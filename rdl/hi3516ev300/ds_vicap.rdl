`ifndef HI3516EV300_VICAP_RDL
`define HI3516EV300_VICAP_RDL
regfile eHI3516EV300_VICAP {
    name = "Video capture (VICAP)";
    desc = "Video capture (VICAP) of the Hi3516E V300 at base 0x1100_0000. 77 registers extracted programmatically from the Hi3516E V300 data sheet (Issue 00B06, 2019-05-15) (Table 9-2 Summary of VICAP registers (base address: 0x1100_0000)): register headings, offsets, total reset values, field bit ranges, access types, names, reset values and descriptions, with PDF page numbers in each register description. Field names, bit ranges, access types and offsets are exact; the free-text descriptions are taken from the cell text of the field table and were checked by sampling only. Hardware not verified.";
    reg {
        name = "WK_MODE";
        desc = "WK_MODE is the global operating mode configuration register. (offset 0x0; total reset 0x00000003; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 9.1.6, PDF page 433).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_2[31:2];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x1;
        } reserved_1_1[1:1];
        field {
            name = "power_mode";
            desc = "Clock mode
- 0: The low-power mode is disabled.
- 1: The low-power mode is disabled.";
            sw = rw; hw = r;
            reset = 0x1;
        } power_mode[0:0];
    } WK_MODE @ 0x0;
    reg {
        name = "AXI_CFG";
