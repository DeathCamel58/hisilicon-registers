    reg AXI_QOS_ADPTn_t {
        name = "AXI_QOS_ADPTn";
        desc = "AXI_QOS_ADPTn is the priority adaptation cycle mapping table register. (offset 0x20C, 5 instances at stride 0x10; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 4.1.5.2, PDF page 226).";
        field {
            name = "reserved";
