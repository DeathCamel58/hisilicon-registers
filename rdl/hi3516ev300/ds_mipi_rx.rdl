- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } phy_da_d0_valid[0:0];
    } PHY_EN_LINK @ 0xC;
    reg {
        name = "PHY_DATA_LINK";
        desc = "PHY_DATA_LINK is the link PHY output parallel data register. (offset 0x18; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 9.3.6, PDF page 521).";
        field {
            name = "phy_data3_mipi";
            desc = "Data received by data lane 3";
            sw = r; hw = w;
            reset = 0x0;
        } phy_data3_mipi[31:24];
        field {
