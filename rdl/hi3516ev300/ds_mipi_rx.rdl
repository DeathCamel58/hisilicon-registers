`ifndef HI3516EV300_MIPI_RX_RDL
`define HI3516EV300_MIPI_RX_RDL
regfile eHI3516EV300_MIPI_RX {
    name = "MIPI RX";
    desc = "MIPI RX of the Hi3516E V300 at base 0x1124_0000. 84 registers extracted programmatically from the Hi3516E V300 data sheet (Issue 00B06, 2019-05-15) (Table 9-12 Summary of MIPI RX registers (base address: 0x1124_0000)): register headings, offsets, total reset values, field bit ranges, access types, names, reset values and descriptions, with PDF page numbers in each register description. Field names, bit ranges, access types and offsets are exact; the free-text descriptions are taken from the cell text of the field table and were checked by sampling only. Hardware not verified.";
    reg {
        name = "PHY_MODE_LINK";
        desc = "PHY_MODE_LINK is the link PHY operating mode register. (offset 0x0; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 9.3.6, PDF page 518).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_26[31:26];
        field {
            name = "phy0_rg_mipi_mode1";
            desc = "MIPI/LVDS input mode select. When the PHY works in LVDS mode and the common voltage is greater than or equal to 1.2 V, this bit is set to 0.
- 0: The common voltage is greater than or equal to 1.2 V.
- 1: The common voltage is less than 1.2 V.";
            sw = rw; hw = r;
            reset = 0x0;
        } phy0_rg_mipi_mode1[25:25];
        field {
            name = "phy0_rg_mipi_mode0";
            desc = "MIPI/LVDS input mode select. When the PHY works in LVDS mode and the common voltage is greater than or equal to 1.2 V, this bit is set to 0.";
            sw = rw; hw = r;
            reset = 0x0;
        } phy0_rg_mipi_mode0[24:24];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_23_17[23:17];
        field {
            name = "phy0_rg_faclk0_en";
            desc = "Phase of associated clock 0 for the PHY output data
- 0: Output data on the rising edge of the clock
- 1: Output data on the falling edge of the clock";
            sw = rw; hw = r;
            reset = 0x0;
        } phy0_rg_faclk0_en[16:16];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_15_14[15:14];
        field {
            name = "phy0_rg_en_lp1";
            desc = "PHY LP1 mode enable. The LP1 mode is enabled in MIPI mode and disabled in other modes.
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } phy0_rg_en_lp1[13:13];
        field {
            name = "phy0_rg_en_lp0";
            desc = "PHY LP0 mode enable. The LP0 mode is enabled in MIPI mode and disabled in other modes.
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } phy0_rg_en_lp0[12:12];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_11_5[11:5];
        field {
            name = "phy0_rg_en_clk0";
            desc = "Clock lane 0 enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } phy0_rg_en_clk0[4:4];
        field {
            name = "phy0_rg_en_d";
            desc = "Data lane enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } phy0_rg_en_d[3:0];
    } PHY_MODE_LINK @ 0x0;
    reg {
