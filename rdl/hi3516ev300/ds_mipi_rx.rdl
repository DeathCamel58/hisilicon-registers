            sw = r; hw = w;
            reset = 0x0;
        } reserved_11_10[11:10];
        field {
            name = "lvds_code_big_endian";
            desc = "Transfer sequence of serial bits of transferred RAW data sync code (sync_code) in LVDS/HiSPI mode
- 0: LSB. Lower bits are transferred first. The sequence of the received sync code (sync_code) serial data is bit 0, bit 1, ..., and bit 11.
- 1: MSB. Upper bits are transferred first. The sequence of the received sync code (sync_code) serial data is bit 11, bit 10, ..., and bit 0.";
            sw = rw; hw = r;
            reset = 0x1;
        } lvds_code_big_endian[9:9];
        field {
            name = "lvds_pix_big_endian";
            desc = "Transfer sequence of serial bits of transferred RAW data valid pixels in LVDS/HiSPI mode
- 0: LSB. Lower bits are transferred first. The";
            sw = rw; hw = r;
            reset = 0x1;
        } lvds_pix_big_endian[8:8];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_7[7:7];
        field {
            name = "lvds_raw_type";
            desc = "Type of transferred RAW data in LVDS/HiSPI mode
- 001: Raw 8-bit
- 010: Raw 10-bit
- 011: Raw 12-bit
- 100: Raw 14-bit

Other values: reserved";
            sw = rw; hw = r;
            reset = 0x3;
        } lvds_raw_type[6:4];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_3_1[3:1];
        field {
            name = "lvds_sync_mode";
            desc = "Frame/Line sync mode in LVDS mode
- 0: The sync mode is SOF/EOF/SOL/EOL mode. SOF indicates the start of the first line of the valid region, EOF indicates the end of the last line of the valid region, and SOL and

EOL indicate the start and end of other valid regions respectively.
- 1: The sync mode is SAV/EAV mode.

SAV(Invalid) and EAV(Invalid) indicate the invalid data of the blanking region, and SAV(Valid) and EAV(Valid) indicate pixel data of the valid region.";
            sw = rw; hw = r;
            reset = 0x0;
        } lvds_sync_mode[0:0];
    } LVDS_CTRL @ 0x1308;
