        desc = "PHY_SKEW_LINK is the link PHY channel delay adjustment register. (offset 0x4; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 9.3.6, PDF page 519).";
        field {
