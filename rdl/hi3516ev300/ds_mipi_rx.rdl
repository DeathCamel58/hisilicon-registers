    } PHY_DATA_MIPI_LINK @ 0x20;
    reg {
        name = "PHY_SYNC_DCT_LINK";
        desc = "PHY_SYNC_DCT_LINK is thelink PHY sync header detection control register in LVDS mode. (offset 0x24; total reset 0x00101101; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 9.3.6, PDF page 522).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_21[31:21];
        field {
            name = "cil_code_big_endian1";
            desc = "Serial bit transmission sequence 1 for the synchronization code (sync_code) of raw data to be transmitted in LVDS or HiSPI mode.
- 0: LSB. The lower bits are transmitted first.

The serial data sequence of the received synchronization code is bit 0, bit 1, ..., and bit 11.
- 1: MSB. The upper bits are transmitted first.

The serial data sequence of the received synchronization code is bit 11, bit 10, ..., and bit 0.";
            sw = rw; hw = r;
            reset = 0x1;
        } cil_code_big_endian1[20:20];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_19_15[19:15];
        field {
            name = "cil_raw_type1";
            desc = "Type1 of the raw data to be transmitted in LVDS or HiSPI mode
- 001: 8-bit raw data
- 010: 10-bit raw data";
            sw = rw; hw = r;
            reset = 0x1;
        } cil_raw_type1[14:12];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
