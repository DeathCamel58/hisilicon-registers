- 0: The internal matched resistor is disabled.
- 1: The internal matched resistor is enabled.";
            sw = rw; hw = r;
            reset = 0x0;
        } phy_d0_term_en[8:8];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_4[7:4];
        field {
            name = "phy_da_d3_valid";
            desc = "High-speed mode enable for data lane 3
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } phy_da_d3_valid[3:3];
        field {
            name = "phy_da_d2_valid";
