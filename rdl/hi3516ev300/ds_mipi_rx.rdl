            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_23[31:23];
        field {
            name = "phy0_d3_skew";
            desc = "Timing delay adjustment for data lane 3. The phase is delayed by about 62.5 ps each time the register value is incremented by 1.";
            sw = rw; hw = r;
            reset = 0x0;
        } phy0_d3_skew[22:20];
        field {
