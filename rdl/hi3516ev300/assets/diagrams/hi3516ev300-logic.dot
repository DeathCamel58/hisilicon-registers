// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3516ev300-logic" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3516E V300: logic block diagram</B><BR/><FONT POINT-SIZE="11">redrawn from the data sheet (Figure 1-2 and chapter 1); bus topology as in the figure, details in the register pages</FONT>>, fontcolor="#808080", rankdir=LR, compound=true, newrank=true];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  bus [label="AMBA 3.0 bus", fillcolor="#9a9a9a"  shape=box, height=5.2, width=0.5, fontcolor="white"];
  subgraph cluster_cpu { label="CPU subsystem"; fontcolor="#808080"; color="#808080"; style="rounded";
  cpu [label="Cortex-A7 up to 900 MHz, NEON + FPU\n32 KB I + 32 KB D L1, 128 KB L2", fillcolor="#e0b86f"  ];
  }
  ddrc [label="DDRC", fillcolor="#8fb3de"  ];
  ddrext [label="built-in 1 Gbit DDR3L\n16-bit", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  ddrext -> ddrc [dir=both]; ddrc -> cpu [dir=both]; ddrc -> bus [dir=both, style=dashed];
  subgraph cluster_l0 { label="Storage, network, USB, audio"; fontcolor="#808080"; color="#808080"; style="rounded";
    sd0 [label="eMMC / SDIO0 (SDHCI)", fillcolor="#8fb3de"  ];
    sd1 [label="SDIO1 (SDHCI)", fillcolor="#8fb3de"  ];
    fmc [label="FMC (SPI NOR / NAND)", fillcolor="#8fb3de"  ];
    eth [label="FEMAC + internal\nFE PHY (TSO)", fillcolor="#8fb3de"  ];
    usb [label="USB 2.0 host / device\n(DWC3 + PHY)", fillcolor="#8fb3de"  ];
    aio [label="AIAO (I2S) +\naudio codec", fillcolor="#8fb3de"  ];
    dma [label="EDMAC\n4 channels", fillcolor="#8fb3de"  ];
  }
  sd0 -> bus [dir=both];
  sd1 -> bus [dir=both];
  fmc -> bus [dir=both];
  eth -> bus [dir=both];
  usb -> bus [dir=both];
  aio -> bus [dir=both];
  dma -> bus [dir=both];
  subgraph cluster_l1 { label="Security"; fontcolor="#808080"; color="#808080"; style="rounded";
    sec [label="SPACC (AES / HASH), RSA,\nKLAD, TRNG, OTP 32 kbit", fillcolor="#c9a0dc"  ];
  }
  sec -> bus [dir=both];
  subgraph cluster_r0 { label="Image subsystem"; fontcolor="#808080"; color="#808080"; style="rounded";
    vicap [label="VICAP: MIPI / LVDS / HiSPi /\nBT.1120 / DC timing", fillcolor="#a6c98f"  ];
    isp [label="ISP (3A, WDR, DIS)", fillcolor="#a6c98f"  ];
    vpss [label="VPSS + VGS", fillcolor="#a6c98f"  ];
    ive [label="IVE", fillcolor="#a6c98f"  ];
    vdp [label="VDP: 6/8/16-bit LCD,\nBT.656 / BT.1120 output", fillcolor="#a6c98f"  ];
  }
  bus -> vicap [dir=both];
  bus -> isp [dir=both];
  bus -> vpss [dir=both];
  bus -> ive [dir=both];
  bus -> vdp [dir=both];
  subgraph cluster_r1 { label="Video codec"; fontcolor="#808080"; color="#808080"; style="rounded";
    enc [label="H.264 / H.265 / MJPEG / JPEG\nencoder", fillcolor="#a6c98f"  ];
    gz [label="GZIP (decompression)", fillcolor="#a6c98f"  ];
  }
  bus -> enc [dir=both];
  bus -> gz [dir=both];
  subgraph cluster_r2 { label="Low-speed peripherals (APB)"; fontcolor="#808080"; color="#808080"; style="rounded";
    lsp [label="UART x3, I2C x3, SPI x2, GPIO x10,\nPWM x4, LSADC x4, timers, WDG,\nRTC, PMC, SYS_CTRL, CRG, IO config", fillcolor="#7fcdc4"  ];
  }
  bus -> lsp [dir=both];
  card [label="SD card / eMMC / SDIO Wi-Fi", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  card -> sd0 [dir=both, style=dashed];
  card -> sd1 [dir=both, style=dashed];
  flash [label="SPI NOR / NAND flash", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  flash -> fmc [dir=both, style=dashed];
  phy [label="RJ45 transformer", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  phy -> eth [dir=both, style=dashed];
  usbp [label="USB port", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  usbp -> usb [dir=both, style=dashed];
  sens [label="CMOS sensor", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  vicap -> sens [dir=both, style=dashed];
  disp [label="LCD / BT.656 display", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  vdp -> disp [dir=both, style=dashed];
  bus -> cpu [dir=both];
}
