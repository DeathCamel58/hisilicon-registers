// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3516ev300-busqos" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3516E V300: bus masters and DDR QoS groups</B><BR/><FONT POINT-SIZE="11">data sheet 3.5 (MISC_CTRL32-38 MDDRC read / write QoS registers, MISC_CTRL28 media bus priority) and the DDRC AXI register tables; the interconnect topology and the master-to-AXI-port assignment are not tabulated, so they are not drawn</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  cpu [label="CPU, DMAC, SPACC", fillcolor="#e0b86f"  ];
  io [label="FMC, USB, SDIO0, SDIO1, ETH", fillcolor="#8fb3de"  ];
  cap [label="VICAP, VIPROC, VDP, AIAO", fillcolor="#a6c98f"  ];
  codec [label="VEDU, JPGE, VPSS", fillcolor="#a6c98f"  ];
  misc [label="IVE / DDRT, VGS / GZIP", fillcolor="#a6c98f"  ];
  qos [label="MDDRC QoS group select\n3 bits per master and direction\nMISC_CTRL32-34 write, MISC_CTRL36-38 read", fillcolor="#d6d27a"  ];
  prio [label="Media bus port priority (MISC_CTRL28):\nVPSS port 0 = 3, VEDU port 1 = 2, JPGE port 2 = 1\n(reset values)", fillcolor="#d6d27a"  ];
  axi [label="DDRC AXI ports, regions, QoS buffer\n(ds_ddrc_axi, ds_ddrc_qosb)", fillcolor="#9aa7e6"  ];
  dmc [label="DDRC DMC + DDR PHY", fillcolor="#8fb3de"  ];
  ddr [label="built-in DDR3L", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  cpu -> qos;
  io -> qos;
  cap -> qos;
  codec -> qos;
  misc -> qos;
  codec -> prio;
  prio -> qos;
  qos -> axi;
  axi -> dmc;
  dmc -> ddr;
}
