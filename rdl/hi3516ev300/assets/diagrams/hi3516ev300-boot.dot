// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3516ev300-boot" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3516E V300: boot flow</B><BR/><FONT POINT-SIZE="11">data sheet 1.4 and Table 1-1; BOOT_SEL1 / BOOT_SEL0 are latched from pins LCD_CLK / LCD_DE (SYSSTAT[5:4]), UPDATE_MODE is GPIO0_0</FONT>>, fontcolor="#808080", rankdir=TB];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  por [label="Power-on reset", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  upd [label="UPDATE_MODE\n(GPIO0_0 key, 0 = pressed) ?", fillcolor="#d6d27a"   shape=diamond];
  bs [label="BOOT_SEL1, BOOT_SEL0 ?", fillcolor="#d6d27a"   shape=diamond];
  nor [label="SPI NOR or SPI NAND (FMC)", fillcolor="#8fb3de"  ];
  emmc [label="eMMC", fillcolor="#8fb3de"  ];
  sern [label="Serial burn: NOR / NAND images", fillcolor="#c9a0dc"  ];
  sere [label="Serial burn: eMMC images", fillcolor="#c9a0dc"  ];
  sd [label="Upgrade from SD card (SDIO0 only)\nor USB, then flash NOR / NAND\n(BOOT_SEL0 = 0) or eMMC (BOOT_SEL0 = 1)", fillcolor="#c9a0dc"  ];
  sec [label="SYSSTAT[31] secure boot flag (OTP)?\nsecure: verify U-Boot signature", fillcolor="#d6d27a"   shape=diamond];
  run [label="U-Boot runs", fillcolor="#a6c98f"  ];
  por -> upd;
  upd -> bs [label="1"];
  upd -> sd [label="0"];
  bs -> nor [label="00"];
  bs -> emmc [label="01"];
  bs -> sern [label="10"];
  bs -> sere [label="11"];
  nor -> sec;
  emmc -> sec;
  sec -> run;
}
