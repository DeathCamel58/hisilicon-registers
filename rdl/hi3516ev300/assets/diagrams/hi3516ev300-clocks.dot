// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3516ev300-clocks" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3516E V300: clock tree</B><BR/><FONT POINT-SIZE="11">data sheet 3.2 (Figures 3-2, 3-3, Tables 3-2 to 3-4); which PLL output feeds which module is not drawn in the figure (assignment of VPLL to display and pixel clocks INFERRED from the frequencies)</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  xin [label="XIN 24 MHz crystal", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  rtcx [label="RTC_XIN 32.768 kHz crystal", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  apll [label="APLL (PERI_CRG_PLL0 / PLL1)\nVCO 1800 MHz, POSTDIV 900 MHz\nlock: PERI_CRG_PLL122 apll_lock", fillcolor="#e6a0a0"  ];
  vpll [label="VPLL (PERI_CRG_PLL6 / PLL7)\nVCO 2376 MHz, POSTDIV 594 MHz\nlock: PERI_CRG_PLL122 vpll_lock", fillcolor="#e6a0a0"  ];
  div [label="CLK_DIV: dividers and selects\nglitch-free switching for A7, DDR, SYSAXI,\nSYSCFG, SYSAPB, FMC, eMMC, SDIO0, SDIO1", fillcolor="#d6d27a"  ];
  cpu [label="A7: 24 / 600 / 900 MHz\nPERI_CRG32 a7_cksel", fillcolor="#e0b86f"  ];
  ddr [label="DDR: 24 / 300 / 450 MHz\nPERI_CRG32 ddr_cksel", fillcolor="#8fb3de"  ];
  bus [label="SYSAXI 24 / 200 MHz, SYSCFG 24 / 100 MHz,\nSYSAPB 24 / 50 MHz (PERI_CRG32)", fillcolor="#8fb3de"  ];
  media [label="VPSS, VIPROC: 75 ... 257 MHz (default 257)\nVICAP / MIPI pixel: 75 ... 360 MHz (default 360)\nIVE: 100 / 300 / 360 / 450 MHz (default 450)\nVGS: follows the DDR clock", fillcolor="#a6c98f"  ];
  stor [label="FMC: 24 ... 360 MHz (PERI_CRG81)\neMMC / SDIO0: 100 kHz ... 150 MHz (PERI_CRG125)\nSDIO1: 100 kHz ... 50 MHz", fillcolor="#8fb3de"  ];
  vid [label="VDP / LCD pixel clocks\nPERI_CRG65 lcd_div, PERI_CRG66 vdp_hd0_cksel\n148.5 / 74.25 MHz class", fillcolor="#a6c98f"  ];
  low [label="UART, PWM, LSADC, SSP selects\nPERI_CRG111; sensor clock out PERI_CRG60", fillcolor="#7fcdc4"  ];
  gate [label="Clock gating and soft reset\nin the per-block CRG registers", fillcolor="#9aa7e6"  ];
  rtc [label="RTC, PMC (always on)", fillcolor="#7fcdc4"  ];
  xin -> apll;
  xin -> vpll;
  xin -> div [label="24 MHz direct"];
  rtcx -> rtc;
  apll -> div [label="600/360/300/257/200/100/72,\n900, 450/150/50 MHz"];
  vpll -> div [label="792/594/475/297, 54/27,\n148.5/74.25 MHz"];
  div -> cpu;
  div -> ddr;
  div -> bus;
  div -> media;
  div -> stor;
  div -> vid;
  div -> low;
  cpu -> gate;
  media -> gate;
  stor -> gate;
}
