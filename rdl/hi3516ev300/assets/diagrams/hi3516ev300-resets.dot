// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3516ev300-resets" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3516E V300: reset tree</B><BR/><FONT POINT-SIZE="11">data sheet 3.1 (Figure 3-1, Table 3-1); register groups from the CRG description (numbers are PERI_CRGnn register numbers)</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  por [label="POR (internal) + external reset\nnpor: global hard reset", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  wdg [label="Watchdog\nwdg_rst_req", fillcolor="#8fb3de"  ];
  sys [label="SYS_CTRL SC_SYSRES\nglobal soft reset request sys_rst_req\n(write enable via SC_LOCKEN)", fillcolor="#e0b86f"  ];
  l1 [label="ResetCtrl level 1\nsys_rst_n: resets everything except the CRG,\ntest logic and some registers", fillcolor="#d6d27a"  ];
  crg [label="CRG xx_srst_req bits\n(self-held: 1 resets, 0 releases)", fillcolor="#9aa7e6"  ];
  l2 [label="ResetCtrl level 2\nxx_rst_n synchronized per clock domain", fillcolor="#d6d27a"  ];
  g1 [label="CPU and debug: PERI_CRG30\narm_core0, arm_dbg0, l2, socdbg, cs", fillcolor="#e0b86f"  ];
  g2 [label="DDR: PERI_CRG31 ddr_hipack, ddr_apb", fillcolor="#8fb3de"  ];
  g3 [label="Image: VICAP 61, MIPI RX 62, VIPROC 63, ISP 64,\nVPSS 42, VGS 43, VEDU 41, JPGE 44, IVE 47,\nVDP 66, GZIP 100, motion detect 26", fillcolor="#a6c98f"  ];
  g4 [label="I/O: USB2 80, FMC 81, FEMAC 91 + FE PHY,\nEDMAC 101, AIAO + codec 103, MMC 125 ...", fillcolor="#8fb3de"  ];
  g5 [label="Crypto: KLAD, TRNG, RSA, SPACC (PERI_CRG104),\neFuse / OTP 54", fillcolor="#c9a0dc"  ];
  g6 [label="Low speed: UART, I2C 110, SPI, PWM,\nLSADC 111", fillcolor="#7fcdc4"  ];
  por -> l1;
  wdg -> l1;
  sys -> l1;
  l1 -> l2;
  crg -> l2;
  l2 -> g1;
  l2 -> g2;
  l2 -> g3;
  l2 -> g4;
  l2 -> g5;
  l2 -> g6;
}
