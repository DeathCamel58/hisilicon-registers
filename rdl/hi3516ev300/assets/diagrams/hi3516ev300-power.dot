// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3516ev300-power" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3516E V300: power domains</B><BR/><FONT POINT-SIZE="11">data sheet 2.5.3 (Table 2-13) and 3.10; always-on area = PMC + RTC, everything else can be powered off through the external PWR_SEQ supply control</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  bat [label="Battery / standby supply\nAVDD_BAT 1.6 - 3.6 V", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  rtc [label="RTC (32.768 kHz)\nalways on", fillcolor="#7fcdc4"  ];
  pmc [label="PMC (0x120F0000)\nwakeup polarity, power-on / off timing,\nRTC timed power-on, PWR_BUTTON 10.2 s", fillcolor="#e0b86f"  ];
  seq [label="PWR_SEQ output -> external DC/DC and LDO", fillcolor="#9aa7e6"  ];
  core [label="Core 0.9 V (non-always-on area)", fillcolor="#8fb3de"  ];
  io1 [label="DVDD3318_FLASH: SFC / SDIO0 / PWM /\nUART0 / SYS I/O (1.8 or 3.3 V)", fillcolor="#8fb3de"  ];
  io2 [label="DVDD3318_SENSOR: sensor + I2C (1.8 / 3.3 V)\nDVDD3318_VIVO: LCD I/O\nDVDD3318_PC: PWR I/O\nDVDD33: JTAG / LSADC / LCD", fillcolor="#8fb3de"  ];
  ana [label="Analog 3.3 V: PLL, USB2, audio codec, FE PHY\nAVDD3318_MIPIRX 1.8 V", fillcolor="#8fb3de"  ];
  ddr [label="VDDIO_DDR 1.35 V (DDR3L)", fillcolor="#8fb3de"  ];
  wake [label="wakeup sources: PWR_WAKEUP, PWR_STARTUP,\nPWR_BUTTON, PWR_RSTN pins", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  avs [label="Adaptive voltage scaling (AVS)\nand clock / module / DDR low-power control", fillcolor="#d6d27a"  ];
  bat -> rtc;
  rtc -> pmc [label="32.768 kHz clock"];
  wake -> pmc;
  pmc -> seq;
  seq -> core;
  seq -> io1;
  seq -> io2;
  seq -> ana;
  seq -> ddr;
  avs -> core;
}
