- 0xF: 16";
            sw = rw; hw = r;
            reset = 0x0;
        } sl[27:24];
        field {
            name = "dl";
            desc = "Burst length on the destination side
- 0x0: 1
- 0x1: 2
- 0x2: 3
- 0x3: 4
- 0x4: 5";
            sw = rw; hw = r;
            reset = 0x0;
        } dl[23:20];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_19_19[19:19];
        field {
            name = "sw";
            desc = "Source data width
- 000: 8 bits
- 001: 16 bits
- 010: 32 bits
- 011: 64 bits 1xx: reserved";
            sw = rw; hw = r;
            reset = 0x0;
        } sw_f[18:16];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_15_15[15:15];
        field {
            name = "dw";
            desc = "Destination data width
- 000: 8 bits
- 001: 16 bits
- 010: 32 bits
- 011: 64 bits 1xx: reserved";
            sw = rw; hw = r;
            reset = 0x0;
        } dw[14:12];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_11_9[11:9];
        field {
            name = "peri";
            desc = "Peripheral request signal If the data is transferred from a memory to another one, these bits are ignored.";
            sw = rw; hw = r;
            reset = 0x0;
        } peri[8:4];
        field {
            name = "flow_ctrl";
            desc = "Flow control type and transfer type
- 00: Transfer between two memories, DMAC flow control
- 01: Transfer between a memory and a peripheral, DMAC flow control 1x: reserved";
            sw = rw; hw = r;
            reset = 0x0;
        } flow_ctrl[3:2];
        field {
            name = "itc_en";
            desc = "Linked list node transfer completion interrupt enable. This bit is used to configure whether to trigger a linked list node transfer completion interrupt after the current linked";
            sw = rw; hw = r;
            reset = 0x0;
        } itc_en[1:1];
        field {
            name = "ch_en";
            desc = "Current channel enable Running status of the current channel when this register is written:
- 0: The channel is disabled.
- 1: The channel is enabled.

Status of the current channel when this register is read:
- 0: The current channel stops running.
- 1: The current channel is running (the current channel is always enabled when the linked list transfer is enabled).";
            sw = rw; hw = r;
            reset = 0x0;
        } ch_en[0:0];
    };
    C_n_CONFIG_t C_0_CONFIG @ 0x830;
    C_n_CONFIG_t C_1_CONFIG @ 0x870;
    C_n_CONFIG_t C_2_CONFIG @ 0x8B0;
    C_n_CONFIG_t C_3_CONFIG @ 0x8F0;
    reg {
        name = "DMAC_VERSION";
        desc = "DATE_VERSION is a version register. (offset 0xF00; total reset 0x0000B310; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 3.6.6, PDF page 159).";
        field {
            name = "dmac_version";
            desc = "Controller version information";
            sw = r; hw = w;
            reset = 0xb310;
        } dmac_version[31:0];
    } DMAC_VERSION @ 0xF00;
};
`endif
