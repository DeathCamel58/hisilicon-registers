regfile eHI3516EV300_DMAC {
    name = "DMAC (EDMAC)";
    desc = "DMAC (EDMAC) of the Hi3516E V300 at base 0x100B0000. 27 registers extracted programmatically from the Hi3516E V300 data sheet (Issue 00B06, 2019-05-15) (Table 3-11 DMAC registers Offset Register Description Page Address): register headings, offsets, total reset values, field bit ranges, access types, names, reset values and descriptions, with PDF page numbers in each register description. Field names, bit ranges, access types and offsets are exact; the free-text descriptions are taken from the cell text of the field table and were checked by sampling only. Hardware not verified.";
    reg {
        name = "INT_STAT";
        desc = "INT_STATUS is an interrupt status register. (offset 0x0; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 3.6.6, PDF page 148).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_4[31:4];
        field {
            name = "int_stat";
            desc = "Status of the masked interrupts of each DMAC channel. Bit[3:0] corresponds to channels 3-0.
- 0: No interrupt is generated.
- 1: An interrupt is generated. The interrupt request may be an error interrupt or a transfer completion interrupt.";
            sw = r; hw = w;
            reset = 0x0;
        } int_stat[3:0];
    } INT_STAT @ 0x0;
