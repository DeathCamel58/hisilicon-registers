        desc = "INT_TC1_RAW is a raw channel transfer completion interrupt status register. (offset 0x600; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 3.6.6, PDF page 152).";
        field {
