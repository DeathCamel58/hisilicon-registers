- 0: not bypassed
- 1: bypassed";
            sw = rw; hw = r;
            reset = 0x0;
        } apll_bypass[26:26];
        field {
            name = "apll_dacpd";
            desc = "APLL test signal control
- 0: normal operating mode
- 1: power-down mode";
            sw = rw; hw = r;
            reset = 0x0;
        } apll_dacpd[25:25];
        field {
            name = "apll_dsmpd";
            desc = "APLL decimal division control
- 0: decimal frequency-division mode";
            sw = rw; hw = r;
            reset = 0x1;
        } apll_dsmpd[24:24];
        field {
            name = "apll_pd";
            desc = "APLL power-down control
- 0: normal operating mode
- 1: power-down mode";
            sw = rw; hw = r;
            reset = 0x0;
        } apll_pd[23:23];
        field {
            name = "apll_foutvcopd";
            desc = "APLL VCO output power-down control
- 0: normal clock output
- 1: no clock output";
            sw = rw; hw = r;
            reset = 0x0;
        } apll_foutvcopd[22:22];
        field {
            name = "apll_postdivpd";
            desc = "APLL POSTDIV output power-down control
- 0: normal clock output
- 1: no clock output";
            sw = rw; hw = r;
            reset = 0x0;
        } apll_postdivpd[21:21];
        field {
            name = "apll_fout4phasepd";
            desc = "APLL FOUT output power-down control
- 0: normal clock output
- 1: no clock output";
            sw = rw; hw = r;
            reset = 0x0;
        } apll_fout4phasepd[20:20];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_19_18[19:18];
        field {
