`ifndef HI3516EV300_CRG_RDL
`define HI3516EV300_CRG_RDL
regfile eHI3516EV300_CRG {
    name = "Clock and reset generator (CRG)";
    desc = "Clock and reset generator (CRG) of the Hi3516E V300 at base 0x1201_0000. 43 registers extracted programmatically (plus 8 registers kept from the vendor-derived map, marked INFERRED) from the Hi3516E V300 data sheet (Issue 00B06, 2019-05-15) (Table 3-5 Summary of CRG registers (base address: 0x1201_0000)): register headings, offsets, total reset values, field bit ranges, access types, names, reset values and descriptions, with PDF page numbers in each register description. Field names, bit ranges, access types and offsets are exact; the free-text descriptions are taken from the cell text of the field table and were checked by sampling only. Hardware not verified.";
    reg {
        name = "PERI_CRG_PLL0";
        desc = "PERI_CRG_PLL0 is APLL configuration register 0. (offset 0x0; total reset 0x12000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 3.2.6, PDF page 82).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_31[31:31];
        field {
            name = "apll_postdiv2";
            desc = "Level-2 output frequency division factor of the APLL";
            sw = rw; hw = r;
            reset = 0x1;
        } apll_postdiv2[30:28];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_27_27[27:27];
        field {
            name = "apll_postdiv1";
            desc = "Level-1 output frequency division factor of the APLL";
            sw = rw; hw = r;
            reset = 0x2;
        } apll_postdiv1[26:24];
        field {
            name = "apll_frac";
            desc = "Decimal part of the APLL frequency multiplication coefficient";
            sw = rw; hw = r;
            reset = 0x0;
        } apll_frac[23:0];
    } PERI_CRG_PLL0 @ 0x0;
    reg {
        name = "PERI_CRG_PLL1";
        desc = "PERI_CRG_PLL1 is APLL configuration register 1. (offset 0x4; total reset 0x0100104B; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 3.2.6, PDF page 82).";
        field {
