- 0: normal clock output
- 1: no clock output";
            sw = rw; hw = r;
            reset = 0x0;
        } vpll_fout4phasepd[20:20];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_19_18[19:18];
        field {
            name = "vpll_refdiv";
            desc = "Frequency division factor of the VPLL reference clock";
            sw = rw; hw = r;
            reset = 0x1;
        } vpll_refdiv[17:12];
        field {
