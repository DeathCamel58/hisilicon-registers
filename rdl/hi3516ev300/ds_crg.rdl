            sw = rw; hw = r;
            reset = 0x63;
        } vpll_fbdiv[11:0];
    } PERI_CRG_PLL7 @ 0x1C;
    reg {
        name = "PERI_CRG20";
        desc = "PERI_CRG20 is the APLL SS configuration register. (offset 0x50; total reset 0x00000004; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 3.2.6, PDF page 84).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_13[31:13];
        field {
            name = "apll_ssmod_cfg";
            desc = "ssmod divval[12: 9]: SSMOD divval control
- 0x0: not divided
- 0x1: not divided
- 0x2: divided by 2
- 0x3: divided by 3 …
- 0xF: divided by 15 ssmod spread[8: 4]: SSMOD spread control
- 0: 0
- 1: 0.1%
- 2: 0.2%
- 3: 0.3%
- 4: 0.4%
- 5: 0.5%
- 6: 0.6%
- 7: 0.7% ...
- 31: 3.1% ssmod downspread[3]: SSMOD downspread control
- 0: central spread spectrum
- 1: down spread spectrum ssmod_disable[2]: SSMOD disable control
- 0: enabled
- 1: disabled ssmod_rst_req[1]: SSMOD reset control
- 0: reset deasserted
- 1: reset ssmod_cken[0]: SSMOD clock gating, disabled by default
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x4;
        } apll_ssmod_cfg[12:0];
    } PERI_CRG20 @ 0x50;
    reg {
        name = "PERI_CRG23";
        desc = "PERI_CRG23 is the VPLL SS configuration register. (offset 0x5C; total reset 0x00000004; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 3.2.6, PDF page 86).";
        field {
