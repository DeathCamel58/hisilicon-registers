`ifndef DEFINES_RDL
`define DEFINES_RDL

// Hi3516EV300: variants of the shared blocks instantiated in hi3516ev300.rdl.
// No data sheet exists for this chip in the repository; every choice below is INFERRED from
// vendor drivers (see docs/research/hi3516ev300-blocks.md in the hi3520d-nvr workspace).
`define FMC_GEN2   // HISI_FMC.rdl: HiFMC v100 as on the Hi3516A V300 / CV500 family (vendor U-Boot hifmc_hi3516ev300.c shares the driver family)
`define I2C_V2_CTRL2   // HISI_I2C_V2.rdl: hibvt I2C (vendor driver i2c-hibvt.c defines HIBVT_I2C_CTRL2 0xD4)
`define SPI_RESET_G1   // HISI_SPI.rdl: PL022 reset group chosen as on the AV300 (no EV300 data sheet)
`define SPI_RESET_G2
`define SPI_RESET_G3
`define SPI_RESET_G5
`define SPI_RESET_G6
`define SPI_MODE_ALTASENS
`define TIMER_SP804_RESET_G1
`define TIMER_SP804_RESET_G3
`define WDG_SP805_RESET_G1
`define PL011_FR_RESET_G2
`define HISI_PWM_NCH 4   // HISI_PWM.rdl: four channels, from the open pwm driver shared with the Hi3516E V200 (see rdl/hi3516ev200)
`define HISI_LSADC_V2_CV300   // HISI_LSADC_V2.rdl: two-channel 10-bit edition (open adc driver register list, shared with the Hi3516E V200)
`define HISI_RTC_SPI_NO_TSENSOR   // HISI_RTC_SPI.rdl: temperature sensor is in MISC 0xBC on the EV300 (as on the AV300)
`define IVE_EXT_REGS   // HISI_IVE.rdl: timeout registers (ive_neo hardware-tested writes 0x60)
`define IVE_AV300_REGS   // HISI_IVE.rdl: 0x8C/0x90 (ive_neo writes 0x8C and 0x90, live capture)
`define HISI_RSA_RAND_MASK   // HISI_RSA.rdl: random-mask registers 0x7C..0x94 (vendor cipher driver, RSA version 0x20160907)
`define HISI_SPACC_EXTRA   // HISI_SPACC.rdl: SM1_SK, ODD_EVEN_KEY_SEL, HDCP_MODE_CTRL, channel owner registers (vendor cipher driver)
`endif
