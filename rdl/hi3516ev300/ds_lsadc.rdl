            desc = "Whether the average algorithm for sampling of LSADC channel 3 is valid
- 0: invalid
- 1: valid

(INFERRED placement: the data sheet prints the reserved range overlapping this field at [11]; PDF pages 795-796.)";
            sw = r; hw = w;
