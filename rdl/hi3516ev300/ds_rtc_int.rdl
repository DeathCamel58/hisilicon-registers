`ifndef HI3516EV300_RTC_INT_RDL
`define HI3516EV300_RTC_INT_RDL
regfile eHI3516EV300_RTC_INT {
    name = "Internal RTC register file (device addresses reached through the RTC SPI interface, NOT memory mapped; the instance base 0x120E0100 in the SoC map is a placeholder)";
    desc = "Internal RTC register file (device addresses reached through the RTC SPI interface, NOT memory mapped; the instance base 0x120E0100 in the SoC map is a placeholder) of the Hi3516E V300 at base 0x120E0000. 41 registers extracted programmatically from the Hi3516E V300 data sheet (Issue 00B06, 2019-05-15) (Table 3-15 Summary of internal RTC registers (base address: 0x00)): register headings, offsets, total reset values, field bit ranges, access types, names, reset values and descriptions, with PDF page numbers in each register description. Field names, bit ranges, access types and offsets are exact; the free-text descriptions are taken from the cell text of the field table and were checked by sampling only. Hardware not verified.";
    reg {
        name = "RTC_10MS_COUNT";
        desc = "RTC_10MS_COUNT is a count value register for the RTC 10 ms counter. (offset 0x0; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 3.9.7, PDF page 178).";
        regwidth = 8;
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_7[7:7];
        field {
            name = "rtc_10ms_count";
            desc = "RTC 10 ms counter value. It indicates the currently counted time. Its unit is 10 ms. The value range is 0-99.";
            sw = r; hw = w;
            reset = 0x0;
        } rtc_10ms_count[6:0];
    } RTC_10MS_COUNT @ 0x0;
    reg {
        name = "RTC_S_COUNT";
        desc = "RTC_S_COUNT is a count value register for the RTC second counter. (offset 0x1; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 3.9.7, PDF page 178).";
        regwidth = 8;
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_6[7:6];
        field {
            name = "rtc_s_count";
            desc = "RTC second counter value. It indicates the currently counted seconds. The value range is 0-59.";
            sw = r; hw = w;
            reset = 0x0;
        } rtc_s_count[5:0];
    } RTC_S_COUNT @ 0x1;
    reg {
        name = "RTC_M_COUNT";
        desc = "RTC_M_COUNT is a count value register for the RTC minute counter. (offset 0x2; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 3.9.7, PDF page 178).";
        regwidth = 8;
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_6[7:6];
        field {
            name = "rtc_m_count";
            desc = "RTC minute counter value. It indicates the currently counted minutes. The value range is 0-59.";
            sw = r; hw = w;
            reset = 0x0;
        } rtc_m_count[5:0];
    } RTC_M_COUNT @ 0x2;
    reg {
        name = "RTC_H_COUNT";
        desc = "RTC_H_COUNT is a count value register for the RTC hour counter. (offset 0x3; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 3.9.7, PDF page 178).";
        regwidth = 8;
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_5[7:5];
        field {
            name = "rtc_h_count";
            desc = "RTC hour counter value. It indicates the currently counted hours. The value range is 0-23.";
            sw = r; hw = w;
            reset = 0x0;
        } rtc_h_count[4:0];
    } RTC_H_COUNT @ 0x3;
    reg {
        name = "RTC_D_COUNT_L";
        desc = "RTC_D_COUNT_L is a lower-8-bit count value register for the RTC day counter. (offset 0x4; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 3.9.7, PDF page 179).";
        regwidth = 8;
        field {
            name = "rtc_d_count_l";
            desc = "Lower eight bits of the RTC day counter value. This field works with RTC_D_COUNT_H to indicate the currently counted days. The day range is 0-65535.";
            sw = r; hw = w;
            reset = 0x0;
        } rtc_d_count_l[7:0];
    } RTC_D_COUNT_L @ 0x4;
    reg {
        name = "RTC_D_COUNT_H";
        desc = "RTC_D_COUNT_H is an upper-8-bit count value register for the RTC day counter. (offset 0x5; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 3.9.7, PDF page 179).";
        regwidth = 8;
        field {
            name = "rtc_d_count_h";
            desc = "Upper eight bits of the RTC day counter value. This field works with RTC_D_COUNT_L to indicate the currently counted days. The day range is 0-65535.";
            sw = r; hw = w;
            reset = 0x0;
        } rtc_d_count_h[7:0];
    } RTC_D_COUNT_H @ 0x5;
    reg {
        name = "RTC_MR_10MS";
        desc = "RTC_MR_10MS is a match value register for the RTC 10 ms counter. (offset 0x6; total reset 0x0000007F; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 3.9.7, PDF page 179).";
        regwidth = 8;
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_7[7:7];
        field {
            name = "rtc_mr_10ms";
            desc = "Match value of the RTC 10 ms counter The value range is 0-99.";
            sw = rw; hw = r;
            reset = 0x7f;
        } rtc_mr_10ms[6:0];
    } RTC_MR_10MS @ 0x6;
    reg {
        name = "RTC_MR_S";
        desc = "RTC_MR_S is a match value register for the RTC second counter. (offset 0x7; total reset 0x0000003F; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 3.9.7, PDF page 179).";
        regwidth = 8;
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_6[7:6];
        field {
            name = "rtc_mr_s";
            desc = "Match value of the RTC second counter The value range is 0-59.";
            sw = rw; hw = r;
            reset = 0x3f;
        } rtc_mr_s[5:0];
    } RTC_MR_S @ 0x7;
    reg {
        name = "RTC_MR_M";
        desc = "RTC_MR_M is a match value register for the RTC minute counter. (offset 0x8; total reset 0x0000003F; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 3.9.7, PDF page 180).";
        regwidth = 8;
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_6[7:6];
        field {
            name = "rtc_mr_m";
