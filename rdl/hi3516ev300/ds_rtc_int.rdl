            reset = 0x0;
        } reserved_7_5[7:5];
        field {
            name = "rtc_lr_h";
            desc = "Configured value of the RTC hour counter The value range is 0-23.";
            sw = rw; hw = r;
            reset = 0x0;
        } rtc_lr_h[4:0];
    } RTC_LR_H @ 0xF;
    reg {
        name = "RTC_LR_D_L";
        desc = "RTC_LR_D_L is a lower-8-bit configured value register for the RTC day counter. (offset 0x10; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 3.9.7, PDF page 182).";
        regwidth = 8;
        field {
            name = "rtc_lr_d_l";
            desc = "Lower eight bits of the configured value of the RTC day counter. This field works with RTC_LR_D_H to indicate the configured day. The day range is 0-65535.";
            sw = rw; hw = r;
            reset = 0x0;
        } rtc_lr_d_l[7:0];
    } RTC_LR_D_L @ 0x10;
    reg {
        name = "RTC_LR_D_H";
        desc = "RTC_LR_D_H is an upper-8-bit configured value register for the RTC day counter. (offset 0x11; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 3.9.7, PDF page 182).";
        regwidth = 8;
        field {
            name = "rtc_lr_d_h";
            desc = "Upper eight bits of the configured value of the RTC day counter. This field works with RTC_LR_D_L to indicate the configured day. The day range is 0-65535.";
            sw = rw; hw = r;
            reset = 0x0;
        } rtc_lr_d_h[7:0];
    } RTC_LR_D_H @ 0x11;
    reg {
        name = "RTC_LORD";
        desc = "RTC_LORD is an RTC configured value loading enable register. (offset 0x12; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 3.9.7, PDF page 183).";
        regwidth = 8;
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_3[7:3];
        field {
            name = "rtc_lock_bypass";
            desc = "RTC lock enable
- 0: enabled. The RTC count value (0x00-0x05) is updated only after the RTC is successfully locked.
- 1: disabled. The RTC count value (0x00-0x05) is updated in real time.";
            sw = rw; hw = r;
            reset = 0x0;
        } rtc_lock_bypass[2:2];
        field {
            name = "rtc_lock";
            desc = "RTC lock. If software writes 1, hardware is automatically cleared after the RTC is successfully locked. Note: This field is valid only when rtc_lock_bypass is 0.";
            sw = rw; hw = r;
            reset = 0x0;
        } rtc_lock[1:1];
        field {
            name = "rtc_load";
            desc = "RTC configured value loading enable. When the field is enabled, the RTC configured value will be loaded to the RTC accumulator. If software writes 1 to load the configured value, hardware will automatically set this field to 0 after successful loading.";
            sw = rw; hw = r;
            reset = 0x0;
        } rtc_load[0:0];
    } RTC_LORD @ 0x12;
    reg {
        name = "RTC_IMSC";
        desc = "RTC_IMSC is an RTC interrupt enable register. (offset 0x13; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 3.9.7, PDF page 183).";
        regwidth = 8;
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_3[7:3];
        field {
            name = "rtc_imsc";
            desc = "RTC global interrupt output enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } rtc_imsc[2:2];
        field {
            name = "rtc_imsc_uv";
            desc = "Battery low-voltage detection interrupt output enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } rtc_imsc_uv[1:1];
        field {
            name = "rtc_imsc_time";
            desc = "RTC timing interrupt output enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } rtc_imsc_time[0:0];
    } RTC_IMSC @ 0x13;
    reg {
        name = "RTC_INT_CLR";
        desc = "RTC_INT_CLR is an RTC interrupt clear register. (offset 0x14; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 3.9.7, PDF page 184).";
        regwidth = 8;
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_1[7:1];
        field {
            name = "rtc_int_clr";
            desc = "RTC interrupt clear register. Writing any value by software clears the interrupt. Reading back the value has no effect.";
            sw = w; hw = r;
            reset = 0x0;
        } rtc_int_clr[0:0];
    } RTC_INT_CLR @ 0x14;
    reg {
        name = "RTC_MSC_INT";
        desc = "RTC_MSC_INT is an RTC mask interrupt status register. (offset 0x15; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 3.9.7, PDF page 184).";
        regwidth = 8;
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_2[7:2];
        field {
            name = "mask_int_uv";
            desc = "Status of the masked battery low-voltage detection interrupt
- 0: No interrupt is generated.
- 1: An interrupt is generated.";
            sw = r; hw = w;
            reset = 0x0;
        } mask_int_uv[1:1];
        field {
            name = "mask_int_time";
            desc = "Status of the masked RTC timing interrupt
- 0: No interrupt is generated.
- 1: An interrupt is generated.";
            sw = r; hw = w;
            reset = 0x0;
        } mask_int_time[0:0];
    } RTC_MSC_INT @ 0x15;
    reg {
        name = "RTC_RAW_INT";
        desc = "RTC_RAW_INT is an RTC raw interrupt status register. (offset 0x16; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 3.9.7, PDF page 184).";
        regwidth = 8;
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_2[7:2];
        field {
            name = "raw_int_uv";
            desc = "Status of the raw battery low-voltage detection interrupt
- 0: No interrupt is generated.
- 1: An interrupt is generated.";
            sw = r; hw = w;
            reset = 0x0;
        } raw_int_uv[1:1];
        field {
            name = "raw_int_time";
            desc = "Status of the raw RTC timing interrupt
- 0: No interrupt is generated.
- 1: An interrupt is generated.";
            sw = r; hw = w;
            reset = 0x0;
        } raw_int_time[0:0];
    } RTC_RAW_INT @ 0x16;
    reg {
        name = "RTC_CLK";
        desc = "RTC_CLK is an RTC output clock select register. (offset 0x17; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 3.9.7, PDF page 185).";
        regwidth = 8;
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_2[7:2];
        field {
            name = "clk_out_sel";
            desc = "Output test clock of the RTC
- 00: crystal oscillator clock
- 01: corrected 100 Hz clock 1x: 1 Hz clock";
            sw = rw; hw = r;
            reset = 0x0;
        } clk_out_sel[1:0];
    } RTC_CLK @ 0x17;
    reg {
        name = "RTC_POR_N";
        desc = "RTC_POR_N is an RTC reset control register. (offset 0x18; total reset 0x00000001; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 3.9.7, PDF page 185).";
        regwidth = 8;
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_1[7:1];
        field {
            name = "rtc_por_n";
            desc = "RTC reset. This field is automatically set to 1 after the RTC is successfully reset.
- 0: reset";
            sw = rw; hw = r;
            reset = 0x1;
        } rtc_por_n[0:0];
    } RTC_POR_N @ 0x18;
    reg {
        name = "RTC_UV_CTRL";
        desc = "RTC_UV_CTRL is an RTC internal low-voltage detection control register. (offset 0x1A; total reset 0x00000004; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 3.9.7, PDF page 185).";
        regwidth = 8;
        field {
            name = "reserved";
            desc = "Reserved";
