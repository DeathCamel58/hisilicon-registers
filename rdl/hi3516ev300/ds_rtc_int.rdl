            sw = rw; hw = r;
            reset = 0x3f;
        } rtc_mr_m[5:0];
    } RTC_MR_M @ 0x8;
    reg {
        name = "RTC_MR_H";
        desc = "RTC_MR_H is a match value register for the RTC hour counter. (offset 0x9; total reset 0x0000001F; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 3.9.7, PDF page 180).";
        regwidth = 8;
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_5[7:5];
        field {
            name = "rtc_mr_h";
            desc = "Match value of the RTC hour counter The value range is 0-23.";
            sw = rw; hw = r;
            reset = 0x1f;
        } rtc_mr_h[4:0];
    } RTC_MR_H @ 0x9;
    reg {
        name = "RTC_MR_D_L";
        desc = "RTC_MR_D_L is a lower-8-bit match value register for the RTC day counter. (offset 0xA; total reset 0x000000FF; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 3.9.7, PDF page 180).";
        regwidth = 8;
        field {
            name = "rtc_mr_d_l";
            desc = "Lower eight bits of the match value of the RTC day counter. This field works with RTC_MR_D_H to indicate the matched day. The day range is 0-65535.";
            sw = rw; hw = r;
            reset = 0xff;
        } rtc_mr_d_l[7:0];
    } RTC_MR_D_L @ 0xA;
    reg {
        name = "RTC_MR_D_H";
        desc = "RTC_MR_D_H is an upper-8-bit match value register for the RTC day counter. (offset 0xB; total reset 0x000000FF; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 3.9.7, PDF page 181).";
        regwidth = 8;
        field {
            name = "rtc_mr_d_h";
            desc = "Upper eight bits of the match value of the RTC day counter. This field works with RTC_MR_D_L to indicate the matched day. The day range is 0-65535.";
            sw = rw; hw = r;
            reset = 0xff;
        } rtc_mr_d_h[7:0];
    } RTC_MR_D_H @ 0xB;
    reg {
        name = "RTC_LR_10MS";
        desc = "RTC_LR_10MS is a configured value register for the RTC 10 ms counter. (offset 0xC; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 3.9.7, PDF page 181).";
        regwidth = 8;
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_7[7:7];
        field {
            name = "rtc_lr_10ms";
            desc = "Configured value of the RTC 10 ms counter The value range is 0-99.";
            sw = rw; hw = r;
            reset = 0x0;
        } rtc_lr_10ms[6:0];
    } RTC_LR_10MS @ 0xC;
    reg {
        name = "RTC_LR_S";
        desc = "RTC_LR_S is a configured value register for the RTC second counter. (offset 0xD; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 3.9.7, PDF page 181).";
        regwidth = 8;
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_6[7:6];
        field {
            name = "rtc_lr_s";
            desc = "Configured value of the RTC second counter The value range is 0-59.";
            sw = rw; hw = r;
            reset = 0x0;
        } rtc_lr_s[5:0];
    } RTC_LR_S @ 0xD;
    reg {
        name = "RTC_LR_M";
        desc = "RTC_LR_M is a configured value register for the RTC minute counter. (offset 0xE; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 3.9.7, PDF page 181).";
        regwidth = 8;
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_6[7:6];
        field {
            name = "rtc_lr_m";
            desc = "Configured value of the RTC minute counter";
            sw = rw; hw = r;
            reset = 0x0;
        } rtc_lr_m[5:0];
    } RTC_LR_M @ 0xE;
    reg {
        name = "RTC_LR_H";
        desc = "RTC_LR_H is a configured value register for the RTC hour counter. (offset 0xF; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 3.9.7, PDF page 182).";
        regwidth = 8;
        field {
            name = "reserved";
            desc = "Reserved";
