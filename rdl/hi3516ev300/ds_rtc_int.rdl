            reset = 0x0;
        } reserved_7_6[7:6];
        field {
            name = "bat_uv_ctrl_en";
            desc = "Low-voltage detection enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } bat_uv_ctrl_en[5:5];
        field {
            name = "bat_uv_ctrl_sel";
            desc = "Low-voltage detection source select
- 0: no filtering
- 1: filtering";
            sw = rw; hw = r;
            reset = 0x0;
        } bat_uv_ctrl_sel[4:4];
        field {
            name = "bat_uvp_sel";
            desc = "Voltage threshold setting for battery undervoltage detection
- 00: 1.6 V";
            sw = rw; hw = r;
            reset = 0x1;
        } bat_uvp_sel[3:2];
        field {
            name = "sample_time";
            desc = "Low-voltage detection cycle
- 00: 1s
- 01: 1 minute
- 10: 10 minutes
- 11: 30 minutes";
            sw = rw; hw = r;
            reset = 0x0;
        } sample_time[1:0];
    } RTC_UV_CTRL @ 0x1A;
    reg {
        name = "RTC_ANA_CTRL";
        desc = "RTC_ANA_CTRL is an internal low-voltage detection control register for the RTC oscillating current control. Locked by the RTC lock register, this register can be modified only when RTC_LOCK3, RTC_LOCK2, RTC_LOCK1, or RTC_LOCK0 is set to 0x5A5AABCD. (offset 0x1B; total reset 0x00000005; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 3.9.7, PDF page 186).";
        regwidth = 8;
        field {
            name = "rtc_ana_ctrl";
            desc = "RTC oscillating current control
- 0x00: 0.619 μA
- 0x01: 0.722 μA
- 0x02: 0.825 μA
- 0x03: 0.929 μA
- 0x04: 1.031 μA
- 0x05: 1.135 μA
- 0x06: 1.238 μA
- 0x07: 1.341 μA
- 0x0F: 2.166 μA
- 0x17: 2.991 μA
- 0x37: 3.817 μA

Other values: reserved";
            sw = rw; hw = r;
            reset = 0x5;
        } rtc_ana_ctrl[7:0];
    } RTC_ANA_CTRL @ 0x1B;
    reg {
        name = "SDM_COEF_OUSIDE_H";
        desc = "SDM_COEF_OUSIDE_H is an external frequency division coefficient upper four bits register. (offset 0x51; total reset 0x00000008; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 3.9.7, PDF page 186).";
        regwidth = 8;
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_4[7:4];
        field {
            name = "sdm_coef_ouside_h";
            desc = "Upper four bits of the frequency division coefficient in fixed frequency-division mode";
            sw = rw; hw = r;
            reset = 0x8;
        } sdm_coef_ouside_h[3:0];
    } SDM_COEF_OUSIDE_H @ 0x51;
    reg {
        name = "SDM_COEF_OUSIDE_L";
        desc = "SDM_COEF_OUSIDE_L is an external frequency division coefficient lower eight bits register. (offset 0x52; total reset 0x0000001B; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 3.9.7, PDF page 187).";
        regwidth = 8;
        field {
            name = "sdm_coef_ouside_l";
            desc = "Lower eight bits of the frequency division coefficient in fixed frequency-division mode Note: When clock divider registers (addresses of 0x51 and 0x52) are read or written, you need to read or write to the upper four bits and then the lower eight bits continuously. The clock divider is calculated as follows: (f - 32700) x 30.52. f indicates the oscillation frequency of the external crystal and ranges from 32700 to 32799.";
            sw = rw; hw = r;
            reset = 0x1b;
