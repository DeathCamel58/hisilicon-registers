`ifndef HI3516EV300_SPACC_RDL
`define HI3516EV300_SPACC_RDL
regfile eHI3516EV300_SPACC {
    name = "SPACC cipher";
    desc = "SPACC cipher of the Hi3516E V300 at base 0x1005_0000. 34 registers extracted programmatically from the Hi3516E V300 data sheet (Issue 00B06, 2019-05-15) (Table 13-2 Summary of the SPACC registers (base address: 0x1005_0000)): register headings, offsets, total reset values, field bit ranges, access types, names, reset values and descriptions, with PDF page numbers in each register description. Field names, bit ranges, access types and offsets are exact; the free-text descriptions are taken from the cell text of the field table and were checked by sampling only. Hardware not verified.";
    reg {
        name = "CHAN0_CIPHER_IV";
        desc = "CHAN0_CIPHER_IV is the IVin and IVout register for the symmetric algorithm of the channel 0. (offset 0x0; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 13.2.6, PDF page 814).";
        field {
            name = "chan0_cipher_iv";
            desc = "IVin and IVout for the symmetric algorithm of channel 0 (little endian) (1) If the vector configuration update is not required (CHAN0_CIPHER_CTRL[sym_ch0_ivin_sel] ='b0)), the logic does not need to read this register again. (2) If the vector configuration update is required (CHAN0_CIPHER_CTRL[sym_ch0_ivin_sel] ='b1), the logic needs to read this register again.";
            sw = rw; hw = r;
            reset = 0x0;
        } chan0_cipher_iv[31:0];
    } CHAN0_CIPHER_IV @ 0x0;
    reg {
        name = "CHAN0_CIPHER_DOUT";
        desc = "CHAN0_CIPHER_DOUT is the Dout register for the symmetric algorithm of channel 0. (offset 0x80; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 13.2.6, PDF page 815).";
        field {
            name = "chan0_cipher_dout";
            desc = "Channel 0 Dout for the symmetric algorithm (little endian) AES: (1) If the 1-CFB mode is selected, chan0_cipher_dout[0] is valid. (2) If the 8-CFB mode is selected, chan0_cipher_dout[7:0] is valid. (3) If the 128-CFB mode is selected, 128 bits are all valid. (4) In other modes, 128 bits are all valid.";
            sw = r; hw = w;
            reset = 0x0;
        } chan0_cipher_dout[31:0];
    } CHAN0_CIPHER_DOUT @ 0x80;
    reg {
        name = "CIPHER_KEY";
        desc = "CIPHER_KEY is the CPU key register for the symmetric algorithm. (offset 0x100; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 13.2.6, PDF page 816).";
        field {
            name = "cipher_key";
            desc = "CPU key register for the symmetric algorithm (little endian). It cannot be read, that is, the read result is 0. The value of j for each channel is 0-7, that is a total of 256 bits. 0x0100-0x011C correspond to the host key of channel 0. The rule applies to other similar situations. AES algorithm: a) If a 128-bit key is selected, cipher_key[127:0] is valid. b) If a 192-bit key is selected, cipher_key[191:0] is valid. c) If a 256-bit key operation is performed, 256 bits are all valid.";
            sw = w; hw = r;
            reset = 0x0;
        } cipher_key[31:0];
    } CIPHER_KEY @ 0x100;
    reg {
        name = "SPACC_VERSION";
        desc = "SPACC_VERSION is the SPACC version register. (offset 0x308; total reset 0x02018121; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 13.2.6, PDF page 816).";
        field {
            name = "spacc_version";
            desc = "SPACC version register. The macro definition is used.";
            sw = rw; hw = r;
            reset = 0x2018121;
        } spacc_version[31:0];
    } SPACC_VERSION @ 0x308;
    reg {
        name = "MEM_EMA_CFG";
        desc = "MEM_EMA_CFG is the memory EMA configuration register. (offset 0x310; total reset 0x00009B13; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 13.2.6, PDF page 816).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_16[31:16];
        field {
            name = "rft_colldisn";
            desc = "RFT colldisn signal";
            sw = rw; hw = r;
            reset = 0x1;
        } rft_colldisn[15:15];
        field {
            name = "rft_emasa";
            desc = "RFT emasa signal";
            sw = rw; hw = r;
            reset = 0x0;
        } rft_emasa[14:14];
        field {
            name = "rft_emab";
            desc = "RFT emab signal";
            sw = rw; hw = r;
            reset = 0x3;
        } rft_emab[13:11];
        field {
            name = "rft_emaa";
            desc = "RFT emaa signal";
            sw = rw; hw = r;
            reset = 0x3;
        } rft_emaa[10:8];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_6[7:6];
        field {
            name = "rfs_emaw";
            desc = "RFS emaw signal";
            sw = rw; hw = r;
            reset = 0x1;
        } rfs_emaw[5:4];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_3_3[3:3];
        field {
            name = "rfs_ema";
            desc = "RFS ema signal";
            sw = rw; hw = r;
            reset = 0x3;
        } rfs_ema[2:0];
    } MEM_EMA_CFG @ 0x310;
    reg {
        name = "CALC_ERR";
        desc = "CALC_ERR is the alarm status register for the algorithm core. (offset 0x320; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 13.2.6, PDF page 817).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_2[31:2];
        field {
            name = "alg_len_err";
            desc = "When the length of a node is 0, an error is reported.";
            sw = r; hw = w;
            reset = 0x0;
        } alg_len_err[1:1];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_0_0[0:0];
    } CALC_ERR @ 0x320;
    reg {
        name = "CHANN_HASH_STATE_VAL";
        desc = "CHANN_HASH_STATE_VAL is the hash input and output state value register for channel z. (offset 0x340; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 13.2.6, PDF page 817).";
        field {
            name = "hash_state_val";
            desc = "Hash result state value";
            sw = rw; hw = r;
            reset = 0x0;
        } hash_state_val[31:0];
    } CHANN_HASH_STATE_VAL @ 0x340;
    reg {
        name = "CHANN_HASH_STATE_VAL_ADDR";
        desc = "CHANN_HASH_STATE_VAL_ADDR is the hash input and output state value address register for channel z. (offset 0x344; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 13.2.6, PDF page 817).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_3[31:3];
        field {
            name = "hash_state_val_addr";
            desc = "Hash state value address. The maximum length is 8 words, that is, 256 bits.";
            sw = rw; hw = r;
            reset = 0x0;
        } hash_state_val_addr[2:0];
    } CHANN_HASH_STATE_VAL_ADDR @ 0x344;
    reg {
        name = "SPACC_CALC_CRG_CFG";
        desc = "SPACC_CALC_CRG_CFG is the SPACC internal algorithm core clock gating and reset configuration register. (offset 0x39C; total reset 0x801F2AAA; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 13.2.6, PDF page 818).";
        field {
            name = "spacc_core_auto_cken_bypass";
            desc = "Automatic clock gating enable for the algorithm core
- 0: enabled
- 1: disabled";
            sw = rw; hw = r;
            reset = 0x1;
        } spacc_core_auto_cken_bypass[31:31];
        field {
            name = "spacc_rft_mem_wr_clk_gt_en";
            desc = "Automatic write clock gating enable for the RFT memory
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } spacc_rft_mem_wr_clk_gt_en[30:30];
        field {
            name = "spacc_rft_mem_rd_clk_gt_en";
            desc = "Automatic read clock gating enable for the RFT memory
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } spacc_rft_mem_rd_clk_gt_en[29:29];
        field {
            name = "spacc_rfs_mem_clk_gt_en";
            desc = "Automatic clock gating enable for the RFS memory
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } spacc_rfs_mem_clk_gt_en[28:28];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_27_21[27:21];
        field {
            name = "cken_in_ram";
            desc = "Clock enable for the RFT memory
- 0: disabled
- 1: enabled

It is used for internal debugging. For normal use, set the register to 1.";
            sw = rw; hw = r;
            reset = 0x1;
        } cken_in_ram[20:20];
        field {
            name = "cken_in_ram_a";
            desc = "Read port clock enable for the RFT memory
- 0: disabled
- 1: enabled

It is used for internal debugging. For normal use, set the register to 1.";
            sw = rw; hw = r;
            reset = 0x1;
        } cken_in_ram_a[19:19];
        field {
            name = "cken_in_ram_b";
            desc = "Write port clock enable for the RFT memory
- 0: disabled
- 1: enabled

It is used for internal debugging. For normal use, set the register to 1.";
            sw = rw; hw = r;
            reset = 0x1;
        } cken_in_ram_b[18:18];
        field {
            name = "cken_in_pipe_ib";
            desc = "pipe_ib clock enable for the RFT memory
- 0: disabled";
            sw = rw; hw = r;
            reset = 0x1;
        } cken_in_pipe_ib[17:17];
        field {
            name = "cken_in_pipe_i";
            desc = "pipe_i clock enable for the RFT memory
- 0: disabled
- 1: enabled

It is used for internal debugging. For normal use, set the register to 1.";
            sw = rw; hw = r;
            reset = 0x1;
        } cken_in_pipe_i[16:16];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_15_14[15:14];
        field {
            name = "spacc_aes_core_srst_req";
            desc = "AES core soft reset request
- 0: not reset
- 1: reset";
            sw = rw; hw = r;
            reset = 0x0;
        } spacc_aes_core_srst_req[12:12];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0xaa;
        } reserved_11_4[11:4];
        field {
            name = "spacc_sha1_core_clk_en";
            desc = "SHA1 core clock enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x1;
        } spacc_sha1_core_clk_en[3:3];
        field {
            name = "spacc_sha1_core_srst_req";
            desc = "SHA1 core soft reset request
- 0: not reset
- 1: reset";
            sw = rw; hw = r;
            reset = 0x0;
        } spacc_sha1_core_srst_req[2:2];
        field {
            name = "spacc_sha2_core_clk_en";
            desc = "SHA2 core clock enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x1;
        } spacc_sha2_core_clk_en[1:1];
        field {
            name = "spacc_sha2_core_srst_req";
            desc = "SHA2 core soft reset request
- 0: not reset
- 1: reset";
            sw = rw; hw = r;
            reset = 0x0;
        } spacc_sha2_core_srst_req[0:0];
    } SPACC_CALC_CRG_CFG @ 0x39C;
    reg {
        name = "CHAN0_CIPHER_CTRL";
        desc = "CHAN0_CIPHER_CTRL is the encryption/decryption control register for channel 0 of the symmetric algorithm. (offset 0x400; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 13.2.6, PDF page 819).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_16[31:16];
        field {
            name = "sym_ch0_ivin_sel";
            desc = "IVin input select for channel 0
- 0: IVin does not need to be configured.
- 1: IVin needs to be configured.";
            sw = rw; hw = r;
            reset = 0x0;
        } sym_ch0_ivin_sel[15:15];
        field {
            name = "sym_ch0_key_sel";
            desc = "Key source select
- 0: keys configured by the CPU
- 1: keys configured by hardware";
            sw = rw; hw = r;
            reset = 0x0;
        } sym_ch0_key_sel[14:14];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_13_12[13:12];
        field {
            name = "sym_ch0_key_length";
            desc = "Key length AES:
- 00: 128 bits
- 01: 192 bits
- 10: 256 bits
- 11: 128 bits";
            sw = rw; hw = r;
            reset = 0x0;
        } sym_ch0_key_length[11:10];
        field {
            name = "sym_ch0_dat_width";
            desc = "Data bit width AES:
- 00: 128 bits
- 01: 8 bits
- 10: 1 bit
- 11: 128 bits";
            sw = rw; hw = r;
            reset = 0x0;
        } sym_ch0_dat_width[9:8];
        field {
            name = "sym_ch0_decrypt";
            desc = "Encryption or decryption
- 0: 0: encryption
- 1: decryption";
            sw = rw; hw = r;
            reset = 0x0;
        } sym_ch0_decrypt[7:7];
        field {
            name = "sym_ch0_alg_sel";
            desc = "Algorithm select
- 010: AES

Other values: AES";
            sw = rw; hw = r;
            reset = 0x0;
        } sym_ch0_alg_sel[6:4];
        field {
            name = "sym_ch0_alg_mode";
            desc = "Operating mode AES:
- 000: ECB
- 001: CBC
- 010: CFB
- 011: OFB
- 100: CTR

Other values: ECB";
            sw = rw; hw = r;
            reset = 0x0;
        } sym_ch0_alg_mode[3:1];
        field {
            name = "sym_ch0_start";
            desc = "Encryption/Decryption start signal for channel 0 (input transfer end)
- 0: not started (The input transfer is ended.)
- 1: started (The input transfer is not ended.)";
            sw = rw; hw = r;
            reset = 0x0;
        } sym_ch0_start[0:0];
    } CHAN0_CIPHER_CTRL @ 0x400;
    reg {
        name = "CIPHER_INT_STATUS";
        desc = "CIPHER_INT_STATUS is the interrupt status register for the symmetric algorithm. (offset 0x404; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 13.2.6, PDF page 821).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_17[31:17];
        field {
            name = "ahb_bus_err_int";
            desc = "AHB error interrupt
- 0: No interrupt is generated.
- 1: An interrupt is generated.";
            sw = r; hw = w;
            reset = 0x0;
        } ahb_bus_err_int[16:16];
        field {
            name = "cipher_chn_obuf_int";
            desc = "Output queue data interrupt for channel m
- 0: No interrupt is generated.
- 1: An interrupt is generated.

Bits 15-8 correspond to channels 7-0, respectively.";
            sw = r; hw = w;
            reset = 0x0;
        } cipher_chn_obuf_int[15:8];
        field {
            name = "cipher_chn_ibuf_int";
            desc = "Input queue data interrupt for channel n
- 0: No interrupt is generated.
- 1: An interrupt is generated.

Bits 7-1 correspond to channels 7-1, respectively.";
            sw = r; hw = w;
            reset = 0x0;
        } cipher_chn_ibuf_int[7:1];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_0_0[0:0];
    } CIPHER_INT_STATUS @ 0x404;
    reg {
        name = "CIPHER_INT_EN";
        desc = "CIPHER_INT_EN is the interrupt enable register for the symmetric algorithm. (offset 0x408; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 13.2.6, PDF page 821).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_31[31:31];
        field {
            name = "cipher_int_en";
            desc = "Global channel interrupt enable for the Cipher module
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } cipher_int_en[30:30];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_29_17[29:17];
        field {
            name = "ahb_bus_err_int_en";
            desc = "AHB error interrupt enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } ahb_bus_err_int_en[16:16];
        field {
            name = "cipher_chn_obuf_en";
            desc = "Output queue data interrupt enable for channel m
- 0: disabled
- 1: enabled

Bits 15-8 correspond to channels 7-0, respectively.";
            sw = rw; hw = r;
            reset = 0x0;
        } cipher_chn_obuf_en[15:8];
        field {
            name = "cipher_chn_ibuf_en";
            desc = "Input queue data interrupt enable for channel 7
- 0: disabled
- 1: enabled

Bits 7-1 correspond to channels 7-1, respectively.";
            sw = rw; hw = r;
            reset = 0x0;
        } cipher_chn_ibuf_en[7:1];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_0_0[0:0];
    } CIPHER_INT_EN @ 0x408;
    reg {
        name = "CIPHER_INT_RAW";
        desc = "CIPHER_INT_RAW is the interrupt status register for the symmetric algorithm. (offset 0x40C; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 13.2.6, PDF page 822).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_17[31:17];
        field {
            name = "ahb_bus_err_int_raw";
            desc = "AHB error raw interrupt
- 0: No interrupt is generated.
- 1: An interrupt is generated.

Access type RWC in the data sheet: written 1 clears the bit.";
            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } ahb_bus_err_int_raw[16:16];
        field {
            name = "cipher_chn_obuf_raw";
            desc = "Raw output queue data interrupt for channel m
- 0: No interrupt is generated.
- 1: An interrupt is generated.

Bits 15-8 correspond to channels 7-0, respectively.

Access type RWC in the data sheet: written 1 clears the bit.";
            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } cipher_chn_obuf_raw[15:8];
        field {
            name = "cipher_chn_ibuf_raw";
            desc = "Raw input queue data interrupt for channel n
- 0: No interrupt is generated.
- 1: An interrupt is generated.

Bits 7-1 correspond to channels 7-1, respectively.

Access type RWC in the data sheet: written 1 clears the bit.";
            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } cipher_chn_ibuf_raw[7:1];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_0_0[0:0];
    } CIPHER_INT_RAW @ 0x40C;
    reg {
        name = "CHAN0_CIPHER_DIN";
        desc = "CHAN0_CIPHER_DIN is the channel 0 Din register for the symmetric algorithm. (offset 0x420; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 13.2.6, PDF page 823).";
        field {
            name = "chan0_cipher_din";
            desc = "Channel 0 Din for the symmetric algorithm (little endian) AES: (1) If the 1-CFB mode is selected, chan0_cipher_din[0] is valid. (2) If the 8-CFB mode is selected, chan0_cipher_din[7:0] is valid. (3) If the 128-CFB mode is selected, 128 bits are all valid. (4) In other modes, 128 bits are all valid.";
            sw = rw; hw = r;
            reset = 0x0;
        } chan0_cipher_din[31:0];
    } CHAN0_CIPHER_DIN @ 0x420;
    reg {
        name = "CHANN_CIPHER_IN_LEFT_BYTE";
        desc = "CHANN_CIPHER_IN_LEFT_BYTE is the left-byte count register for the current read data for channel n. (offset 0x410; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 13.2.6, PDF page 825).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_4[31:4];
        field {
            name = "in_left_byte";
            desc = "Number of remaining bytes in the read data";
            sw = r; hw = w;
            reset = 0x0;
        } in_left_byte[3:0];
    } CHANN_CIPHER_IN_LEFT_BYTE @ 0x410;
    reg {
        name = "CHANN_CIPHER_IN_LEFT_WORD0";
        desc = "CHANN_CIPHER_IN_LEFT_WORD0 is the left-word register for the current read data of channel n. (offset 0x414; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 13.2.6, PDF page 825).";
        field {
            name = "cipher_in_left_wordFirst0";
            desc = "word in the remaining data";
            sw = r; hw = w;
            reset = 0x0;
        } cipher_in_left_wordFirst0[31:0];
    } CHANN_CIPHER_IN_LEFT_WORD0 @ 0x414;
    reg {
        name = "CHANN_CIPHER_IN_LEFT_WORD1";
        desc = "CHANN_CIPHER_IN_LEFT_WORD1 is the left-word register for the current read data of channel n. (offset 0x418; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 13.2.6, PDF page 826).";
        field {
            name = "cipher_in_left_wordSecond1";
            desc = "word in the remaining data";
            sw = r; hw = w;
            reset = 0x0;
        } cipher_in_left_wordSecond1[31:0];
    } CHANN_CIPHER_IN_LEFT_WORD1 @ 0x418;
    reg {
        name = "CHANN_CIPHER_IN_LEFT_WORD2";
        desc = "CHANN_CIPHER_IN_LEFT_WORD2 is the left-word register for the current read data of channel n. (offset 0x41C; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 13.2.6, PDF page 826).";
        field {
            name = "cipher_in_left_wordThird2";
            desc = "word in the remaining data";
            sw = r; hw = w;
            reset = 0x0;
        } cipher_in_left_wordThird2[31:0];
    } CHANN_CIPHER_IN_LEFT_WORD2 @ 0x41C;
