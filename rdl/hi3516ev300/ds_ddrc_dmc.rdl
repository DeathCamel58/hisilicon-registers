            sw = rw; hw = r;
            reset = 0x2;
        } bl_data[3:0];
    } DDRC_CFG_BLDATA @ 0x148;
    reg {
        name = "DDRC_CFG_DMCLVL";
        desc = "DDRC_CFG_DMCLVL is the DDRC command queue depth threshold configuration register. (offset 0x14C; total reset 0x00000008; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 4.1.7.2, PDF page 269).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_13[31:13];
        field {
            name = "mbist_que_level";
            desc = "Number of command buffers started by the DMC when the MTEST or MCLR function is used
- 0x0: 1 0x1-0x10: 1-16. The maximum value is related to the code.";
            sw = rw; hw = r;
            reset = 0x0;
        } mbist_que_level[12:8];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_5[7:5];
        field {
            name = "que_level";
            desc = "Depth of the command register FIFO in the DMC 0x1-0x10: depth of n commands Other values: reserved";
            sw = rw; hw = r;
            reset = 0x16;
        } que_level[4:0];
    } DDRC_CFG_DMCLVL @ 0x14C;
    reg {
        name = "DDRC_CFG_DDRPHY";
        desc = "DDRC_CFG_DDRPHY is the DDR SDRAM I/O configuration register. (offset 0x200; total reset 0x001F1000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 4.1.7.2, PDF page 269).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_21[31:21];
        field {
            name = "wr_busy_dly";
            desc = "Gating enable for the data beat in the PHY The value of this field must be greater than (WL + 2). This field can be set to 0x1F in scenarios that do not have high requirements on power consumption.";
            sw = rw; hw = r;
            reset = 0x1f;
        } wr_busy_dly[20:16];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_15_13[15:13];
        field {
            name = "phy_upden";
            desc = "Enable of the DDRC response to dfi_phyupd_en of the DDR PHY
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x1;
        } phy_upden[12:12];
        field {
            name = "trdlat";
            desc = "Inherent delay of the DDR PHY 0x0-0xF: (n + 1) clock cycles";
            sw = rw; hw = r;
            reset = 0x0;
        } trdlat[11:8];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_0[7:0];
    } DDRC_CFG_DDRPHY @ 0x200;
};
`endif
