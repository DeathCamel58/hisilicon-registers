            reset = 0x0;
        } trp_ab[4:0];
    } DDRC_CFG_TIMING8 @ 0x120;
    reg {
        name = "DDRC_CFG_BLDATA";
        desc = "DDRC_CFG_BLDATA is the DDRC pre-received write data configuration register. (offset 0x148; total reset 0x00000002; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 4.1.7.2, PDF page 268).";
        field {
            name = "reserved";
