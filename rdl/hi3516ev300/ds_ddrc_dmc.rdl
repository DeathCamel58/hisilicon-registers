            sw = r; hw = w;
            reset = 0xf2018;
        } reserved_19_0[19:0];
    } DDRC_CFG_TIMING4 @ 0x110;
    reg {
        name = "DDRC_CFG_TIMING5";
        desc = "DDRC_CFG_TIMING5 is DDRC timing parameter register 5. (offset 0x114; total reset 0x1113FF1F; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 4.1.7.2, PDF page 266).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x1113;
        } reserved_31_16[31:16];
        field {
            name = "tzqcs";
            desc = "ZQCS calibration delay cycle 0x0-0xFF: (n x 2) clock cycles The field value must be greater than or equal to 10 because of the DMC design.";
            sw = rw; hw = r;
            reset = 0xff;
        } tzqcs[15:8];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_5[7:5];
        field {
            name = "twr";
            desc = "Number of wait cycles of write recovery 0x0-0x1: one clock cycle 0x2-0x1F: n clock cycles When the DFS is required, tWR must be set based on the highest chip frequency that may be used. tWR cannot be changed when the DDR SDRAM frequency changes.";
            sw = rw; hw = r;
            reset = 0x1f;
        } twr[4:0];
    } DDRC_CFG_TIMING5 @ 0x114;
    reg {
        name = "DDRC_CFG_TIMING6";
        desc = "DDRC_CFG_TIMING6 is DDRC timing parameter register 6. (offset 0x118; total reset 0x000000FF; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 4.1.7.2, PDF page 266).";
        field {
            name = "tccd_nsw";
            desc = "Minimum interval between two inconsecutive write operations when the 2T preamble or 2T postamble is enabled 0x0-0x1: one clock cycle 0x2-0xF: n clock cycles";
            sw = rw; hw = r;
            reset = 0x0;
        } tccd_nsw[31:28];
        field {
            name = "tccd_nsr";
            desc = "Minimum interval between two inconsecutive read operations when the 2T preamble or 2T postamble is enabled 0x0-0x1: one clock cycle 0x2-0xF: n clock cycles";
            sw = rw; hw = r;
            reset = 0x0;
        } tccd_nsr[27:24];
        field {
            name = "trrd_l";
