            sw = rw; hw = r;
            reset = 0x0;
        } rnk_trtw[7:4];
        field {
            name = "rnk_twtr";
            desc = "Write-to-read delay between ranks";
            sw = rw; hw = r;
            reset = 0x0;
        } rnk_twtr[3:0];
    } DDRC_CFG_TIMING7 @ 0x11C;
    reg {
        name = "DDRC_CFG_TIMING8";
        desc = "DDRC_CFG_TIMING8 is DDRC timing parameter register 8. (offset 0x120; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 4.1.7.2, PDF page 268).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_28[31:28];
        field {
            name = "trfc_ab";
            desc = "Number of wait cycles from the auto-refresh command cycle (AREF period) or auto-refresh (AREF) to the ACT command. This field value is set to set to max{trfc, tzqcs}.
- 0x00: Reserved 0x01-0x1FF: n clock cycles";
            sw = rw; hw = r;
            reset = 0x0;
        } trfc_ab[27:19];
        field {
            name = "trfc_pb";
