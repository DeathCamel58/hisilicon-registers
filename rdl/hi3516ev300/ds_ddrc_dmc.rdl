            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_28[31:28];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_27_24[27:24];
        field {
            name = "dimm_trtr";
            desc = "Extra delay of read-to-read switching between DIMMs based on rnk_trtr, for matching the maximum skew between DIMMs";
            sw = rw; hw = r;
            reset = 0x0;
        } dimm_trtr[23:20];
        field {
            name = "dimm_twtw";
