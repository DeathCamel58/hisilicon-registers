    } DDRC_CFG_TIMING6 @ 0x118;
    reg {
        name = "DDRC_CFG_TIMING7";
        desc = "DDRC_CFG_TIMING7 is DDRC timing parameter register 7. (offset 0x11C; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 4.1.7.2, PDF page 267).";
        field {
