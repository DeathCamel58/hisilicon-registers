        field {
            name = "cipher_srst_req";
            desc = "Cipher (SPACC-like v1.0) reset. PROVEN.";
            sw = rw;
            hw = r;
        } cipher_srst_req[8:8];
        field {
            name = "cipher_cken";
            desc = "Cipher clock enable. PROVEN.";
            sw = rw;
            hw = r;
        } cipher_cken[9:9];
    } PERI_CRG104 @ 0x1A0;

    reg {
        name = "UART / I2C clock gates (per the OpenIPC clock driver)";
        desc = "Evidence: INFERRED (clk-hi3516ev300.c: UART0..2 gates bits 0..2, I2C0..2 gates bits 11..13). CONFLICT: the vendor U-Boot platform.h puts a UART clock select (UART_CLK_SEL [19:18], values 0 = APB, 1 = 24 MHz, 2 = 2 MHz) in this register, while the clock driver has the UART selectors in PERI_CRG111 [20:18]; the vendor U-Boot has never been proven to run its select on this chip (the macro looks inherited). Resolve with a board read.";
        field {
            name = "uart0_cken";
            desc = "UART0 clock gate. INFERRED.";
            sw = rw;
            hw = r;
        } uart0_cken[0:0];
        field {
            name = "uart1_cken";
            desc = "UART1 clock gate. INFERRED.";
            sw = rw;
            hw = r;
        } uart1_cken[1:1];
        field {
            name = "uart2_cken";
            desc = "UART2 clock gate. INFERRED.";
            sw = rw;
            hw = r;
        } uart2_cken[2:2];
        field {
            name = "i2c0_cken";
            desc = "I2C0 clock gate. INFERRED.";
            sw = rw;
            hw = r;
        } i2c0_cken[11:11];
        field {
            name = "i2c1_cken";
            desc = "I2C1 clock gate. INFERRED.";
            sw = rw;
            hw = r;
        } i2c1_cken[12:12];
        field {
            name = "i2c2_cken";
            desc = "I2C2 clock gate. INFERRED.";
            sw = rw;
            hw = r;
        } i2c2_cken[13:13];
    } PERI_CRG110 @ 0x1B8;

    reg {
        name = "SPI / LSADC / UART clock selection";
        desc = "Evidence: PROVEN for the OTP clock bit 1 (vendor cipher driver) and for SPI0 clock gate bit 12 (Goke sys_config.c spi0_pin_mux sets 'SPI0 clock for LCD' at crg + 0x1BC bit 12); INFERRED for SPI1 bit 13 and the UART selectors [20:18] (clock driver uart_mux: 0 = 24 MHz, 1 = 6 MHz); the LSADC reset is bit 2 per the vendor DT (resets <crg 0x1bc 2>).";
        field {
            name = "otp_cken";
            desc = "OTP controller clock enable (cipher driver REG_SYS_OTP_CLK_ADDR_PHY 0x120101BC, OTP_CRG_CLOCK_BIT 1<<1; the Xiongmai boot table clears the register first). PROVEN.";
            sw = rw;
            hw = r;
        } otp_cken[1:1];
        field {
            name = "lsadc_srst_req";
            desc = "LSADC reset (DT 'lsadc-crg'). PROVEN (DT).";
            sw = rw;
            hw = r;
        } lsadc_srst_req[2:2];
        field {
            name = "spi0_cken";
            desc = "SPI0 clock gate. PROVEN.";
            sw = rw;
            hw = r;
        } spi0_cken[12:12];
        field {
            name = "spi1_cken";
            desc = "SPI1 clock gate. INFERRED.";
            sw = rw;
            hw = r;
        } spi1_cken[13:13];
        field {
            name = "uart_cksel";
            desc = "UART0..2 clock select, one bit each: 0 = 24 MHz, 1 = 6 MHz. INFERRED (clock driver).";
            sw = rw;
            hw = r;
        } uart_cksel[20:18];
    } PERI_CRG111 @ 0x1BC;

    reg {
        name = "MMC/SDIO controller clock and reset";
        desc = "Layout from the vendor U-Boot (drivers/mmc/hisi_hi3516ev300.c: REG_EMMC_CRG 0x1F4; SDIO1 0x22C) and the vendor DT (resets crg 0x1f4 bits 27 and 29). The SDHCI card clock mux: 0 = 100 kHz, 1 = 400 kHz, 2 = 25 MHz, 3 = 50 MHz, 4 = 90 MHz, 5 = 112 MHz, 6 = 150 MHz, 7 = 198 MHz (U-Boot table; the Linux driver lists only 0..6). Evidence: PROVEN (vendor source).";
        field {
            name = "sample_dll_slave_en";
            desc = "Sampling DLL slave enable (SDIO_SAMPL_DLL_SLAVE_EN). PROVEN.";
            sw = rw;
            hw = r;
        } sample_dll_slave_en[16:16];
        field {
