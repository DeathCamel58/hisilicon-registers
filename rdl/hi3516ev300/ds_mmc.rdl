`ifndef HI3516EV300_MMC_RDL
`define HI3516EV300_MMC_RDL
regfile eHI3516EV300_MMC {
    name = "eMMC/SDIO controller";
    desc = "eMMC/SDIO controller of the Hi3516E V300 at base 0x1001_0000. 42 registers extracted programmatically from the Hi3516E V300 data sheet (Issue 00B06, 2019-05-15) (Table 12-15 Summary of MMC registers (eMMC/SDIO0 base address: 0x1001_0000; SDIO1): register headings, offsets, total reset values, field bit ranges, access types, names, reset values and descriptions, with PDF page numbers in each register description. Field names, bit ranges, access types and offsets are exact; the free-text descriptions are taken from the cell text of the field table and were checked by sampling only. Hardware not verified.";
    reg {
        name = "SDMASA_R";
        desc = "SDMASA_R is an SDMA system address register. (offset 0x0; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 12.4.4, PDF page 711).";
        field {
            name = "blockcnt_sdmasa";
            desc = "When Host Version Enable is set to 0, the register indicates the SDMA system address. When Host Version Enable is set to 1, the register indicates the block count. The value 1 indicates one block.";
            sw = rw; hw = r;
            reset = 0x0;
        } blockcnt_sdmasa[31:0];
    } SDMASA_R @ 0x0;
    reg {
        name = "BLOCKSIZE_R";
        desc = "BLOCKSIZE_R is a block size register. (offset 0x4; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 12.4.4, PDF page 712).";
        regwidth = 16;
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_15_15[15:15];
        field {
            name = "sdma_buf_bdary";
            desc = "Boundary value of an SDMA data block
- 000: 4K bytes
- 001: 8K bytes ...
- 111: 512K bytes";
            sw = rw; hw = r;
            reset = 0x0;
        } sdma_buf_bdary[14:12];
        field {
            name = "xfer_block_size";
            desc = "Transferred block size
- 0x800: 2048 bytes";
            sw = rw; hw = r;
            reset = 0x0;
        } xfer_block_size[11:0];
    } BLOCKSIZE_R @ 0x4;
    reg {
        name = "BLOCKCOUNT_R";
        desc = "BLOCKCOUNT_R is a block count register. (offset 0x6; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 12.4.4, PDF page 712).";
        regwidth = 16;
        field {
            name = "block_cnt";
            desc = "Block count
- 0x1: 1 ...
- 0xFFFF: 65,535";
            sw = rw; hw = r;
            reset = 0x0;
        } block_cnt[15:0];
    } BLOCKCOUNT_R @ 0x6;
    reg {
        name = "ARGUMENT_R";
        desc = "ARGUMENT_R is an SD card or eMMC command content register. (offset 0x8; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 12.4.4, PDF page 713).";
        field {
            name = "argument";
            desc = "Content value of the 32-bit command";
            sw = rw; hw = r;
            reset = 0x0;
        } argument[31:0];
    } ARGUMENT_R @ 0x8;
    reg {
        name = "XFER_MODE_R";
        desc = "XFER_MODE_R is a transfer mode command register. (offset 0xC; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 12.4.4, PDF page 713).";
        regwidth = 16;
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_15_9[15:9];
        field {
            name = "resp_int_disable";
            desc = "Response interrupt disable
- 0: enabled
- 1: disabled";
            sw = rw; hw = r;
            reset = 0x0;
        } resp_int_disable[8:8];
        field {
            name = "resp_err_chk_enable";
            desc = "Response error check enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } resp_err_chk_enable[7:7];
        field {
            name = "resp_type";
            desc = "Response R1/R5 type
- 0: R1
- 1: R5";
            sw = rw; hw = r;
            reset = 0x0;
        } resp_type[6:6];
        field {
            name = "multi_blk_sel";
            desc = "Multiple/single block select
- 0: single block
- 1: multiple blocks";
            sw = rw; hw = r;
            reset = 0x0;
        } multi_blk_sel[5:5];
        field {
            name = "data_xfer_dir";
            desc = "Data transfer direction
- 0: from the controller to the card
- 1: from the card to the controller";
            sw = rw; hw = r;
            reset = 0x0;
        } data_xfer_dir[4:4];
        field {
            name = "auto_cmd_enable";
            desc = "Auto command enable
- 00: disabled
- 01: auto CMD12 enabled
- 10: auto CMD23 enabled
- 11: auto CMD auto select (The value is fixed at 00 in the SDIO.)";
            sw = rw; hw = r;
            reset = 0x0;
        } auto_cmd_enable[3:2];
        field {
            name = "block_count_enable";
            desc = "Block count enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } block_count_enable[1:1];
        field {
            name = "dma_enable";
            desc = "DMA enable";
            sw = rw; hw = r;
            reset = 0x0;
        } dma_enable[0:0];
    } XFER_MODE_R @ 0xC;
    reg {
        name = "CMD_R";
        desc = "CMD_R is a transfer mode command register. (offset 0xE; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 12.4.4, PDF page 714).";
        regwidth = 16;
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_15_14[15:14];
        field {
            name = "cmd_index";
            desc = "Command index";
            sw = rw; hw = r;
            reset = 0x0;
        } cmd_index[13:8];
        field {
            name = "cmd_type";
            desc = "Command type
- 00: normal command
- 01: suspend command
- 10: resume command
- 11: abort command";
            sw = rw; hw = r;
            reset = 0x0;
        } cmd_type[7:6];
        field {
            name = "data_present_sel";
            desc = "Data transmission select
- 0: No data is transmitted.
- 1: Data is transmitted.";
            sw = rw; hw = r;
            reset = 0x0;
        } data_present_sel[5:5];
        field {
            name = "cmd_idx_chk_enable";
            desc = "Command ID check enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } cmd_idx_chk_enable[4:4];
        field {
            name = "cmd_crc_chk_enable";
            desc = "Command cyclic redundancy check (CRC) enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } cmd_crc_chk_enable[3:3];
        field {
            name = "sub_cmd_flag";
            desc = "Subcommand flag
- 0: main
- 1: subcommand";
            sw = rw; hw = r;
            reset = 0x0;
        } sub_cmd_flag[2:2];
        field {
            name = "resp_type_select";
            desc = "Response type
- 00: no response
- 01: response length 136
- 10: response length 48
- 11: response length 48 check";
            sw = rw; hw = r;
            reset = 0x0;
        } resp_type_select[1:0];
    } CMD_R @ 0xE;
    reg {
        name = "RESP01_R";
        desc = "RESP01_R is a RESP 0/1 register. (offset 0x10; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 12.4.4, PDF page 715).";
        field {
            name = "resp01";
            desc = "RESP 0/1 register. This register stores the content of the response bits [39:8] of the send command of the controller.";
            sw = r; hw = w;
            reset = 0x0;
        } resp01[31:0];
    } RESP01_R @ 0x10;
    reg {
        name = "RESP23_R";
        desc = "RESP23_R is a RESP 2/3 register. (offset 0x14; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 12.4.4, PDF page 715).";
        field {
            name = "resp23";
            desc = "RESP 2/3 register. This register stores the content of the response bits [71:40] of the send command of the controller.";
            sw = r; hw = w;
            reset = 0x0;
        } resp23[31:0];
    } RESP23_R @ 0x14;
    reg {
        name = "RESP45_R";
        desc = "RESP45_R is a RESP 4/5 register. (offset 0x18; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 12.4.4, PDF page 715).";
        field {
            name = "resp45";
            desc = "RESP 4/5 register. This register stores the content of the response bits [103:72] of the send command of the controller.";
            sw = r; hw = w;
            reset = 0x0;
        } resp45[31:0];
    } RESP45_R @ 0x18;
    reg {
        name = "RESP67_R";
        desc = "RESP67_R is a RESP 6/7 register. (offset 0x1C; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 12.4.4, PDF page 715).";
        field {
            name = "resp67";
            desc = "RESP 6/7 register. This register stores the content of the response bits [135:104] of the send command of the controller.";
            sw = r; hw = w;
            reset = 0x0;
        } resp67[31:0];
    } RESP67_R @ 0x1C;
    reg {
        name = "BUF_DATA_R";
        desc = "BUF_DATA_R is a buffer data register. (offset 0x20; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 12.4.4, PDF page 716).";
        field {
            name = "buf_data";
            desc = "In slave mode, the buffer used to store the RX data and TX data in the controller writes data to the card by continuously writing data to this register and read data from the card by continuously reading data in this register.";
            sw = rw; hw = r;
            reset = 0x0;
        } buf_data[31:0];
    } BUF_DATA_R @ 0x20;
    reg {
        name = "PSTATE_R";
        desc = "PSTATE_R is a current state register. (offset 0x24; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 12.4.4, PDF page 716).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_28[31:28];
        field {
            name = "cmd_issue_err";
            desc = "Command issuing error
- 0: There is no command issuing error.
- 1: The command cannot be issued.";
            sw = r; hw = w;
            reset = 0x0;
        } cmd_issue_err[27:27];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_26_25[26:25];
        field {
            name = "cmd_line_lvl";
            desc = "Level state the command pin
- 0: low
- 1: high";
            sw = r; hw = w;
            reset = 0x0;
        } cmd_line_lvl[24:24];
        field {
            name = "sd_dat_in[3:0]";
            desc = "State of the data[3:0] pin, corresponding to each bit 0 The data pin is in low level.
- 1: The data pin is in high level.";
            sw = r; hw = w;
            reset = 0x0;
        } sd_dat_in_3_0[23:20];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_19_19[19:19];
        field {
            name = "Card_detect_pin_lvl";
            desc = "Card_detect_npin state
- 0: The Card_detect_n pin is in low level.
- 1: The Card_detect_n pin is in high level.";
            sw = r; hw = w;
            reset = 0x0;
        } Card_detect_pin_lvl[18:18];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_17_12[17:12];
        field {
            name = "buf_rd_enable";
            desc = "Buffer read enable
- 0: disabled";
            sw = r; hw = w;
            reset = 0x0;
        } buf_rd_enable[11:11];
        field {
            name = "buf_wr_enable";
            desc = "Buffer write enable
- 0: disabled
- 1: enabled";
            sw = r; hw = w;
            reset = 0x0;
        } buf_wr_enable[10:10];
        field {
            name = "Rd_xfer_active";
            desc = "Read transfer active
- 0: No data is transferred (idle state).
- 1: Data is being read.";
            sw = r; hw = w;
            reset = 0x0;
        } Rd_xfer_active[9:9];
        field {
            name = "Wr_xfer_active";
            desc = "Write transfer active
- 0: No data is transferred (idle state).
- 1: Data is being written.";
            sw = r; hw = w;
            reset = 0x0;
        } Wr_xfer_active[8:8];
        field {
            name = "sd_dat_in[7:4]";
            desc = "State of the data[7:4] pin, corresponding to each bit
- 0: The data pin is in low level.
- 1: The data pin is in high level.";
            sw = r; hw = w;
            reset = 0x0;
        } sd_dat_in_7_4[7:4];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_3_3[3:3];
        field {
            name = "Dat_line_active";
            desc = "Data line active
- 0: No data is transmitted (idle state).
- 1: Data is being transmitted.";
            sw = r; hw = w;
            reset = 0x0;
        } Dat_line_active[2:2];
        field {
            name = "cmd_inhibit_dat";
            desc = "Flag indicating whether the command with data is active
- 0: No data is transmitted (idle state).

Commands with data can be transmitted.
- 1: Data line is transmitting data or the read operation is being valid.";
            sw = r; hw = w;
            reset = 0x0;
        } cmd_inhibit_dat[1:1];
        field {
            name = "cmd_inhibit";
            desc = "Data line active
- 0: idle state. The controller can send commands.
- 1: busy state. The controller cannot send commands.";
            sw = r; hw = w;
            reset = 0x0;
        } cmd_inhibit[0:0];
    } PSTATE_R @ 0x24;
    reg {
        name = "HOST_CTRL1_R";
        desc = "HOST_CTRL1_R is HOST control 1 register. (offset 0x28; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 12.4.4, PDF page 717).";
        regwidth = 8;
        field {
            name = "card_detect_sig_lvl";
            desc = "Card detection signal select";
            sw = rw; hw = r;
            reset = 0x0;
        } card_detect_sig_lvl[7:7];
        field {
            name = "card_detect_test_lvl";
            desc = "Test level for card detection
- 0: No card is inserted.
- 1: A card is inserted.";
            sw = rw; hw = r;
            reset = 0x0;
        } card_detect_test_lvl[6:6];
        field {
            name = "ext_dat_xfer";
            desc = "Bit width of the extended data transfer
- 0: selected by dat_xfer_width
- 1: 8 bits";
            sw = rw; hw = r;
            reset = 0x0;
        } ext_dat_xfer[5:5];
        field {
            name = "dma_sel";
            desc = "DMA select When Host Version 4 Enable in the HOST_CTRL2_R register is set to 1:
- 00: SDMA
- 01: reserved
- 10: ADMA2
- 11: ADMA2 or ADMA3

When Host Version 4 Enable in the HOST_CTRL2_R register is set to 0:
- 00: SDMA
- 01: reserved
- 10: 32-bit address ADMA2
- 11: 64-bit address ADMA2";
            sw = rw; hw = r;
            reset = 0x0;
        } dma_sel[4:3];
        field {
            name = "high_speed_en";
            desc = "High speed enable
- 0: normal speed
- 1: high speed";
            sw = rw; hw = r;
            reset = 0x0;
        } high_speed_en[2:2];
        field {
            name = "dat_xfer_width";
            desc = "TX data bit width
- 0: 1 bit
- 1: 4 bits";
            sw = rw; hw = r;
            reset = 0x0;
        } dat_xfer_width[1:1];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_0_0[0:0];
    } HOST_CTRL1_R @ 0x28;
    reg {
        name = "PWR_CTRL_R";
        desc = "PWR_CTRL_R is a host basic configuration control register. (offset 0x29; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 12.4.4, PDF page 718).";
        regwidth = 8;
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_1[7:1];
        field {
            name = "sd_bus_pwr_vdd1";
            desc = "VDD2 power enable
- 0: powered off
- 1: powered on";
            sw = rw; hw = r;
            reset = 0x0;
        } sd_bus_pwr_vdd1[0:0];
    } PWR_CTRL_R @ 0x29;
    reg {
        name = "WUP_CTRL_R";
        desc = "WUP_CTRL_R is a wakeup control register. (offset 0x2B; total reset 0x00000020; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 12.4.4, PDF page 719).";
        regwidth = 8;
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_6[7:6];
        field {
            name = "sd_vdd1_on_polarity";
            desc = "sd_vdd1_on polarity control
- 0: positive
- 1: negative";
            sw = rw; hw = r;
            reset = 0x1;
        } sd_vdd1_on_polarity[5:5];
        field {
            name = "Write_prot_polarity";
            desc = "Write_protect polarity control
- 0: positive
- 1: negative";
            sw = rw; hw = r;
            reset = 0x0;
        } Write_prot_polarity[4:4];
        field {
            name = "card_detect_polarity";
            desc = "Card_detect polarity control
- 0: positive
- 1: negative";
            sw = rw; hw = r;
            reset = 0x0;
        } card_detect_polarity[3:3];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_2_0[2:0];
    } WUP_CTRL_R @ 0x2B;
    reg {
        name = "CLK_CTRL_R";
        desc = "CLK_CTRL_R is a clock control register. (offset 0x2C; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 12.4.4, PDF page 719).";
        regwidth = 16;
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_15_4[15:4];
        field {
            name = "pll_enable";
            desc = "PLL enable
- 0: The PLL is in low power mode.
- 1: The PLL is enabled.";
            sw = rw; hw = r;
            reset = 0x0;
        } pll_enable[3:3];
        field {
            name = "sd_clk_en";
            desc = "SD/eMMC clock enable
- 0: disabled";
            sw = rw; hw = r;
            reset = 0x0;
        } sd_clk_en[2:2];
        field {
            name = "internal_clk_statable";
            desc = "Internal clock state
- 0: unstable
- 1: stable";
            sw = r; hw = w;
            reset = 0x0;
        } internal_clk_statable[1:1];
        field {
            name = "internal_clk_en";
            desc = "Internal clock enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x1;
        } internal_clk_en[0:0];
    } CLK_CTRL_R @ 0x2C;
    reg {
        name = "TOUT_CTRL_R";
        desc = "TOUT_CTRL_R is a timeout control register. (offset 0x2E; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 12.4.4, PDF page 720).";
        regwidth = 8;
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_4[7:4];
        field {
            name = "tout_cnt";
            desc = "Data timeout count
- 0x0: TMCLK x 2^13
- 0xe: TMCLK x 2^27

Other values: reserved";
            sw = rw; hw = r;
            reset = 0x0;
        } tout_cnt[3:0];
    } TOUT_CTRL_R @ 0x2E;
    reg {
        name = "SW_RST_R";
        desc = "SW_RST_R is a soft reset control register. (offset 0x2F; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 12.4.4, PDF page 720).";
        regwidth = 8;
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_3[7:3];
        field {
            name = "sw_rst_dat";
            desc = "Data line request for soft reset
- 0: reset deasserted
- 1: reset";
            sw = rw; hw = r;
            reset = 0x0;
        } sw_rst_dat[2:2];
        field {
            name = "sw_rst_cmd";
            desc = "Command line request for soft reset
- 0: reset deasserted
- 1: reset";
            sw = rw; hw = r;
            reset = 0x0;
        } sw_rst_cmd[1:1];
        field {
            name = "sw_rst_all";
            desc = "Controller request for soft reset
- 0: reset deasserted";
            sw = rw; hw = r;
            reset = 0x0;
        } sw_rst_all[0:0];
    } SW_RST_R @ 0x2F;
    reg {
        name = "NORMAL_INT_STAT_R";
        desc = "NORMAL_INT_STAT_R is a normal interrupt status register. (offset 0x30; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 12.4.4, PDF page 721).";
        regwidth = 16;
        field {
            name = "err_interrupt";
            desc = "Error interrupt status
- 0: No interrupt is generated.
- 1: An interrupt is generated.";
            sw = r; hw = w;
            reset = 0x0;
        } err_interrupt[15:15];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_14_14[14:14];
        field {
            name = "fx_event";
            desc = "TX event interrupt status
- 0: No interrupt is generated.
- 1: An interrupt is generated.";
            sw = r; hw = w;
            reset = 0x0;
        } fx_event[13:13];
        field {
            name = "re_tune_event";
            desc = "Retuning event interrupt status
- 0: No interrupt is generated.
- 1: An interrupt is generated.";
            sw = r; hw = w;
            reset = 0x0;
        } re_tune_event[12:12];
        field {
            name = "int_c";
            desc = "INT_C interrupt status
- 0: No interrupt is generated.
- 1: An interrupt is generated.";
            sw = r; hw = w;
            reset = 0x0;
        } int_c[11:11];
        field {
            name = "int_b";
            desc = "INT_B interrupt status
- 0: No interrupt is generated.
- 1: An interrupt is generated.";
            sw = r; hw = w;
            reset = 0x0;
        } int_b[10:10];
        field {
            name = "int_a";
            desc = "INT_A interrupt status
- 0: No interrupt is generated.
- 1: An interrupt is generated.";
            sw = r; hw = w;
            reset = 0x0;
        } int_a[9:9];
        field {
