            sw = w; hw = r;
            reset = 0x0;
        } validate_boot[7:7];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_6_1[6:1];
        field {
            name = "man_boot_en";
            desc = "Forcible boot enable. This bit must be configured together with validate_boot. It is automatically cleared after the boot transfer is complete.
- 0: There is no effect.
- 1: The boot enable is valid.";
            sw = rw; hw = r;
            reset = 0x0;
        } man_boot_en[0:0];
    } BOOT_CTRL_R @ 0x52E;
    reg {
        name = "GP_OUT_R";
        desc = "GP_OUT_R is an eMMC reset and GPIO register. (offset 0x534; total reset 0x00000001; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 12.4.4, PDF page 740).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_1[31:1];
        field {
            name = "emmc_rst_n";
            desc = "eMMC card reset signal
- 0: reset
- 1: not reset";
            sw = rw; hw = r;
            reset = 0x1;
        } emmc_rst_n[0:0];
    } GP_OUT_R @ 0x534;
    reg {
        name = "AT_CTRL_R";
        desc = "AT_CTRL_R is a tuning control register. (offset 0x540; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 12.4.4, PDF page 740).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_5[31:5];
        field {
            name = "sw_tuning_en";
            desc = "Software configuration tuning enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } sw_tuning_en[4:4];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_3_0[3:0];
    } AT_CTRL_R @ 0x540;
    reg {
        name = "AT_STAT_R";
        desc = "AT_STAT_R is a tuning status register. (offset 0x544; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 12.4.4, PDF page 740).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_8[31:8];
        field {
            name = "sw_ph_sel_code";
            desc = "Phase value of the software configuration";
            sw = rw; hw = r;
            reset = 0x0;
        } sw_ph_sel_code[7:0];
    } AT_STAT_R @ 0x544;
};
`endif
