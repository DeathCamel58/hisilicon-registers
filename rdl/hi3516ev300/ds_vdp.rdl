    reg {
        name = "GFX_CKEY_MASK";
        desc = "GFX_CKEY_MASK is a masked colorkey register (non-instant register). The value 1 indicates that the bit corresponding to a pixel is retained during colorkey comparison; the value 0 indicates that the bit corresponding to a pixel is forcibly set to 0 during color comparison no matter whether the bit is 0 or 1. (offset 0x10F08; total reset 0x00FFFFFF; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 9.2.6, PDF page 499).";
