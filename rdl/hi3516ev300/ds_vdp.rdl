            sw = rw; hw = r;
            reset = 0x0;
        } ireso_w[15:0];
    } VID_IN_RESO @ 0x1024C;
    reg {
        name = "GFX_OUT_CTRL";
        desc = "GFX_OUT_CTRL is a GFX FDR output control register (non-instant register). (offset 0x10E08; total reset 0x00000001; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 9.2.6, PDF page 496).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_11[31:11];
        field {
            name = "premulti_en";
            desc = "GFX premultiplication enable register
- 0: enabled
- 1: disabled";
            sw = rw; hw = r;
            reset = 0x0;
        } premulti_en[10:10];
        field {
            name = "bitext";
            desc = "Bit extend mode of the input bitmap
- 00: extend 0s to lower bits
- 10: extend the value of the MSB to a lower bit
- 11: extend the values of upper bits to lower bits";
            sw = rw; hw = r;
            reset = 0x0;
        } bitext[9:8];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_6[7:6];
        field {
            name = "key_en";
            desc = "Colorkey enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } key_en[5:5];
        field {
            name = "key_mode";
            desc = "Colorkey mode
- 0: The color is regarded as the colorkey when the following condition is met: Keymin ≤

Pixel ≤ Keymax
- 1: The color is regarded as the colorkey when either of the following conditions is met: Pixel ≤ Keymin or Pixel ≥ Keymax";
            sw = rw; hw = r;
            reset = 0x0;
        } key_mode[4:4];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_3_2[3:2];
        field {
            name = "palpha_en";
            desc = "Pixel alpha enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } palpha_en[1:1];
        field {
            name = "palpha_range";
            desc = "Alpha range select of the pixel
- 0: The alpha range of the pixel is 0-128.
- 1: The alpha range of the pixel is 0-255.";
            sw = rw; hw = r;
            reset = 0x0;
        } palpha_range[0:0];
    } GFX_OUT_CTRL @ 0x10E08;
    reg {
        name = "GFX_1555_ALPHA";
        desc = "GFX_1555_ALPHA is an alpha value register in ARGB1555 format (non-instant register). (offset 0x10E28; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 9.2.6, PDF page 496).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_16[31:16];
        field {
            name = "alpha_1";
            desc = "Alpha1 value. When the data format is alphaRGB1555 and the alpha value is 1, the alpha1 value is used.";
            sw = rw; hw = r;
            reset = 0x0;
        } alpha_1[15:8];
        field {
            name = "alpha_0";
            desc = "Alpha0 value. When the data format is alphaRGB1555 and the alpha value is 1, the alpha0 value is used.";
            sw = rw; hw = r;
            reset = 0x0;
        } alpha_0[7:0];
    } GFX_1555_ALPHA @ 0x10E28;
    reg {
        name = "GFX_SRC_INFO";
        desc = "GFX_SRC_INFO is a GFX FDR original picture attribute register (non-instant register). (offset 0x10E40; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 9.2.6, PDF page 497).";
        field {
