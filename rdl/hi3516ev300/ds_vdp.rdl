            desc = "Master 0 read outstanding";
            sw = rw; hw = r;
            reset = 0xf;
        } mstr0_routstanding[3:0];
    } MAC_OUTSTANDING @ 0x10000;
    reg {
        name = "VID_READ_CTRL";
        desc = "VID_READ_CTRL is a VID FDR read control register (non-instant register). (offset 0x10200; total reset 0x00020000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 9.2.6, PDF page 493).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_14[31:14];
        field {
            name = "chm_copy_en";
            desc = "Repeated chrominance read enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } chm_copy_en[13:13];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_12_7[12:7];
        field {
            name = "lm_rmode";
            desc = "Chrominance read mode register
- 000: The read mode is bound to the interface.
- 001: The data is read in progressive mode.
- 010: The top field is read in interlaced mode.
- 011: The bottom field is read in interlaced mode.

Other values: reserved";
            sw = rw; hw = r;
            reset = 0x0;
        } lm_rmode[6:4];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_3_3[3:3];
        field {
            name = "chm_rmode";
            desc = "Chrominance read mode register
- 000: The read mode is bound to the interface.
- 001: The data is read in progressive mode.
- 010: The top field is read in interlaced mode.
- 011: The bottom field is read in interlaced mode.

Other values: reserved";
            sw = rw; hw = r;
            reset = 0x0;
        } chm_rmode[2:0];
    } VID_READ_CTRL @ 0x10200;
    reg {
        name = "VID_OUT_CTRL";
        desc = "VID_OUT_CTRL is a VID FDR output control register (non-instant register). (offset 0x10210; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 9.2.6, PDF page 494).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_5[31:5];
        field {
            name = "uv_order_en";
            desc = "UV sequence register of the input YUV data format
- 0: U for upper bits
- 1: V for upper bits";
