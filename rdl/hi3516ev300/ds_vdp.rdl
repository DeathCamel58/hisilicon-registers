            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_8[31:8];
        field {
            name = "ifmt";
            desc = "Input data format
- 0x48: ARGB4444
- 0x49: ARGB1555

Other values: reserved";
            sw = rw; hw = r;
            reset = 0x0;
        } ifmt[7:0];
    } GFX_SRC_INFO @ 0x10E40;
    reg {
        name = "GFX_SRC_RESO";
        desc = "GFX_SRC_RESO is an original picture resolution register (non-instant register). (offset 0x10E44; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 9.2.6, PDF page 497).";
        field {
            name = "src_h";
            desc = "Height (in lines). The configured value is the actual height minus 1. The frame height is referenced and its unit is line.";
            sw = rw; hw = r;
            reset = 0x0;
        } src_h[31:16];
        field {
            name = "src_w";
            desc = "Width (in pixels). The configured value is the actual width minus 1.";
            sw = rw; hw = r;
            reset = 0x0;
        } src_w[15:0];
    } GFX_SRC_RESO @ 0x10E44;
    reg {
        name = "GFX_SRC_CROP";
        desc = "GFX_SRC_CROP is an original picture crop register (non-instant register). (offset 0x10E48; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 9.2.6, PDF page 497).";
        field {
