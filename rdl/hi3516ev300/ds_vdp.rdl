            reset = 0x0;
        } reserved_3_0[3:0];
    } VID_OUT_CTRL @ 0x10210;
    reg {
        name = "VID_SRC_INFO";
        desc = "VID_SRC_INFO is a VID FDR input picture attribute register (non-instant register). (offset 0x10240; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 9.2.6, PDF page 494).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_3[31:3];
        field {
            name = "data_type";
            desc = "Input data type
- 000: reserved. The default value is YUV422.
- 001: YUV400";
            sw = rw; hw = r;
            reset = 0x0;
        } data_type[2:0];
    } VID_SRC_INFO @ 0x10240;
    reg {
        name = "VID_SRC_RESO";
        desc = "VID_SRC_RESO is an original picture resolution register (non-instant register). (offset 0x10244; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 9.2.6, PDF page 495).";
        field {
            name = "src_h";
            desc = "Height (in lines). The configured value is the actual height minus 1. The frame height is referenced and its unit is line.";
            sw = rw; hw = r;
            reset = 0x0;
        } src_h[31:16];
        field {
