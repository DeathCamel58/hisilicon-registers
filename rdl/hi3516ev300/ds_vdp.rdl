            sw = rw; hw = r;
            reset = 0x0;
        } src_crop_x[15:0];
    } VID_SRC_CROP @ 0x10248;
    reg {
        name = "VID_IN_RESO";
        desc = "VID_IN_RESO is a VID input picture resolution register (non-instant register). (offset 0x1024C; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 9.2.6, PDF page 495).";
        field {
            name = "ireso_h";
            desc = "Height (in lines). The configured value is the actual height minus 1. The frame height is referenced and its unit is line.";
            sw = rw; hw = r;
            reset = 0x0;
        } ireso_h[31:16];
        field {
            name = "ireso_w";
