        desc = "GFX_CKEY_MAX is a maximum colorkey register (non-instant register). (offset 0x10F00; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 9.2.6, PDF page 498).";
        field {
