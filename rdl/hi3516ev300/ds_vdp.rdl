        desc = "INTF_LCD_UPD is an INTF_LCD update register. (offset 0xD304; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 9.2.6, PDF page 492).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_1[31:1];
        field {
            name = "regup";
            desc = "Update register. After the registers at this layer are configured, the registers are updated when the value 1 is written to this bit. After updates, this bit is automatically cleared by the hardware.

Access type WC in the data sheet: written 1 clears the bit.";
            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } regup[0:0];
    } INTF_LCD_UPD @ 0xD304;
    reg {
        name = "INTF_LCD_SYNC_INV";
        desc = "INTF_LCD_SYNC_INV is a sync signal polarity configuration register in LCD external sync timing input mode. The setting of this register takes effect immediately after configuration, that is, the polarity of the corresponding sync signal is immediately affected. (offset 0xD308; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 9.2.6, PDF page 492).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_4[31:4];
        field {
            name = "f_inv";
            desc = "Output phase inversion enable for the odd/even field indicator signal (instant)
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } f_inv[3:3];
        field {
            name = "vs_inv";
            desc = "Output phase inversion enable for the vertical";
            sw = rw; hw = r;
            reset = 0x0;
        } vs_inv[2:2];
        field {
            name = "hs_inv";
            desc = "Output phase inversion enable for the horizontal sync pulse (instant)
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } hs_inv[1:1];
        field {
            name = "dv_inv";
            desc = "Output phase inversion enable for the data validity signal (instant)
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } dv_inv[0:0];
    } INTF_LCD_SYNC_INV @ 0xD308;
    reg {
        name = "MAC_OUTSTANDING";
        desc = "MAC_OUTSTANDING is an outstanding register. (offset 0x10000; total reset 0x0000007F; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 9.2.6, PDF page 493).";
        field {
            name = "reserved";
