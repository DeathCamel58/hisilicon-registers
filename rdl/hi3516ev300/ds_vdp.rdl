        desc = "GFX_IRESO is an input resolution register (non-instant register). (offset 0x10E4C; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 9.2.6, PDF page 498).";
        field {
            name = "ireso_h";
            desc = "Height (in lines). The configured value is the actual height minus 1. Note: The actual layer height must be an even number.";
            sw = rw; hw = r;
            reset = 0x0;
        } ireso_h[31:16];
        field {
