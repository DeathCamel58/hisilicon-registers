`ifndef HI3516EV300_VEDU_RDL
`define HI3516EV300_VEDU_RDL

regfile eVEDU_V4_EV300 {
    name = "VEDU H.264/H.265 encoder, EV200/EV300 generation (subset)";
    desc = "VEDU at 0x11410000 (SPI 47). Only the MMIO registers the vendor driver writes per picture are listed; the bulk of the configuration is a register image in DDR (REG_IMAGE). Not a full register description.";

    reg {
        name = "Interrupt mask";
        desc = "Bit 0: end of picture. Source: OpenIPC qemu-bench docs/hisilicon-venc.md (reverse engineering of the SDK driver objects hi_vedu.o / hi_vpss.o / hi_vi.o plus a model that runs the unmodified vendor driver stack); not read from hardware. Evidence: INFERRED.";
        field {
            name = "end_of_pic";
            desc = "End-of-picture interrupt enable.";
            sw = rw;
            hw = r;
        } end_of_pic[0:0];
    } INTMASK @ 0x0;

    reg {
        name = "Interrupt clear";
        desc = "Write 1s to clear. Source: OpenIPC qemu-bench docs/hisilicon-venc.md (reverse engineering of the SDK driver objects hi_vedu.o / hi_vpss.o / hi_vi.o plus a model that runs the unmodified vendor driver stack); not read from hardware. Evidence: INFERRED.";
        field {
            name = "clr";
            desc = "Clear bits.";
            sw = w;
            hw = r;
        } clr[31:0];
    } INTCLR @ 0x4;

    reg {
        name = "Start";
        desc = "Write 1 to start a picture. Source: OpenIPC qemu-bench docs/hisilicon-venc.md (reverse engineering of the SDK driver objects hi_vedu.o / hi_vpss.o / hi_vi.o plus a model that runs the unmodified vendor driver stack); not read from hardware. Evidence: INFERRED.";
        field {
            name = "start";
            desc = "Start encoding.";
            sw = w;
            hw = r;
        } start[0:0];
    } START @ 0x8;

    reg {
        name = "Encoder mode";
        desc = "Values seen: 0x40071116 (H.264), 0x400103D2 (H.265). Source: OpenIPC qemu-bench docs/hisilicon-venc.md (reverse engineering of the SDK driver objects hi_vedu.o / hi_vpss.o / hi_vi.o plus a model that runs the unmodified vendor driver stack); not read from hardware. Evidence: INFERRED.";
        field {
            name = "mode";
            desc = "Raw value";
            sw = rw;
            hw = r;
        } mode[31:0];
    } MODE @ 0x10;

    reg {
        name = "Picture size";
        desc = "(width - 1) | (height - 1) << 16. Source: OpenIPC qemu-bench docs/hisilicon-venc.md (reverse engineering of the SDK driver objects hi_vedu.o / hi_vpss.o / hi_vi.o plus a model that runs the unmodified vendor driver stack); not read from hardware. Evidence: INFERRED.";
        field {
            name = "width_m1";
            desc = "Width - 1.";
            sw = rw;
            hw = r;
        } width_m1[15:0];
        field {
            name = "height_m1";
            desc = "Height - 1.";
            sw = rw;
            hw = r;
        } height_m1[31:16];
    } PIC_SIZE @ 0x14;

    reg {
        name = "Reset request";
        desc = "Reset request; BUS_IDLE is polled around a reset. Source: OpenIPC qemu-bench docs/hisilicon-venc.md (reverse engineering of the SDK driver objects hi_vedu.o / hi_vpss.o / hi_vi.o plus a model that runs the unmodified vendor driver stack); not read from hardware. Evidence: INFERRED.";
        field {
            name = "reset";
            desc = "Raw value";
            sw = rw;
            hw = r;
        } reset[31:0];
    } RESET @ 0x4C;

    reg {
        name = "Register image address";
        desc = "Physical address of the configuration image in DDR (laid out like the MMIO space; image offsets 0x104/0x108 source luma/chroma, 0x12C/0x130 ring pointer cells, 0x16C ring base, 0x1F4 source strides, 0x4A0 ring size, 0x61C slice QP). Source: OpenIPC qemu-bench docs/hisilicon-venc.md (reverse engineering of the SDK driver objects hi_vedu.o / hi_vpss.o / hi_vi.o plus a model that runs the unmodified vendor driver stack); not read from hardware. Evidence: INFERRED.";
        field {
            name = "addr";
            desc = "Raw value";
            sw = rw;
            hw = r;
        } addr[31:0];
    } REG_IMAGE @ 0x58;

    reg {
        name = "Masked interrupt status";
        desc = "Bit 0 end of picture, 2 buffer full, 3 bits over, 6 timeout. Source: OpenIPC qemu-bench docs/hisilicon-venc.md (reverse engineering of the SDK driver objects hi_vedu.o / hi_vpss.o / hi_vi.o plus a model that runs the unmodified vendor driver stack); not read from hardware. Evidence: INFERRED.";
        field {
            name = "status";
            desc = "Raw value";
            sw = rw;
            hw = r;
        } status[31:0];
    } INTSTAT @ 0x3000;

    reg {
        name = "Raw interrupt status";
        desc = "Bit 11 ring full, 12 ring back (plus the INTSTAT bits). Source: OpenIPC qemu-bench docs/hisilicon-venc.md (reverse engineering of the SDK driver objects hi_vedu.o / hi_vpss.o / hi_vi.o plus a model that runs the unmodified vendor driver stack); not read from hardware. Evidence: INFERRED.";
        field {
            name = "raw";
            desc = "Raw value";
            sw = rw;
            hw = r;
        } raw[31:0];
    } RAWINT @ 0x3004;

    reg {
        name = "Bus idle";
        desc = "Bit 0: idle. Source: OpenIPC qemu-bench docs/hisilicon-venc.md (reverse engineering of the SDK driver objects hi_vedu.o / hi_vpss.o / hi_vi.o plus a model that runs the unmodified vendor driver stack); not read from hardware. Evidence: INFERRED.";
        field {
            name = "idle";
            desc = "Bus idle.";
            sw = r;
            hw = w;
        } idle[0:0];
    } BUS_IDLE @ 0x3010;

};

`endif
