            desc = "Raw value";
            sw = rw;
            hw = r;
        } regup[31:0];
    } REGUP @ 0x10;

    reg {
        name = "Interrupt mask";
        desc = "The driver writes 0x7401. Source: OpenIPC qemu-bench docs/hisilicon-venc.md (reverse engineering of the SDK driver objects hi_vedu.o / hi_vpss.o / hi_vi.o plus a model that runs the unmodified vendor driver stack); not read from hardware. Evidence: INFERRED.";
        field {
            name = "mask";
            desc = "Raw value";
            sw = rw;
            hw = r;
        } mask[31:0];
    } INT_MASK @ 0xF0;

    reg {
        name = "Offline node list address";
        desc = "First node of the register-image list (offline mode); read back after the write. Source: OpenIPC qemu-bench docs/hisilicon-venc.md (reverse engineering of the SDK driver objects hi_vedu.o / hi_vpss.o / hi_vi.o plus a model that runs the unmodified vendor driver stack); not read from hardware. Evidence: INFERRED.";
        field {
