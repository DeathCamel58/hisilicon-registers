    } NODE_ADDR @ 0x2F8;

    reg {
        name = "Offline node list start";
        desc = "Bit 0 starts the node list; the driver writes 0x0900647F. Source: OpenIPC qemu-bench docs/hisilicon-venc.md (reverse engineering of the SDK driver objects hi_vedu.o / hi_vpss.o / hi_vi.o plus a model that runs the unmodified vendor driver stack); not read from hardware. Evidence: INFERRED.";
        field {
            name = "start";
            desc = "Raw value";
            sw = rw;
            hw = r;
        } start[31:0];
    } NODE_START @ 0x304;

    reg {
        name = "Raw status";
        desc = "Write 1s to clear: bit 10 frame start, bit 0 end of frame; 0xADC clears the errors. Source: OpenIPC qemu-bench docs/hisilicon-venc.md (reverse engineering of the SDK driver objects hi_vedu.o / hi_vpss.o / hi_vi.o plus a model that runs the unmodified vendor driver stack); not read from hardware. Evidence: INFERRED.";
        field {
            name = "raw";
            desc = "Raw value";
            sw = rw;
            hw = r;
        } raw[31:0];
    } RAW_STATUS @ 0x310;

    reg {
        name = "Masked status";
        desc = " Source: OpenIPC qemu-bench docs/hisilicon-venc.md (reverse engineering of the SDK driver objects hi_vedu.o / hi_vpss.o / hi_vi.o plus a model that runs the unmodified vendor driver stack); not read from hardware. Evidence: INFERRED.";
        field {
            name = "status";
            desc = "Raw value";
            sw = rw;
            hw = r;
        } status[31:0];
    } STATUS @ 0x314;

    reg {
        name = "Channel 0 size";
        desc = "Channel 1: 0x4A0, channel 2: 0x4E8. Source: OpenIPC qemu-bench docs/hisilicon-venc.md (reverse engineering of the SDK driver objects hi_vedu.o / hi_vpss.o / hi_vi.o plus a model that runs the unmodified vendor driver stack); not read from hardware. Evidence: INFERRED.";
        field {
            name = "size";
            desc = "Raw value";
            sw = rw;
            hw = r;
        } size[31:0];
    } CH0_SIZE @ 0x44C;

    reg {
        name = "Channel 0 control";
        desc = "Bit 31 enable (toggled per frame by frame-rate control); channel 1: 0x4A4, channel 2: 0x4EC. Source: OpenIPC qemu-bench docs/hisilicon-venc.md (reverse engineering of the SDK driver objects hi_vedu.o / hi_vpss.o / hi_vi.o plus a model that runs the unmodified vendor driver stack); not read from hardware. Evidence: INFERRED.";
        field {
