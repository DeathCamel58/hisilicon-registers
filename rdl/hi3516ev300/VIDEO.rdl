        field {
            name = "addr";
            desc = "Raw value";
            sw = rw;
            hw = r;
        } addr[31:0];
    } STT_AE_ZONE1_ADDR @ 0x10218;

    reg {
        name = "ISP front-end status";
        desc = "Write 1s to clear: bit 0 frame start, bit 4 frame end. Source: OpenIPC qemu-bench docs/hisilicon-venc.md (reverse engineering of the SDK driver objects hi_vedu.o / hi_vpss.o / hi_vi.o plus a model that runs the unmodified vendor driver stack); not read from hardware. Evidence: INFERRED.";
        field {
