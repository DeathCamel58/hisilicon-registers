            desc = "Width - 1.";
            sw = rw;
            hw = r;
        } width_m1[15:0];
        field {
            name = "height_m1";
            desc = "Height - 1.";
            sw = rw;
            hw = r;
        } height_m1[31:16];
    } PIC_SIZE @ 0x34;

    reg {
        name = "Stream ring size";
        desc = " Source: OpenIPC qemu-bench docs/hisilicon-venc.md (reverse engineering of the SDK driver objects hi_vedu.o / hi_vpss.o / hi_vi.o plus a model that runs the unmodified vendor driver stack); not read from hardware. Evidence: INFERRED.";
        field {
            name = "size";
