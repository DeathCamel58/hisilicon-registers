            sw = rw;
            hw = r;
        } addr[31:0];
    } CH0_ADDR @ 0x468;

    reg {
        name = "Channel 0 stride";
        desc = "Channel 1: 0x4D0, channel 2: 0x514. Source: OpenIPC qemu-bench docs/hisilicon-venc.md (reverse engineering of the SDK driver objects hi_vedu.o / hi_vpss.o / hi_vi.o plus a model that runs the unmodified vendor driver stack); not read from hardware. Evidence: INFERRED.";
        field {
            name = "stride";
            desc = "Raw value";
            sw = rw;
            hw = r;
        } stride[31:0];
