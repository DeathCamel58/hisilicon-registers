            sw = rw;
            hw = r;
        } enable[31:31];
    } CH0_CTRL @ 0x450;

    reg {
        name = "Channel 0 buffer addresses";
        desc = "Header Y, header C, Y, C, 8 bytes apart; channel 1: 0x4B0, channel 2: 0x4F4. Source: OpenIPC qemu-bench docs/hisilicon-venc.md (reverse engineering of the SDK driver objects hi_vedu.o / hi_vpss.o / hi_vi.o plus a model that runs the unmodified vendor driver stack); not read from hardware. Evidence: INFERRED.";
        field {
            name = "addr";
