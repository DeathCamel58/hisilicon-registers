regfile eVPSS_V4_EV300 {
    name = "VPSS, EV200/EV300 generation (subset)";
    desc = "VPSS at 0x11400000 (SPI 46). Only registers the vendor driver uses for the online/offline frame flow are listed. Not a full register description.";

    reg {
        name = "Control";
        desc = "Bit 31: online video enable. Source: OpenIPC qemu-bench docs/hisilicon-venc.md (reverse engineering of the SDK driver objects hi_vedu.o / hi_vpss.o / hi_vi.o plus a model that runs the unmodified vendor driver stack); not read from hardware. Evidence: INFERRED.";
