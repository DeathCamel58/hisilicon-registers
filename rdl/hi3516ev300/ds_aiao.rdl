`ifndef HI3516EV300_AIAO_RDL
`define HI3516EV300_AIAO_RDL
regfile eHI3516EV300_AIAO {
    name = "Audio input/output (AIAO)";
    desc = "Audio input/output (AIAO) of the Hi3516E V300 at base 0x100E0000. 31 registers extracted programmatically from the Hi3516E V300 data sheet (Issue 00B06, 2019-05-15) (Table 11-1 Summary of the AIAO registers (base address: 0x100E _0000)): register headings, offsets, total reset values, field bit ranges, access types, names, reset values and descriptions, with PDF page numbers in each register description. Field names, bit ranges, access types and offsets are exact; the free-text descriptions are taken from the cell text of the field table and were checked by sampling only. Hardware not verified.";
    reg {
        name = "AIAO_INT_ENA";
        desc = "AIAO_INT_ENA is an AIAO interrupt enable register. (offset 0x0; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 11.1.6, PDF page 600).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_17[31:17];
        field {
            name = "tx_ch0_int_ena";
            desc = "TX channel 0 interrupt enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } tx_ch0_int_ena[16:16];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_15_1[15:1];
        field {
            name = "rx_ch0_int_ena";
            desc = "RX channel 0 interrupt enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } rx_ch0_int_ena[0:0];
    } AIAO_INT_ENA @ 0x0;
    reg {
        name = "AIAO_INT_STATUS";
        desc = "AIAO_INT_STATUS is an AIAO interrupt status register. (offset 0x4; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 11.1.6, PDF page 601).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_17[31:17];
        field {
            name = "tx_ch0_int_status";
            desc = "Interrupt status of TX channel 0
- 0: No interrupt is generated.
- 1: An interrupt is generated.";
            sw = r; hw = w;
            reset = 0x0;
        } tx_ch0_int_status[16:16];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_15_1[15:1];
        field {
            name = "rx_ch0_int_status";
            desc = "Interrupt status of RX channel 0
- 0: No interrupt is generated.
- 1: An interrupt is generated.";
            sw = r; hw = w;
            reset = 0x0;
        } rx_ch0_int_status[0:0];
    } AIAO_INT_STATUS @ 0x4;
    reg {
        name = "AIAO_INT_RAW";
        desc = "AIAO_INT_RAW is an AIAO raw interrupt register. (offset 0x8; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 11.1.6, PDF page 601).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_17[31:17];
        field {
            name = "tx_ch0_int_raw";
            desc = "Raw interrupt of TX channel 0
- 0: No raw interrupt is generated.
- 1: A raw interrupt is generated.";
            sw = r; hw = w;
            reset = 0x0;
        } tx_ch0_int_raw[16:16];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_15_1[15:1];
        field {
            name = "rx_ch0_int_raw";
            desc = "Raw interrupt of RX channel 0
- 0: No raw interrupt is generated.
- 1: A raw interrupt is generated.";
            sw = r; hw = w;
            reset = 0x0;
        } rx_ch0_int_raw[0:0];
    } AIAO_INT_RAW @ 0x8;
    reg {
        name = "I2S_CRG_CFG0_00";
        desc = "I2S_CRG_CFG0_00 is I2S00 CRG configuration register 0. (offset 0x100; total reset 0x00AAAAAA; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 11.1.6, PDF page 602).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_27[31:27];
        field {
            name = "aiao_mclk_div";
            desc = "Configured value of the frequency division clock of the MCLK. The configured value is calculated as follows: (Target MCLK frequency/PLL frequency of the MCLK clock source) x 2^27. For details about the PLL frequency of the MCLK clock source, see section 3.2 \"Clock\" in chapter 3 \"System\" in the Hi3519 V101 Professional HD IP Camera SoC Data Sheet.";
            sw = rw; hw = r;
            reset = 0xaaaaa;
        } aiao_mclk_div[26:0];
    } I2S_CRG_CFG0_00 @ 0x100;
    reg {
        name = "I2S_CRG_CFG1_00";
        desc = "I2S_CRG_CFG1_00 is I2S00 CRG configuration register 1. (offset 0x104; total reset 0x00000131; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 11.1.6, PDF page 602).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_10[31:10];
        field {
            name = "aiao_srst_req";
            desc = "Independent soft reset request of the RX 0 channel
- 0: deassert reset
- 1: reset";
            sw = rw; hw = r;
            reset = 0x0;
        } aiao_srst_req[9:9];
        field {
            name = "aiao_cken";
            desc = "MCLK/BCLK/WS clock gating for CRG00
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x1;
        } aiao_cken[8:8];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_7[7:7];
        field {
            name = "aiao_fsclk_div";
            desc = "Frequency division relationship between the bit clock BCLK and the sampling clock FS
- 000: The FS is obtained by dividing the BCLK by 16.
- 001: The FS is obtained by dividing the BCLK by 32.
- 010: The FS is obtained by dividing the BCLK by 48.
- 011: The FS is obtained by dividing the BCLK by 64.
- 100: The FS is obtained by dividing the BCLK";
            sw = rw; hw = r;
            reset = 0x3;
        } aiao_fsclk_div[6:4];
        field {
            name = "aiao_bclk_div";
            desc = "Frequency division relationship between the main clock MCLK and the bit clock BCLK
- 0000: The BCLK is obtained by dividing the

MCLK by 1.
- 0001: The BCLK is obtained by dividing the

MCLK by 3.
- 0010: The BCLK is obtained by dividing the

MCLK by 2.
- 0011: The BCLK is obtained by dividing the

MCLK by 4.
- 0100: The BCLK is obtained by dividing the

MCLK by 6.
- 0101: The BCLK is obtained by dividing the

MCLK by 8.
- 0110: The BCLK is obtained by dividing the

MCLK by 12.
- 0111: The BCLK is obtained by dividing the

MCLK by 16.
- 1000: The BCLK is obtained by dividing the

MCLK by 24.
- 1001: The BCLK is obtained by dividing the

MCLK by 32.
- 1010: The BCLK is obtained by dividing the

MCLK by 48.
- 1011: The BCLK is obtained by dividing the

MCLK by 64. Other values: The BCLK is obtained by dividing the MCLK by 8.";
            sw = rw; hw = r;
            reset = 0x1;
        } aiao_bclk_div[3:0];
    } I2S_CRG_CFG1_00 @ 0x104;
    reg {
        name = "I2S_CRG_CFG0_08";
        desc = "I2S_CRG_CFG0_08 is I2S08 CRG configuration register 0. (offset 0x140; total reset 0x00AAAAAA; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 11.1.6, PDF page 603).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_27[31:27];
        field {
            name = "aiao_mclk_div";
            desc = "Configured value of the frequency division clock of the MCLK. The configured value is";
            sw = rw; hw = r;
            reset = 0xaaaaa;
        } aiao_mclk_div[26:0];
    } I2S_CRG_CFG0_08 @ 0x140;
    reg {
        name = "I2S_CRG_CFG1_08";
        desc = "I2S_CRG_CFG1_08 is I2S08 CRG configuration register 1. (offset 0x144; total reset 0x00000131; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 11.1.6, PDF page 604).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_10[31:10];
        field {
            name = "aiao_srst_req";
            desc = "Independent soft reset request of the TX 0 channel
- 0: deassert reset
- 1: reset";
            sw = rw; hw = r;
            reset = 0x0;
        } aiao_srst_req[9:9];
        field {
            name = "aiao_cken";
            desc = "MCLK/BCLK/WS clock gating for CRG08
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x1;
        } aiao_cken[8:8];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_7[7:7];
        field {
            name = "aiao_fsclk_div";
            desc = "Frequency division relationship between the bit clock BCLK and the sampling clock FS
- 000: The FS is obtained by dividing the BCLK by 16.
- 001: The FS is obtained by dividing the BCLK by 32.
- 010: The FS is obtained by dividing the BCLK by 48.
- 011: The FS is obtained by dividing the BCLK by 64.
- 100: The FS is obtained by dividing the BCLK by 128.
- 101: The FS is obtained by dividing the BCLK by 256.

Other values: The FS is obtained by dividing the BCLK by 8.";
            sw = rw; hw = r;
            reset = 0x3;
        } aiao_fsclk_div[6:4];
        field {
            name = "aiao_bclk_div";
            desc = "Frequency division relationship between the main clock MCLK and the bit clock BCLK";
            sw = rw; hw = r;
            reset = 0x1;
        } aiao_bclk_div[3:0];
    } I2S_CRG_CFG1_08 @ 0x144;
    reg {
        name = "RX_IF_ATTRI";
        desc = "RX_IF_ATTRI is an interface attribute configuration register for the RX channel. (offset 0x1000; total reset 0xE4000004; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 11.1.6, PDF page 605).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0xe4;
        } reserved_31_24[31:24];
        field {
            name = "rx_sd_source_sel";
            desc = "This bit is set to 0x1000 in normal mode.";
            sw = rw; hw = r;
            reset = 0x0;
        } rx_sd_source_sel[23:20];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_19_19[19:19];
        field {
            name = "rx_trackmode";
            desc = "Audio-left and audio-right channel mode in I2S mode
- 000: The sound is not processed.
- 001: The sounds in two channels are audio-left channel sounds.
- 010: The sounds in two channels are audio-";
            sw = rw; hw = r;
            reset = 0x0;
        } rx_trackmode[18:16];
        field {
            name = "rx_sd_offset";
            desc = "PCM timing mode
- 0x0: left-aligned mode
- 0x1: standard mode

Other values: reserved";
            sw = rw; hw = r;
            reset = 0x0;
        } rx_sd_offset[15:8];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_7[7:7];
        field {
            name = "rx_ch_num";
            desc = "Number of RX channels
- 00: 1
- 01: 2

Other values: reserved";
            sw = rw; hw = r;
            reset = 0x0;
        } rx_ch_num[6:4];
        field {
            name = "rx_i2s_precision";
            desc = "Data sampling precision I2S mode:
- 01: 16 bits
- 10: 24 bits

Other values: reserved PCM mode:
- 01: 16 bits

Other values: reserved";
            sw = rw; hw = r;
            reset = 0x1;
        } rx_i2s_precision[3:2];
        field {
            name = "rx_mode";
            desc = "Interface mode of the RX channel
- 00: I2S mode
- 01: PCM mode

Other values: reserved";
            sw = rw; hw = r;
            reset = 0x0;
        } rx_mode[1:0];
    } RX_IF_ATTRI @ 0x1000;
    reg {
        name = "RX_DSP_CTRL";
        desc = "RX_DSP_CTRL is an RX channel control register. (offset 0x1004; total reset 0x20000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 11.1.6, PDF page 607).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_30[31:30];
        field {
            name = "rx_disable_done";
            desc = "RX channel disable completion identifier
- 0: not complete
- 0: complete";
            sw = r; hw = w;
            reset = 0x1;
        } rx_disable_done[29:29];
        field {
            name = "rx_enable";
            desc = "RX channel start/stop control bit
- 0: stop
- 1: start";
            sw = rw; hw = r;
            reset = 0x0;
        } rx_enable[28:28];
        field {
            name = "bypass_en";
            desc = "Data processing disable bit. The control function still takes effect after data processing is disabled.
- 0: Data processing is implemented normally.
- 1: Operations such as trackmode are not implemented.";
            sw = rw; hw = r;
            reset = 0x0;
        } bypass_en[27:27];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_26_0[26:0];
    } RX_DSP_CTRL @ 0x1004;
    reg {
        name = "RX_BUFF_SADDR";
        desc = "RX_BUFF_SADDR is a DDR buffer start address register for the RX channel. (offset 0x1080; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 11.1.6, PDF page 607).";
        field {
            name = "rx_buff_saddr";
            desc = "Start address for the DDR buffer of RX channel 0. Its unit is byte. The start address must be 128x8-bit-aligned.";
            sw = rw; hw = r;
            reset = 0x0;
        } rx_buff_saddr[31:0];
    } RX_BUFF_SADDR @ 0x1080;
    reg {
        name = "RX_BUFF_SIZE";
        desc = "RX_BUFF_SIZE is a DDR buffer size register for the RX channel. (offset 0x1084; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 11.1.6, PDF page 607).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_24[31:24];
        field {
            name = "rx_buff_size";
            desc = "DDR buffer size of the RX channel. Its unit is byte. The buffer size must be an integral multiple of 128 bytes.";
            sw = rw; hw = r;
            reset = 0x0;
        } rx_buff_size[23:0];
    } RX_BUFF_SIZE @ 0x1084;
    reg {
        name = "RX_BUFF_WPTR";
        desc = "RX_BUFF_WPTR is a DDR buffer write address register for the RX channel. (offset 0x1088; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 11.1.6, PDF page 608).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_24[31:24];
        field {
            name = "rx_buff_wptr";
            desc = "Write address for the DDR buffer of the RX channel. Its unit is byte. The write address in the RX direction is maintained by the logic and is the offset address relative to the start address for the DDR buffer. The write address must be 128x2-bit-aligned.";
            sw = rw; hw = r;
            reset = 0x0;
        } rx_buff_wptr[23:0];
    } RX_BUFF_WPTR @ 0x1088;
    reg {
        name = "RX_BUFF_RPTR";
        desc = "RX_BUFF_RPTR is a DDR buffer read address register for the RX channel. (offset 0x108C; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 11.1.6, PDF page 608).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_24[31:24];
        field {
            name = "rx_buff_rptr";
            desc = "Read address for the DDR buffer of the RX channel. Its unit is byte. The read address in the RX direction is maintained by the logic and is the offset address relative to the start address for the DDR buffer. The software operation is performed by byte, and the hardware operation is performed based on 128 x 2-bit alignment.";
            sw = rw; hw = r;
            reset = 0x0;
        } rx_buff_rptr[23:0];
    } RX_BUFF_RPTR @ 0x108C;
    reg {
        name = "RX_BUFF_ALFULL_TH";
        desc = "RX_BUFF_ALFULL_TH is a DDR buffer almost full threshold register for the RX channel. (offset 0x1090; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 11.1.6, PDF page 609).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_24[31:24];
        field {
            name = "rx_buff_alfull_th";
            desc = "Almost full threshold for the DDR buffer of the RX channel. Its unit is byte. If the available space of the DDR buffer is below the almost full threshold, the almost full raw interrupt is generated. If the rx_alfull_int interrupt is used, the field value must be an integral multiple of 16 bytes and greater than or equal to 0x40.";
            sw = rw; hw = r;
            reset = 0x0;
        } rx_buff_alfull_th[23:0];
    } RX_BUFF_ALFULL_TH @ 0x1090;
    reg {
        name = "RX_TRANS_SIZE";
        desc = "RX_TRANS_SIZE is data transfer length register for the RX interrupt. (offset 0x1094; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 11.1.6, PDF page 609).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_24[31:24];
        field {
            name = "rx_trans_size";
            desc = "After the RX channel receives the audio data with the length of rx_trans_size (in byte), a transfer completion interrupt is generated.";
            sw = rw; hw = r;
            reset = 0x0;
        } rx_trans_size[23:0];
    } RX_TRANS_SIZE @ 0x1094;
    reg {
        name = "RX_INT_ENA";
        desc = "RX_INT_ENA is an interrupt enable register for the RX channel. (offset 0x10A0; total reset 0x00000000; PROVEN: Hi3516E V300 data sheet (Issue 00B06, 2019-05-15), section 11.1.6, PDF page 609).";
        field {
            name = "reserved";
