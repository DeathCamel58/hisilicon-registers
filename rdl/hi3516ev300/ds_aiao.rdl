            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_8[31:8];
        field {
            name = "rx_if_full_lost_int_ena";
            desc = "Interface data full loss raw interrupt enable for the RX channel
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } rx_if_full_lost_int_ena[7:7];
        field {
