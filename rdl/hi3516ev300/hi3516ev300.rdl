addrmap hi3516ev300 {
    name = "hi3516ev300 registers";
    desc = "
        ## Status

        Register map of the Hi3516E V300 (Cortex-A7 IP camera SoC, DDR at 0x40000000). Audited block by block on 2026-11-14 against the Hi3516E V300 data sheet, Issue 00B06 (2019-05-15, dl/Hi3516EV300-Datasheet.pdf): the blocks named ds_*.rdl were regenerated from the data sheet tables (PROVEN: offsets, names, bit ranges, access types, reset values exact; descriptions sampled only) and replaced the earlier vendor-code derived blocks; registers the old map knew from vendor code but the data sheet does not tabulate were kept in CRG and SYS_CTRL, marked INFERRED. Blocks the data sheet has no register chapter for (ISP, VIPROC, VGS, GZIP, IVE, VPSS, VEDU, JPGE, IO config banks, USB PHY) and the shared common blocks that match the data sheet (FEMAC, I2C, UART, SPI, PL061 GPIO, SP804 timers, SP805 watchdog, PWM, RSA, SPI RTC) keep their earlier vendor-derived or cross-checked layout; the audit results per block are in docs/rdl-campaign/audit-status.csv and docs/rdl-campaign/hi3516ev300-audit.md of the hi3520d-nvr workspace. Nothing was read from an EV300.

        ## Addresses (vendor device tree, vendor U-Boot and sys.ko; IRQ = GIC SPI number)

        | Start Address | Block | IRQ | Documented Here |
        |---------------|-------|-----|-----------------|
        | 0x04010000    | on-chip SRAM 64 KB (U-Boot RAM_START_ADRS 0x04010500) | - | &#10060; |
        | 0x10000000    | FMC control (memory window 0x14000000, 16 MB) | - | &#9989; |
        | 0x10010000    | eMMC / SDIO0 (SDHCI + vendor regs) | 30 | &#9989; |
        | 0x10020000    | SDIO1 (SDHCI + vendor regs) | 31 | &#9989; |
        | 0x10030000    | USB2 DWC3 (high-speed, host) | 39 | &#9989; (vendor glue registers only) |
        | 0x10040000    | FEMAC (internal FE PHY, MDIO 0x10041100, GLB 0x10041300) | 33 | &#9989; |
        | 0x10050000    | CIPHER (SPACC layout, version register 0x308 = 0x02018121) | 34 | &#9989; |
        | 0x10060000    | KLAD | - | &#9989; |
        | 0x10070000    | RSA | - | &#9989; |
        | 0x10080000    | TRNG (registers at +0x200) | - | &#9989; |
        | 0x10090000    | OTP controller (user interface) | - | &#9989; |
        | 0x100A0000    | OTP shadow (user) | - | &#10060; |
        | 0x100B0000    | EDMAC hiedmacv310 (4 channels) | 38 | &#9989; |
        | 0x100C0000    | IO config bank ahb | - | &#9989; |
        | 0x100D0000    | USB2 PHY (hixvp) | - | &#9989; |
        | 0x100E0000    | AIAO | 42 | &#9989; |
        | 0x100F0000    | ACODEC | - | &#10060; |
        | 0x10301000    | GIC distributor (cpu interface 0x10302000) | - | &#10060; |
        | 0x11000000    | VI capture (2 MB) | 43 | &#9989; (subset) |
        | 0x11200000    | VI process (VIPROC) | 44 | &#9989; (subset) |
        | 0x11220000    | ISP (128 KB) | 43 | &#10060; |
        | 0x11240000    | MIPI RX (one controller) | 45 | &#9989; (EV200 block) |
        | 0x11280000    | VO | 40 / 41 (hifb) | &#9989; (heuristic map) |
        | 0x112C0000    | IO config bank vio | - | &#9989; |
        | 0x11300000    | VGS | 49 | &#10060; |
        | 0x11310000    | GZIP | 50 | &#9989; |
        | 0x11320000    | IVE | 51 | &#9989; |
        | 0x11400000    | VPSS | 46 | &#9989; (subset) |
        | 0x11410000    | VEDU | 47 | &#9989; (subset) |
        | 0x11420000    | JPGE | 48 | &#9989; (subset) |
        | 0x12000000    | Timers 0/1 (SP804) | 5 | &#9989; |
        | 0x12001000    | Timers 2/3 (SP804) | 6 | &#9989; |
        | 0x12010000    | CRG | - | &#9989; (partial) |
        | 0x12020000    | SYS_CTRL | - | &#9989; (partial) |
        | 0x12028000    | MISC_CTRL | - | &#9989; (partial) |
        | 0x12030000    | WDG | 2 | &#9989; |
        | 0x12040000    | UART0 / 1 / 2 (PL011, stride 0x1000) | 7 / 8 / 9 | &#9989; |
        | 0x12050000    | SYSCNT (50 MHz generic counter) | - | &#10060; |
        | 0x12060000    | I2C0 / 1 / 2 (hibvt, stride 0x1000) | - | &#9989; |
        | 0x12070000    | SPI0 / SPI1 (PL022) | 14 / 15 | &#9989; |
        | 0x12080000    | PWM (4 channels, stride 0x20) | - | &#9989; |
        | 0x120A0000    | LSADC (2 channels) | 4 | &#9989; |
        | 0x120B0000    | GPIO0..9 (PL061, stride 0x1000) | 16..25 | &#9989; |
        | 0x120C0000    | IO config bank core | - | &#9989; |
        | 0x120D0000    | DDR AXI (DMC at 0x120D8000, PHY at 0x120DC000) | - | &#9989; (EV200 blocks, see note) |
        | 0x120E0000    | RTC (SPI bridge) | 0 | &#9989; |
    ";

    eIOCFG_AHB          IOCFG_AHB  @ 0x100C0000;
    eIOCFG_VIO          IOCFG_VIO  @ 0x112C0000;
    eIOCFG_CORE         IOCFG_CORE @ 0x120C0000;

    eVEDU_V4           VEDU       @ 0x11410000;
    eJPGE_V4           JPGE       @ 0x11420000;
    eVPSS_V4           VPSS       @ 0x11400000;
    eISP_FE_V4          ISP_FE     @ 0x11020000;
    eVIPROC_V4          VIPROC     @ 0x11200000;
    eISP_BE_V4          ISP_BE     @ 0x11220000;
    eVGS_V4             VGS        @ 0x11300000;

    eHISI_RSA           RSA        @ 0x10070000;
    eUSB2_PHY_HIXVP     USB2_PHY   @ 0x100D0000;
    eHISI_GZIP_V4      GZIP       @ 0x11310000;
    eHISI_IVE           IVE        @ 0x11320000;
    eHISI_FEMAC         ETH        @ 0x10040000;
    eHISI_TIMER_SP804   TIMER0     @ 0x12000000;
    eHISI_TIMER_SP804   TIMER1     @ 0x12000020;
    eHISI_TIMER_SP804   TIMER2     @ 0x12001000;
    eHISI_TIMER_SP804   TIMER3     @ 0x12001020;
    eHISI_WDG_SP805     WDG        @ 0x12030000;
    eARM_PL011          UART0      @ 0x12040000;
    eARM_PL011          UART1      @ 0x12041000;
    eARM_PL011          UART2      @ 0x12042000;
    eHISI_I2C_V2        I2C0       @ 0x12060000;
    eHISI_I2C_V2        I2C1       @ 0x12061000;
    eHISI_I2C_V2        I2C2       @ 0x12062000;
    eHISI_SPI           SPI0       @ 0x12070000;
    eHISI_SPI           SPI1       @ 0x12071000;
    eHISI_PWM_GRP       PWM        @ 0x12080000;
    eARM_PL061          GPIO0      @ 0x120B0000;
    eARM_PL061          GPIO1      @ 0x120B1000;
    eARM_PL061          GPIO2      @ 0x120B2000;
    eARM_PL061          GPIO3      @ 0x120B3000;
    eARM_PL061          GPIO4      @ 0x120B4000;
    eARM_PL061          GPIO5      @ 0x120B5000;
    eARM_PL061          GPIO6      @ 0x120B6000;
    eARM_PL061          GPIO7      @ 0x120B7000;
    eARM_PL061          GPIO8      @ 0x120B8000;
    eARM_PL061          GPIO9      @ 0x120B9000;
    eHI3516EV300_CRG        CRG        @ 0x12010000;
    eHI3516EV300_SYS_CTRL   SYS_CTRL   @ 0x12020000;
    eHI3516EV300_PMC        PMC        @ 0x120F0000;
    eHI3516EV300_DDRC_AXI   DDRC_AXI   @ 0x120D0000;
    eHI3516EV300_DDRC_QOSB  DDRC_QOSB  @ 0x120D4000;
    eHI3516EV300_DDRC_DMC   DDRC_DMC   @ 0x120D8000;
    eHI3516EV300_DDRC_PHY   DDRC_PHY   @ 0x120DC000;
    eHI3516EV300_FMC        FMC        @ 0x10000000;
    eHI3516EV300_VICAP      VICAP      @ 0x11000000;
    eHI3516EV300_VDP        VDP        @ 0x11280000;
    eHI3516EV300_MIPI_RX    MIPI_RX    @ 0x11240000;
    eHI3516EV300_AIAO       AIAO       @ 0x100E0000;
    eHI3516EV300_ACODEC     ACODEC     @ 0x100F0000;
    eHI3516EV300_MMC        MMC0       @ 0x10010000;
    eHI3516EV300_MMC        MMC1       @ 0x10020000;
    eHI3516EV300_USB        USB        @ 0x10030000;
    eHI3516EV300_SPACC      SPACC      @ 0x10050000;
    eHI3516EV300_KLAD       KLAD       @ 0x10060000;
    eHI3516EV300_TRNG       TRNG       @ 0x10080000;
    eHI3516EV300_OTP        OTP        @ 0x10090000;
    eHI3516EV300_LSADC      LSADC      @ 0x120A0000;
    eHI3516EV300_DMAC       DMAC       @ 0x100B0000;
    eHI3516EV300_RTC        RTC        @ 0x120E0000;
    eHI3516EV300_RTC_INT    RTC_INT    @ 0x120E0100;
};
