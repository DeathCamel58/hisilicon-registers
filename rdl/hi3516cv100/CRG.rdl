    reg {
        name = "CRG status register";
        desc = "PERI_CRG58 is a CRG status register.

PLL lock status. Wait for apll_lock (bit 0) before switching SYS_CTRL SC_CTRL[modectrl] to normal mode (100) and for the other PLLs before using their clocks.

Data sheet 3.2.5 PERI_CRG58 (offset 0xE8, printed page 3-44, `hi3516cv100--Hi3516C-Datasheet.txt` line 11007).";

        enum PERI_CRG58_epll_lock_enum {
            UNLOCKED = 0 { name = "Unlocked"; desc = "unlocked"; };
            LOCKED = 1 { name = "Locked"; desc = "locked"; };
        };

        field {
            name = "epll_lock";
            desc = "EPLL lock status.";
            sw = r;
            hw = w;
            encode = PERI_CRG58_epll_lock_enum;
            reset = 0x0;
        } epll_lock[3:3];

        enum PERI_CRG58_bpll_lock_enum {
            UNLOCKED = 0 { name = "Unlocked"; desc = "unlocked"; };
            LOCKED = 1 { name = "Locked"; desc = "locked"; };
        };

        field {
            name = "bpll_lock";
            desc = "BPLL lock status.";
            sw = r;
            hw = w;
            encode = PERI_CRG58_bpll_lock_enum;
            reset = 0x0;
        } bpll_lock[2:2];

        enum PERI_CRG58_vpll0_lock_enum {
            UNLOCKED = 0 { name = "Unlocked"; desc = "unlocked"; };
            LOCKED = 1 { name = "Locked"; desc = "locked"; };
        };

        field {
            name = "vpll0_lock";
            desc = "VPLL0 lock status.";
            sw = r;
            hw = w;
            encode = PERI_CRG58_vpll0_lock_enum;
            reset = 0x0;
        } vpll0_lock[1:1];

        enum PERI_CRG58_apll_lock_enum {
            UNLOCKED = 0 { name = "Unlocked"; desc = "unlocked"; };
            LOCKED = 1 { name = "Locked"; desc = "locked"; };
        };

        field {
            name = "apll_lock";
            desc = "APLL lock status.";
            sw = r;
            hw = w;
            encode = PERI_CRG58_apll_lock_enum;
            reset = 0x0;
        } apll_lock[0:0];
    } PERI_CRG58 @ 0xE8;

    reg {
        name = "Speed monitor control register";
        desc = "PERI_CRG61 is a speed monitor control register.

Speed monitor (silicon speed sensor) control. The vendor U-Boot start.S (svb_voltage_adjust) reads the sensor 8 times: write 0x3 then 0x7 to this register (osc_clk_en and osc_mode, then osc_en), poll PERI_CRG62 osc_valid (bit 9), read osc_value (bits 8:0), and averages.

Data sheet 3.2.5 PERI_CRG61 (offset 0xF4, printed page 3-45, `hi3516cv100--Hi3516C-Datasheet.txt` line 11055).";

        enum PERI_CRG61_osc_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "osc_en";
            desc = "Speed monitor enable.";
            sw = rw;
            hw = r;
            encode = PERI_CRG61_osc_en_enum;
            reset = 0x0;
        } osc_en[2:2];

        enum PERI_CRG61_osc_mode_enum {
            STEP_150 = 0 { name = "Step 150"; desc = "150-step level"; };
            STEP_200 = 1 { name = "Step 200"; desc = "200-step level"; };
        };

        field {
            name = "osc_mode";
            desc = "Speed monitor mode.";
            sw = rw;
            hw = r;
            encode = PERI_CRG61_osc_mode_enum;
            reset = 0x0;
        } osc_mode[1:1];

        enum PERI_CRG61_osc_clk_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "osc_clk_en";
            desc = "Speed monitor clock enable.";
            sw = rw;
            hw = r;
            encode = PERI_CRG61_osc_clk_en_enum;
            reset = 0x0;
        } osc_clk_en[0:0];
    } PERI_CRG61 @ 0xF4;

    reg {
        name = "Speed monitor status register 1";
        desc = "PERI_CRG62 is speed monitor status register 1.

Speed monitor status. Used by the vendor U-Boot SVB code (see PERI_CRG61) to pick the core voltage.

Data sheet 3.2.5 PERI_CRG62 (offset 0xF8, printed page 3-46, `hi3516cv100--Hi3516C-Datasheet.txt` line 11094).";

        enum PERI_CRG62_osc_valid_enum {
            INVALID = 0 { name = "Invalid"; desc = "invalid;"; };
            VALID = 1 { name = "Valid"; desc = "valid."; };
        };

        field {
            name = "osc_valid";
            desc = "Status of the SpeedMonitor.";
            sw = r;
            hw = w;
            encode = PERI_CRG62_osc_valid_enum;
            reset = 0x0;
        } osc_valid[9:9];

        field {
            name = "osc_value";
            desc = "Value of the SpeedMonitor.";
            sw = r;
            hw = w;
            reset = 0x0;
        } osc_value[8:0];
    } PERI_CRG62 @ 0xF8;

};

