            ASSERT_RESET = 1 { name = "Assert Reset"; desc = "reset (the module is held in reset until the bit is cleared)"; };
        };

        field {
            name = "ssp1_srst_req";
            desc = "SSP1 soft reset request.";
            sw = rw;
            hw = r;
            encode = PERI_CRG57_ssp1_srst_req_enum;
            reset = 0x0;
        } ssp1_srst_req[6:6];

        enum PERI_CRG57_ssp0_srst_req_enum {
            DEASSERT_RESET = 0 { name = "Deassert Reset"; desc = "deassert reset"; };
            ASSERT_RESET = 1 { name = "Assert Reset"; desc = "reset (the module is held in reset until the bit is cleared)"; };
        };

        field {
            name = "ssp0_srst_req";
