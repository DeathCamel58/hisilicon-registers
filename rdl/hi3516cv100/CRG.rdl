            NORMAL_OUTPUT_CLOCK = 1 { name = "Normal Output Clock"; desc = "normal output clock"; };
        };

        field {
            name = "apll_foutvcopd";
            desc = "Power down control for the APLL VCO output.";
            sw = rw;
            hw = r;
            encode = PERI_CRG1_apll_foutvcopd_enum;
            reset = 0x0;
        } apll_foutvcopd[20:20];

        enum PERI_CRG1_apll_postdivpd_enum {
            NO_OUTPUT_CLOCK = 0 { name = "No Output Clock"; desc = "no output clock"; };
            NORMAL_OUTPUT_CLOCK = 1 { name = "Normal Output Clock"; desc = "normal output clock"; };
        };

        field {
            name = "apll_postdivpd";
            desc = "Power down control for the APLL POSTDIV output.";
            sw = rw;
            hw = r;
