            reset = 0x1;
        } apll_postdivpd[19:19];

        enum PERI_CRG1_apll_fout4phasepd_enum {
            NO_OUTPUT_CLOCK = 0 { name = "No Output Clock"; desc = "no output clock"; };
            NORMAL_OUTPUT_CLOCK = 1 { name = "Normal Output Clock"; desc = "normal output clock"; };
        };

        field {
            name = "apll_fout4phasepd";
            desc = "Power down control for the APLL FOUT output.";
            sw = rw;
