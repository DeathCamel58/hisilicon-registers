            ASSERT_RESET = 1 { name = "Assert Reset"; desc = "reset (the module is held in reset until the bit is cleared)"; };
        };

        field {
            name = "ir_srst_req";
            desc = "IR soft reset request.";
            sw = rw;
            hw = r;
            encode = PERI_CRG57_ir_srst_req_enum;
            reset = 0x0;
        } ir_srst_req[4:4];

        enum PERI_CRG57_t_cap_srst_req_enum {
            DEASSERT_RESET = 0 { name = "Deassert Reset"; desc = "deassert reset"; };
            ASSERT_RESET = 1 { name = "Assert Reset"; desc = "reset (the module is held in reset until the bit is cleared)"; };
        };

        field {
            name = "t_cap_srst_req";
            desc = "Temper_Cap (temperature capture, interrupt 10) soft reset request. The data sheet names this bit `t_cap_srst_req`.";
            sw = rw;
