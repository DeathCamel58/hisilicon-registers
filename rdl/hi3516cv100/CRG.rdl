            reset = 0x3;
        } apll_refdiv[17:12];

        field {
            name = "apll_fbdiv";
            desc = "Integral multiplier of the APLL.";
            sw = rw;
            hw = r;
            reset = 0x6E;
        } apll_fbdiv[11:0];
    } PERI_CRG1 @ 0x4;

    reg {
        name = "VPLL0 configuration register 0";
        desc = "PERI_CRG2 is VPLL0 configuration register 0.

VPLL0 (video PLL). FOUTVCO = 24 MHz x (fbdiv + frac/2^24) / refdiv (must be > 600 MHz and <= 1.6 GHz); FOUTPOSTDIV = FOUTVCO / (postdiv1 x postdiv2); FOUT1ph0/2/3/4 = FOUTVCO / (postdiv1 x postdiv2 x 2/4/6/8). In the power-down fields 0 = power down / no output and 1 = normal. Reset (Total Reset Value 0x12000000 / 0x007C2063): postdiv2 = 2, postdiv1 = 2, refdiv = 2, fbdiv = 99 -> VCO 1188 MHz (the data sheet's worked example), POSTDIV output 297 MHz. Derived clocks (Table 3-3): VCO/6 = 198 MHz (VPSS, TDE), VCO/12 = 99 MHz (MDU, NFC, CIPHER), FOUT2 = VCO/16 = 74.25 MHz (VDP HD). LOW CONFIDENCE ON THE BIT ROW: the printed bit row (postdiv1 = 4, refdiv = 4, fbdiv = 178) disagrees with the header; the header is used.

Data sheet 3.2.5 PERI_CRG2 (offset 0x8, printed page 3-18, `hi3516cv100--Hi3516C-Datasheet.txt` line 9478).";

