// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3516cv100-video" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3516C V100: video data path</B><BR/><FONT POINT-SIZE="11">block names from the data sheet logic figure and chapter 1; arrows are the usual camera data path (INFERRED, not tabulated); DDR sits between the stages</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  sens [label="CMOS / CCD sensor", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  vi [label="RAW Bayer 8/10/12 bit, BT.656 / BT.1120", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  vicap [label="VICAP", fillcolor="#a6c98f"  ];
  isp [label="ISP (3A, WDR)", fillcolor="#a6c98f"  ];
  vpss [label="VPSS + TDE\n3DNR, scale, de-interlace, OSD", fillcolor="#a6c98f"  ];
  enc [label="H.264 BP/MP + MJPEG/JPEG\nencoder (VEDU, JPGE)", fillcolor="#a6c98f"  ];
  ive [label="IVE / MDU\nmotion detection", fillcolor="#a6c98f"  ];
  vdp [label="VDP", fillcolor="#a6c98f"  ];
  out [label="CVBS, BT.1120 out", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  sink [label="SPI NOR / SD / USB / ETH", fillcolor="#8fb3de"  ];
  sens -> vi;
  vi -> vicap;
  vicap -> isp;
  isp -> vpss;
  vpss -> enc;
  vpss -> ive;
  vpss -> vdp;
  vdp -> out;
  enc -> sink [label="streams"];
}
