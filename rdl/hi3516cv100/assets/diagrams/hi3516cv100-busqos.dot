digraph "hi3516cv100-busqos" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3516C V100: bus master and slave ports</B><BR/><FONT POINT-SIZE="11">ports named in the system controller bus timeout/priority registers (PERIPHCTRL5-13); topology between the buses is INFERRED from the slave port list</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  ddrc [label="MDDRC (DDR controller)", fillcolor="#e0b86f"  ];
  sysaxi [label="SYS AXI bus", fillcolor="#9a9a9a"  ];
  mediabus [label="media bus(es)", fillcolor="#9a9a9a"  ];
  sm0 [label="AHB bridge (port0)", fillcolor="#8fb3de"  ];
  sm1 [label="ARMD (CPU data) (port1)", fillcolor="#8fb3de"  ];
  sm2 [label="IVE (port2)", fillcolor="#8fb3de"  ];
  sm3 [label="ARMI (CPU instruction) (port3)", fillcolor="#8fb3de"  ];
  ss0 [label="slave s1: AHB (peripheral bridge)", fillcolor="#7fcdc4"  ];
  ss1 [label="slave s2: APB_SYS", fillcolor="#7fcdc4"  ];
  ss2 [label="slave s3: APB_MEDIA", fillcolor="#7fcdc4"  ];
  media0 [label="VENC (port0)", fillcolor="#a6c98f"  ];
  media1 [label="VPSS (port1)", fillcolor="#a6c98f"  ];
  media2 [label="TDE (port2)", fillcolor="#a6c98f"  ];
  media3 [label="JPGE (port3)", fillcolor="#a6c98f"  ];
  media4 [label="MDU (port4)", fillcolor="#a6c98f"  ];
  sysaxi -> ddrc;
  mediabus -> sysaxi;
  sm0 -> sysaxi;
  sm1 -> sysaxi;
  sm2 -> sysaxi;
  sm3 -> sysaxi;
  sysaxi -> ss0;
  sysaxi -> ss1;
  sysaxi -> ss2;
  media0 -> mediabus;
  media1 -> mediabus;
  media2 -> mediabus;
  media3 -> mediabus;
  media4 -> mediabus;
}
