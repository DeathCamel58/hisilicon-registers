// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3516cv100-io" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3516C V100: storage, network and USB paths</B><BR/><FONT POINT-SIZE="11">from the architecture and peripheral lists of the data sheet; the controller-to-device wiring shown is the usual board connection (INFERRED where not named in the sheet)</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  cpu [label="CPU + bus", fillcolor="#e0b86f"  ];
  sdio [label="SDIO 2.0 x1", fillcolor="#8fb3de"  ];
  sdio_x [label="SD/MMC card or SDIO device", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  sfc [label="SFC (SPI NOR, 1 CS)", fillcolor="#8fb3de"  ];
  sfc_x [label="SPI NOR flash", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  nand [label="NANDC (8-bit)", fillcolor="#8fb3de"  ];
  nand_x [label="NAND flash", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  eth [label="ETH MAC 10/100", fillcolor="#8fb3de"  ];
  eth_x [label="external Ethernet PHY", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  usb [label="USB 2.0 host x1", fillcolor="#8fb3de"  ];
  usb_x [label="USB port", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  cpu -> sdio;
  sdio -> sdio_x;
  cpu -> sfc;
  sfc -> sfc_x;
  cpu -> nand;
  nand -> nand_x;
  cpu -> eth;
  eth -> eth_x;
  cpu -> usb;
  usb -> usb_x;
}
