`ifndef DEFINES_RDL
`define DEFINES_RDL

// Hi3518EV200 (data sheet Hi3518E V20X / Hi3516C V200): field-reset selectors of the shared components.
// G1..G3, G5, G6 give the SPI (PL022) resets of this data sheet (TXINTSize/RXINTSize reset 1, i.e. G5 and not the G4 variant).
`define SPI_RESET_G1
`define SPI_RESET_G2
`define SPI_RESET_G3
`define SPI_RESET_G5
`define SPI_RESET_G6
`define SPI_MODE_ALTASENS   // HISI_SPI.rdl: SPICR1 bit 6 mode_altasens is listed by this chip's data sheet
`define TIMER_SP804_RESET_G1
`define WDG_SP805_RESET_G1

// HISI_USB_HOST.rdl: this data sheet's INTNREG01..03 layouts and the INTNREG05 vcontrol_loadm reset of 1
`define USB_HOST_INSNREG_DS
`define USB_HOST_INTNREG05_RESET1

`endif
