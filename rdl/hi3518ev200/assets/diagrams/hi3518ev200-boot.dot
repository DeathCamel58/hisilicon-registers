// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3518ev200-boot" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3518E V200 / Hi3516C V200: boot flow</B><BR/><FONT POINT-SIZE="11">data sheet 1.3 and 4.1 (pins in parentheses); straps readable in SYS_CTRL SYSSTAT</FONT>>, fontcolor="#808080", rankdir=TB];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  por [label="Power-on reset", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  b1 [label="BOOTROM_SEL (MDCK) ?", fillcolor="#d6d27a"   shape=diamond];
  rom [label="BOOTROM\nserial download", fillcolor="#e0b86f"  ];
  b2 [label="BOOT_SEL (EPHY_RST) ?", fillcolor="#d6d27a"   shape=diamond];
  spi [label="SPI flash on the FMC (CS0)\nNOR 3/4-byte or NAND 1/4-wire\n(SFC_DEVICE_MODE = SHUTTER_TRIG,\nSFC_EMMC_BOOT_MODE = FLASH_TRIG)", fillcolor="#8fb3de"  ];
  emmc [label="eMMC, 4- or 8-wire\n(SFC_EMMC_BOOT_MODE)", fillcolor="#8fb3de"  ];
  run [label="Boot memory remapped to address 0;\nboot code clears the remap\n(SC_CTRL remapclear)", fillcolor="#a6c98f"  ];
  por -> b1;
  b1 -> rom [label="1"];
  b1 -> b2 [label="0"];
  b2 -> spi [label="0"];
  b2 -> emmc [label="1"];
  rom -> run;
  spi -> run;
  emmc -> run;
}
