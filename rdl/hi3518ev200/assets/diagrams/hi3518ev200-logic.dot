// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3518ev200-logic" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3518E V200 / V201: logic block diagram</B><BR/><FONT POINT-SIZE="11">redrawn from data sheet Figure 1-3 / 1-4 (chapter 1)</FONT>>, fontcolor="#808080", rankdir=LR, compound=true, newrank=true];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  bus [label="AMBA 3.0 bus", fillcolor="#9a9a9a"  shape=box, height=5.2, width=0.5, fontcolor="white"];
  subgraph cluster_cpu { label="CPU subsystem"; fontcolor="#808080"; color="#808080"; style="rounded";
  cpu [label="ARM926EJ-S 540 MHz\n32 KB I + 32 KB D cache", fillcolor="#e0b86f"  ];
  }
  ddrc [label="DDRC", fillcolor="#8fb3de"  ];
  ddrext [label="embedded 16-bit DDR2\n(512 / 256 Mbit)", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  ddrext -> ddrc [dir=both]; ddrc -> cpu [dir=both]; ddrc -> bus [dir=both, style=dashed];
  subgraph cluster_l0 { label="Storage, network, USB"; fontcolor="#808080"; color="#808080"; style="rounded";
    sdio [label="SDIO x2", fillcolor="#8fb3de"  ];
    fmc [label="FMC (SPI NOR / NAND)", fillcolor="#8fb3de"  ];
    emmc [label="eMMC", fillcolor="#8fb3de"  ];
    eth [label="ETH MAC +\nFE PHY", fillcolor="#8fb3de"  ];
    usb [label="USB 2.0 host / device", fillcolor="#8fb3de"  ];
    aud [label="audio codec + I2S", fillcolor="#8fb3de"  ];
  }
  sdio -> bus [dir=both];
  fmc -> bus [dir=both];
  emmc -> bus [dir=both];
  eth -> bus [dir=both];
  usb -> bus [dir=both];
  aud -> bus [dir=both];
  subgraph cluster_l1 { label="Security"; fontcolor="#808080"; color="#808080"; style="rounded";
    sec [label="AES / DES / 3DES / RSA /\nHash / OTP / TRNG", fillcolor="#c9a0dc"  ];
  }
  sec -> bus [dir=both];
  subgraph cluster_r0 { label="Image subsystem"; fontcolor="#808080"; color="#808080"; style="rounded";
    isp [label="ISP (3A, WDR)", fillcolor="#a6c98f"  ];
    vin [label="VICAP: MIPI / LVDS /\nHiSPi / BT.656 / LCD", fillcolor="#a6c98f"  ];
    vpss [label="VPSS + VGS", fillcolor="#a6c98f"  ];
    tde [label="TDE + IVE", fillcolor="#a6c98f"  ];
  }
  bus -> isp [dir=both];
  bus -> vin [dir=both];
  bus -> vpss [dir=both];
  bus -> tde [dir=both];
  subgraph cluster_r1 { label="Video subsystem"; fontcolor="#808080"; color="#808080"; style="rounded";
    enc [label="H.264 BP/MP/HP,\nMJPEG/JPEG encoder", fillcolor="#a6c98f"  ];
  }
  bus -> enc [dir=both];
  subgraph cluster_r2 { label="Low-speed peripherals (APB)"; fontcolor="#808080"; color="#808080"; style="rounded";
    lsp [label="RTC, I2C / I2S, SSP, GPIO, IR,\nUART x3, PWM x4, SAR-ADC x4", fillcolor="#7fcdc4"  ];
  }
  bus -> lsp [dir=both];
  sd [label="SD/SDXC card", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  sd -> sdio [dir=both, style=dashed];
  nor [label="SPI NOR / NAND flash", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  nor -> fmc [dir=both, style=dashed];
  emmcx [label="eMMC", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  emmcx -> emmc [dir=both, style=dashed];
  phy [label="RJ45 transformer", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  phy -> eth [dir=both, style=dashed];
  usbp [label="USB", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  usbp -> usb [dir=both, style=dashed];
  bus -> cpu [dir=both];
}
