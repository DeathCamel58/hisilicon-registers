// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3516cv200-clocks" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3516C V200: clock tree</B><BR/><FONT POINT-SIZE="11">data sheet 3.2 (Tables 3-2 to 3-6); the clock distribution figure is not tabulated: selects and dividers are the CRG fields the sheet names</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  xin [label="XIN crystal 24 MHz", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  rtc [label="RTC_XIN 32.768 kHz", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  apll [label="APLL (PERI_CRG0/1)\nprogrammable", fillcolor="#e6a0a0"  ];
  vpll [label="VPLL (PERI_CRG4/5)", fillcolor="#e6a0a0"  ];
  epll [label="EPLL (PERI_CRG8/9)", fillcolor="#e6a0a0"  ];
  cpu [label="ARM9 clock\ncpu_sc_sel PERI_CRG12[8], cpu_clk_div [5:4],\nskip PERI_CRG10[16:12]; slow = crystal", fillcolor="#e0b86f"  ];
  bus [label="bus clock: bus_sc_sel PERI_CRG12[0]", fillcolor="#e0b86f"  ];
  vo [label="VDP / LCD: PERI_CRG13 hd_cksel, vo_out_cksel,\nhd_lcd_cksel, lcd_cksel; lcd_mclk_div PERI_CRG26", fillcolor="#a6c98f"  ];
  vi [label="VICAP / MIPI / sensor clock\nPERI_CRG11 sensor_cksel [18:16], vi0_sc_sel", fillcolor="#a6c98f"  ];
  pipe [label="AVC, VPSS, TDE, VGS, JPGE:\nloaden + skip fields (PERI_CRG16/18/22/23/24)", fillcolor="#a6c98f"  ];
  io [label="SFC PERI_CRG48, SDIO0/1 PERI_CRG49,\nPWM PERI_CRG14, UART PERI_CRG57,\nETH core/PHY/RMII PERI_CRG59", fillcolor="#8fb3de"  ];
  gate [label="CRG clock gates and soft resets", fillcolor="#9aa7e6"  ];
  tim [label="Timers: SC_CTRL timeren0ov..3ov\n3 MHz / bus clock", fillcolor="#d6d27a"  ];
  xin -> apll;
  xin -> vpll;
  xin -> epll;
  xin -> cpu [label="slow mode"];
  apll -> cpu [label="normal mode"];
  apll -> bus;
  vpll -> vo;
  vpll -> vi;
  vpll -> pipe;
  epll -> io;
  cpu -> gate;
  bus -> gate;
  bus -> tim;
  vo -> gate;
  vi -> gate;
  pipe -> gate;
  io -> gate;
  rtc -> gate [label="RTC"];
}
