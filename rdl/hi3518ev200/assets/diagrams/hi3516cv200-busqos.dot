digraph "hi3516cv200-busqos" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3516C V200: bus master and slave ports</B><BR/><FONT POINT-SIZE="11">ports named in the system controller bus timeout/priority registers (MISC_CTRL registers); topology between the buses is INFERRED from the slave port list</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  ddrc [label="MDDRC (DDR controller)", fillcolor="#e0b86f"  ];
  sysaxi [label="SYS AXI bus", fillcolor="#9a9a9a"  ];
  mediabus [label="media bus(es)", fillcolor="#9a9a9a"  ];
  sm0 [label="CPU (M1)", fillcolor="#8fb3de"  ];
  sm1 [label="AHB0 (M2)", fillcolor="#8fb3de"  ];
  sm2 [label="AHB1 (M3)", fillcolor="#8fb3de"  ];
  ss0 [label="slave s1: ahb_cfg", fillcolor="#7fcdc4"  ];
  ss1 [label="slave s2: sysapb", fillcolor="#7fcdc4"  ];
  ss2 [label="slave s3: mediaapb", fillcolor="#7fcdc4"  ];
  media00 [label="AVC (M1)", fillcolor="#a6c98f"  ];
  media01 [label="VGS (M2)", fillcolor="#a6c98f"  ];
  media10 [label="TDE / DDRT (M1)", fillcolor="#a6c98f"  ];
  media11 [label="JPGE (M2)", fillcolor="#a6c98f"  ];
  media12 [label="AIAO (M3)", fillcolor="#a6c98f"  ];
  media13 [label="IVE / GZIP (M4)", fillcolor="#a6c98f"  ];
  sysaxi -> ddrc;
  mediabus -> sysaxi;
  sm0 -> sysaxi;
  sm1 -> sysaxi;
  sm2 -> sysaxi;
  sysaxi -> ss0;
  sysaxi -> ss1;
  sysaxi -> ss2;
  media00 -> mediabus [label="media0"];
  media01 -> mediabus [label="media0"];
  media10 -> mediabus [label="media1"];
  media11 -> mediabus [label="media1"];
  media12 -> mediabus [label="media1"];
  media13 -> mediabus [label="media1"];
}
