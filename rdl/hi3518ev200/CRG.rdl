            V_24_MHZ_CLOCK = 1 { name = "24 MHz Clock"; desc = "24 MHz clock"; };
            V_6_MHZ_CLOCK = 2 { name = "6 MHz Clock"; desc = "6 MHz clock (data sheet `1x`)"; };
            V_6_MHZ_CLOCK_2 = 3 { name = "6 MHz Clock (alias)"; desc = "6 MHz clock (data sheet `1x`)"; };
