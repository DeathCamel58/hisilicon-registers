`ifndef HI3518EV200_CRG_RDL
`define HI3518EV200_CRG_RDL

regfile eCRG {
    name = "Clock and reset generator (CRG), Hi3518E V20X";
    desc = "
    PERI_CRGn clock/reset registers at 0x20030000. Three PLLs (APLL = CPU, VPLL = video, EPLL), fed by the 24 MHz XIN crystal; the other PLL
    outputs are fixed. Reset values come from the data sheet total reset value. Every module has a soft reset request bit (1 = reset, the reset is NOT
    released automatically) and a clock gate. Data sheet Hi3518E V20X/Hi3516C V200 issue 02, chapter 3.2.

    Clock facts used by the bring-up code: ARM926 runs from the 24 MHz crystal after reset (cpu_sc_sel = 0); bus/APB mux PERI_CRG12 bit 0 (24 MHz / 198 MHz, APB = /4);
    UART mux PERI_CRG57 [20:19] (APB / 24 MHz / 6 MHz); timers use 3 MHz or the APB clock (SYS_CTRL SC_CTRL).
    Vendor clock tree (clk-hi3518ev20x.c, `hisilicon,hi3518ev20x-clock`): sysapb = bus mux / 4 (6 or 49.5 MHz, parent of the I2Cs, GPIOs and timers); SSP0/SSP1 (PERI_CRG57 bits 13/14)
    are clocked from the bus mux itself (24 or 198 MHz), DMAC (PERI_CRG54 bit 5) from a fixed 50 MHz (the data sheet SPI chapter, line 80003, says the SPI reference clock is the APB bus clock, 49.5 MHz at bus_sc_sel = 1, with SPI_CLK <= 24.75 MHz, so the vendor parent `sysapb_mux` for SSP is probably the wrong node; crg-hi3516cv200.c in the same tree uses a fixed 50 MHz and different mmc/eth/usb offsets that contradict both the data sheet and the vendor U-Boot, so it is not used as evidence), FMC from the PERI_CRG48 mux, ETH from the PERI_CRG59 mux, SDIO0/1 from the PERI_CRG49 muxes.

    Sources: HiSilicon's own English data sheet (issue 02, 2017-06-12; the `Hi3518E` data sheet issue 03 of 2015 in the same dump folder is the Hi3518E V100, SC_SYSID 0x3518_0100, and
    does not apply). No Chinese original of the Hi3518E V20X/Hi3516C V200 data sheet is available locally, so disputed values were settled with the vendor U-Boot
    (`arch-hi3518ev200/platform.h`, `hiusb-3518ev200.c`) and the vendor Linux clock driver; each such case is noted in the register description. The reserved-bit resets follow
    the `Total Reset Value` header where it disagrees with the bit row. Register names, offsets, bit ranges and resets of all 35 registers were checked against the data
    sheet on 2026-11-09. The Hi3516C V200 uses the same CRG (same data sheet chapter); only the APLL target (600 MHz CPU) differs.
    ";

    reg {
        name = "APLL configuration register 0";
        desc = "PERI_CRG0 is APLL configuration register 0.

APLL (CPU PLL). XIN = 24 MHz. FOUTVCO = 24 MHz x (fbdiv + frac/2^24) / refdiv (must be > 600 MHz and <= 2.4 GHz); FOUTPOSTDIV = FOUTVCO / (postdiv1 x postdiv2). Reset: postdiv2 = 1, postdiv1 = 2, refdiv = 2, fbdiv = 100 -> VCO 1200 MHz, POSTDIV output 600 MHz. The data sheet lists 540/600/660/750 MHz as the CPU frequencies (Hi3518E V20X is specified for 540 MHz). Change the APLL only while the CPU runs from the 24 MHz crystal (PERI_CRG12 cpu_sc_sel = 0); the PLL is stable 0.1 ms after the change, check PERI_CRG58 apll_lock. DS section 3.2.4 mixes `12 x` and `refdiv 2` in its worked example (24 MHz x 100 / 2 = 1200 MHz is the consistent reading) and refers to `Table 3-1` where Table 3-2/3-3 is meant.

Data sheet 3.2.7 PERI_CRG0 (offset 0x0, printed page 3-11, `hi3518ev200-datasheet.txt` line 22802).";

        field {
            name = "apll_postdiv2";
            desc = "Level-2 output divider of the APLL";
            sw = rw;
            hw = r;
            reset = 0x1;
        } apll_postdiv2[30:28];

        field {
            name = "apll_postdiv1";
            desc = "Level-1 output divider of the APLL";
            sw = rw;
            hw = r;
            reset = 0x2;
        } apll_postdiv1[26:24];

        field {
            name = "apll_frac";
            desc = "Decimal divider of the APLL";
            sw = rw;
            hw = r;
            reset = 0x0;
        } apll_frac[23:0];
    } PERI_CRG0 @ 0x0;

    reg {
        name = "APLL configuration register 1";
        desc = "PERI_CRG1 is APLL configuration register 1.

Data sheet 3.2.7 PERI_CRG1 (offset 0x4, printed page 3-12, `hi3518ev200-datasheet.txt` line 22841).";

        enum PERI_CRG1_apll_bypass_enum {
            NOT_BYPASSED = 0 { name = "Not Bypassed"; desc = "not bypassed"; };
            BYPASSED = 1 { name = "Bypassed"; desc = "bypassed"; };
        };

        field {
            name = "apll_bypass";
            desc = "APLL clock frequency division bypass";
            sw = rw;
            hw = r;
            encode = PERI_CRG1_apll_bypass_enum;
            reset = 0x0;
        } apll_bypass[26:26];

        enum PERI_CRG1_apll_dacpd_enum {
            NORMAL_OPERATING_MODE = 0 { name = "Normal Operating Mode"; desc = "normal operating mode"; };
            POWER_DOWN_MODE = 1 { name = "Power Down Mode"; desc = "power-down mode"; };
        };

        field {
            name = "apll_dacpd";
            desc = "APLL test signal control";
            sw = rw;
            hw = r;
            encode = PERI_CRG1_apll_dacpd_enum;
            reset = 0x0;
        } apll_dacpd[25:25];

        enum PERI_CRG1_apll_dsmpd_enum {
            DECIMAL_FREQUENCY_DIVISION = 0 { name = "Decimal Frequency Division"; desc = "decimal frequency-division mode"; };
            INTEGRAL_FREQUENCY_DIVISION = 1 { name = "Integral Frequency Division"; desc = "integral frequency-division mode"; };
        };

        field {
            name = "apll_dsmpd";
            desc = "APLL decimal division control";
            sw = rw;
            hw = r;
            encode = PERI_CRG1_apll_dsmpd_enum;
            reset = 0x1;
        } apll_dsmpd[24:24];

        enum PERI_CRG1_apll_pd_enum {
            NORMAL_OPERATING_MODE = 0 { name = "Normal Operating Mode"; desc = "normal operating mode"; };
            POWER_DOWN_MODE = 1 { name = "Power Down Mode"; desc = "power-down mode"; };
        };

        field {
            name = "apll_pd";
            desc = "APLL power-down control";
            sw = rw;
            hw = r;
            encode = PERI_CRG1_apll_pd_enum;
            reset = 0x0;
        } apll_pd[23:23];

        enum PERI_CRG1_apll_foutvcopd_enum {
            NORMAL_OUTPUT_CLOCK = 0 { name = "Normal Output Clock"; desc = "normal output clock"; };
            NO_OUTPUT_CLOCK = 1 { name = "No Output Clock"; desc = "no output clock"; };
        };

        field {
            name = "apll_foutvcopd";
            desc = "APLL VCO output power-down control";
            sw = rw;
            hw = r;
            encode = PERI_CRG1_apll_foutvcopd_enum;
            reset = 0x0;
        } apll_foutvcopd[22:22];

        enum PERI_CRG1_apll_postdivpd_enum {
            NORMAL_CLOCK_OUTPUT = 0 { name = "Normal Clock Output"; desc = "normal clock output"; };
            NO_OUTPUT_CLOCK = 1 { name = "No Output Clock"; desc = "no output clock"; };
        };

        field {
            name = "apll_postdivpd";
            desc = "APLL POSTDIV output power-down control";
            sw = rw;
            hw = r;
            encode = PERI_CRG1_apll_postdivpd_enum;
            reset = 0x0;
        } apll_postdivpd[21:21];

        enum PERI_CRG1_apll_fout4phasepd_enum {
            NORMAL_OUTPUT_CLOCK = 0 { name = "Normal Output Clock"; desc = "normal output clock"; };
            NO_OUTPUT_CLOCK = 1 { name = "No Output Clock"; desc = "no output clock"; };
        };

        field {
            name = "apll_fout4phasepd";
            desc = "APLL FOUT output power-down control";
            sw = rw;
            hw = r;
            encode = PERI_CRG1_apll_fout4phasepd_enum;
            reset = 0x0;
        } apll_fout4phasepd[20:20];

        field {
            name = "apll_refdiv";
            desc = "Frequency divider of the APLL reference clock";
            sw = rw;
            hw = r;
            reset = 0x2;
        } apll_refdiv[17:12];

        field {
            name = "apll_fbdiv";
            desc = "Integral frequency multiplier of the APLL";
            sw = rw;
            hw = r;
            reset = 0x64;
        } apll_fbdiv[11:0];
    } PERI_CRG1 @ 0x4;

    reg {
        name = "VPLL configuration register 0";
        desc = "PERI_CRG4 is VPLL configuration register 0.

VPLL: reset VCO = 24 x 99 / 2 = 1188 MHz, POSTDIV (/2) = 594 MHz; source of the fixed 297/148.5/99/74.25/37.125 MHz module clocks (vendor kernel names 594m, 297m, 198m, 148.5m, 99m, 74.25m, 49.5m, 37.125m).

Data sheet 3.2.7 PERI_CRG4 (offset 0x10, printed page 3-13, `hi3518ev200-datasheet.txt` line 22899).";

        field {
            name = "vpll_postdiv2";
            desc = "Level-2 output divider of VPLL";
            sw = rw;
            hw = r;
            reset = 0x1;
        } vpll_postdiv2[30:28];

        field {
            name = "vpll_postdiv1";
            desc = "Level-1 output divider of VPLL";
            sw = rw;
            hw = r;
            reset = 0x2;
        } vpll_postdiv1[26:24];

        field {
