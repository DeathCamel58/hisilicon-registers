            APLL_POSTDIV = 1 { name = "APLL POSTDIV"; desc = "APLL_POSTDIV (configurable frequency of 540, 600, 660, or 750 MHz)"; };
        };

        field {
            name = "cpu_sc_sel";
            desc = "CPU clock select";
            sw = rw;
            hw = r;
            encode = PERI_CRG12_cpu_sc_sel_enum;
            reset = 0x0;
        } cpu_sc_sel[8:8];

        enum PERI_CRG12_cpu_clk_div_enum {
            CPU_DIV_3 = 2 { name = "CPU Clock / 3"; desc = "DDR bus clock = CPU clock divided by 3 (the only documented value; others reserved)"; };
        };

        field {
            name = "cpu_clk_div";
