    reg {
        name = "ARM9 frequency mode and reset configuration register";
        desc = "PERI_CRG10 is an ARM9 frequency mode and reset configuration register.

The ARM9 clock skip configuration: cpuclk_skipcfg = N disables N beats out of every 32 CPU clocks. Software writes cpuclk_skipcfg, then pulses cpuclk_loaden 0 -> 1 -> 0 (DS: write the value, write 0 to loaden, write 1 to loaden).

Data sheet 3.2.7 PERI_CRG10 (offset 0x28, printed page 3-17, `hi3518ev200-datasheet.txt` line 23095).";

        field {
            name = "cpuclk_loaden";
            desc = "Skip configuration enable for the CPU clock To change the skip configuration, perform the following steps: 1. Write a new skip configuration value. 2. Write 0 to loaden. 3. Write 1 to loaden.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } cpuclk_loaden[17:17];

        field {
            name = "cpuclk_skipcfg";
            desc = "Skip configuration of the CPU clock N: N-beat clocks are disabled every 32-beat CPU clocks.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } cpuclk_skipcfg[16:12];

        enum PERI_CRG10_arm_core_srst_req_enum {
            DEASSERT_RESET = 0 { name = "Deassert Reset"; desc = "deassert reset"; };
            RESET = 1 { name = "Reset"; desc = "reset"; };
        };

        field {
            name = "arm_core_srst_req";
            desc = "ARM core soft reset request";
            sw = rw;
            hw = r;
            encode = PERI_CRG10_arm_core_srst_req_enum;
            reset = 0x0;
        } arm_core_srst_req[5:5];
    } PERI_CRG10 @ 0x28;

    reg {
        name = "VICAP&MIPI CTRL and sensor clock and reset configuration register";
        desc = "PERI_CRG11 is a VICAP&MIPI CTRL and sensor clock and reset configuration register.

Bit 11: the data sheet's bit-name row prints `mipi_hrst_req` (MIPI bus reset) for it, but the bit table lists [11] as reserved (RO); modelled as reserved, treat as a possible MIPI AHB reset. The sensor clock table is `000` 74.25, `001` 37.125, `010` 54, `011` 27, `1X0` 24, `1X1` 25 MHz (the vendor clock driver has no sensor clock entry).

Data sheet 3.2.7 PERI_CRG11 (offset 0x2C, printed page 3-18, `hi3518ev200-datasheet.txt` line 23145).";

        enum PERI_CRG11_sensor_srst_req_enum {
