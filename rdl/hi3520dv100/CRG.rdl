            V_2_MHZ_CLOCK = 0x1 { desc = "2 MHz clock"; };
        };

        field {
            name = "uart_cksel";
            desc = "UART clock select. 0 selects the APB clock, 1 the 2 MHz clock. This is exactly what the original Chinese data sheet prints (1: 2M clock, 0: APB clock) and what hardware and the vendor code show; only the machine-translated data sheet has it inverted. Reset 1 = 2 MHz matches the vendor U-Boot comment 'default is 2MHz'.";
