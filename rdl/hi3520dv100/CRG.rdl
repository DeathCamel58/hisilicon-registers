    reg {
        name = "USB related clock and soft reset control register";
        desc = "
        Clock gate and soft resets of the USB 2.0 host controllers (EHCI 0x100B0000, OHCI 0x100A0000) and their two-port PHY (DS 14.6.3, `datasheet.txt` lines 56621-56726). All reset bits are 1 (asserted) and the
        clock is on after power-on. Deassert order (DS): wait 10 us; clear `usbphy_port0_treq` / `usbphy_port1_treq`; clear `usbphy_req`; wait 250 us; clear `usb_ctrl_utmi0_req`, `usb_ctrl_utmi1_req`,
        `usb_ctrl_hub_req`; clear `usb_ahb_srst_req`. To reset a single port: set `usb_ctrl_utmiN_req`, set `usbphy_portN_treq`, wait 200 us, clear `usbphy_portN_treq`, clear `usb_ctrl_utmiN_req`.
        Vendor driver (`hiusb-hi3520d.c`, CRG + 0xB8): start = set `usb_cken` and clear the seven reset bits in one write, 100 us delay; stop = clear `usb_cken` and set the seven reset bits. The PHY
        and controller options are in SYS_CTRL PERIPHCTRL20 (burst, UTMI, port power, over-current polarity) and PERIPHCTRL21 / PERIPHCTRL22 (PHY0 / PHY1 tuning).
        ";

        enum PERI_CRG46_usb_cken_enum {
            DISABLE = 0x0 { desc = "disabled"; };
            ENABLE = 0x1 { desc = "enabled"; };
        };

        field {
            name = "usb_cken";
            encode = PERI_CRG46_usb_cken_enum;
            reset = 0x1;
        } usb_cken[7:7];

        enum PERI_CRG46_usb_ctrl_utmi1_req_enum {
            DEASSERT_RESET = 0x0 { desc = "deassert reset"; };
            RESET = 0x1 { desc = "reset"; };
        };

        field {
            name = "usb_ctrl_utmi1_req";
            encode = PERI_CRG46_usb_ctrl_utmi1_req_enum;
            reset = 0x1;
        } usb_ctrl_utmi1_req[6:6];

        enum PERI_CRG46_usb_ctrl_utmi0_req_enum {
            DEASSERT_RESET = 0x0 { desc = "deassert reset"; };
            RESET = 0x1 { desc = "reset"; };
        };

        field {
            name = "usb_ctrl_utmi0_req";
            encode = PERI_CRG46_usb_ctrl_utmi0_req_enum;
            reset = 0x1;
        } usb_ctrl_utmi0_req[5:5];

        enum PERI_CRG46_usb_ctrl_hub_req_enum {
            DEASSERT_RESET = 0x0 { desc = "deassert reset"; };
            RESET = 0x1 { desc = "reset"; };
        };

        field {
            name = "usb_ctrl_hub_req";
            encode = PERI_CRG46_usb_ctrl_hub_req_enum;
            reset = 0x1;
        } usb_ctrl_hub_req[4:4];

        enum PERI_CRG46_usbphy_port1_treq_enum {
            DEASSERT_RESET = 0x0 { desc = "deassert reset"; };
            RESET = 0x1 { desc = "reset"; };
        };

        field {
            name = "usbphy_port1_treq";
            encode = PERI_CRG46_usbphy_port1_treq_enum;
            reset = 0x1;
        } usbphy_port1_treq[3:3];

        enum PERI_CRG46_usbphy_port0_treq_enum {
            DEASSERT_RESET = 0x0 { desc = "deassert reset"; };
            RESET = 0x1 { desc = "reset"; };
        };

        field {
            name = "usbphy_port0_treq";
            encode = PERI_CRG46_usbphy_port0_treq_enum;
            reset = 0x1;
        } usbphy_port0_treq[2:2];

        enum PERI_CRG46_usbphy_req_enum {
            DEASSERT_RESET = 0x0 { desc = "deassert reset"; };
            RESET = 0x1 { desc = "reset"; };
        };

        field {
            name = "usbphy_req";
            encode = PERI_CRG46_usbphy_req_enum;
            reset = 0x1;
        } usbphy_req[1:1];

        enum PERI_CRG46_usb_ahb_srst_req_enum {
            DEASSERT_RESET = 0x0 { desc = "deassert reset"; };
            RESET = 0x1 { desc = "reset"; };
        };

        field {
            name = "usb_ahb_srst_req";
            encode = PERI_CRG46_usb_ahb_srst_req_enum;
            reset = 0x1;
        } usb_ahb_srst_req[0:0];

    } PERI_CRG46 @ 0x00B8;

    reg {
        name = "SFC related clock and soft reset control register";
        desc = "Hardware (Hi3520D V100 board, read on hardware 2026-11-08, stock U-Boot prompt after a cold boot): reads 0x0000000E (sfc_cksel = 3 = 112.5 MHz, sfc_cken = 1), data sheet reset 0x00000002. Boot value (the boot code selects the SFC clock to boot from SPI flash), not taken as the reset value.";

        enum PERI_CRG48_sfc_cksel_enum {
            V_24_MHZ_CLOCK = 0x0 { desc = "24 MHz clock"; };
            V_24_MHZ_CLOCK_2 = 0x2 { desc = "24 MHz clock"; };
            V_75_MHZ_CLOCK = 0x1 { desc = "75 MHz clock"; };
            V_112_5_MHZ_CLOCK = 0x3 { desc = "112.5 MHz clock"; };
        };

        field {
            name = "sfc_cksel";
            desc = "SFC2X clock source: x0 = 24 MHz, 01 = 75 MHz, 11 = 112.5 MHz (original Chinese data sheet, printed '112..5MHz'; the 11 row is missing from the machine translation). 75 MHz = EPLL FOUT1PH0 and 112.5 MHz = EPLL VCO / 12 at the EPLL reset settings.";
            encode = PERI_CRG48_sfc_cksel_enum;
            reset = 0x0;
        } sfc_cksel[3:2];

        enum PERI_CRG48_sfc_cken_enum {
            DISABLE = 0x0 { desc = "disabled"; };
            ENABLE = 0x1 { desc = "enabled"; };
        };

        field {
            name = "sfc_cken";
            encode = PERI_CRG48_sfc_cken_enum;
            reset = 0x1;
        } sfc_cken[1:1];

        enum PERI_CRG48_sfc_srst_req_enum {
            DEASSERT_RESET = 0x0 { desc = "deassert reset"; };
            RESET = 0x1 { desc = "reset"; };
        };

        field {
            name = "sfc_srst_req";
            encode = PERI_CRG48_sfc_srst_req_enum;
            reset = 0x0;
        } sfc_srst_req[0:0];

    } PERI_CRG48 @ 0x00C0;

    reg {
        name = "Clock and soft reset control registers related to ETH interface";

        enum reset_enum {
            CANCEL = 0x0 { desc = "Cancel reset"; };
