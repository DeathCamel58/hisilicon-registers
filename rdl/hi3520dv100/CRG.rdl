            DEASSERT_RESET = 0x0 { desc = "deassert reset"; };
            RESET = 0x1 { desc = "reset"; };
        };

        field {
            name = "rst_alive_s";
            encode = PERI_CRG45_rst_alive_s_enum;
            reset = 0x0;
        } rst_alive_s[7:7];

