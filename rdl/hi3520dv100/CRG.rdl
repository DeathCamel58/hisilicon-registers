`ifndef CRG_RDL
`define CRG_RDL

regfile eCRG {
    name = "CRG Registers";
    desc = "
    The clock management module manages clock input, clock generation, and clock control in a unified manner as follows:

    * Manages and controls clock inputs
    * Divides and controls clock frequencies
    * Generates working clocks for each module

    ![Block Diagram](assets/crg-block-diagram.png)
    ";

    reg {
        name = "APLL configuration register 0";

        enum PERI_CRG0_apll_bypass_enum {
            NO_BYPASS = 0x0 { desc = "No bypass."; };
            BYPASS    = 0x1 { desc = "Bypass."; };
        };

        field {
            name = "APLL clock divider bypass (bypass) control.";
            encode = PERI_CRG0_apll_bypass_enum;
            reset = 0x0;
        } apll_bypass[30:30];

        field {
            name = "Level-2 output frequency divider of the APLL";
            reset = 0x2;
        } apll_postdiv2[29:27];

        field {
            name = "Level-1 output frequency divider of the APLL";
            reset = 0x1;
        } apll_postdiv1[26:24];

        field {
            name = "Decimal part of the APLL frequency multiplication coefficient";
            reset = 0x0;
        } apll_frac[23:0];

    } PERI_CRG0 @ 0x0000;

    reg {
        name = "APLL configuration register 1";
        desc = "Hardware (Hi3520D V100 board, read on hardware 2026-11-08, stock U-Boot prompt after a cold boot): reads 0x007C30A5 (apll_fbdiv = 0xA5), reset here (data sheet) 0x007C309B (apll_fbdiv = 0x9B). Boot value: the BootROM / stock boot table reprograms the APLL before the prompt, so this is not taken as the reset value.";

        field {
            enum apll_dacpd_enum {
                down = 0x0 { desc = "power-down mode"; };
                normal = 0x1 { desc = "normal operating mode"; };
            };
            name = "APLL test signal control";
            encode = apll_dacpd_enum;
            reset = 0x0;
        } apll_dacpd[23:23];

        field {
            enum apll_dsmpd_enum {
                decimal = 0x0 { desc = "decimal frequency-division mode"; };
                integral = 0x1 { desc = "integral frequency-division mode"; };
            };
            name = "APLL decimal division control";
            encode = apll_dsmpd_enum;
            reset = 0x1;
        } apll_dsmpd[22:22];

        field {
            enum apll_pd_enum {
                down = 0x0 { desc = "power-down mode"; };
                normal = 0x1 { desc = "normal operating mode"; };
            };
            name = "APLL power-down control";
            encode = apll_pd_enum;

            reset = 0x1;
        } apll_pd[21:21];

        field {
            enum apll_foutvcopd_enum {
                no = 0x0 { desc = "no output clock"; };
                normal = 0x1 { desc = "normal output clock"; };
            };
            name = "APLL VCO output power-down control";
            encode = apll_foutvcopd_enum;
            reset = 0x1;
        } apll_foutvcopd [20:20];

        field {
            enum apll_postdivpd_enum {
                no = 0x0 { desc = "no output clock"; };
                normal = 0x1 { desc = "normal clock output"; };
            };

            name = "APLL FOUT output power-down control";
            encode = apll_postdivpd_enum;
            reset = 0x1;
        } apll_postdivpd[19:19];

        field {
            enum apll_fout4phasepd_enum {
                no = 0x0 { desc = "no output clock"; };
                normal = 0x1 { desc = "normal output clock"; };
            };
            name = "APLL FOUT output power-down control";
            encode = apll_fout4phasepd_enum;
            reset = 0x1;
        } apll_fout4phasepd[18:18];

        field {
            name = "Frequency divider of the APLL reference clock";
            reset = 0x3;
        } apll_refdiv[17:12];

        field {
            name = "Integral part of the APLL frequency multiplication coefficient";
            reset = 0x9B;
        } apll_fbdiv[11:0];

    } PERI_CRG1 @ 0x0004;

    reg {
        name = "VPLL0 Configuration Register 0";
        desc = "Hardware (Hi3520D V100 board, read on hardware 2026-11-08, stock U-Boot prompt after a cold boot): reads 0x22000000 (vpll0_postdiv2 = 4, postdiv1 = 2), data sheet reset 0x12000000 (postdiv2 = 2). Boot value (VPLL0 is programmed by the boot table), not taken as the reset value.";

        field {
            enum vpll0_bypass_enum {
                no = 0x0 { desc = "not bypassed"; };
                bypass = 0x1 { desc = "bypassed"; };
            };
            name = "VPLL0 clock frequency division bypass";
            encode = vpll0_bypass_enum;
            reset = 0x0;
        } vpll0_bypass[30:30];

        field {
            name = "Level-2 output divider of VPLL0";
            reset = 0x2;
        } vpll0_postdiv2[29:27];

        field {
            name = "Level-1 output divider of VPLL0";
            reset = 0x2;
        } vpll0_postdiv1[26:24];

        field {
                name = "Decimal part of the VPLL0 frequency multiplication coefficient";
            reset = 0x0;
        } vpll0_frac[23:0];

    } PERI_CRG2 @ 0x008;

    reg {
        name = "VPLL0 Configuration Register 1";

        field {
            enum vpll0_dacpd_enum {
                down = 0x0 { desc = "power-down mode"; };
                normal = 0x1 { desc = "normal operating mode"; };
            };
            name = "VPLL0 test signal control";
            encode = vpll0_dacpd_enum;
            reset = 0x0;
        } vpll0_dacpd[23:23];

        field {
            enum vpll0_dsmpd_encode {
                decimal = 0x0 { desc = "decimal frequency-division mode"; };
                integral = 0x1 { desc = "integral frequency-division mode"; };
            };
            name = "VPLL0 decimal division control";
            encode = vpll0_dsmpd_encode;
            reset = 0x1;
        } vpll0_dsmpd[22:22];

        field {
            enum vpll0_pd_enum {
                down = 0x0 { desc = "power-down mode"; };
                normal = 0x1 { desc = "normal operating mode"; };
            };
            name = "VPLL0 power-down control";
            encode = vpll0_pd_enum;
            reset = 0x1;
        } vpll0_pd[21:21];

        field {
            enum vpll0_foutvcopd_enum {
                no = 0x0 { desc = "no output clock"; };
                normal = 0x1 { desc = "normal output clock"; };
            };
            name = "VPLL0 VCO output power-down control";
            encode = vpll0_foutvcopd_enum;
            reset = 0x1;
        } vpll0_foutvcopd[20:20];

        field {
            enum vpll0_postdivpd_enum {
                no = 0x0 { desc = "no output clock"; };
                normal = 0x1 { desc = "normal clock output"; };
            };
            name = "VPLL0 POSTDIV output power-down control";
            encode = vpll0_postdivpd_enum;
            reset = 0x1;
        } vpll0_postdivpd[19:19];

        field {
            enum vpll0_fout4phasepd_enum {
                no = 0x0 { desc = "no output clock"; };
                normal = 0x1 { desc = "normal output clock"; };
            };
            name = "VPLL0 FOUT output power-down control";
            encode = vpll0_fout4phasepd_enum;
            reset = 0x1;
        } vpll0_fout4phasepd[18:18];

        field {
            name = "Frequency divider of the VPLL0 reference clock";
            reset = 0x2;
        } vpll0_refdiv[17:12];

        field {
            name = "Integral part of the VPLL0 frequency multiplication coefficient";
            reset = 0x63;
        } vpll0_fbdiv[11:0];

    } PERI_CRG3 @ 0x000C;

    reg {
        name = "EPLL Configuration Register 0";

        field {
            enum epll_bypass_enum {
                no = 0x0 { desc = "not bypassed"; };
                bypass = 0x1 { desc = "bypassed"; };
            };
            name = "EPLL clock frequency division bypass";
            encode = epll_bypass_enum;
            reset = 0x0;
        } epll_bypass[30:30];

        field {
            name = "Level-2 output divider of EPLL";
            reset = 0x3;
        } epll_postdiv2[29:27];

        field {
            name = "Level-1 output divider of EPLL";
            reset = 0x3;
        } epll_postdiv1[26:24];

        field {
            name = "Decimal part of the EPLL frequency multiplication coefficient";
            reset = 0x0;
        } epll_frac[23:0];

    } PERI_CRG8 @ 0x0020;

    reg {
        name = "EPLL Configuration Register 1";

        field {
            enum epll_dacpd_enum {
                down = 0x0 { desc = "power-down mode"; };
                normal = 0x1 { desc = "normal operating mode"; };
            };
            name = "EPLL test signal control";
            encode = epll_dacpd_enum;
            reset = 0x0;
        } epll_dacpd[23:23];

        field {
            enum epll_dsmpd_encode {
                decimal = 0x0 { desc = "decimal frequency-division mode"; };
                integral = 0x1 { desc = "integral frequency-division mode"; };
            };
            name = "EPLL decimal division control";
            encode = epll_dsmpd_encode;
            reset = 0x1;
        } epll_dsmpd[22:22];

        field {
            enum epll_pd_enum {
                down = 0x0 { desc = "power-down mode"; };
                normal = 0x1 { desc = "normal operating mode"; };
            };
            name = "EPLL power-down control";
            encode = epll_pd_enum;
            reset = 0x1;
        } epll_pd[21:21];

        field {
            enum epll_foutvcopd_enum {
                no = 0x0 { desc = "no output clock"; };
                normal = 0x1 { desc = "normal output clock"; };
            };
            name = "EPLL VCO output power-down control";
            encode = epll_foutvcopd_enum;
            reset = 0x1;
        } epll_foutvcopd[20:20];

        field {
            enum epll_postdivpd_enum {
                no = 0x0 { desc = "no output clock"; };
                normal = 0x1 { desc = "normal clock output"; };
            };
            name = "EPLL POSTDIV output power-down control";
            encode = epll_postdivpd_enum;
            reset = 0x1;
        } epll_postdivpd[19:19];

        field {
            enum epll_fout4phasepd_enum {
                no = 0x0 { desc = "no output clock"; };
                normal = 0x1 { desc = "normal output clock"; };
            };
            name = "EPLL FOUT output power-down control";
            encode = epll_fout4phasepd_enum;
            reset = 0x1;
        } epll_fout4phasepd[18:18];

        field {
            name = "Frequency divider of the EPLL reference clock";
            reset = 0x4;
        } epll_refdiv[17:12];

        field {
            name = "Integral part of the EPLL frequency multiplication coefficient";
            reset = 0xE1;
        } epll_fbdiv[11:0];

    } PERI_CRG9 @ 0x0024;

    reg {
        name = "A9 Frequency mode and reset configuration register";
        desc = "Data sheet: bit 4 reserved, reset value 0x20 (cpu_srst_req = 1). Hardware (Hi3520D V100, after boot): reads 0x10, i.e. reserved bit 4 reads 1 and cpu_srst_req [5] reads 0. Writes should preserve bit 4. Read again on 2026-11-08 after two cold boots: 0x00000010 (stock U-Boot prompt). The A9 is running, so cpu_srst_req = 0 is a boot value; the data sheet reset 0x20 is kept.";

        enum reset_enum {
            CANCEL = 0x0 { desc = "Cancel reset"; };
            RESET  = 0x1 { desc = "Reset"; };
        };

        field {
            name = "CS soft reset request.";
            encode = reset_enum;
            reset = 0x0;
        } cs_srst_req[11:11];

        field {
            name = "SCU soft reset request.";
            encode = reset_enum;
            reset = 0x0;
        } cluster_scu_srst_req[10:10];

        field {
            name = "PERI soft reset request.";
            encode = reset_enum;
            reset = 0x0;
        } cluster_peri_srst_req[9:9];

        field {
            name = "WDG soft reset request.";
            encode = reset_enum;
            reset = 0x0;
        } sc_wd_srst_req[7:7];

        field {
            name = "DBG soft reset request.";
            encode = reset_enum;
            reset = 0x0;
        } cluster_dbg_srst_req[6:6];

        field {
            name = "CPU soft reset request. (Documentation says something about 'only valid in the slave loading mode')";
            encode = reset_enum;
            reset = 0x1;
        } cpu_srst_req[5:5];

        enum freqmode_a9_sys_enum {
            A9_AXI_2_1_0 = 0x0 { desc = "A9:AXI = 2:1"; };
            A9_AXI_2_1_1 = 0x1 { desc = "A9:AXI = 2:1"; };
            A9_AXI_2_1_2 = 0x2 { desc = "A9:AXI = 2:1"; };
            A9_AXI_1_1 = 0x3 { desc = "A9:AXI = 1:1"; };
        };

        field {
            name = "A9 clock down-conversion configuration.";
            desc = "
                A9 frequency reduction can be realized through Mask A9 clock pulse, and the frequency ratio between it and AXI clock can be adjusted.
                11: A9:AXI = 1:1
                Others: A9:AXI = 2:1
            ";
            encode = freqmode_a9_sys_enum;
            reset = 0x0;
        } freqmode_a9_sys[3:2];

    } PERI_CRG10 @ 0x0028;

    reg {
        name = "VICAP Clock and Reset Configuration Register";

        enum PERI_CRG11_vich0_divsel_enum {
            DIV2 = 0x0 { desc = "div2"; };
            DIV4 = 0x1 { desc = "div4"; };
        };

        field {
            name = "vich0_divsel";
            encode = PERI_CRG11_vich0_divsel_enum;
            reset = 0x0;
        } vich0_divsel[31:30];

        enum PERI_CRG11_vich1_divsel_enum {
            DIV2 = 0x0 { desc = "div2"; };
            DIV4 = 0x1 { desc = "div4"; };
        };

        field {
            name = "vich1_divsel";
            encode = PERI_CRG11_vich1_divsel_enum;
            reset = 0x0;
        } vich1_divsel[29:28];

        enum PERI_CRG11_vich4_divsel_enum {
            DIV2 = 0x0 { desc = "div2"; };
            DIV4 = 0x1 { desc = "div4"; };
        };

        field {
            name = "vich4_divsel";
            encode = PERI_CRG11_vich4_divsel_enum;
            reset = 0x0;
        } vich4_divsel[27:26];

        enum PERI_CRG11_vich5_divsel_enum {
            DIV2 = 0x0 { desc = "div2"; };
            DIV4 = 0x1 { desc = "div4"; };
        };

        field {
            name = "vich5_divsel";
            encode = PERI_CRG11_vich5_divsel_enum;
            reset = 0x0;
        } vich5_divsel[25:24];

        enum PERI_CRG11_vi_selftest_enum {
            NORMAL_MODE = 0x0 { desc = "normal mode (I/O input clock)"; };
            SELF_TEST_MODE = 0x1 { desc = "self test mode (on-chip 24 MHz test clock)"; };
        };

        field {
            name = "vi_selftest";
            encode = PERI_CRG11_vi_selftest_enum;
            reset = 0x0;
        } vi_selftest[22:22];

        enum PERI_CRG11_vi1_sc_sel_enum {
            VI0_PAD_INPUT = 0x0 { desc = "VI0 pad input clock"; };
            VI1_PAD_INPUT = 0x1 { desc = "VI1 pad input clock"; };
        };

        field {
            name = "vi1_sc_sel";
            encode = PERI_CRG11_vi1_sc_sel_enum;
            reset = 0x1;
        } vi1_sc_sel[21:21];

        enum PERI_CRG11_vi0_sc_sel_enum {
            VI0_PAD_INPUT = 0x0 { desc = "VI0 pad input clock"; };
            VI1_PAD_INPUT = 0x1 { desc = "VI1 pad input clock"; };
        };

        field {
            name = "vi0_sc_sel";
            encode = PERI_CRG11_vi0_sc_sel_enum;
            reset = 0x0;
        } vi0_sc_sel[20:20];

        enum PERI_CRG11_vi_adc_cksel_enum {
            V_54_MHZ = 0x0 { desc = "54 MHz"; };
            V_27_MHZ = 0x1 { desc = "27 MHz"; };
            V_24_MHZ = 0x2 { desc = "24 MHz"; };
            V_24_MHZ_3 = 0x3 { desc = "24 MHz"; };
        };

        field {
            name = "vi_adc_cksel";
            encode = PERI_CRG11_vi_adc_cksel_enum;
            reset = 0x0;
        } vi_adc_cksel[19:18];

        enum PERI_CRG11_vi_cken_ch_enum {
            DISABLE = 0x0 { desc = "disabled"; };
            ENABLE = 0x1 { desc = "enabled"; };
        };

        field {
            name = "vi_cken_ch";
            desc = "Other values: bits: bit15 = VI channel 7 ... bit8 = VI channel 0";
            encode = PERI_CRG11_vi_cken_ch_enum;
            reset = 0x0;
        } vi_cken_ch[15:8];

        enum PERI_CRG11_vi0_rst_req_enum {
            DEASSERT_RESET = 0x0 { desc = "deassert reset"; };
            RESET = 0x1 { desc = "reset"; };
        };

        field {
            name = "vi0_rst_req";
            encode = PERI_CRG11_vi0_rst_req_enum;
            reset = 0x0;
        } vi0_rst_req[7:7];

        enum PERI_CRG11_vi1_rst_req_enum {
            DEASSERT_RESET = 0x0 { desc = "deassert reset"; };
            RESET = 0x1 { desc = "reset"; };
        };

        field {
            name = "vi1_rst_req";
            encode = PERI_CRG11_vi1_rst_req_enum;
            reset = 0x0;
        } vi1_rst_req[6:6];

        enum PERI_CRG11_vi0_pctrl_enum {
            NORMAL_PHASE_CLOCK = 0x0 { desc = "normal phase clock"; };
            REVERSE_PHASE_CLOCK = 0x1 { desc = "reverse phase clock"; };
        };

        field {
            name = "vi0_pctrl";
            encode = PERI_CRG11_vi0_pctrl_enum;
            reset = 0x0;
        } vi0_pctrl[3:3];

        enum PERI_CRG11_vi1_pctrl_enum {
            NORMAL_PHASE_CLOCK = 0x0 { desc = "normal phase clock"; };
            REVERSE_PHASE_CLOCK = 0x1 { desc = "reverse phase clock"; };
        };

        field {
            name = "vi1_pctrl";
            encode = PERI_CRG11_vi1_pctrl_enum;
            reset = 0x0;
        } vi1_pctrl[2:2];

        enum PERI_CRG11_vi_hcken_enum {
            DISABLE = 0x0 { desc = "disabled"; };
            ENABLE = 0x1 { desc = "enabled"; };
        };

        field {
            name = "vi_hcken";
            encode = PERI_CRG11_vi_hcken_enum;
            reset = 0x0;
        } vi_hcken[1:1];

        enum PERI_CRG11_vi_hrst_req_enum {
            DEASSERT_RESET = 0x0 { desc = "deassert reset"; };
            RESET = 0x1 { desc = "reset"; };
        };

        field {
            name = "vi_hrst_req";
            encode = PERI_CRG11_vi_hrst_req_enum;
            reset = 0x0;
        } vi_hrst_req[0:0];

    } PERI_CRG11 @ 0x002C;

    reg {
        name = "VOU Clock and Reset Control Register";
        desc = "Hardware (Hi3520D V100 board, read on hardware 2026-11-08, stock U-Boot prompt after a cold boot): reads 0x00000037: the data-sheet resets (all clocks off, the three vo_*_srst_req bits asserted) plus reserved bits 5:4 reading 1. Not modelled (reserved).";

        enum PERI_CRG13_vou_sd1_cken_enum {
            DISABLE = 0x0 { desc = "disabled"; };
            ENABLE = 0x1 { desc = "enabled"; };
        };

        field {
            name = "vou_sd1_cken";
            encode = PERI_CRG13_vou_sd1_cken_enum;
            reset = 0x0;
        } vou_sd1_cken[11:11];

        enum PERI_CRG13_vou_sd0_cken_enum {
            DISABLE = 0x0 { desc = "disabled"; };
            ENABLE = 0x1 { desc = "enabled"; };
        };

        field {
            name = "vou_sd0_cken";
            encode = PERI_CRG13_vou_sd0_cken_enum;
            reset = 0x0;
        } vou_sd0_cken[10:10];

        enum PERI_CRG13_vou_hd_cken_enum {
            DISABLE = 0x0 { desc = "disabled"; };
            ENABLE = 0x1 { desc = "enabled"; };
        };

        field {
            name = "vou_hd_cken";
            encode = PERI_CRG13_vou_hd_cken_enum;
            reset = 0x0;
        } vou_hd_cken[9:9];

        enum PERI_CRG13_vou_hcken_enum {
            DISABLE = 0x0 { desc = "disabled"; };
            ENABLE = 0x1 { desc = "enabled"; };
        };

        field {
            name = "vou_hcken";
            encode = PERI_CRG13_vou_hcken_enum;
            reset = 0x0;
        } vou_hcken[8:8];

        enum PERI_CRG13_sddac_cken_enum {
            DISABLE = 0x0 { desc = "disabled"; };
            ENABLE = 0x1 { desc = "enabled"; };
        };

        field {
            name = "sddac_cken";
            encode = PERI_CRG13_sddac_cken_enum;
            reset = 0x0;
        } sddac_cken[7:7];

        enum PERI_CRG13_hddac_cken_enum {
            DISABLE = 0x0 { desc = "disabled"; };
            ENABLE = 0x1 { desc = "enabled"; };
        };

        field {
            name = "hddac_cken";
            encode = PERI_CRG13_hddac_cken_enum;
            reset = 0x0;
        } hddac_cken[6:6];

        enum PERI_CRG13_vo_sd_srst_req_enum {
            DEASSERT_RESET = 0x0 { desc = "deassert reset"; };
            RESET = 0x1 { desc = "reset"; };
        };

        field {
            name = "vo_sd_srst_req";
            encode = PERI_CRG13_vo_sd_srst_req_enum;
            reset = 0x1;
        } vo_sd_srst_req[2:2];

        enum PERI_CRG13_vo_hd_srst_req_enum {
            DEASSERT_RESET = 0x0 { desc = "deassert reset"; };
            RESET = 0x1 { desc = "reset"; };
        };

        field {
            name = "vo_hd_srst_req";
            encode = PERI_CRG13_vo_hd_srst_req_enum;
            reset = 0x1;
        } vo_hd_srst_req[1:1];

        enum PERI_CRG13_vo_hrst_req_enum {
            DEASSERT_RESET = 0x0 { desc = "deassert reset"; };
            RESET = 0x1 { desc = "reset"; };
        };

        field {
            name = "vo_hrst_req";
            encode = PERI_CRG13_vo_hrst_req_enum;
            reset = 0x1;
        } vo_hrst_req[0:0];

    } PERI_CRG13 @ 0x0034;

    reg {
        name = "PWM Clock and Reset Control Register";

        enum PERI_CRG14_pwm_cksel_enum {
            V_3_MHZ = 0x0 { desc = "3 MHz"; };
            V_24_MHZ = 0x1 { desc = "24 MHz"; };
        };

        field {
            name = "pwm_cksel";
            encode = PERI_CRG14_pwm_cksel_enum;
            reset = 0x0;
        } pwm_cksel[2:2];

        enum PERI_CRG14_pwm_cken_enum {
            DISABLE = 0x0 { desc = "disabled"; };
            ENABLE = 0x1 { desc = "enabled"; };
        };

        field {
            name = "pwm_cken";
            encode = PERI_CRG14_pwm_cken_enum;
            reset = 0x0;
        } pwm_cken[1:1];

        enum PERI_CRG14_pwm_srst_req_enum {
            DEASSERT_RESET = 0x0 { desc = "deassert reset"; };
            RESET = 0x1 { desc = "reset"; };
        };

        field {
            name = "pwm_srst_req";
            encode = PERI_CRG14_pwm_srst_req_enum;
            reset = 0x0;
        } pwm_srst_req[0:0];

    } PERI_CRG14 @ 0x0038;

    reg {
        name = "HDMI Clock and Reset Control Register";

        enum PERI_CRG15_hdmi_cec_clk_sel_enum {
            XTAL_DIV12_CLOCK = 0x0 { desc = "XTAL div12 clock"; };
            V_2_04_MHZ = 0x1 { desc = "2.04 MHz clock generated by dividing the PLL clock"; };
        };

        field {
            name = "hdmi_cec_clk_sel";
            encode = PERI_CRG15_hdmi_cec_clk_sel_enum;
            reset = 0x0;
        } hdmi_cec_clk_sel[6:6];

        enum PERI_CRG15_hdmi_asclk_sel_enum {
