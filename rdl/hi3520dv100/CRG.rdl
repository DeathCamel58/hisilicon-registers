        desc = "Hardware (Hi3520D V100 board, read on hardware 2026-11-08, stock U-Boot prompt after a cold boot): reads 0x00000007 (all three PLLs locked). Status, not a reset value: the lock bits depend on the PLL state, so the reset stays 0.";

        enum lock_unlock_enum {
            unlocked = 0x0 { desc = "unlocked"; };
            locked = 0x1 { desc = "locked"; };
        };

        field {
            name = "EPLL lock status";
            encode = lock_unlock_enum;
            sw = r;
            hw = w;
            reset = 0x0;
        } epll_lock[2:2];

        field {
            name = "VPLL0 lock status";
            encode = lock_unlock_enum;
            sw = r;
            hw = w;
            reset = 0x0;
