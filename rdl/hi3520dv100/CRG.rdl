    reg {
        name = "VDH0 clock and soft reset control register (UNVERIFIED, vendor-derived, not in the data sheet)";
        desc = "UNVERIFIED, vendor-derived: this register is NOT in the data sheet (it lists PERI_CRG16, 18, 22, 24.. and skips 17, 19, 20, 21, 23). The Xiongmai/HiSilicon MPP vfmw module (hi3520D_vfmw.ko, VDM_OpenHardware) writes 0x20030050 with bit 1 set and bit 0 cleared (read-modify-write) before using the video decoder VDH0, and its board script carries the commented line `himm 0x20030050 0x2 #VDH`; ResetVdm sets bit 0, waits for VDH_STATE bit 20 to clear and clears bit 0 again. The bit meanings (bit 1 = clock enable, bit 0 = soft reset, 1 = reset) are inferred from that idiom and from the identical layout of every neighboring register; the reset value is unknown. Source: docs/rdl-campaign/vdh-scd.md. Second pass 2026-11-10: vendor module hi3520D_vfmw.ko, confidence MEDIUM, word-checked against the Hi3520D disassembly: yes. VDM_OpenHardware does reg = (reg | 2) & ~1 (read-modify-write); VDMHAL_V200R001_OpenHAL maps this register; ResetVdm: reg |= 1, poll VDH_STATE bit 20 until it reads 0 (10000 iterations), reg &= ~1, then restores INT_MASK. The neighbor registers PERI_CRG18/22/24-27 reset to clock enabled + reset asserted (0x3), so the VDH likely needs the reset released explicitly (inferred, confidence LOW). The VDH clock rate is not set by any vendor script. Not verified on hardware.";

        field {
            name = "vdh0_cken";
            desc = "Clock gating (1 = clock on); inferred, see register description.";
        } vdh0_cken[1:1];

        field {
            name = "vdh0_srst_req";
            desc = "Soft reset request (1 = reset); inferred, see register description.";
        } vdh0_srst_req[0:0];

    } PERI_CRG20 @ 0x0050;

    reg {
        name = "VDH1 clock and soft reset control register (UNVERIFIED, vendor-derived, not in the data sheet)";
        desc = "UNVERIFIED, vendor-derived: this register is NOT in the data sheet (it lists PERI_CRG16, 18, 22, 24.. and skips 17, 19, 20, 21, 23). The Xiongmai/HiSilicon MPP vfmw module (hi3520D_vfmw.ko, VDM_OpenHardware) writes 0x20030054 with bit 1 set and bit 0 cleared (read-modify-write) before using the video decoder VDH1, and its board script carries the commented line `himm 0x20030050 0x2 #VDH`; ResetVdm sets bit 0, waits for VDH_STATE bit 20 to clear and clears bit 0 again. The bit meanings (bit 1 = clock enable, bit 0 = soft reset, 1 = reset) are inferred from that idiom and from the identical layout of every neighboring register; the reset value is unknown. Source: docs/rdl-campaign/vdh-scd.md. Second pass 2026-11-10: vendor module hi3520D_vfmw.ko, confidence MEDIUM, word-checked against the Hi3520D disassembly: yes. VDM_OpenHardware does reg = (reg | 2) & ~1 (read-modify-write); VDMHAL_V200R001_OpenHAL maps this register; ResetVdm: reg |= 1, poll VDH_STATE bit 20 until it reads 0 (10000 iterations), reg &= ~1, then restores INT_MASK. The neighbor registers PERI_CRG18/22/24-27 reset to clock enabled + reset asserted (0x3), so the VDH likely needs the reset released explicitly (inferred, confidence LOW). The VDH clock rate is not set by any vendor script. Not verified on hardware.";

        field {
