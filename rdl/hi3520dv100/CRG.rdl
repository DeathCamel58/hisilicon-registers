    reg {
        name = "SCD related clock and soft reset control register";

        enum PERI_CRG53_scd_cken_enum {
            DISABLE = 0x0 { desc = "disabled"; };
            ENABLE = 0x1 { desc = "enabled"; };
        };

        field {
            name = "scd_cken";
            encode = PERI_CRG53_scd_cken_enum;
            reset = 0x0;
        } scd_cken[3:3];

        desc = "Data sheet: scd_cken [3], scd_srst_req [1], reset 0x0. Second pass 2026-11-10, vendor module hi3520D_vfmw.ko, confidence HIGH, word-checked against the Hi3520D disassembly: yes: SCD_OpenHardware does reg = (reg | 8) & ~2 (read-modify-write); ResetSCD sets bit 1, polls SCD_OVER (0x10150040) bit 1 until clear (10000 iterations), clears bit 1; the vendor board script writes 0x8 (`himm 0x200300d4 0x8`). DNR_OpenHardware additionally sets bit 8 and clears bits 1:0 (stub fields below, purpose unknown). Not verified on hardware.";
        enum PERI_CRG53_scd_srst_req_enum {
            DEASSERT_RESET = 0x0 { desc = "deassert reset"; };
            RESET = 0x1 { desc = "reset"; };
        };

        field {
            name = "scd_srst_req";
            encode = PERI_CRG53_scd_srst_req_enum;
            reset = 0x0;
        } scd_srst_req[1:1];

    } PERI_CRG53 @ 0x00D4;

    reg {
        name = "DDRTEST and EFUSE related clock and soft reset control register";
        desc = "Hardware (Hi3520D V100 board, read on hardware 2026-11-08, stock U-Boot prompt after a cold boot): reads 0x0000000A (ddrtest_cken = 1), data sheet reset 0x00000002. Boot value (the DDR boot table uses the DDR tester for training), not taken as the reset value.";

        enum PERI_CRG54_ddrtest_cken_enum {
            DISABLE = 0x0 { desc = "disabled"; };
            ENABLE = 0x1 { desc = "enabled"; };
        };

        field {
        field {
            name = "bit8_unk";
            desc = "Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware. Observed access: read-modify-write (set to 1) by vendor module hi3520D_vfmw.ko, DNR_OpenHardware; neighbors accessed together: bits 1:0 of the same register (cleared; bit 1 = scd_srst_req); the software path SM_CopyYuvToDnr/g_dnr_hal_fun_ptr, no register window known. Not in the data sheet; no reset value or meaning is claimed.";
            sw = rw;
            hw = r;
        } bit8_unk[8:8];

        field {
            name = "bit0_unk";
            desc = "Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware. Observed access: read-modify-write (cleared to 0) by vendor module hi3520D_vfmw.ko, DNR_OpenHardware; neighbors accessed together: bit 8 (set) and bit 1 (cleared). Not in the data sheet; no reset value or meaning is claimed.";
            sw = rw;
            hw = r;
        } bit0_unk[0:0];

            name = "ddrtest_cken";
            encode = PERI_CRG54_ddrtest_cken_enum;
            reset = 0x0;
        } ddrtest_cken[3:3];

        enum PERI_CRG54_ddrtest_srst_req_enum {
