`ifndef CRG_RDL
`define CRG_RDL

regfile eCRG {
    name = "CRG Registers";
    desc = "
    The clock management module manages clock input, clock generation, and clock control in a unified manner as follows:

    * Manages and controls clock inputs
    * Divides and controls clock frequencies
    * Generates working clocks for each module

    ![Block Diagram](assets/crg-block-diagram.png)
    ";

    reg {
        name = "APLL configuration register 0";
        desc = "APLL (PERI_CRG0/1): the A9 and DDR clock is APLL FOUTVCO / 2 (a fixed divide: 1320 / 2 = 660 MHz on the board), not FOUTPOSTDIV; the AXI/APB clocks are derived from it. Hence postdiv/bypass here do not change the CPU rate. PLL rules (original Chinese data sheet 3.2.3 Tables 3-2..3-4): reference XIN = 24 MHz fixed; FOUTVCO = 24 MHz * (fbdiv + frac/2^24) / refdiv, which must be within 600 MHz..1.6 GHz; FOUTPOSTDIV = VCO / (postdiv1*postdiv2); FOUT1PH0 = /(pd1*pd2*2); FOUT2 = /(pd1*pd2*4); FOUT3 = /(pd1*pd2*6); FOUT4 = /(pd1*pd2*8). The *_pd / *_dacpd / *_foutvcopd / *_postdivpd / *_fout4phasepd bits are enables (1 = running, 0 = power down) despite their names; dsmpd 1 = integer mode (frac ignored), 0 = fractional mode. Changing a PLL configuration is only allowed in SLOW mode (SC_CTRL modectrl); wait for the lock bit in PERI_CRG58 (bit 0 APLL, bit 1 VPLL0, bit 2 EPLL) before switching back to NORMAL. The data sheet gives 0.1 ms (clock chapter) and 0.5 ms (SC_PLLCTRL text) for the settling time; it disagrees with itself.";

        enum PERI_CRG0_apll_bypass_enum {
            NO_BYPASS = 0x0 { desc = "No bypass."; };
            BYPASS    = 0x1 { desc = "Bypass."; };
        };

        field {
            name = "APLL clock divider bypass (bypass) control.";
            encode = PERI_CRG0_apll_bypass_enum;
            reset = 0x0;
        } apll_bypass[30:30];

        field {
            name = "Level-2 output frequency divider of the APLL";
            reset = 0x2;
        } apll_postdiv2[29:27];

        field {
            name = "Level-1 output frequency divider of the APLL";
            reset = 0x1;
        } apll_postdiv1[26:24];

        field {
            name = "Decimal part of the APLL frequency multiplication coefficient";
            reset = 0x0;
        } apll_frac[23:0];

    } PERI_CRG0 @ 0x0000;

    reg {
        name = "APLL configuration register 1";
        desc = "Hardware (Hi3520D V100 board, read on hardware 2026-11-08, stock U-Boot prompt after a cold boot): reads 0x007C30A5 (apll_fbdiv = 0xA5), reset here (data sheet) 0x007C309B (apll_fbdiv = 0x9B). Boot value: the BootROM / stock boot table reprograms the APLL before the prompt, so this is not taken as the reset value. Data sheet reset values compute to VCO 1240 MHz (24/3*155); the data sheet text 'divide by two gives 660 MHz' is only correct for the boot value 1320 MHz (fbdiv 165).";

        field {
            enum apll_dacpd_enum {
                down = 0x0 { desc = "power-down mode"; };
                normal = 0x1 { desc = "normal operating mode"; };
            };
            name = "APLL test signal control";
            encode = apll_dacpd_enum;
            reset = 0x0;
        } apll_dacpd[23:23];

        field {
            enum apll_dsmpd_enum {
                decimal = 0x0 { desc = "decimal frequency-division mode"; };
                integral = 0x1 { desc = "integral frequency-division mode"; };
            };
            name = "APLL decimal division control";
            encode = apll_dsmpd_enum;
            reset = 0x1;
        } apll_dsmpd[22:22];

        field {
            enum apll_pd_enum {
                down = 0x0 { desc = "power-down mode"; };
                normal = 0x1 { desc = "normal operating mode"; };
            };
            name = "APLL power-down control";
            encode = apll_pd_enum;

            reset = 0x1;
        } apll_pd[21:21];

        field {
            enum apll_foutvcopd_enum {
                no = 0x0 { desc = "no output clock"; };
                normal = 0x1 { desc = "normal output clock"; };
            };
            name = "APLL VCO output power-down control";
            encode = apll_foutvcopd_enum;
            reset = 0x1;
        } apll_foutvcopd [20:20];

        field {
            enum apll_postdivpd_enum {
                no = 0x0 { desc = "no output clock"; };
                normal = 0x1 { desc = "normal clock output"; };
            };

            name = "APLL POSTDIV output power-down control";
            encode = apll_postdivpd_enum;
            reset = 0x1;
        } apll_postdivpd[19:19];

        field {
            enum apll_fout4phasepd_enum {
                no = 0x0 { desc = "no output clock"; };
                normal = 0x1 { desc = "normal output clock"; };
            };
            name = "APLL FOUT output power-down control";
            encode = apll_fout4phasepd_enum;
            reset = 0x1;
        } apll_fout4phasepd[18:18];

        field {
            name = "Frequency divider of the APLL reference clock";
            reset = 0x3;
        } apll_refdiv[17:12];

        field {
            name = "Integral part of the APLL frequency multiplication coefficient";
            reset = 0x9B;
        } apll_fbdiv[11:0];

    } PERI_CRG1 @ 0x0004;

    reg {
        name = "VPLL0 Configuration Register 0";
        desc = "Hardware (Hi3520D V100 board, read on hardware 2026-11-08, stock U-Boot prompt after a cold boot): reads 0x22000000 (vpll0_postdiv2 = 4, postdiv1 = 2), data sheet reset 0x12000000 (postdiv2 = 2). Boot value (VPLL0 is programmed by the boot table), not taken as the reset value. VPLL0 (PERI_CRG2/3): feeds the VDP (video output, HD) and HDMI pixel clock; FOUT1PH0 = 148.5 MHz with refdiv 2, fbdiv 99, postdiv 2x2 (VCO 1188 MHz, example in data sheet 3.2.3). PLL rules (original Chinese data sheet 3.2.3 Tables 3-2..3-4): reference XIN = 24 MHz fixed; FOUTVCO = 24 MHz * (fbdiv + frac/2^24) / refdiv, which must be within 600 MHz..1.6 GHz; FOUTPOSTDIV = VCO / (postdiv1*postdiv2); FOUT1PH0 = /(pd1*pd2*2); FOUT2 = /(pd1*pd2*4); FOUT3 = /(pd1*pd2*6); FOUT4 = /(pd1*pd2*8). The *_pd / *_dacpd / *_foutvcopd / *_postdivpd / *_fout4phasepd bits are enables (1 = running, 0 = power down) despite their names; dsmpd 1 = integer mode (frac ignored), 0 = fractional mode. Changing a PLL configuration is only allowed in SLOW mode (SC_CTRL modectrl); wait for the lock bit in PERI_CRG58 (bit 0 APLL, bit 1 VPLL0, bit 2 EPLL) before switching back to NORMAL. The data sheet gives 0.1 ms (clock chapter) and 0.5 ms (SC_PLLCTRL text) for the settling time; it disagrees with itself.";

        field {
            enum vpll0_bypass_enum {
                no = 0x0 { desc = "not bypassed"; };
                bypass = 0x1 { desc = "bypassed"; };
            };
            name = "VPLL0 clock frequency division bypass";
            encode = vpll0_bypass_enum;
            reset = 0x0;
        } vpll0_bypass[30:30];

        field {
            name = "Level-2 output divider of VPLL0";
            reset = 0x2;
        } vpll0_postdiv2[29:27];

        field {
            name = "Level-1 output divider of VPLL0";
            reset = 0x2;
        } vpll0_postdiv1[26:24];

        field {
                name = "Decimal part of the VPLL0 frequency multiplication coefficient";
            reset = 0x0;
        } vpll0_frac[23:0];

    } PERI_CRG2 @ 0x008;

    reg {
        name = "VPLL0 Configuration Register 1";
        desc = "Reset 0x007C2063: refdiv 2, fbdiv 99, integer mode, all enables set (VCO 1188 MHz). Lock status PERI_CRG58 bit 1.";

        field {
            enum vpll0_dacpd_enum {
                down = 0x0 { desc = "power-down mode"; };
                normal = 0x1 { desc = "normal operating mode"; };
            };
            name = "VPLL0 test signal control";
            encode = vpll0_dacpd_enum;
            reset = 0x0;
        } vpll0_dacpd[23:23];

        field {
            enum vpll0_dsmpd_encode {
                decimal = 0x0 { desc = "decimal frequency-division mode"; };
                integral = 0x1 { desc = "integral frequency-division mode"; };
            };
            name = "VPLL0 decimal division control";
            encode = vpll0_dsmpd_encode;
            reset = 0x1;
        } vpll0_dsmpd[22:22];

        field {
            enum vpll0_pd_enum {
                down = 0x0 { desc = "power-down mode"; };
                normal = 0x1 { desc = "normal operating mode"; };
            };
            name = "VPLL0 power-down control";
            encode = vpll0_pd_enum;
            reset = 0x1;
        } vpll0_pd[21:21];

        field {
            enum vpll0_foutvcopd_enum {
                no = 0x0 { desc = "no output clock"; };
                normal = 0x1 { desc = "normal output clock"; };
            };
            name = "VPLL0 VCO output power-down control";
            encode = vpll0_foutvcopd_enum;
            reset = 0x1;
        } vpll0_foutvcopd[20:20];

        field {
            enum vpll0_postdivpd_enum {
                no = 0x0 { desc = "no output clock"; };
                normal = 0x1 { desc = "normal clock output"; };
            };
            name = "VPLL0 POSTDIV output power-down control";
            encode = vpll0_postdivpd_enum;
            reset = 0x1;
        } vpll0_postdivpd[19:19];

        field {
            enum vpll0_fout4phasepd_enum {
                no = 0x0 { desc = "no output clock"; };
                normal = 0x1 { desc = "normal output clock"; };
            };
            name = "VPLL0 FOUT output power-down control";
            encode = vpll0_fout4phasepd_enum;
            reset = 0x1;
        } vpll0_fout4phasepd[18:18];

        field {
            name = "Frequency divider of the VPLL0 reference clock";
            reset = 0x2;
        } vpll0_refdiv[17:12];

        field {
            name = "Integral part of the VPLL0 frequency multiplication coefficient";
            reset = 0x63;
        } vpll0_fbdiv[11:0];

    } PERI_CRG3 @ 0x000C;

    reg {
        name = "EPLL Configuration Register 0";
        desc = "EPLL (PERI_CRG8/9), VCO 1350 MHz at reset (refdiv 4, fbdiv 225, postdiv 3x3): VCO/2 = 675 MHz AIO MCLK source; VCO/6 = 225 MHz VEDU/VPSS; VCO/7 = 193 MHz JPGE/VAPU; VCO/12 = 112.5 MHz SFC/MDU/JPGE/CIPHER (SFC also 75 MHz = FOUT1PH0); VDP SD source 54 MHz; FOUTPOSTDIV 150 MHz, /3 = 50 MHz SATA and ETH RMII reference; FOUT3 25 MHz = FE PHY input clock. PLL rules (original Chinese data sheet 3.2.3 Tables 3-2..3-4): reference XIN = 24 MHz fixed; FOUTVCO = 24 MHz * (fbdiv + frac/2^24) / refdiv, which must be within 600 MHz..1.6 GHz; FOUTPOSTDIV = VCO / (postdiv1*postdiv2); FOUT1PH0 = /(pd1*pd2*2); FOUT2 = /(pd1*pd2*4); FOUT3 = /(pd1*pd2*6); FOUT4 = /(pd1*pd2*8). The *_pd / *_dacpd / *_foutvcopd / *_postdivpd / *_fout4phasepd bits are enables (1 = running, 0 = power down) despite their names; dsmpd 1 = integer mode (frac ignored), 0 = fractional mode. Changing a PLL configuration is only allowed in SLOW mode (SC_CTRL modectrl); wait for the lock bit in PERI_CRG58 (bit 0 APLL, bit 1 VPLL0, bit 2 EPLL) before switching back to NORMAL. The data sheet gives 0.1 ms (clock chapter) and 0.5 ms (SC_PLLCTRL text) for the settling time; it disagrees with itself.";

        field {
            enum epll_bypass_enum {
                no = 0x0 { desc = "not bypassed"; };
                bypass = 0x1 { desc = "bypassed"; };
            };
            name = "EPLL clock frequency division bypass";
            encode = epll_bypass_enum;
            reset = 0x0;
        } epll_bypass[30:30];

        field {
            name = "Level-2 output divider of EPLL";
            reset = 0x3;
        } epll_postdiv2[29:27];

        field {
            name = "Level-1 output divider of EPLL";
            reset = 0x3;
        } epll_postdiv1[26:24];

        field {
            name = "Decimal part of the EPLL frequency multiplication coefficient";
            reset = 0x0;
        } epll_frac[23:0];

    } PERI_CRG8 @ 0x0020;

    reg {
        name = "EPLL Configuration Register 1";
        desc = "Reset 0x007C40E1: refdiv 4, fbdiv 225, integer mode, all enables set. Lock status PERI_CRG58 bit 2.";

        field {
            enum epll_dacpd_enum {
                down = 0x0 { desc = "power-down mode"; };
                normal = 0x1 { desc = "normal operating mode"; };
            };
            name = "EPLL test signal control";
            encode = epll_dacpd_enum;
            reset = 0x0;
        } epll_dacpd[23:23];

        field {
            enum epll_dsmpd_encode {
                decimal = 0x0 { desc = "decimal frequency-division mode"; };
                integral = 0x1 { desc = "integral frequency-division mode"; };
            };
            name = "EPLL decimal division control";
            encode = epll_dsmpd_encode;
            reset = 0x1;
        } epll_dsmpd[22:22];

        field {
            enum epll_pd_enum {
                down = 0x0 { desc = "power-down mode"; };
                normal = 0x1 { desc = "normal operating mode"; };
            };
            name = "EPLL power-down control";
            encode = epll_pd_enum;
            reset = 0x1;
        } epll_pd[21:21];

        field {
            enum epll_foutvcopd_enum {
                no = 0x0 { desc = "no output clock"; };
                normal = 0x1 { desc = "normal output clock"; };
            };
            name = "EPLL VCO output power-down control";
            encode = epll_foutvcopd_enum;
            reset = 0x1;
        } epll_foutvcopd[20:20];

        field {
            enum epll_postdivpd_enum {
                no = 0x0 { desc = "no output clock"; };
                normal = 0x1 { desc = "normal clock output"; };
            };
            name = "EPLL POSTDIV output power-down control";
            encode = epll_postdivpd_enum;
            reset = 0x1;
        } epll_postdivpd[19:19];

        field {
            enum epll_fout4phasepd_enum {
                no = 0x0 { desc = "no output clock"; };
                normal = 0x1 { desc = "normal output clock"; };
            };
            name = "EPLL FOUT output power-down control";
            encode = epll_fout4phasepd_enum;
            reset = 0x1;
        } epll_fout4phasepd[18:18];

        field {
            name = "Frequency divider of the EPLL reference clock";
            reset = 0x4;
        } epll_refdiv[17:12];

        field {
            name = "Integral part of the EPLL frequency multiplication coefficient";
            reset = 0xE1;
        } epll_fbdiv[11:0];

    } PERI_CRG9 @ 0x0024;

    reg {
        name = "A9 Frequency mode and reset configuration register";
        desc = "Original (Chinese) data sheet, version 02: total reset value 0x0000_0010 with bit 4 'RO reserved' (it reads 1) and cpu_srst_req [5] = 0; the machine translation printed 0x20, which is wrong. Hardware (Hi3520D V100 board, stock U-Boot prompt, 2026-11-08, two cold boots): reads 0x00000010, as the original says. Writes should preserve bit 4.";

        enum reset_enum {
            CANCEL = 0x0 { desc = "Cancel reset"; };
            RESET  = 0x1 { desc = "Reset"; };
        };

        field {
            name = "CS soft reset request.";
            encode = reset_enum;
            reset = 0x0;
        } cs_srst_req[11:11];

        field {
            name = "SCU soft reset request.";
            encode = reset_enum;
            reset = 0x0;
        } cluster_scu_srst_req[10:10];

        field {
            name = "PERI soft reset request.";
            encode = reset_enum;
            reset = 0x0;
        } cluster_peri_srst_req[9:9];

        field {
            name = "WDG soft reset request.";
            encode = reset_enum;
            reset = 0x0;
        } sc_wd_srst_req[7:7];

        field {
            name = "DBG soft reset request.";
            encode = reset_enum;
            reset = 0x0;
        } cluster_dbg_srst_req[6:6];

        field {
            name = "CPU soft reset request. (Documentation says something about 'only valid in the slave loading mode')";
            encode = reset_enum;
            reset = 0x0;
        } cpu_srst_req[5:5];

        field {
            name = "reserved_nz";
            desc = "Reserved; the original data sheet lists it as RO and its total reset value 0x10 (and the hardware) show that it reads 1.";
            sw = r;
            hw = w;
            reset = 0x1;
        } reserved_nz[4:4];

        enum freqmode_a9_sys_enum {
            A9_AXI_2_1_0 = 0x0 { desc = "A9:AXI = 2:1"; };
            A9_AXI_2_1_1 = 0x1 { desc = "A9:AXI = 2:1"; };
            A9_AXI_2_1_2 = 0x2 { desc = "A9:AXI = 2:1"; };
            A9_AXI_1_1 = 0x3 { desc = "A9:AXI = 1:1"; };
        };

        field {
            name = "A9 clock down-conversion configuration.";
            desc = "
                A9 frequency reduction can be realized through Mask A9 clock pulse, and the frequency ratio between it and AXI clock can be adjusted.
                11: A9:AXI = 1:1
                Others: A9:AXI = 2:1
                The vendor Linux get_bus_clk() (arch/arm/mach-hi3520d/core.c) tests this field the same way: AXI = VCO / 2 when bits [3:2] = 11, else VCO / 4.
            ";
            encode = freqmode_a9_sys_enum;
            reset = 0x0;
        } freqmode_a9_sys[3:2];

    } PERI_CRG10 @ 0x0028;

    reg {
        name = "VICAP Clock and Reset Configuration Register";

        enum PERI_CRG11_vich0_divsel_enum {
            DIV2 = 0x0 { desc = "div2"; };
            DIV4 = 0x1 { desc = "div4"; };
            DIV1 = 0x2 { desc = "div1 (original data sheet: 10 = div1, 11 = reserved)"; };
        };

        field {
            name = "vich0_divsel";
            desc = "Source: vendor module hi3520D_sys.ko (Hi3520D_MPP_V2.0.5.1, OpenIPC Hi3520D rootfs) function SYS_HAL_SelViDevClkDiv: for VI device 0 the vendor writes the same 2-bit code to [31:30] (vich0) and [29:28] (vich1), confidence HIGH; code 2 = div1 is used for a single-multiplexed BT.656 input, 0 = div2 for 2-way multiplexing, 1 = div4 for 4-way (VIU_DRV_SetDevClk). Board script crgctrl_8D1_hi3520D.sh writes 0x5524ff02 (all four fields = 1 = div4). Linux driver leaves the reset value 0 (div2). Not verified on hardware.";
            encode = PERI_CRG11_vich0_divsel_enum;
            reset = 0x0;
        } vich0_divsel[31:30];

        enum PERI_CRG11_vich1_divsel_enum {
            DIV2 = 0x0 { desc = "div2"; };
            DIV4 = 0x1 { desc = "div4"; };
        };

        field {
            name = "vich1_divsel";
            desc = "Source: vendor module hi3520D_sys.ko (Hi3520D_MPP_V2.0.5.1, OpenIPC Hi3520D rootfs) function SYS_HAL_SelViDevClkDiv: for VI device 0 the vendor writes the same 2-bit code to [31:30] (vich0) and [29:28] (vich1), confidence HIGH; code 2 = div1 is used for a single-multiplexed BT.656 input, 0 = div2 for 2-way multiplexing, 1 = div4 for 4-way (VIU_DRV_SetDevClk). Board script crgctrl_8D1_hi3520D.sh writes 0x5524ff02 (all four fields = 1 = div4). Linux driver leaves the reset value 0 (div2). Not verified on hardware.";
            encode = PERI_CRG11_vich1_divsel_enum;
            reset = 0x0;
        } vich1_divsel[29:28];

        enum PERI_CRG11_vich4_divsel_enum {
            DIV2 = 0x0 { desc = "div2"; };
            DIV4 = 0x1 { desc = "div4"; };
            DIV1 = 0x2 { desc = "div1 (original data sheet: 10 = div1, 11 = reserved)"; };
        };

        field {
            name = "vich4_divsel";
            desc = "Source: vendor module hi3520D_sys.ko (Hi3520D_MPP_V2.0.5.1, OpenIPC Hi3520D rootfs) function SYS_HAL_SelViDevClkDiv: for VI device 1 the vendor writes the same 2-bit code to [27:26] (vich4) and [25:24] (vich5); same code meaning as vich0/1, confidence HIGH. Not verified on hardware.";
            encode = PERI_CRG11_vich4_divsel_enum;
            reset = 0x0;
        } vich4_divsel[27:26];

        enum PERI_CRG11_vich5_divsel_enum {
            DIV2 = 0x0 { desc = "div2"; };
            DIV4 = 0x1 { desc = "div4"; };
        };

        field {
            name = "vich5_divsel";
            desc = "Source: vendor module hi3520D_sys.ko (Hi3520D_MPP_V2.0.5.1, OpenIPC Hi3520D rootfs) function SYS_HAL_SelViDevClkDiv: for VI device 1 the vendor writes the same 2-bit code to [27:26] (vich4) and [25:24] (vich5); same code meaning as vich0/1, confidence HIGH. Not verified on hardware.";
            encode = PERI_CRG11_vich5_divsel_enum;
            reset = 0x0;
        } vich5_divsel[25:24];

        enum PERI_CRG11_vi_selftest_enum {
            NORMAL_MODE = 0x0 { desc = "normal mode (I/O input clock)"; };
            SELF_TEST_MODE = 0x1 { desc = "self test mode (on-chip 24 MHz test clock)"; };
        };

        field {
            name = "vi_selftest";
            desc = "Source: data sheet for the meaning. The vendor module hi3520D_sys.ko has no function that writes this bit and the board scripts (crgctrl_*_hi3520D.sh) never set it (confidence HIGH: no vendor code path uses the self-test clock). What the self-test clock feeds (pixel clock of the color bar generator?) is UNKNOWN. Not verified on hardware; board 2026-11-10: setting it did not make PT_TEST_CFG.cbar_en produce frames.";
            encode = PERI_CRG11_vi_selftest_enum;
            reset = 0x0;
        } vi_selftest[22:22];

        enum PERI_CRG11_vi1_sc_sel_enum {
            VI0_PAD_INPUT = 0x0 { desc = "VI0 pad input clock"; };
            VI1_PAD_INPUT = 0x1 { desc = "VI1 pad input clock"; };
        };

        field {
            name = "vi1_sc_sel";
            desc = "Source: vendor module hi3520D_sys.ko (Hi3520D_MPP_V2.0.5.1, OpenIPC Hi3520D rootfs) function SYS_HAL_SelViDevClk (dev 1 -> bit 21): the vendor sets this bit to 1 when the 8-bit data of the device sits on the byte mask 0x00FF0000 (the vendor device attribute au32CompMask[0] = 0xFF0000) and to 0 when it sits on 0xFF000000, i.e. it follows the data lane / pad clock of the device (error text of the module: 'Invalid input clock edge', but the effect is the pad clock choice shown in the enum). Confidence MEDIUM. Not verified on hardware.";
            encode = PERI_CRG11_vi1_sc_sel_enum;
            reset = 0x1;
        } vi1_sc_sel[21:21];

        enum PERI_CRG11_vi0_sc_sel_enum {
            VI0_PAD_INPUT = 0x0 { desc = "VI0 pad input clock"; };
            VI1_PAD_INPUT = 0x1 { desc = "VI1 pad input clock"; };
        };

        field {
            name = "vi0_sc_sel";
            desc = "Source: vendor module hi3520D_sys.ko (Hi3520D_MPP_V2.0.5.1, OpenIPC Hi3520D rootfs) function SYS_HAL_SelViDevClk (dev 0 -> bit 20): same rule as vi1_sc_sel (1 when the data mask is 0x00FF0000, 0 when 0xFF000000). Confidence MEDIUM. Not verified on hardware.";
            encode = PERI_CRG11_vi0_sc_sel_enum;
            reset = 0x0;
        } vi0_sc_sel[20:20];

        enum PERI_CRG11_vi_adc_cksel_enum {
            V_54_MHZ = 0x0 { desc = "54 MHz"; };
            V_27_MHZ = 0x1 { desc = "27 MHz"; };
            V_24_MHZ = 0x2 { desc = "24 MHz"; };
            V_24_MHZ_3 = 0x3 { desc = "24 MHz"; };
        };

        field {
            name = "vi_adc_cksel";
            encode = PERI_CRG11_vi_adc_cksel_enum;
            reset = 0x0;
        } vi_adc_cksel[19:18];

        enum PERI_CRG11_vi_cken_ch_enum {
            DISABLE = 0x0 { desc = "disabled"; };
            ENABLE = 0x1 { desc = "enabled"; };
        };

        field {
            name = "vi_cken_ch";
