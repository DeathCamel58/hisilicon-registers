    reg {
        name = "VCMP related clock and soft reset control register";
        desc = "Vendor-module cross-check (vcmp.ko, 2026-11-10): the vendor VCMP module drives this register only through hi3520D_sys.ko (SYS_HAL_VcmpClkEn: read-modify-write of bit 1; SYS_HAL_VcmpResetSel: read-modify-write of bit 0), always in this order: init = clock enabled first, then reset released (value 0x2); exit = reset asserted first, then clock disabled. Both calls are made from VcmpHalInit/VcmpHalExit (first VcmpOpen / last VcmpClose, i.e. when hifb.ko loads or unloads). The board scripts (load3520D via clkcfg_hi3520D.sh, OpenIPC load_hisilicon) additionally write the whole register with 0x2 before any module is loaded. Source: vendor module hi3520D_sys.ko (SYS_HAL_VcmpClkEn, SYS_HAL_VcmpResetSel), confidence HIGH, word-checked: yes. Not verified on hardware. Details: docs/rdl-campaign/vcmp-vendor.md.";

        enum PERI_CRG29_vcmp_cken_enum {
            DISABLE = 0x0 { desc = "disabled"; };
            ENABLE = 0x1 { desc = "enabled"; };
        };

        field {
            name = "vcmp_cken";
        field {
            name = "bit3_unk";
            desc = "Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware. Observed access: read-modify-write (set to 1) by vendor module hi3520D_vfmw.ko, BPD_OpenHardware (called from OpenDrivers via the hardware-open table); neighbors accessed together: bit 2 of the same register (cleared) and the 4 KB BPD window 0x206D0000 mapped by OpenDrivers (data sheet: DDR test module, do not touch); inherited Hi3531-generation code, probably irrelevant on this chip. Not in the data sheet; no reset value or meaning is claimed.";
            sw = rw;
            hw = r;
        } bit3_unk[3:3];

        field {
            name = "bit2_unk";
            desc = "Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware. Observed access: read-modify-write (cleared to 0) by vendor module hi3520D_vfmw.ko, BPD_OpenHardware; neighbors accessed together: bit 3 (set). Not in the data sheet; no reset value or meaning is claimed.";
            sw = rw;
            hw = r;
        } bit2_unk[2:2];

            desc = "Source: vendor module hi3520D_sys.ko (SYS_HAL_VcmpClkEn), confidence HIGH, word-checked: yes: set before the reset is released (init) and cleared after the reset is asserted (exit). Not verified on hardware.";
            encode = PERI_CRG29_vcmp_cken_enum;
            reset = 0x0;
        } vcmp_cken[1:1];

        enum PERI_CRG29_vcmp_srst_req_enum {
            DEASSERT_RESET = 0x0 { desc = "deassert reset"; };
            RESET = 0x1 { desc = "reset"; };
        };

        field {
            name = "vcmp_srst_req";
            desc = "Source: vendor module hi3520D_sys.ko (SYS_HAL_VcmpResetSel), confidence HIGH, word-checked: yes: written 0 (released) after the clock is enabled (init) and 1 (asserted) before the clock is disabled (exit). Not verified on hardware.";
            encode = PERI_CRG29_vcmp_srst_req_enum;
            reset = 0x0;
        } vcmp_srst_req[0:0];

    } PERI_CRG29 @ 0x0074;

    reg {
        name = "CIPHER related clock and soft reset control register";
        desc = "
            Hardware verified 2026-11-09, Hi3520D, linux driver hi3520d-cipher.c: the register reads 0 at power up and after U-Boot (clock gated, not in reset). Writing 0x2 enables the clock and releases the reset. After asserting the reset (0x3), bit 0 reads 1 again once the reset is released: the driver asserts the reset, waits 10-20 us, deasserts it and polls bit 0 until it reads 1 (RST_STATUS). There is no clock select, so the CIPHER rate is fixed.
        ";

        enum PERI_CRG31_cipher_cken_enum {
            DISABLE = 0x0 { desc = "disabled"; };
            ENABLE = 0x1 { desc = "enabled"; };
        };

        field {
            name = "cipher_cken";
            encode = PERI_CRG31_cipher_cken_enum;
            reset = 0x0;
        } cipher_cken[1:1];

        enum PERI_CRG31_cipher_srst_req_enum {
            DEASSERT_RESET = 0x0 { desc = "deassert reset"; };
            RESET = 0x1 { desc = "reset"; };
        };

        field {
            name = "cipher_srst_req";
            encode = PERI_CRG31_cipher_srst_req_enum;
            reset = 0x0;
        } cipher_srst_req[0:0];

    } PERI_CRG31 @ 0x007C;

