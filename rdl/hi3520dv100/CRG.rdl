            encode = PERI_CRG61_osc_mode_enum;
            reset = 0x0;
        } osc_mode[1:1];

        enum PERI_CRG61_osc_clk_en_enum {
            DISABLE = 0x0 { desc = "disabled"; };
            ENABLE = 0x1 { desc = "enabled"; };
        };

        field {
            name = "osc_clk_en";
            encode = PERI_CRG61_osc_clk_en_enum;
            reset = 0x0;
        } osc_clk_en[0:0];

    } PERI_CRG61 @ 0x00F4;

    reg {
        name = "SpeedMonitor Status Register 1";

        enum PERI_CRG62_osc_valid_enum {
            INVALID = 0x0 { desc = "invalid"; };
            VALID = 0x1 { desc = "valid"; };
        };

        field {
