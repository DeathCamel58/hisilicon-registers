// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3515cv100-clktree" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3520D V100 / Hi3515A / Hi3515C: clock tree</B><BR/><FONT POINT-SIZE="11">data sheet 3.2.3 (Tables 3-2 to 3-14); PLL formula FOUTVCO = 24 MHz x (fbdiv + frac / 2^24) / refdiv, 600 MHz to 1.6 GHz</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  xin [label="XIN\n24 MHz crystal", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  viclk [label="VIU0_CLK / VIU1_CLK\nvideo input clock pads", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  apll [label="APLL\nPERI_CRG0 / PERI_CRG1\nFOUTVCO 1240 MHz (default)", fillcolor="#e6a0a0"  ];
  vpll [label="VPLL0\nPERI_CRG2 / PERI_CRG3\nFOUT1PH0 148.5 MHz (configured)", fillcolor="#e6a0a0"  ];
  epll [label="EPLL\nPERI_CRG8 / PERI_CRG9\nFOUTVCO 1350 MHz; FOUTPOSTDIV 150 MHz; FOUT3 25 MHz", fillcolor="#e6a0a0"  ];
  cpu [label="A9 and DDR clock 660 MHz (APLL VCO / 2)\nA9:AXI 2:1, or 1:1 when PERI_CRG10[3:2] = 11\n(L2 660 MHz, AXI 330 MHz)", fillcolor="#e0b86f"  ];
  bus [label="AXI, APB and other bus clocks\n(divided from the DDR clock)", fillcolor="#8fb3de"  ];
  vdphd [label="VDP HD and HDMI\n148.5 MHz", fillcolor="#a6c98f"  ];
  vdpsd [label="VDP SD\n54 MHz", fillcolor="#a6c98f"  ];
  aio [label="SIO / AIO MCLK source 675 MHz (VCO / 2)\nfractional dividers PERI_CRG32..34 (MCLK max 62.5 MHz)", fillcolor="#a6c98f"  ];
  vedu [label="VEDU, VPSS\n225 MHz (VCO / 6)", fillcolor="#a6c98f"  ];
  jpge [label="JPGE, VAPU\n193 MHz (VCO / 7)", fillcolor="#a6c98f"  ];
  sfc [label="SFC, MDU, JPGE, CIPHER source 112.5 MHz (VCO / 12)\nSFC select PERI_CRG48[3:2]: 24 / 75 / 112.5 MHz", fillcolor="#8fb3de"  ];
  sata [label="SATA and ETH RMII reference 50 MHz (150 MHz / 3)\nSATA PHY reference PERI_CRG45[11]: 150 or 50 MHz", fillcolor="#8fb3de"  ];
  fephy [label="FE PHY input clock\n25 MHz", fillcolor="#8fb3de"  ];
  vi [label="VICAP channel clocks\nPERI_CRG11: vichN_divsel (div1/2/4), vi0_sc_sel / vi1_sc_sel (pad select),\nvi_selftest (24 MHz), vi_adc_cksel (54 / 27 / 24 MHz to the video ADC)", fillcolor="#a6c98f"  ];
  pwm [label="PWM\n3 or 24 MHz (PERI_CRG14[2])", fillcolor="#7fcdc4"  ];
  xin -> apll;
  xin -> vpll;
  xin -> epll;
  xin -> cpu [label="default after reset (crystal mode)"];
  apll -> cpu;
  cpu -> bus;
  vpll -> vdphd;
  epll -> vdpsd;
  epll -> aio;
  epll -> vedu;
  epll -> jpge;
  epll -> sfc;
  epll -> sata;
  epll -> fephy;
  viclk -> vi;
  xin -> pwm;
  xin -> sfc [label="24 MHz option"];
}
