// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3520dv100-clocks" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3520D V100: clock tree</B><BR/><FONT POINT-SIZE="11">redrawn from the data sheet CRG block diagram; register names from the CRG description</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  xin [label="XIN crystal", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  viclk [label="VIUn_CLK\n(external video input clocks)", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  pll [label="PLLs\nAPLL: PERI_CRG0 / PERI_CRG1\nVPLL0: PERI_CRG2 / PERI_CRG3\nEPLL: PERI_CRG8 / PERI_CRG9", fillcolor="#e6a0a0"  ];
  a9f [label="A9 clock frequency control\nPERI_CRG10 (A9 frequency mode, soft resets)", fillcolor="#d6d27a"  ];
  ipf [label="IP clock frequency control\n(dividers and selects in the block registers,\nfor example PERI_CRG11 vichN_divsel)", fillcolor="#d6d27a"  ];
  gate [label="Clock gating and soft reset\nPERI_CRG11 ... PERI_CRG62", fillcolor="#9aa7e6"  ];
  a9 [label="a9_clk", fillcolor="#e0b86f"  ];
  axi [label="axi_clk and bus clocks", fillcolor="#8fb3de"  ];
  ip [label="IP clocks (XXIP_clk):\nVICAP, VOU, HDMI, VEDU, VPSS, TDE, JPGE/JPGD,\nCIPHER, AIO, SATA, ETH, USB ...", fillcolor="#a6c98f"  ];
  xin -> pll;
  xin -> ipf [label="direct"];
  pll -> a9f;
  pll -> ipf;
  viclk -> ipf;
  a9f -> gate;
  ipf -> gate;
  gate -> a9;
  gate -> axi;
  gate -> ip;
}
