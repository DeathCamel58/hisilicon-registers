// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3520dv100-video" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3520D V100: video data path</B><BR/><FONT POINT-SIZE="11">block names from the data sheet chapter 1; the arrows are the usual NVR data path (inferred, not tabulated in the data sheet); DDR sits between the stages</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  vi [label="Video input\nBT.656 x2 / BT.1120\n(VICAP)", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  vpss [label="VPSS\ndeinterlace, scale, 3DNR,\nOSD / cover", fillcolor="#a6c98f"  ];
  ive [label="IVE\nmotion detection,\nperimeter, diagnosis", fillcolor="#a6c98f"  ];
  enc [label="H.264 / MJPEG / JPEG\nencoder", fillcolor="#a6c98f"  ];
  dec [label="H.264 / MJPEG / JPEG\ndecoder", fillcolor="#a6c98f"  ];
  tde [label="TDE\ngraphics 2D", fillcolor="#a6c98f"  ];
  vdp [label="VDP\nvideo, graphics and cursor layers,\nalpha blending", fillcolor="#a6c98f"  ];
  hdmi [label="HDMI / VGA / CVBS", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  sata [label="SATA / USB / ETH\n(recording, network)", fillcolor="#8fb3de"  ];
  vi -> vpss;
  vpss -> ive;
  vpss -> enc;
  enc -> sata [label="streams"];
  sata -> dec [label="streams"];
  dec -> vpss;
  vpss -> vdp;
  tde -> vdp [label="graphics"];
  vdp -> hdmi;
}
