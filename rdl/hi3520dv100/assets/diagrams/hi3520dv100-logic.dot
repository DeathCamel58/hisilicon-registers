// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3520dv100-logic" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3520D V100: logic block diagram</B><BR/><FONT POINT-SIZE="11">redrawn from the data sheet (chapter 1); bus topology as in the vendor figure, details in the register pages</FONT>>, fontcolor="#808080", rankdir=LR, compound=true, newrank=true];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  bus [label="AMBA 3.0 bus", fillcolor="#9a9a9a"  shape=box, height=5.2, width=0.5, fontcolor="white"];
  subgraph cluster_cpu { label="CPU subsystem"; fontcolor="#808080"; color="#808080"; style="rounded";
  cpu [label="Cortex-A9 up to 660 MHz\n32 KB I + 32 KB D L1, 128 KB L2", fillcolor="#e0b86f"  ];
  }
  ddrc [label="DDRC", fillcolor="#8fb3de"  ];
  ddrext [label="16-bit DDR2/DDR3\nup to 660 MHz", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  ddrext -> ddrc [dir=both]; ddrc -> cpu [dir=both]; ddrc -> bus [dir=both, style=dashed];
  subgraph cluster_l0 { label="High-speed peripherals"; fontcolor="#808080"; color="#808080"; style="rounded";
    sata [label="SATA 2.5 x2", fillcolor="#8fb3de"  ];
    sfc [label="SFC (SPI NOR\ninterface)", fillcolor="#8fb3de"  ];
    eth [label="ETH MAC +\ninternal FE PHY", fillcolor="#8fb3de"  ];
    usb [label="USB 2.0 host x2\n(EHCI + OHCI)", fillcolor="#8fb3de"  ];
    aio [label="AIO (I2S x2)", fillcolor="#8fb3de"  ];
  }
  sata -> bus [dir=both];
  sfc -> bus [dir=both];
  eth -> bus [dir=both];
  usb -> bus [dir=both];
  aio -> bus [dir=both];
  subgraph cluster_l1 { label="Security"; fontcolor="#808080"; color="#808080"; style="rounded";
    cipher [label="CIPHER\nAES / DES / 3DES", fillcolor="#c9a0dc"  ];
  }
  cipher -> bus [dir=both];
  subgraph cluster_r0 { label="Image subsystem"; fontcolor="#808080"; color="#808080"; style="rounded";
    vi [label="BT.656 x2 / BT.1120 x1\n(VICAP)", fillcolor="#a6c98f"  ];
    ive [label="IVE (intelligent\nvideo analysis)", fillcolor="#a6c98f"  ];
    vpss [label="VPSS", fillcolor="#a6c98f"  ];
    tde [label="TDE", fillcolor="#a6c98f"  ];
    vo [label="VDP: HDMI 1.3 / VGA /\n2 x CVBS output", fillcolor="#a6c98f"  ];
  }
  bus -> vi [dir=both];
  bus -> ive [dir=both];
  bus -> vpss [dir=both];
  bus -> tde [dir=both];
  bus -> vo [dir=both];
  subgraph cluster_r1 { label="Video codec"; fontcolor="#808080"; color="#808080"; style="rounded";
    codec [label="H.264 / MJPEG / JPEG\ncodec", fillcolor="#a6c98f"  ];
  }
  bus -> codec [dir=both];
  subgraph cluster_r2 { label="Low-speed peripherals (APB)"; fontcolor="#808080"; color="#808080"; style="rounded";
    lsp [label="UART x4, SPI, I2C, IR, GPIO,\nPWM, timers, WDG, RTC,\nSYS_CTRL, CRG, IO config", fillcolor="#7fcdc4"  ];
    rom [label="BOOTROM 4 KB, SRAM 10 KB", fillcolor="#7fcdc4"  ];
  }
  bus -> lsp [dir=both];
  bus -> rom [dir=both];
  hdd [label="SATA hard disks", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  hdd -> sata [dir=both, style=dashed];
  nor [label="SPI NOR flash", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  nor -> sfc [dir=both, style=dashed];
  phy [label="RJ45 transformer", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  phy -> eth [dir=both, style=dashed];
  usbp [label="2 USB ports", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  usbp -> usb [dir=both, style=dashed];
  bus -> cpu [dir=both];
}
