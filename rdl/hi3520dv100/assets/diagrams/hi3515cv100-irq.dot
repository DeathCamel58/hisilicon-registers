  g0 [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#606060" BGCOLOR="#d6d27a"><TR><TD COLSPAN="2" BGCOLOR="#404858"><FONT COLOR="white"><B>Timers, watchdog, RTC</B></FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">34</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">WDG</FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">35</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">Timer0</FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">36</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">Timer1</FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">37</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">TIMER2</FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">38</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">TIMER3</FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">39</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">RTC</FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">89</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">TEM_CAP_INT (RTC temperature sensor)</FONT></TD></TR></TABLE>>];
  g1 [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#606060" BGCOLOR="#8fb3de"><TR><TD COLSPAN="2" BGCOLOR="#404858"><FONT COLOR="white"><B>Serial, I/O, GPIO</B></FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">79-87</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">GPIO0-GPIO8</FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">40-43</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">UART0-UART3</FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">44</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">SPI</FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">45</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">I2C</FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">46</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">IR</FONT></TD></TR></TABLE>>];
  g2 [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#606060" BGCOLOR="#a6c98f"><TR><TD COLSPAN="2" BGCOLOR="#404858"><FONT COLOR="white"><B>Storage, network, USB, DMA</B></FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">52</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">SATA</FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">53</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">USB EHCI</FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">54</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">USB OHCI</FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">55</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">CIPHER</FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">56</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">ETH</FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">57</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">FE PHY</FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">50</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">SFC</FONT></TD></TR></TABLE>>];
  g3 [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#606060" BGCOLOR="#c9a0dc"><TR><TD COLSPAN="4" BGCOLOR="#404858"><FONT COLOR="white"><B>Video and graphics</B></FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">72</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">VEDU</FONT></TD><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">65</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">VOIE</FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">73</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">JPGE</FONT></TD><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">66</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">HDMI</FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">74</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">JPGD</FONT></TD><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">67</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">VDP</FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">76</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">MD</FONT></TD><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">68-71</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">VICAP, VPSS, TDE, VCMP</FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">77</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">IVE</FONT></TD><TD></TD><TD></TD></TR></TABLE>>];
  g4 [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#606060" BGCOLOR="#e6a0a0"><TR><TD COLSPAN="2" BGCOLOR="#404858"><FONT COLOR="white"><B>Audio</B></FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">47</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">AIO</FONT></TD></TR></TABLE>>];
  g5 [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#606060" BGCOLOR="#7fcdc4"><TR><TD COLSPAN="2" BGCOLOR="#404858"><FONT COLOR="white"><B>CPU debug and internal</B></FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">32</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">COMMTX[0]</FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">33</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">COMMRX[0]</FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">60</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">Software interrupt</FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">61</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">L2CACHE_CHK0_INT</FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">62</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">L2CACHE_CHK1_INT</FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">63</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">L2CACHE_INT_COMB</FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">64</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">A9_PMU_INT0</FONT></TD></TR></TABLE>>];
  ctl [label="GIC\nCortex-A9 GIC\n(ID = 32 + SPI number)", shape=box, style="filled", fillcolor="#e0b86f", fontsize=12];
  cpu [label="CPU interrupt inputs\n(IRQ / FIQ)", fillcolor="#e0b86f"];
