digraph "hi3515cv100-irq" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.12, ranksep=0.7, rankdir=LR,
         label=<<B>Hi3520D V100 / Hi3515A / Hi3515C: interrupt topology</B><BR/><FONT POINT-SIZE="11">generated from the interrupt table of this description; interrupt controller: Cortex-A9 GIC (ID = 32 + SPI number); reserved IDs omitted</FONT>>, fontcolor="#808080"];
