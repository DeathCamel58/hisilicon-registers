// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3515cv100-bus" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3520D V100: bus clock domains</B><BR/><FONT POINT-SIZE="11">bus clock domains from the data sheet clock chapter; the data sheet has no master/slave bus matrix or QoS table (INFERRED: the role named in each domain label)</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  a9 [label="Cortex-A9 + L2 (128 KB)\n660 MHz max", fillcolor="#e0b86f"  ];
  axi [label="AXI system bus\n330 MHz\nA9:AXI = 2:1 (or 1:1 with PERI_CRG10[3:2] = 11)", fillcolor="#9a9a9a"  ];
  ddrc [label="DDRC\nDDR clock 660 MHz", fillcolor="#8fb3de"  ];
  ahb [label="AHB / peripheral buses\n(divided from the DDR clock)", fillcolor="#8fb3de"  ];
  media [label="media blocks: VICAP, VPSS, VEDU, JPGE/JPGD, VDP, TDE, IVE, VOIE, AIO, MD, VDH", fillcolor="#a6c98f"  ];
  io [label="SATA, ETH, USB, SFC, CIPHER", fillcolor="#8fb3de"  ];
  apb [label="APB: timers, UART, SPI, I2C, GPIO, SYS_CTRL, CRG, IO config", fillcolor="#7fcdc4"  ];
  a9 -> axi [label="L2 / AXI ratio"];
  axi -> ddrc;
  axi -> media;
  axi -> io;
  axi -> ahb;
  ahb -> apb;
}
