`define SYS_CTRL_SYSID_REGWIDTH8

// Number of SATA ports: 2 on Hi3520D/Hi3515A, 1 on Hi3515C (the Hi3515C addrmap defines HI3515C before including this file)
`ifdef HI3515C
`define HISI_SATA_NPORTS 1
`else
`define HISI_SATA_NPORTS 2
`endif

