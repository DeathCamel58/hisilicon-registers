addrmap hi3518av100 {
    name = "hi3518av100 registers";
    desc = "
        ## Datasheets

        * [Full Datasheet](assets/Hi3518-Datasheet.pdf)
        * [User Guide](assets/Hi3518-UserGuide.pdf)

        ## Diagrams

        ![Logic Block Diagram](assets/Hi3518AV100-Logic-Block-Diagram.png)
    ";

    eHISI_NANDC         NANDC           @ 0x10000000;
    eHISI_SFC_350       SFC             @ 0x10010000;
    eHISI_DWMMC         SDIO            @ 0x10020000;
    eHISI_FEMAC         ETH             @ 0x10090000;
    eHISI_USB_OHCI      OHCI            @ 0x100A0000;
    eHISI_USB_EHCI      EHCI            @ 0x100B0000;
    eHISI_CIPHER_MC     CIPHER          @ 0x100C0000;
    eHISI_DMAC          DMAC            @ 0x100D0000;
    eARM_PL190          VIC             @ 0x10140000;
    eHISI_TIMER_SP804   TIMER0          @ 0x20000000;
    eHISI_TIMER_SP804   TIMER1          @ 0x20000020;
    eHISI_TIMER_SP804   TIMER2          @ 0x20010000;
    eHISI_TIMER_SP804   TIMER3          @ 0x20010020;
    eCRG                CRG             @ 0x20030000;
    eHISI_WDG_SP805     WDG             @ 0x20040000;
    eSYS_CTRL           SYS_CTRL        @ 0x20050000;
    eHISI_RTC_SPI       RTC             @ 0x20060000;
    eHISI_IR            IR              @ 0x20070000;
    eARM_PL011          UART0           @ 0x20080000;
    eARM_PL011          UART1           @ 0x20090000;
    eARM_PL011          UART2           @ 0x200A0000;
    eHISI_SAR_ADC       SAR_ADC         @ 0x200B0000;
    eHISI_SPI           SPI0            @ 0x200C0000;
    eHISI_I2C           I2C             @ 0x200D0000;
    eHISI_SPI           SPI1            @ 0x200E0000;
    eIO_CONFIG_HI3518A  IO_CONFIG       @ 0x200F0000;
    eDDRC               DDRC            @ 0x20110000;
    eDDRC_PUB_PHY       DDR_PHY         @ 0x20120000;
    eHISI_PWM_GRP       PWM             @ 0x20130000;
    eARM_PL061          GPIO0           @ 0x20140000;
    eARM_PL061          GPIO1           @ 0x20150000;
    eARM_PL061          GPIO2           @ 0x20160000;
    eARM_PL061          GPIO3           @ 0x20170000;
    eARM_PL061          GPIO4           @ 0x20180000;
    eARM_PL061          GPIO5           @ 0x20190000;
    eARM_PL061          GPIO6           @ 0x201A0000;
    eARM_PL061          GPIO7           @ 0x201B0000;
    eARM_PL061          GPIO8           @ 0x201C0000;
    eARM_PL061          GPIO9           @ 0x201D0000;
    eARM_PL061          GPIO10          @ 0x201E0000;
    eARM_PL061          GPIO11          @ 0x201F0000;
    eHISI_IVE           IVE             @ 0x205E0000;
    aHISI_VPSS          VPSS            @ 0x20600000;
    eHISI_TDE_G0          TDE             @ 0x20610000;
    aHISI_VEDU          VEDU            @ 0x20620000;
    eHISI_JPGE          JPGE            @ 0x20660000;
    eMOTION_DETECT      MOTION_DETECT   @ 0x206C0000;
    eHISI_DDRT          DDRT            @ 0x206D0000;
};
