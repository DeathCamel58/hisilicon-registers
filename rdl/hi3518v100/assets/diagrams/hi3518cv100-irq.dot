// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3518cv100-irq" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3518C V100: interrupt routing</B><BR/><FONT POINT-SIZE="11">interrupt numbers from the data sheet table (overview/hi3518v100.irq.tsv); grouping by function is ours</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  cpu [label="CPU IRQ", fillcolor="#e0b86f"  ];
  ic [label="PL190 VIC (32 sources)", fillcolor="#d6d27a"   shape=diamond];
  g0 [label="System\n0: Global software interrupt\n10: Temper_Cap", fillcolor="#8fb3de"  ];
  g1 [label="Timers, watchdog, RTC\n1: WDT interrupt when periphctrl0 bit[31] is 0\n2: RTC interrupt when periphctrl0 bit[31] is 0\n3: Timer0/Timer1\n4: Timer2/Timer3", fillcolor="#8fb3de"  ];
  g2 [label="Serial and I/O\n5: UART0/UART1\n6: SSP0\n7: SSP1\n9: SIO\n19: IR/SAR_ADC\n20: I2C\n25: UART2\n29: GPIO0/GPIO1/GPIO2/GPIO11\n30: GPIO3/GPIO4/GPIO5/GPIO10\n31: GPIO6/GPIO7/GPIO8/GPIO9", fillcolor="#8fb3de"  ];
  g3 [label="Storage\n8: NANDC\n11: SFC\n18: SDIO", fillcolor="#8fb3de"  ];
  g4 [label="Network, USB, PCIe, DMA\n12: ETH\n13: CIPHER\n14: DMAC\n15: USB_EHCI\n16: USB_OHCI", fillcolor="#8fb3de"  ];
  g5 [label="Media\n17: VPSS\n21: IVE\n22: VICAP\n23: VOU\n24: VEDU\n26: JPGE\n27: TDE\n28: MDU/DDRT", fillcolor="#a6c98f"  ];
  ic -> cpu;
  g0 -> ic;
  g1 -> ic;
  g2 -> ic;
  g3 -> ic;
  g4 -> ic;
  g5 -> ic;
}
