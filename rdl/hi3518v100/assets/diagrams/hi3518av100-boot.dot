// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3518av100-boot" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3518A V100: boot flow</B><BR/><FONT POINT-SIZE="11">data sheet 1.3; NAND boot exists only on the Hi3518A</FONT>>, fontcolor="#808080", rankdir=TB];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  por [label="Power-on reset", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  sel [label="BOOT_SEL (MDCK) ?", fillcolor="#d6d27a"   shape=diamond];
  spi [label="SPI NOR flash (SFC)\nstorage space 0x58000000", fillcolor="#8fb3de"  ];
  nand [label="NAND flash (NANDC)\nNF_BOOT_PIN0..4 select the NAND type", fillcolor="#8fb3de"  ];
  run [label="Boot space remapped to address 0;\nboot code clears the remap (SC_CTRL),\naddress 0 then shows TCM", fillcolor="#a6c98f"  ];
  por -> sel;
  sel -> spi [label="0"];
  spi -> run;
  sel -> nand [label="1"];
  nand -> run;
}
