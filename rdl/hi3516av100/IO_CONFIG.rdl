            V_2_MA = 2 { name = "V 2 Ma"; desc = "2 mA"; };
            V_1_MA = 3 { name = "V 1 Ma"; desc = "1 mA"; };
        };

        field {
            name = "vi_dat0_ds";
            desc = "Drive current of the VI_DAT0 pin";
            sw = rw;
            hw = r;
            encode = PADCTRL_REG135_vi_dat0_ds_enum;
            reset = 0x2;
        } vi_dat0_ds[5:4];
    } PADCTRL_REG135 @ 0xA1C;

};

`endif
