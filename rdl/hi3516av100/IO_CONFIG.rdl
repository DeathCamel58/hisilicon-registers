`ifndef HI3516AV100_IO_CONFIG_RDL
`define HI3516AV100_IO_CONFIG_RDL

regfile eIO_CONFIG {
    name = "IO configuration (pin multiplexing and pad control), Hi3516A/Hi3516D V100";
    desc = "
    0x200F0000..0x200F07FF: `muxctrl_regN` pin multiplexing control registers (123 registers, one per pin; the field value selects the pin function, 0 is the reset default; bits [31:n] are reserved, read 0 - the data sheet bit tables spell them `reseved`).
    0x200F0800..: `PADCTRL_REGn` pin drive capability (pad control) registers (136 registers: slew rate `_sr` and drive strength `_ds` per pin; PADCTRL_REG100/101 for the SAR ADC pins also carry Schmitt/pull-up/pull-down bits). The pad registers reset to non-zero values (slow edge, mid drive) as given per register.
    Source: Hi3516A/Hi3516D data sheet issue 08 (2016-10-28), English edition (no Chinese original is available in the tree, so a few ambiguous descriptions are flagged low confidence): 2.3 Pin Multiplexing Control Registers (Table 2-37, `hi3516av100--Hi3516A-Hi3516D-Datasheet.txt` lines 4671-8858) and 2.6 Pin Drive Capability Registers (Table 2-80, lines 10138-16170). Memory map Table 1-1: 'IO MUX register' 0x200F0000, 2 KB.
    Vendor cross-check: the vendor U-Boot `arch/arm/cpu/hi3516a/lowlevel_init_svb.c` writes 2 to MUX_CTRL_REG83/84 (0x200F014C/0x150: PWM0/PWM1 pins -> PMC_I2C_SCL/SDA) and the OpenIPC `load3516a` script writes 1 (SPI0) or 2 (I2C0) to 0x200F0050..0x5C (muxctrl_reg20-23, SPI0_SCLK/SDO/SDI/CSN pins); both agree with the encodings below.
    Hi3516D: same register set (one data sheet covers both parts; the Hi3516D has fewer bonded pins, see 2.1).
    ";

    reg {
        name = "Multiplexing control register for the SENSOR_CLK pin";
        desc = "muxctrl_reg0 is a multiplexing control register for the SENSOR_CLK pin.

Data sheet 2.3.2 muxctrl_reg0 (offset 0x0, printed page 2-70, `hi3516av100--Hi3516A-Hi3516D-Datasheet.txt` line 5007).";

        enum muxctrl_reg0_muxctrl_reg0_enum {
            GPIO0_5 = 0 { name = "Gpio0 5"; desc = "GPIO0_5"; };
            SENSOR_CLK = 1 { name = "Sensor Clk"; desc = "SENSOR_CLK"; };
        };

        field {
            name = "muxctrl_reg0";
            desc = "Multiplexing control for the SENSOR_CLK pin";
            sw = rw;
            hw = r;
            encode = muxctrl_reg0_muxctrl_reg0_enum;
            reset = 0x0;
        } muxctrl_reg0[0:0];
    } muxctrl_reg0 @ 0x0;

