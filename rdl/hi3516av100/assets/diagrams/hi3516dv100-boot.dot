// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3516dv100-boot" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3516D V100 (same flow as the Hi3516A V100): boot flow</B><BR/><FONT POINT-SIZE="11">data sheet 1.3; BOOTROM_SEL = VO_DAT1, BOOT_SEL = VO_DAT0, SFC_DEVICE_MODE = VO_DAT3, SFC_BOOT_MODE = SFC_CLK (straps latched at reset)</FONT>>, fontcolor="#808080", rankdir=TB];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  por [label="Power-on reset", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  b1 [label="BOOTROM_SEL ?", fillcolor="#d6d27a"   shape=diamond];
  rom [label="BOOTROM\nserial download (Fastboot)", fillcolor="#e0b86f"  ];
  to [label="serial link timed out ->\nBOOT_SEL ?", fillcolor="#d6d27a"   shape=diamond];
  spi [label="SPI flash on the SFC\nSFC_DEVICE_MODE: NOR (3/4-byte) or\nSPI NAND (1/4-wire)", fillcolor="#8fb3de"  ];
  nand [label="NAND flash on the NANDC", fillcolor="#8fb3de"  ];
  run [label="boot code runs; remap cleared\n(0x0 = on-chip RAM)", fillcolor="#a6c98f"  ];
  por -> b1;
  b1 -> rom [label="1"];
  b1 -> spi [label="0 and BOOT_SEL = 0"];
  b1 -> nand [label="0 and BOOT_SEL = 1"];
  rom -> to;
  rom -> run [label="download done"];
  to -> spi [label="0"];
  to -> nand [label="1"];
  spi -> run;
  nand -> run;
}
