// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3516dv100-crgmap" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>hi3516dv100: CRG register map overview</B><BR/><FONT POINT-SIZE="11">generated from the compiled RDL CRG block (36 registers at 0x20030000); registers grouped by the keywords of their names (keyword grouping, not a data sheet figure)</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  crg [label="CRG  0x20030000\n36 registers", fillcolor="#9aa7e6"  ];
  g0 [label="PLL configuration\n11 registers, 0x000-0x118\nPERI_CRG0, PERI_CRG1, PERI_CRG2, PERI_CRG3, PERI_CRG4, PERI_CRG5, PERI_CRG8, ...", fillcolor="#e6a0a0"  ];
  crg -> g0;
  g1 [label="Clock frequency / source select\n3 registers, 0x028-0x104\nPERI_CRG10, PERI_CRG12, PERI_CRG65", fillcolor="#d6d27a"  ];
  crg -> g1;
  g2 [label="Module clock gate and soft reset\n19 registers, 0x02C-0x0E4\nPERI_CRG11, PERI_CRG13, PERI_CRG14, PERI_CRG16, PERI_CRG18, PERI_CRG22, PERI_CRG23, ...", fillcolor="#9aa7e6"  ];
  crg -> g2;
  g3 [label="Status / monitor / other\n3 registers, 0x0E8-0x12C\nPERI_CRG58, PERI_CRG59, PERI_CRG75", fillcolor="#9a9a9a"  ];
  crg -> g3;
}
