// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3516dv100-irq" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>hi3516dv100: interrupt routing</B><BR/><FONT POINT-SIZE="11">every peripheral line goes to the ARM GIC-400; groups of the generated interrupt table (IDs from the data sheet table above; reserved lines omitted)</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  gic [label="ARM GIC-400\n(SPI interrupt IDs)", fillcolor="#d6d27a"  shape=box];
  cpu [label="Cortex-A7", fillcolor="#e0b86f"  ];
  gic -> cpu;
  c0 [label="Timers, watchdog, RTC\n4 lines: IDs 34, 35, 36, 39\nWatchdog, Timer01, Timer23, RTC", fillcolor="#8fb3de"  ];
  c0 -> gic;
  c1 [label="UART, I2C, SPI, GPIO, IR, ADC, PWM\n21 lines: IDs 40, 41, 42, 43, 44, 45, 46, 47, 48, 79, ...\nUART0, UART1, UART2, UART3, SSP0, SSP1, ...", fillcolor="#8fb3de"  ];
  c1 -> gic;
  c2 [label="DMA and memory\n1 lines: IDs 37\nDMAC", fillcolor="#8fb3de"  ];
  c2 -> gic;
  c3 [label="Storage\n5 lines: IDs 49, 50, 51, 52, 56\nSFC_NOR, NFC, SDIO0, SDIO1, SFC_NAND", fillcolor="#8fb3de"  ];
  c3 -> gic;
  c4 [label="Network, USB, PCIe\n4 lines: IDs 53, 54, 55, 57\nUSB_EHCI, USB_OHCI, USB_DEV, GSF", fillcolor="#8fb3de"  ];
  c4 -> gic;
  c5 [label="Security\n1 lines: IDs 58\nCipher", fillcolor="#8fb3de"  ];
  c5 -> gic;
  c6 [label="CPU debug and PMU\n3 lines: IDs 32, 33, 64\nCOMMTX[0], COMMRX[0], A7_PMU_INT0", fillcolor="#8fb3de"  ];
  c6 -> gic;
  c7 [label="Video input, ISP, processing, output\n9 lines: IDs 65, 66, 67, 68, 69, 70, 71, 76, 77\nVDP, MIPI, VICAP, VPSS, TDE, VGS, ...", fillcolor="#8fb3de"  ];
  c7 -> gic;
  c8 [label="Video codec\n3 lines: IDs 72, 73, 75\nAVC (264), JPGE, VEDU (265)", fillcolor="#8fb3de"  ];
  c8 -> gic;
  c9 [label="Other\n1 lines: IDs 60\nSoftware int", fillcolor="#8fb3de"  ];
  c9 -> gic;
}
