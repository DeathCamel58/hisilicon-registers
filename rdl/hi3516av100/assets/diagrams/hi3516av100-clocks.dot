// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3516av100-clocks" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3516A/D V100: clock tree</B><BR/><FONT POINT-SIZE="11">redrawn from data sheet Figures 3-2/3-3 and Tables 3-2..3-6; register names from the CRG chapter; fixed-PLL VCO to PLL name assignment not legible (INFERRED, not drawn)</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  xin [label="XIN 24 MHz crystal", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  rtc [label="RTC_XIN 32.768 kHz", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  rtcref [label="RTC reference clock", fillcolor="#7fcdc4"  ];
  apll [label="APLL PERI_CRG0/1\nprogrammable, up to 900 MHz", fillcolor="#e6a0a0"  ];
  fpll [label="BPLL 2/3 (off by default), VPLL 4/5, EPLL 8/9\nfixed: VCO 1188 and 1000 MHz\n594 / 297 / 148.5 / 99 / 74.25 / 500 / 250 / 125 MHz", fillcolor="#e6a0a0"  ];
  cpusel [label="cpu_sc_sel PERI_CRG12[8:7]\na7clk skip PERI_CRG10", fillcolor="#d6d27a"  ];
  ddrsel [label="ddr_sc_sel PERI_CRG12[5:4]", fillcolor="#d6d27a"  ];
  bussel [label="bus_sc_sel PERI_CRG12[3:0]\nmda_sc_sel PERI_CRG12", fillcolor="#d6d27a"  ];
  ipsel [label="module selects and skip dividers\n(VI/MIPI CRG11, VDP CRG13, VEDU/AVC CRG16, VPSS CRG18,\nTDE 22, VGS 23, JPGE 24, MDU 26, IVE 27)", fillcolor="#d6d27a"  ];
  ioclk [label="SFC CRG48, SDIO CRG49, NFC CRG52,\nUART CRG57, PWM CRG14, GMAC CRG51/59, AIO CRG35", fillcolor="#d6d27a"  ];
  gate [label="clock gate + soft reset bits\nin each PERI_CRGn", fillcolor="#9aa7e6"  ];
  a7 [label="A7 clock", fillcolor="#e0b86f"  ];
  ddr [label="DDRC clock", fillcolor="#8fb3de"  ];
  bus [label="sysaxi / mda0axi / mda1axi", fillcolor="#8fb3de"  ];
  ip [label="block clocks: VICAP, MIPI, VDP, VEDU,\nAVC, VPSS, TDE, VGS, JPGE, IVE, SFC ...", fillcolor="#a6c98f"  ];
  rtc -> rtcref;
  xin -> apll;
  xin -> fpll;
  xin -> cpusel [label="slow mode"];
  apll -> cpusel;
  fpll -> cpusel;
  fpll -> ddrsel;
  fpll -> bussel;
  fpll -> ipsel;
  fpll -> ioclk;
  cpusel -> a7;
  ddrsel -> ddr;
  bussel -> bus;
  ipsel -> gate;
  ioclk -> gate;
  gate -> ip;
}
