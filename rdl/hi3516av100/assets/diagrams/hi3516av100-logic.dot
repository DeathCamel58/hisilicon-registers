// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3516av100-logic" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3516A V100: logic block diagram</B><BR/><FONT POINT-SIZE="11">redrawn from the data sheet logic block diagram (chapter 1); bus as in the vendor figure (AMBA 3.0)</FONT>>, fontcolor="#808080", rankdir=LR, compound=true, newrank=true];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  bus [label="AMBA 3.0 bus", fillcolor="#9a9a9a"  shape=box, height=5.2, width=0.5, fontcolor="white"];
  subgraph cluster_cpu { label="CPU subsystem"; fontcolor="#808080"; color="#808080"; style="rounded";
  cpu [label="Cortex-A7 @ 600 MHz\n32 KB I + 32 KB D L1, 128 KB L2\nNEON + FPU, GIC", fillcolor="#e0b86f"  ];
  }
  ddrc [label="DDRC", fillcolor="#8fb3de"  ];
  ddrext [label="32-bit DDR3/3L\nup to 600 MHz", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  ddrext -> ddrc [dir=both]; ddrc -> cpu [dir=both]; ddrc -> bus [dir=both, style=dashed];
  subgraph cluster_l0 { label="Storage and network"; fontcolor="#808080"; color="#808080"; style="rounded";
    sfc [label="SFC (SPI NOR / SPI NAND)", fillcolor="#8fb3de"  ];
    nand [label="NANDC (8-bit NAND)", fillcolor="#8fb3de"  ];
    sdio [label="SDIO 3.0 x2", fillcolor="#8fb3de"  ];
    eth [label="GMAC (GSF)\nRGMII/RMII/MII, TSO", fillcolor="#8fb3de"  ];
    usb [label="USB 2.0\nhost (EHCI/OHCI) + device", fillcolor="#8fb3de"  ];
    aio [label="AIO (I2S) +\naudio codec", fillcolor="#8fb3de"  ];
  }
  sfc -> bus [dir=both];
  nand -> bus [dir=both];
  sdio -> bus [dir=both];
  eth -> bus [dir=both];
  usb -> bus [dir=both];
  aio -> bus [dir=both];
  subgraph cluster_l1 { label="Security"; fontcolor="#808080"; color="#808080"; style="rounded";
    cipher [label="CIPHER\nAES / DES / 3DES", fillcolor="#c9a0dc"  ];
  }
  cipher -> bus [dir=both];
  subgraph cluster_r0 { label="Image subsystem"; fontcolor="#808080"; color="#808080"; style="rounded";
    vi [label="VICAP: MIPI / LVDS / HiSPi,\nDC, BT.601/656/1120 + ISP", fillcolor="#a6c98f"  ];
    vpss [label="VPSS + VGS", fillcolor="#a6c98f"  ];
    tde [label="TDE + IVE + MD", fillcolor="#a6c98f"  ];
    vo [label="VDP: CVBS +\nBT.1120/656", fillcolor="#a6c98f"  ];
  }
  bus -> vi [dir=both];
  bus -> vpss [dir=both];
  bus -> tde [dir=both];
  bus -> vo [dir=both];
  subgraph cluster_r1 { label="Video codec"; fontcolor="#808080"; color="#808080"; style="rounded";
    vedu [label="VEDU (H.265)\nAVC (H.264)", fillcolor="#a6c98f"  ];
    jpge [label="JPGE (JPEG)", fillcolor="#a6c98f"  ];
  }
  bus -> vedu [dir=both];
  bus -> jpge [dir=both];
  subgraph cluster_r2 { label="Low-speed peripherals"; fontcolor="#808080"; color="#808080"; style="rounded";
    lsp [label="UART x4, SPI x4, I2C x3, GPIO, IR,\nPWM x8, SAR ADC, timers, WDG,\nRTC, DMAC, SYS_CTRL, CRG, IO config", fillcolor="#7fcdc4"  ];
    rom [label="BOOTROM 64 KB window,\nSRAM 64 KB window", fillcolor="#7fcdc4"  ];
  }
  bus -> lsp [dir=both];
  bus -> rom [dir=both];
  nor [label="SPI NOR / NAND,\nNAND flash", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  nor -> sfc [dir=both, style=dashed];
  nor -> nand [dir=both, style=dashed];
  sd [label="SD card / Wi-Fi", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  sd -> sdio [dir=both, style=dashed];
  phy [label="Ethernet PHY", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  phy -> eth [dir=both, style=dashed];
  usbp [label="USB port", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  usbp -> usb [dir=both, style=dashed];
  sens [label="CMOS sensor", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  vi -> sens [dir=both, style=dashed];
  disp [label="CVBS / BT.1120\nHDMI or SDI bridge", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  vo -> disp [dir=both, style=dashed];
  bus -> cpu [dir=both];
}
