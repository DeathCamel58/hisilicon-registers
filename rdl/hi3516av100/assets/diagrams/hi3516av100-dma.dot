// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3516av100-dma" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3516A/D V100: DMAC request lines</B><BR/><FONT POINT-SIZE="11">data sheet Table 3-11; 4 channels, channel 0 highest priority; MISC_CTRL1[i2c1_dma_ch_sel] moves the I2C1 requests</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  u [label="UART0..3 RX/TX\nlines 4-11", fillcolor="#7fcdc4"  ];
  i0 [label="I2C0 / I2C2 (lines 0-3)", fillcolor="#7fcdc4"  ];
  i1 [label="I2C1 (lines 0-3 or 12-15)", fillcolor="#7fcdc4"  ];
  s [label="SSP0 / SSP1 (lines 14/15, 12/13)", fillcolor="#7fcdc4"  ];
  sel [label="MISC_CTRL1[i2c1_dma_ch_sel]\n100 lines 0/1, 101 lines 2/3,\n110 lines 12/13, 111 lines 14/15", fillcolor="#d6d27a"  ];
  dmac [label="DMAC 0x10060000\n4 channels, LLI, 2 AHB masters", fillcolor="#e0b86f"  ];
  mem [label="DDR / peripherals", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  u -> dmac;
  i0 -> sel;
  i1 -> sel;
  s -> sel;
  sel -> dmac;
  dmac -> mem;
}
