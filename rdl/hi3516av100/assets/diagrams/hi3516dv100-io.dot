// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3516dv100-io" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3516D V100: storage, USB and Ethernet paths</B><BR/><FONT POINT-SIZE="11">controller blocks with register bases and memory windows from data sheet Table 1-3; external parts are typical (the data sheet application diagram)</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  sfc [label="SFC (SPI NOR) 0x10010000\nwindow 0x58000000, 64 MB", fillcolor="#8fb3de"  ];
  snfc [label="SPI NAND control 0x10040000\nwindow 0x54000000, 64 MB", fillcolor="#8fb3de"  ];
  nand [label="NANDC 0x10000000\nwindow 0x50000000, 64 MB", fillcolor="#8fb3de"  ];
  sdio [label="SDIO0 0x206E0000, SDIO1 0x206F0000", fillcolor="#8fb3de"  ];
  gsf [label="GSF GMAC 0x10090000", fillcolor="#8fb3de"  ];
  usbh [label="USB EHCI 0x100B0000 / OHCI 0x100A0000", fillcolor="#8fb3de"  ];
  usbd [label="USB device 0x10080000", fillcolor="#8fb3de"  ];
  nor [label="SPI NOR flash", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  nandf [label="SPI NAND / NAND flash", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  sd [label="SD card / SDIO Wi-Fi", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  phy [label="Ethernet PHY\nRGMII / RMII / MII", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  port [label="USB 2.0 host/device port", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  sfc -> nor;
  snfc -> nandf;
  nand -> nandf;
  sdio -> sd;
  gsf -> phy;
  usbh -> port;
  usbd -> port;
}
