// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3516av100-power" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3516A/D V100: operating modes and power control</B><BR/><FONT POINT-SIZE="11">data sheet 3.5.3 Figure 3-4, 3.11</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  por [label="after POR: slow mode", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  slow [label="slow mode\n24 MHz XIN, APLL off", fillcolor="#8fb3de"  ];
  norm [label="normal mode\nclocks from the PLLs", fillcolor="#a6c98f"  ];
  doze [label="doze mode\n46.875 kHz (XIN / 512)", fillcolor="#7fcdc4"  ];
  pll [label="PLLCTL: enable APLL,\nwait SC_XTALCTRL plltime", fillcolor="#d6d27a"  ];
  opt [label="power options: clock gating, PLL power-down\nPERI_CRG1/3/5/9[23], USB clock PERI_CRG46[7],\nDDR self-refresh, DVFS / AVS (PMC)", fillcolor="#9aa7e6"  ];
  venc [label="VEDU / AVC power-off:\nreset, clock off, isolate, request\n(PERI_CRG16, MISC_CTRL5)", fillcolor="#c9a0dc"  ];
  por -> slow;
  slow -> pll [label="modectrl MSB = 1"];
  pll -> norm [label="SWtoPLL"];
  norm -> slow [label="SWfromPLL"];
  slow -> doze [label="modectrl = 001"];
  doze -> slow [label="modectrl = 010"];
  norm -> opt;
  opt -> venc;
}
