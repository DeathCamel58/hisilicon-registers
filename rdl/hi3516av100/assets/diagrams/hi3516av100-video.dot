// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3516av100-video" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3516A/D V100: video data path</B><BR/><FONT POINT-SIZE="11">block names and capabilities from the data sheet chapter 1 (ISP, VPSS, VGS, VEDU, VDP, TDE, IVE ...); the arrows are the usual camera data path (INFERRED, not tabulated in the data sheet); frames pass through DDR between stages</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  sen [label="CMOS sensor\nMIPI / LVDS / HiSPi / DC / BT.656/1120", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  vicap [label="VICAP + MIPI RX\n(input interface)", fillcolor="#a6c98f"  ];
  isp [label="ISP\n3A, WDR, FPN, DPC, lens correction", fillcolor="#a6c98f"  ];
  vpss [label="VPSS\n3DNR, scale, rotate, OSD/cover", fillcolor="#a6c98f"  ];
  vgs [label="VGS\nscale / stitch / OSD", fillcolor="#a6c98f"  ];
  venc [label="VEDU (H.265) / AVC (H.264)\nJPGE (JPEG)", fillcolor="#a6c98f"  ];
  ive [label="IVE + MD\nmotion, perimeter, diagnosis", fillcolor="#a6c98f"  ];
  tde [label="TDE\ngraphics 2D", fillcolor="#a6c98f"  ];
  vdp [label="VDP\nvideo + graphics layers", fillcolor="#a6c98f"  ];
  out [label="CVBS / BT.1120 / BT.656", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  net [label="GMAC / SDIO / USB / SFC\n(stream out, storage)", fillcolor="#8fb3de"  ];
  sen -> vicap;
  vicap -> isp;
  isp -> vpss;
  vpss -> vgs;
  vpss -> venc;
  vpss -> ive;
  vgs -> venc;
  venc -> net [label="streams"];
  vpss -> vdp;
  tde -> vdp [label="graphics"];
  vdp -> out;
}
