            desc = "Integral frequency multiplier of VPLL.";
            sw = rw;
            hw = r;
            reset = 0x63;
        } vpll_fbdiv[11:0];
    } PERI_CRG5 @ 0x14;

    reg {
        name = "EPLL configuration register 0";
        desc = "PERI_CRG8 is EPLL configuration register 0.

EPLL: reset VCO = 24 x 125 / 3 = 1000 MHz, FOUTPOSTDIV (/2) = 500 MHz, FOUT1PH0 250 MHz, FOUT2 125 MHz (data sheet figure 3-3: 500/250/125 MHz clocks for bus, CBB, SFC, RGMII; a /3 divider gives 333 MHz).

Data sheet 3.2.7 PERI_CRG8 (offset 0x20, printed page 3-18, `hi3516av100--Hi3516A-Hi3516D-Datasheet.txt` line 18765).";

        field {
            name = "epll_postdiv2";
            desc = "Level-2 output divider of the EPLL.";
            sw = rw;
            hw = r;
            reset = 0x1;
        } epll_postdiv2[30:28];

        field {
            name = "epll_postdiv1";
            desc = "Level-1 output divider of the EPLL.";
            sw = rw;
            hw = r;
            reset = 0x2;
        } epll_postdiv1[26:24];

        field {
            name = "epll_frac";
