    reg {
        name = "Multiplexing control register for the VI0HS pin";
        desc = "reg0 is the multiplexing control register for the VI0HS pin (DS: VI0HS 管脚复用控制寄存器). Reset value 0 selects VI0HS. Other values: reserved (其它：保留).

Data sheet 2.5 reg0 (offset 0x0, printed page 2-66, `hi3520v100--Hi3520-Datasheet.txt` line 5305).";

        enum reg0_reg0_enum {
            VI0HS = 0 { name = "Vi0Hs"; desc = "VI0HS"; };
            URXD2 = 1 { name = "Urxd2"; desc = "URXD2"; };
            GPIO1_3 = 2 { name = "Gpio1 3"; desc = "GPIO1_3"; };
        };

        field {
            name = "reg0";
            desc = "Function of the VI0HS pin (DS: VI0HS 管脚的具体复用情况).";
            sw = rw;
            hw = r;
            encode = reg0_reg0_enum;
            reset = 0x0;
        } reg0[1:0];
    } reg0 @ 0x0;

