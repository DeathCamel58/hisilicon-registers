// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3520v100-boot" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3520 V100: boot flow</B><BR/><FONT POINT-SIZE="11">data sheet 3.3.2, Table 3-17 (applies to the ARM1176; pin levels EBIADR23, EBIADR24)</FONT>>, fontcolor="#808080", rankdir=TB];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  por [label="Power-on reset", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  sel [label="EBIADR23 / EBIADR24\npull levels", fillcolor="#d6d27a"   shape=diamond];
  nor [label="NOR flash (8-bit, SMI chip select 0)", fillcolor="#8fb3de"  ];
  nand [label="NAND flash", fillcolor="#8fb3de"  ];
  ddr [label="DDR", fillcolor="#8fb3de"  ];
  run [label="ARM1176 boot program runs;\nremap cleared (ITCM at address 0)", fillcolor="#a6c98f"  ];
  arm1 [label="ARM926 (slave) starts later:\nARM1176 writes its program to 0xC8000000\nand releases it", fillcolor="#c9a0dc"  ];
  por -> sel;
  sel -> nor [label="down, down"];
  sel -> ddr [label="down, up or up, up"];
  sel -> nand [label="up, down"];
  nor -> run;
  nand -> run;
  ddr -> run;
  run -> arm1;
}
