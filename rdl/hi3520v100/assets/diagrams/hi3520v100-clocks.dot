// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3520v100-clocks" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3520 V100: clock tree</B><BR/><FONT POINT-SIZE="11">data sheet 3.2 (Tables 3-2 to 3-16). Data sheet inconsistency: Table 3-2 lists EPLL = SC_PERCTRL2/3, VPLL0 = 4/5, VPLL1 = 6/7, while the recommended-configuration text uses SC_PERCTRL6/7 for the EPLL and 2..5 for the VPLLs; both are shown as printed in the text</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  xin [label="XIN24 24 MHz crystal", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  viclk [label="VI0CK ... VI3CK\nvideo input clock pads", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  ethclk [label="ERXCLK / ETXCLK\n(ETH interface clocks)", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  apll [label="APLL\nSC_PERCTRL0 / SC_PERCTRL1\nFOUT2 600 / FOUT3 400 / FOUT4 300 MHz\n(recommended: 0x89000000 / 0x006C1064)", fillcolor="#e6a0a0"  ];
  epll [label="EPLL (ETH)\nFOUTPOSTDIV 500 / FOUT1PH0 250 / FOUT2 125 / FOUT4 62.5 MHz\n(recommended: 0x8B000000 / 0x006C207D)", fillcolor="#e6a0a0"  ];
  vpll0 [label="VPLL0 (VO0 clock)\nFOUTPOSTDIV, configured per scenario", fillcolor="#e6a0a0"  ];
  vpll1 [label="VPLL1 (VO1 clock)\nFOUTPOSTDIV, configured per scenario", fillcolor="#e6a0a0"  ];
  arm [label="ARM1176 (600 MHz max) and ARM926 clocks, sclk bus clock\nsysmode / SC_CTRL, arm0freq_sel SC_PERCTRL9[1:0]", fillcolor="#e0b86f"  ];
  ip [label="IP clock selects in SC_PERCTRL9:\nMMC clk [21:20] and sample phase [22], PCI [24:23], SMI [3] (AHB /1 or /2),\nVI dividers vi0..3div_sel [7:6]...[13:12] (1/2/4), VO phases [19:18],\nDATE dividers [17:14], ETH mode [28:26], ACKOUT [25]", fillcolor="#a6c98f"  ];
  sio [label="SIO0 / SIO1 / SIO2 master clocks from the ARM PLL\nMCLK fractional divider SC_PERCTRL13 / 14 [23:0], BCLK/FS dividers", fillcolor="#a6c98f"  ];
  gate [label="Clock gating: SC_PEREN / SC_PERDIS\n(generated clock-gate map)", fillcolor="#9aa7e6"  ];
  eth [label="ETH GMAC clocks", fillcolor="#8fb3de"  ];
  vo [label="VO0 / VO1 clocks", fillcolor="#a6c98f"  ];
  xin -> apll;
  xin -> epll;
  xin -> vpll0;
  xin -> vpll1;
  apll -> arm;
  apll -> ip;
  apll -> sio [label="ARMPLL source"];
  epll -> eth;
  vpll0 -> vo;
  vpll1 -> vo;
  viclk -> ip;
  ethclk -> eth;
  ip -> gate;
  arm -> gate;
  sio -> gate;
}
