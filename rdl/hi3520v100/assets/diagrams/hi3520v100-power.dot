// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3520v100-power" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3520 V100: system operating modes</B><BR/><FONT POINT-SIZE="11">data sheet 3.2 (system controller states table); mode control SC_CTRL[2:0] (sysmode)</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  normal [label="NORMAL\n24 MHz crystal, low-speed clock and PLL enabled\nARM subsystem clocks from the PLL", fillcolor="#e0b86f"  ];
  slow [label="SLOW\nPLL off\nARM subsystem clocks from the 24 MHz crystal", fillcolor="#8fb3de"  ];
  doze [label="DOZE\nPLL off\nARM subsystem clocks from the 45 kHz clock\n(divided from the crystal)", fillcolor="#7fcdc4"  ];
  sleep [label="SLEEP\nall clocks stopped except the system controller\nand IR (45 kHz)", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  por [label="power-on reset", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  normal -> slow;
  slow -> normal [label="PLL stable 0.1 ms"];
  slow -> doze;
  doze -> slow;
  doze -> sleep;
  sleep -> doze;
  por -> slow [label="crystal mode after reset"];
}
