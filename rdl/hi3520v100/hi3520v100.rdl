`include "defines.rdl"

`include "IO_CONFIG.rdl"
`include "../common/ARM_PL011.rdl"
`include "../common/ARM_PL061.rdl"
`include "../common/ARM_PL190.rdl"
`include "../common/DW_APB_I2C.rdl"
`include "../common/HISI_CIPHER.rdl"
`include "../common/HISI_DDRC.rdl"
`include "../common/HISI_DMAC.rdl"
`include "../common/HISI_DWMMC.rdl"
`include "../common/HISI_IR_V1.rdl"
`include "../common/HISI_MOTION_DETECT.rdl"
`include "../common/HISI_NANDC.rdl"
`include "../common/HISI_RTC.rdl"
`include "../common/HISI_SFC_350.rdl"
`include "../common/HISI_SIO.rdl"
`include "../common/HISI_SMI.rdl"
`include "../common/HISI_SPI.rdl"
`include "../common/HISI_SYS_CTRL.rdl"
`include "../common/HISI_TDE.rdl"
`include "../common/HISI_TIMER_SP804.rdl"
`include "../common/HISI_USB_HOST.rdl"
`include "../common/HISI_WDG_SP805.rdl"

addrmap hi3520v100 {
    name = "hi3520v100 registers";
    desc = "
        ## Datasheets

        * [Full Datasheet](assets/Hi3520-Datasheet.pdf)

        ## Diagrams

        ![Application Block Diagram](assets/Application-Block-Diagram.png)
        ![Logic Block Diagram](assets/Logic-Block-Diagram.png)
    ";

    eHISI_NANDC         NANDC           @ 0x10000000;
    eHISI_SMI           SMI             @ 0x10010000;
    eHISI_DWMMC         MMC             @ 0x10030000;
    eHISI_SIO           SIO0            @ 0x10040000;
    eHISI_SIO           SIO1            @ 0x10050000;
    eHISI_SIO           SIO2            @ 0x10060000;
    eARM_PL190          VIC0            @ 0x10070000;
    eARM_PL190          VIC1            @ 0x10080000;
    eHISI_USB_OHCI      OHCI            @ 0x100A0000;
    eHISI_USB_EHCI      EHCI            @ 0x100B0000;
    eHISI_CIPHER        CIPHER          @ 0x100C0000;
    eHISI_DMAC          DMAC            @ 0x100D0000;
    eHISI_TIMER_SP804   TIMER4          @ 0x20020000;
    eHISI_TIMER_SP804   TIMER5          @ 0x20020020;
    eHISI_TIMER_SP804   TIMER6          @ 0x20030000;
    eHISI_TIMER_SP804   TIMER7          @ 0x20030020;
    eHISI_WDG_SP805     WDG             @ 0x20040000;
    eHISI_TIMER_SP804   TIMER0          @ 0x20000000;
    eHISI_TIMER_SP804   TIMER1          @ 0x20000020;
    eHISI_TIMER_SP804   TIMER2          @ 0x20010000;
    eHISI_TIMER_SP804   TIMER3          @ 0x20010020;
    eSYS_CTRL           SYS_CTRL        @ 0x20050000;
    eHISI_RTC           RTC             @ 0x20060000;
    eHISI_IR_V1         IR              @ 0x20070000;
    eARM_PL011          UART0           @ 0x20090000;
    eARM_PL011          UART1           @ 0x200A0000;
    eARM_PL011          UART2           @ 0x200B0000;
    eARM_PL011          UART3           @ 0x200C0000;
    eDW_APB_I2C         I2C             @ 0x200D0000;
    eHISI_SPI           SPI             @ 0x200E0000;
    eIO_CONFIG          IO_CONFIG       @ 0x200F0000;
    eDDRC               DDRC0           @ 0x20110000;
    eDDRC               DDRC1           @ 0x20120000;
    aHISI_TDE           TDE             @ 0x20140000;
    eARM_PL061          GPIO0           @ 0x20150000;
    eARM_PL061          GPIO1           @ 0x20160000;
    eARM_PL061          GPIO2           @ 0x20170000;
    eARM_PL061          GPIO3           @ 0x20180000;
    eARM_PL061          GPIO4           @ 0x20190000;
    eARM_PL061          GPIO5           @ 0x201A0000;
    eARM_PL061          GPIO6           @ 0x201B0000;
    eARM_PL061          GPIO7           @ 0x201C0000;
    // MOTION_DETECT removed: the Hi3520 V100 data sheet has no motion detection register block; 0x206C_0000 lies in
    // "Reserved 0x201D_0000-0x6FFF_FFFF" (DS-3520-ZH:11495, Table 1-1), only a feature bullet mentions motion detection
    // (DS-3520-ZH:57510). The block was copied from Hi3520D. See docs/rdl-sweep/hi3520/eMOTION_DETECT.yaml.
    // eMOTION_DETECT      MOTION_DETECT   @ 0x206C0000;
};
