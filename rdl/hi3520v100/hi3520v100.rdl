`include "../common/HISI_TDE.rdl"
`include "../common/HISI_TIMER_SP804.rdl"
`include "../common/HISI_USB_HOST.rdl"
`include "../common/HISI_WDG_SP805.rdl"

addrmap hi3520v100 {
    name = "hi3520v100 registers";
    desc = "
        ## Datasheets

        * [Full Datasheet](assets/Hi3520-Datasheet.pdf)

        ## Diagrams

        ![Application Block Diagram](assets/Application-Block-Diagram.png)
        ![Logic Block Diagram](assets/Logic-Block-Diagram.png)

        <!-- overview:begin -->

        ### Diagrams

        ![Register blocks by function](assets/diagrams/hi3520v100-blocks.svg)

        ### Interrupts (VIC0 source numbers, data sheet Table 3-20; the data sheet is Chinese, names translated)

        The chip has two VICs. VIC1 (Table 3-21) has the same assignment except 4 = Dual-Timer4/5 and 5 = Dual-Timer6/7. COMMRX and COMMTX are for CPU debug use.

        | # | Source | # | Source | # | Source |
        |---|---|---|---|---|---|
        | 0 | Watchdog | 11 | SPI | 22 | USB 2.0 host OHCI |
        | 1 | Global software interrupt | 12 | UART0 or UART1 | 23 | USB 2.0 host EHCI |
        | 2 | COMMRX | 13 | UART2 or UART3 | 24 | SDIO |
        | 3 | COMMTX | 14 | GMAC | 25 | SIO0 |
        | 4 | Dual-Timer0/1 | 15 | DMAC | 26 | SIO1 |
        | 5 | Dual-Timer2/3 | 16 | I2C | 27 | SIO2 |
        | 6 | GPIO0 | 17 | VIU | 28 | CIPHER |
        | 7 | GPIO1 | 18 | TDE | 29 | PCI |
        | 8 | GPIO2-GPIO7 (combined) | 19 | VOU | 30 | NANDC |
        | 9 | IR | 20 | VEDU0 | 31 | IPCM |
        | 10 | RTC | 21 | VEDU1 |  |  |

        ### Register blocks (generated from this description)

        | Base | Instance | Block | Register space |
        |---|---|---|---|
        | 0x10000000 | NANDC | HiSilicon parallel NAND flash controller (hinfc300/301/504 family) | 96 B |
        | 0x10010000 | SMI | Static memory interface controller (SMI, PL172-style) | 520 B |
        | 0x10030000 | MMC | HiSilicon MMC/SD/SDIO controller (DesignWare-MMC based, himciv200) | 260 B |
        | 0x10040000 | SIO0 | HiSilicon SIO (I2S/PCM audio interface) | 196 B |
        | 0x10050000 | SIO1 | HiSilicon SIO (I2S/PCM audio interface) | 196 B |
        | 0x10060000 | SIO2 | HiSilicon SIO (I2S/PCM audio interface) | 196 B |
        | 0x10070000 | VIC0 | Vectored interrupt controller (ARM PrimeCell PL190) | 4 KB |
        | 0x10080000 | VIC1 | Vectored interrupt controller (ARM PrimeCell PL190) | 4 KB |
        | 0x100A0000 | OHCI | HiSilicon USB 2.0 host controller - OHCI | 92 B |
        | 0x100B0000 | EHCI | HiSilicon USB 2.0 host controller - EHCI | 176 B |
        | 0x100C0000 | CIPHER | CIPHER Registers | 132 B |
        | 0x100D0000 | DMAC | HiSilicon DMA controller (PL080-compatible, 4 or 8 channels) | 512 B |
        | 0x20000000 | TIMER0 | Timer Registers | 28 B |
        | 0x20000020 | TIMER1 | Timer Registers | 28 B |
        | 0x20010000 | TIMER2 | Timer Registers | 28 B |
        | 0x20010020 | TIMER3 | Timer Registers | 28 B |
        | 0x20020000 | TIMER4 | Timer Registers | 28 B |
        | 0x20020020 | TIMER5 | Timer Registers | 28 B |
        | 0x20030000 | TIMER6 | Timer Registers | 28 B |
        | 0x20030020 | TIMER7 | Timer Registers | 28 B |
        | 0x20040000 | WDG | Watchdog Registers | 3076 B |
        | 0x20050000 | SYS_CTRL | System Controller Registers | 3824 B |
        | 0x20060000 | RTC | RTC (ARM PL031-style 32-bit counter) | 32 B |
        | 0x20070000 | IR | HiSilicon IR receiver (V1, mode 0 only) | 56 B |
        | 0x20090000 | UART0 | UART (ARM PrimeCell PL011) | 4 KB |
        | 0x200A0000 | UART1 | UART (ARM PrimeCell PL011) | 4 KB |
        | 0x200B0000 | UART2 | UART (ARM PrimeCell PL011) | 4 KB |
        | 0x200C0000 | UART3 | UART (ARM PrimeCell PL011) | 4 KB |
        | 0x200D0000 | I2C | Synopsys DW_apb_i2c I2C Master/Slave Controller (16-bit, Hi3511/Hi3512/Hi3515/Hi3520 V100) | 148 B |
        | 0x200E0000 | SPI | SPI Registers | 40 B |
        | 0x200F0000 | IO_CONFIG | IO configuration (pin multiplexing control), Hi3520 V100 | 332 B |
        | 0x20110000 | DDRC0 | DDRC Registers | 620 B |
        | 0x20120000 | DDRC1 | DDRC Registers | 620 B |
        | 0x20140000 | TDE | HiSilicon TDE (registers not described) | 64 KB |
        | 0x20150000 | GPIO0 | ARM PL061 | 1053 B |
        | 0x20160000 | GPIO1 | ARM PL061 | 1053 B |
        | 0x20170000 | GPIO2 | ARM PL061 | 1053 B |
        | 0x20180000 | GPIO3 | ARM PL061 | 1053 B |
        | 0x20190000 | GPIO4 | ARM PL061 | 1053 B |
        | 0x201A0000 | GPIO5 | ARM PL061 | 1053 B |
        | 0x201B0000 | GPIO6 | ARM PL061 | 1053 B |
        | 0x201C0000 | GPIO7 | ARM PL061 | 1053 B |

        The table is generated from the elaborated root (instances at their absolute addresses; register space is the span of the block's registers, not the data sheet window).

        <!-- overview:end -->
    ";

    eHISI_NANDC         NANDC           @ 0x10000000;
    eHISI_SMI           SMI             @ 0x10010000;
    eHISI_DWMMC         MMC             @ 0x10030000;
    eHISI_SIO           SIO0            @ 0x10040000;
    eHISI_SIO           SIO1            @ 0x10050000;
    eHISI_SIO           SIO2            @ 0x10060000;
    eARM_PL190          VIC0            @ 0x10070000;
    eARM_PL190          VIC1            @ 0x10080000;
    eHISI_USB_OHCI      OHCI            @ 0x100A0000;
    eHISI_USB_EHCI      EHCI            @ 0x100B0000;
    eHISI_CIPHER        CIPHER          @ 0x100C0000;
    eHISI_DMAC          DMAC            @ 0x100D0000;
    eHISI_TIMER_SP804   TIMER4          @ 0x20020000;
    eHISI_TIMER_SP804   TIMER5          @ 0x20020020;
    eHISI_TIMER_SP804   TIMER6          @ 0x20030000;
    eHISI_TIMER_SP804   TIMER7          @ 0x20030020;
    eHISI_WDG_SP805     WDG             @ 0x20040000;
    eHISI_TIMER_SP804   TIMER0          @ 0x20000000;
    eHISI_TIMER_SP804   TIMER1          @ 0x20000020;
    eHISI_TIMER_SP804   TIMER2          @ 0x20010000;
    eHISI_TIMER_SP804   TIMER3          @ 0x20010020;
    eSYS_CTRL           SYS_CTRL        @ 0x20050000;
    eHISI_RTC           RTC             @ 0x20060000;
    eHISI_IR_V1         IR              @ 0x20070000;
    eARM_PL011          UART0           @ 0x20090000;
    eARM_PL011          UART1           @ 0x200A0000;
    eARM_PL011          UART2           @ 0x200B0000;
    eARM_PL011          UART3           @ 0x200C0000;
    eDW_APB_I2C         I2C             @ 0x200D0000;
    eHISI_SPI           SPI             @ 0x200E0000;
    eIO_CONFIG          IO_CONFIG       @ 0x200F0000;
    eDDRC               DDRC0           @ 0x20110000;
    eDDRC               DDRC1           @ 0x20120000;
    aHISI_TDE           TDE             @ 0x20140000;
    eARM_PL061          GPIO0           @ 0x20150000;
    eARM_PL061          GPIO1           @ 0x20160000;
    eARM_PL061          GPIO2           @ 0x20170000;
    eARM_PL061          GPIO3           @ 0x20180000;
    eARM_PL061          GPIO4           @ 0x20190000;
    eARM_PL061          GPIO5           @ 0x201A0000;
    eARM_PL061          GPIO6           @ 0x201B0000;
    eARM_PL061          GPIO7           @ 0x201C0000;
    // MOTION_DETECT removed: the Hi3520 V100 data sheet has no motion detection register block; 0x206C_0000 lies in
    // "Reserved 0x201D_0000-0x6FFF_FFFF" (DS-3520-ZH:11495, Table 1-1), only a feature bullet mentions motion detection
    // (DS-3520-ZH:57510). The block was copied from Hi3520D. See docs/rdl-sweep/hi3520/eMOTION_DETECT.yaml.
    // eMOTION_DETECT      MOTION_DETECT   @ 0x206C0000;
};
