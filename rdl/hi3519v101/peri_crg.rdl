            DPLL_POSTDIV = 1 { name = "Dpll Postdiv"; desc = "The clock is switched to the DPLL POSTDIV clock."; };
            RESERVED_2 = 2 { name = "Reserved 2"; desc = "reserved"; };
            CLK_396MHZ = 3 { name = "Clk 396Mhz"; desc = "The clock is switched to a 396 MHz clock."; };
            CLK_340MHZ = 4 { name = "Clk 340Mhz"; desc = "The clock is switched to a 340 MHz clock."; };
            CLK_300MHZ = 5 { name = "Clk 300Mhz"; desc = "The clock is switched to a 300 MHz clock."; };
            RESERVED_6 = 6 { name = "Reserved 6"; desc = "reserved"; };
            RESERVED_7 = 7 { name = "Reserved 7"; desc = "reserved"; };
        };

        field {
            name = "ddr_sc_seled";
            desc = "DDR clock switching completion indicator. Other values are reserved.";
            sw = r;
            hw = w;
            encode = PERI_CRG79_ddr_sc_seled_enum;
            reset = 0x0;
        } ddr_sc_seled[8:6];

        enum PERI_CRG79_a17_sc_seled_enum {
            CLK_24MHZ = 0 { name = "Clk 24Mhz"; desc = "The clock is switched to a 24 MHz clock."; };
            APLL_FOUTVCO = 1 { name = "Apll Foutvco"; desc = "The clock is switched to the APLL FOUTVCO clock."; };
            APLL_POSTDIV = 2 { name = "Apll Postdiv"; desc = "The clock is switched to the APLL POSTDIV clock."; };
            CLK_594MHZ = 3 { name = "Clk 594Mhz"; desc = "The clock is switched to a 594 MHz clock."; };
            CLK_792MHZ = 4 { name = "Clk 792Mhz"; desc = "The clock is switched to a 792 MHz clock."; };
            RESERVED_5 = 5 { name = "Reserved 5"; desc = "reserved"; };
            RESERVED_6 = 6 { name = "Reserved 6"; desc = "reserved"; };
            RESERVED_7 = 7 { name = "Reserved 7"; desc = "reserved"; };
        };

        field {
            name = "a17_sc_seled";
            desc = "A17 clock switching completion indicator. Other values are reserved.";
            sw = r;
            hw = w;
            encode = PERI_CRG79_a17_sc_seled_enum;
            reset = 0x0;
        } a17_sc_seled[5:3];

        enum PERI_CRG79_a7_sc_seled_enum {
            CLK_24MHZ = 0 { name = "Clk 24Mhz"; desc = "The clock is switched to a 24 MHz clock."; };
            RESERVED_1 = 1 { name = "Reserved 1"; desc = "reserved"; };
            APLL_POSTDIV = 2 { name = "Apll Postdiv"; desc = "The clock is switched to the APLL POSTDIV clock."; };
            CLK_792MHZ = 3 { name = "Clk 792Mhz"; desc = "The clock is switched to a 792 MHz clock."; };
            CLK_594MHZ = 4 { name = "Clk 594Mhz"; desc = "The clock is switched to a 594 MHz clock."; };
