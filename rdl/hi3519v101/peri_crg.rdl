        name = "GMAC interface status register";
        desc = "PERI_CRG60 is a GMAC interface status register.

GMAC interface status (read-only): link status/speed/mode seen on the RGMII receive path when rxdv and rxer are 0.

Data sheet 3.2.7 PERI_CRG60 (offset 0xF0, printed page 3-58, `hi3519v101--Hi3519V101-Datasheet.txt` line 6986).";

        enum PERI_CRG60_link_status_enum {
            LINK_DOWN = 0 { name = "Link Down"; desc = "link down"; };
            LINK_UP = 1 { name = "Link Up"; desc = "link up"; };
        };

        field {
            name = "link_status";
            desc = "Link status when rxdv and rxer are 0 in RGMII mode";
            sw = r;
            hw = w;
            encode = PERI_CRG60_link_status_enum;
            reset = 0x0;
        } link_status[3:3];

        enum PERI_CRG60_link_speed_enum {
            CLK_2P5MHZ = 0 { name = "Clk 2P5Mhz"; desc = "2.5 MHz"; };
            CLK_25MHZ = 1 { name = "Clk 25Mhz"; desc = "25 MHz"; };
            CLK_125MHZ = 2 { name = "Clk 125Mhz"; desc = "125 MHz"; };
            RESERVED_3 = 3 { name = "Reserved 3"; desc = "reserved"; };
        };

        field {
            name = "link_speed";
            desc = "Rate status when rxdv and rxer are 0 in RGMII mode";
            sw = r;
            hw = w;
            encode = PERI_CRG60_link_speed_enum;
            reset = 0x0;
        } link_speed[2:1];

        enum PERI_CRG60_link_mode_enum {
            HALF_DUPLEX_MODE = 0 { name = "Half Duplex Mode"; desc = "half-duplex mode"; };
            FULL_DUPLEX_MODE = 1 { name = "Full Duplex Mode"; desc = "full-duplex mode"; };
        };

        field {
            name = "link_mode";
            desc = "Mode status when rxdv and rxer are 0 in RGMII mode";
            sw = r;
            hw = w;
            encode = PERI_CRG60_link_mode_enum;
            reset = 0x0;
        } link_mode[0:0];
    } PERI_CRG60 @ 0xF0;

    reg {
        name = "SoC frequency status register";
        desc = "PERI_CRG79 is an SoC frequency status register.

SoC frequency status (read-only): completion indicators for the PERI_CRG13 muxes, same encodings as the select fields (a7_sc_seled [2:0], a17_sc_seled [5:3], ddr_sc_seled [8:6], sysaxi_sc_seled [9]). Poll them after changing PERI_CRG13.

Data sheet 3.2.7 PERI_CRG79 (offset 0x13C, printed page 3-58, `hi3519v101--Hi3519V101-Datasheet.txt` line 7016).";

        enum PERI_CRG79_sysaxi_sc_seled_enum {
            CLK_24MHZ = 0 { name = "Clk 24Mhz"; desc = "The clock is switched to a 24 MHz clock."; };
            CLK_198MHZ = 1 { name = "Clk 198Mhz"; desc = "The clock is switched to a 198 MHz clock."; };
        };

        field {
