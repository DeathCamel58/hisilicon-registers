            CLK_150MHZ = 3 { name = "Clk 150Mhz"; desc = "150 MHz clock"; };
            CLK_198MHZ = 4 { name = "Clk 198Mhz"; desc = "198 MHz clock (for the component that supports 3.3 V I/O voltage)"; };
            CLK_250MHZ = 5 { name = "Clk 250Mhz"; desc = "250 MHz clock (available only in DDR mode)"; };
            CLK_300MHZ = 6 { name = "Clk 300Mhz"; desc = "300 MHz clock (available only in DDR mode)"; };
