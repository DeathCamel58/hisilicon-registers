// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3519v101-boot" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3519 V101: boot flow</B><BR/><FONT POINT-SIZE="11">data sheet 1.4 Table 1-1; straps are VO_DATA0..4, 6, 8 and PWR_BUTTON1 (see the boot table)</FONT>>, fontcolor="#808080", rankdir=TB];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  por [label="Power-on reset", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  up [label="UPDATE_FROM_SDIO0 = 1 or\nUPDATE_FROM_SDIO0_N = 0 ?", fillcolor="#d6d27a"   shape=diamond];
  sd [label="BOOTROM: SDIO0 upgrade mode\n(programs the device chosen by BOOT_SEL1/0)", fillcolor="#e0b86f"  ];
  b1 [label="BOOTROM_SEL = 1 ?", fillcolor="#d6d27a"   shape=diamond];
  rom [label="BOOTROM: serial download (fastboot);\non timeout use BOOT_SEL1/0", fillcolor="#e0b86f"  ];
  sel [label="BOOT_SEL1, BOOT_SEL0", fillcolor="#d6d27a"   shape=diamond];
  spi [label="SPI NOR / SPI NAND (FMC)\nSFC_DEVICE_MODE, SFC_EMMC_BOOT_MODE,\nSPI_NAND_SEL pick wire mode", fillcolor="#8fb3de"  ];
  nand [label="NAND flash (FMC)", fillcolor="#8fb3de"  ];
  emmc [label="eMMC 4- or 8-wire\n(SFC_EMMC_BOOT_MODE)", fillcolor="#8fb3de"  ];
  pcie [label="slave: CPU held in reset;\nPCIe master loads DDR", fillcolor="#c9a0dc"  ];
  run [label="boot code runs; remap cleared\n(0x0 = BOOTRAM)", fillcolor="#a6c98f"  ];
  por -> up;
  up -> sd [label="yes"];
  up -> b1 [label="no"];
  b1 -> rom [label="1"];
  b1 -> sel [label="0"];
  sel -> spi [label="00"];
  sel -> nand [label="01"];
  sel -> emmc [label="10"];
  sel -> pcie [label="11"];
  rom -> run;
  sd -> run;
  spi -> run;
  nand -> run;
  emmc -> run;
}
