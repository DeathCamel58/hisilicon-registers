// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3519v101-io" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3519 V101: storage, USB, PCIe and Ethernet paths</B><BR/><FONT POINT-SIZE="11">controller blocks with register bases and windows from data sheet Table 1-2</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  fmc [label="FMC 0x10000000\nwindow 0x14000000, 16 MB", fillcolor="#8fb3de"  ];
  mmc [label="MMC0 0x100C0000, MMC1 0x100D0000, MMC2 0x100E0000", fillcolor="#8fb3de"  ];
  gsf [label="GSF GMAC 0x10050000", fillcolor="#8fb3de"  ];
  usb [label="USB 3.0 / 2.0 DRD + COMBPHY", fillcolor="#8fb3de"  ];
  pcie [label="PCIe 2.0 x1\ncfg 0x20000000, mem 0x28000000, 128 MB each", fillcolor="#8fb3de"  ];
  fl [label="SPI NOR / SPI NAND / NAND", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  sd [label="SD cards / eMMC 5.0", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  phy [label="Ethernet PHY\nRGMII / RMII", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  port [label="USB 3.0 / 2.0 port", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  peer [label="PCIe master or slave chip", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  fmc -> fl;
  mmc -> sd;
  gsf -> phy;
  usb -> port;
  pcie -> peer;
}
