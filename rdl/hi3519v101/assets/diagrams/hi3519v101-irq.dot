// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3519v101-irq" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>hi3519v101: interrupt routing</B><BR/><FONT POINT-SIZE="11">every peripheral line goes to the ARM GIC-400 (+ CCI-400); groups of the generated interrupt table (IDs from the data sheet table above; reserved lines omitted)</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  gic [label="ARM GIC-400 (+ CCI-400)\n(SPI interrupt IDs)", fillcolor="#d6d27a"  shape=box];
  cpu [label="Cortex-A17 + Cortex-A7", fillcolor="#e0b86f"  ];
  gic -> cpu;
  c0 [label="Timers, watchdog, RTC\n8 lines: IDs 32, 33, 96, 97, 98, 99, 100, 101\nWatchDog, RTC/TEM_CAP, Timer0, Timer1, Timer2, Timer3, ...", fillcolor="#8fb3de"  ];
  c0 -> gic;
  c1 [label="UART, I2C, SPI, GPIO, IR, ADC, PWM\n14 lines: IDs 36, 37, 38, 39, 40, 41, 42, 43, 44, 46, ...\nUART0, UART1, UART2, UART3, UART4, SSP0/I2C0, ...", fillcolor="#8fb3de"  ];
  c1 -> gic;
  c2 [label="DMA and memory\n2 lines: IDs 49, 73\nDMAC, GZIP", fillcolor="#8fb3de"  ];
  c2 -> gic;
  c3 [label="Storage\n4 lines: IDs 45, 50, 55, 56\nMMC2, FMC, MMC0, MMC1", fillcolor="#8fb3de"  ];
  c3 -> gic;
  c4 [label="Network, USB, PCIe\n15 lines: IDs 51, 52, 53, 54, 57, 86, 87, 88, 89, 90, ...\nUSB2_EHCI, USB2_OHCI, USB2_DEV, USB3, GSF, PCIE_CFG_LINK_AUTO_BW, ...", fillcolor="#8fb3de"  ];
  c4 -> gic;
  c5 [label="Security\n1 lines: IDs 58\nCipher", fillcolor="#8fb3de"  ];
  c5 -> gic;
  c6 [label="CPU debug and PMU\n7 lines: IDs 77, 78, 79, 81, 82, 83, 84\nA7_PMU, A17_PMU, CCI, A17_COMMRX, A17_COMMTX, A7_COMMRX, ...", fillcolor="#8fb3de"  ];
  c6 -> gic;
  c7 [label="Video input, ISP, processing, output\n11 lines: IDs 59, 60, 61, 62, 63, 64, 66, 67, 68, 71, ...\nVDP, MIPI0, MIPI1, VICAP0, VICAP1, VPSS, ...", fillcolor="#8fb3de"  ];
  c7 -> gic;
  c8 [label="Video codec\n2 lines: IDs 69, 70\nVEDU, JPGE", fillcolor="#8fb3de"  ];
  c8 -> gic;
  c9 [label="Other\n1 lines: IDs 74\nSoftware int", fillcolor="#8fb3de"  ];
