// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3519v101-video" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3519 V101: video data path</B><BR/><FONT POINT-SIZE="11">block names and capabilities from the data sheet chapter 1 (ISP, VPSS, VGS, VEDU, VDP, TDE, IVE ...); the arrows are the usual camera data path (INFERRED, not tabulated in the data sheet); frames pass through DDR between stages</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  sen0 [label="sensor 0 (main, up to 16 MP)\n12-lane MIPI/LVDS/HiSPi, DC, BT.1120", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  sen1 [label="sensor 1 (8 or 9 MP)\n4-lane MIPI/LVDS/HiSPi, DC", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  mipi [label="MIPI0/1 + VICAP0/1", fillcolor="#a6c98f"  ];
  isp [label="ISP x2\n(channel 1: limited WDR)", fillcolor="#a6c98f"  ];
  vpss [label="VPSS\n3DNR, scale, rotate, OSD", fillcolor="#a6c98f"  ];
  gdc [label="GDC\nlens / fisheye correction", fillcolor="#a6c98f"  ];
  vgs [label="VGS\nscale / stitch (2 channels)", fillcolor="#a6c98f"  ];
  venc [label="VEDU (H.264/H.265), JPGE", fillcolor="#a6c98f"  ];
  ive [label="IVE + TDE + GZIP", fillcolor="#a6c98f"  ];
  vdp [label="VDP: CVBS, BT.1120/656, LCD", fillcolor="#a6c98f"  ];
  net [label="GMAC / MMC / USB / FMC / PCIe\n(stream out, storage)", fillcolor="#8fb3de"  ];
  sen0 -> mipi;
  sen1 -> mipi;
  mipi -> isp;
  isp -> vpss;
  vpss -> gdc;
  gdc -> vgs;
  vpss -> vgs;
  vgs -> venc;
  vpss -> venc;
  vpss -> ive;
  venc -> net [label="streams"];
  vpss -> vdp;
  ive -> vdp [label="graphics"];
}
