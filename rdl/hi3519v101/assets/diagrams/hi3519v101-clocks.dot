// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3519v101-clocks" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3519 V101: clock tree</B><BR/><FONT POINT-SIZE="11">redrawn from data sheet Figures 3-2/3-3 and Tables 3-2..3-6; register names from the CRG chapter; which VCO belongs to which fixed PLL is INFERRED from the register tables</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  xin [label="XIN 24 MHz crystal", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  apll [label="APLL PERI_CRG_PLL0/1\nprogrammable", fillcolor="#e6a0a0"  ];
  dpll [label="DPLL PERI_CRG_PLL4/5\nprogrammable\nDDR 396 / 340 / 300", fillcolor="#e6a0a0"  ];
  vpll [label="VPLL PERI_CRG_PLL6/7\nfixed VCO 1188 MHz\n594 / 297 / 148.5 / 99 / 74.25", fillcolor="#e6a0a0"  ];
  epll [label="EPLL PERI_CRG_PLL8/9\nfixed VCO 1500 MHz\n500 / 250 / 125, 750, 3000 VCO2X", fillcolor="#e6a0a0"  ];
  cpusel [label="a7_clksel PERI_CRG13[9:7]\na17_clksel PERI_CRG13[6:4]\nddr_clksel PERI_CRG13[2:0]\nsysaxi_clksel [13:12]", fillcolor="#d6d27a"  ];
  vsel [label="VI / ISP / VPSS / VEDU / VGS / GDC / IVE selects\nPERI_CRG16, 19, 21 (sensor0/1, vi0/1, isp0/1)", fillcolor="#d6d27a"  ];
  vdpsel [label="VDP selects PERI_CRG17, LCD divider PERI_CRG18", fillcolor="#d6d27a"  ];
  iosel [label="FMC CRG48, MMC0/1/2 CRG49, GMAC CRG51/59,\nPWM/I2C/UART CRG55/57, AIAO CRG32, USB3/COMBPHY CRG43/46", fillcolor="#d6d27a"  ];
  gate [label="clock gate + soft reset bits in PERI_CRGn", fillcolor="#9aa7e6"  ];
  cpu [label="A7 / A17 clocks", fillcolor="#e0b86f"  ];
  ddr [label="DDRC clock", fillcolor="#8fb3de"  ];
  ip [label="block clocks:\nVICAP, ISP, VPSS, VGS, GDC, IVE, TDE,\nJPGE (VEDU 396/500/594), VDP, FMC, MMC, GSF, AIAO", fillcolor="#a6c98f"  ];
  xin -> apll;
  xin -> dpll;
  xin -> vpll;
  xin -> epll;
  apll -> cpusel;
  dpll -> cpusel;
  vpll -> vsel;
  epll -> vsel;
  vpll -> vdpsel;
  epll -> iosel;
  dpll -> iosel;
  cpusel -> cpu;
  cpusel -> ddr;
  vsel -> gate;
  vdpsel -> gate;
  iosel -> gate;
  gate -> ip;
}
