// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3519v101-power" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3519 V101: power control</B><BR/><FONT POINT-SIZE="11">data sheet 3.10: power controller and RTC in the always-on area; PWR_SEQ0-2 control the supplies of the power-off area</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  rtc [label="RTC + power controller\n(always on, 32.768 kHz)", fillcolor="#7fcdc4"  ];
  key [label="PWR_BUTTON0/1, PWR_WAKEUP0/1/2\nRTC alarm", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  seq [label="PWR_SEQ0, 1, 2 / PWR_EN0/1/2", fillcolor="#9aa7e6"  ];
  dcdc [label="DC/DC and LDO supplies\n(power-off area)", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  chip [label="SoC core and I/O supplies", fillcolor="#a6c98f"  ];
  pmc [label="PMC: DVFS / AVS", fillcolor="#d6d27a"  ];
  key -> rtc [label="wakeup"];
  rtc -> seq;
  seq -> dcdc;
  dcdc -> chip;
  chip -> pmc;
}
