// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3519v101-resets" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3519 V101: reset tree</B><BR/><FONT POINT-SIZE="11">data sheet 3.1 Figure 3-1 and Table 3-1</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  pin [label="external reset", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  por [label="internal POR", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  wdg [label="watchdog\nwdg_rst_req", fillcolor="#8fb3de"  ];
  npor [label="npor\nglobal hard reset", fillcolor="#d6d27a"   shape=diamond];
  sc [label="system controller (level 1)\nsys_rst_req", fillcolor="#e0b86f"  ];
  sys [label="sys_rst_n\nglobal soft reset", fillcolor="#d6d27a"   shape=diamond];
  crg [label="CRG (level 2)\nPERI_CRGn xx_srst_req", fillcolor="#9aa7e6"  ];
  xx [label="xx_rst_n per module", fillcolor="#d6d27a"   shape=diamond];
  blk [label="chip modules", fillcolor="#a6c98f"  ];
  pin -> npor;
  por -> npor;
  npor -> blk;
  wdg -> sc;
  sc -> sys;
  sys -> blk;
  crg -> xx;
  xx -> blk;
}
