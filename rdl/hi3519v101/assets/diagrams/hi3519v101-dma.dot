// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3519v101-dma" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3519 V101: DMAC request lines</B><BR/><FONT POINT-SIZE="11">data sheet Table 3-11; 4 channels; MISC_CTRL1 dma_01_sel / dma_67_sel / dma_89_sel / dma_ab_sel choose the line owner</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  u03 [label="UART0 or UART4 (0/1)\nUART1 (2/3), UART2 (4/5)", fillcolor="#7fcdc4"  ];
  m67 [label="UART3, I2C3 or SSP3 (6/7)", fillcolor="#7fcdc4"  ];
  m89 [label="I2C0 or SSP0 (8/9)", fillcolor="#7fcdc4"  ];
  mab [label="I2C1 or SSP1 (10/11)", fillcolor="#7fcdc4"  ];
  fix [label="SSP2 (12/13), I2C2 (14/15)", fillcolor="#7fcdc4"  ];
  sel [label="MISC_CTRL1 select fields", fillcolor="#d6d27a"  ];
  dmac [label="DMAC 0x10030000\n4 channels", fillcolor="#e0b86f"  ];
  mem [label="DDR / peripherals", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  u03 -> sel;
  m67 -> sel;
  m89 -> sel;
  mab -> sel;
  fix -> dmac;
  sel -> dmac;
  dmac -> mem;
}
