// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3515v100-logic" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3515 V100: logic block diagram</B><BR/><FONT POINT-SIZE="11">redrawn from data sheet Figure 1-1 (chapter 1.1.1)</FONT>>, fontcolor="#808080", rankdir=LR, compound=true, newrank=true];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  bus [label="shared memory switch / DMA", fillcolor="#9a9a9a"  shape=box, height=5.2, width=0.5, fontcolor="white"];
  subgraph cluster_cpu { label="CPU subsystem"; fontcolor="#808080"; color="#808080"; style="rounded";
  cpu [label="ARM926EJ-S 400 MHz\n16 KB I + 16 KB D cache, 2 KB ITCM", fillcolor="#e0b86f"  ];
  }
  ddrc [label="DDRC", fillcolor="#8fb3de"  ];
  ddrext [label="DDR2 controller\n32 bit, up to 200 MHz", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  ddrext -> ddrc [dir=both]; ddrc -> cpu [dir=both]; ddrc -> bus [dir=both, style=dashed];
  subgraph cluster_l0 { label="Storage and network"; fontcolor="#808080"; color="#808080"; style="rounded";
    nand [label="NAND flash controller", fillcolor="#8fb3de"  ];
    nor [label="NOR flash (SMI) controller", fillcolor="#8fb3de"  ];
    eth [label="ETH MAC 10/100", fillcolor="#8fb3de"  ];
    sata [label="SATA II x2", fillcolor="#8fb3de"  ];
    mmc [label="MMC / SD / SDIO", fillcolor="#8fb3de"  ];
    usb [label="USB 2.0 host x2", fillcolor="#8fb3de"  ];
  }
  nand -> bus [dir=both];
  nor -> bus [dir=both];
  eth -> bus [dir=both];
  sata -> bus [dir=both];
  mmc -> bus [dir=both];
  usb -> bus [dir=both];
  subgraph cluster_l1 { label="Security"; fontcolor="#808080"; color="#808080"; style="rounded";
    cipher [label="AES / DES / 3DES", fillcolor="#c9a0dc"  ];
  }
  cipher -> bus [dir=both];
  subgraph cluster_r0 { label="Video"; fontcolor="#808080"; color="#808080"; style="rounded";
    vi [label="Video in x4\nBT.656 / BT.1120", fillcolor="#a6c98f"  ];
    gfx [label="Graphics engine\nde-interlace / scaler / OSD (TDE)", fillcolor="#a6c98f"  ];
    codec [label="Video codec\nH.264 / MJPEG", fillcolor="#a6c98f"  ];
    vo [label="Video out: CVBS / VGA / BT.656", fillcolor="#a6c98f"  ];
  }
  bus -> vi [dir=both];
  bus -> gfx [dir=both];
  bus -> codec [dir=both];
  bus -> vo [dir=both];
  subgraph cluster_r1 { label="Low-speed peripherals"; fontcolor="#808080"; color="#808080"; style="rounded";
    lsp [label="I2S x2 (SIO), I2C, SSP/SPI, GPIO, JTAG,\nUART x4, IR, timers, WDT, RTC, interrupts (VIC)", fillcolor="#7fcdc4"  ];
  }
  bus -> lsp [dir=both];
  flash [label="NAND / NOR flash", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  flash -> nand [dir=both, style=dashed];
  flash -> nor [dir=both, style=dashed];
  phy [label="Ethernet PHY", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  phy -> eth [dir=both, style=dashed];
  hdd [label="SATA hard disks", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  hdd -> sata [dir=both, style=dashed];
  sd [label="SD card", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  sd -> mmc [dir=both, style=dashed];
  bus -> cpu [dir=both];
}
