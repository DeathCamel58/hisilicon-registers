// written by scripts/rdl-extract/overview_nvr_p2.py - do not edit
digraph "hi3515v100-irq" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.12, ranksep=0.7, rankdir=LR,
         label=<<B>Hi3515 V100: interrupt topology</B><BR/><FONT POINT-SIZE="11">generated from the interrupt table of this description; interrupt controller: VIC (PL190 style); reserved IDs omitted</FONT>>, fontcolor="#808080"];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=10, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.08,0.03"];
  edge [color="#808080", arrowsize=0.6];
  g0 [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#606060" BGCOLOR="#d6d27a"><TR><TD COLSPAN="2" BGCOLOR="#404858"><FONT COLOR="white"><B>Timers, watchdog, RTC</B></FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">0</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">Watchdog interrupt</FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">4</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">Dual-timer01 interrupt</FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">5</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">Dual-timer23 interrupt</FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">10</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">RTC interrupt</FONT></TD></TR></TABLE>>];
  g1 [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#606060" BGCOLOR="#8fb3de"><TR><TD COLSPAN="4" BGCOLOR="#404858"><FONT COLOR="white"><B>Serial, I/O, GPIO</B></FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">6</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">GPIO0 interrupt</FONT></TD><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">12</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">UART0 or UART1 interrupt</FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">7</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">GPIO1 interrupt</FONT></TD><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">13</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">UART2 or UART3 interrupt</FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">8</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">Combined interrupt of GPIO2, GPIO3, GPIO4, and GPIO5</FONT></TD><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">16</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">I2C interrupt</FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">9</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">IR interrupt</FONT></TD><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">25</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">SIO0 interrupt</FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">11</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">SPI interrupt</FONT></TD><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">26</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">SIO1 interrupt</FONT></TD></TR></TABLE>>];
  g2 [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#606060" BGCOLOR="#a6c98f"><TR><TD COLSPAN="2" BGCOLOR="#404858"><FONT COLOR="white"><B>Storage, network, USB, DMA</B></FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">14</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">ETH interrupt</FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">15</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">DMAC interrupt</FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">22</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">USB 2.0 HOST OHCI interrupt</FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">23</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">USB 2.0 HOST EHCI interrupt</FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">24</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">SDIO interrupt</FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">28</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">CIPHER interrupt</FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">29</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">SATA interrupt</FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">30</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">NANDC interrupt</FONT></TD></TR></TABLE>>];
  g3 [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#606060" BGCOLOR="#c9a0dc"><TR><TD COLSPAN="2" BGCOLOR="#404858"><FONT COLOR="white"><B>Video and graphics</B></FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">17</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">VIU interrupt</FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">18</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">TDE interrupt</FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">19</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">VOU interrupt</FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">20</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">VEDU interrupt</FONT></TD></TR></TABLE>>];
  g4 [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#606060" BGCOLOR="#e6a0a0"><TR><TD COLSPAN="2" BGCOLOR="#404858"><FONT COLOR="white"><B>CPU debug and internal</B></FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">1</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">Global software interrupt</FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">2</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">COMMRX interrupt</FONT></TD></TR><TR><TD ALIGN="RIGHT"><FONT FACE="Courier" POINT-SIZE="9" COLOR="#202020">3</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#101010">COMMTX interrupt</FONT></TD></TR></TABLE>>];
  ctl [label="VIC\nVIC\n(PL190 style)", shape=box, style="filled", fillcolor="#e0b86f", fontsize=12];
  cpu [label="CPU interrupt inputs\n(IRQ / FIQ)", fillcolor="#e0b86f"];
  g0 -> ctl;
  g1 -> ctl;
  g2 -> ctl;
  g3 -> ctl;
  g4 -> ctl;
  ctl -> cpu;
}
