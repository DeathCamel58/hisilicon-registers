// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3515v100-clocks" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3515 V100: clock tree</B><BR/><FONT POINT-SIZE="11">data sheet 3.2.3 (Tables 3-2 to 3-4): four PLLs, VCO range 800 MHz to 2.4 GHz</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  xin [label="XIN24 24 MHz crystal", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  viclk [label="VI0CK ... VI3CK\nvideo input clock pads", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  ethclk [label="ERXCLK / ETXCLK\n(ETH interface clocks)", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  apll [label="APLL\nSC_PERCTRL0 / SC_PERCTRL1\nFOUT2 400 / FOUT3 266 MHz\n(recommended: 0x89000000 / 0x006C30C8)", fillcolor="#e6a0a0"  ];
  epll [label="EPLL (ETH clock)\nSC_PERCTRL2 / SC_PERCTRL3", fillcolor="#e6a0a0"  ];
  vpll0 [label="VPLL0 (VO0 clock)\nSC_PERCTRL4 / SC_PERCTRL5", fillcolor="#e6a0a0"  ];
  vpll1 [label="VPLL1 (VO1 clock)\nSC_PERCTRL6 / SC_PERCTRL7", fillcolor="#e6a0a0"  ];
  arm [label="ARM926 (400 MHz max), DDR2 (200 MHz max), bus clocks", fillcolor="#e0b86f"  ];
  ip [label="IP clock selects (SC_PERCTRL9) and SIO dividers (SC_PERCTRL13/14)", fillcolor="#a6c98f"  ];
  gate [label="Clock gating: SC_PEREN / SC_PERDIS", fillcolor="#9aa7e6"  ];
  eth [label="ETH MAC clocks", fillcolor="#8fb3de"  ];
  vo [label="VO0 / VO1 clocks", fillcolor="#a6c98f"  ];
  xin -> apll;
  xin -> epll;
  xin -> vpll0;
  xin -> vpll1;
  apll -> arm;
  apll -> ip;
  epll -> eth;
  vpll0 -> vo;
  vpll1 -> vo;
  viclk -> ip;
  ethclk -> eth;
  ip -> gate;
  arm -> gate;
}
