            UTXD2 = 1 { name = "Utxd2"; desc = "UTXD2"; };
            GPIO1_4 = 2 { name = "Gpio1 4"; desc = "GPIO1_4"; };
        };

        field {
            name = "reg1";
            desc = "Multiplexing of the VI0VS pin. Other values: reserved.";
            sw = rw;
            hw = r;
            encode = reg1_reg1_enum;
            reset = 0x0;
