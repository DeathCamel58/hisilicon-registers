`ifndef HI3515V100_IO_CONFIG_RDL
`define HI3515V100_IO_CONFIG_RDL

regfile eIO_CONFIG {
    name = "IO configuration (pin multiplexing control), Hi3515 V100";
    desc = "
    0x200F0000..: `regN` pin multiplexing control registers (48 registers, one per pin, offsets 0x000..0x0BC; the field value selects the pin function, 0 is the reset default = the pin's primary function; the upper bits are reserved and read 0).
    Source: Hi3515 data sheet issue 02 (2010-04-20), English edition (no Chinese original is available in the tree; the register names `reg0`..`reg47` are the data sheet's own): 2.4 Summary of the IO Config registers (Table 2-30, `hi3515v100--Hi3515-Datasheet.txt` line 3060) and the register descriptions that follow it in the same section (lines 3100-4683). Memory map Table 1-1 lists the IO config window at 0x200F0000.
    No vendor Hi3515 pin-multiplexing code is in the tree (the vendor U-Boot/kernel trees carry no Hi3515 V100 port), so the encodings are data-sheet only.
    ";

    reg {
        name = "Multiplexing control register of the VI0HS pin";
        desc = "Multiplexing control register of the VI0HS pin.

Data sheet 2.4 reg0 (offset 0x0, printed page 2-38, `hi3515v100--Hi3515-Datasheet.txt` line 3214).";

        enum reg0_reg0_enum {
            VI0HS = 0 { name = "Vi0Hs"; desc = "VI0HS"; };
            URXD2 = 1 { name = "Urxd2"; desc = "URXD2"; };
            GPIO1_3 = 2 { name = "Gpio1 3"; desc = "GPIO1_3"; };
        };

        field {
            name = "reg0";
            desc = "Multiplexing of the VI0HS pin. Other values: reserved.";
            sw = rw;
            hw = r;
            encode = reg0_reg0_enum;
            reset = 0x0;
        } reg0[1:0];
    } reg0 @ 0x0;

    reg {
        name = "Multiplexing control register of the VI0VS pin";
        desc = "Multiplexing control register of the VI0VS pin.

Data sheet 2.4 reg1 (offset 0x4, printed page 2-38, `hi3515v100--Hi3515-Datasheet.txt` line 3241).";

