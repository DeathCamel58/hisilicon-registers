addrmap hi3511v100 {
    name = "hi3511v100 registers";
    desc = "
        ## Datasheets

        * [Full Datasheet](assets/Hi3511-Datasheet.pdf)

        ## Diagrams

        ![Logic Block Diagram](assets/Logic-Block-Diagram.png)

        ## Addresses

