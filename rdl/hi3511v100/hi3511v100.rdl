        | 0x101E2000    | 0x101E2FFF  | Timer0/1 registers 4 KB      | &#9989;         |
        | 0x101E1000    | 0x101E1FFF  | WatchDog registers 4 KB      | &#9989;         |
        | 0x101E0000    | 0x101E0FFF  | System control registers 4 KB           | &#9989;         |
        | 0x10160000    | 0x101DFFFF  | Reserved 512 KB              | &#10060;        |
        | 0x10150000    | 0x1015FFFF  | DDRC registers 64 KB         | &#10060;        |
        | 0x10140000    | 0x1014FFFF  | INT registers 64 KB          | &#9989;         |
        | 0x10130000    | 0x1013FFFF  | DMA registers 64 KB          | &#9989;         |
        | 0x10120000    | 0x1012FFFF  | Reserved 64 KB               | &#10060;        |
        | 0x10110000    | 0x1011FFFF  | Reserved 64 KB               | &#10060;        |
        | 0x10100000    | 0x1010FFFF  | SMI registers 64 KB          | &#9989;         |
        | 0x01000000    | 0x100FFFFF  | Reserved 257 MB              | &#10060;        |
        | 0x00000000    | 0x00FFFFFF  | - 16 MB                | &#10060;        |
    ";

    eHISI_SMI           SMI             @ 0x10100000;
    eHISI_DMAC          DMAC            @ 0x10130000;
    eARM_PL190          VIC             @ 0x10140000;
    eSYS_CTRL           SYS_CTRL        @ 0x101E0000;
