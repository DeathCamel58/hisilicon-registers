        <!-- overview:begin -->

        ### Diagrams

        ![Register blocks by function](assets/diagrams/hi3511v100-blocks.svg)

        ### Interrupts (VIC source numbers, data sheet Table 3-13; the data sheet is Chinese, names translated)

        COMMRX and COMMTX are for CPU debug use.

        | # | Source | # | Source | # | Source |
        |---|---|---|---|---|---|
        | 0 | Watchdog | 11 | SSP | 22 | External pin INTRN (multiplexed pin) |
        | 1 | Software interrupt | 12 | UART0 | 23 | USB 2.0 OTG |
        | 2 | COMMRX | 13 | UART1 | 24 | MMC |
        | 3 | COMMTX | 14 | UART2 | 25 | VIU |
        | 4 | Dual-Timer0 | 15 | ETH | 26 | DSU |
        | 5 | Dual-Timer1 | 16 | VOU | 27 | SIO0 |
        | 6 | GPIO0 | 17 | DMAC | 28 | VEDU |
        | 7 | GPIO1 | 18 | SIO1 | 29 | Reserved |
        | 8 | GPIO2-GPIO7 (combined) | 19 | I2C | 30 | PCI |
        | 9 | IR | 20 | USB 1.1 host | 31 | TDE |
        | 10 | RTC | 21 | CIPHER |  |  |

        ### Register blocks (generated from this description)

        | Base | Instance | Block | Register space |
        |---|---|---|---|
        | 0x10100000 | SMI | Static memory interface controller (SMI, PL172-style) | 520 B |
        | 0x10130000 | DMAC | HiSilicon DMA controller (PL080-compatible, 4 or 8 channels) | 512 B |
        | 0x10140000 | VIC | Vectored interrupt controller (ARM PrimeCell PL190) | 4 KB |
        | 0x10150000 | DDRC | DDRC Registers | 184 B |
        | 0x101E0000 | SYS_CTRL | System Controller Registers | 3824 B |
        | 0x101E1000 | WDG | Watchdog Registers | 3076 B |
        | 0x101E2000 | TIMER0 | Timer Registers | 28 B |
        | 0x101E2020 | TIMER1 | Timer Registers | 28 B |
        | 0x101E3000 | TIMER2 | Timer Registers | 28 B |
        | 0x101E3020 | TIMER3 | Timer Registers | 28 B |
        | 0x101E4000 | GPIO0 | ARM PL061 | 1053 B |
        | 0x101E5000 | GPIO1 | ARM PL061 | 1053 B |
        | 0x101E6000 | GPIO2 | ARM PL061 | 1053 B |
        | 0x101E7000 | GPIO3 | ARM PL061 | 1053 B |
        | 0x101E8000 | RTC | RTC (ARM PL031-style 32-bit counter) | 32 B |
        | 0x101E9000 | IR | HiSilicon IR receiver (V1, mode 0 only) | 56 B |
        | 0x101F1000 | UART0 | UART (ARM PrimeCell PL011) | 4 KB |
        | 0x101F2000 | UART1 | UART (ARM PrimeCell PL011) | 4 KB |
        | 0x101F3000 | UART2 | UART (ARM PrimeCell PL011) | 4 KB |
        | 0x101F4000 | SPI | SPI Registers | 40 B |
        | 0x101F6000 | I2C | Synopsys DW_apb_i2c I2C Master/Slave Controller (16-bit, Hi3511/Hi3512/Hi3515/Hi3520 V100) | 148 B |
        | 0x101F7000 | GPIO4 | ARM PL061 | 1053 B |
        | 0x101F8000 | GPIO5 | ARM PL061 | 1053 B |
        | 0x101F9000 | GPIO6 | ARM PL061 | 1053 B |
        | 0x101FA000 | GPIO7 | ARM PL061 | 1053 B |
        | 0x80080000 | SIO0 | HiSilicon SIO V1 (I2S/PCM audio interface, Hi3511/Hi3512) | 196 B |
        | 0x90020000 | MMC | HiSilicon MMC/SD/SDIO controller (DesignWare-MMC based, himciv200) | 260 B |
        | 0x90040000 | CIPHER | CIPHER Registers | 132 B |
        | 0x90080000 | VEDU | HiSilicon VEDU (registers not described) | 64 KB |
        | 0x900A0000 | SIO1 | HiSilicon SIO V1 (I2S/PCM audio interface, Hi3511/Hi3512) | 196 B |
        | 0xA0000000 | USB11_HOST | HiSilicon USB 2.0 host controller - OHCI | 88 B |

        The table is generated from the elaborated root (instances at their absolute addresses; register space is the span of the block's registers, not the data sheet window).

        <!-- overview:end -->
    ";

    eHISI_SMI           SMI             @ 0x10100000;
    eHISI_DMAC          DMAC            @ 0x10130000;
    eARM_PL190          VIC             @ 0x10140000;
    eDDRC               DDRC            @ 0x10150000;
    eSYS_CTRL           SYS_CTRL        @ 0x101E0000;
    eHISI_RTC           RTC             @ 0x101E8000;
    eHISI_WDG_SP805     WDG             @ 0x101E1000;
    eHISI_TIMER_SP804   TIMER0          @ 0x101E2000;
    eHISI_TIMER_SP804   TIMER1          @ 0x101E2020;
    eHISI_TIMER_SP804   TIMER2          @ 0x101E3000;
    eHISI_TIMER_SP804   TIMER3          @ 0x101E3020;
    eARM_PL061          GPIO0           @ 0x101E4000;
    eARM_PL061          GPIO1           @ 0x101E5000;
    eARM_PL061          GPIO2           @ 0x101E6000;
    eARM_PL061          GPIO3           @ 0x101E7000;
    eHISI_IR_V1         IR              @ 0x101E9000;
    eARM_PL011          UART0           @ 0x101F1000;
    eARM_PL011          UART1           @ 0x101F2000;
    eARM_PL011          UART2           @ 0x101F3000;
    eDW_APB_I2C         I2C             @ 0x101F6000;
    eARM_PL061          GPIO4           @ 0x101F7000;
    eARM_PL061          GPIO5           @ 0x101F8000;
    eARM_PL061          GPIO6           @ 0x101F9000;
    eARM_PL061          GPIO7           @ 0x101FA000;
    eHISI_SPI           SPI             @ 0x101F4000;
    eHISI_SIO_V1        SIO0            @ 0x80080000;
    eHISI_DWMMC         MMC             @ 0x90020000;
    eHISI_CIPHER        CIPHER          @ 0x90040000;
    aHISI_VEDU          VEDU            @ 0x90080000;
    eHISI_SIO_V1        SIO1            @ 0x900A0000;
    eHISI_USB_OHCI      USB11_HOST      @ 0xA0000000;
};
