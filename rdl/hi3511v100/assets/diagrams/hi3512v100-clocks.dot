// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3512v100-clocks" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3511 / Hi3512: clock tree</B><BR/><FONT POINT-SIZE="11">data sheet 3.2 (Figure 3-2, Tables 3-2 to 3-3): a single ARM PLL feeds the ARM and the bus clocks; the other IP clocks are divided from it</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  xin [label="XIN / XIN24 crystals", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  viclk [label="VI0CK ... VI3CK\nvideo input clock pads", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  ethclk [label="ERXCLK / ETXCLK\n(ETH interface clocks)", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  apll [label="ARMPLL\nSC_PLLFCTRL (frequency), SC_PLLCTRL[0] (enable)", fillcolor="#e6a0a0"  ];
  arm [label="ARM926 (270 MHz max), SCLK and HCLK bus clocks\nsysmode SC_CTRL[2:0]; arm_hclk_sel SC_PERCTRL2[7]", fillcolor="#e0b86f"  ];
  ip [label="IP clock selects: SC_PERCTRL2 / SC_PERCTRL3", fillcolor="#a6c98f"  ];
  gate [label="Clock gating: SC_PEREN / SC_PERDIS", fillcolor="#9aa7e6"  ];
  usbphy [label="USB 2.0 OTG PHY\n(XIN24 input)", fillcolor="#8fb3de"  ];
  eth [label="ETH MAC clocks", fillcolor="#8fb3de"  ];
  pci [label="PCI clock (PCICLK pad)", fillcolor="#8fb3de"  ];
  xin -> apll [label="XIN"];
  apll -> arm;
  apll -> ip [label="divided"];
  xin -> usbphy [label="XIN24"];
  viclk -> ip;
  ethclk -> eth;
  ip -> gate;
  arm -> gate;
}
