// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3512v100-resets" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3511 / Hi3512: reset tree</B><BR/><FONT POINT-SIZE="11">data sheet 3.1 (same scheme as the Hi3520; PCIRSTN for the PCI block)</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  pin [label="RSTN pin", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  por [label="RSTN low pulse\nand stable crystal", fillcolor="#d6d27a"   shape=diamond];
  npor [label="npor\nglobal hard reset:\nall logic", fillcolor="#e0b86f"  ];
  sysc [label="System controller\nglobal soft reset in the system controller", fillcolor="#9aa7e6"  ];
  sysrst [label="sys_rst_n\nglobal soft reset:\nall modules except the clock/reset circuits\nand test logic", fillcolor="#e0b86f"  ];
  crg [label="system controller\nper-module soft reset bits", fillcolor="#9aa7e6"  ];
  xx [label="xx_rst_n\nper-module soft reset\n(held until the bit is cleared)", fillcolor="#8fb3de"  ];
  pci [label="PCIRSTN pin\n(PCI slave mode)", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  pcirst [label="PCI block reset", fillcolor="#8fb3de"  ];
  pin -> por;
  por -> npor;
  sysc -> sysrst [label="srst_req"];
  crg -> xx [label="xx_rst_req"];
  npor -> sysrst [label="also resets"];
  npor -> xx [label="also resets"];
  pci -> pcirst;
}
