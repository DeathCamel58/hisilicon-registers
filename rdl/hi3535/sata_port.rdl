        field {
            name = "link_rx_fifo_full";
            desc = "Link receive FIFO full flag.
- 0: FIFO not full;
- 1: FIFO full.";
            sw = r; hw = w;
            reset = 0x0;
        } link_rx_fifo_full[14:14];
        field {
