            reset = 0x0;
        } txdmac_cur_state[27:24];
        field {
            name = "txdmac_prd_i";
            desc = "The \"I\" bit in the entry of the PRD list in SATA_TX_DAMC.";
            sw = r; hw = w;
            reset = 0x0;
        } txdmac_prd_i[23:23];
        field {
