            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_19[31:19];
        field {
            name = "px_reset";
            desc = "SerDes lane reset signal, asynchronous reset, active high.";
            sw = rw; hw = r;
            reset = 0x0;
        } px_reset[18:18];
        field {
            name = "px_tx_preemph_gen3";
            desc = "Transmit pre-emphasis control in Gen3 mode.";
            sw = rw; hw = r;
            reset = 0x20;
        } px_tx_preemph_gen3[17:12];
        field {
            name = "px_tx_preemph_gen2";
            desc = "Transmit pre-emphasis control in Gen2 mode.";
            sw = rw; hw = r;
            reset = 0x15;
        } px_tx_preemph_gen2[11:6];
        field {
            name = "px_tx_preemph_gen1";
            desc = "Transmit pre-emphasis control in Gen1 mode.";
            sw = rw; hw = r;
            reset = 0x15;
        } px_tx_preemph_gen1[5:0];
    } SATA_PORT_PHYCTL2 @ 0x4c;
    reg {
        name = "SATA_PORT_HBA";
        desc = "SATA_PORT_HBA is the HBA test status register. SATA_PORT_HBA (offset 0x050+n x 0x80, total reset 0x0100_0000; PROVEN: Hi3535 data sheet, PDF page 1403, section 13.8.7.2). Per-instance register (offset = 0x050+n x 0x80); the first instance is modelled.";
        field {
