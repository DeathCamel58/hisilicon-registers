        } cfis_curr_st[15:12];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_11_11[11:11];
        field {
            name = "pio_curr_st";
            desc = "Current state of the HBA_PIO_STATE state machine.";
            sw = r; hw = w;
            reset = 0x0;
        } pio_curr_st[10:8];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_7[7:7];
        field {
            name = "pm_curr_st";
            desc = "Current state of the HBA_PM_STATE state machine.";
            sw = r; hw = w;
