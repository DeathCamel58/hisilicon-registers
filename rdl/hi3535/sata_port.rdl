            sw = r; hw = w;
            reset = 0x0;
        } phy_cominit[2:2];
        field {
            name = "half_rate";
            desc = "PHY operating rate mode.
- 0: Full-speed mode;
- 1: Half-speed mode;";
            sw = r; hw = w;
            reset = 0x1;
        } half_rate[1:1];
        field {
            name = "phyrdy";
            desc = "When 1, indicates that the PHY is now operating normally.";
            sw = r; hw = w;
            reset = 0x0;
        } phyrdy[0:0];
    } SATA_PORT_PHYSTS @ 0x78;
};

