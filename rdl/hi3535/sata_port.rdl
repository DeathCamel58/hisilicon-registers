    } SATA_PORT_DMA1 @ 0x58;
    reg {
        name = "SATA_PORT_DMA2";
        desc = "SATA_PORT_DMA2 is DMAC test status register 2. SATA_PORT_DMA2 (offset 0x05C+n x 0x80, total reset 0x0020_0000; PROVEN: Hi3535 data sheet, PDF page 1406, section 13.8.7.2). Per-instance register (offset = 0x05C+n x 0x80); the first instance is modelled.";
        field {
