    } SATA_PORT_LINK @ 0x54;
    reg {
        name = "SATA_PORT_DMA1";
        desc = "SATA_PORT_DMA1 is DMAC test status register 1. SATA_PORT_DMA1 (offset 0x058+n x 0x80, total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 1405, section 13.8.7.2). Per-instance register (offset = 0x058+n x 0x80); the first instance is modelled.";
        field {
