        field {
            name = "tx_data_fis_cnt";
            desc = "Down counter in SATA_TX_DMAC, indicating the number of Data FIS bytes during PIO, Legacy DMA, and First Party DMA operations. For PIO operations its initial value is the transcount in PIO Setup; for Legacy DMA or First Party DMA operations its initial value is 0x2000";
            sw = r; hw = w;
            reset = 0x2000;
        } tx_data_fis_cnt[23:8];
        field {
            name = "tx_cmdh_prdtl";
            desc = "Down counter in the SATA_TX_DMAC: parameter in the Command Header indicating how many Entries are in the PRDT.";
            sw = r; hw = w;
            reset = 0x0;
        } tx_cmdh_prdtl[7:0];
    } SATA_PORT_DMA2 @ 0x5c;
    reg {
        name = "SATA_PORT_DMA3";
        desc = "SATA_PORT_DMA3 is DMAC test status register 3. SATA_PORT_DMA3 (offset 0x060+n x 0x80, total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 1406, section 13.8.7.2). Per-instance register (offset = 0x060+n x 0x80); the first instance is modelled.";
        field {
            name = "tx_fpdma_tran_cnt";
            desc = "Down counter in the SATA_TX_DMAC, indicating the number of Data FIS bytes during a First Party DMA operation. Its initial value is the transcount in the DMA Setup.";
            sw = r; hw = w;
            reset = 0x0;
        } tx_fpdma_tran_cnt[31:0];
    } SATA_PORT_DMA3 @ 0x60;
    reg {
        name = "SATA_PORT_DMA4";
        desc = "SATA_PORT_DMA4 is DMAC test status register 4. SATA_PORT_DMA4 (offset 0x064+n x 0x80, total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 1407, section 13.8.7.2). Per-instance register (offset = 0x064+n x 0x80); the first instance is modelled.";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_28[31:28];
        field {
            name = "rxdmac_cur_state";
            desc = "Current state machine signal of SATA_RX_DMAC.";
            sw = r; hw = w;
            reset = 0x0;
        } rxdmac_cur_state[27:24];
        field {
            name = "rxdmac_prd_i";
            desc = "The \"I\" bit in the entry of the PRD list in SATA_RX_DAMC.";
            sw = r; hw = w;
            reset = 0x0;
        } rxdmac_prd_i[23:23];
        field {
            name = "rx_entry_dbc_cnt";
            desc = "Down counter in the SATA_RX_DMAC: number of data bytes in the Entry currently in use.";
            sw = r; hw = w;
            reset = 0x0;
        } rx_entry_dbc_cnt[22:0];
    } SATA_PORT_DMA4 @ 0x64;
    reg {
        name = "SATA_PORT_DMA5";
        desc = "SATA_PORT_DMA5 is DMAC test status register 5. SATA_PORT_DMA5 (offset 0x068+n x 0x80, total reset 0x0020_0000; PROVEN: Hi3535 data sheet, PDF page 1407, section 13.8.7.2). Per-instance register (offset = 0x068+n x 0x80); the first instance is modelled.";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_24[31:24];
        field {
            name = "rx_data_fis_cnt";
            desc = "Down counter in SATA_RX_DMAC, indicating the number of Data FIS bytes during PIO, Legacy DMA, and First Party DMA operations. For PIO operations, its initial value is the transcount in the PIO Setup; for Legacy DMA or First Party DMA operations, its initial value is 0x2000";
            sw = r; hw = w;
            reset = 0x2000;
        } rx_data_fis_cnt[23:8];
        field {
            name = "rx_cmdh_prdtl";
            desc = "Down counter in the SATA_RX_DMAC, a parameter in the Command Header, indicating how many entries are in the PRDT.";
            sw = r; hw = w;
            reset = 0x0;
        } rx_cmdh_prdtl[7:0];
    } SATA_PORT_DMA5 @ 0x68;
    reg {
        name = "SATA_PORT_DMA6";
        desc = "SATA_PORT_DMA6 is DMAC test status register 6. SATA_PORT_DMA6 (offset 0x6C+n x 0x80, total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 1408, section 13.8.7.2). Per-instance register (offset = 0x6C+n x 0x80); the first instance is modelled.";
        field {
            name = "rx_fpdma_tran_cnt";
            desc = "Down counter in the SATA_RX_DMAC, indicating the number of Data FIS bytes during a First Party DMA operation. Its initial value is the transcount value in the DMA Setup.";
            sw = r; hw = w;
            reset = 0x0;
        } rx_fpdma_tran_cnt[31:0];
    } SATA_PORT_DMA6 @ 0x6c;
    reg {
        name = "SATA_PORT_DMA7";
        desc = "SATA_PORT_DMA7 is DMAC test status register 7. SATA_PORT_DMA7 (offset 0x070+n x 0x80, total reset 0x0005_0000; PROVEN: Hi3535 data sheet, PDF page 1408, section 13.8.7.2). Per-instance register (offset = 0x070+n x 0x80); the first instance is modelled.";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_22[31:22];
        field {
            name = "pio_op";
            desc = "PIO operation indication.
- 0: The current command is not a PIO operation.
- 1: The current command is a PIO operation.";
            sw = r; hw = w;
            reset = 0x0;
        } pio_op[21:21];
        field {
            name = "fpdma_op";
            desc = "First Party DMA operation indication.
- 0: The current command is not a First Party DMA operation;
- 1: The current command is a First Party DMA operation.";
            sw = r; hw = w;
            reset = 0x0;
        } fpdma_op[20:20];
        field {
            name = "dmac_rx_fifo_full";
            desc = "SATA_DMAC_RX_FIFO full status.
- 0: FIFO not full.
- 1: FIFO full.";
            sw = r; hw = w;
            reset = 0x0;
        } dmac_rx_fifo_full[19:19];
        field {
            name = "dmac_rx_fifo_empty";
            desc = "SATA_DMAC_RX_FIFO empty status.
- 0: FIFO not empty;
- 1: FIFO empty.";
            sw = r; hw = w;
            reset = 0x1;
        } dmac_rx_fifo_empty[18:18];
        field {
            name = "dmac_tx_fifo_full";
            desc = "SATA_DMAC_TX_FIFO full status.
- 0: FIFO not full;
- 1: FIFO full.";
            sw = r; hw = w;
            reset = 0x0;
        } dmac_tx_fifo_full[17:17];
        field {
            name = "dmac_tx_fifo_empty";
            desc = "SATA_DMAC_TX_FIFO empty status.
- 0: FIFO not empty;
- 1: FIFO empty.";
            sw = r; hw = w;
            reset = 0x1;
        } dmac_tx_fifo_empty[16:16];
        field {
            name = "dmac_rx_fifo_cnt";
            desc = "Number of data entries in SATA_DMAC_RX_FIFO, in DWORDs.";
            sw = r; hw = w;
            reset = 0x0;
        } dmac_rx_fifo_cnt[15:8];
        field {
            name = "dmac_tx_fifo_cnt";
            desc = "Number of data items in the SATA_DMAC_TX_FIFO, in DWORDs.";
            sw = r; hw = w;
            reset = 0x0;
        } dmac_tx_fifo_cnt[7:0];
    } SATA_PORT_DMA7 @ 0x70;
    reg {
        name = "SATA_PORT_PHYCTL";
        desc = "SATA_PORT_PHYCTL is the PHY control register. SATA_PORT_PHYCTL (offset 0x074+n x 0x80, total reset 0x0E24_0000; PROVEN: Hi3535 data sheet, PDF page 1409, section 13.8.7.2). Per-instance register (offset = 0x074+n x 0x80); the first instance is modelled.";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_29[31:29];
        field {
            name = "phy_disable";
            desc = "Whether to use the PHY.
- 0: Use the PHY;
- 1: Do not use the PHY.";
            sw = rw; hw = r;
            reset = 0x0;
        } phy_disable[28:28];
        field {
            name = "phy_calibrated";
            desc = "Whether to calibrate the PHY.
- 0: Do not calibrate;
- 1: Calibrate.";
            sw = rw; hw = r;
            reset = 0x1;
        } phy_calibrated[27:27];
        field {
            name = "spd_change_ack";
            desc = "Whether speed switching is allowed.
- 0: Speed switching is not allowed.
- 1: Speed switching is allowed.";
            sw = rw; hw = r;
            reset = 0x1;
        } spd_change_ack[26:26];
        field {
            name = "dp_rdy";
            desc = "Whether the PHY is ready to send data.
- 0: Not ready;
- 1: Ready.";
            sw = rw; hw = r;
            reset = 0x1;
        } dp_rdy[25:25];
        field {
            name = "bist_tx_fspd";
            desc = "BIST mode forced transmit clock frequency.
- 0: Not forced.
- 1: Forced.";
            sw = rw; hw = r;
            reset = 0x0;
        } bist_tx_fspd[24:24];
        field {
            name = "neg_mode_b";
            desc = "Negotiation mode B select.
- 0: Not supported;
- 1: Supported.";
            sw = rw; hw = r;
            reset = 0x0;
        } neg_mode_b[23:23];
        field {
            name = "gen2_en";
            desc = "Transmit control signal, whether 3G mode is allowed.
- 00: 1.5G mode supported;
- 01: 3G mode supported;
- 10: 6G mode supported;
- 11: Reserved;";
            sw = rw; hw = r;
            reset = 0x1;
        } gen2_en[22:21];
        field {
            name = "speed_ctrl";
            desc = "Speed support mode control.
- 0: Select hardware auto-negotiation.
- 1: Select software control.";
            sw = rw; hw = r;
            reset = 0x0;
        } speed_ctrl[20:20];
        field {
            name = "rx_dpll_mode";
            desc = "Which rate profile the PHY currently selects.
- 00: 1.5G profile;
- 01: 3.0G profile;
- 10: 6.0G profile;
- 11: Reserved.";
            sw = rw; hw = r;
            reset = 0x1;
        } rx_dpll_mode[19:18];
        field {
            name = "half_rate";
            desc = "Software forced speed.
- 00: Force 1.5G mode;
- 01: Force 3G mode, provided the Device supports 3G or above;
- 10: Force 6G mode, provided the Device supports 6G;
- 11: Reserved.";
            sw = rw; hw = r;
            reset = 0x0;
        } half_rate[17:16];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_15_0[15:0];
    } SATA_PORT_PHYCTL @ 0x74;
    reg {
        name = "SATA_PORT_PHYSTS";
        desc = "SATA_PORT_PHYSTS is the PHY test status register. SATA_PORT_PHYSTS (offset 0x078+nx0x80, total reset 0x0000_0002; PROVEN: Hi3535 data sheet, PDF page 1411, section 13.8.7.2). Per-instance register (offset = 0x078+nx0x80); the first instance is modelled.";
        field {
            name = "reserved";
