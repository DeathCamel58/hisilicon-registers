            reset = 0x0;
        } err_curr_st[3:0];
    } SATA_PORT_HBA @ 0x50;
    reg {
        name = "SATA_PORT_LINK";
        desc = "SATA_PORT_LINK is the Link test status register. SATA_PORT_LINK (offset 0x054+n x 0x80, total reset 0x0020_2020; PROVEN: Hi3535 data sheet, PDF page 1404, section 13.8.7.2). Per-instance register (offset = 0x054+n x 0x80); the first instance is modelled.";
        field {
