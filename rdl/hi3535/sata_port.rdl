            reset = 0x0;
        } ln_cominit_det[23:23];
        field {
            name = "ln_comwake_det";
            desc = "OOB Comwake detect signal.";
            sw = r; hw = w;
            reset = 0x0;
        } ln_comwake_det[22:22];
        field {
            name = "ln_sig_level_valid_";
            desc = "Signal level valid indication, asynchronous, directly from the analog signal detector.
- 0: No signal is detected on the lnX_rxp_i/lnX_rxm_i pins.
- 1: A signal is detected on the lnX_rxp_i/lnX_rxm_i pins.";
            sw = r; hw = w;
            reset = 0x0;
        } ln_sig_level_valid[21:21];
        field {
            name = "ln_ok";
            desc = "Lane OK indication.";
            sw = r; hw = w;
            reset = 0x0;
        } ln_ok[20:20];
        field {
            name = "ln_runlen_err";
            desc = "Run length error indication.";
            sw = r; hw = w;
            reset = 0x0;
        } ln_runlen_err[19:19];
        field {
            name = "ln_ebuf_stat";
            desc = "Elastic Buffer status indication.
- 000: No error.
- 001: Underflow.
- 010: Overflow.
- 011: SKP added.
- 100: SKP removed. Others: Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } ln_ebuf_stat[18:16];
        field {
            name = "ln_dec_disp_err";
            desc = "8B/10B decode disparity error indication. [0] corresponds to lnX_rxdata_i[9:0], [1] corresponds to lnX_rxdata_i[19:10].";
            sw = r; hw = w;
            reset = 0x0;
        } ln_dec_disp_err[15:14];
        field {
            name = "ln_dec_err";
            desc = "8B/10B decode error indication. [0] corresponds to lnX_rxdata_i[9:0], [1] corresponds to lnX_rxdata_i[19:10].";
            sw = r; hw = w;
            reset = 0x0;
        } ln_dec_err[13:12];
        field {
            name = "ln_rx_locked";
            desc = "Rx lock indication, indicating that the symbol alignment logic has locked onto the data and the data is valid. [0] corresponds to lnX_rxdata_i[9:0], [1] corresponds to lnX_rxdata_i[19:10].";
            sw = r; hw = w;
            reset = 0x0;
        } ln_rx_locked[11:10];
        field {
            name = "ln_k28p5_det";
            desc = "K28.5 detection indication. [0] corresponds to lnX_rxdata_i[9:0], [1] corresponds to lnX_rxdata_i[19:10].
- 00: Not a K28.5 word;
- 01: The word is a K28.5 word.";
            sw = r; hw = w;
            reset = 0x0;
        } ln_k28p5_det[9:8];
        field {
            name = "spd_change";
            desc = "Requested conversion rate.";
            sw = r; hw = w;
            reset = 0x0;
        } spd_change[7:7];
        field {
            name = "link_rdy";
            desc = "When 1, indicates that enough D10.2 have been sent.";
            sw = r; hw = w;
            reset = 0x0;
        } link_rdy[6:6];
        field {
            name = "init_compl";
            desc = "When 1, indicates that a non-ALIGN primitive was received and initialization is complete.";
            sw = r; hw = w;
            reset = 0x0;
        } init_compl[5:5];
        field {
            name = "pwr_state";
            desc = "When 1, indicates a low-power mode (partial or slumber); otherwise the Active state.";
            sw = r; hw = w;
            reset = 0x0;
        } pwr_state[4:4];
        field {
            name = "phy_comwake";
            desc = "When 1, indicates that the PHY detected COMWAKE.";
            sw = r; hw = w;
            reset = 0x0;
