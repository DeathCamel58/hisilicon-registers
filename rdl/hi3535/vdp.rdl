    } G0_IRESO @ 0x6020;
    reg {
        name = "G0_SFPOS";
        desc = "G0_SFPOS is the start position, in the source bitmap, of the data that the surface needs to read; not an immediate register. When the read position is not 128-bit-word aligned, this register indicates the number of pixels needed to complete the whole 128-bit-word. Note: The start position offset must not exceed one 128-bit-word; the part beyond a 128-bit-word is represented by the address. The calculation is as follows. Let the start address of the original graphics layer be addr_ori, the graphics layer address configured to the logic be addr_offset, the offset of the graphics layer be offsetp pixels, and the data format of the graphics layer be bpp (for example, bpp=32 for ARGB8888). Then G0ADDR=addr_offset = addr_ori + int(offsetp*bpp/128); G0SFPOS=offset%128; where int denotes the integer (truncation) operation and % denotes the modulo operation. G0_SFPOS (offset 0x6024, total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 1063, section 5.10).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_7[31:7];
        field {
            name = "src_xfpos";
            desc = "Source start X coordinate; 0 is the first pixel of a line.";
            sw = rw; hw = r;
            reset = 0x0;
        } src_xfpos[6:0];
    } G0_SFPOS @ 0x6024;
    reg {
        name = "G0_CBMPARA";
