    reg {
        name = "DATE_COEFF0";
        desc = "DATE_COEFF0 is the video standard parameter configuration register. DATE_COEFF0 (offset 0xF200, total reset 0x5284_14FC; PROVEN: Hi3535 data sheet, PDF page 1129, section 5.10).";
        field {
            name = "clpf_sel";
            desc = "Chroma low-pass filter bandwidth selection.
- 00: 1.1MHz bandwidth (NTSC);
- 01: 1.3MHz bandwidth (PAL);
- 10: 1.6MHz bandwidth (test);
- 11: Reserved.";
            sw = rw; hw = r;
            reset = 0x1;
        } clpf_sel[31:30];
        field {
            name = "dis_ire";
            desc = "For the (M)NTSC and (M,N)PAL standards, the black level is 7.5IRE above the blanking level; for other standards, the black level equals the blanking level. This bit controls whether the black level should be 7.5IRE above the blanking level.
- 0: The black level is 7.5IRE above the blanking level.
- 1: The black level equals the blanking level.";
            sw = rw; hw = r;
            reset = 0x0;
        } dis_ire[29:29];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x1;
        } reserved_28_28[28:28];
        field {
            name = "pal_half_en";
            desc = "PAL half-line reduction enable.
- 0: Disable;
- 1: Enable.";
            sw = rw; hw = r;
            reset = 0x0;
        } pal_half_en[27:27];
        field {
            name = "pbpr_lpf_en";
            desc = "Component chroma low-pass filter enable.
- 0: Disable;
- 1: Enable.";
            sw = rw; hw = r;
            reset = 0x0;
        } pbpr_lpf_en[26:26];
        field {
            name = "scanline";
            desc = "Set according to the number of scan lines per frame in the different standards. For (M)NTSC, NTSC-J and (M)PAL, each frame contains 525 lines; for (B, D, J, H, I)PAL, (N)PAL and (Nc)PAL, each frame contains 625 lines.
- 0: 525 lines per frame;
- 1: 625 lines per frame.";
            sw = rw; hw = r;
            reset = 0x1;
        } scanline[25:25];
        field {
            name = "rgb_en";
            desc = "When intf_sel is configured as 100, this bit selects whether the component signal uses RGB or YPbPr.
- 0: The component signal uses YPbPr;
- 1: The component signal uses RGB.";
            sw = rw; hw = r;
            reset = 0x0;
        } rgb_en[24:24];
        field {
            name = "vbi_lpf_en";
            desc = "Vbi data low-pass filter enable control.
- 0: No filtering;
- 1: Filtering.";
            sw = rw; hw = r;
            reset = 0x1;
        } vbi_lpf_en[23:23];
        field {
            name = "fm_sel";
            desc = "FMsecam frequency modulation selection.
- 0: secam frequency modulation uses sin;
- 1: secam frequency modulation uses cos.";
            sw = rw; hw = r;
            reset = 0x0;
        } fm_sel[22:22];
        field {
            name = "style_sel";
            desc = "Used together with scanline to set the standard of the CVBS/S-Video output signal. When scanline is 0, that is, each frame contains 525 lines, the meanings are as follows:
- 0001: (M)NTSC standard.
- 0010: NTSC-J standard.
- 0100: (M)PAL standard. When scanline is 1, that is, each frame contains 625 lines, the meanings are as follows:
- 0001: (B, D, G, H, I)PAL standard.
- 0010: (N)PAL standard.
- 0100: (Nc)PAL standard.
- 1000: SECAM standard.";
            sw = rw; hw = r;
            reset = 0x1;
        } style_sel[21:18];
        field {
            name = "sync_mode_sel";
            desc = "The high bit specifies whether the component output must include the sync signal on all three channels; this control bit takes effect only when sync_mode_scart is configured to 0. The high bit is valid only when intf_sel is set to 100, that is, with component output, with the following meaning:
- 0: For component output, only one channel includes the sync signal;
- 1: For component output, all three channels include the sync signal. When this bit is set to 0, the sync channel can only be the Y channel for YPbPr output, and only the G channel for RGB output. The low bit specifies whether the RGB output has a blanking pedestal. The low bit is valid only when intf_sel is set to 100 and rgb_en is set to 1, with the following meaning:
- 0: No blanking pedestal for RGB output;
- 1: Blanking pedestal for RGB output.";
            sw = rw; hw = r;
            reset = 0x0;
        } sync_mode_sel[17:16];
        field {
            name = "sync_mode_scart";
            desc = "This bit indicates that none of the 3 component channels has sync superimposed.
- 0: The component sync output follows the sync_mode_sel[1] configuration.
- 1: None of the 3 component channels has sync superimposed; in this case sync_mode_sel[1] must be configured as 0.";
            sw = rw; hw = r;
            reset = 0x0;
        } sync_mode_scart[15:15];
        field {
            name = "length_sel";
            desc = "Specifies the active line width, in pixels, of each video line.
- 0: Output with the active line pixel width of BT.601 mode;
- 1: Output with the active line pixel width of BT.470 mode. When this bit is 0, the active line width is 720 pixels. When this bit is 1, the active line width is 704 pixels for the 625-line standard and 712 pixels for the 525-line standard. The current version does not support dynamic switching between BT601 mode and BT470 mode; configure it as needed after reset and do not change the configuration afterward. A fixed BT601 configuration, that is, the power-on reset value, is recommended.";
            sw = rw; hw = r;
            reset = 0x0;
        } length_sel[14:14];
        field {
            name = "agc_amp_sel";
            desc = "- 0: Generate the AGC pulse using the on-chip default value (recommended);
- 1: Generate the AGC pulse using the off-chip configuration.

DATE_COEFF1[amp_outside].";
            sw = rw; hw = r;
            reset = 0x0;
        } agc_amp_sel[13:13];
        field {
            name = "luma_dl";
            desc = "Shift of the chroma signal ahead of or behind the luma signal, in units of half a pixel width. The most significant bit indicates the direction of the chroma shift relative to luma.
- 0: The chroma signal lags the luma signal.
- 1: The chroma signal leads the chroma signal. The low 3 bits indicate the absolute value of the chroma shift relative to luma, in binary, ranging from 0 to 7.
- 000: Chroma is aligned with luma, no adjustment. 001 to 111: The chroma signal leads or lags the luma signal by 1 to 7 units.";
            sw = rw; hw = r;
            reset = 0xa;
        } luma_dl[12:9];
        field {
            name = "reserved";
            desc = "Reserved. Writes have no effect; reads return 0.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_8_8[8:8];
        field {
            name = "oversam_en";
            desc = "First-stage oversampling switch control bits, including the luma oversampling switch control bit and the chroma oversampling switch control bit. The high bit is the luma oversampling switch control bit.
- 0: Luma oversampling off;
- 1: Luma oversampling on. The low bit is the chroma oversampling switch control bit.
- 0: Chroma oversampling off;
- 1: Chroma oversampling on.";
            sw = rw; hw = r;
            reset = 0x3;
