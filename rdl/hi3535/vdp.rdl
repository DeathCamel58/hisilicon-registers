regfile eHI3535_VDP {
    name = "Video display processor (VDP)";
    desc = "Video display processor (VDP). 322 registers extracted programmatically from the Hi3535 H.264 codec processor (Hi3535 user guide) data sheet (Issue 00B08, 2014-02-25); chapter 11.5, table 11-1. Field names, bit ranges, access types and reset values are taken from the register tables; reset values are the data sheet total reset values split onto the fields (per-field values where the table has them). Label: PROVEN. Hardware not verified here (no board).";
    reg {
        name = "VOCTRL";
        desc = "VOCTRL is the VO control register. Surface bus request arbitration mode. VOCTRL (offset 0x0000, total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 972, section 11.5).";
        field {
            name = "vo_ck_gt_en";
            desc = "VDP clock gate enable.
- 0: Clock gate off;
- 1: The internal clock gate of the VDP is on.";
            sw = rw; hw = r;
            reset = 0x0;
        } vo_ck_gt_en[31:31];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_30_4[30:4];
        field {
            name = "m0_arb_mode";
            desc = "Arbitration mode for bus data requests of the surfaces inside VO MAC0.
- 0000: Round robin;
- 0001: Graphics layer first;
Other values: reserved.";
            sw = rw; hw = r;
            reset = 0x0;
        } m0_arb_mode[3:0];
    } VOCTRL @ 0x0;
