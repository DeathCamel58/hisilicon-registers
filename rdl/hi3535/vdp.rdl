    reg {
        name = "INTF_DITHER0_CTRL";
        desc = "INTF_DITHER0_CTRL is the interface processing Dither control register. INTF_DITHER0_CTRL (offset 0xD080, total reset 0x2000_0000; PROVEN: Hi3535 data sheet, PDF page 1127, section 5.10).";
        field {
            name = "dither_md";
            desc = "Dither mode select register.
- 000: 12-bit input, 10-bit output, no dither, direct truncation;
- 001: 12-bit input, 10-bit output, temporal dither;
- 010: 12-bit input, 10-bit output, spatial dither;
- 011: 12-bit input, 8-bit output, temporal and spatial dither;
- 100: 12-bit input, 10-bit output, rounding;
- 101: 12-bit input, 8-bit output, rounding.";
            sw = rw; hw = r;
            reset = 0x1;
        } dither_md[31:29];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_28_0[28:0];
    } INTF_DITHER0_CTRL @ 0xd080;
    reg {
