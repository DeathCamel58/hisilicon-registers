    reg {
        name = "WBC_DHD0_ZME_VOFFSET";
        desc = "WBC_DHD0_ZME_VOFFSET is the vertical scaling offset (Vertical Scaling Offset) register. The vertical scaling offset is affected by two factors: pan-scan and the field offset when frames are repeated. When there is no field offset, vluma_offset is the lowest integer bits plus the fractional bits of offset_pan-scan; in YCbCr422 format, vchroma_offset equals vluma_offset; in YCbCr420 format, vchroma_offset = scaling_chroma/2-0.25. When a field offset is needed (for example, a still frame or repeated frames), assuming the bottom field is repeated, the vluma_offset and vchroma_offset configured for the top field are the same as in the no-offset case above, and the bottom field configuration must take the field offset into account. WBC_DHD0_ZME_VOFFSET (offset 0xAEE0, total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 1095, section 5.10).";
        field {
            name = "vluma_offset";
            desc = "Vertical luma offset, two's complement representation, (s,4,12) format.";
            sw = rw; hw = r;
            reset = 0x0;
        } vluma_offset[31:16];
        field {
            name = "vchroma_offset";
            desc = "Vertical chroma offset, two's complement, (s,4,12) format.";
            sw = rw; hw = r;
            reset = 0x0;
        } vchroma_offset[15:0];
    } WBC_DHD0_ZME_VOFFSET @ 0xaee0;
    reg {
        name = "WBC_DHD0_ZME_VBOFFSET";
        desc = "WBC_DHD0_ZME_VBOFFSET is the bottom field Vertical Scaling Offset register. The vertical scaling offset is affected by two factors: pan-scan and the field offset when frames are repeated. When there is no field offset, vluma_offset is the lowest integer bits plus the fractional bits of offset_pan-scan; in YCbCr422 format vchroma_offset equals vluma_offset; in YCbCr420 format, vchroma_offset = scaling_chroma/2-0.25. When a field offset is needed (for example, a still frame or repeated frame), assuming the bottom field is repeated, the vluma_offset and vchroma_offset configured for the top field are the same as in the no-offset case above, and the bottom field configuration must account for the field offset. WBC_DHD0_ZME_VBOFFSET (offset 0xAEE4, total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 1096, section 5.10).";
        field {
