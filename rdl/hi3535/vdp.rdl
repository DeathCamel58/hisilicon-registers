            desc = "DAC3 output select (default 0x0).
- 0x0: DAC3 outputs CVBS video (SDATE).
- 0x1: DAC3 outputs the Y/R component of standard-definition analog video (SDATE).
- 0x2: DAC3 outputs the Cb/G component of standard-definition analog video (SDATE).
- 0x3: DAC3 outputs the Cr/B component of standard-definition analog video (SDATE).
- 0x4: DAC3 outputs the Y/R component of high-definition analog video (HDATE).
- 0x5: DAC3 outputs the Cb/G component of high-definition analog video (HDATE).
- 0x6: DAC3 outputs the Cr/B component of high-definition analog video (HDATE).
- 0x7: DAC3 outputs the R component of VGA video.
- 0x8: DAC3 outputs the G component of VGA video.
- 0x9: DAC3 outputs the B component of VGA video.";
            sw = rw; hw = r;
            reset = 0x6;
        } dac3_sel[15:12];
        field {
            name = "dac2_sel";
            desc = "DAC2 output selection (default 0x0).
- 0x0: DAC2 outputs CVBS video (SDATE);
- 0x1: DAC2 outputs the standard-definition analog video Y/R component (SDATE);
- 0x2: DAC2 outputs the standard-definition analog video Cb/G component (SDATE);
- 0x3: DAC2 outputs the standard-definition analog video Cr/B component (SDATE);
- 0x4: DAC2 outputs the high-definition analog video Y/R component (HDATE);
- 0x5: DAC2 outputs the high-definition analog video Cb/G component (HDATE);
- 0x6: DAC2 outputs the high-definition analog video Cr/B component (HDATE);
- 0x7: DAC2 outputs the VGA video R component;
- 0x8: DAC2 outputs the VGA video G component;
- 0x9: DAC2 outputs the VGA video B component.";
            sw = rw; hw = r;
            reset = 0x5;
        } dac2_sel[11:8];
        field {
            name = "dac1_sel";
