            sw = rw; hw = r;
            reset = 0x0;
        } vchroma_offset[15:0];
    } V0_VOFFSET @ 0x8e0;
    reg {
        name = "V0_VBOFFSET";
        desc = "V0_VBOFFSET is the bottom field vertical scaling offset (Vertical Scaling Offset) register. The vertical scaling offset is affected by two factors: pan-scan and the field offset when frames are repeated. When there is no field offset, vluma_offset is the lowest integer bit plus the fraction bits of offset_pan-scan; in YCbCr422 format, vchroma_offset equals vluma_offset; in YCbCr420 format, vchroma_offset = scaling_chroma/2-0.25. When a field offset is needed (for example for a still frame or repeated frame), assuming the bottom field is repeated, the vluma_offset and vchroma_offset configured for the top field are the same as in the no-offset case above, and the bottom field configuration must take the field offset into account. V0_VBOFFSET (offset 0x08E4, total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 1013, section 5.10).";
