        field {
            name = "dma_sar_low";
            desc = "Source address of the DMA transfer (low 32 bits). Before a DMA transfer, write the start address of the source data to this register; the DMA channel fetches the data to be transferred from this address. During the DMA transfer, the value of this register increments automatically. The low 2 bits of this register must be 0.";
            sw = rw; hw = r;
            reset = 0x0;
        } dma_sar_low[31:0];
    } DMA_SAR_LOW @ 0xa7c;
