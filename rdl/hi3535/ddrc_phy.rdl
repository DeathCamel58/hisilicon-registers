    reg {
        name = "PACK_DRAMTMR3";
        desc = "PACK_DRAMTMR3 is DRAM timing parameter register 3. The command delay set in this register applies only to commands issued from within the PHY registers. PACK_DRAMTMR3 (offset 0x03C, total reset 0x0010_0200; PROVEN: Hi3535 data sheet, PDF page 680, section 4.1.8.2).";
