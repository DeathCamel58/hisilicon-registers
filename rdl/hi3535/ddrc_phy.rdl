`ifndef EHI3535_DDRC_PHY_RDL
`define EHI3535_DDRC_PHY_RDL
regfile eHI3535_DDRC_PHY {
    name = "DDRC DDRPHY module";
    desc = "DDRC DDRPHY module. 64 registers extracted programmatically from the Hi3535 H.264 codec processor (Hi3535 user guide) data sheet (Issue 00B08, 2014-02-25); chapter 4.1.8, tables 4-6/4-7. Field names, bit ranges, access types and reset values are taken from the register tables; reset values are the data sheet total reset values split onto the fields (per-field values where the table has them). Label: PROVEN. Hardware not verified here (no board).";
    reg {
        name = "PACK_PHYINITCTRL";
        desc = "PACK_PHYINITCTRL is the PHY initialization control register. Writing this register has no effect when init_en is 1. PACK_PHYINITCTRL (offset 0x004, total reset 0x0000_000E; PROVEN: Hi3535 data sheet, PDF page 669, section 4.1.8.2).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_16[31:16];
        field {
            name = "phyconn_rst";
            desc = "PHY counter reset. This field sets the PHY register reset signal. Set this field to 1 to send the reset signal to the PHY counters; clear it to deassert the reset signal. Note: the reset signal is connected to the A/C block counters and all data block counters.";
            sw = rw; hw = r;
            reset = 0x0;
        } phyconn_rst[15:15];
        field {
            name = "pack_rst";
            desc = "PACK reset. This field resets all digital circuits of the PACK (including the register file). When this field is set, all digital parts of the PHY, including the control registers, return to their default values. The reset is performed automatically, and this field is cleared when the reset ends.";
            sw = rw; hw = r;
            reset = 0x0;
        } pack_rst[14:14];
        field {
            name = "phy_rst";
            desc = "PHY reset. This field sets the PHY reset signal. To send the reset signal to the PHY, set this field to 1; to deassert the reset signal to the PHY, clear this field. Note: The reset signal is connected to the A/C block and all data blocks.";
            sw = rw; hw = r;
            reset = 0x0;
        } phy_rst[13:13];
        field {
            name = "dram_rst";
            desc = "DRAM reset. This field initiates the DRAM reset sequence. When this field is set, the RESET# and CKE signals are driven low for a period (t_dram_rst). After t_dram_rst, RESET# is driven high while CKE stays low for a period, after which CKE is driven high; after t_cke_high, this field is cleared automatically.";
            sw = rw; hw = r;
            reset = 0x0;
        } dram_rst[12:12];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_11_11[11:11];
        field {
            name = "dram_init_en";
            desc = "DRAM initialization enable. This field controls whether the internal DRAM initialization sequence is used after PHY initialization completes.";
            sw = rw; hw = r;
            reset = 0x0;
        } dram_init_en[10:10];
        field {
            name = "wdet_en";
            desc = "Write data eye training enable. Writing 1 to this field starts the write data eye training sequence. The field is cleared after the write data eye training completes.";
            sw = rw; hw = r;
            reset = 0x0;
        } wdet_en[9:9];
        field {
            name = "rdet_en";
            desc = "Read data eye training enable. Writing 1 to this field starts the read data eye training sequence. After read data eye training completes, this field is cleared.";
            sw = rw; hw = r;
            reset = 0x0;
        } rdet_en[8:8];
        field {
            name = "wl2_en";
            desc = "Second write leveling enable. Writing 1 to this field adjusts the write delay. The field clears itself after the adjustment completes. Note: write leveling adjustment applies to DDR3 only.";
            sw = rw; hw = r;
            reset = 0x0;
        } wl2_en[7:7];
        field {
            name = "gdst_en";
            desc = "PHY read data latch training enable. Writing 1 to this field starts read data latch position training. After the write leveling completes, this field is cleared.";
            sw = rw; hw = r;
            reset = 0x0;
        } gdst_en[6:6];
        field {
            name = "gt_en";
            desc = "Gating training enable. Writing 1 to this field starts the gating training sequence. This field is cleared after gating training completes.";
            sw = rw; hw = r;
            reset = 0x0;
        } gt_en[5:5];
        field {
            name = "wl_en";
            desc = "Write leveling enable. Writing 1 to this field starts the write leveling sequence. The field clears itself after write leveling completes. Note: write leveling applies to DDR3 only.";
            sw = rw; hw = r;
            reset = 0x0;
        } wl_en[4:4];
        field {
            name = "zcal_en";
            desc = "Impedance calibration enable. This field specifies whether to perform impedance calibration. The field is cleared after impedance calibration completes.";
            sw = rw; hw = r;
            reset = 0x1;
        } zcal_en[3:3];
        field {
            name = "dlymeas_en";
            desc = "Delay measurement enable. This field specifies whether the initial delay measurement of the read delay line is activated. Setting this field to 1 enables delay measurement.";
            sw = rw; hw = r;
            reset = 0x1;
        } dlymeas_en[2:2];
        field {
            name = "pll_init_en";
            desc = "PLL initialization enable. This field activates PLL initialization. If this field is 1, the PLL is reset and waits for the PLL to lock.";
            sw = rw; hw = r;
            reset = 0x1;
        } pll_init_en[1:1];
        field {
            name = "init_en";
            desc = "PHY initialization enable. Writing 1 to this field triggers the PHY initialization sequence. Bits 1-15 of this register specify the individual initialization operations. After PHY initialization completes, this field is cleared. Note: Writing 0 to this field has no effect.";
            sw = rw; hw = r;
            reset = 0x0;
        } init_en[0:0];
    } PACK_PHYINITCTRL @ 0x4;
    reg {
        name = "PACK_PHYSTS";
        desc = "PACK_PHYSTS is the PHY status register. PACK_PHYSTS (offset 0x008, total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 671, section 4.1.8.2).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_10[31:10];
        field {
            name = "wdet_err";
            desc = "Write data eye calibration error. This field indicates whether an error occurred while calibrating the write data eye. Writing 1 to this field clears the error status. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } wdet_err[9:9];
        field {
            name = "rdet_err";
            desc = "Read data eye calibration error. This field indicates whether an error occurred during read data eye calibration. Writing 1 to this field clears the error status. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } rdet_err[8:8];
        field {
            name = "wl2_err";
            desc = "Write leveling adjustment enable. This field indicates whether an error occurred during write leveling adjustment. Writing 1 to this field clears the error status. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } wl2_err[7:7];
        field {
            name = "gdst_err";
            desc = "PHY read data latch training error. This field indicates whether an error occurred during read data latch training. Writing 1 to this field clears the error status. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } gdst_err[6:6];
        field {
            name = "gt_err";
            desc = "Gate training error. This field indicates whether an error occurred during gate training. Writing 1 to this field clears the error status. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } gt_err[5:5];
        field {
            name = "wl_err";
            desc = "Write leveling error. This field indicates whether an error occurred during write leveling. Writing 1 to this field clears the error status. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } wl_err[4:4];
        field {
            name = "zcal_err";
            desc = "Impedance calibration error. This field indicates whether an error occurred during impedance calibration. Writing 1 to this field clears the error status. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } zcal_err[3:3];
        field {
            name = "dlymeas_err";
            desc = "Delay measurement failure. This field indicates whether an initial delay measurement failed. Writing 1 to this field clears the error status. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } dlymeas_err[2:2];
        field {
            name = "pll_lock_err";
            desc = "PLL lock failure. This field indicates that locking a PLL in the PHY failed after the t_pll_lock timer. Writing 1 to this field clears the error status. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } pll_lock_err[1:1];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_0_0[0:0];
    } PACK_PHYSTS @ 0x8;
    reg {
        name = "PACK_PHYTMR0";
        desc = "PACK_PHYTMR0 is PHY timing parameter register 0. PACK_PHYTMR0 (offset 0x010, total reset 0x0000_000F; PROVEN: Hi3535 data sheet, PDF page 672, section 4.1.8.2).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_8[31:8];
        field {
            name = "t_dram_reset";
            desc = "DDR3 DRAM reset. This field specifies the time for sending the reset signal to the DRAM.";
            sw = rw; hw = r;
            reset = 0xf;
        } t_dram_reset[7:0];
    } PACK_PHYTMR0 @ 0x10;
    reg {
        name = "PACK_PHYTMR1";
        desc = "PACK_PHYTMR1 is PHY timing parameter register 1. PACK_PHYTMR1 (offset 0x014, total reset 0x4000_2000; PROVEN: Hi3535 data sheet, PDF page 673, section 4.1.8.2).";
        field {
            name = "t_dram_cke_high";
            desc = "DRAM CKE high initialization. This field specifies the number of clock cycles from CKE going high to the first DRAM command.";
            sw = rw; hw = r;
            reset = 0x4000;
        } t_dram_cke_high[31:16];
        field {
            name = "t_dram_cke_low";
            desc = "DRAM CKE low initialization. This field specifies the number of clock cycles CKE must be held low after power reset and clock stabilization.";
            sw = rw; hw = r;
            reset = 0x2000;
        } t_dram_cke_low[15:0];
    } PACK_PHYTMR1 @ 0x14;
    reg {
        name = "PACK_PLLCTRL";
        desc = "PACK_PLLCTRL is the PLL address/command and data block timing parameter control register. PACK_PLLCTRL (offset 0x018, total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 673, section 4.1.8.2).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_4[31:4];
        field {
            name = "pll_freq_range";
            desc = "PLL frequency range select. This field specifies the input frequency range of the PLL.";
            sw = rw; hw = r;
            reset = 0x0;
        } pll_freq_range[3:2];
        field {
            name = "pll_pwdn";
            desc = "PLL power-down. This field sets the power-down state of the PLL input. Setting this field to 1 enables the PLL power-down pin. Writing 0 to this field disables the PLL power-down pin.";
            sw = rw; hw = r;
            reset = 0x0;
        } pll_pwdn[1:1];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_0_0[0:0];
    } PACK_PLLCTRL @ 0x18;
    reg {
        name = "PACK_PLLTMR";
        desc = "PACK_PLLTMR is the PLL address/command and data block control register. PACK_PLLTMR (offset 0x01C, total reset 0x4E20_0080; PROVEN: Hi3535 data sheet, PDF page 674, section 4.1.8.2).";
        field {
            name = "t_pll_lock";
            desc = "PLL lock time. This field sets the number of clock cycles to wait for the PLL to lock.";
            sw = rw; hw = r;
            reset = 0x4e20;
        } t_pll_lock[31:16];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_15_8[15:8];
        field {
            name = "t_pll_rst";
            desc = "PLL reset time. This field sets the number of clock cycles for which the reset signal is sent to the PLL.";
            sw = rw; hw = r;
            reset = 0x80;
        } t_pll_rst[7:0];
    } PACK_PLLTMR @ 0x1c;
    reg {
        name = "PACK_DLYMEASCTRL";
        desc = "PACK_DLYMEASCTRL is the read delay line measurement control register. PACK_DLYMEASCTRL (offset 0x020, total reset 0x0000_0471; PROVEN: Hi3535 data sheet, PDF page 674, section 4.1.8.2).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_15[31:15];
        field {
            name = "dly_track_limit";
            desc = "Delay tracking limit. This field sets the maximum cumulative number of taps supported during dynamic tracking.";
            sw = rw; hw = r;
            reset = 0x4;
        } dly_track_limit[14:8];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = rw; hw = r;
            reset = 0x0;
        } reserved_7_7[7:7];
        field {
            name = "phy_autoref_en";
            desc = "PHY auto-refresh tracking enable.";
            sw = rw; hw = r;
            reset = 0x1;
        } phy_autoref_en[6:6];
        field {
            name = "dynamic_dqsen";
            desc = "Dynamic DQS tracking enable.";
            sw = rw; hw = r;
            reset = 0x1;
        } dynamic_dqsen[5:5];
        field {
            name = "dynamic_dqsgen";
            desc = "Dynamic DQSG tracking enable.";
            sw = rw; hw = r;
            reset = 0x1;
        } dynamic_dqsgen[4:4];
        field {
            name = "dynamic_dqsgth";
            desc = "Dynamic DQSG update threshold. This field sets the accumulated number of taps before the RDQSG delay line is updated.";
            sw = rw; hw = r;
            reset = 0x0;
        } dynamic_dqsgth[3:2];
        field {
            name = "dly_track_type";
            desc = "Latency tracking type. This field specifies whether the priority updated from the PHY is used during dynamic tracking. Setting this field to 1 uses the priority updated from the PHY.";
            sw = rw; hw = r;
            reset = 0x0;
        } dly_track_type[1:1];
        field {
            name = "dly_meas_type";
            desc = "Delay measurement type. This field specifies whether the delay measurement is made over 1 clock cycle or half a clock cycle. Setting this field to 1 measures one full clock cycle.";
            sw = rw; hw = r;
            reset = 0x1;
        } dly_meas_type[0:0];
    } PACK_DLYMEASCTRL @ 0x20;
    reg {
        name = "PACK_ZCALCTRL";
        desc = "PACK_ZCALCTRL is the ZQ calibration control register. PACK_ZCALCTRL (offset 0x024, total reset 0x0000_0020; PROVEN: Hi3535 data sheet, PDF page 675, section 4.1.8.2).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_6[31:6];
        field {
            name = "zcomp_rsp_dly";
            desc = "ZQ comparator response time. This field specifies the delay of the zcomp result after zctrl is used.";
            sw = rw; hw = r;
            reset = 0x20;
        } zcomp_rsp_dly[5:0];
    } PACK_ZCALCTRL @ 0x24;
    reg {
        name = "PACK_ZCAL_STATUS";
        desc = "PACK_ZCAL_STATUS is the ZQ calibration result register. PACK_ZCAL_STATUS (offset 0x028, total reset 0x0020_0020; PROVEN: Hi3535 data sheet, PDF page 676, section 4.1.8.2).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_31[31:31];
        field {
            name = "zcode_pdrv_cal";
            desc = "P driver impedance calibration code. This field shows the P driver calibration code during impedance calibration.";
            sw = r; hw = w;
            reset = 0x0;
        } zcode_pdrv_cal[30:24];
        field {
            name = "pdrv_cal_result";
            desc = "P drive calibration result. This field is used to set the ZQ calibration result.
- 0: Calibration completed without error;
- 1: Calibration completed with an error. Writing 1 to this field clears it.";
            sw = r; hw = w;
            reset = 0x0;
        } pdrv_cal_result[23:23];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_22_22[22:22];
        field {
            name = "zcode_pdrv";
            desc = "P drive impedance control code. This field specifies the P drive impedance control code. This register is updated by the user or after each ZQ calibration completes.";
            sw = rw; hw = r;
            reset = 0x20;
        } zcode_pdrv[21:16];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_15_15[15:15];
        field {
            name = "zcode_ndrv_cal";
            desc = "N driver impedance calibration code. This field shows the N driver calibration code during impedance calibration.";
            sw = r; hw = w;
            reset = 0x0;
        } zcode_ndrv_cal[14:8];
        field {
            name = "ndrv_cal_result";
            desc = "N driver calibration result. This field is used to set the ZQ calibration result.
- 0: Calibration completed without error.
- 1: Calibration completed with error. Writing 1 to this field clears it.";
            sw = r; hw = w;
            reset = 0x0;
        } ndrv_cal_result[7:7];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_6_6[6:6];
        field {
            name = "zcode_ndrv";
            desc = "N drive impedance control code. This field specifies the N drive impedance control code. This register is updated by the user or after each ZQ calibration completes.";
            sw = rw; hw = r;
            reset = 0x20;
        } zcode_ndrv[5:0];
    } PACK_ZCAL_STATUS @ 0x28;
    reg {
        name = "PACK_DRAMCFG";
        desc = "PACK_DRAMCFG is the DRAM configuration system register. PACK_DRAMCFG (offset 0x02C, total reset 0x0000_0002; PROVEN: Hi3535 data sheet, PDF page 677, section 4.1.8.2).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_7[31:7];
        field {
            name = "maddr_mir";
            desc = "Address mirroring. This field must be set to 0 for a single-rank configuration.";
            sw = rw; hw = r;
            reset = 0x0;
        } maddr_mir[6:6];
        field {
            name = "ma2t";
            desc = "Two address/command cycles. This field specifies whether the PHY controller that generates DRAM commands internally uses 2T timing.";
            sw = rw; hw = r;
            reset = 0x0;
        } ma2t[5:5];
        field {
            name = "nosra";
            desc = "No simultaneous rank access. This field specifies whether simultaneous rank accesses are allowed within the same clock cycle. Setting this field to 1 makes rank accesses take turns. Note: This field can be enabled only when the number of ranks is 2 or 4. It must be set to 0 for a single-rank configuration.";
            sw = rw; hw = r;
            reset = 0x0;
        } nosra[4:4];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_3_3[3:3];
        field {
            name = "dcfg_type";
            desc = "DRAM type enable. This field sets the DDR RAM type.
- 010: DDR3. Others: Reserved.";
            sw = rw; hw = r;
            reset = 0x2;
        } dcfg_type[2:0];
    } PACK_DRAMCFG @ 0x2c;
    reg {
        name = "PACK_DRAMTMR0";
        desc = "PACK_DRAMTMR0 is DRAM timing parameter register 0. The command delays set by this register apply only to commands issued internally from the PHY registers. PACK_DRAMTMR0 (offset 0x030, total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 678, section 4.1.8.2).";
        field {
            name = "t_rc";
            desc = "Activate-to-activate command delay for the same bank.";
            sw = rw; hw = r;
            reset = 0x0;
        } t_rc[31:26];
        field {
            name = "t_rrd";
            desc = "Activate-to-activate command delay between different banks.";
            sw = rw; hw = r;
            reset = 0x0;
        } t_rrd[25:22];
        field {
            name = "t_ras";
            desc = "Activate-to-precharge command cycle.";
            sw = rw; hw = r;
            reset = 0x0;
        } t_ras[21:16];
        field {
            name = "t_rcd";
            desc = "Activate-to-read/write delay.";
            sw = rw; hw = r;
            reset = 0x0;
        } t_rcd[15:12];
        field {
            name = "t_rp";
            desc = "Precharge command cycles.";
            sw = rw; hw = r;
            reset = 0x0;
        } t_rp[11:8];
        field {
            name = "t_wtr";
            desc = "Write-to-read command cycles.";
            sw = rw; hw = r;
            reset = 0x0;
        } t_wtr[7:4];
        field {
            name = "t_rtp";
            desc = "Read-to-precharge command cycles.";
            sw = rw; hw = r;
            reset = 0x0;
        } t_rtp[3:0];
    } PACK_DRAMTMR0 @ 0x30;
    reg {
        name = "PACK_DRAMTMR1";
        desc = "PACK_DRAMTMR1 is DRAM timing parameter register 1. The command delays set by this register apply only to commands issued internally from the PHY registers. PACK_DRAMTMR1 (offset 0x034, total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 678, section 4.1.8.2).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_29[31:29];
        field {
            name = "t_rtw";
            desc = "Read-to-write command delay. This field specifies whether extra cycles are inserted between read and write commands. Normally this value is 3.";
            sw = rw; hw = r;
            reset = 0x0;
        } t_rtw[28:25];
        field {
            name = "t_rfc";
            desc = "Refresh-to-refresh command delay.";
            sw = rw; hw = r;
            reset = 0x0;
        } t_rfc[24:16];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_15_15[15:15];
        field {
            name = "t_faw";
            desc = "Four-bank activate window. This field is valid only for 8-rank devices.";
            sw = rw; hw = r;
            reset = 0x0;
        } t_faw[14:9];
        field {
            name = "t_mod";
            desc = "Load mode register to non-load-mode-register command delay. This field is valid only for DDR3.";
            sw = rw; hw = r;
            reset = 0x0;
        } t_mod[8:4];
        field {
            name = "t_mrd";
            desc = "Load mode register to load mode register command delay.";
            sw = rw; hw = r;
            reset = 0x0;
        } t_mrd[3:0];
    } PACK_DRAMTMR1 @ 0x34;
    reg {
        name = "PACK_DRAMTMR2";
        desc = "PACK_DRAMTMR2 is DRAM timing parameter register 2. The command delays set by this register apply only to commands issued from within the PHY registers. PACK_DRAMTMR2 (offset 0x038, total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 679, section 4.1.8.2).";
        field {
            name = "t_ccd";
            desc = "Read-to-read and write-to-write command delay.
- 0 = BL/2 (for DDR3, this value should be 4)
- 1 = BL/2 + 1 (for DDR3, this value should be 5)";
            sw = rw; hw = r;
            reset = 0x0;
        } t_ccd[31:31];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_30_30[30:30];
        field {
            name = "t_dllk";
            desc = "DLL lock time.";
            sw = rw; hw = r;
            reset = 0x0;
        } t_dllk[29:20];
        field {
            name = "t_cke";
