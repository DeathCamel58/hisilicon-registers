// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3535-clocks" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3535: clock tree</B><BR/><FONT POINT-SIZE="11">data sheet 3.2.3-3.2.5 (Figure 3-3, Tables 3-2 to 3-4); consumer lists are grouped by printed adjacency to each PLL output (INFERRED: connector lines are lost in the text layer)</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  xin [label="XIN 24 MHz crystal", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  rg [label="RGMII0/1 RXCK, TXCK\n(GMAC interface clocks)", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  apll [label="APLL (PERI_CRG0 / 1)\nFOUTPOSTDIV max 1000 MHz;\nFOUT1PH0 max 500 MHz", fillcolor="#e6a0a0"  ];
  bpll [label="BPLL (PERI_CRG2 / 3)\nFOUTVCO 1200 MHz: 400 / 200 / 100 / 50 MHz", fillcolor="#e6a0a0"  ];
  vpll0 [label="VPLL0 (PERI_CRG4 / 5)\nFOUT1PH0 max 194 MHz", fillcolor="#e6a0a0"  ];
  vpll1 [label="VPLL1 (PERI_CRG6 / 7)\nFOUT1PH0 max 194 MHz", fillcolor="#e6a0a0"  ];
  vpll2 [label="VPLL2 (PERI_CRG72 / 73)\nFOUTPOSTDIV 324 MHz; FOUT3 54 MHz", fillcolor="#e6a0a0"  ];
  epll [label="EPLL (PERI_CRG8 / 9)\nFOUTVCO 1500 MHz: 500 / 250 / 125 MHz;\ndividers 750 / 375 / 187 / 150 MHz", fillcolor="#e6a0a0"  ];
  a9 [label="dual Cortex-A9\ncpu_sc_sel PERI_CRG12[8]: APLL FOUTPOSTDIV or 750 MHz\nDFS skip PERI_CRG10[24:20]", fillcolor="#e0b86f"  ];
  ddr [label="DDR\nddr_sc_sel PERI_CRG12[5:4]: 400 / 324 / 300 MHz or APLL FOUT1PH0", fillcolor="#8fb3de"  ];
  bus [label="bus clocks\nbus_sc_sel PERI_CRG12[2:0]: hpaxi 324/250, mdaaxi 324/250, sysaxi 250/200 MHz", fillcolor="#8fb3de"  ];
  aio [label="AIO", fillcolor="#a6c98f"  ];
  tde [label="TDE, VAPU", fillcolor="#a6c98f"  ];
  ciph [label="JPGD, NFC, CIPHER", fillcolor="#a6c98f"  ];
  phy [label="USB 3.0 / SATA / PCIe PHY reference 100 MHz (default)", fillcolor="#8fb3de"  ];
  rmii [label="RMII, SDIO 50 MHz", fillcolor="#8fb3de"  ];
  hdmi [label="HDMI, HD DAC (default), DHD0 / DHD1\nvo_hd0_clkdiv / vo_hd1_clkdiv PERI_CRG13[22:21]", fillcolor="#a6c98f"  ];
  vgs [label="VGS", fillcolor="#a6c98f"  ];
  sdd [label="SD DAC, DSD, DATE\n54 MHz", fillcolor="#a6c98f"  ];
  vpss [label="VPSS, SED", fillcolor="#a6c98f"  ];
  toe [label="TOE 150 MHz", fillcolor="#8fb3de"  ];
  vedu [label="VEDU, VDH, JPGE, MD 250 MHz", fillcolor="#a6c98f"  ];
  sfc [label="SFC, RGMII", fillcolor="#8fb3de"  ];
  xin -> apll;
  xin -> bpll;
  xin -> vpll0;
  xin -> vpll1;
  xin -> vpll2;
  xin -> epll;
  xin -> a9 [label="crystal after reset"];
  apll -> a9;
  epll -> a9 [label="750 MHz"];
  apll -> aio;
  apll -> ddr [label="FOUT1PH0"];
  bpll -> ddr [label="400 MHz"];
  bpll -> tde [label="200 MHz"];
  bpll -> ciph [label="200 MHz"];
  bpll -> bus;
  bpll -> phy [label="100 MHz"];
  bpll -> rmii [label="50 MHz"];
  vpll0 -> hdmi;
  vpll1 -> hdmi;
  vpll2 -> ddr [label="324 MHz"];
  vpll2 -> bus [label="324 MHz"];
  vpll2 -> vgs;
  vpll2 -> sdd [label="FOUT3"];
  epll -> vpss [label="375 / 187 MHz"];
  epll -> toe [label="150 MHz"];
  epll -> vedu [label="250 MHz"];
  epll -> sfc [label="125 MHz"];
  epll -> aio [label="500 MHz"];
  rg -> sfc [label="RGMII interface"];
}
