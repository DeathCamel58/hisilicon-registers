// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3535-video" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3535: decode and display data path</B><BR/><FONT POINT-SIZE="11">block names from the data sheet memory map and chapter 1; arrows are the usual NVR data path (INFERRED, not tabulated in the data sheet); the data sheet lists no video-input block for this chip</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  io [label="SATA 3.0 / PCIe (shared port) /\n2 x GMAC with TOE / USB 3.0 / USB 2.0\n(recorded streams in)", fillcolor="#8fb3de"  ];
  ddr [label="DDR3 (streams, frames)", fillcolor="#e0b86f"  ];
  vdh [label="VDH0 / VDH1\nH.264 / MPEG4 decoder", fillcolor="#a6c98f"  ];
  jpgd [label="JPGD", fillcolor="#a6c98f"  ];
  vpss [label="VPSS\nscale, de-interlace, NR", fillcolor="#a6c98f"  ];
  venc [label="VENC / JPGE\n1 x 1080p@30 encode", fillcolor="#a6c98f"  ];
  ive [label="IVE", fillcolor="#a6c98f"  ];
  md [label="MD\nmotion detect", fillcolor="#a6c98f"  ];
  tde [label="TDE", fillcolor="#a6c98f"  ];
  vgs [label="VGS", fillcolor="#a6c98f"  ];
  vdp [label="VDP\nDHD0 / DHD1, DSD, cursor, GUI layers", fillcolor="#a6c98f"  ];
  out [label="HDMI 1.4 / VGA / BT.1120 / CVBS", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  io -> ddr;
  ddr -> vdh [label="streams"];
  ddr -> jpgd;
  vdh -> vpss;
  jpgd -> vpss;
  vpss -> venc;
  vpss -> ive;
  vpss -> md;
  venc -> ddr [label="streams"];
  vpss -> vgs;
  vgs -> vdp;
  tde -> vdp [label="graphics"];
  vdp -> out;
}
