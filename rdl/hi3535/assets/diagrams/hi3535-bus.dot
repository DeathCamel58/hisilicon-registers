// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3535-bus" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3535: bus clock domains</B><BR/><FONT POINT-SIZE="11">bus clock domains from the data sheet clock chapter; the data sheet has no master/slave bus matrix or QoS table (INFERRED: the role named in each domain label)</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  a9 [label="dual Cortex-A9 + L2 (256 KB)", fillcolor="#e0b86f"  ];
  hp [label="hpaxi\n324 or 250 MHz\n(bus_sc_sel [2])", fillcolor="#9a9a9a"  ];
  mda [label="mdaaxi\n324 or 250 MHz\n(bus_sc_sel [1])", fillcolor="#9a9a9a"  ];
  sys [label="sysaxi\n250 or 200 MHz\n(bus_sc_sel [0])", fillcolor="#9a9a9a"  ];
  ddr [label="DDR3 controller\n400 / 324 / 300 MHz or APLL FOUT1PH0\n(ddr_sc_sel PERI_CRG12[5:4])", fillcolor="#8fb3de"  ];
  note [label="bus_sc_sel and ddr_sc_sel can be changed only in SLOW mode", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  a9 -> hp;
  hp -> ddr;
  mda -> ddr;
  sys -> ddr;
  a9 -> mda;
  a9 -> sys;
}
