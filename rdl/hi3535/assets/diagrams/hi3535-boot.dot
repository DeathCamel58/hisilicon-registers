// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3535-boot" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3535: boot flow</B><BR/><FONT POINT-SIZE="11">data sheet 1.3, Table 1-1 (BOOTROM_SEL = MDCK, BOOT_SEL1 = VOU1120_DATA10, BOOT_SEL0 = VOU1120_DATA7)</FONT>>, fontcolor="#808080", rankdir=TB];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  por [label="Power-on reset", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  sel [label="BOOTROM_SEL ?", fillcolor="#d6d27a"   shape=diamond];
  rom [label="BOOTROM\nserial download (UART)", fillcolor="#e0b86f"  ];
  to [label="Serial link\ntimed out?", fillcolor="#d6d27a"   shape=diamond];
  bs [label="BOOT_SEL1, BOOT_SEL0", fillcolor="#d6d27a"   shape=diamond];
  spi [label="SPI flash", fillcolor="#8fb3de"  ];
  nand [label="NAND flash", fillcolor="#8fb3de"  ];
  slave [label="Slave mode (0,0,1): CPU held;\nmaster loads boot program into DDR\nover PCIe and releases reset", fillcolor="#c9a0dc"  ];
  run [label="Boot program runs", fillcolor="#a6c98f"  ];
  por -> sel;
  sel -> rom [label="1"];
  sel -> bs [label="0"];
  rom -> to;
  to -> run [label="download done"];
  to -> bs [label="yes"];
  bs -> spi [label="00"];
  bs -> nand [label="10"];
  bs -> slave [label="01"];
  spi -> run;
  nand -> run;
  slave -> run;
}
