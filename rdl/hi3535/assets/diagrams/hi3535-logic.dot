// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3535-logic" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3535: logic block diagram</B><BR/><FONT POINT-SIZE="11">drawn from the key-specification list of the data sheet (chapter 1); bus topology is not stated there and is not drawn</FONT>>, fontcolor="#808080", rankdir=LR, compound=true, newrank=true];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  bus [label="system bus", fillcolor="#9a9a9a"  shape=box, height=5.2, width=0.5, fontcolor="white"];
  subgraph cluster_cpu { label="CPU subsystem"; fontcolor="#808080"; color="#808080"; style="rounded";
  cpu [label="dual Cortex-A9 up to 1 GHz\n32 KB I + 32 KB D L1 per core, 256 KB L2", fillcolor="#e0b86f"  ];
  }
  ddrc [label="DDRC", fillcolor="#8fb3de"  ];
  ddrext [label="32-bit DDR3\nup to 800 MHz, 2 GB", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  ddrext -> ddrc [dir=both]; ddrc -> cpu [dir=both]; ddrc -> bus [dir=both, style=dashed];
  subgraph cluster_l0 { label="High-speed peripherals"; fontcolor="#808080"; color="#808080"; style="rounded";
    sata [label="SATA 3.0 x2", fillcolor="#8fb3de"  ];
    pcie [label="PCIe 2.0 RC/EP or\nSATA 3.0 (shared port)", fillcolor="#8fb3de"  ];
    eth [label="GMAC x2\n1 Gbit/s, TOE", fillcolor="#8fb3de"  ];
    usb [label="USB 2.0 host x2,\nUSB 3.0 host x1", fillcolor="#8fb3de"  ];
    sfc [label="SFC (SPI NOR)", fillcolor="#8fb3de"  ];
    nand [label="NAND controller (8-bit)", fillcolor="#8fb3de"  ];
    aio [label="AIO (I2S x2,\naudio codec)", fillcolor="#8fb3de"  ];
  }
  sata -> bus [dir=both];
  pcie -> bus [dir=both];
  eth -> bus [dir=both];
  usb -> bus [dir=both];
  sfc -> bus [dir=both];
  nand -> bus [dir=both];
  aio -> bus [dir=both];
  subgraph cluster_l1 { label="Security"; fontcolor="#808080"; color="#808080"; style="rounded";
    cipher [label="CIPHER\nAES / DES / 3DES", fillcolor="#c9a0dc"  ];
  }
  cipher -> bus [dir=both];
  subgraph cluster_r0 { label="Video input and output"; fontcolor="#808080"; color="#808080"; style="rounded";
    vi [label="VICAP", fillcolor="#a6c98f"  ];
    vpss [label="VPSS", fillcolor="#a6c98f"  ];
    vo [label="VDP: HDMI 1.4 / VGA /\nBT.1120 / CVBS output", fillcolor="#a6c98f"  ];
  }
  bus -> vi [dir=both];
  bus -> vpss [dir=both];
  bus -> vo [dir=both];
  subgraph cluster_r1 { label="Video codec and analysis"; fontcolor="#808080"; color="#808080"; style="rounded";
    codec [label="H.264 decoder, H.264 /\nMJPEG / JPEG encoder", fillcolor="#a6c98f"  ];
    ive [label="IVE", fillcolor="#a6c98f"  ];
  }
  bus -> codec [dir=both];
  bus -> ive [dir=both];
  subgraph cluster_r2 { label="Low-speed peripherals"; fontcolor="#808080"; color="#808080"; style="rounded";
    lsp [label="UART x4, I2C, IR, GPIO,\ntimers, WDG, RTC,\nSYS_CTRL, CRG, IO config", fillcolor="#7fcdc4"  ];
    rom [label="BOOTROM 4 KB, SRAM 10 KB", fillcolor="#7fcdc4"  ];
  }
  bus -> lsp [dir=both];
  bus -> rom [dir=both];
  hdd [label="SATA hard disks", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  hdd -> sata [dir=both, style=dashed];
  peer [label="PCIe peer / SATA", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  peer -> pcie [dir=both, style=dashed];
  phy [label="2 Ethernet PHYs", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  phy -> eth [dir=both, style=dashed];
  usbp [label="USB 2.0 / 3.0 ports", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  usbp -> usb [dir=both, style=dashed];
  nor [label="SPI NOR / NAND flash", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  nor -> sfc [dir=both, style=dashed];
  nor -> nand [dir=both, style=dashed];
  bus -> cpu [dir=both];
}
