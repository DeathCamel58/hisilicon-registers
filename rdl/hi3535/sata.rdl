            sw = rw; hw = r;
            reset = 0x0;
        } reset_[0:0];
    } SATA_PHY2_CTLL @ 0xf0;
    reg {
        name = "SATA_PHY2_CTLH";
        desc = "SATA_PHY2_CTLH is the PHY2 global control register, high part. SATA_PHY2_CTLH (offset 0x00F4, total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 1385, section 13.8.7.1).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_4[31:4];
        field {
            name = "data_invert";
            desc = "- 0: The endianness of the parallel data between the PHY and the SATA controller is the same.
- 1: The endianness of the parallel data between the PHY and the SATA controller is opposite.";
            sw = rw; hw = r;
            reset = 0x0;
        } data_invert[3:3];
        field {
            name = "test_powerdown";
            desc = "Test control signal that controls power-down of all circuits. Used during IDDQ testing.
- 0: No power-down;
- 1: Power-down.";
            sw = rw; hw = r;
            reset = 0x0;
        } test_powerdown[2:2];
        field {
            name = "test_bypass";
            desc = "Test control signal, set to 0.";
            sw = rw; hw = r;
            reset = 0x0;
        } test_bypass[1:1];
        field {
            name = "test_burnin";
            desc = "Test control signal, set to 0.";
            sw = rw; hw = r;
            reset = 0x0;
        } test_burnin[0:0];
    } SATA_PHY2_CTLH @ 0xf4;
    reg {
        name = "SATA_PHY2_STS";
        desc = "SATA_PHY2_STS is the PHY2 global status register. SATA_PHY2_STS (offset 0x00F8, total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 1386, section 13.8.7.1).";
        field {
            name = "Phy2_sts";
            desc = "SATA PHY2 common part status register.";
            sw = r; hw = w;
            reset = 0x0;
        } Phy2_sts[31:0];
    } SATA_PHY2_STS @ 0xf8;
};

`endif
