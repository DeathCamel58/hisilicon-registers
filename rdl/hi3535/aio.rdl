            sw = rw; hw = r;
            reset = 0x0;
        } tx_sd0_sel[25:24];
        field {
            name = "tx_sd_source_sel";
            desc = "SD0, SD1, SD2, SD3 source selection.
- 0000: I2S TX0;
- 0001: I2S TX1;
- 1000: I2S RX0; Others: Reserved.";
