    reg {
        name = "RX_IF_ATTRI";
        desc = "RX_IF_ATTRI is the interface attribute setting register of the receive channel. RX_IF_ATTRI (offset 0x1000, total reset 0xE400_0004; PROVEN: Hi3535 data sheet, PDF page 1183, section 12.1.6).";
        field {
            name = "rx_sd3_sel";
            desc = "SD3 select.
- 00: SD0.
- 01: SD1.
- 10: SD2.
- 11: SD3. Note: Select the channel first, then select the data line.";
            sw = rw; hw = r;
            reset = 0x3;
        } rx_sd3_sel[31:30];
        field {
            name = "rx_sd2_sel";
            desc = "SD2 select
- 00: SD0;
- 01: SD1;
- 10: SD2;
- 11: SD3.
Note: select the channel first, then select the data line.";
            sw = rw; hw = r;
            reset = 0x2;
        } rx_sd2_sel[29:28];
        field {
            name = "rx_sd1_sel";
            desc = "SD1 select.
- 00: SD0.
- 01: SD1.
- 10: SD2.
- 11: SD3. Note: Select the channel first, then select the data line.";
            sw = rw; hw = r;
            reset = 0x1;
        } rx_sd1_sel[27:26];
        field {
            name = "rx_sd0_sel";
            desc = "SD0 select.
- 00: SD0;
- 01: SD1;
- 10: SD2;
- 11: SD3.
Note: Select the channel first, then select the data line.";
            sw = rw; hw = r;
            reset = 0x0;
        } rx_sd0_sel[25:24];
        field {
            name = "rx_sd_source_sel";
            desc = "Source select for SD0, SD1, SD2 and SD3.
- 0000: I2S TX0.
- 0001: I2S TX1.
- 1000: I2S RX0. Others: Reserved.";
            sw = rw; hw = r;
            reset = 0x0;
        } rx_sd_source_sel[23:20];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = rw; hw = r;
            reset = 0x0;
        } reserved_19_19[19:19];
        field {
            name = "rx_trackmode";
            desc = "Left/right channel mode control in I2S mode.
- 000: No processing;
- 001: Both channels carry the left channel audio;
- 010: Both channels carry the right channel audio;
- 011: The two channels are swapped;
- 100: Both channel outputs carry the sum of the left and right channels;
- 101: Left channel muted, right channel plays its original right channel audio;
- 110: Right channel muted, left channel plays its original left channel audio;
- 111: Left and right channels muted. Note: trackmode is still valid for 1ch reception.";
            sw = rw; hw = r;
            reset = 0x0;
        } rx_trackmode[18:16];
        field {
            name = "rx_sd_offset";
            desc = "In PCM mode, the data is delayed by n BCLK cycles relative to the frame sync signal.
- 0x00: 0 bit clocks;
- 0x01: 1 bit clocks;
- 0x02: 2 bit clocks;
- ...
- 0xFE: 254 bitclocks;
- 0xFF: 255 bitclocks.";
            sw = rw; hw = r;
            reset = 0x0;
        } rx_sd_offset[15:8];
        field {
            name = "rx_multislot_en";
            desc = "Time-division multiplexing valid indication bit.
- 0: Time-division multiplexing mode is invalid, normal mode;
- 1: Time-division multiplexing mode is valid.";
            sw = rw; hw = r;
            reset = 0x0;
        } rx_multislot_en[7:7];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = rw; hw = r;
