        field {
            name = "rx_ch_num";
            desc = "Receive channel count select. rx_multislot_en = 0
- 00: 1 channel (ch) receive (sd0 data line).
- 01: 2 channel (ch) receive (sd0 data line).
- 10: Reserved.
- 11: 8 channel (ch) receive (sd0, sd1, sd2, sd3 data lines). Others: Reserved. rx_multislot_en = 1 Channel count select for receive in time-division multiplexing mode.
- 00: 2 channel receive (sd0 data line).
- 01: 4 channel receive (sd0 data line).
- 10: 8 channel receive (sd0 data line).
- 11: 16 channel receive (sd0 data line). Note: For multi-channel receive, only data line 0 (sd0) is used.";
            sw = rw; hw = r;
            reset = 0x0;
        } rx_ch_num[5:4];
        field {
