PCM normal mode:
- 00: 8bit;
- 01: 16bit;
Others: Reserved. rx_multislot_en = 1

I2S/PCM mode:
- 00: 8bit;
- 01: 16bit;
Others: Reserved.";
            sw = rw; hw = r;
            reset = 0x1;
        } rx_i2s_precision[3:2];
