`ifndef EHI3535_AIO_RDL
`define EHI3535_AIO_RDL
regfile eHI3535_AIO {
    name = "Audio interface (AIO)";
    desc = "Audio interface (AIO). 43 registers extracted programmatically from the Hi3535 H.264 codec processor (Hi3535 user guide) data sheet (Issue 00B08, 2014-02-25); chapter 12.1.6, table 12-2. Field names, bit ranges, access types and reset values are taken from the register tables; reset values are the data sheet total reset values split onto the fields (per-field values where the table has them). Label: PROVEN. Hardware not verified here (no board).";
    reg {
        name = "AIAO_INT_ENA";
        desc = "AIAO_INT_ENA is the AIO module interrupt enable register. AIAO_INT_ENA (offset 0x0000, total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 1172, section 12.1.6).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = rw; hw = r;
            reset = 0x0;
        } reserved_31_18[31:18];
        field {
            name = "tx_ch1_int_ena";
            desc = "Interrupt enable of transmit channel 1.
- 0: Disable;
- 1: Enable.";
            sw = rw; hw = r;
            reset = 0x0;
        } tx_ch1_int_ena[17:17];
        field {
            name = "tx_ch0_int_ena";
            desc = "Interrupt enable of transmit channel 0.
- 0: Disable;
- 1: Enable.";
            sw = rw; hw = r;
            reset = 0x0;
        } tx_ch0_int_ena[16:16];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = rw; hw = r;
            reset = 0x0;
        } reserved_15_1[15:1];
        field {
            name = "rx_ch0_int_ena";
            desc = "Interrupt enable of receive channel 0.
- 0: Disable.
- 1: Enable.";
            sw = rw; hw = r;
            reset = 0x0;
        } rx_ch0_int_ena[0:0];
    } AIAO_INT_ENA @ 0x0;
    reg {
        name = "AIAO_INT_STATUS";
        desc = "AIAO_INT_STATUS is the interrupt status register of the AIO module. AIAO_INT_STATUS (offset 0x0004, total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 1173, section 12.1.6).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_18[31:18];
        field {
            name = "tx_ch1_int_status";
            desc = "Interrupt status of transmit channel 1.
- 0: No interrupt status;
- 1: Interrupt status present.";
            sw = r; hw = w;
            reset = 0x0;
        } tx_ch1_int_status[17:17];
        field {
            name = "tx_ch0_int_status";
            desc = "Interrupt status of transmit channel 0.
- 0: No interrupt status;
- 1: Interrupt status present.";
            sw = r; hw = w;
            reset = 0x0;
        } tx_ch0_int_status[16:16];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_15_1[15:1];
        field {
            name = "rx_ch0_int_status";
            desc = "Interrupt status of receive channel 0.
- 0: No interrupt status;
- 1: Interrupt status present.";
            sw = r; hw = w;
            reset = 0x0;
        } rx_ch0_int_status[0:0];
    } AIAO_INT_STATUS @ 0x4;
    reg {
        name = "AIAO_INT_RAW";
        desc = "AIAO_INT_RAW is the raw interrupt register of the AIO module. AIAO_INT_RAW (offset 0x0008, total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 1174, section 12.1.6).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_18[31:18];
        field {
            name = "tx_ch1_int_raw";
            desc = "Raw interrupt of transmit channel 1.
- 0: No raw interrupt;
- 1: Raw interrupt present.";
            sw = r; hw = w;
            reset = 0x0;
        } tx_ch1_int_raw[17:17];
        field {
            name = "tx_ch0_int_raw";
            desc = "Raw interrupt of transmit channel 0.
- 0: No raw interrupt.
- 1: Raw interrupt present.";
            sw = r; hw = w;
            reset = 0x0;
        } tx_ch0_int_raw[16:16];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_15_1[15:1];
        field {
            name = "rx_ch0_int_raw";
            desc = "Raw interrupt of receive channel 0.
- 0: No raw interrupt;
- 1: Raw interrupt present.";
            sw = r; hw = w;
            reset = 0x0;
        } rx_ch0_int_raw[0:0];
    } AIAO_INT_RAW @ 0x8;
    reg {
        name = "AIAO_SWITCH_RX_BCLK";
        desc = "AIAO_SWITCH_RX_BCLK is the AIO I2S RX BCLK SWITCH configuration register. AIAO_SWITCH_RX_BCLK (offset 0x0028, total reset 0x7654_3210; PROVEN: Hi3535 data sheet, PDF page 1174, section 12.1.6).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = rw; hw = r;
            reset = 0x7654321;
        } reserved_31_4[31:4];
        field {
            name = "inner_bclk_ws_sel_rx_00";
            desc = "Internal BCLK select of the receive channel.
- 0000: Select BCLK0;
- 1000: Select BCLK8;
- 1001: Select BCLK9; Others: Reserved.";
            sw = rw; hw = r;
            reset = 0x0;
        } inner_bclk_ws_sel_rx_00[3:0];
    } AIAO_SWITCH_RX_BCLK @ 0x28;
    reg {
        name = "AIAO_SWITCH_TX_BCLK";
        desc = "AIAO_SWITCH_TX_BCLK is the AIO I2S TX BCLK SWITCH configuration register. AIAO_SWITCH_TX_BCLK (offset 0x002C, total reset 0x7654_3210; PROVEN: Hi3535 data sheet, PDF page 1175, section 12.1.6).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = rw; hw = r;
            reset = 0x765432;
        } reserved_31_8[31:8];
        field {
            name = "inner_bclk_ws_sel_tx_01";
            desc = "Internal BCLK select of transmit channel 1.
- 0000: Select BCLK0.
- 1000: Select BCLK8.
- 1001: Select BCLK9. Others: Reserved.";
            sw = rw; hw = r;
            reset = 0x1;
        } inner_bclk_ws_sel_tx_01[7:4];
        field {
            name = "inner_bclk_ws_sel_tx_00";
            desc = "Internal BCLK select of transmit channel 0.
- 0000: Select BCLK0;
- 1000: Select BCLK8;
- 1001: Select BCLK9;
Others: Reserved.";
            sw = rw; hw = r;
            reset = 0x0;
        } inner_bclk_ws_sel_tx_00[3:0];
    } AIAO_SWITCH_TX_BCLK @ 0x2c;
    reg {
        name = "AIAO_STATUS";
        desc = "AIAO_STATUS is the AIO status register. AIAO_STATUS (offset 0x0030, total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 1176, section 12.1.6).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_1[31:1];
        field {
            name = "srst_rdy";
            desc = "Soft reset status signal.
- 0: Reset in progress;
- 1: Reset complete.";
            sw = r; hw = w;
            reset = 0x0;
        } srst_rdy[0:0];
    } AIAO_STATUS @ 0x30;
    reg {
        name = "I2S_CRG_CFG0_00";
        desc = "I2S_CRG_CFG0_00 is I2S00 CRG configuration register 0. I2S_CRG_CFG0_00 (offset 0x0100, total reset 0x00AA_AAAA; PROVEN: Hi3535 data sheet, PDF page 1176, section 12.1.6).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = rw; hw = r;
            reset = 0x0;
        } reserved_31_27[31:27];
        field {
            name = "aiao_mclk_div";
            desc = "Divided clock configuration value of MCLK; the value is (MCLK0/AIO clock source frequency) x 2^27. For the MCLK0 clock source frequency, see 3.2 Clocks.";
            sw = rw; hw = r;
            reset = 0xaaaaaa;
        } aiao_mclk_div[26:0];
    } I2S_CRG_CFG0_00 @ 0x100;
    reg {
        name = "I2S_CRG_CFG1_00";
        desc = "I2S_CRG_CFG1_00 is I2S00 CRG configuration register 1. I2S_CRG_CFG1_00 (offset 0x0104, total reset 0x0000_0131; PROVEN: Hi3535 data sheet, PDF page 1177, section 12.1.6).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = rw; hw = r;
            reset = 0x0;
        } reserved_31_14[31:14];
        field {
            name = "aiao_bclkout_pctrl";
            desc = "BCLKOUT polarity control.
- 0: Normal;
- 1: Inverted.";
            sw = rw; hw = r;
            reset = 0x0;
        } aiao_bclkout_pctrl[13:13];
        field {
            name = "aiao_bclkin_pctrl";
            desc = "BCLKIN polarity control.
- 0: Normal;
- 1: Inverted.";
            sw = rw; hw = r;
            reset = 0x0;
        } aiao_bclkin_pctrl[12:12];
        field {
            name = "aiao_bclk_sel";
            desc = "BCLK/FCLK select.
- 0: Clock generated internally;
- 1: Clock input from an external Audio DAC chip.";
            sw = rw; hw = r;
            reset = 0x0;
        } aiao_bclk_sel[11:11];
        field {
            name = "aiao_bclk_oen";
            desc = "BCLK/FCLK IO oen control.
- 0: BCLK/FCLK IO is an output;
- 1: BCLK/FCLK IO is an input. Note: Must be used together with aiao_bclk_sel to select the I2S interface master/slave mode.";
            sw = rw; hw = r;
            reset = 0x0;
        } aiao_bclk_oen[10:10];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = rw; hw = r;
            reset = 0x0;
        } reserved_9_9[9:9];
        field {
            name = "aiao_cken";
            desc = "Clock status.
- 0: Off.
- 1: On.";
            sw = rw; hw = r;
            reset = 0x1;
        } aiao_cken[8:8];
        field {
            name = "reserved";
            desc = "Reserved extension.";
            sw = rw; hw = r;
            reset = 0x0;
        } reserved_7_7[7:7];
        field {
            name = "aiao_fsclk_div";
            desc = "Divider relationship between the bit clock BCLK and the sampling clock FS.
- 000: FS is BCLK divided by 16;
- 001: FS is BCLK divided by 32;
- 010: FS is BCLK divided by 48;
- 011: FS is BCLK divided by 64;
- 100: FS is BCLK divided by 128;
- 101: FS is BCLK divided by 256; Others: FS is BCLK divided by 8.";
            sw = rw; hw = r;
            reset = 0x3;
        } aiao_fsclk_div[6:4];
        field {
            name = "aiao_bclk_div";
            desc = "Divider relationship between the master clock MCLK and the bit clock BCLK.
- 0000: BCLK is MCLK divided by 1;
- 0001: BCLK is MCLK divided by 3;
- 0010: BCLK is MCLK divided by 2;
- 0011: BCLK is MCLK divided by 4;
- 0100: BCLK is MCLK divided by 6;
- 0101: BCLK is MCLK divided by 8;
- 0110: BCLK is MCLK divided by 12;
- 0111: BCLK is MCLK divided by 16;
- 1000: BCLK is MCLK divided by 24;
- 1001: BCLK is MCLK divided by 32;
- 1010: BCLK is MCLK divided by 48;
- 1011: BCLK is MCLK divided by 64; Others: BCLK is MCLK divided by 8.";
            sw = rw; hw = r;
            reset = 0x1;
        } aiao_bclk_div[3:0];
    } I2S_CRG_CFG1_00 @ 0x104;
    reg {
        name = "I2S_CRG_CFG0_08";
        desc = "I2S_CRG_CFG0_08 is I2S08 CRG configuration register 0. I2S_CRG_CFG0_08 (offset 0x0140, total reset 0x00AA_AAAA; PROVEN: Hi3535 data sheet, PDF page 1178, section 12.1.6).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = rw; hw = r;
            reset = 0x0;
        } reserved_31_27[31:27];
        field {
            name = "aiao_mclk_div";
            desc = "Divided clock configuration value of MCLK. The configured value is (MCLK0 / AIO clock source frequency) x 2^27. For the MCLK0 clock source frequency, see 3.2 Clocks.";
            sw = rw; hw = r;
            reset = 0xaaaaaa;
        } aiao_mclk_div[26:0];
    } I2S_CRG_CFG0_08 @ 0x140;
    reg {
        name = "I2S_CRG_CFG1_08";
        desc = "I2S_CRG_CFG1_08 is I2S08 CRG configuration register 1. I2S_CRG_CFG1_08 (offset 0x0144, total reset 0x0000_0131; PROVEN: Hi3535 data sheet, PDF page 1179, section 12.1.6).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = rw; hw = r;
            reset = 0x0;
        } reserved_31_14[31:14];
        field {
            name = "aiao_bclkout_pctrl";
            desc = "BCLKOUT polarity control.
- 0: Normal;
- 1: Inverted.";
            sw = rw; hw = r;
            reset = 0x0;
        } aiao_bclkout_pctrl[13:13];
        field {
            name = "aiao_bclkin_pctrl";
            desc = "BCLKIN polarity control.
- 0: Normal;
- 1: Inverted.";
            sw = rw; hw = r;
            reset = 0x0;
        } aiao_bclkin_pctrl[12:12];
        field {
            name = "aiao_bclk_sel";
            desc = "BCLK/FCLK select.
- 0: Clock generated internally;
- 1: Clock input from an external Audio DAC chip.";
            sw = rw; hw = r;
            reset = 0x0;
        } aiao_bclk_sel[11:11];
        field {
            name = "aiao_bclk_oen";
            desc = "BCLK/FCLK IO oen control.
- 0: The BCLK/FCLK IO is an output (AIO is in master mode).
- 1: The BCLK/FCLK IO is an input (AIO is in slave mode). Note: Must be used together with aiao_bclk_sel to select the I2S interface master/slave mode.";
            sw = rw; hw = r;
            reset = 0x0;
        } aiao_bclk_oen[10:10];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = rw; hw = r;
            reset = 0x0;
        } reserved_9_9[9:9];
        field {
            name = "aiao_cken";
            desc = "Clock status.
- 0: Off.
- 1: On.";
            sw = rw; hw = r;
            reset = 0x1;
        } aiao_cken[8:8];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = rw; hw = r;
            reset = 0x0;
        } reserved_7_7[7:7];
        field {
            name = "aiao_fsclk_div";
            desc = "Divider relationship between the bit clock BCLK and the sampling clock FS.
- 000: FS is BCLK divided by 16;
- 001: FS is BCLK divided by 32;
- 010: FS is BCLK divided by 48;
- 011: FS is BCLK divided by 64;
- 100: FS is BCLK divided by 128;
- 101: FS is BCLK divided by 256; Others: FS is BCLK divided by 8.";
            sw = rw; hw = r;
            reset = 0x3;
        } aiao_fsclk_div[6:4];
        field {
            name = "aiao_bclk_div";
            desc = "Divider relationship between the master clock MCLK and the bit clock BCLK.
- 0000: BCLK is MCLK divided by 1;
- 0001: BCLK is MCLK divided by 3;
- 0010: BCLK is MCLK divided by 2;
- 0011: BCLK is MCLK divided by 4;
- 0100: BCLK is MCLK divided by 6;
- 0101: BCLK is MCLK divided by 8;
- 0110: BCLK is MCLK divided by 12;
- 0111: BCLK is MCLK divided by 16;
- 1000: BCLK is MCLK divided by 24;
- 1001: BCLK is MCLK divided by 32;
- 1010: BCLK is MCLK divided by 48;
- 1011: BCLK is MCLK divided by 64; Others: BCLK is MCLK divided by 8.";
            sw = rw; hw = r;
            reset = 0x1;
        } aiao_bclk_div[3:0];
    } I2S_CRG_CFG1_08 @ 0x144;
    reg {
        name = "I2S_CRG_CFG0_09";
        desc = "I2S_CRG_CFG0_09 is I2S09 CRG configuration register 0. I2S_CRG_CFG0_09 (offset 0x0148, total reset 0x00AA_AAAA; PROVEN: Hi3535 data sheet, PDF page 1180, section 12.1.6).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = rw; hw = r;
            reset = 0x0;
        } reserved_31_27[31:27];
        field {
            name = "aiao_mclk_div";
            desc = "Divided clock configuration value of MCLK; the value is (MCLK0/AIO clock source frequency) x 2^27. For the MCLK0 clock source frequency, see 3.2 Clocks.";
            sw = rw; hw = r;
            reset = 0xaaaaaa;
        } aiao_mclk_div[26:0];
    } I2S_CRG_CFG0_09 @ 0x148;
    reg {
        name = "I2S_CRG_CFG1_09";
        desc = "I2S_CRG_CFG1_09 is I2S09 CRG configuration register 1. I2S_CRG_CFG1_09 (offset 0x014C, total reset 0x0000_0131; PROVEN: Hi3535 data sheet, PDF page 1181, section 12.1.6).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = rw; hw = r;
