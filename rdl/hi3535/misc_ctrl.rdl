`ifndef EHI3535_MISC_CTRL_RDL
`define EHI3535_MISC_CTRL_RDL
regfile eHI3535_MISC_CTRL {
    name = "Peripheral (MISC) control registers";
    desc = "Peripheral (MISC) control registers. 64 registers extracted programmatically from the Hi3535 H.264 codec processor (Hi3535 user guide) data sheet (Issue 00B08, 2014-02-25); chapter 3.4.5, table 3-27. Field names, bit ranges, access types and reset values are taken from the register tables; reset values are the data sheet total reset values split onto the fields (per-field values where the table has them). Label: PROVEN. Hardware not verified here (no board).";
    reg {
        name = "MISC_CTRL0";
        desc = "MISC_CTRL0 is the CPU control register. This register is not reset by a system soft reset. MISC_CTRL0 (offset 0x0000, total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 418, section 3.4.5.2).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_6[31:6];
        field {
            name = "l2_spniden";
            desc = "Secure privileged non-invasive debug enable.";
            sw = rw; hw = r;
            reset = 0x0;
        } l2_spniden[5:5];
        field {
            name = "a9_cfgsdisable";
            desc = "Masks write access to the key internal configuration registers of the processor, including ICDDCR[0]=EnableSecure, the secure interrupts defined in ICDICTR, and ICCICR (excluding the EnableNS control bit).
- 0: Disable;
- 1: Enable";
            sw = rw; hw = r;
            reset = 0x0;
        } a9_cfgsdisable[4:4];
        field {
            name = "a9_cfgnmfi";
            desc = "CPU fast interrupt used as non-maskable interrupt enable.
- 00: Disable;
- 01: Enable the CPU0 fast interrupt as a non-maskable interrupt;
- 10: Enable the CPU1 fast interrupt as a non-maskable interrupt;
- 11: Enable the CPU0 and CPU1 fast interrupts as non-maskable interrupts.";
            sw = rw; hw = r;
            reset = 0x0;
        } a9_cfgnmfi[3:2];
        field {
            name = "a9_cp15sdiable";
            desc = "Mask write accesses to the processor's internal security registers, including c1 (SCTLR), c2 (TTBR0 and TTBCR), c3 (DACR), c10 (PRRR and NMRR), c12 (VBAR and MVBAR) and c13 (FCSEIDR) in the CP15 coprocessor.
- 00: Disable;
- 01: Enable for CPU0;
- 10: Enable for CPU1;
- 11: Enable for CPU0 and CPU1.";
            sw = rw; hw = r;
            reset = 0x0;
        } a9_cp15sdiable[1:0];
    } MISC_CTRL0 @ 0x0;
    reg {
        name = "MISC_CTRL1";
        desc = "MISC_CTRL1 is the peripheral function selection register. This register is not reset by a system soft reset. MISC_CTRL1 (offset 0x0004, total reset 0x0000_1C00; PROVEN: Hi3535 data sheet, PDF page 419, section 3.4.5.2).";
        field {
            name = "jtag_fun_sel";
            desc = "JTAG function selection. When JTAG_SEL_CPU is 0, this register determines the function of the JTAG pins.
- 00: USB3 PHY JTAG;
- 01: SATA3 PHY0 JTAG;
- 10: SATA3 PHY1 JTAG;
- 11: COMB PHY JTAG.";
            sw = rw; hw = r;
            reset = 0x0;
        } jtag_fun_sel[31:30];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_29_13[29:13];
        field {
            name = "pcie_sata_mode_sel";
            desc = "PCIe function enable.
- 0: PCIe function off; SATA Port2 is enabled.
- 1: PCIe function enabled; SATA Port2 is off.";
            sw = rw; hw = r;
            reset = 0x1;
        } pcie_sata_mode_sel[12:12];
        field {
            name = "hdmi_audio_tx_sel";
            desc = "HDMI audio channel select.
- 0: The HDMI audio channel is connected to AIO TX0;
- 1: The HDMI audio channel is connected to AIO TX1.";
            sw = rw; hw = r;
            reset = 0x1;
        } hdmi_audio_tx_sel[11:11];
        field {
            name = "pad_i2c_tx_sel";
            desc = "AIO pin TX channel select.
- 0: The AIO pin TX channel is connected to AIO TX0;
- 1: The AIO pin TX channel is connected to AIO TX1.";
            sw = rw; hw = r;
            reset = 0x1;
        } pad_i2c_tx_sel[10:10];
        field {
            name = "audiocodec_tx_sel";
            desc = "Audio Codec TX path selection.
- 0: The Audio Codec Tx channel is connected to AIO TX0;
- 1: The Audio Codec Tx channel is connected to AIO TX1.";
            sw = rw; hw = r;
            reset = 0x0;
        } audiocodec_tx_sel[9:9];
        field {
            name = "aio_rx_sel";
            desc = "AIO RX path select.
- 0: The AIO RX path is connected to the internal Audio Codec.
- 1: The AIO RX path is connected to the AIO pins.";
            sw = rw; hw = r;
            reset = 0x0;
        } aio_rx_sel[8:8];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_7[7:7];
        field {
            name = "rom_pgen";
            desc = "ROM power supply enable.
- 0: Enable;
- 1: Disable.";
            sw = rw; hw = r;
            reset = 0x0;
        } rom_pgen[6:6];
        field {
            name = "ram2_ck_gt_en";
            desc = "RAM2 clock gate enable.
- 0: Disable;
- 1: Enable.";
            sw = rw; hw = r;
            reset = 0x0;
        } ram2_ck_gt_en[5:5];
        field {
            name = "ram1_ck_gt_en";
            desc = "RAM1 clock gating enable.
- 0: Disable;
- 1: Enable.";
            sw = rw; hw = r;
            reset = 0x0;
        } ram1_ck_gt_en[4:4];
        field {
            name = "ram0_ck_gt_en";
            desc = "RAM0 clock gate enable.
- 0: Disable;
- 1: Enable.";
            sw = rw; hw = r;
            reset = 0x0;
        } ram0_ck_gt_en[3:3];
        field {
            name = "mdu_ddrt_mst_sel";
            desc = "MDU and DDRT function select.
- 0: MDU enabled, DDRT disabled.
- 1: DDRT enabled, MDU disabled.";
            sw = rw; hw = r;
            reset = 0x0;
        } mdu_ddrt_mst_sel[2:2];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_1_1[1:1];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_0_0[0:0];
    } MISC_CTRL1 @ 0x4;
    reg {
        name = "MISC_CTRL2";
        desc = "MISC_CTRL2 is the CPU Memory speed adjustment register. This register is not reset by a system soft reset. MISC_CTRL2 (offset 0x0008, total reset 0x0211_D5D5; PROVEN: Hi3535 data sheet, PDF page 421, section 3.4.5.2).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_27[31:27];
        field {
            name = "l2_dataram_ema";
            desc = "MEM speed adjustment value, valid for both reads and writes. 000 is the fastest, 111 is the slowest. Note 1: this value can only be modified statically and must be set before the MEM runs. Note 2: setting this value below the default makes MEM reads and writes unreliable.";
            sw = rw; hw = r;
            reset = 0x2;
        } l2_dataram_ema[26:24];
        field {
            name = "l2_dataram_emaw";
            desc = "MEM write speed adjustment value. 00 is the fastest and 11 is the slowest. The total MEM write speed adjustment value is emaw+ema. Note 1: This value can only be modified statically and must be set before the MEM runs. Note 2: Setting this value lower than the default makes MEM reads and writes risky.";
            sw = rw; hw = r;
            reset = 0x0;
        } l2_dataram_emaw[23:22];
        field {
            name = "l2_tagram_delay";
            desc = "L2 TagRam speed adjustment control.";
            sw = rw; hw = r;
            reset = 0x1;
        } l2_tagram_delay[21:20];
        field {
            name = "a9_hsmem_adjust";
            desc = "A9 high-speed memory speed regulation control.";
            sw = rw; hw = r;
            reset = 0x1d5d5;
        } a9_hsmem_adjust[19:0];
    } MISC_CTRL2 @ 0x8;
    reg {
        name = "MISC_CTRL6";
        desc = "MISC_CTRL6 is system bus arbitration control register 0. MISC_CTRL6 (offset 0x0018, total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 422, section 3.4.5.2).";
        field {
            name = "sys_timeout_en_m2";
            desc = "Timeout count enable of system bus port M2 (AHB_SUBSYS).
- 0: Disable;
- 1: Enable.";
            sw = rw; hw = r;
            reset = 0x0;
        } sys_timeout_en_m2[31:31];
        field {
            name = "sys_timeout_value_m2";
            desc = "Timeout count value of system bus port M2 (AHB_SUBSYS). Count value = sys_timeout_value_m2 x 2.";
            sw = rw; hw = r;
            reset = 0x0;
        } sys_timeout_value_m2[30:16];
        field {
            name = "sys_timeout_en_m1";
            desc = "Timeout counter enable for system bus port M1 (CPU).
- 0: Disable;
- 1: Enable.";
            sw = rw; hw = r;
            reset = 0x0;
        } sys_timeout_en_m1[15:15];
        field {
            name = "sys_timeout_value_m1";
            desc = "Timeout count value of system bus port M1 (CPU). Count value = sys_timeout_value_m1 x 2.";
            sw = rw; hw = r;
            reset = 0x0;
        } sys_timeout_value_m1[14:0];
    } MISC_CTRL6 @ 0x18;
    reg {
        name = "MISC_CTRL7";
        desc = "MISC_CTRL7 is system bus arbitration control register 1. MISC_CTRL7 (offset 0x001C, total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 423, section 3.4.5.2).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_16[31:16];
        field {
            name = "sys_timeout_en_m3";
            desc = "Timeout counter enable of system bus port M3 (PCIE).
- 0: Disable.
- 1: Enable.";
            sw = rw; hw = r;
            reset = 0x0;
        } sys_timeout_en_m3[15:15];
        field {
            name = "sys_timeout_value_m3";
            desc = "Timeout count value of system bus port M3 (PCIE). Count value = sys_timeout_value_m3 x 2.";
            sw = rw; hw = r;
            reset = 0x0;
        } sys_timeout_value_m3[14:0];
    } MISC_CTRL7 @ 0x1c;
    reg {
        name = "MISC_CTRL8";
        desc = "MISC_CTRL8 is system bus priority register 0. MISC_CTRL8 (offset 0x0020, total reset 0x0000_0012; PROVEN: Hi3535 data sheet, PDF page 423, section 3.4.5.2).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_11[31:11];
        field {
            name = "sys_pri_m3";
            desc = "Priority of system bus port M3 (PCIE). 3 is the highest priority.";
            sw = rw; hw = r;
            reset = 0x0;
        } sys_pri_m3[10:8];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_7[7:7];
        field {
            name = "sys_pri_m2";
            desc = "Priority of system bus port M2 (AHB_SUBSYS). 3 is the highest priority.";
            sw = rw; hw = r;
            reset = 0x1;
        } sys_pri_m2[6:4];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_3_3[3:3];
        field {
            name = "sys_pri_m1";
            desc = "Priority of system bus M1 (CPU) port. 3 is the highest priority.";
            sw = rw; hw = r;
            reset = 0x2;
        } sys_pri_m1[2:0];
    } MISC_CTRL8 @ 0x20;
    reg {
        name = "MISC_CTRL9";
        desc = "MISC_CTRL9 is system bus priority register 1. MISC_CTRL9 (offset 0x0024, total reset 0x0001_2345; PROVEN: Hi3535 data sheet, PDF page 424, section 3.4.5.2).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_23[31:23];
        field {
            name = "sys_pri_s6";
            desc = "Bus access priority of system bus port S6 (HP_PERI). 7 is the highest priority.";
            sw = rw; hw = r;
            reset = 0x0;
        } sys_pri_s6[22:20];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_19_19[19:19];
        field {
            name = "sys_pri_s5";
            desc = "Bus access priority of system bus port S5 (PCIE). 7 is the highest priority.";
            sw = rw; hw = r;
            reset = 0x1;
        } sys_pri_s5[18:16];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_15_15[15:15];
        field {
            name = "sys_pri_s4";
            desc = "Bus access priority of system bus port S4 (DDR). 7 is the highest priority.";
            sw = rw; hw = r;
            reset = 0x2;
        } sys_pri_s4[14:12];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_11_11[11:11];
        field {
            name = "sys_pri_s3";
            desc = "Bus access priority of system bus port S3 (MEDIA). 7 is the highest priority.";
            sw = rw; hw = r;
            reset = 0x3;
        } sys_pri_s3[10:8];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_7[7:7];
        field {
            name = "sys_pri_s2";
            desc = "Bus access priority of system bus port S2 (APB_SUBSYS). 7 is the highest priority.";
            sw = rw; hw = r;
            reset = 0x4;
        } sys_pri_s2[6:4];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_3_3[3:3];
        field {
            name = "sys_pri_s1";
            desc = "Bus access priority of system bus port S1 (AHB_SUBSYS). 7 is the highest priority.";
            sw = rw; hw = r;
            reset = 0x5;
        } sys_pri_s1[2:0];
    } MISC_CTRL9 @ 0x24;
    reg {
        name = "MISC_CTRL11";
        desc = "MISC_CTRL11 is MEDIA0 bus arbitration control register 0. MISC_CTRL11 (offset 0x002C, total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 425, section 3.4.5.2).";
        field {
            name = "media0_timeout_en_m2";
            desc = "Timeout counting enable of MEDIA0 bus port M2 (VDH1).
- 0: Disable.
- 1: Enable.";
            sw = rw; hw = r;
            reset = 0x0;
        } media0_timeout_en_m2[31:31];
        field {
            name = "media0_timeout_value_m2";
            desc = "Timeout count value of MEDIA0 bus port M2 (VDH1). Count value = media0_timeout_value_m2 x 2.";
            sw = rw; hw = r;
            reset = 0x0;
        } media0_timeout_value_m2[30:16];
        field {
            name = "media0_timeout_en_m1";
            desc = "Timeout counter enable of MEDIA0 bus port M1 (VDH0).
- 0: Disable.
- 1: Enable.";
            sw = rw; hw = r;
            reset = 0x0;
        } media0_timeout_en_m1[15:15];
        field {
            name = "media0_timeout_value_m1";
            desc = "Timeout count value of MEDIA0 bus port M1 (VDH0). Count value = media0_timeout_value_m1 x 2.";
            sw = rw; hw = r;
            reset = 0x0;
        } media0_timeout_value_m1[14:0];
    } MISC_CTRL11 @ 0x2c;
    reg {
        name = "MISC_CTRL12";
        desc = "MISC_CTRL12 is MEDIA0 bus arbitration control register 1. MISC_CTRL12 (offset 0x0030, total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 426, section 3.4.5.2).";
        field {
            name = "media0_timeout_en_m4";
            desc = "Timeout counting enable of MEDIA0 bus port M4 (JPGD).
- 0: Disable.
- 1: Enable.";
            sw = rw; hw = r;
            reset = 0x0;
        } media0_timeout_en_m4[31:31];
        field {
            name = "media0_timeout_value_m4";
            desc = "Timeout count value of MEDIA0 bus port M4 (JPGD). Count value = media0_timeout_value_m4 x 2.";
            sw = rw; hw = r;
            reset = 0x0;
        } media0_timeout_value_m4[30:16];
        field {
            name = "media0_timeout_en_m3";
            desc = "Timeout count enable of MEDIA0 bus port M3 (TDE).
- 0: Disable;
- 1: Enable.";
            sw = rw; hw = r;
            reset = 0x0;
        } media0_timeout_en_m3[15:15];
        field {
