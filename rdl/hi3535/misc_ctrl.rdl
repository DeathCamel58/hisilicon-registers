            desc = "Timeout counter value of MEDIA0 bus port M3 (TDE). Count value = media0_timeout_value_m3 x 2.";
            sw = rw; hw = r;
            reset = 0x0;
        } media0_timeout_value_m3[14:0];
    } MISC_CTRL12 @ 0x30;
    reg {
        name = "MISC_CTRL13";
        desc = "MISC_CTRL13 is MEDIA0 bus arbitration control register 2. MISC_CTRL13 (offset 0x0034, total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 427, section 3.4.5.2).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_16[31:16];
        field {
            name = "media0_timeout_en_m5";
            desc = "Timeout count enable of MEDIA0 bus port M5 (MDU).
- 0: Disable;
- 1: Enable.";
            sw = rw; hw = r;
            reset = 0x0;
        } media0_timeout_en_m5[15:15];
        field {
            name = "media0_timeout_value_m5";
            desc = "Timeout count value of MEDIA0 bus port M5 (MDU). Count value = media0_timeout_value_m5 x 2.";
            sw = rw; hw = r;
            reset = 0x0;
        } media0_timeout_value_m5[14:0];
    } MISC_CTRL13 @ 0x34;
    reg {
        name = "MISC_CTRL14";
        desc = "MISC_CTRL14 is the MEDIA0 bus priority register. MISC_CTRL14 (offset 0x0038, total reset 0x0001_2345; PROVEN: Hi3535 data sheet, PDF page 427, section 3.4.5.2).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_19[31:19];
        field {
