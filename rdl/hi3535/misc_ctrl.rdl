            sw = rw; hw = r;
            reset = 0x1;
        } media0_pri_m5[18:16];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_15_15[15:15];
        field {
            name = "media0_pri_m4";
