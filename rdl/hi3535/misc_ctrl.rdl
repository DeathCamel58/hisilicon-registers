            desc = "Priority of MEDIA0 bus port M3 (TDE). 7 is the highest priority.";
            sw = rw; hw = r;
            reset = 0x3;
        } media0_pri_m3[10:8];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_7[7:7];
        field {
