        name = "PADCTRL_REG132";
        desc = "PADCTRL_REG132 is the VOU1120_CLK pin drive capability register. PADCTRL_REG132 (offset 0x0210, total reset 0x0000_0058; PROVEN: Hi3535 data sheet, PDF page 260, section 2.4.2).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_7[31:7];
        field {
            name = "vou1120_clk_ds";
            desc = "VOU1120_CLK pin drive current control.
- 000: 4.7 mA.
- 001: 7.0 mA.
- 010: 9.3 mA.
- 011: 11.6 mA.
- 100: 14.0 mA.
- 101: 16.3 mA.
- 110: 18.6 mA.
- 111: 20.9 mA.";
            sw = rw; hw = r;
            reset = 0x5;
        } vou1120_clk_ds[6:4];
        field {
            name = "vou1120_clk_sl";
            desc = "VOU1120_CLK pin slew rate control.
- 0: Slow edge;
- 1: Fast edge.";
            sw = rw; hw = r;
            reset = 0x1;
        } vou1120_clk_sl[3:3];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_2_0[2:0];
    } PADCTRL_REG132 @ 0x210;
};

