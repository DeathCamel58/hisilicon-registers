            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_7[31:7];
        field {
            name = "vga_hs_ds";
            desc = "VGA_HS pin drive current control.
- 000: 4.7mA;
- 001: 7.0mA;
- 010: 9.3mA;
- 011: 11.6mA;
- 100: 14.0mA;
- 101: 16.3mA;
- 110: 18.6mA;
- 111: 20.9mA.";
            sw = rw; hw = r;
            reset = 0x5;
        } vga_hs_ds[6:4];
        field {
            name = "vga_hs_sl";
            desc = "VGA_HS pin slew rate control.
- 0: Slow edge.
- 1: Fast edge.";
