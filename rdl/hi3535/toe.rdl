    reg {
        name = "DMAP_MISSED_FRAME_CTR";
        desc = "DMAP_MISSED_FRAME_CTR is the register of the two counters contained in DMAp (0 to 2) that track frames dropped during reception. This register holds the current values of the two counters, which are the dropped frame counts caused by the host receive buffer being unavailable and by FIFO overflow, respectively. DMAP_MISSED_FRAME_CTR (offset 0x1020+Px0x100 (P = 0~2), total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 856, section 5.6).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_29[31:29];
        field {
            name = "ob_fifo_overflow_cnt";
            desc = "Overflow indication signal of the FIFO overflow counter. (data sheet access type RC)";
            sw = r; hw = w; onread = rclr;
            reset = 0x0;
        } ob_fifo_overflow_cnt[28:28];
        field {
            name = "app_miss_frms";
            desc = "Indicates the number of frames discarded by the application. The counter increments by 1 each time the mtl_rxoverflow_o signal goes high; it is cleared when the counter is read and mci_be_i[2] is 1. (data sheet access type RC)";
            sw = r; hw = w; onread = rclr;
            reset = 0x0;
        } app_miss_frms[27:17];
        field {
            name = "ob_miss_frms_cnt";
            desc = "Overflow indication signal of the dropped frame counter. (data sheet access type RC)";
            sw = r; hw = w; onread = rclr;
            reset = 0x0;
        } ob_miss_frms_cnt[16:16];
        field {
            name = "ctrl_miss_frms";
            desc = "Indicates the number of frames dropped by the GMAC because no host receive buffer was available. The counter increments by 1 each time the DMA drops a received frame, and is cleared when the counter is read while mci_be_i[0] is 1. (data sheet access type RC)";
            sw = r; hw = w; onread = rclr;
            reset = 0x0;
        } ctrl_miss_frms[15:0];
    } DMAP_MISSED_FRAME_CTR_0 @ 0x1020;
