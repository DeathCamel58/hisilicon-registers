    reg {
        name = "DMAP_BUS_MODE";
        desc = "DMAP_BUS_MODE is the bus mode register. It specifies the bus operation mode of DMAp (0 to 2). DMAP_BUS_MODE (offset 0x1000+Px0x100 (P = 0~2), total reset 0x0002_0101; PROVEN: Hi3535 data sheet, PDF page 842, section 5.6).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_26[31:26];
        field {
            name = "aal";
            desc = "AAL: address-aligned beats.
- 0: Beats are not address-aligned;
- 1: Beats are address-aligned. When FB is 1, the AXI interface generates all addresses aligned to the start address LS burst; if FB is 0, the first address burst generated by the AXI interface is not aligned, but all subsequent addresses are aligned to the first address burst.";
            sw = rw; hw = r;
            reset = 0x0;
        } aal[25:25];
        field {
            name = "pblx8";
            desc = "pblx8: 8xPBL mode.
- 0: Not 8xPBL mode.
- 1: 8xPBL mode. When this bit is 1, the PBL value is determined by 8 times the product of bits [22:17] and bits [13:8]. The possible DMA transfers then include 8, 16, 32, 64, 128, and 256 burst operations.";
            sw = rw; hw = r;
            reset = 0x0;
        } pblx8[24:24];
        field {
            name = "usp";
            desc = "USP: use separate PBL.
- 0: Do not use separate PBL. TxDMA and RxDMA use bits [13:8] as the PBL;
- 1: Use separate PBL. Bits [22:17] are used as the RxDMA PBL and bits [13:8] are used as the TxDMA PBL.";
            sw = rw; hw = r;
            reset = 0x0;
        } usp[23:23];
        field {
            name = "rpbl";
            desc = "RPBL: RxDMA PBL. Indicates the maximum number of beats in a single RxDMA transaction, that is, the maximum burst length of a single block read or write operation. Each RxDMA burst always attempts to use the value determined by PBL. The selectable values are 1, 2, 4, 8, 16, and 32; other values may cause undefined behavior. When USP is set to 1, RxPBL is used only for RxDMA operations.";
            sw = rw; hw = r;
            reset = 0x1;
        } rpbl[22:17];
        field {
            name = "fb";
            desc = "FB: fixed burst mode. This bit controls whether the AXI master uses fixed burst mode.
- 0: Fixed burst mode is not used. The AXI can then use SINGLE or INCR burst operations;
- 1: Fixed burst mode is used.";
            sw = rw; hw = r;
            reset = 0x0;
        } fb[16:16];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_15_14[15:14];
        field {
            name = "pbl";
            desc = "PBL: programmable burst length. Indicates the maximum number of beats in a single DMA transaction, that is, the maximum burst length of a single module read or write operation. Each DMA burst always tries to execute with the value determined by PBL. The selectable values are 1, 2, 4, 8, 16 and 32; other values may cause undefined behavior. When USP is set to 1, PBL applies only to TxDMA operation. If operations longer than 32 bursts are needed, set 8xpbl. For example, for a 64-burst operation, set 8xpbl to 1 and pbl to 8.";
            sw = rw; hw = r;
            reset = 0x1;
        } pbl[13:8];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_7[7:7];
        field {
            name = "dsl";
            desc = "DSL: descriptor skip length. This field determines the number of words to skip between two non-chained descriptors. The length starts at the first byte of the current descriptor and ends at the first byte of the next adjacent descriptor. If the value is 0, ring mode is assumed.";
            sw = rw; hw = r;
            reset = 0x0;
        } dsl[6:2];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_1_1[1:1];
        field {
            name = "swr";
            desc = "SWR: soft reset.
- 0: Do not perform a soft reset;
- 1: Perform a soft reset. During a soft reset, the DMA controller resets the entire GMAC registers and logic. This bit is cleared automatically when the reset completes. No register may be written before the reset completes. (data sheet access type RWSC)";
            sw = rw; hw = r;
            reset = 0x1;
        } swr[0:0];
    } DMAP_BUS_MODE_0 @ 0x1000;
