`ifndef EHI3535_TOE_RDL
`define EHI3535_TOE_RDL
regfile eHI3535_TOE {
    name = "GMAC and TOE (TCP offload engine) registers";
    desc = "GMAC and TOE (TCP offload engine) registers. 82 registers extracted programmatically from the Hi3535 H.264 codec processor (Hi3535 user guide) data sheet (Issue 00B08, 2014-02-25); chapter 5.6, table 5-11. Field names, bit ranges, access types and reset values are taken from the register tables; reset values are the data sheet total reset values split onto the fields (per-field values where the table has them). Label: PROVEN. Hardware not verified here (no board).";
    reg {
        name = "GMACN_CTRL_REG";
        desc = "GMACN_CTRL_REG is the configuration register of GMACn (0 to 1). It configures the operating modes of receive and transmit. GMACN_CTRL_REG (offset 0x0000+Nx0x4000 (N = 0~1), total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 810, section 5.6).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_16[31:16];
        field {
            name = "ps";
            desc = "PS: port select, selects between GMII and MII.
- 0: GMII (1000 Mbps);
- 1: MII (10/100 Mbps).";
            sw = rw; hw = r;
            reset = 0x0;
        } ps[15:15];
        field {
            name = "fes";
            desc = "FES: Speed, indicating the speed in FE (MII mode).
- 0: 10 Mbps;
- 1: 100 Mbps, valid only in RGMII mode.";
            sw = rw; hw = r;
            reset = 0x0;
        } fes[14:14];
        field {
            name = "do";
            desc = "DO: disable receiving own frames. When this bit is set to 1, the GMAC disables frame reception while it asserts gmii_txen_o in half-duplex mode. This bit has no effect in full-duplex mode.
- 0: In half-duplex mode, frame reception is enabled when gmii_txen_o is 1;
- 1: In half-duplex mode, frame reception is disabled when gmii_txen_o is 1.";
            sw = rw; hw = r;
            reset = 0x0;
        } do[13:13];
        field {
            name = "lm";
            desc = "LM: Loopback mode. In GMII/MII mode, when this bit is set to 1, the GMAC operates in loopback mode.
- 0: The GMAC does not operate in loopback mode.
- 1: The GMAC operates in loopback mode.";
            sw = rw; hw = r;
            reset = 0x0;
        } lm[12:12];
        field {
            name = "dm";
            desc = "DM: Duplex mode.
- 0: Half-duplex mode;
- 1: Full-duplex mode.";
            sw = rw; hw = r;
            reset = 0x0;
        } dm[11:11];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_10_10[10:10];
        field {
            name = "dr";
            desc = "DR: Disable retry. When this bit is set to 1, the GMAC makes only one transmission attempt. On a collision in half-duplex mode, the GMAC ignores the transmission of the current frame and reports a collision event. When this bit is 0, the GMAC retries according to the BL setting (bit[6:5]).
- 0: Retry on collision in half-duplex mode;
- 1: Do not retry on collision in half-duplex mode.";
            sw = rw; hw = r;
            reset = 0x0;
        } dr[9:9];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_8_7[8:7];
        field {
            name = "bl";
            desc = "BL: back-off limit. The back-off limit determines the random integer multiple of the slot time delay (4,096 bit times for 1000 Mbps and 512 bit times for 10/100 Mbps) that the GMAC waits before a retransmission attempt after a collision. Valid only in half-duplex mode.
- 00: k = min (n, 10);
- 01: k = min (n, 8);
- 10: k = min (n, 4);
- 11: k = min (n, 1).
Here n is the number of retransmission attempts, and the random variable r is in the range 0 ≤ r < 2k (2 to the power k)";
            sw = rw; hw = r;
            reset = 0x0;
        } bl[6:5];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_4_4[4:4];
        field {
            name = "te";
            desc = "TE: transmit enable.
- 0: Transmit disabled; the GMAC stops after finishing the current frame and sends no further frames;
- 1: Transmit enabled; the internal GMAC transmit state machine is enabled.";
            sw = rw; hw = r;
            reset = 0x0;
        } te[3:3];
        field {
            name = "re";
            desc = "RE: Receive enable.
- 0: Receive disabled; the GMAC stops after finishing the reception of the current frame and no longer receives subsequent frames.
- 1: Receive enabled; the internal receive state machine of the GMAC is enabled.";
            sw = rw; hw = r;
            reset = 0x0;
        } re[2:2];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_1_0[1:0];
    } GMACN_CTRL_REG_0 @ 0x0;
    reg {
        name = "GMACN_CTRL_REG";
        desc = "GMACN_CTRL_REG is the configuration register of GMACn (0 to 1). It configures the operating modes of receive and transmit. GMACN_CTRL_REG (offset 0x0000+Nx0x4000 (N = 0~1), total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 810, section 5.6).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_16[31:16];
        field {
            name = "ps";
            desc = "PS: port select, selects between GMII and MII.
- 0: GMII (1000 Mbps);
- 1: MII (10/100 Mbps).";
            sw = rw; hw = r;
            reset = 0x0;
        } ps[15:15];
        field {
            name = "fes";
            desc = "FES: Speed, indicating the speed in FE (MII mode).
- 0: 10 Mbps;
- 1: 100 Mbps, valid only in RGMII mode.";
            sw = rw; hw = r;
            reset = 0x0;
        } fes[14:14];
        field {
            name = "do";
            desc = "DO: disable receiving own frames. When this bit is set to 1, the GMAC disables frame reception while it asserts gmii_txen_o in half-duplex mode. This bit has no effect in full-duplex mode.
- 0: In half-duplex mode, frame reception is enabled when gmii_txen_o is 1;
- 1: In half-duplex mode, frame reception is disabled when gmii_txen_o is 1.";
            sw = rw; hw = r;
            reset = 0x0;
        } do[13:13];
        field {
            name = "lm";
            desc = "LM: Loopback mode. In GMII/MII mode, when this bit is set to 1, the GMAC operates in loopback mode.
- 0: The GMAC does not operate in loopback mode.
- 1: The GMAC operates in loopback mode.";
            sw = rw; hw = r;
            reset = 0x0;
        } lm[12:12];
        field {
            name = "dm";
            desc = "DM: Duplex mode.
- 0: Half-duplex mode;
- 1: Full-duplex mode.";
            sw = rw; hw = r;
            reset = 0x0;
        } dm[11:11];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_10_10[10:10];
        field {
            name = "dr";
            desc = "DR: Disable retry. When this bit is set to 1, the GMAC makes only one transmission attempt. On a collision in half-duplex mode, the GMAC ignores the transmission of the current frame and reports a collision event. When this bit is 0, the GMAC retries according to the BL setting (bit[6:5]).
- 0: Retry on collision in half-duplex mode;
- 1: Do not retry on collision in half-duplex mode.";
            sw = rw; hw = r;
            reset = 0x0;
        } dr[9:9];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_8_7[8:7];
        field {
            name = "bl";
            desc = "BL: back-off limit. The back-off limit determines the random integer multiple of the slot time delay (4,096 bit times for 1000 Mbps and 512 bit times for 10/100 Mbps) that the GMAC waits before a retransmission attempt after a collision. Valid only in half-duplex mode.
- 00: k = min (n, 10);
- 01: k = min (n, 8);
- 10: k = min (n, 4);
- 11: k = min (n, 1).
Here n is the number of retransmission attempts, and the random variable r is in the range 0 ≤ r < 2k (2 to the power k)";
            sw = rw; hw = r;
            reset = 0x0;
        } bl[6:5];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_4_4[4:4];
        field {
            name = "te";
            desc = "TE: transmit enable.
- 0: Transmit disabled; the GMAC stops after finishing the current frame and sends no further frames;
- 1: Transmit enabled; the internal GMAC transmit state machine is enabled.";
            sw = rw; hw = r;
            reset = 0x0;
        } te[3:3];
        field {
            name = "re";
            desc = "RE: Receive enable.
- 0: Receive disabled; the GMAC stops after finishing the reception of the current frame and no longer receives subsequent frames.
- 1: Receive enabled; the internal receive state machine of the GMAC is enabled.";
            sw = rw; hw = r;
            reset = 0x0;
        } re[2:2];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_1_0[1:0];
    } GMACN_CTRL_REG_1 @ 0x4000;
    reg {
        name = "GMACN_FRAME_FILTER";
        desc = "GMACN_FRAME_FILTER is the frame filter register of GMACn (0 to 1). It contains the filtering controls for received frames. GMACN_FRAME_FILTER (offset 0x0004+Nx0x4000 (N = 0~1), total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 812, section 5.6).";
        field {
            name = "ra";
            desc = "RA: receive all.
- 0: The GMAC forwards only frames that pass the SA/DA filter to the CPU.
- 1: The GMAC forwards all frames to the CPU and writes the SA/DA filter status back to the descriptor.";
            sw = rw; hw = r;
            reset = 0x0;
        } ra[31:31];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_30_11[30:11];
        field {
            name = "hpf";
            desc = "HPF: hash or perfect filtering.
- 0: If the HUC/HMC bit is set to 1, the current frame passes filtering only when it meets the hash filtering condition;
- 1: When this bit is set to 1, if the current frame meets the hash filtering or the perfect filtering condition, it passes the address filter.";
            sw = rw; hw = r;
            reset = 0x0;
        } hpf[10:10];
        field {
            name = "saf";
            desc = "SAF: Source address filter enable.
- 0: The GMAC forwards the current frame to the CPU and writes the SA filter status back to the receive status in the descriptor.
- 1: The GMAC drops frames that fail the SA filter.";
            sw = rw; hw = r;
            reset = 0x0;
        } saf[9:9];
        field {
            name = "saif";
            desc = "SAIF: SA inverse filtering.
- 0: If the SA of a frame does not match the SA register, the frame is marked as failing the SA filter.
- 1: The address check module works in inverse mode: if the SA of a frame matches the SA register, the frame is marked as failing the SA filter.";
            sw = rw; hw = r;
            reset = 0x0;
        } saif[8:8];
        field {
            name = "pcf";
            desc = "PCF: pass control frames. These bits control the forwarding of all control frames (including all unicast and multicast pause frames).
- 00: The GMAC filters out all control frames arriving at the application;
- 01: The GMAC forwards all control frames except pause frames to the CPU, even if they fail address filtering;
- 10: The GMAC forwards all control frames to the CPU, even if they fail address filtering;
- 11: The GMAC forwards all control frames that pass address filtering to the CPU.";
            sw = rw; hw = r;
            reset = 0x0;
        } pcf[7:6];
        field {
            name = "dbf";
            desc = "DBF: disable broadcast frames.
- 0: Do not filter any received broadcast frames;
- 1: Filter all incoming broadcast frames and ignore other filter settings.";
            sw = rw; hw = r;
            reset = 0x0;
        } dbf[5:5];
        field {
            name = "pm";
            desc = "PM: Pass all multicast.
- 0: Multicast frames are filtered according to the HMC bit setting.
- 1: Pass all multicast frames.";
            sw = rw; hw = r;
            reset = 0x0;
        } pm[4:4];
        field {
            name = "daif";
            desc = "DAIF: DA inverse filtering.
- 0: If the DA of a frame does not match the DA registers, the frame is marked as failing DA filtering;
- 1: The address check module works in inverse mode: if the DA of a frame matches the DA registers, the frame is marked as failing DA filtering.";
            sw = rw; hw = r;
            reset = 0x0;
        } daif[3:3];
        field {
            name = "hmc";
            desc = "HMC: hash multicast.
- 0: The GMAC performs DA filtering of received multicast frames according to the DA register.
- 1: The GMAC performs DA filtering of received multicast frames according to the hash table.";
            sw = rw; hw = r;
            reset = 0x0;
        } hmc[2:2];
        field {
            name = "huc";
            desc = "HUC: hash unicast.
- 0: The GMAC performs DA filtering of received unicast frames according to the DA register.
- 1: The GMAC performs DA filtering of received unicast frames according to the hash table.";
            sw = rw; hw = r;
            reset = 0x0;
        } huc[1:1];
        field {
            name = "pr";
            desc = "PR: promiscuous mode. In this mode all incoming received frames are forwarded to the CPU, and the receive status is always 0.
- 0: Not in promiscuous mode;
- 1: In promiscuous mode.";
            sw = rw; hw = r;
            reset = 0x0;
        } pr[0:0];
    } GMACN_FRAME_FILTER_0 @ 0x4;
    reg {
        name = "GMACN_FRAME_FILTER";
        desc = "GMACN_FRAME_FILTER is the frame filter register of GMACn (0 to 1). It contains the filtering controls for received frames. GMACN_FRAME_FILTER (offset 0x0004+Nx0x4000 (N = 0~1), total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 812, section 5.6).";
        field {
            name = "ra";
            desc = "RA: receive all.
- 0: The GMAC forwards only frames that pass the SA/DA filter to the CPU.
- 1: The GMAC forwards all frames to the CPU and writes the SA/DA filter status back to the descriptor.";
            sw = rw; hw = r;
            reset = 0x0;
        } ra[31:31];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_30_11[30:11];
        field {
            name = "hpf";
            desc = "HPF: hash or perfect filtering.
- 0: If the HUC/HMC bit is set to 1, the current frame passes filtering only when it meets the hash filtering condition;
- 1: When this bit is set to 1, if the current frame meets the hash filtering or the perfect filtering condition, it passes the address filter.";
            sw = rw; hw = r;
            reset = 0x0;
        } hpf[10:10];
        field {
            name = "saf";
            desc = "SAF: Source address filter enable.
- 0: The GMAC forwards the current frame to the CPU and writes the SA filter status back to the receive status in the descriptor.
- 1: The GMAC drops frames that fail the SA filter.";
            sw = rw; hw = r;
            reset = 0x0;
        } saf[9:9];
        field {
            name = "saif";
            desc = "SAIF: SA inverse filtering.
- 0: If the SA of a frame does not match the SA register, the frame is marked as failing the SA filter.
- 1: The address check module works in inverse mode: if the SA of a frame matches the SA register, the frame is marked as failing the SA filter.";
            sw = rw; hw = r;
            reset = 0x0;
        } saif[8:8];
        field {
            name = "pcf";
            desc = "PCF: pass control frames. These bits control the forwarding of all control frames (including all unicast and multicast pause frames).
- 00: The GMAC filters out all control frames arriving at the application;
- 01: The GMAC forwards all control frames except pause frames to the CPU, even if they fail address filtering;
- 10: The GMAC forwards all control frames to the CPU, even if they fail address filtering;
- 11: The GMAC forwards all control frames that pass address filtering to the CPU.";
            sw = rw; hw = r;
            reset = 0x0;
        } pcf[7:6];
        field {
            name = "dbf";
            desc = "DBF: disable broadcast frames.
- 0: Do not filter any received broadcast frames;
- 1: Filter all incoming broadcast frames and ignore other filter settings.";
            sw = rw; hw = r;
            reset = 0x0;
        } dbf[5:5];
        field {
            name = "pm";
            desc = "PM: Pass all multicast.
- 0: Multicast frames are filtered according to the HMC bit setting.
- 1: Pass all multicast frames.";
            sw = rw; hw = r;
            reset = 0x0;
        } pm[4:4];
        field {
            name = "daif";
            desc = "DAIF: DA inverse filtering.
- 0: If the DA of a frame does not match the DA registers, the frame is marked as failing DA filtering;
- 1: The address check module works in inverse mode: if the DA of a frame matches the DA registers, the frame is marked as failing DA filtering.";
            sw = rw; hw = r;
            reset = 0x0;
        } daif[3:3];
        field {
            name = "hmc";
            desc = "HMC: hash multicast.
- 0: The GMAC performs DA filtering of received multicast frames according to the DA register.
- 1: The GMAC performs DA filtering of received multicast frames according to the hash table.";
            sw = rw; hw = r;
            reset = 0x0;
        } hmc[2:2];
        field {
            name = "huc";
            desc = "HUC: hash unicast.
- 0: The GMAC performs DA filtering of received unicast frames according to the DA register.
- 1: The GMAC performs DA filtering of received unicast frames according to the hash table.";
            sw = rw; hw = r;
            reset = 0x0;
        } huc[1:1];
        field {
            name = "pr";
            desc = "PR: promiscuous mode. In this mode all incoming received frames are forwarded to the CPU, and the receive status is always 0.
- 0: Not in promiscuous mode;
- 1: In promiscuous mode.";
            sw = rw; hw = r;
            reset = 0x0;
        } pr[0:0];
    } GMACN_FRAME_FILTER_1 @ 0x4004;
    reg {
        name = "GMACN_GMII_ADDR";
        desc = "GMACN_GMII_ADDR is the GMII address register. It accesses the external PHY through the MDIO interface. GMACN_GMII_ADDR (offset 0x0010+Nx0x4000 (N = 0~1), total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 813, section 5.6).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_16[31:16];
        field {
            name = "pa";
            desc = "PA: Physical layer address. Distinguishes among the 32 external PHYs that may be accessed.";
            sw = rw; hw = r;
            reset = 0x0;
        } pa[15:11];
        field {
            name = "gr";
            desc = "GR: GMII register. Selects the register of the PHY being accessed.";
            sw = rw; hw = r;
            reset = 0x0;
        } gr[10:6];
        field {
            name = "cr";
            desc = "CR: CSR clock range. The CSR clock range determines the frequency of the MDC clock. When bit[5] is 0, the recommended CSR clock ranges that keep the MDC clock within its operating range (1.0 MHz to 2.5 MHz) are as follows. Select CSR clock MDC clock 0000 60-100 MHz clk_csr_i/42 0001 100-150 MHz clk_csr_i/62 0010 20-35 MHz clk_csr_i/16 0011 35-60 MHz clk_csr_i/26 0100 150-250 MHz clk_csr_i/102 0101 250-300 MHz clk_csr_i/124 0110,0111: Reserved. When bit[5] is 1, the MDC clock may exceed the 2.5 MHz clock limit specified by IEEE 802.3. Select MDC clock 1000 clk_csr_i/4 1001 clk_csr_i/6 1010 clk_csr_i/8 1011 clk_csr_i/10 1100 clk_csr_i/12 1101 clk_csr_i/14 1110 clk_csr_i/16 1111 clk_csr_i/18";
            sw = rw; hw = r;
            reset = 0x0;
        } cr[5:2];
        field {
            name = "gw";
            desc = "GW: GMII write.
- 0: Read operation.
- 1: Write operation.";
            sw = rw; hw = r;
            reset = 0x0;
        } gw[1:1];
        field {
            name = "gb";
            desc = "GB: GMII busy. Before writing the GMACn_GMII_DATA and GMACn_GMII_ADDR registers, this bit must read back as 0. While accessing the external PHY, software must keep this bit set to 1. The value of GMACn_GMII_DATA is valid only after the GMAC sets this bit to 0.
- 0: GMII busy;
- 1: GMII idle, read and write operations can be performed. (data sheet access type RWSC)";
            sw = rw; hw = r;
            reset = 0x0;
        } gb[0:0];
    } GMACN_GMII_ADDR_0 @ 0x10;
    reg {
        name = "GMACN_GMII_ADDR";
        desc = "GMACN_GMII_ADDR is the GMII address register. It accesses the external PHY through the MDIO interface. GMACN_GMII_ADDR (offset 0x0010+Nx0x4000 (N = 0~1), total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 813, section 5.6).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_16[31:16];
        field {
            name = "pa";
            desc = "PA: Physical layer address. Distinguishes among the 32 external PHYs that may be accessed.";
            sw = rw; hw = r;
            reset = 0x0;
        } pa[15:11];
        field {
            name = "gr";
            desc = "GR: GMII register. Selects the register of the PHY being accessed.";
            sw = rw; hw = r;
            reset = 0x0;
        } gr[10:6];
        field {
            name = "cr";
            desc = "CR: CSR clock range. The CSR clock range determines the frequency of the MDC clock. When bit[5] is 0, the recommended CSR clock ranges that keep the MDC clock within its operating range (1.0 MHz to 2.5 MHz) are as follows. Select CSR clock MDC clock 0000 60-100 MHz clk_csr_i/42 0001 100-150 MHz clk_csr_i/62 0010 20-35 MHz clk_csr_i/16 0011 35-60 MHz clk_csr_i/26 0100 150-250 MHz clk_csr_i/102 0101 250-300 MHz clk_csr_i/124 0110,0111: Reserved. When bit[5] is 1, the MDC clock may exceed the 2.5 MHz clock limit specified by IEEE 802.3. Select MDC clock 1000 clk_csr_i/4 1001 clk_csr_i/6 1010 clk_csr_i/8 1011 clk_csr_i/10 1100 clk_csr_i/12 1101 clk_csr_i/14 1110 clk_csr_i/16 1111 clk_csr_i/18";
            sw = rw; hw = r;
            reset = 0x0;
        } cr[5:2];
        field {
            name = "gw";
            desc = "GW: GMII write.
- 0: Read operation.
- 1: Write operation.";
            sw = rw; hw = r;
            reset = 0x0;
        } gw[1:1];
        field {
            name = "gb";
            desc = "GB: GMII busy. Before writing the GMACn_GMII_DATA and GMACn_GMII_ADDR registers, this bit must read back as 0. While accessing the external PHY, software must keep this bit set to 1. The value of GMACn_GMII_DATA is valid only after the GMAC sets this bit to 0.
- 0: GMII busy;
- 1: GMII idle, read and write operations can be performed. (data sheet access type RWSC)";
            sw = rw; hw = r;
            reset = 0x0;
        } gb[0:0];
    } GMACN_GMII_ADDR_1 @ 0x4010;
    reg {
        name = "GMACN_GMII_DATA";
        desc = "GMACN_GMII_DATA is the GMII data register. It stores the data to be written to the external PHY specific register (determined by GMACn_GMII_ADDR), and can also store the data read from the external PHY specific register. GMACN_GMII_DATA (offset 0x0014+Nx0x4000 (N = 0~1), total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 815, section 5.6).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_16[31:16];
        field {
            name = "gd";
            desc = "GD: GMII data. This data is the data read from the external PHY register after a read operation, or the data to be written to the external PHY register before a write operation.";
            sw = rw; hw = r;
            reset = 0x0;
        } gd[15:0];
    } GMACN_GMII_DATA_0 @ 0x14;
    reg {
        name = "GMACN_GMII_DATA";
        desc = "GMACN_GMII_DATA is the GMII data register. It stores the data to be written to the external PHY specific register (determined by GMACn_GMII_ADDR), and can also store the data read from the external PHY specific register. GMACN_GMII_DATA (offset 0x0014+Nx0x4000 (N = 0~1), total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 815, section 5.6).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_16[31:16];
        field {
            name = "gd";
            desc = "GD: GMII data. This data is the data read from the external PHY register after a read operation, or the data to be written to the external PHY register before a write operation.";
            sw = rw; hw = r;
            reset = 0x0;
        } gd[15:0];
    } GMACN_GMII_DATA_1 @ 0x4014;
    reg {
        name = "GMACN_ADDR0_HIGH";
        desc = "GMACN_ADDR0_HIGH is the register holding the high 16 bits [47:32] of the first MAC address of GMACn (0 to 1). GMACN_ADDR0_HIGH (offset 0x0040+Nx0x4000 (N = 0~1), total reset 0x8000_FFFF; PROVEN: Hi3535 data sheet, PDF page 815, section 5.6).";
        field {
            name = "mo";
            desc = "MO: constant 1.";
            sw = r; hw = w;
            reset = 0x1;
        } mo[31:31];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_30_16[30:16];
        field {
            name = "a_47_32";
            desc = "A[47:32]: Contains the upper 16 bits [47:32] of the 6-byte MAC address, used for receive frame filtering and for transmitting pause frames.";
            sw = rw; hw = r;
            reset = 0xffff;
        } a_47_32[15:0];
    } GMACN_ADDR0_HIGH_0 @ 0x40;
    reg {
        name = "GMACN_ADDR0_HIGH";
        desc = "GMACN_ADDR0_HIGH is the register holding the high 16 bits [47:32] of the first MAC address of GMACn (0 to 1). GMACN_ADDR0_HIGH (offset 0x0040+Nx0x4000 (N = 0~1), total reset 0x8000_FFFF; PROVEN: Hi3535 data sheet, PDF page 815, section 5.6).";
