            sw = rw; hw = r;
            reset = 0xffff;
        } a_47_32[15:0];
    } GMACN_ADDR0_HIGH_1 @ 0x4040;
    reg {
        name = "GMACN_ADDRX_HIGH";
        desc = "GMACN_ADDRX_HIGH is the register for the high 16 bits [47:32] of the X-th (1 to 15) MAC address of GMACn (0 to 1). GMACN_ADDRX_HIGH (offset 0x0048+Xx0x8 (X = 0~14), total reset 0x0000_FFFF; PROVEN: Hi3535 data sheet, PDF page 816, section 5.6). Registers for X = 1..15 (offset 0x40 + n x 0x4000 + X x 0x8; instances 0..14 below are X = 1..15). Address registers 1-15 (X) and 16-31 (Y) of GMAC n sit at the formula offsets of the data sheet (0x40 + n x 0x4000 + X x 0x8 / 0x780 + n x 0x4000 + Y x 0x8); modelled for GMAC 0 as 15 resp. 16 instances, GMAC 1 is the same layout 0x4000 higher.";
        field {
            name = "ae";
            desc = "AE: address enable.
- 0: When this bit is 0, the address filter module ignores this MAC address;
- 1: When this bit is 1, the address filter module uses this MAC address for perfect filtering.";
            sw = rw; hw = r;
            reset = 0x0;
        } ae[31:31];
        field {
            name = "sa";
            desc = "SA: source address.
- 0: This MAC address is used for comparison with the DA of received frames.
- 1: This MAC address is used for comparison with the SA of received frames.";
            sw = rw; hw = r;
            reset = 0x0;
        } sa[30:30];
        field {
            name = "mbc";
            desc = "MBC: mask byte control. These bits are the mask control bits for each byte of the MAC address. Each bit means:
- 0: The GMAC uses this byte for address filtering;
- 1: The GMAC does not use this byte for address filtering.
The MAC address byte corresponding to each bit is as follows: bit[29]: byte 6 of the MAC address [47:40]; bit[28]: byte 5 of the MAC address [39:32]; bit[27]: byte 4 of the MAC address [31:24]; bit[26]: byte 3 of the MAC address [23:16]; bit[25]: byte 2 of the MAC address [15:8]; bit[24]: byte 1 of the MAC address [7:0].";
            sw = rw; hw = r;
            reset = 0x0;
        } mbc[29:24];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_23_16[23:16];
        field {
            name = "mac_addr_h16";
            desc = "A[47:32]: Contains the upper 16 bits [47:32] of the 6-byte MAC address, used for receive frame filtering and for transmitting pause frames.";
            sw = rw; hw = r;
            reset = 0xffff;
        } mac_addr_h16[15:0];
    } GMACN_ADDRX_HIGH_0 @ 0x48;
