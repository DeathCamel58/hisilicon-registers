    reg {
        name = "GMACN_MMC_CTRL";
        desc = "GMACN_MMC_CTRL is the MMC control register. It sets the operating mode of the management counters. GMACN_MMC_CTRL (offset 0x0100+Nx0x4000 (N = 0~1), total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 819, section 5.6).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_6[31:6];
        field {
            name = "fh_pre";
            desc = "Full-Half preset
- 0: When cnt_pre is 1, all MMC counters are preset to a nearly half-full value. All byte counters are preset to 0x7FFF_F800 (half-full minus 2048), and all frame counters are preset to 0x7FFF_FFF0 (half-full minus 16).
- 1: When cnt_pre is 1, all MMC counters are preset to a nearly full value. All byte counters are preset to 0xFFFF_F800 (full minus 2048), and all frame counters are preset to 0xFFFF_FFF0 (full minus 16). For 16-bit byte counters, the nearly half-full value is 0x7800 and the nearly full value is 0xF800; for 16-bit frame counters, the nearly half-full value is 0x7FF0 and the nearly full value is 0xFFF0.";
            sw = rw; hw = r;
            reset = 0x0;
        } fh_pre[5:5];
        field {
            name = "cnt_pre";
            desc = "Counter preset.
- 0: Do not preset the counters;
- 1: Preset the counters. When this bit is 1, all counters are initialized to an almost-full or almost-half-full value according to the fh_pre setting. This bit is cleared automatically after one cycle and is mainly used to debug MMC counter interrupts. (data sheet access type RWSC)";
            sw = rw; hw = r;
            reset = 0x0;
        } cnt_pre[4:4];
        field {
            name = "mmc_cf";
            desc = "MMC counter freeze.
- 0: Do not freeze the MMC counters.
- 1: Freeze the MMC counters. All MMC counters are then not updated until this bit is set to 0 again. While this bit is 1, all MMC counters can be cleared on read.";
            sw = rw; hw = r;
            reset = 0x0;
        } mmc_cf[3:3];
        field {
            name = "rst_on_rd";
            desc = "Read reset.
- 0: Do not perform a read reset.
- 1: Perform a read reset. The MMC counters are automatically reset to zero after the read operation completes.";
            sw = rw; hw = r;
            reset = 0x0;
        } rst_on_rd[2:2];
        field {
            name = "cnt_sr";
            desc = "Counter wrap stop.
- 0: The counter wraps around automatically; it returns to zero after reaching the maximum value;
- 1: The counter stops wrapping. It does not return to zero after reaching the maximum value.";
            sw = rw; hw = r;
            reset = 0x0;
        } cnt_sr[1:1];
        field {
            name = "cnt_rst";
            desc = "Counter reset.
- 0: Do not reset the counters.
- 1: Reset the counters. All counters are cleared, and this bit is cleared automatically after one cycle. (data sheet access type RWSC)";
            sw = rw; hw = r;
            reset = 0x0;
        } cnt_rst[0:0];
    } GMACN_MMC_CTRL_0 @ 0x100;
    reg {
