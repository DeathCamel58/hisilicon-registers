            desc = "AAL: address-aligned beats.
- 0: Beats are not address-aligned;
- 1: Beats are address-aligned. When FB is 1, the AXI interface generates all addresses aligned to the start address LS burst; if FB is 0, the first address burst generated by the AXI interface is not aligned, but all subsequent addresses are aligned to the first address burst.";
            sw = rw; hw = r;
            reset = 0x0;
        } aal[25:25];
        field {
            name = "pblx8";
            desc = "pblx8: 8xPBL mode.
- 0: Not 8xPBL mode.
- 1: 8xPBL mode. When this bit is 1, the PBL value is determined by 8 times the product of bits [22:17] and bits [13:8]. The possible DMA transfers then include 8, 16, 32, 64, 128, and 256 burst operations.";
            sw = rw; hw = r;
            reset = 0x0;
        } pblx8[24:24];
        field {
            name = "usp";
            desc = "USP: use separate PBL.
- 0: Do not use separate PBL. TxDMA and RxDMA use bits [13:8] as the PBL;
- 1: Use separate PBL. Bits [22:17] are used as the RxDMA PBL and bits [13:8] are used as the TxDMA PBL.";
            sw = rw; hw = r;
            reset = 0x0;
        } usp[23:23];
        field {
            name = "rpbl";
            desc = "RPBL: RxDMA PBL. Indicates the maximum number of beats in a single RxDMA transaction, that is, the maximum burst length of a single block read or write operation. Each RxDMA burst always attempts to use the value determined by PBL. The selectable values are 1, 2, 4, 8, 16, and 32; other values may cause undefined behavior. When USP is set to 1, RxPBL is used only for RxDMA operations.";
            sw = rw; hw = r;
            reset = 0x1;
        } rpbl[22:17];
        field {
            name = "fb";
            desc = "FB: fixed burst mode. This bit controls whether the AXI master uses fixed burst mode.
- 0: Fixed burst mode is not used. The AXI can then use SINGLE or INCR burst operations;
- 1: Fixed burst mode is used.";
            sw = rw; hw = r;
            reset = 0x0;
        } fb[16:16];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_15_14[15:14];
        field {
            name = "pbl";
            desc = "PBL: programmable burst length. Indicates the maximum number of beats in a single DMA transaction, that is, the maximum burst length of a single module read or write operation. Each DMA burst always tries to execute with the value determined by PBL. The selectable values are 1, 2, 4, 8, 16 and 32; other values may cause undefined behavior. When USP is set to 1, PBL applies only to TxDMA operation. If operations longer than 32 bursts are needed, set 8xpbl. For example, for a 64-burst operation, set 8xpbl to 1 and pbl to 8.";
            sw = rw; hw = r;
            reset = 0x1;
        } pbl[13:8];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_7[7:7];
        field {
            name = "dsl";
            desc = "DSL: descriptor skip length. This field determines the number of words to skip between two non-chained descriptors. The length starts at the first byte of the current descriptor and ends at the first byte of the next adjacent descriptor. If the value is 0, ring mode is assumed.";
            sw = rw; hw = r;
            reset = 0x0;
        } dsl[6:2];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_1_1[1:1];
        field {
            name = "swr";
            desc = "SWR: soft reset.
- 0: Do not perform a soft reset;
- 1: Perform a soft reset. During a soft reset, the DMA controller resets the entire GMAC registers and logic. This bit is cleared automatically when the reset completes. No register may be written before the reset completes. (data sheet access type RWSC)";
            sw = rw; hw = r;
            reset = 0x1;
        } swr[0:0];
    } DMAP_BUS_MODE_2 @ 0x1200;
    reg {
        name = "DMAP_XMT_POLL_DEMAND";
        desc = "DMAP_XMT_POLL_DEMAND is the transmit poll demand register. It enables the TxDMA to check whether the current descriptor belongs to the DMA. This command wakes up a TxDMA in the suspended state. The TxDMA usually enters the suspended state because of a FIFO underflow or no available transmit descriptor. Once the TxDMA starts fetching descriptors from host memory again, this register can be written at any time. DMAP_XMT_POLL_DEMAND (offset 0x1004+Px0x100 (P = 0~2), total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 844, section 5.6).";
        field {
            name = "tpd";
            desc = "TPD: transmit poll demand. When any value is written to this register, the DMA reads the current transmit descriptor address. If the current descriptor is unavailable (own bit is 0), the transmit state machine enters the suspended state; otherwise, if the current descriptor is available, the transmit state machine resumes. (data sheet access type ROWT)";
            sw = rw; hw = r;
            reset = 0x0;
        } tpd[31:0];
    } DMAP_XMT_POLL_DEMAND_0 @ 0x1004;
    reg {
        name = "DMAP_XMT_POLL_DEMAND";
        desc = "DMAP_XMT_POLL_DEMAND is the transmit poll demand register. It enables the TxDMA to check whether the current descriptor belongs to the DMA. This command wakes up a TxDMA in the suspended state. The TxDMA usually enters the suspended state because of a FIFO underflow or no available transmit descriptor. Once the TxDMA starts fetching descriptors from host memory again, this register can be written at any time. DMAP_XMT_POLL_DEMAND (offset 0x1004+Px0x100 (P = 0~2), total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 844, section 5.6).";
        field {
            name = "tpd";
            desc = "TPD: transmit poll demand. When any value is written to this register, the DMA reads the current transmit descriptor address. If the current descriptor is unavailable (own bit is 0), the transmit state machine enters the suspended state; otherwise, if the current descriptor is available, the transmit state machine resumes. (data sheet access type ROWT)";
            sw = rw; hw = r;
            reset = 0x0;
        } tpd[31:0];
    } DMAP_XMT_POLL_DEMAND_1 @ 0x1104;
    reg {
        name = "DMAP_XMT_POLL_DEMAND";
        desc = "DMAP_XMT_POLL_DEMAND is the transmit poll demand register. It enables the TxDMA to check whether the current descriptor belongs to the DMA. This command wakes up a TxDMA in the suspended state. The TxDMA usually enters the suspended state because of a FIFO underflow or no available transmit descriptor. Once the TxDMA starts fetching descriptors from host memory again, this register can be written at any time. DMAP_XMT_POLL_DEMAND (offset 0x1004+Px0x100 (P = 0~2), total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 844, section 5.6).";
        field {
            name = "tpd";
            desc = "TPD: transmit poll demand. When any value is written to this register, the DMA reads the current transmit descriptor address. If the current descriptor is unavailable (own bit is 0), the transmit state machine enters the suspended state; otherwise, if the current descriptor is available, the transmit state machine resumes. (data sheet access type ROWT)";
            sw = rw; hw = r;
            reset = 0x0;
        } tpd[31:0];
    } DMAP_XMT_POLL_DEMAND_2 @ 0x1204;
    reg {
        name = "DMAP_RCV_POLL_DEMAND";
        desc = "DMAP_RCV_POLL_DEMAND is the receive poll demand register. Enables the RxDMA to check whether the current descriptor belongs to the DMA. This command is used to wake up an RxDMA in the suspended state. The RxDMA normally enters the suspended state due to FIFO underflow or no available receive descriptor. DMAP_RCV_POLL_DEMAND (offset 0x1008+Px0x100 (P = 0~2), total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 845, section 5.6).";
        field {
            name = "rpd";
            desc = "RPD: receive poll demand. When any value is written to this register, the DMA reads the current receive descriptor address. If the current descriptor is unavailable (own bit is 0), the receive state machine enters the suspended state; otherwise, if the current descriptor is available, the receive state machine enters the active state. (data sheet access type ROWT)";
            sw = rw; hw = r;
            reset = 0x0;
        } rpd[31:0];
    } DMAP_RCV_POLL_DEMAND_0 @ 0x1008;
    reg {
        name = "DMAP_RCV_POLL_DEMAND";
        desc = "DMAP_RCV_POLL_DEMAND is the receive poll demand register. Enables the RxDMA to check whether the current descriptor belongs to the DMA. This command is used to wake up an RxDMA in the suspended state. The RxDMA normally enters the suspended state due to FIFO underflow or no available receive descriptor. DMAP_RCV_POLL_DEMAND (offset 0x1008+Px0x100 (P = 0~2), total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 845, section 5.6).";
        field {
            name = "rpd";
            desc = "RPD: receive poll demand. When any value is written to this register, the DMA reads the current receive descriptor address. If the current descriptor is unavailable (own bit is 0), the receive state machine enters the suspended state; otherwise, if the current descriptor is available, the receive state machine enters the active state. (data sheet access type ROWT)";
            sw = rw; hw = r;
            reset = 0x0;
        } rpd[31:0];
    } DMAP_RCV_POLL_DEMAND_1 @ 0x1108;
    reg {
        name = "DMAP_RCV_POLL_DEMAND";
        desc = "DMAP_RCV_POLL_DEMAND is the receive poll demand register. Enables the RxDMA to check whether the current descriptor belongs to the DMA. This command is used to wake up an RxDMA in the suspended state. The RxDMA normally enters the suspended state due to FIFO underflow or no available receive descriptor. DMAP_RCV_POLL_DEMAND (offset 0x1008+Px0x100 (P = 0~2), total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 845, section 5.6).";
        field {
            name = "rpd";
            desc = "RPD: receive poll demand. When any value is written to this register, the DMA reads the current receive descriptor address. If the current descriptor is unavailable (own bit is 0), the receive state machine enters the suspended state; otherwise, if the current descriptor is available, the receive state machine enters the active state. (data sheet access type ROWT)";
            sw = rw; hw = r;
            reset = 0x0;
        } rpd[31:0];
    } DMAP_RCV_POLL_DEMAND_2 @ 0x1208;
    reg {
        name = "DMAP_RCV_BASE_ADDR";
        desc = "DMAP_RCV_BASE_ADDR is the receive descriptor list address register. It indicates the start of the receive descriptor list. This register may be changed only while reception is stopped and before the receive start command is issued. DMAP_RCV_BASE_ADDR (offset 0x100C+Px0x100 (P = 0~2), total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 845, section 5.6).";
        field {
            name = "rba";
            desc = "Start of the receive list. This field contains the base address of the first descriptor of the receive descriptor list.";
            sw = rw; hw = r;
            reset = 0x0;
        } rba[31:0];
    } DMAP_RCV_BASE_ADDR_0 @ 0x100c;
    reg {
        name = "DMAP_RCV_BASE_ADDR";
        desc = "DMAP_RCV_BASE_ADDR is the receive descriptor list address register. It indicates the start of the receive descriptor list. This register may be changed only while reception is stopped and before the receive start command is issued. DMAP_RCV_BASE_ADDR (offset 0x100C+Px0x100 (P = 0~2), total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 845, section 5.6).";
        field {
            name = "rba";
            desc = "Start of the receive list. This field contains the base address of the first descriptor of the receive descriptor list.";
            sw = rw; hw = r;
            reset = 0x0;
        } rba[31:0];
    } DMAP_RCV_BASE_ADDR_1 @ 0x110c;
    reg {
        name = "DMAP_RCV_BASE_ADDR";
        desc = "DMAP_RCV_BASE_ADDR is the receive descriptor list address register. It indicates the start of the receive descriptor list. This register may be changed only while reception is stopped and before the receive start command is issued. DMAP_RCV_BASE_ADDR (offset 0x100C+Px0x100 (P = 0~2), total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 845, section 5.6).";
        field {
            name = "rba";
            desc = "Start of the receive list. This field contains the base address of the first descriptor of the receive descriptor list.";
            sw = rw; hw = r;
            reset = 0x0;
        } rba[31:0];
    } DMAP_RCV_BASE_ADDR_2 @ 0x120c;
    reg {
        name = "DMAP_TX_BASE_ADDR";
        desc = "DMAP_TX_BASE_ADDR is the transmit descriptor list address register. It indicates the start of the transmit descriptor list. This register may be changed only when transmission is stopped and before the transmit start command is issued. DMAP_TX_BASE_ADDR (offset 0x1010+Px0x100 (P = 0~2), total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 846, section 5.6).";
        field {
            name = "tba";
            desc = "Start of the transmit list. This field holds the base address of the first descriptor of the transmit descriptor list.";
            sw = rw; hw = r;
            reset = 0x0;
        } tba[31:0];
    } DMAP_TX_BASE_ADDR_0 @ 0x1010;
    reg {
        name = "DMAP_TX_BASE_ADDR";
        desc = "DMAP_TX_BASE_ADDR is the transmit descriptor list address register. It indicates the start of the transmit descriptor list. This register may be changed only when transmission is stopped and before the transmit start command is issued. DMAP_TX_BASE_ADDR (offset 0x1010+Px0x100 (P = 0~2), total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 846, section 5.6).";
        field {
            name = "tba";
            desc = "Start of the transmit list. This field holds the base address of the first descriptor of the transmit descriptor list.";
            sw = rw; hw = r;
            reset = 0x0;
        } tba[31:0];
    } DMAP_TX_BASE_ADDR_1 @ 0x1110;
    reg {
        name = "DMAP_TX_BASE_ADDR";
        desc = "DMAP_TX_BASE_ADDR is the transmit descriptor list address register. It indicates the start of the transmit descriptor list. This register may be changed only when transmission is stopped and before the transmit start command is issued. DMAP_TX_BASE_ADDR (offset 0x1010+Px0x100 (P = 0~2), total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 846, section 5.6).";
        field {
            name = "tba";
            desc = "Start of the transmit list. This field holds the base address of the first descriptor of the transmit descriptor list.";
            sw = rw; hw = r;
            reset = 0x0;
        } tba[31:0];
    } DMAP_TX_BASE_ADDR_2 @ 0x1210;
    reg {
        name = "DMAP_STATUS";
        desc = "DMAP_STATUS is the status register. It holds all status information that the DMA reports to the host. Software reads this register by interrupt service or by polling. Most bits of this register can cause interrupts. DMAP_STATUS is not clear-on-read; DMAP_STATUS[16:0] is cleared by writing 1, and writing 0 has no effect. These bits can be masked by operating the DMAP_CONTROL register. DMAP_STATUS (offset 0x1014+Px0x100 (P = 0~2), total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 846, section 5.6).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_28[31:28];
        field {
            name = "gmi";
            desc = "GMI: GMAC MMC interrupt. This bit reflects interrupt events of the MMC module. Software must read the corresponding registers in the GMAC to determine the interrupt source and clear the interrupt.
- 0: No GMAC MMC interrupt generated;
- 1: GMAC MMC interrupt generated.";
            sw = r; hw = w;
            reset = 0x0;
        } gmi[27:27];
        field {
            name = "gli";
            desc = "GLI: GMAC line interface interrupt. This bit reflects the interrupt event of the PCS module in the GMAC. Software must read the corresponding registers in the GMAC to find the interrupt source and clear the interrupt.
- 0: No GMAC PCS interrupt generated;
- 1: GMAC PCS interrupt generated.";
            sw = r; hw = w;
            reset = 0x0;
        } gli[26:26];
        field {
            name = "eb";
            desc = "EB: Error bits. These bits indicate the type of error that caused a bus error. They are valid only when bit 13 (FBI) is 1, and they do not generate an interrupt. This field does not generate an interrupt. bit[23]:
- 0: Error occurred during RxDMA data transfer;
- 1: Error occurred during TxDMA data transfer. bit[24]:
- 0: Error occurred during a write operation;
- 1: Error occurred during a read operation. bit[25]:
- 0: Error occurred during a data buffer access;
- 1: Error occurred during a descriptor access.";
            sw = r; hw = w;
            reset = 0x0;
        } eb[25:23];
        field {
            name = "ts";
            desc = "TS: transmit process state. These bits indicate the state of the TxDMA; they do not generate interrupts.
- 000: Stopped. A reset or stop command was received.
- 001: Running. Fetching the transmit descriptor.
- 010: Running. Waiting for status information.
- 011: Running. Reading the packet from host memory and writing it to the

TxFIFO.
- 100: TIME_STAMP write state.
- 101: Reserved.
- 110: Suspended. No transmit descriptor is available or the TxFIFO underflowed.
- 111: Writing back the transmit descriptor.";
            sw = r; hw = w;
            reset = 0x0;
        } ts[22:20];
        field {
            name = "rs";
            desc = "RS: receive process state. These bits indicate the state of the RxDMA; they do not generate interrupts.
- 000: Stopped. A reset or stop command was received;
- 001: Running. Fetching the receive descriptor;
- 010: Reserved;
- 011: Running. Waiting for a receive packet;
- 100: Suspended. No receive descriptor available;
- 101: Running. Writing back the receive descriptor;
- 110: TIME_STAMP write state;
- 111: Running. Writing the receive packet to host memory.";
            sw = r; hw = w;
            reset = 0x0;
        } rs[19:17];
        field {
            name = "nis";
            desc = "NIS: Normal interrupt summary. This bit is the logical OR of the following interrupt bits. DMAp_STATUS[0], DMAp_STATUS[2], DMAp_STATUS[6], DMAp_STATUS[14]. Only unmasked interrupts affect this bit. Each time an interrupt event sets this bit to 1, it must be cleared. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } nis[16:16];
        field {
            name = "ais";
            desc = "AIS: Abnormal interrupt summary. This bit is the logical OR of the following interrupt bits. DMAp_STATUS[1], DMAp_STATUS[3], DMAp_STATUS[4] DMAp_STATUS[5], DMAp_STATUS[7], DMAp_STATUS[8] DMAp_STATUS[9], DMAp_STATUS[10], DMAp_STATUS[13] Only interrupts that are not masked affect this bit. After each interrupt event sets this bit to 1, this bit must be cleared. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } ais[15:15];
        field {
            name = "eri";
            desc = "ERI: early receive interrupt.
- 0: No early receive interrupt generated;
- 1: Early receive interrupt generated.
Indicates that the RxDMA has filled the first data buffer of the receive descriptor. This interrupt is cleared automatically by DMAp_STATUS[6]. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } eri[14:14];
        field {
            name = "fbi";
            desc = "FBI: Fatal bus error interrupt.
- 0: No fatal bus error interrupt generated.
- 1: Fatal bus error interrupt generated. Indicates that a fatal bus error occurred; see bits [25:23]. When this bit is set,

the DMA stops all bus accesses. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } fbi[13:13];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_12_11[12:11];
        field {
            name = "eti";
            desc = "ETI: Early transmit interrupt.
- 0: No early transmit interrupt generated;
- 1: Early transmit interrupt generated. This bit indicates that the frame to be transmitted has been written to the TxFIFO. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } eti[10:10];
        field {
            name = "rwt";
            desc = "RWT: Receive watchdog timeout.
- 0: No receive watchdog timeout occurred.
- 1: A receive watchdog timeout occurred. This bit is set to 1 when the received frame length exceeds 2048 bytes. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } rwt[9:9];
        field {
            name = "rps";
            desc = "RPS: receive process stopped.
- 0: Receive process has not stopped;
- 1: Receive process stopped.
This bit indicates that the receive state machine entered the stopped state. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } rps[8:8];
        field {
            name = "ru";
            desc = "RU: receive buffer unavailable.
- 0: No receive buffer unavailable condition occurred;
- 1: A receive buffer unavailable condition occurred.
This bit indicates that the next descriptor in the receive queue is owned by the host and cannot be fetched. The receive process then enters the suspended state. The host must configure the next available descriptor and send a poll demand command to the RxDMA; otherwise this bit stays set. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } ru[7:7];
        field {
            name = "ri";
            desc = "RI: Receive interrupt.
- 0: No receive interrupt generated;
- 1: Receive interrupt generated. This bit indicates that frame reception is complete. The frame status information has been written to the descriptor, and the receive process is still running. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } ri[6:6];
        field {
            name = "unf";
            desc = "UNF: transmit underflow.
- 0: No transmit underflow occurred;
- 1: Transmit underflow occurred. This bit indicates that a TxFIFO underflow occurred during frame transmission. The transmit process enters the suspended state, and the underflow error bit in the transmit descriptor is also set to 1. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } unf[5:5];
        field {
            name = "ovf";
            desc = "OVF: receive overflow.
- 0: No receive overflow occurred;
- 1: Receive overflow occurred.
This bit indicates that an RxFIFO overflow occurred during frame reception. If part of the data has already been written to the host buffer, the overflow error bit in the receive descriptor is also set to 1. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } ovf[4:4];
        field {
            name = "tjt";
            desc = "TJT: transmit jabber timeout.
- 0: No transmit jabber timeout occurred;
- 1: Transmit jabber timeout occurred. This bit indicates that the transmit jabber timer expired; the transmit process is then canceled and enters the stopped state, and the jabber timeout bit of the corresponding transmit descriptor is also set to 1. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } tjt[3:3];
        field {
            name = "tu";
            desc = "TU: Transmit buffer unavailable.
- 0: No transmit buffer unavailable condition occurred.
- 1: A transmit buffer unavailable condition occurred. This bit indicates that the next descriptor in the transmit queue is owned by the host and cannot be fetched. The transmit process enters the suspended state. If the host has new data to transmit, it must configure the next available descriptor and send a poll demand command to the TxDMA. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } tu[2:2];
        field {
            name = "tps";
            desc = "TPS: transmit process stopped.
- 0: Transmit process stop did not occur;
- 1: Transmit process stop occurred. This bit indicates that the transmit state machine entered the stopped state. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } tps[1:1];
        field {
            name = "ti";
            desc = "TI: transmit interrupt.
- 0: No transmit interrupt generated;
- 1: Transmit interrupt generated.
This bit indicates that transmission of a frame is complete. The frame status information has been written to the descriptor, and the transmit process remains in the running state. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } ti[0:0];
    } DMAP_STATUS_0 @ 0x1014;
    reg {
        name = "DMAP_STATUS";
        desc = "DMAP_STATUS is the status register. It holds all status information that the DMA reports to the host. Software reads this register by interrupt service or by polling. Most bits of this register can cause interrupts. DMAP_STATUS is not clear-on-read; DMAP_STATUS[16:0] is cleared by writing 1, and writing 0 has no effect. These bits can be masked by operating the DMAP_CONTROL register. DMAP_STATUS (offset 0x1014+Px0x100 (P = 0~2), total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 846, section 5.6).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_28[31:28];
        field {
            name = "gmi";
            desc = "GMI: GMAC MMC interrupt. This bit reflects interrupt events of the MMC module. Software must read the corresponding registers in the GMAC to determine the interrupt source and clear the interrupt.
- 0: No GMAC MMC interrupt generated;
- 1: GMAC MMC interrupt generated.";
            sw = r; hw = w;
            reset = 0x0;
        } gmi[27:27];
        field {
            name = "gli";
            desc = "GLI: GMAC line interface interrupt. This bit reflects the interrupt event of the PCS module in the GMAC. Software must read the corresponding registers in the GMAC to find the interrupt source and clear the interrupt.
- 0: No GMAC PCS interrupt generated;
- 1: GMAC PCS interrupt generated.";
            sw = r; hw = w;
            reset = 0x0;
        } gli[26:26];
        field {
            name = "eb";
            desc = "EB: Error bits. These bits indicate the type of error that caused a bus error. They are valid only when bit 13 (FBI) is 1, and they do not generate an interrupt. This field does not generate an interrupt. bit[23]:
- 0: Error occurred during RxDMA data transfer;
- 1: Error occurred during TxDMA data transfer. bit[24]:
- 0: Error occurred during a write operation;
- 1: Error occurred during a read operation. bit[25]:
- 0: Error occurred during a data buffer access;
- 1: Error occurred during a descriptor access.";
            sw = r; hw = w;
            reset = 0x0;
        } eb[25:23];
        field {
            name = "ts";
            desc = "TS: transmit process state. These bits indicate the state of the TxDMA; they do not generate interrupts.
- 000: Stopped. A reset or stop command was received.
- 001: Running. Fetching the transmit descriptor.
- 010: Running. Waiting for status information.
- 011: Running. Reading the packet from host memory and writing it to the

TxFIFO.
- 100: TIME_STAMP write state.
- 101: Reserved.
- 110: Suspended. No transmit descriptor is available or the TxFIFO underflowed.
- 111: Writing back the transmit descriptor.";
            sw = r; hw = w;
            reset = 0x0;
        } ts[22:20];
        field {
            name = "rs";
            desc = "RS: receive process state. These bits indicate the state of the RxDMA; they do not generate interrupts.
- 000: Stopped. A reset or stop command was received;
- 001: Running. Fetching the receive descriptor;
- 010: Reserved;
- 011: Running. Waiting for a receive packet;
- 100: Suspended. No receive descriptor available;
- 101: Running. Writing back the receive descriptor;
- 110: TIME_STAMP write state;
- 111: Running. Writing the receive packet to host memory.";
            sw = r; hw = w;
            reset = 0x0;
        } rs[19:17];
        field {
            name = "nis";
            desc = "NIS: Normal interrupt summary. This bit is the logical OR of the following interrupt bits. DMAp_STATUS[0], DMAp_STATUS[2], DMAp_STATUS[6], DMAp_STATUS[14]. Only unmasked interrupts affect this bit. Each time an interrupt event sets this bit to 1, it must be cleared. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } nis[16:16];
        field {
            name = "ais";
            desc = "AIS: Abnormal interrupt summary. This bit is the logical OR of the following interrupt bits. DMAp_STATUS[1], DMAp_STATUS[3], DMAp_STATUS[4] DMAp_STATUS[5], DMAp_STATUS[7], DMAp_STATUS[8] DMAp_STATUS[9], DMAp_STATUS[10], DMAp_STATUS[13] Only interrupts that are not masked affect this bit. After each interrupt event sets this bit to 1, this bit must be cleared. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } ais[15:15];
        field {
            name = "eri";
            desc = "ERI: early receive interrupt.
- 0: No early receive interrupt generated;
- 1: Early receive interrupt generated.
Indicates that the RxDMA has filled the first data buffer of the receive descriptor. This interrupt is cleared automatically by DMAp_STATUS[6]. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } eri[14:14];
        field {
            name = "fbi";
            desc = "FBI: Fatal bus error interrupt.
- 0: No fatal bus error interrupt generated.
- 1: Fatal bus error interrupt generated. Indicates that a fatal bus error occurred; see bits [25:23]. When this bit is set,

the DMA stops all bus accesses. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } fbi[13:13];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_12_11[12:11];
        field {
            name = "eti";
            desc = "ETI: Early transmit interrupt.
- 0: No early transmit interrupt generated;
- 1: Early transmit interrupt generated. This bit indicates that the frame to be transmitted has been written to the TxFIFO. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } eti[10:10];
        field {
            name = "rwt";
            desc = "RWT: Receive watchdog timeout.
- 0: No receive watchdog timeout occurred.
- 1: A receive watchdog timeout occurred. This bit is set to 1 when the received frame length exceeds 2048 bytes. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } rwt[9:9];
        field {
            name = "rps";
            desc = "RPS: receive process stopped.
- 0: Receive process has not stopped;
- 1: Receive process stopped.
This bit indicates that the receive state machine entered the stopped state. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } rps[8:8];
        field {
            name = "ru";
            desc = "RU: receive buffer unavailable.
- 0: No receive buffer unavailable condition occurred;
- 1: A receive buffer unavailable condition occurred.
This bit indicates that the next descriptor in the receive queue is owned by the host and cannot be fetched. The receive process then enters the suspended state. The host must configure the next available descriptor and send a poll demand command to the RxDMA; otherwise this bit stays set. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } ru[7:7];
        field {
            name = "ri";
            desc = "RI: Receive interrupt.
- 0: No receive interrupt generated;
- 1: Receive interrupt generated. This bit indicates that frame reception is complete. The frame status information has been written to the descriptor, and the receive process is still running. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } ri[6:6];
        field {
            name = "unf";
            desc = "UNF: transmit underflow.
- 0: No transmit underflow occurred;
- 1: Transmit underflow occurred. This bit indicates that a TxFIFO underflow occurred during frame transmission. The transmit process enters the suspended state, and the underflow error bit in the transmit descriptor is also set to 1. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } unf[5:5];
        field {
            name = "ovf";
            desc = "OVF: receive overflow.
- 0: No receive overflow occurred;
- 1: Receive overflow occurred.
This bit indicates that an RxFIFO overflow occurred during frame reception. If part of the data has already been written to the host buffer, the overflow error bit in the receive descriptor is also set to 1. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } ovf[4:4];
        field {
            name = "tjt";
            desc = "TJT: transmit jabber timeout.
- 0: No transmit jabber timeout occurred;
- 1: Transmit jabber timeout occurred. This bit indicates that the transmit jabber timer expired; the transmit process is then canceled and enters the stopped state, and the jabber timeout bit of the corresponding transmit descriptor is also set to 1. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } tjt[3:3];
        field {
            name = "tu";
            desc = "TU: Transmit buffer unavailable.
- 0: No transmit buffer unavailable condition occurred.
- 1: A transmit buffer unavailable condition occurred. This bit indicates that the next descriptor in the transmit queue is owned by the host and cannot be fetched. The transmit process enters the suspended state. If the host has new data to transmit, it must configure the next available descriptor and send a poll demand command to the TxDMA. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } tu[2:2];
        field {
            name = "tps";
            desc = "TPS: transmit process stopped.
- 0: Transmit process stop did not occur;
- 1: Transmit process stop occurred. This bit indicates that the transmit state machine entered the stopped state. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } tps[1:1];
        field {
            name = "ti";
            desc = "TI: transmit interrupt.
- 0: No transmit interrupt generated;
- 1: Transmit interrupt generated.
This bit indicates that transmission of a frame is complete. The frame status information has been written to the descriptor, and the transmit process remains in the running state. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } ti[0:0];
    } DMAP_STATUS_1 @ 0x1114;
    reg {
        name = "DMAP_STATUS";
        desc = "DMAP_STATUS is the status register. It holds all status information that the DMA reports to the host. Software reads this register by interrupt service or by polling. Most bits of this register can cause interrupts. DMAP_STATUS is not clear-on-read; DMAP_STATUS[16:0] is cleared by writing 1, and writing 0 has no effect. These bits can be masked by operating the DMAP_CONTROL register. DMAP_STATUS (offset 0x1014+Px0x100 (P = 0~2), total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 846, section 5.6).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_28[31:28];
        field {
            name = "gmi";
            desc = "GMI: GMAC MMC interrupt. This bit reflects interrupt events of the MMC module. Software must read the corresponding registers in the GMAC to determine the interrupt source and clear the interrupt.
- 0: No GMAC MMC interrupt generated;
- 1: GMAC MMC interrupt generated.";
            sw = r; hw = w;
            reset = 0x0;
        } gmi[27:27];
        field {
            name = "gli";
            desc = "GLI: GMAC line interface interrupt. This bit reflects the interrupt event of the PCS module in the GMAC. Software must read the corresponding registers in the GMAC to find the interrupt source and clear the interrupt.
- 0: No GMAC PCS interrupt generated;
- 1: GMAC PCS interrupt generated.";
            sw = r; hw = w;
            reset = 0x0;
        } gli[26:26];
        field {
            name = "eb";
            desc = "EB: Error bits. These bits indicate the type of error that caused a bus error. They are valid only when bit 13 (FBI) is 1, and they do not generate an interrupt. This field does not generate an interrupt. bit[23]:
- 0: Error occurred during RxDMA data transfer;
- 1: Error occurred during TxDMA data transfer. bit[24]:
- 0: Error occurred during a write operation;
- 1: Error occurred during a read operation. bit[25]:
- 0: Error occurred during a data buffer access;
- 1: Error occurred during a descriptor access.";
            sw = r; hw = w;
            reset = 0x0;
        } eb[25:23];
        field {
            name = "ts";
            desc = "TS: transmit process state. These bits indicate the state of the TxDMA; they do not generate interrupts.
- 000: Stopped. A reset or stop command was received.
- 001: Running. Fetching the transmit descriptor.
- 010: Running. Waiting for status information.
- 011: Running. Reading the packet from host memory and writing it to the

TxFIFO.
- 100: TIME_STAMP write state.
- 101: Reserved.
- 110: Suspended. No transmit descriptor is available or the TxFIFO underflowed.
- 111: Writing back the transmit descriptor.";
            sw = r; hw = w;
            reset = 0x0;
        } ts[22:20];
        field {
            name = "rs";
            desc = "RS: receive process state. These bits indicate the state of the RxDMA; they do not generate interrupts.
- 000: Stopped. A reset or stop command was received;
- 001: Running. Fetching the receive descriptor;
- 010: Reserved;
- 011: Running. Waiting for a receive packet;
- 100: Suspended. No receive descriptor available;
- 101: Running. Writing back the receive descriptor;
- 110: TIME_STAMP write state;
- 111: Running. Writing the receive packet to host memory.";
            sw = r; hw = w;
            reset = 0x0;
        } rs[19:17];
        field {
            name = "nis";
            desc = "NIS: Normal interrupt summary. This bit is the logical OR of the following interrupt bits. DMAp_STATUS[0], DMAp_STATUS[2], DMAp_STATUS[6], DMAp_STATUS[14]. Only unmasked interrupts affect this bit. Each time an interrupt event sets this bit to 1, it must be cleared. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } nis[16:16];
        field {
            name = "ais";
            desc = "AIS: Abnormal interrupt summary. This bit is the logical OR of the following interrupt bits. DMAp_STATUS[1], DMAp_STATUS[3], DMAp_STATUS[4] DMAp_STATUS[5], DMAp_STATUS[7], DMAp_STATUS[8] DMAp_STATUS[9], DMAp_STATUS[10], DMAp_STATUS[13] Only interrupts that are not masked affect this bit. After each interrupt event sets this bit to 1, this bit must be cleared. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } ais[15:15];
        field {
            name = "eri";
            desc = "ERI: early receive interrupt.
- 0: No early receive interrupt generated;
- 1: Early receive interrupt generated.
Indicates that the RxDMA has filled the first data buffer of the receive descriptor. This interrupt is cleared automatically by DMAp_STATUS[6]. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } eri[14:14];
        field {
            name = "fbi";
            desc = "FBI: Fatal bus error interrupt.
- 0: No fatal bus error interrupt generated.
- 1: Fatal bus error interrupt generated. Indicates that a fatal bus error occurred; see bits [25:23]. When this bit is set,

the DMA stops all bus accesses. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } fbi[13:13];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_12_11[12:11];
        field {
            name = "eti";
            desc = "ETI: Early transmit interrupt.
- 0: No early transmit interrupt generated;
- 1: Early transmit interrupt generated. This bit indicates that the frame to be transmitted has been written to the TxFIFO. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } eti[10:10];
        field {
            name = "rwt";
            desc = "RWT: Receive watchdog timeout.
- 0: No receive watchdog timeout occurred.
- 1: A receive watchdog timeout occurred. This bit is set to 1 when the received frame length exceeds 2048 bytes. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } rwt[9:9];
        field {
            name = "rps";
            desc = "RPS: receive process stopped.
- 0: Receive process has not stopped;
- 1: Receive process stopped.
This bit indicates that the receive state machine entered the stopped state. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } rps[8:8];
        field {
            name = "ru";
            desc = "RU: receive buffer unavailable.
- 0: No receive buffer unavailable condition occurred;
- 1: A receive buffer unavailable condition occurred.
This bit indicates that the next descriptor in the receive queue is owned by the host and cannot be fetched. The receive process then enters the suspended state. The host must configure the next available descriptor and send a poll demand command to the RxDMA; otherwise this bit stays set. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } ru[7:7];
        field {
            name = "ri";
            desc = "RI: Receive interrupt.
- 0: No receive interrupt generated;
- 1: Receive interrupt generated. This bit indicates that frame reception is complete. The frame status information has been written to the descriptor, and the receive process is still running. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } ri[6:6];
        field {
            name = "unf";
            desc = "UNF: transmit underflow.
- 0: No transmit underflow occurred;
- 1: Transmit underflow occurred. This bit indicates that a TxFIFO underflow occurred during frame transmission. The transmit process enters the suspended state, and the underflow error bit in the transmit descriptor is also set to 1. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } unf[5:5];
        field {
            name = "ovf";
            desc = "OVF: receive overflow.
- 0: No receive overflow occurred;
- 1: Receive overflow occurred.
This bit indicates that an RxFIFO overflow occurred during frame reception. If part of the data has already been written to the host buffer, the overflow error bit in the receive descriptor is also set to 1. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } ovf[4:4];
        field {
            name = "tjt";
            desc = "TJT: transmit jabber timeout.
- 0: No transmit jabber timeout occurred;
- 1: Transmit jabber timeout occurred. This bit indicates that the transmit jabber timer expired; the transmit process is then canceled and enters the stopped state, and the jabber timeout bit of the corresponding transmit descriptor is also set to 1. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } tjt[3:3];
        field {
            name = "tu";
            desc = "TU: Transmit buffer unavailable.
- 0: No transmit buffer unavailable condition occurred.
- 1: A transmit buffer unavailable condition occurred. This bit indicates that the next descriptor in the transmit queue is owned by the host and cannot be fetched. The transmit process enters the suspended state. If the host has new data to transmit, it must configure the next available descriptor and send a poll demand command to the TxDMA. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } tu[2:2];
        field {
            name = "tps";
            desc = "TPS: transmit process stopped.
- 0: Transmit process stop did not occur;
- 1: Transmit process stop occurred. This bit indicates that the transmit state machine entered the stopped state. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } tps[1:1];
        field {
            name = "ti";
            desc = "TI: transmit interrupt.
- 0: No transmit interrupt generated;
- 1: Transmit interrupt generated.
This bit indicates that transmission of a frame is complete. The frame status information has been written to the descriptor, and the transmit process remains in the running state. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } ti[0:0];
    } DMAP_STATUS_2 @ 0x1214;
    reg {
        name = "DMAP_CONTROL";
        desc = "DMAP_CONTROL is the operation mode register of DMAp (0 to 2). It specifies the receive and transmit operation modes and commands. This register should be the last register written during DMA initialization. DMAP_CONTROL (offset 0x1018+Px0x100 (P = 0~2), total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 850, section 5.6).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_26[31:26];
        field {
            name = "rsf";
            desc = "RSF: receive store and forward.
- 0: Receive store and forward is not performed. The RxFIFO decides whether to forward according to the FIFO threshold.
- 1: Receive store and forward is performed. The RxFIFO forwards a frame upward only after it has received the complete frame.";
            sw = rw; hw = r;
            reset = 0x0;
        } rsf[25:25];
        field {
            name = "dff";
            desc = "DFF: Disable flushing of received frames.
- 0: Enable flushing of received frames. When this bit is 0, the RxDMA flushes any frame if the receive descriptor or receive buffer is unavailable;
- 1: Disable flushing of received frames. When this bit is 1, the RxDMA does not flush any frame because of an unavailable receive descriptor or receive buffer.";
            sw = rw; hw = r;
            reset = 0x0;
        } dff[24:24];
        field {
            name = "rfa2";
            desc = "RFA[2]: high bit of the flow control activation threshold.
- 0: When this bit is 0, the flow control threshold is set according to RFA;
- 1: When this bit is 1, the flow control activation threshold is determined jointly by this bit and RFA. The activation threshold varies with {rfa2,rfa[1:0]} as follows:
- 100: Full minus 5 KB;
- 101: Full minus 6 KB;
- 110: Full minus 7 KB;
- 111: Reserved.";
            sw = rw; hw = r;
            reset = 0x0;
        } rfa2[23:23];
        field {
            name = "rfd2";
            desc = "RFD[2]: upper bit of the flow control deactivation threshold.
- 0: When this bit is 0, the flow control deactivation threshold is set according to RFD.
- 1: When this bit is 1, the flow control deactivation threshold is determined jointly by this bit and RFD. The deactivation threshold varies with {rfd2,rfd[1:0]} as follows:
- 100: Full minus 5 KB;
- 101: Full minus 6 KB;
- 110: Full minus 7 KB;
- 111: Reserved.";
            sw = rw; hw = r;
            reset = 0x0;
        } rfd2[22:22];
        field {
            name = "tsf";
            desc = "TSF: transmit store and forward.
- 0: Transmit store and forward is not performed. The TxFIFO decides whether to forward based on the FIFO threshold;
- 1: Transmit store and forward is performed. The TxFIFO forwards a frame to the MAC only after receiving the complete frame.";
            sw = rw; hw = r;
            reset = 0x0;
        } tsf[21:21];
        field {
            name = "ftf";
            desc = "FTF: flush TxFIFO.
- 0: Do not flush the TxFIFO.
- 1: Flush the TxFIFO. When this bit is set to 1, all control logic of the TxFIFO is reset and the data in the TxFIFO is lost. This bit is cleared automatically after the flush completes. During the flush, the operation mode register cannot be written. Data already accepted by the GMAC transmitter is not flushed. This operation causes

FIFO underflow and the sending of runt frames. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } ftf[20:20];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_19_17[19:17];
        field {
            name = "ttc";
            desc = "TTC: Transmit threshold control. Controls the TxFIFO threshold for starting the TxDMA. When the number of bytes in the RxFIFO is greater than or equal to this threshold, the TxDMA is started for processing. This bit is valid only when TSF is 0.
- 000: 64;
- 001: 128;
- 010: 192;
- 011: 256;
- 100: 40;
- 101: 32;
- 110: 24;
- 111: 16.";
            sw = rw; hw = r;
            reset = 0x0;
        } ttc[16:14];
        field {
            name = "st";
            desc = "ST: start/stop transmission command.
- 1: When this bit is 1, the transmit process enters the running state. The DMA tries to fetch a descriptor from the transmit queue. The descriptor is fetched from the DMAp_XMT_BASE_ADDR register or from the position saved when the transmit state machine last stopped. If no descriptor is available, the TxDMA enters the suspended state and transmit buffer unavailable (DMAp_STATUS[2]) is set to 1. Note that when this bit is set to 1, it takes effect only when transmission is stopped, and it works correctly only after the DMAp_XMT_BASE_ADDR configuration has taken effect.
- 0: When this bit is 0, the TxDMA stops operation after the current frame is processed. The position of the next descriptor in the queue is saved and becomes the current position when the transmit process restarts. Setting this bit to 0 is effective only when the transmit process is in the running or suspended state.";
            sw = rw; hw = r;
            reset = 0x0;
        } st[13:13];
        field {
            name = "rfd";
            desc = "RFD: threshold for deactivating flow control (in both HD and FD). These bits control the RxFIFO fill level below which flow control is deactivated after it has been activated.
- 00: Full minus 1 KB;
- 01: Full minus 2 KB;
- 10: Full minus 3 KB;
- 11: Full minus 4 KB.
The above is valid only after flow control is activated and when the RxFIFO depth exceeds 4KB. If the RxFIFO depth exceeds 8KB, RFD[2] in bit 22 can determine additional deactivation thresholds.";
            sw = rw; hw = r;
            reset = 0x0;
        } rfd[12:11];
        field {
            name = "rfa";
            desc = "RFA: Threshold for activating flow control (in both HD and FD). These bits control the start of flow control when the RxFIFO fill level exceeds this threshold.
- 00: Full minus 1 KB;
- 01: Full minus 2 KB;
- 10: Full minus 3 KB;
- 11: Full minus 4 KB. The above is valid only when EFC is set to 1 and the RxFIFO depth exceeds 4 KB. If the RxFIFO depth exceeds 8 KB, RFA[2] in bit 23 can determine further flow control thresholds.";
            sw = rw; hw = r;
            reset = 0x0;
        } rfa[10:9];
        field {
            name = "efc";
            desc = "EFC: enable hardware flow control.
- 0: Hardware flow control disabled.
- 1: Hardware flow control enabled. The hardware implements flow control depending on how full or empty the FIFO is.";
            sw = rw; hw = r;
            reset = 0x0;
        } efc[8:8];
        field {
            name = "fef";
            desc = "FEF: forward error frames.
- 0: When this bit is 0, the RxFIFO drops all frames with errors (including CRC errors, collision errors, gmii_er, oversize frames, watchdog timeout, overflow, and so on). However, in threshold mode, a frame cannot be dropped if its start pointer has already been obtained by the receive controller;
- 1: When this bit is 1, all frames except runt frames are forwarded to the DMA. Frames with FIFO overflow errors are still dropped.";
            sw = rw; hw = r;
            reset = 0x0;
        } fef[7:7];
        field {
            name = "fuf";
            desc = "FUF: forward undersized good frames.
- 0: When this bit is 0, the RxFIFO drops all undersized frames smaller than the receive threshold;
- 1: When this bit is 1, the RxFIFO forwards all error-free frames shorter than 64 bytes (including padding bytes and CRC).";
            sw = rw; hw = r;
            reset = 0x0;
        } fuf[6:6];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_5_5[5:5];
        field {
            name = "rtc";
            desc = "RTC: Receive threshold control. Controls the RxFIFO threshold for starting the RxDMA. When the number of bytes in the RxFIFO is greater than or equal to this threshold, the RxDMA is started for processing. This bit is valid only when RSF is 0.
- 00: 64;
- 01: 32;
- 10: 96;
- 11: 128.";
            sw = rw; hw = r;
            reset = 0x0;
        } rtc[4:3];
        field {
            name = "osf";
            desc = "OSF: operate on second frame.
- 0: Do not operate on the second frame;
- 1: Operate on the second frame. The DMA can then start processing the second frame before obtaining the status of the previous frame.";
            sw = rw; hw = r;
            reset = 0x0;
        } osf[2:2];
        field {
            name = "sr";
            desc = "SR: start/stop receive.
- 0: When this bit is 0, the RxDMA stops operating after the current frame has been processed. The position of the next descriptor in the receive queue is saved and becomes the current position when the receive process is restarted. Setting this bit to 0 is effective only when the receive process is in the running or suspended state.
- 1: When this bit is 1, the receive process enters the running state. The DMA tries to fetch descriptors from the receive queue and processes incoming frames. Descriptors are fetched from the

DMAp_RCV_BASE_ADDR register or from the position saved when the receive state machine last stopped. If no descriptor is available, the receive DMA enters the suspended state and receive buffer unavailable (DMAp_STATUS[7]) is set to 1. Note that setting this bit to 1 takes effect only when reception is stopped, and it works correctly only after the DMAp_RCV_BASE_ADDR configuration has taken effect.";
            sw = rw; hw = r;
            reset = 0x0;
        } sr[1:1];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_0_0[0:0];
    } DMAP_CONTROL_0 @ 0x1018;
    reg {
        name = "DMAP_CONTROL";
        desc = "DMAP_CONTROL is the operation mode register of DMAp (0 to 2). It specifies the receive and transmit operation modes and commands. This register should be the last register written during DMA initialization. DMAP_CONTROL (offset 0x1018+Px0x100 (P = 0~2), total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 850, section 5.6).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_26[31:26];
        field {
            name = "rsf";
            desc = "RSF: receive store and forward.
- 0: Receive store and forward is not performed. The RxFIFO decides whether to forward according to the FIFO threshold.
- 1: Receive store and forward is performed. The RxFIFO forwards a frame upward only after it has received the complete frame.";
            sw = rw; hw = r;
            reset = 0x0;
        } rsf[25:25];
        field {
            name = "dff";
            desc = "DFF: Disable flushing of received frames.
- 0: Enable flushing of received frames. When this bit is 0, the RxDMA flushes any frame if the receive descriptor or receive buffer is unavailable;
- 1: Disable flushing of received frames. When this bit is 1, the RxDMA does not flush any frame because of an unavailable receive descriptor or receive buffer.";
            sw = rw; hw = r;
            reset = 0x0;
        } dff[24:24];
        field {
            name = "rfa2";
            desc = "RFA[2]: high bit of the flow control activation threshold.
- 0: When this bit is 0, the flow control threshold is set according to RFA;
- 1: When this bit is 1, the flow control activation threshold is determined jointly by this bit and RFA. The activation threshold varies with {rfa2,rfa[1:0]} as follows:
- 100: Full minus 5 KB;
- 101: Full minus 6 KB;
- 110: Full minus 7 KB;
- 111: Reserved.";
            sw = rw; hw = r;
            reset = 0x0;
        } rfa2[23:23];
        field {
            name = "rfd2";
            desc = "RFD[2]: upper bit of the flow control deactivation threshold.
- 0: When this bit is 0, the flow control deactivation threshold is set according to RFD.
- 1: When this bit is 1, the flow control deactivation threshold is determined jointly by this bit and RFD. The deactivation threshold varies with {rfd2,rfd[1:0]} as follows:
- 100: Full minus 5 KB;
- 101: Full minus 6 KB;
- 110: Full minus 7 KB;
- 111: Reserved.";
            sw = rw; hw = r;
            reset = 0x0;
        } rfd2[22:22];
        field {
            name = "tsf";
            desc = "TSF: transmit store and forward.
- 0: Transmit store and forward is not performed. The TxFIFO decides whether to forward based on the FIFO threshold;
- 1: Transmit store and forward is performed. The TxFIFO forwards a frame to the MAC only after receiving the complete frame.";
            sw = rw; hw = r;
            reset = 0x0;
        } tsf[21:21];
        field {
            name = "ftf";
            desc = "FTF: flush TxFIFO.
- 0: Do not flush the TxFIFO.
- 1: Flush the TxFIFO. When this bit is set to 1, all control logic of the TxFIFO is reset and the data in the TxFIFO is lost. This bit is cleared automatically after the flush completes. During the flush, the operation mode register cannot be written. Data already accepted by the GMAC transmitter is not flushed. This operation causes

FIFO underflow and the sending of runt frames. (data sheet access type RWC)";
            sw = rw; hw = rw; onwrite = woclr;
            reset = 0x0;
        } ftf[20:20];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_19_17[19:17];
        field {
            name = "ttc";
            desc = "TTC: Transmit threshold control. Controls the TxFIFO threshold for starting the TxDMA. When the number of bytes in the RxFIFO is greater than or equal to this threshold, the TxDMA is started for processing. This bit is valid only when TSF is 0.
- 000: 64;
- 001: 128;
- 010: 192;
- 011: 256;
- 100: 40;
- 101: 32;
- 110: 24;
- 111: 16.";
            sw = rw; hw = r;
            reset = 0x0;
        } ttc[16:14];
        field {
            name = "st";
            desc = "ST: start/stop transmission command.
- 1: When this bit is 1, the transmit process enters the running state. The DMA tries to fetch a descriptor from the transmit queue. The descriptor is fetched from the DMAp_XMT_BASE_ADDR register or from the position saved when the transmit state machine last stopped. If no descriptor is available, the TxDMA enters the suspended state and transmit buffer unavailable (DMAp_STATUS[2]) is set to 1. Note that when this bit is set to 1, it takes effect only when transmission is stopped, and it works correctly only after the DMAp_XMT_BASE_ADDR configuration has taken effect.
- 0: When this bit is 0, the TxDMA stops operation after the current frame is processed. The position of the next descriptor in the queue is saved and becomes the current position when the transmit process restarts. Setting this bit to 0 is effective only when the transmit process is in the running or suspended state.";
            sw = rw; hw = r;
            reset = 0x0;
        } st[13:13];
        field {
            name = "rfd";
            desc = "RFD: threshold for deactivating flow control (in both HD and FD). These bits control the RxFIFO fill level below which flow control is deactivated after it has been activated.
- 00: Full minus 1 KB;
- 01: Full minus 2 KB;
- 10: Full minus 3 KB;
- 11: Full minus 4 KB.
The above is valid only after flow control is activated and when the RxFIFO depth exceeds 4KB. If the RxFIFO depth exceeds 8KB, RFD[2] in bit 22 can determine additional deactivation thresholds.";
            sw = rw; hw = r;
            reset = 0x0;
        } rfd[12:11];
        field {
            name = "rfa";
            desc = "RFA: Threshold for activating flow control (in both HD and FD). These bits control the start of flow control when the RxFIFO fill level exceeds this threshold.
- 00: Full minus 1 KB;
- 01: Full minus 2 KB;
- 10: Full minus 3 KB;
- 11: Full minus 4 KB. The above is valid only when EFC is set to 1 and the RxFIFO depth exceeds 4 KB. If the RxFIFO depth exceeds 8 KB, RFA[2] in bit 23 can determine further flow control thresholds.";
            sw = rw; hw = r;
            reset = 0x0;
        } rfa[10:9];
        field {
            name = "efc";
            desc = "EFC: enable hardware flow control.
- 0: Hardware flow control disabled.
- 1: Hardware flow control enabled. The hardware implements flow control depending on how full or empty the FIFO is.";
            sw = rw; hw = r;
            reset = 0x0;
        } efc[8:8];
        field {
            name = "fef";
            desc = "FEF: forward error frames.
- 0: When this bit is 0, the RxFIFO drops all frames with errors (including CRC errors, collision errors, gmii_er, oversize frames, watchdog timeout, overflow, and so on). However, in threshold mode, a frame cannot be dropped if its start pointer has already been obtained by the receive controller;
- 1: When this bit is 1, all frames except runt frames are forwarded to the DMA. Frames with FIFO overflow errors are still dropped.";
            sw = rw; hw = r;
            reset = 0x0;
        } fef[7:7];
        field {
            name = "fuf";
            desc = "FUF: forward undersized good frames.
- 0: When this bit is 0, the RxFIFO drops all undersized frames smaller than the receive threshold;
- 1: When this bit is 1, the RxFIFO forwards all error-free frames shorter than 64 bytes (including padding bytes and CRC).";
            sw = rw; hw = r;
            reset = 0x0;
        } fuf[6:6];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_5_5[5:5];
        field {
            name = "rtc";
            desc = "RTC: Receive threshold control. Controls the RxFIFO threshold for starting the RxDMA. When the number of bytes in the RxFIFO is greater than or equal to this threshold, the RxDMA is started for processing. This bit is valid only when RSF is 0.
- 00: 64;
- 01: 32;
- 10: 96;
- 11: 128.";
            sw = rw; hw = r;
            reset = 0x0;
        } rtc[4:3];
        field {
            name = "osf";
            desc = "OSF: operate on second frame.
- 0: Do not operate on the second frame;
- 1: Operate on the second frame. The DMA can then start processing the second frame before obtaining the status of the previous frame.";
            sw = rw; hw = r;
            reset = 0x0;
        } osf[2:2];
        field {
            name = "sr";
            desc = "SR: start/stop receive.
- 0: When this bit is 0, the RxDMA stops operating after the current frame has been processed. The position of the next descriptor in the receive queue is saved and becomes the current position when the receive process is restarted. Setting this bit to 0 is effective only when the receive process is in the running or suspended state.
- 1: When this bit is 1, the receive process enters the running state. The DMA tries to fetch descriptors from the receive queue and processes incoming frames. Descriptors are fetched from the

DMAp_RCV_BASE_ADDR register or from the position saved when the receive state machine last stopped. If no descriptor is available, the receive DMA enters the suspended state and receive buffer unavailable (DMAp_STATUS[7]) is set to 1. Note that setting this bit to 1 takes effect only when reception is stopped, and it works correctly only after the DMAp_RCV_BASE_ADDR configuration has taken effect.";
            sw = rw; hw = r;
            reset = 0x0;
        } sr[1:1];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_0_0[0:0];
    } DMAP_CONTROL_1 @ 0x1118;
