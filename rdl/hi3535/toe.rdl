    reg {
        name = "DMAP_INTR_ENA";
        desc = "DMAP_INTR_ENA is the interrupt enable register of DMAp (0 to 2). It enables the interrupts reported by DMAp_STATUS. After a soft reset or hard reset,. DMAP_INTR_ENA (offset 0x101C+Px0x100 (P = 0~2), total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 854, section 5.6).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_17[31:17];
        field {
            name = "nie";
            desc = "NIE: normal interrupt summary enable.
- 0: Disable the normal interrupt summary;
- 1: Enable the normal interrupt summary. The normal interrupts enabled by this bit are: DMAp_STATUS[0], DMAp_STATUS[2], DMAp_STATUS[6], DMAp_STATUS[14]";
            sw = rw; hw = r;
            reset = 0x0;
        } nie[16:16];
        field {
            name = "aie";
            desc = "AIE: abnormal interrupt summary enable.
- 0: Disable the abnormal interrupt summary;
- 1: Enable the abnormal interrupt summary. The abnormal interrupts enabled by this bit are: DMAp_STATUS[1], DMAp_STATUS[3], DMAp_STATUS[4], DMAp_STATUS[5], DMAp_STATUS[7], DMAp_STATUS[8], DMAp_STATUS[9], DMAp_STATUS[10], DMAp_STATUS[13]";
            sw = rw; hw = r;
            reset = 0x0;
        } aie[15:15];
        field {
            name = "ere";
            desc = "ERE: early receive interrupt enable.
- 0: Early receive interrupt disabled;
- 1: Early receive interrupt enabled when the normal interrupt summary enable is 1.";
            sw = rw; hw = r;
            reset = 0x0;
        } ere[14:14];
        field {
            name = "fbe";
            desc = "FBE: fatal bus error enable.
- 0: Fatal bus error disabled;
- 1: Fatal bus error enabled when the abnormal interrupt summary enable is 1.";
            sw = rw; hw = r;
            reset = 0x0;
        } fbe[13:13];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_12_11[12:11];
        field {
            name = "ete";
            desc = "ETE: Early transmit interrupt enable.
- 0: Early transmit interrupt disabled.
- 1: Early transmit interrupt enabled when the abnormal interrupt summary enable is 1.";
            sw = rw; hw = r;
            reset = 0x0;
        } ete[10:10];
        field {
            name = "rwe";
            desc = "RWE: receive watchdog timeout enable.
- 0: Receive watchdog timeout disabled.
- 1: Receive watchdog timeout enabled when the abnormal interrupt summary enable is 1.";
            sw = rw; hw = r;
            reset = 0x0;
        } rwe[9:9];
        field {
            name = "rse";
            desc = "RSE: Receive stopped enable.
- 0: Receive stopped interrupt disabled.
- 1: Receive stopped interrupt enabled when the abnormal interrupt summary enable is 1.";
            sw = rw; hw = r;
            reset = 0x0;
        } rse[8:8];
        field {
            name = "rue";
            desc = "RUE: receive buffer unavailable enable.
- 0: Disable receive buffer unavailable;
- 1: When the abnormal interrupt summary enable is 1, enable receive buffer unavailable.";
            sw = rw; hw = r;
            reset = 0x0;
        } rue[7:7];
        field {
            name = "rie";
            desc = "RIE: receive interrupt enable.
- 0: Receive interrupt disabled;
- 1: Receive interrupt enabled when the normal interrupt summary enable is 1.";
            sw = rw; hw = r;
            reset = 0x0;
        } rie[6:6];
        field {
            name = "une";
            desc = "UNE: Underflow interrupt enable.
- 0: Underflow interrupt disabled;
- 1: Underflow interrupt enabled when the abnormal interrupt summary enable is 1.";
            sw = rw; hw = r;
            reset = 0x0;
        } une[5:5];
        field {
            name = "ove";
            desc = "OVE: Overflow interrupt enable.
- 0: Overflow interrupt disabled.
- 1: Overflow interrupt enabled when the abnormal interrupt summary enable is 1.";
            sw = rw; hw = r;
            reset = 0x0;
        } ove[4:4];
        field {
            name = "tje";
            desc = "TJE: transmit jabber timeout enable.
- 0: Transmit jabber timeout disabled.
- 1: Transmit jabber timeout enabled when the abnormal interrupt summary enable is 1.";
            sw = rw; hw = r;
            reset = 0x0;
        } tje[3:3];
        field {
            name = "tue";
            desc = "TUE: transmit buffer unavailable enable.
- 0: Disable transmit buffer unavailable;
- 1: When the normal interrupt summary enable is 1, enable transmit buffer unavailable.";
            sw = rw; hw = r;
            reset = 0x0;
        } tue[2:2];
        field {
            name = "tse";
            desc = "TSE: Transmit stop enable.
- 0: Transmit stop disabled;
- 1: Transmit stop enabled when the abnormal interrupt summary enable is 6.";
            sw = rw; hw = r;
            reset = 0x0;
        } tse[1:1];
        field {
            name = "tie";
            desc = "TIE: Transmit interrupt enable.
- 0: Transmit interrupt disabled;
- 1: Transmit interrupt enabled when the normal interrupt summary enable is 1.";
            sw = rw; hw = r;
            reset = 0x0;
        } tie[0:0];
    } DMAP_INTR_ENA_0 @ 0x101c;
    reg {
        name = "DMAP_INTR_ENA";
        desc = "DMAP_INTR_ENA is the interrupt enable register of DMAp (0 to 2). It enables the interrupts reported by DMAp_STATUS. After a soft reset or hard reset,. DMAP_INTR_ENA (offset 0x101C+Px0x100 (P = 0~2), total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 854, section 5.6).";
        field {
            name = "reserved";
