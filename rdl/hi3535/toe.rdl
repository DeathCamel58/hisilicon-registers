            reset = 0x0;
        } reserved_31_8[31:8];
        field {
            name = "toe_int";
            desc = "Interrupt from the TOE.";
            sw = r; hw = w;
            reset = 0x0;
        } toe_int[7:7];
        field {
            name = "gmac1_int";
            desc = "All interrupts from GMAC1.";
            sw = r; hw = w;
            reset = 0x0;
        } gmac1_int[6:6];
        field {
            name = "gmac0_int";
            desc = "All interrupts from GMAC0.";
            sw = r; hw = w;
            reset = 0x0;
        } gmac0_int[5:5];
        field {
            name = "dma_ch2_int";
            desc = "All interrupts from DMA2.";
            sw = r; hw = w;
            reset = 0x0;
        } dma_ch2_int[4:4];
        field {
            name = "dma_ch1_int";
            desc = "All interrupts from DMA1.";
            sw = r; hw = w;
            reset = 0x0;
        } dma_ch1_int[3:3];
        field {
            name = "dma_ch0_int";
            desc = "All interrupts from DMA0.";
            sw = r; hw = w;
            reset = 0x0;
        } dma_ch0_int[2:2];
        field {
            name = "dma_ttx_err_int";
            desc = "Interrupt generated by an error detected by the TOE transmit DMA.";
            sw = r; hw = w;
            reset = 0x0;
        } dma_ttx_err_int[1:1];
        field {
            name = "dma_ttx_ack_int";
            desc = "Interrupt generated when the TOE detects that one or more descriptors can be reclaimed by software because the peer ACK was returned.";
            sw = r; hw = w;
            reset = 0x0;
        } dma_ttx_ack_int[0:0];
    } TNK_INTR_STAT @ 0x9000;
    reg {
        name = "TNK_INTR_EN";
        desc = "TNK_INTR_EN is the interrupt enable register. TNK_INTR_EN (offset 0x09004, total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 862, section 5.6).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_8[31:8];
        field {
            name = "toe_ien";
            desc = "Interrupt enable of toe_int.";
            sw = rw; hw = r;
            reset = 0x0;
        } toe_ien[7:7];
        field {
            name = "gmac1_ien";
            desc = "Enable of all interrupts from GMAC1.";
            sw = rw; hw = r;
            reset = 0x0;
        } gmac1_ien[6:6];
        field {
            name = "gmac0_ien";
            desc = "Enable of all interrupts from GMAC0.";
            sw = rw; hw = r;
            reset = 0x0;
        } gmac0_ien[5:5];
        field {
            name = "dma_ch2_ien";
            desc = "Enable of all interrupts from DMA2.";
            sw = rw; hw = r;
            reset = 0x0;
        } dma_ch2_ien[4:4];
        field {
            name = "dma_ch1_ien";
            desc = "Enable of all interrupts from DMA1.";
            sw = rw; hw = r;
            reset = 0x0;
        } dma_ch1_ien[3:3];
        field {
            name = "dma_ch0_ien";
            desc = "Enable of all interrupts from DMA0.";
            sw = rw; hw = r;
            reset = 0x0;
        } dma_ch0_ien[2:2];
        field {
            name = "dma_ttx_err_ien";
            desc = "Interrupt enable of dma_ttx_err_int.";
            sw = rw; hw = r;
            reset = 0x0;
        } dma_ttx_err_ien[1:1];
        field {
            name = "dma_ttx_ack_ien";
            desc = "Interrupt enable of dma_ttx_ack_int.";
            sw = rw; hw = r;
            reset = 0x0;
        } dma_ttx_ack_ien[0:0];
    } TNK_INTR_EN @ 0x9004;
    reg {
        name = "TNK_RESET_STAT";
        desc = "TNK_RESET_STAT is the MAC reset status register. TNK_RESET_STAT (offset 0x09008, total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 863, section 5.6).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_2[31:2];
        field {
            name = "mac1_in_reset";
            desc = "If this value is 1, the reset of MAC1 is asserted, and the MAC does not leave the reset state before the MAC receive clock and transmit clock toggle.
- 0: The MAC is not in the reset state.
- 1: The MAC is in the reset state.";
            sw = r; hw = w;
            reset = 0x0;
        } mac1_in_reset[1:1];
        field {
            name = "mac0_in_reset";
            desc = "If this value is 1, the reset of MAC0 is asserted, and the MAC does not leave the reset state until the MAC receive clock and transmit clock have toggled.
- 0: MAC is not in the reset state;
- 1: MAC is in the reset state.";
            sw = r; hw = w;
            reset = 0x0;
        } mac0_in_reset[0:0];
    } TNK_RESET_STAT @ 0x9008;
    reg {
        name = "TNK_ID";
        desc = "TNK_ID is the register for the supported number of connections and the hardware version number. TNK_ID (offset 0x0900C, total reset 0x0001_00FF; PROVEN: Hi3535 data sheet, PDF page 863, section 5.6).";
        field {
            name = "tnk_id";
            desc = "Hardware version number.";
            sw = r; hw = w;
            reset = 0x1;
        } tnk_id[31:16];
        field {
            name = "num_conn";
            desc = "Number of supported connections. Contents";
            sw = r; hw = w;
            reset = 0xff;
        } num_conn[15:0];
    } TNK_ID @ 0x900c;
};

`endif
