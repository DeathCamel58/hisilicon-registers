        name = "DDRC_HIS_FLUX_RCMD";
        desc = "DDRC_HIS_FLUX_RCMD is the register counting all read commands in the DDRC. DDRC_HIS_FLUX_RCMD (offset 0x38C, total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 653, section 4.1.6.2).";
        field {
            name = "flux_rd_cmd";
            desc = "Count of MASTER read commands of all IDs in the DDRC. Counts within the valid statistics period. Wraps around on overflow when perf_mode=0; holds on overflow when perf_mode=1. Cleared when the next statistics period starts.";
            sw = r; hw = w;
            reset = 0x0;
        } flux_rd_cmd[31:0];
    } DDRC_HIS_FLUX_RCMD @ 0x38c;
    reg {
        name = "DDRC_HIS_FLUXID_WR";
        desc = "DDRC_HIS_FLUXID_WR is the DDRC write traffic statistics register for the specified ID. DDRC_HIS_FLUXID_WR (offset 0x390, total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 653, section 4.1.6.2).";
        field {
            name = "fluxid_wr";
            desc = "Write traffic count of the MASTER with the specified ID in the DDRC. It counts within the valid statistics period, in units of the 128-bit DMC data width. When perf_mode=0 it wraps around on overflow; when perf_mode=1 it holds on overflow. It is cleared when the next statistics period starts.";
            sw = r; hw = w;
            reset = 0x0;
        } fluxid_wr[31:0];
    } DDRC_HIS_FLUXID_WR @ 0x390;
    reg {
        name = "DDRC_HIS_FLUXID_RD";
        desc = "DDRC_HIS_FLUXID_RD is the DDRC read traffic statistics register for the specified ID. DDRC_HIS_FLUXID_RD (offset 0x394, total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 654, section 4.1.6.2).";
        field {
            name = "fluxid_rd";
            desc = "Read traffic statistics of the DDRC for the MASTER with the specified ID. Counts within the valid statistics period. The unit is the DMC data width of 128 bits. When perf_mode is 0, it wraps around on overflow. When perf_mode is 1, it holds its value on overflow. It is cleared when the next statistics period starts.";
            sw = r; hw = w;
            reset = 0x0;
        } fluxid_rd[31:0];
    } DDRC_HIS_FLUXID_RD @ 0x394;
    reg {
        name = "DDRC_HIS_FLUXID_WCMD";
        desc = "DDRC_HIS_FLUXID_WCMD is the register for the number of write commands of all specified IDs in the DDRC. DDRC_HIS_FLUXID_WCMD (offset 0x0398, total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 654, section 4.1.6.2).";
        field {
            name = "fluxid_wr_cmd";
            desc = "Read traffic statistics of the DDRC for the MASTER with the specified ID. Counts within the valid statistics period. The unit is the DMC data width of 128 bits. When perf_mode is 0, it wraps around on overflow. When perf_mode is 1, it holds its value on overflow. It is cleared when the next statistics period starts.";
            sw = r; hw = w;
            reset = 0x0;
        } fluxid_wr_cmd[31:0];
    } DDRC_HIS_FLUXID_WCMD @ 0x398;
    reg {
        name = "DDRC_HIS_FLUXID_RCMD";
        desc = "DDRC_HIS_FLUXID_RCMD is the register for the count of read commands of all specified IDs of the DDRC. DDRC_HIS_FLUXID_RCMD (offset 0x039C, total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 655, section 4.1.6.2).";
        field {
            name = "fluxid_rd_cmd";
            desc = "Count of MASTER read commands of the specified ID in the DDRC. Counts within the valid statistics period. When perf_mode=0, wraps around on overflow; when perf_mode=1, holds the value on overflow. Cleared when the next statistics period starts.";
            sw = r; hw = w;
            reset = 0x0;
        } fluxid_rd_cmd[31:0];
    } DDRC_HIS_FLUXID_RCMD @ 0x39c;
    reg {
        name = "DDRC_HIS_WLATCNT0";
        desc = "DDRC_HIS_WLATCNT0 is write command latency statistics register 0 for the specified ID of the DDRC. DDRC_HIS_WLATCNT0 (offset 0x3A0, total reset 0x0000_FFFF; PROVEN: Hi3535 data sheet, PDF page 655, section 4.1.6.2).";
        field {
            name = "wlatcnt_max";
            desc = "Maximum write command latency statistics for the specified ID of the DDRC. Cleared when the next statistics period starts.";
            sw = r; hw = w;
            reset = 0x0;
        } wlatcnt_max[31:16];
        field {
            name = "wlatcnt_min";
            desc = "Minimum write command latency statistic of the specified ID in the DDRC. Holds the maximum value on overflow. Cleared when the next statistics period starts.";
            sw = r; hw = w;
            reset = 0xffff;
        } wlatcnt_min[15:0];
    } DDRC_HIS_WLATCNT0 @ 0x3a0;
    reg {
        name = "DDRC_HIS_WLATCNT1";
        desc = "DDRC_HIS_WLATCNT1 is write command latency statistics register 1 of the specified ID in the DDRC. DDRC_HIS_WLATCNT1 (offset 0x3A4, total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 656, section 4.1.6.2).";
        field {
            name = "wlatcnt_all";
            desc = "Accumulated latency of write commands of the specified ID within the statistics period (the low 4 bits of the result are ignored). Wraps around on overflow when perf_mode=0; holds on overflow when perf_mode=1. Cleared when the next statistics period starts. Note: software can obtain the average latency of write commands of the specified ID as (wlatcnt_all)/fluxid_wr_cmd.";
            sw = r; hw = w;
            reset = 0x0;
        } wlatcnt_all[31:0];
    } DDRC_HIS_WLATCNT1 @ 0x3a4;
    reg {
        name = "DDRC_HIS_RLATCNT0";
        desc = "DDRC_HIS_RLATCNT0 is read command latency statistics register 0 for the specified ID of the DDRC. DDRC_HIS_RLATCNT0 (offset 0x3A8, total reset 0x0000_FFFF; PROVEN: Hi3535 data sheet, PDF page 656, section 4.1.6.2).";
        field {
            name = "rlatcnt_max";
            desc = "Maximum read command latency statistics for the specified ID of the DDRC. The actual maximum read latency is rlatcnt_max + inhere_rlatcnt. Holds the maximum value on overflow. Cleared when the next statistics period starts.";
            sw = r; hw = w;
            reset = 0x0;
        } rlatcnt_max[31:16];
        field {
            name = "rlatcnt_min";
            desc = "DDRC minimum read command latency statistics for the specified ID. Note: The actual minimum read latency is rlatcnt_min + inhere_rlatcnt. Holds the maximum value on overflow. Cleared when the next statistics run starts.";
            sw = r; hw = w;
            reset = 0xffff;
        } rlatcnt_min[15:0];
    } DDRC_HIS_RLATCNT0 @ 0x3a8;
    reg {
        name = "DDRC_HIS_RLATCNT1";
        desc = "DDRC_HIS_RLATCNT1 is read command latency statistics register 1 of the specified ID in the DDRC. DDRC_HIS_RLATCNT1 (offset 0x3AC, total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 657, section 4.1.6.2).";
        field {
            name = "rlatcnt_all";
            desc = "Accumulated read command latency for the specified ID within the statistics period (the low 4 bits of the result are ignored). When perf_mode=0 it wraps around on overflow; when perf_mode=1 it holds the value on overflow. Cleared when the next statistics period starts. Note: Software can obtain the average read command latency of the specified ID from (rlatcnt_all/fluxid_rd_cmd + inhere_rlatcnt.";
            sw = r; hw = w;
            reset = 0x0;
        } rlatcnt_all[31:0];
    } DDRC_HIS_RLATCNT1 @ 0x3ac;
    reg {
        name = "DDRC_HIS_INHERE_RLAT_CNT";
        desc = "DDRC_HIS_INHERE_RLAT_CNT is the read channel inherent latency register. DDRC_HIS_INHERE_RLAT_CNT (offset 0x3B0, total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 657, section 4.1.6.2).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_16[31:16];
        field {
            name = "inhere_rlatcnt";
            desc = "Indicates the inherent delay of the DDRC and PHY on the read data path. This register must be used together with rlatcnt_min, rlatcnt_max, rlatcnt_all and fluxid_rd_cmd to obtain the true latency.";
            sw = r; hw = w;
            reset = 0x0;
        } inhere_rlatcnt[15:0];
    } DDRC_HIS_INHERE_RLAT_CNT @ 0x3b0;
    reg {
        name = "DDRC_HIS_CMD_SUM";
        desc = "DDRC_HIS_CMD_SUM is the accumulation register for the DMC command count. DDRC_HIS_CMD_SUM (offset 0x3BC, total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 658, section 4.1.6.2).";
        field {
            name = "dmc_cmd_sum";
            desc = "Accumulates, per cycle, the value of the commands currently buffered in the DMC; wraps around on overflow.";
            sw = r; hw = w;
            reset = 0x0;
        } dmc_cmd_sum[31:0];
    } DDRC_HIS_CMD_SUM @ 0x3bc;
    reg {
        name = "DDRC_HIS_SFC_RDATA0";
        desc = "DDRC_HIS_SFC_RDATA0 is the SFC (Software config) read data register. DDRC_HIS_SFC_RDATA0 (offset 0x4A8, total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 658, section 4.1.6.2).";
        field {
            name = "rdata0";
            desc = "SFC read data [127:96].";
            sw = rw; hw = r;
            reset = 0x0;
        } rdata0[31:0];
    } DDRC_HIS_SFC_RDATA0 @ 0x4a8;
    reg {
        name = "DDRC_HIS_SFC_RDATA1";
        desc = "DDRC_HIS_SFC_RDATA1 is the SFC (Software config) read data register. DDRC_HIS_SFC_RDATA1 (offset 0x4AC, total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 658, section 4.1.6.2).";
        field {
            name = "rdata1";
            desc = "SFC read data [95:64].";
            sw = rw; hw = r;
            reset = 0x0;
        } rdata1[31:0];
    } DDRC_HIS_SFC_RDATA1 @ 0x4ac;
    reg {
        name = "DDRC_HIS_SFC_RDATA2";
        desc = "DDRC_HIS_SFC_RDATA2 is the SFC (software config) read data register. DDRC_HIS_SFC_RDATA2 (offset 0x4B0, total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 659, section 4.1.6.2).";
        field {
            name = "rdata2";
            desc = "SFC read data [63:32].";
            sw = rw; hw = r;
            reset = 0x0;
        } rdata2[31:0];
    } DDRC_HIS_SFC_RDATA2 @ 0x4b0;
    reg {
        name = "DDRC_HIS_SFC_RDATA3";
        desc = "DDRC_HIS_SFC_RDATA3 is the SFC (Software config) read data register. DDRC_HIS_SFC_RDATA3 (offset 0x4B4, total reset 0x0000_0000; PROVEN: Hi3535 data sheet, PDF page 659, section 4.1.6.2).";
        field {
            name = "rdata3";
            desc = "SFC read data [31:0]; in RD_MRS mode, [7:0] is the register value read back from the LP DDR2 MRS.";
            sw = rw; hw = r;
            reset = 0x0;
        } rdata3[31:0];
    } DDRC_HIS_SFC_RDATA3 @ 0x4b4;
};

`endif
