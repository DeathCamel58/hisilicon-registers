            desc = "Mute control bit of the ADCR.
- 0: The ADCR is unmuted.
- 1: The ADCR is muted.";
            sw = rw; hw = r;
            reset = 0x0;
        } adcr_mute[23:23];
        field {
            name = "adcr_vol";
            desc = "Volume control for the ADCR.
- 00: 30 dB
- 01: 29 dB
- 02: 28 dB ... 7E: –96 dB 7F: –97 dB";
            sw = rw; hw = r;
            reset = 0x0;
        } adcr_vol[22:16];
        field {
            name = "adcl_hpf_en";
            desc = "High-pass filter enable control for the ADCL.
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } adcl_hpf_en[15:15];
        field {
            name = "adcr_hpf_en";
            desc = "High-pass filter enable control for the ADCR.
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } adcr_hpf_en[14:14];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = rw; hw = r;
            reset = 0x0;
        } reserved_13_0[13:0];
    } PERIPHCTRL18 @ 0x78;
    reg {
        name = "PERIPHCTRL19";
        desc = "PERIPHCTRL19 is peripheral control register 19 (audio CODEC control register 5). PERIPHCTRL19 (offset 0x007C, total reset 0x0000_0000; PROVEN: Hi3518E V100 data sheet, PDF page 222, section 3.4.6). Data sheet inconsistency: the total reset value reads 0x0000_0000 (used here) but the bit diagram shows 0x2424_2424; the audio codec registers of the Hi3535 (MISC_CTRL51-55) and Hi3520D with the same field layout have non-zero defaults equal to the bit diagram, so the bit diagram is probably right (UNVERIFIED).";
        field {
            name = "adcl2dacl_en";
            desc = "Mixer control signal of adcl2dacl.
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } adcl2dacl_en[31:31];
        field {
            name = "adcl2dacl_vol";
            desc = "Volume control bit of dacl to dacl.
- 00: 36 dB
- 01: 35 dB
- 02: 34 dB ... 7E: –90 dB 7F: –91 dB";
            sw = rw; hw = r;
            reset = 0x0;
        } adcl2dacl_vol[30:24];
        field {
            name = "adcr2dacl_en";
            desc = "Mixer control signal of adcr2dacl.
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } adcr2dacl_en[23:23];
        field {
            name = "adcr2dacl_vol";
            desc = "Volume control bit of dacr to dacl.
- 00: 36 dB
- 01: 35 dB
- 02: 34 dB ... 7E: –90 dB 7F: –91 dB";
            sw = rw; hw = r;
            reset = 0x0;
        } adcr2dacl_vol[22:16];
        field {
            name = "adcl2dacr_en";
            desc = "Mixer control signal of adcl2dacr.
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } adcl2dacr_en[15:15];
        field {
            name = "adcl2dacr_vol";
            desc = "Volume control bit of dacl to dacr.
- 00: 36 dB
- 01: 35 dB
- 02: 34 dB ... 7E: –90 dB 7F: –91 dB";
            sw = rw; hw = r;
            reset = 0x0;
        } adcl2dacr_vol[14:8];
        field {
            name = "adcr2dacr_en";
            desc = "Mixer control signal of adcr2dacr.
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } adcr2dacr_en[7:7];
        field {
            name = "adcr2dacr_vol";
            desc = "Volume control bit of dacr to dacr.
- 00: 36 dB
- 01: 35 dB
- 02: 34 dB ... 7E: –90 dB 7F: –91 dB";
            sw = rw; hw = r;
            reset = 0x0;
        } adcr2dacr_vol[6:0];
    } PERIPHCTRL19 @ 0x7c;
    reg {
        name = "PERIPHCTRL20";
