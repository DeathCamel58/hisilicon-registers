- 0: do not power off the analog power
- 1: power off the analog power

The default value is 0. The bit must be set to 0 before the built-in self test (BIST).";
            sw = rw; hw = r;
            reset = 0x0;
        } siddq[22:22];
        field {
            name = "commononn";
            desc = "Indicates whether XO BIAS BANDGAP PLL works when the PHY is suspended.
- 0: clk48m_ohci output is always valid even when the PHY is suspended.
- 1: clk48m_ohci output is valid except when the PHY is suspended.";
            sw = rw; hw = r;
            reset = 0x0;
        } commononn[21:21];
        field {
            name = "phy0_txhsxvtune";
