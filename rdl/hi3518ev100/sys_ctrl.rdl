- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } phy0_ovrcur_en[14:14];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x1;
        } reserved_13_13[13:13];
        field {
            name = "phy0_pwr_en";
            desc = "Power-off control for the PHY0 power supply.
