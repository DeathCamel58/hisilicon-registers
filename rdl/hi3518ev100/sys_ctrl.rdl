- 0: default value
- 1: –8%";
            sw = rw; hw = r;
            reset = 0x0;
        } phy0_txrisetune[4:4];
        field {
            name = "phy0_txverftune";
            desc = "DC level tune signal in HS mode of PHY0.
- 0x0: –10%
- 0x1: –8.75%
- 0x2: –7.5%
- 0x3: –6.25%
- 0x4: –5%
- 0x5: –3.75%
- 0x6: –2.5%
- 0x7: –1.25%
- 0x8: default value
- 0x9: +1.25%
- 0xA: +2.5%
- 0xB: +3.7%
- 0xC: +5%
- 0xD: +6.25%
- 0xE: +7.5%
- 0xF: +8.75%";
            sw = rw; hw = r;
            reset = 0x8;
        } phy0_txverftune[3:0];
    } PERIPHCTRL21 @ 0x84;
    reg {
        name = "SYSSTAT";
