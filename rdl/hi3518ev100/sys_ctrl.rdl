`ifndef EHI3518EV100_SYS_CTRL_RDL
`define EHI3518EV100_SYS_CTRL_RDL
regfile eHI3518EV100_SYS_CTRL {
    name = "System controller (SC)";
    desc = "System controller (SC). 32 registers extracted programmatically from the Hi3518E 720p IP Camera SoC data sheet (Issue 03, 2015-11-26); chapter 3.4.6, table 3-22. Field names, bit ranges, access types and reset values are taken from the register tables; reset values are the data sheet total reset values split onto the fields (per-field values where the table has them). Label: PROVEN. Hardware not verified here (no board).";
    reg {
        name = "SC_CTRL";
        desc = "SC_CTRL is a system control register. It is used to specify the operations that are performed by the system. Write protection for this register can be enabled by configuring SC_LOCKEN. This register can be written only when write protection is disabled. SC_CTRL (offset 0x000, total reset 0x0000_0212; PROVEN: Hi3518E V100 data sheet, PDF page 198, section 3.4.6).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = rw; hw = r;
            reset = 0x0;
        } reserved_31_24[31:24];
        field {
            name = "wdogenov";
            desc = "Watchdog count clock select.
- 0: 3 MHz clock
- 1: bus clock";
            sw = rw; hw = r;
            reset = 0x0;
        } wdogenov[23:23];
        field {
            name = "timeren3ov";
            desc = "Count clock select of timer3.
- 0: 3 MHz clock.
- 1: bus clock";
            sw = rw; hw = r;
            reset = 0x0;
        } timeren3ov[22:22];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = rw; hw = r;
            reset = 0x0;
        } reserved_21_21[21:21];
        field {
            name = "timeren2ov";
            desc = "Count clock select of timer2.
- 0: 3 MHz clock
- 1: bus clock";
            sw = rw; hw = r;
            reset = 0x0;
        } timeren2ov[20:20];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = rw; hw = r;
            reset = 0x0;
        } reserved_19_19[19:19];
        field {
            name = "timeren1ov";
            desc = "Count clock select of timer1.
- 0: 3 MHz clock
- 1: bus clock";
            sw = rw; hw = r;
            reset = 0x0;
        } timeren1ov[18:18];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = rw; hw = r;
            reset = 0x0;
        } reserved_17_17[17:17];
        field {
            name = "timeren0ov";
            desc = "Count clock select of timer0.
- 0: 3 MHz clock
- 1: bus clock";
            sw = rw; hw = r;
            reset = 0x0;
        } timeren0ov[16:16];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = rw; hw = r;
            reset = 0x0;
        } reserved_15_15[15:15];
        field {
            name = "reserved";
            desc = "Reserved. Reading this field returns 0 and writing to this field has no effect.";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_14_10[14:10];
        field {
            name = "remapstat";
            desc = "Status of address remap.
- 0: The address is not remapped.
- 1: The address is remapped. The details are as follows:

SFC is remapped to address 0.";
            sw = r; hw = w;
            reset = 0x1;
        } remapstat[9:9];
        field {
            name = "remapclear";
            desc = "Address remap clear.
- 0: keep the remap status
- 1: clear the remap status

For details about the address mappings before and after remapping is cleared, see Table 1-1.";
            sw = rw; hw = r;
            reset = 0x0;
        } remapclear[8:8];
        field {
            name = "reserved";
            desc = "Reserved. Reading this bit returns 0 and writing to this bit has no effect.";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_7_7[7:7];
        field {
            name = "modestatus";
            desc = "Mode status. The current operating mode of the system is returned.
- 0x0: reserved
- 0x1: doze
- 0x2: slow
- 0x3: XTAL CTL
- 0x4: normal
- 0x6: PLL CTL
- 0x9: SW from XTAL
- 0xA: SW from PLL
- 0xB: SW to XTAL
- 0xE: SW to PLL

Other values: reserved";
            sw = rw; hw = r;
            reset = 0x2;
        } modestatus[6:3];
        field {
            name = "modectrl";
            desc = "Mode control. This field defines the operating mode to which the system controller is switched.
- 000: reserved
- 001: doze
- 010: slow
- 100: normal";
            sw = rw; hw = r;
            reset = 0x2;
        } modectrl[2:0];
    } SC_CTRL @ 0x0;
    reg {
        name = "SC_SYSRES";
        desc = "SC_SYSRES is a system soft reset register. When any value is written to this register, the system controller transmits a system soft reset request to the reset module. Then the reset module resets the system. Write protection for this register can be enabled by configuring SC_LOCKEN. This register can be written only when write protection is disabled. SC_SYSRES (offset 0x004, total reset 0x0000_0002; PROVEN: Hi3518E V100 data sheet, PDF page 200, section 3.4.6).";
        field {
            name = "softresreq";
            desc = "The system is reset when any value is written to this register.";
            sw = w; hw = r;
            reset = 0x2;
        } softresreq[31:0];
    } SC_SYSRES @ 0x4;
    reg {
        name = "SC_IMCTRL";
        desc = "SC_IMCTRL is an interrupt mode control register. It is used to control the system mode when an interrupt is generated. SC_IMCTRL (offset 0x008, total reset 0x0000_0000; PROVEN: Hi3518E V100 data sheet, PDF page 200, section 3.4.6).";
        field {
            name = "reserved";
            desc = "Reserved. Reading this field returns 0x000000 and writing to this field has no effect.";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_8[31:8];
        field {
            name = "inmdtype";
            desc = "Type of the interrupt for triggering the interrupt mode of the system.
- 0: fast interrupt request (FIQ) interrupt
- 1: FIQ interrupt or interrupt request (IRQ) interrupt";
            sw = rw; hw = r;
            reset = 0x0;
        } inmdtype[7:7];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_6_4[6:4];
        field {
            name = "itmdctrl";
            desc = "Operating mode of the system with the lowest speed in interrupt mode. The value obtained after the values of this register and SC_CTRL[modectrl] are ORed indicates the operating mode of the system after an interrupt is generated. The definitions of these bits are as follows:
- 000: sleep
- 001: doze 01X: slow 1XX: normal";
            sw = rw; hw = r;
            reset = 0x0;
        } itmdctrl[3:1];
        field {
            name = "itmden";
            desc = "Interrupt mode enable.
- 0: disabled
- 1: enabled. When an interrupt is generated, the system enters the interrupt mode.";
            sw = rw; hw = r;
            reset = 0x0;
        } itmden[0:0];
    } SC_IMCTRL @ 0x8;
    reg {
        name = "SC_IMSTAT";
        desc = "SC_IMSTAT is an interrupt mode status register. It is used to check whether the system is in interrupt mode. The system can be set to the interrupt mode forcibly by configuring this register. When the interrupt service routine (ISR) ends, the interrupt mode must be cleared manually. SC_IMSTAT (offset 0x00C, total reset 0x0000_0000; PROVEN: Hi3518E V100 data sheet, PDF page 201, section 3.4.6).";
        field {
            name = "reserved";
            desc = "Reserved. Reading this field returns 0x00000000 and writing to this field has no effect.";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_1[31:1];
        field {
            name = "itmdstat";
            desc = "Interrupt mode status. The bit is used by software for controlling whether the system enters the interrupt mode. When the register is read:
- 0: The system is not in interrupt mode.
- 1: The system is in interrupt mode.

When the register is written:
- 0: Software controls whether the system enters the interrupt mode.
- 1: Software does not control whether the system enters the interrupt mode.";
            sw = rw; hw = r;
            reset = 0x0;
        } itmdstat[0:0];
    } SC_IMSTAT @ 0xc;
    reg {
        name = "SC_XTALCTRL";
        desc = "SC_XTALCTRL is a crystal oscillator control register. It is used to specify the stable wait time after the clock module is initialized. The stable wait time is the period when the system is switched from the XTAL CTL mode to the SW-to-XTAL mode. SC_XTALCTRL (offset 0x010, total reset 0x0000_0000; PROVEN: Hi3518E V100 data sheet, PDF page 202, section 3.4.6).";
        field {
            name = "reserved";
            desc = "Reserved. Reading this field returns 0x0000 and writing to this field has no effect.";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_19[31:19];
        field {
            name = "xtaltime";
            desc = "Wait time of crystal oscillator switching. The value of this field is used to specify the time spent on switching the system mode from XTAL CTL to SW-to-XTAL. The wait cycle can be calculated as follows: (65536 – xtaltime) x T46.8 K. T46.8 K indicates the clock cycle of the 46.8 kHz clock.";
            sw = rw; hw = r;
            reset = 0x0;
        } xtaltime[18:3];
        field {
            name = "reserved";
            desc = "Reserved. Reading this bit returns 0x0 and writing to this bit has no effect.";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_2_2[2:2];
        field {
            name = "reserved";
            desc = "Reserved. Reading this field returns the written value and writing to this field has no effect.";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_1_0[1:0];
    } SC_XTALCTRL @ 0x10;
    reg {
        name = "SC_PLLCTRL";
        desc = "SC_PLLCTRL is a PLL control register. It is used to control whether to enable the on-chip ARMPLL through software or system mode switching. It also sets the stable time of the ARMPLL. Write protection for this register can be enabled by configuring SC_LOCKEN. This register can be written only when write protection is disabled. When the ARMPLL is enabled by switching the system mode (namely, by configuring SC_PLLCTRL[pllover]), the ARMPLL is disabled automatically if the system is not in normal mode. The clock frequency of the APLL is controlled by PERI_CRG0 and PERI_CRG1. When the PLL frequency is changed, a stable clock can be output only after 0.5 ms. Therefore, the plltime of this register must meet this requirement. SC_PLLCTRL (offset 0x014, total reset 0x0000_0000; PROVEN: Hi3518E V100 data sheet, PDF page 203, section 3.4.6).";
        field {
            name = "reserved";
            desc = "Reserved. Reading this bit returns 0x0 and writing to this bit has no effect.";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_28[31:28];
        field {
            name = "plltime";
            desc = "Stable time of the ARMPLL. This time refers to the period from the start of the PLL to the output of a stable PLL clock. That is, the wait time of switching the system mode from PLL CTL to SW-to-PLL. The timeout is calculated as follows: 4 x (33554432 – plltime) x TXIN. TXIN indicates the clock cycle of the external crystal oscillator of the Hi3518E.";
            sw = rw; hw = r;
            reset = 0x0;
        } plltime[27:3];
        field {
            name = "reserved";
            desc = "Reserved. Reading this bit returns 0x0 and writing to this bit has no effect.";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_2_2[2:2];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_1_1[1:1];
        field {
            name = "pllover";
            desc = "Whether the ARMPLL is enabled is controlled by the software rather than system mode switching. This bit must be set to 0.
- 0: The ARMPLL is enabled by switching the system mode.
- 1: reserved";
            sw = rw; hw = r;
            reset = 0x0;
        } pllover[0:0];
    } SC_PLLCTRL @ 0x14;
    reg {
        name = "PERIPHCTRL0";
        desc = "PERIPHCTRL0 is peripheral control register 0. Write protection for this register can be enabled by configuring SC_LOCKEN. This register can be written only when write protection is disabled. PERIPHCTRL0 (offset 0x01C, total reset 0x0022_1000; PROVEN: Hi3518E V100 data sheet, PDF page 204, section 3.4.6).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_23[31:23];
        field {
            name = "arm_tcm_gate_en";
            desc = "ARM TCM dynamic clock gating enable.
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } arm_tcm_gate_en[22:22];
        field {
            name = "arm_mem_adjust";
            desc = "ARM9 memory adjustment.";
            sw = rw; hw = r;
            reset = 0x22;
        } arm_mem_adjust[21:16];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_15_15[15:15];
        field {
            name = "global_software_int";
            desc = "Global software interrupt.
- 0: No interrupt is generated.
- 1: An interrupt is generated.";
            sw = rw; hw = r;
            reset = 0x0;
        } global_software_int[14:14];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_13_13[13:13];
        field {
            name = "ddrc_apb_gt_en";
            desc = "DDRC APB clock gating.
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x1;
        } ddrc_apb_gt_en[12:12];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_11_0[11:0];
    } PERIPHCTRL0 @ 0x1c;
    reg {
        name = "PERIPHCTRL1";
        desc = "PERIPHCTRL1 is a software interrupt configuration register. PERIPHCTRL1 (offset 0x0020, total reset 0x0000_0000; PROVEN: Hi3518E V100 data sheet, PDF page 205, section 3.4.6).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_1[31:1];
        field {
            name = "software_int";
            desc = "Software interrupts.
- 0: No interrupt is generated.
- 1: An interrupt is generated.";
            sw = rw; hw = r;
            reset = 0x0;
        } software_int[0:0];
    } PERIPHCTRL1 @ 0x20;
    reg {
        name = "PERIPHCTRL3";
        desc = "PERIPHCTRL3 is peripheral control register 3 (MDDRC out-of-order configuration register outtodr_ctrl). PERIPHCTRL3 (offset 0x0038, total reset 0x0000_0000; PROVEN: Hi3518E V100 data sheet, PDF page 206, section 3.4.6).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_20[31:20];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_19_18[19:18];
        field {
            name = "ive_ctrl";
            desc = "Indicates whether out-of-order is allowed when the IVE subsystem accesses DDR.
- 0: Out-of-order is not allowed.
- 1: Out-of-order is allowed.";
            sw = rw; hw = r;
            reset = 0x0;
        } ive_ctrl[17:17];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_16_8[16:8];
        field {
            name = "mdu_ddrt_ctrl";
            desc = "Indicates whether out-of-order is allowed when MDU or DDRT accesses DDR.
- 0: Out-of-order is not allowed.
- 1: Out-of-order is allowed.";
            sw = rw; hw = r;
            reset = 0x0;
        } mdu_ddrt_ctrl[7:7];
        field {
            name = "jpge_ctrl";
            desc = "Indicates whether out-of-order is allowed when JPGE accesses DDR.
- 0: Out-of-order is not allowed.
- 1: Out-of-order is allowed.";
            sw = rw; hw = r;
            reset = 0x0;
        } jpge_ctrl[6:6];
        field {
            name = "tde_ctrl";
            desc = "Indicates whether out-of-order is allowed when TDE accesses DDR.
- 0: Out-of-order is not allowed.
- 1: Out-of-order is allowed.";
            sw = rw; hw = r;
            reset = 0x0;
        } tde_ctrl[5:5];
        field {
            name = "vpss_ctrl";
            desc = "Indicates whether out-of-order is allowed when VPSS accesses DDR.
- 0: Out-of-order is not allowed.
- 1: Out-of-order is allowed.";
            sw = rw; hw = r;
            reset = 0x0;
        } vpss_ctrl[4:4];
        field {
            name = "venc_ctrl";
            desc = "Indicates whether out-of-order is allowed when VENC accesses DDR.
- 0: Out-of-order is not allowed.
- 1: Out-of-order is allowed.";
            sw = rw; hw = r;
            reset = 0x0;
        } venc_ctrl[3:3];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_2_2[2:2];
        field {
            name = "vicap_ctrl";
            desc = "Indicates whether out-of-order is allowed when the VICAP accesses DDR.
- 0: Out-of-order is not allowed.
- 1: Out-of-order is allowed.";
            sw = rw; hw = r;
            reset = 0x0;
        } vicap_ctrl[1:1];
        field {
            name = "vou_ctrl";
            desc = "Indicates whether out-of-order is allowed when the VOU accesses DDR.
- 0: Out-of-order is not allowed.
- 1: Out-of-order is allowed.";
            sw = rw; hw = r;
            reset = 0x0;
        } vou_ctrl[0:0];
    } PERIPHCTRL3 @ 0x38;
    reg {
        name = "PERIPHCTRL4";
        desc = "PERIPHCTRL4 is peripheral control register 4. PERIPHCTRL4 (offset 0x003C, total reset 0x0000_01E0; PROVEN: Hi3518E V100 data sheet, PDF page 207, section 3.4.6).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_17[31:17];
        field {
            name = "cbar_en";
            desc = "cbar_en output enable.
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } cbar_en[16:16];
        field {
            name = "mdu_ddrt_sel";
            desc = "Motion detection unit (MDU) and DDR test (DDRT) function select.
- 0: Only the MDU is enabled.
- 1: Only the DDRT is enabled.";
            sw = rw; hw = r;
            reset = 0x0;
        } mdu_ddrt_sel[15:15];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x3c;
        } reserved_14_3[14:3];
        field {
            name = "sdio_det_mode";
            desc = "Signal detection mode of the SDIO card.
- 0: active low
- 1: active high";
            sw = rw; hw = r;
            reset = 0x0;
        } sdio_det_mode[2:2];
        field {
            name = "uart1_rts_ctrl";
            desc = "UART1 RTS output control.
- 0: normal output
- 1: reverse output";
            sw = rw; hw = r;
            reset = 0x0;
        } uart1_rts_ctrl[1:1];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_0_0[0:0];
    } PERIPHCTRL4 @ 0x3c;
    reg {
        name = "PERIPHCTRL5";
        desc = "PERIPHCTRL5 is peripheral control register 5 (media bus timeout control register 1 for master port l). PERIPHCTRL5 (offset 0x0040, total reset 0x0000_0000; PROVEN: Hi3518E V100 data sheet, PDF page 208, section 3.4.6).";
        field {
            name = "count_en_media0_port1";
            desc = "Timeout count enable of the VPSS port.
- 0: Disabled;
- 1: Enabled.";
            sw = rw; hw = r;
            reset = 0x0;
        } count_en_media0_port1[31:31];
        field {
            name = "over_value_media0_port1";
            desc = "Timeout count value of the VPSS port.
Count value = over_value_media0_port1 x 2.";
            sw = rw; hw = r;
            reset = 0x0;
        } over_value_media0_port1[30:16];
        field {
            name = "count_en_media0_port0";
            desc = "Timeout count enable of the VENC port.
- 0: Disabled;
- 1: Enabled.";
            sw = rw; hw = r;
            reset = 0x0;
        } count_en_media0_port0[15:15];
        field {
            name = "over_value_media0_port0";
            desc = "Timeout count value of the VENC port.
Count value = over_value_media0_port0 x 2.";
            sw = rw; hw = r;
            reset = 0x0;
        } over_value_media0_port0[14:0];
    } PERIPHCTRL5 @ 0x40;
    reg {
        name = "SC_LOCKEN";
        desc = "SC_LOCKEN is a register for locking key system control registers. SC_LOCKEN (offset 0x0044, total reset 0x0000_0000; PROVEN: Hi3518E V100 data sheet, PDF page 209, section 3.4.6).";
        field {
            name = "scper_lockl";
            desc = "Register for locking key system control registers. The key registers include SC_CTRL, SYSSTAT, and SC_PLLCTRL. When 0x1ACC_E551 is written to SC_LOCKEN, the write permission for all registers is enabled; when any other value is written to SC_LOCKEN, the write permission is disabled. Reading this register returns the lock status rather than its written value. 0x0000_0000: The write permission is enabled (unlocked). 0x0000_0001: The write permission is disabled (locked).";
            sw = rw; hw = r;
            reset = 0x0;
        } scper_lockl[31:0];
    } SC_LOCKEN @ 0x44;
    reg {
        name = "PERIPHCTRL6";
        desc = "PERIPHCTRL6 is peripheral control register 6 (media bus timeout control register 2 for master port l). PERIPHCTRL6 (offset 0x0048, total reset 0x0000_0000; PROVEN: Hi3518E V100 data sheet, PDF page 209, section 3.4.6).";
        field {
            name = "count_en_media0_port3";
            desc = "Timeout count enable of the JPGE port.
- 0: Disabled;
- 1: Enabled.";
            sw = rw; hw = r;
            reset = 0x0;
        } count_en_media0_port3[31:31];
        field {
            name = "over_value_media0_port3";
            desc = "Timeout count value of the JPGE port.
Count value = over_value_media0_port3 x 2.";
            sw = rw; hw = r;
            reset = 0x0;
        } over_value_media0_port3[30:16];
        field {
            name = "count_en_media0_port2";
            desc = "Timeout count enable of the TDE port.
- 0: Disabled;
- 1: Enabled.";
            sw = rw; hw = r;
            reset = 0x0;
        } count_en_media0_port2[15:15];
        field {
            name = "over_value_media0_port2";
            desc = "Timeout count value of the TDE port.
Count value = over_value_media0_port2 x 2.";
            sw = rw; hw = r;
            reset = 0x0;
        } over_value_media0_port2[14:0];
    } PERIPHCTRL6 @ 0x48;
    reg {
        name = "PERIPHCTRL7";
        desc = "PERIPHCTRL7 is peripheral control register 7 (media bus timeout control register 3 for master port l). PERIPHCTRL7 (offset 0x004C, total reset 0x0000_0000; PROVEN: Hi3518E V100 data sheet, PDF page 210, section 3.4.6).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_16[31:16];
        field {
            name = "count_en_media0_port4";
            desc = "Timeout count enable for the MDU port.
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } count_en_media0_port4[15:15];
        field {
            name = "over_value_media0_port4";
            desc = "Timeout count value of the MDU port. Count value = over_value_media0_port4 x 2";
            sw = rw; hw = r;
            reset = 0x0;
        } over_value_media0_port4[14:0];
    } PERIPHCTRL7 @ 0x4c;
    reg {
        name = "PERIPHCTRL9";
        desc = "PERIPHCTRL9 is peripheral control register 9 (media bus priority configuration register for master port l). PERIPHCTRL9 (offset 0x0054, total reset 0x0001_2345; PROVEN: Hi3518E V100 data sheet, PDF page 211, section 3.4.6).";
        field {
            name = "reserved";
