        field {
            name = "ss_ena_incr8_i";
            desc = "AHB burst8 enable.
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x1;
        } ss_ena_incr8_i[8:8];
        field {
            name = "ss_ena_incr4_i";
            desc = "AHB burst4 enable.
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x1;
