            sw = rw; hw = r;
            reset = 0x1;
        } phy0_sleepm[18:18];
        field {
            name = "phy0_loopbackenb";
            desc = "Loopback (from D+ to D-) test enable signal of PHY0. This bit must be set to 0.";
            sw = rw; hw = r;
            reset = 0x0;
        } phy0_loopbackenb[17:17];
        field {
            name = "phy0_compdistune";
            desc = "HOSDISCONNECT threshold level tune signal of PHY0.
- 000: –6%
- 001: –4.5%
- 010: –3%
- 100: default value
- 101: +1.5%
- 110: +3%
- 111: +4.5%

Other values: reserved";
            sw = rw; hw = r;
            reset = 0x4;
        } phy0_compdistune[16:14];
        field {
            name = "phy0_sqrxtune";
            desc = "Squelch circuit tune signal of PHY0.
- 000: +20%
- 001: +15%
- 010: +10%
- 011: +5%
- 100: default value
- 101: –5%
- 110: –10%
- 111: –15%";
            sw = rw; hw = r;
            reset = 0x4;
        } phy0_sqrxtune[13:11];
        field {
            name = "phy0_txfslstune";
            desc = "FS LS impedance tune signal of PHY0.
- 0x0: +5%
- 0x1: +2.5%
- 0x3: default value
- 0x7: –2.5%
- 0xF: –5%

Other values: reserved";
            sw = rw; hw = r;
            reset = 0x3;
        } phy0_txfslstune[10:7];
        field {
            name = "phy0_txpreemphasistune";
            desc = "Pre-emphasis transmit enable signal of PHY0 in HS mode. The default value is 0.
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } phy0_txpreemphasistune[6:6];
        field {
            name = "reserved";
