    reg {
        name = "PERIPHCTRL21";
        desc = "PERIPHCTRL21 is USB control register 2 (peripheral control register 21). PERIPHCTRL21 (offset 0x0084, total reset 0x001D_2188; PROVEN: Hi3518E V100 data sheet, PDF page 225, section 3.4.6).";
        field {
            name = "reserved";
