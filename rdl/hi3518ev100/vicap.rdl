        } reserved_15_1[15:1];
        field {
            name = "int_ch0";
            desc = "Channel 0 interrupt indicator.
- 0: No interrupt is generated.
- 1: An interrupt is generated.";
            sw = r; hw = w;
            reset = 0x0;
        } int_ch0[0:0];
    } VICAP_INT @ 0xf0;
    reg {
