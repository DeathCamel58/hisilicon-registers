            sw = rw; hw = r;
            reset = 0x0;
        } offset[5:0];
    } PT_OFFSET0 @ 0x110;
    reg {
        name = "PT_OFFSET1";
        desc = "PT_OFFSET1 is component 1 offset register. PT_OFFSET1 (offset 0x0114, total reset 0xFFF0_0010; PROVEN: Hi3518E V100 data sheet, PDF page 625, section 10.1.6).";
        field {
            name = "mask";
            desc = "Component 1 mask.";
            sw = rw; hw = r;
            reset = 0xfff0;
        } mask_[31:16];
        field {
            name = "rev";
            desc = "Whether the data line is reversed.
- 0: no
- 1: yes";
            sw = rw; hw = r;
            reset = 0x0;
        } rev[15:15];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_14_6[14:6];
        field {
            name = "offset";
            desc = "Component 1 offset.";
            sw = rw; hw = r;
            reset = 0x10;
        } offset[5:0];
    } PT_OFFSET1 @ 0x114;
    reg {
        name = "PT_OFFSET2";
        desc = "PT_OFFSET2 is component 2 offset register. PT_OFFSET2 (offset 0x0118, total reset 0xFFF0_0020; PROVEN: Hi3518E V100 data sheet, PDF page 626, section 10.1.6).";
        field {
            name = "mask";
            desc = "Component 2 mask.";
            sw = rw; hw = r;
            reset = 0xfff0;
        } mask_[31:16];
        field {
            name = "rev";
            desc = "Whether the data line is reversed.
- 0: no
- 1: yes";
            sw = rw; hw = r;
            reset = 0x0;
        } rev[15:15];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_14_6[14:6];
        field {
            name = "offset";
            desc = "Component 2 offset.";
            sw = rw; hw = r;
            reset = 0x20;
        } offset[5:0];
    } PT_OFFSET2 @ 0x118;
    reg {
        name = "PT_BT656_CFG";
        desc = "PT_BT656_CFG is a BT.656 configuration register. PT_BT656_CFG (offset 0x0120, total reset 0x0000_0303; PROVEN: Hi3518E V100 data sheet, PDF page 626, section 10.1.6).";
        field {
            name = "enable";
            desc = "BT.656 enable.
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } enable_[31:31];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_30_11[30:11];
        field {
            name = "field_inv";
            desc = "Field reverse control.
- 0: not reversed
- 1: reversed";
            sw = rw; hw = r;
            reset = 0x0;
        } field_inv[10:10];
        field {
            name = "vsync_inv";
            desc = "vsync reverse control.
- 0: not reversed
- 1: reversed";
            sw = rw; hw = r;
            reset = 0x1;
        } vsync_inv[9:9];
        field {
            name = "hsync_inv";
            desc = "hsync reverse control.
- 0: not reversed
- 1: reversed";
            sw = rw; hw = r;
            reset = 0x1;
        } hsync_inv[8:8];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_7_4[7:4];
        field {
            name = "mode";
            desc = "Mode select. mode[0]
- 0: hsync is not an active signal.
- 1: hsync is an active signal. mode[1]
- 0: The hsync output is active low.
- 1: The hsync output is active high. mode[3:2]
- 00: Component 0 is parsed.
- 01: Component 1 is parsed.
- 10: Component 2 is parsed.
- 11: reserved";
            sw = rw; hw = r;
            reset = 0x3;
        } mode[3:0];
    } PT_BT656_CFG @ 0x120;
    reg {
        name = "PT_UNIFY_TIMING_CFG";
        desc = "PT_UNIFY_TIMING_CFG is a timing configuration register. PT_UNIFY_TIMING_CFG (offset 0x0130, total reset 0x0008_2801; PROVEN: Hi3518E V100 data sheet, PDF page 628, section 10.1.6).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_27[31:27];
        field {
            name = "field_inv";
            desc = "Field reverse (level-1 processing for field).
- 0: not reversed
- 1: reversed";
            sw = rw; hw = r;
            reset = 0x0;
        } field_inv[26:26];
        field {
            name = "field_sel";
            desc = "Field source select (level-0 processing for field).
- 00: input field
- 01: input vsync
- 10: detected based on the relationship between vsync and hsync
- 11: 0";
            sw = rw; hw = r;
            reset = 0x0;
        } field_sel[25:24];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_23_21[23:21];
        field {
            name = "vsync_mode";
            desc = "vsync processing mode (level-2 processing for vsync).
- 00: No operation is performed.
- 01: Pulses are generated based on the rising edge.
- 10: Pulses are generated based on the rising and falling edge.
- 11: reserved";
            sw = rw; hw = r;
            reset = 0x1;
        } vsync_mode[20:19];
        field {
            name = "vsync_inv";
            desc = "vsync reverse (level-1 processing for vsync).
- 0: not reversed
- 1: reversed";
            sw = rw; hw = r;
            reset = 0x0;
        } vsync_inv[18:18];
        field {
            name = "vsync_sel";
            desc = "vsync source select (level-0 processing for vsync).
- 00: input vsync
- 01: input field
- 10: 0
- 11: reserved";
            sw = rw; hw = r;
            reset = 0x0;
        } vsync_sel[17:16];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_15_15[15:15];
        field {
            name = "hsync_mode";
            desc = "hsync processing mode (level-3 processing for hsync).
- 0: No operation is performed.
- 1: Pulses are generated based on the rising edge.";
            sw = rw; hw = r;
            reset = 0x1;
        } hsync_mode[14:13];
        field {
            name = "hsync_and";
            desc = "Whether hsync is calculated with the level-1 processing result of vsync (level-2 processing for hsync).
- 00: no operation
- 01: AND
- 10: exclusive OR
- 11: reserved";
            sw = rw; hw = r;
            reset = 0x1;
        } hsync_and[12:11];
        field {
            name = "hsync_inv";
