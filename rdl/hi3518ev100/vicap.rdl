- 0: not reversed
- 1: reversed";
            sw = rw; hw = r;
            reset = 0x0;
        } hsync_inv[10:10];
        field {
            name = "hsync_sel";
            desc = "hsync source select (level-0 processing for hsync).
- 00: input vsync
- 01: input de
- 10: 0
- 11: reserved";
            sw = rw; hw = r;
            reset = 0x0;
        } hsync_sel[9:8];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_7_3[7:3];
        field {
            name = "de_inv";
