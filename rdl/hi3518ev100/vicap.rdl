`ifndef EHI3518EV100_VICAP_RDL
`define EHI3518EV100_VICAP_RDL
regfile eHI3518EV100_VICAP {
    name = "Video capture (VICAP)";
    desc = "Video capture (VICAP). 116 registers extracted programmatically from the Hi3518E 720p IP Camera SoC data sheet (Issue 03, 2015-11-26); chapter 10.1.6, table 10-5. Field names, bit ranges, access types and reset values are taken from the register tables; reset values are the data sheet total reset values split onto the fields (per-field values where the table has them). Label: PROVEN. Hardware not verified here (no board).";
    reg {
        name = "WK_MODE";
        desc = "WK_MODE is a global working configuration register. WK_MODE (offset 0x0000, total reset 0x0000_0000; PROVEN: Hi3518E V100 data sheet, PDF page 620, section 10.1.6).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_1[31:1];
        field {
            name = "power_mode";
            desc = "Clock mode.
- 0: The low-power mode is disabled.
- 1: The low-power mode is enabled.";
            sw = rw; hw = r;
            reset = 0x0;
        } power_mode[0:0];
    } WK_MODE @ 0x0;
    reg {
        name = "AXI_CFG";
        desc = "AXI_CFG is a bus configuration register. AXI_CFG (offset 0x0010, total reset 0x0000_0000; PROVEN: Hi3518E V100 data sheet, PDF page 620, section 10.1.6).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_4[31:4];
        field {
            name = "m0_otd";
            desc = "Number of outstandings. The value range is 1−4.";
            sw = rw; hw = r;
            reset = 0x0;
        } m0_otd[3:0];
    } AXI_CFG @ 0x10;
    reg {
        name = "PT_SEL";
        desc = "PT_SEL is a port input select register. PT_SEL (offset 0x0020, total reset 0x0000_0000; PROVEN: Hi3518E V100 data sheet, PDF page 621, section 10.1.6).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_1[31:1];
        field {
            name = "pt0_sel";
            desc = "Port input select.
- 0: external input
- 1: colorbar";
            sw = rw; hw = r;
            reset = 0x0;
        } pt0_sel[0:0];
    } PT_SEL @ 0x20;
    reg {
        name = "CH_SEL";
        desc = "CH_SEL is a channel input select register. CH_SEL (offset 0x0030, total reset 0x0000_0000; PROVEN: Hi3518E V100 data sheet, PDF page 621, section 10.1.6).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_1[31:1];
        field {
            name = "ch0_sel";
            desc = "Channel input select.
- 0: ISP bypass
- 1: input from the ISP";
            sw = rw; hw = r;
            reset = 0x0;
        } ch0_sel[0:0];
    } CH_SEL @ 0x30;
    reg {
        name = "APB_TIMEOUT";
        desc = "APB_TIMEOUT is an APB timeout register. APB_TIMEOUT (offset 0x00E0, total reset 0x8000_0100; PROVEN: Hi3518E V100 data sheet, PDF page 622, section 10.1.6).";
        field {
            name = "enable";
            desc = "Timeout enable.
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x1;
        } enable_[31:31];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_30_16[30:16];
        field {
            name = "timeout";
            desc = "Timeout threshold. The unit is APB clock.";
            sw = rw; hw = r;
            reset = 0x100;
        } timeout[15:0];
    } APB_TIMEOUT @ 0xe0;
    reg {
        name = "VICAP_INT";
        desc = "VICAP_INT is an interrupt indicator register. VICAP_INT (offset 0x00F0, total reset 0x0000_0000; PROVEN: Hi3518E V100 data sheet, PDF page 622, section 10.1.6).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_25[31:25];
        field {
            name = "int_isp";
            desc = "ISP interrupt indicator.
- 0: No interrupt is generated.
- 1: An interrupt is generated.";
            sw = r; hw = w;
            reset = 0x0;
        } int_isp[24:24];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_23_17[23:17];
        field {
            name = "int_pt0";
            desc = "Port 0 interrupt indicator.
- 0: No interrupt is generated.
- 1: An interrupt is generated.";
            sw = r; hw = w;
            reset = 0x0;
        } int_pt0[16:16];
        field {
            name = "reserved";
