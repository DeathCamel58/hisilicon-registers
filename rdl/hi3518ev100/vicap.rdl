            reset = 0x0;
        } mode[0:0];
    } PT_INTF_MOD @ 0x100;
    reg {
        name = "PT_OFFSET0";
        desc = "PT_OFFSET0 is component 0 offset register. PT_OFFSET0 (offset 0x0110, total reset 0xFFF0_0000; PROVEN: Hi3518E V100 data sheet, PDF page 625, section 10.1.6).";
        field {
            name = "mask";
            desc = "Component 0 mask.";
            sw = rw; hw = r;
            reset = 0xfff0;
        } mask_[31:16];
        field {
