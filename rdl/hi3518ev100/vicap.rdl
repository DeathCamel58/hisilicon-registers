- 0: not reversed
- 1: reversed";
            sw = rw; hw = r;
            reset = 0x0;
        } de_inv[2:2];
        field {
            name = "de_sel";
            desc = "de source select (level-0 processing for de).
- 00: input de
- 01: level-2 processing result of hsync
- 10: 1
- 11: 0";
            sw = rw; hw = r;
            reset = 0x1;
        } de_sel[1:0];
