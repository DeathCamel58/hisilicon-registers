`ifndef EHI3518EV100_ISP_RDL
`define EHI3518EV100_ISP_RDL
regfile eHI3518EV100_ISP {
    name = "Image signal processor (ISP)";
    desc = "Image signal processor (ISP). 164 registers extracted programmatically from the Hi3518E 720p IP Camera SoC data sheet (Issue 03, 2015-11-26); chapter 11.4, table 11-1. Field names, bit ranges, access types and reset values are taken from the register tables; reset values are the data sheet total reset values split onto the fields (per-field values where the table has them). Label: PROVEN. Hardware not verified here (no board).";
    reg {
        name = "ACTIVE_WIDTH";
        desc = "ACTIVE_WIDTH is a picture width register. ACTIVE_WIDTH (offset 0x0010, total reset 0x0000_0000; PROVEN: Hi3518E V100 data sheet, PDF page 754, section 11.4).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = rw; hw = r;
            reset = 0x0;
        } reserved_31_16[31:16];
        field {
            name = "ActiveWidth";
            desc = "Active video width (in pixel).";
            sw = rw; hw = r;
            reset = 0x0;
        } ActiveWidth[15:0];
    } ACTIVE_WIDTH @ 0x10;
    reg {
        name = "ACTIVE_HEIGHT";
        desc = "ACTIVE_HEIGHT is a picture height register. ACTIVE_HEIGHT (offset 0x0014, total reset 0x0000_0000; PROVEN: Hi3518E V100 data sheet, PDF page 754, section 11.4).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = rw; hw = r;
            reset = 0x0;
        } reserved_31_16[31:16];
        field {
            name = "ActiveHeight";
            desc = "Active video height (in line).";
            sw = rw; hw = r;
            reset = 0x0;
        } ActiveHeight[15:0];
    } ACTIVE_HEIGHT @ 0x14;
    reg {
        name = "RGGB_START";
        desc = "RGGB_START is an RGGB mode register. RGGB_START (offset 0x0018, total reset 0x0000_0000; PROVEN: Hi3518E V100 data sheet, PDF page 754, section 11.4).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = rw; hw = r;
            reset = 0x0;
        } reserved_31_2[31:2];
        field {
            name = "RGGBstart";
            desc = "Start color of the RGGB pattern.
- 00: R Gr Gb B
- 01: Gr R B Gb
- 10: Gb B R Gr
- 11: B Gb";
            sw = rw; hw = r;
            reset = 0x0;
        } RGGBstart[1:0];
    } RGGB_START @ 0x18;
    reg {
        name = "CONFIG_BUFFER_MODE";
        desc = "CONFIG_BUFFER_MODE is an update mode configuration register. CONFIG_BUFFER_MODE (offset 0x0030, total reset 0x0000_0000; PROVEN: Hi3518E V100 data sheet, PDF page 755, section 11.4).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = rw; hw = r;
            reset = 0x0;
        } reserved_31_2[31:2];
        field {
            name = "ConfigBufferMode";
            desc = "Double-buffer mode select.
- 00: disabled (configuration are updated immediately)
- 01: blocked (configuration are not updated)
- 10: local (module configurations are updated during local vertical blanking)
- 11: global (all module configurations are updated during ISP vertical blanking)";
            sw = rw; hw = r;
            reset = 0x0;
        } ConfigBufferMode[1:0];
    } CONFIG_BUFFER_MODE @ 0x30;
    reg {
        name = "BYPASS";
        desc = "BYPASS is a bypass register. BYPASS (offset 0x0040, total reset 0x0000_0000; PROVEN: Hi3518E V100 data sheet, PDF page 756, section 11.4).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = rw; hw = r;
            reset = 0x0;
        } reserved_31_27[31:27];
        field {
            name = "ISPfullbypassenable";
            desc = "Output is connected directly to input.";
            sw = rw; hw = r;
            reset = 0x0;
        } ISPfullbypassenable[26:26];
        field {
            name = "ISPprocessingbypassmode";
            desc = "- 00: full processing
- 01: bypass entire ISP processing (video input and output ports are still connected) and output raw sensor data
- 10: bypass entire ISP processing (video input and output ports are still connected) and output raw sensor data in most significant bits of channels 1 and 2
- 11: connect output to ground";
            sw = rw; hw = r;
            reset = 0x0;
        } ISPprocessingbypassmode[25:24];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = rw; hw = r;
            reset = 0x0;
        } reserved_23_19[23:19];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = rw; hw = r;
            reset = 0x0;
        } reserved_18_18[18:18];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = rw; hw = r;
            reset = 0x0;
        } reserved_17_15[17:15];
        field {
            name = "Bypassgamma";
            desc = "Bypass gamma table.";
            sw = rw; hw = r;
            reset = 0x0;
        } Bypassgamma[14:14];
        field {
            name = "Bypasscolor";
            desc = "Bypass color matrix.";
            sw = rw; hw = r;
            reset = 0x0;
        } Bypasscolor[13:13];
        field {
            name = "Bypassdemosaic";
            desc = "Bypass demosaic module (output raw data).";
            sw = rw; hw = r;
            reset = 0x0;
        } Bypassdemosaic[12:12];
        field {
            name = "BypassDRC";
            desc = "Bypass DRC.";
            sw = rw; hw = r;
            reset = 0x0;
        } BypassDRC[11:11];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = rw; hw = r;
            reset = 0x0;
        } reserved_10_10[10:10];
        field {
            name = "Bypassradial";
            desc = "Bypass shading.";
            sw = rw; hw = r;
            reset = 0x0;
        } Bypassradial[9:9];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = rw; hw = r;
            reset = 0x0;
        } reserved_8_7[8:7];
        field {
            name = "Bypassgain";
            desc = "Bypass black level/gain.";
            sw = rw; hw = r;
            reset = 0x0;
        } Bypassgain[6:6];
        field {
            name = "Bypassdenoise";
            desc = "Bypass denoise.";
            sw = rw; hw = r;
            reset = 0x0;
        } Bypassdenoise[5:5];
        field {
            name = "Bypassdefectpixel";
            desc = "Bypass defect pixel.";
            sw = rw; hw = r;
            reset = 0x0;
        } Bypassdefectpixel[4:4];
        field {
            name = "Bypassgreenequalize";
            desc = "Bypass green equalization.";
            sw = rw; hw = r;
            reset = 0x0;
        } Bypassgreenequalize[3:3];
        field {
            name = "Bypassgammafe";
            desc = "Bypass WDR compression front-end lookup.";
            sw = rw; hw = r;
            reset = 0x0;
        } Bypassgammafe[2:2];
        field {
            name = "Bypassbalancefe";
            desc = "Bypass front-end black level adjustment.";
            sw = rw; hw = r;
            reset = 0x0;
        } Bypassbalancefe[1:1];
        field {
            name = "Bypassvideotestgen";
            desc = "Bypass video test generator.";
            sw = rw; hw = r;
            reset = 0x0;
        } Bypassvideotestgen[0:0];
    } BYPASS @ 0x40;
    reg {
        name = "AE_SWITCH";
        desc = "AE_SWITCH is an AE region statistics position control register. AE_SWITCH (offset 0x0044, total reset 0x0000_0000; PROVEN: Hi3518E V100 data sheet, PDF page 757, section 11.4).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = rw; hw = r;
            reset = 0x0;
        } reserved_31_2[31:2];
        field {
            name = "AEswitch";
            desc = "AE tap in the pipeline.
- 00: after static WB
- 01: immediately from sensor (for WDR compression modes)
- 10: after shading
- 11: after front-end LUT (for WDR compression modes)";
            sw = rw; hw = r;
            reset = 0x0;
        } AEswitch[1:0];
    } AE_SWITCH @ 0x44;
    reg {
        name = "AWB_SWITCH";
        desc = "AWB_SWITCH is an AWB statistics position control register. AWB_SWITCH (offset 0x0048, total reset 0x0000_0000; PROVEN: Hi3518E V100 data sheet, PDF page 758, section 11.4).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = rw; hw = r;
            reset = 0x0;
        } reserved_31_1[31:1];
        field {
            name = "AWBswitch";
            desc = "AWB tap in the pipeline.
- 0: immediately before color matrix
- 1: immediately after color matrix (for sensors with strong color channel crosstalk)";
            sw = rw; hw = r;
            reset = 0x0;
        } AWBswitch[0:0];
    } AWB_SWITCH @ 0x48;
    reg {
        name = "AF_SWITCH";
        desc = "AF_SWITCH is an AF statistics position control register. AF_SWITCH (offset 0x004C, total reset 0x0000_0000; PROVEN: Hi3518E V100 data sheet, PDF page 759, section 11.4).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = rw; hw = r;
            reset = 0x0;
        } reserved_31_1[31:1];
        field {
            name = "AFswitch";
            desc = "AF tap in the pipeline.
- 0: enabled
- 1: disabled";
            sw = rw; hw = r;
            reset = 0x0;
        } AFswitch[0:0];
    } AF_SWITCH @ 0x4c;
    reg {
        name = "DIS_SWITCH";
        desc = "DIS_SWITCH is a DIS statistics position control register. DIS_SWITCH (offset 0x0050, total reset 0x0000_0000; PROVEN: Hi3518E V100 data sheet, PDF page 759, section 11.4).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = rw; hw = r;
            reset = 0x0;
        } reserved_31_2[31:2];
        field {
            name = "DISswitch";
            desc = "DIS tap in the pipeline.
- 00: end of pipeline
- 01: after DRC
- 10: after defect pixel
- 11: switched off";
            sw = rw; hw = r;
            reset = 0x0;
        } DISswitch[1:0];
    } DIS_SWITCH @ 0x50;
    reg {
        name = "HISTOGRAM_SWITCH";
        desc = "HISTOGRAM_SWITCH is an AE global statistics position control register. HISTOGRAM_SWITCH (offset 0x0054, total reset 0x0000_0000; PROVEN: Hi3518E V100 data sheet, PDF page 760, section 11.4).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = rw; hw = r;
            reset = 0x0;
        } reserved_31_2[31:2];
        field {
            name = "Histogramswitch";
            desc = "AE tap in the pipeline.
- 00: same as AE
- 01: immediately from sensor (for WDR compression modes)
- 10: after shading
- 11: after front-end LUT (for WDR compression modes)";
            sw = rw; hw = r;
            reset = 0x0;
        } Histogramswitch[1:0];
    } HISTOGRAM_SWITCH @ 0x54;
