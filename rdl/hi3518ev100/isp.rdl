        desc = "INPUTPORT_CTRL is an input port control register. INPUTPORT_CTRL (offset 0x0130, total reset 0x0000_0000; PROVEN: Hi3518E V100 data sheet, PDF page 763, section 11.4).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = rw; hw = r;
            reset = 0x0;
