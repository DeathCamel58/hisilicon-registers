// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3518ev100-power" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3518E V100: operating modes</B><BR/><FONT POINT-SIZE="11">data sheet 3.10 and Table 3-5 (v100: normal / standby; Hi3518E V20X: Table 3-5 normal / slow); no power-domain switching described</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  n [label="Normal mode\nARM subsystem clocks from the PLL", fillcolor="#a6c98f"  ];
  s [label="Slow (standby) mode\nARM subsystem clocks from the 24 MHz crystal,\nAPLL off", fillcolor="#7fcdc4"  ];
  lp [label="Clock gating, module low power,\nDDR self-refresh (DDRC_SREFCTRL)", fillcolor="#d6d27a"  ];
  n -> s [label="SC_CTRL mode request"];
  s -> n [label="PLL locked (PERI_CRG58)"];
  lp -> n;
}
