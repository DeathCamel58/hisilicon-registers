// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3518ev100-clocks" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3518E V100: clock tree</B><BR/><FONT POINT-SIZE="11">data sheet 3.2 (Table 3-3 default frequencies); register names from the CRG description; second POSTDIV row INFERRED as BPLL</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  xin [label="XIN crystal 24 MHz", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  viu [label="VIU_CLK, MII_RXCK / MII_TXCK\n(external clocks)", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  rtc [label="RTC_XIN 32 kHz", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  apll [label="APLL (PERI_CRG0/1)\nFOUTPOSTDIV 440 MHz", fillcolor="#e6a0a0"  ];
  bpll [label="BPLL (PERI_CRG4/5)\n440 MHz (INFERRED)", fillcolor="#e6a0a0"  ];
  vpll [label="VPLL0 (PERI_CRG2/3)\nVCO 1188 MHz, FOUT2 74.25 MHz", fillcolor="#e6a0a0"  ];
  epll [label="EPLL (PERI_CRG8/9)\nVCO 1350 MHz", fillcolor="#e6a0a0"  ];
  a9 [label="ARM9 clock (PERI_CRG10:\nfrequency mode, soft reset)", fillcolor="#e0b86f"  ];
  ddr [label="DDR clock 440 MHz\nAXI = DDR/2, APB = DDR/4", fillcolor="#e0b86f"  ];
  v198 [label="198 MHz: VPSS, TDE\n99 MHz: MDU, NFC, CIPHER", fillcolor="#a6c98f"  ];
  vdp [label="74.25 MHz VDP HD", fillcolor="#a6c98f"  ];
  e225 [label="225 MHz: VEDU, JPGE, VAPU\n112.5 MHz SFC, 675 MHz SIO MCLK\n54 MHz VDP SD, 27 MHz sensor", fillcolor="#a6c98f"  ];
  gate [label="Clock gating + soft reset\nPERI_CRG11 ... PERI_CRG58", fillcolor="#9aa7e6"  ];
  ip [label="IP clocks", fillcolor="#8fb3de"  ];
  tim [label="Timers: SC_CTRL timeren0ov..3ov\nreference clock / bus clock", fillcolor="#d6d27a"  ];
  xin -> apll;
  xin -> bpll;
  xin -> vpll;
  xin -> epll;
  apll -> a9;
  bpll -> ddr;
  vpll -> v198;
  vpll -> vdp;
  epll -> e225;
  a9 -> gate;
  ddr -> gate;
  v198 -> gate;
  vdp -> gate;
  e225 -> gate;
  viu -> gate;
  gate -> ip;
  ddr -> tim [label="bus clock"];
  rtc -> ip [label="RTC"];
}
