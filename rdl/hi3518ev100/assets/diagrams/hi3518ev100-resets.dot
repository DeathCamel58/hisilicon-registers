// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3518ev100-resets" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3518E V100: reset sources</B><BR/><FONT POINT-SIZE="11">data sheet 3.1 (reset control figure and Table 3-1)</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  rstn [label="RSTN pin", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  por [label="internal POR\n(POR_SEL selects pin or POR)", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  npor [label="npor: global hard reset", fillcolor="#d6d27a"   shape=diamond];
  sysc [label="SYS_CTRL global soft reset\nsys_rst_req", fillcolor="#e0b86f"  ];
  sys [label="sys_rst_n: global soft reset\nexcludes CRG and test circuits;\nreleased after >= 360 system clocks", fillcolor="#8fb3de"  ];
  crg [label="CRG: xx_srst_req per module\n(write 1 = reset, write 0 = release)", fillcolor="#9aa7e6"  ];
  mod [label="xx_rst_n: module resets", fillcolor="#a6c98f"  ];
  rstn -> npor;
  por -> npor;
  sysc -> sys;
  npor -> sys;
  crg -> mod;
  sys -> mod;
  npor -> mod;
}
