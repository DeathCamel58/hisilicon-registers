// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3518ev100-dma" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3518E V100: DMA request lines</B><BR/><FONT POINT-SIZE="11">data sheet Table 3-24 (3-23 on the Hi3518E V100), DMAC at 0x100D0000</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  dmac [label="DMAC\nchannels 0-3 (0 = highest priority)\nsource / destination request\nselected per channel by software", fillcolor="#e0b86f"  ];
  mem [label="memory (always-ready request)", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  bus [label="AHB / AXI master", fillcolor="#9a9a9a"  ];
  p0 [label="SIO receive (RX)\nreq 0 SIO receive (RX)", fillcolor="#8fb3de"  ];
  p1 [label="SIO transmit (TX)\nreq 1 SIO transmit (TX)", fillcolor="#8fb3de"  ];
  p2 [label="UART0\nreq 6 RX, 7 TX", fillcolor="#8fb3de"  ];
  p3 [label="UART1\nreq 8 RX, 9 TX", fillcolor="#8fb3de"  ];
  p4 [label="UART2\nreq 10 RX, 11 TX", fillcolor="#8fb3de"  ];
  p5 [label="SSP1\nreq 12 RX, 13 TX", fillcolor="#8fb3de"  ];
  p6 [label="SSP0\nreq 14 RX, 15 TX", fillcolor="#8fb3de"  ];
  dmac -> bus;
  mem -> dmac;
  p0 -> dmac;
  p1 -> dmac;
  p2 -> dmac;
  p3 -> dmac;
  p4 -> dmac;
  p5 -> dmac;
  p6 -> dmac;
}
