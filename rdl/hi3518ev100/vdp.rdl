        } vbk_cr[7:0];
    } VSD1BK @ 0x4070;
    reg {
        name = "VSD1CSCIDC";
        desc = "VSD1CSCIDC is a VSD input DC component register for CSC (instant register). VSD1CSCIDC (offset 0x4080, total reset 0x0000_0000; PROVEN: Hi3518E V100 data sheet, PDF page 703, section 10.2.5).";
        field {
