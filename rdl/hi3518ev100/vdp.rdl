            sw = rw; hw = r;
            reset = 0x0;
        } disp_xlpos[11:0];
    } VSD1DLPOS @ 0x4064;
    reg {
        name = "VSD1BK";
        desc = "VSD1BK is a video layer background color register. VSD1BK (offset 0x4070, total reset 0x0000_0000; PROVEN: Hi3518E V100 data sheet, PDF page 703, section 10.2.5).";
        field {
            name = "vbk_alpha";
            desc = "Levels 0–128 of the background filling color of the video layer.";
            sw = rw; hw = r;
            reset = 0x0;
        } vbk_alpha[31:24];
        field {
            name = "vbk_y";
            desc = "Y component.";
            sw = rw; hw = r;
