`ifndef EHI3518EV100_VDP_RDL
`define EHI3518EV100_VDP_RDL
regfile eHI3518EV100_VDP {
    name = "Video display processor (VDP, VOU)";
    desc = "Video display processor (VDP, VOU). 68 registers extracted programmatically from the Hi3518E 720p IP Camera SoC data sheet (Issue 03, 2015-11-26); chapters 10.2.5, table 10-8. Field names, bit ranges, access types and reset values are taken from the register tables; reset values are the data sheet total reset values split onto the fields (per-field values where the table has them). Label: PROVEN. Hardware not verified here (no board).";
    reg {
        name = "VSD1VFPOS";
        desc = "VSD1VFPOS is a VSD surface content start position (in the display window) register (non- instant register). The start position is in the unit of pixel. VSD1VFPOS (offset 0x3068, total reset 0x0000_0000; PROVEN: Hi3518E V100 data sheet, PDF page 702, section 10.2.5).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_24[31:24];
        field {
            name = "video_yfpos";
            desc = "Start coordinate of the video column. The frame height is referenced and the unit is line.";
            sw = rw; hw = r;
            reset = 0x0;
        } video_yfpos[23:12];
        field {
            name = "video_xfpos";
            desc = "Start coordinate of the video row.";
            sw = rw; hw = r;
            reset = 0x0;
        } video_xfpos[11:0];
    } VSD1VFPOS @ 0x3068;
    reg {
        name = "VSD1VLPOS";
        desc = "VSD1VLPOS is a VSD surface content end position (in the display window) register (non- instant register). The end position is in the unit of pixel. VSD1VLPOS (offset 0x306C, total reset 0x0000_0000; PROVEN: Hi3518E V100 data sheet, PDF page 702, section 10.2.5).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_24[31:24];
        field {
            name = "video_ylpos";
            desc = "End coordinate of the video column. The frame height is referenced and the unit is line.";
            sw = rw; hw = r;
            reset = 0x0;
        } video_ylpos[23:12];
        field {
            name = "video_xlpos";
            desc = "End coordinate of the video row.";
            sw = rw; hw = r;
            reset = 0x0;
        } video_xlpos[11:0];
    } VSD1VLPOS @ 0x306c;
    reg {
        name = "VSD1CTRL";
        desc = "VSD1CTRL is a VSD control register (non-instant register). It is used to configure the layer information VSD1CTRL (offset 0x4000, total reset 0x0000_0000; PROVEN: Hi3518E V100 data sheet, PDF page 697, section 10.2.5).";
        field {
            name = "surface_en";
            desc = "Surface enable (non-instant register).
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } surface_en[31:31];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_30_20[30:20];
        field {
            name = "ifir_mode";
            desc = "Horizontal chrominance IFIR mode.
- 00: reserved
- 01: chrominance IFIR copy mode
- 10: bilinear interpolation
- 11: 6-tap FIR";
            sw = rw; hw = r;
            reset = 0x0;
        } ifir_mode[19:18];
        field {
            name = "vup_mode";
            desc = "Register update mode.
- 0: update by field
- 1: update by frame";
            sw = r; hw = na;
            reset = 0x0;
        } vup_mode[17:17];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_16_4[16:4];
        field {
            name = "ifmt";
            desc = "Input data format.
- 0x3: SPYCbCr420
- 0x4: SPYCbCr422

Other values: reserved";
            sw = rw; hw = r;
            reset = 0x0;
        } ifmt[3:0];
    } VSD1CTRL @ 0x4000;
    reg {
        name = "VSD1UPD";
        desc = "VSD1UPD is a VSD channel update enable register. VSD1UPD (offset 0x4004, total reset 0x0000_0000; PROVEN: Hi3518E V100 data sheet, PDF page 698, section 10.2.5).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_1[31:1];
        field {
            name = "regup";
            desc = "Surface register update. After the registers at this layer are configured, the registers are updated when the value 1 is written to this bit. After updates, this bit is cleared automatically by the hardware.";
            sw = rw; hw = r;
            reset = 0x0;
        } regup[0:0];
    } VSD1UPD @ 0x4004;
    reg {
        name = "VSD1CADDR";
        desc = "VSD1CADDR is a VSD current frame address register. In package pixel format, the address is the address of the frame buffer; in semi-planar pixel format, the address is the address of the luminance frame buffer. VSD1CADDR (offset 0x4010, total reset 0x0000_0000; PROVEN: Hi3518E V100 data sheet, PDF page 698, section 10.2.5).";
        field {
            name = "surface_caddr";
            desc = "Address of the current frame.";
            sw = rw; hw = r;
            reset = 0x0;
        } surface_caddr[31:0];
    } VSD1CADDR @ 0x4010;
    reg {
        name = "VSD1CCADDR";
        desc = "VSD1CCADDR is a VSD current frame chrominance address register. In package pixel format, the address is invalid; in semi-planar pixel format, the address is the address of the luminance frame buffer. VSD1CCADDR (offset 0x4014, total reset 0x0000_0000; PROVEN: Hi3518E V100 data sheet, PDF page 699, section 10.2.5).";
        field {
            name = "surface_ccaddr";
            desc = "Chrominance address of the current frame.";
            sw = rw; hw = r;
            reset = 0x0;
        } surface_ccaddr[31:0];
    } VSD1CCADDR @ 0x4014;
    reg {
        name = "VSD1STRIDE";
        desc = "VSD1STRIDE is a VSD surface stride register. VSD1STRIDE (offset 0x4024, total reset 0x0000_0000; PROVEN: Hi3518E V100 data sheet, PDF page 699, section 10.2.5).";
        field {
            name = "surface_cstride";
            desc = "Stride of the chrominance frame buffer (valid in semi-planar format), 128-bit alignment.";
            sw = rw; hw = r;
            reset = 0x0;
        } surface_cstride[31:16];
        field {
