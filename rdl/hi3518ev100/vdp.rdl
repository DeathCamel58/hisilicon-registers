        desc = "VSD1CSCP0 is VSD CSC parameter 0 register (instant register). VSD1CSCP0 (offset 0x4088, total reset 0x0000_0000; PROVEN: Hi3518E V100 data sheet, PDF page 704, section 10.2.5).";
