            sw = rw; hw = r;
            reset = 0x0;
        } surface_stride[15:0];
    } VSD1STRIDE @ 0x4024;
    reg {
        name = "VSD1IRESO";
        desc = "VSD1IRESO is a VSD input resolution register (non-instant register). VSD1IRESO (offset 0x4028, total reset 0x0000_0000; PROVEN: Hi3518E V100 data sheet, PDF page 700, section 10.2.5).";
        field {
