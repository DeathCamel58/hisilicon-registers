            desc = "DC parameter of output component 2. The MSB is the signed bit. The value is expressed as the complementary code.";
            sw = rw; hw = r;
            reset = 0x0;
        } cscodc2[26:18];
        field {
            name = "cscodc1";
            desc = "DC parameter of output component 1. The MSB is the signed bit. The value is expressed as the complementary code.";
            sw = rw; hw = r;
            reset = 0x0;
        } cscodc1[17:9];
        field {
            name = "cscodc0";
            desc = "DC parameter of output component 0. The MSB is the signed bit. The value is expressed as the complementary code.";
            sw = rw; hw = r;
            reset = 0x0;
        } cscodc0[8:0];
