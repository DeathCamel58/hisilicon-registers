            sw = rw; hw = r;
            reset = 0x0;
        } iw[11:0];
    } VSD1IRESO @ 0x4028;
    reg {
        name = "VSD1CBMPARA";
        desc = "VSD1CBMPARA is a VSD overlay parameter register (non-instant register). VSD1CBMPARA (offset 0x4034, total reset 0x0000_0000; PROVEN: Hi3518E V100 data sheet, PDF page 700, section 10.2.5).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = rw; hw = r;
            reset = 0x0;
        } reserved_31_8[31:8];
        field {
            name = "galpha";
            desc = "Overlay global alpha value. The value ranges from 0 to 128. The value 128 indicates opaque, and the value 0 indicates full transparent.";
            sw = rw; hw = r;
            reset = 0x0;
        } galpha[7:0];
    } VSD1CBMPARA @ 0x4034;
    reg {
        name = "VSD1DFPOS";
        desc = "VSD1DFPOS is a VSD surface start position (in the display window) register (non-instant register). VSD1DFPOS (offset 0x4060, total reset 0x0000_0000; PROVEN: Hi3518E V100 data sheet, PDF page 701, section 10.2.5).";
        field {
