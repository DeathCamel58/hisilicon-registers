            sw = rw; hw = r;
            reset = 0x0;
        } disp_yfpos[23:12];
        field {
            name = "disp_xfpos";
            desc = "Start coordinate of the display row.";
            sw = rw; hw = r;
            reset = 0x0;
        } disp_xfpos[11:0];
    } VSD1DFPOS @ 0x4060;
    reg {
        name = "VSD1DLPOS";
        desc = "VSD1DLPOS is a VSD surface end position (in the display window) register (non-instant register). The end position is in the unit of pixel. VSD1DLPOS (offset 0x4064, total reset 0x0000_0000; PROVEN: Hi3518E V100 data sheet, PDF page 701, section 10.2.5).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = na;
