- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } csc_en[27:27];
        field {
            name = "cscidc2";
            desc = "DC parameter of input component 2. The MSB is the signed bit. The value is expressed as the complementary code.";
            sw = rw; hw = r;
            reset = 0x0;
        } cscidc2[26:18];
        field {
            name = "cscidc1";
            desc = "DC parameter of input component 1. The MSB is the signed bit. The value is expressed as the complementary code.";
            sw = rw; hw = r;
            reset = 0x0;
        } cscidc1[17:9];
        field {
