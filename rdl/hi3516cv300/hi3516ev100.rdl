addrmap hi3516ev100 {
    name = "hi3516ev100 registers";
    desc = "
        ## Datasheets

        * [Full Datasheet Hi3516CV300 and Hi3516EV100](assets/Hi3516CV300-Hi3516EV100-Datasheet.pdf)

        ## Diagrams

        ![Application Block Diagram](assets/Hi3516EV100-Application-Block-Diagram.png)
        ![Logic Block Diagram](assets/Hi3516EV100-Logic-Block-Diagram.png)
    ";

    eHISI_FMC           FMC             @ 0x10000000;
    eHISI_DMAC          DMAC            @ 0x10030000;
    eARM_PL190          VIC             @ 0x10040000;
    eHISI_FEMAC         ETH             @ 0x10050000;
    eHISI_CIPHER_MC     CIPHER          @ 0x10080000;
    eHISI_HASH          HASH            @ 0x10090000;
    eHISI_DWMMC         MMC0            @ 0x100C0000;
    eHISI_DWMMC         MMC1            @ 0x100D0000;
    eHISI_DWMMC         MMC2            @ 0x100E0000;
    eHISI_DWMMC         MMC3            @ 0x100F0000;
    eHISI_USB_OHCI      OHCI            @ 0x10110000;
    eHISI_USB_EHCI      EHCI            @ 0x10120000;
    eHISI_USB_DEVICE    USB_DEV         @ 0x10130000;
    eHISI_DDRT          DDRT            @ 0x11200000;
    eHISI_JPGE          JPGE            @ 0x11220000;
    eHISI_IVE           IVE             @ 0x11230000;
    aHISI_VPSS          VPSS            @ 0x11250000;
    aHISI_VEDU_V2       VEDU            @ 0x11260000;
    aHISI_VGS           VGS             @ 0x11240000;
    eHISI_MIPI_RX_CV300 MIPI            @ 0x11300000;
    eHISI_AIAO          AIAO            @ 0x11310000;
    eHISI_ISP_CV300     ISP             @ 0x11390000;
    eCRG                CRG             @ 0x12010000;
    eMISC_CTRL          MISC_CTRL       @ 0x12030000;
    eHISI_MDDRC         MDDRC           @ 0x12060000;
    eHISI_OTP_KEY_CTRL  OTP_KEY_CTRL    @ 0x12070800;
    eHISI_RTC_SPI       RTC             @ 0x12090000;
    eHISI_RSA           RSA             @ 0x120B0000;
    eHISI_TRNG          TRNG            @ 0x120C0000;
    eHISI_LSADC_V2      LSADC           @ 0x120E0000;
    eHISI_IR            IR              @ 0x120F0000;
    eHISI_I2C_V2        I2C0            @ 0x12110000;
    eHISI_I2C_V2        I2C1            @ 0x12112000;
    eARM_PL011          UART0           @ 0x12100000;
    eARM_PL011          UART1           @ 0x12101000;
    eARM_PL011          UART2           @ 0x12102000;
    eHISI_SPI           SPI0            @ 0x12120000;
    eHISI_SPI           SPI1            @ 0x12121000;
    eHISI_SPI_3WIRE     SPI_3WIRE       @ 0x12122000;
    eHISI_PWM_GRP       PWM             @ 0x12130000;
    eARM_PL061          GPIO0           @ 0x12140000;
    eARM_PL061          GPIO1           @ 0x12141000;
    eARM_PL061          GPIO2           @ 0x12142000;
    eARM_PL061          GPIO3           @ 0x12143000;
    eARM_PL061          GPIO4           @ 0x12144000;
    eARM_PL061          GPIO5           @ 0x12145000;
    eARM_PL061          GPIO6           @ 0x12146000;
    eARM_PL061          GPIO7           @ 0x12147000;
    eARM_PL061          GPIO8           @ 0x12148000;
    eHISI_TIMER_SP804   TIMER0          @ 0x12000000;
    eHISI_TIMER_SP804   TIMER1          @ 0x12000020;
    eHISI_TIMER_SP804   TIMER2          @ 0x12001000;
    eHISI_TIMER_SP804   TIMER3          @ 0x12001020;
    eHISI_WDG_SP805     WDG             @ 0x12080000;
    eSYS_CTRL           SYS_CTRL        @ 0x12020000;
};

