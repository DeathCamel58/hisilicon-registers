        enum MISC_CTRL40_tsensor_temp_calib_enum {
            ENABLED = 0 { name = "Enabled"; desc = "calibration algorithm enabled"; };
            DISABLED = 1 { name = "Disabled"; desc = "calibration algorithm disabled"; };
