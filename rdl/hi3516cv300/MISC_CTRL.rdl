    reg {
        name = "T-sensor status register";
        desc = "MISC_CTRL40 is a T-sensor status register.

Temperature sensor status/config. Names of fields [3:2], [1], [0] are wrapped in the data sheet text; repaired here. Fields [5:4] and [3:2] are RW although the register is titled `status register`; the alarms [1:0] are RO.

Data sheet 3.5.5.2 MISC_CTRL40 (offset 0xA0, printed page 3-95, `hi3516cv300--Hi3516CV300-Hi3516EV100-Datasheet.txt` line 10200).";

        enum MISC_CTRL40_tsensor_vcalib1_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "tsensor_vcalib1_en";
            desc = "TSensor VCALIB1 enable";
            sw = rw;
            hw = r;
