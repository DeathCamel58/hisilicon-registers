            desc = "Timeout count enable of the SYS AXI bus port M1 (CPU)";
            sw = rw;
            hw = r;
            encode = MISC_CTRL5_sysaxi_m1_timeout_en_enum;
            reset = 0x0;
        } sysaxi_m1_timeout_en[15:15];

        field {
            name = "sysaxi_m1_timeout_value";
            desc = "Timeout count of the SYS AXI bus port M1 (CPU) Count value = sysaxi_timeout_value_m1 x 2";
            sw = rw;
            hw = r;
            reset = 0x0;
        } sysaxi_m1_timeout_value[14:0];
    } MISC_CTRL5 @ 0x14;

