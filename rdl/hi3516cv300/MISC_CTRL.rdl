            CT_0P512MS = 0 { name = "Ct 0P512Ms"; desc = "0.512 ms"; };
            CT_1P024MS = 1 { name = "Ct 1P024Ms"; desc = "1.024 ms"; };
            CT_0P256MS = 2 { name = "Ct 0P256Ms"; desc = "0.256 ms"; };
            CT_2P048MS = 3 { name = "Ct 2P048Ms"; desc = "2.048 ms"; };
        };

        field {
            name = "tsensor_temp_ct_sel";
            desc = "Time select for converting a temperature code value of the TSensor";
            sw = rw;
            hw = r;
            encode = MISC_CTRL40_tsensor_temp_ct_sel_enum;
            reset = 0x0;
        } tsensor_temp_ct_sel[3:2];

        field {
            name = "tsensor_low_warning";
            desc = "Temperature underflow alarm, active high";
            sw = r;
            hw = w;
            reset = 0x0;
        } tsensor_low_warning[1:1];

        field {
            name = "tsensor_up_warning";
            desc = "Temperature overflow alarm, active high";
            sw = r;
            hw = w;
            reset = 0x0;
        } tsensor_up_warning[0:0];
    } MISC_CTRL40 @ 0xA0;

