            reset = 0x1;
        } ir_ret1n[2:2];

        enum MISC_CTRL3_cipher_ret1n_enum {
            RETENTION = 0 { name = "Retention"; desc = "RAM in retention state"; };
            ACTIVE = 1 { name = "Active"; desc = "RAM active"; };
        };

        field {
            name = "cipher_ret1n";
            desc = "RAM retention control of the cipher";
            sw = rw;
            hw = r;
            encode = MISC_CTRL3_cipher_ret1n_enum;
            reset = 0x1;
        } cipher_ret1n[1:1];
    } MISC_CTRL3 @ 0xC;

    reg {
        name = "SYS bus control register 0";
        desc = "MISC_CTRL5 is an SYS bus control register 0.

SYS AXI bus timeout counters (ports M1 = CPU and M2 = AHB master 0). The bus control registers MISC_CTRL5..MISC_CTRL16 hold, per bus (SYS, media, VIVO), the timeout enable/count of each master port and the priority of each master/slave port (3 = highest).

Data sheet 3.5.5.2 MISC_CTRL5 (offset 0x14, printed page 3-69, `hi3516cv300--Hi3516CV300-Hi3516EV100-Datasheet.txt` line 8780).";

        enum MISC_CTRL5_sysaxi_m2_timeout_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "sysaxi_m2_timeout_en";
            desc = "Timeout count enable of the SYS AXI bus port M2 (AHB master 0)";
            sw = rw;
            hw = r;
            encode = MISC_CTRL5_sysaxi_m2_timeout_en_enum;
            reset = 0x0;
        } sysaxi_m2_timeout_en[31:31];

        field {
            name = "sysaxi_m2_timeout_value";
            desc = "Timeout count of the SYS AXI bus port M2 (AHB master 0) Count value = sysaxi_timeout_value_m2 x 2";
            sw = rw;
            hw = r;
            reset = 0x0;
        } sysaxi_m2_timeout_value[30:16];

