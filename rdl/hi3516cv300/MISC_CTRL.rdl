`ifndef HI3516CV300_MISC_CTRL_RDL
`define HI3516CV300_MISC_CTRL_RDL

regfile eMISC_CTRL {
    name = "Miscellaneous control (MISC_CTRL), Hi3516C V300 / Hi3516E V100";
    desc = "    MISC_CTRLn miscellaneous control registers at 0x12030000 (offset = n x 4; only the 37 registers listed in the data sheet exist: MISC_CTRL0, 3, 5..10, 12..14, 16..25, 30..44, 47). Data sheet: Hi3516C V300/Hi3516E V100 Professional HD IP Camera SoC, Issue 05 (2018-05-10), chapter 3.5.5 (printed pages 3-63..3-97); shared by the Hi3516C V300 and Hi3516E V100 (no chip-specific marks in this block). Contents: function select (MISC_CTRL0: GZIP/DDRT, MIPI PHY mode, SPI chip select polarity/select, VICAP/VPSS online mode, test clock select), RAM retention control (MISC_CTRL3), AXI bus timeout/priority for the SYS, media and VIVO buses (MISC_CTRL5..16), DDR QoS/timeout group assignment (MISC_CTRL17..22), USB 2.0 controller and PHY control (MISC_CTRL23..25), SVB PWM (MISC_CTRL30), core and media HPM monitors (MISC_CTRL31..38), the temperature sensor (MISC_CTRL39..44) and the update-mode clear (MISC_CTRL47).

    Bring-up notes. USB: the vendor U-Boot hiusb-3516cv300.c reads PERI_USB = MISC_CTRL23 (0x5C) and writes WORDINTERFACE/burst bits (these are already the reset values 0x000313A0 except WORDINTERFACE), sets MISC_CTRL24 (0x60) bit 16 `usb_phy_reg_access` before programming the PHY (registers at 0x120D0000) while releasing the reset in PERI_CRG46. SPI1 chip select: MISC_CTRL0 bit 4. GZIP: MISC_CTRL0 bit 19 selects GZIP (1) instead of DDRT (0). No clock or PLL registers live here.

    Relation to the Hi3518EV200/Hi3516CV200 block (common/HISI_MISC_CTRL.rdl, MISC at 0x20120000): the register names and some offsets coincide, but the contents differ (different register set, USB glue in MISC_CTRL23..25 instead of MISC_CTRL30, no ACODEC/eMMC DLL registers here, HPM/T-sensor/SVB registers added), so the common block cannot be reused; all 37 registers are described from this data sheet.

    Sources: the same data sheet dump as the CRG (`hi3516cv300--Hi3516CV300-Hi3516EV100-Datasheet.txt`); the older Issue 00B03 draft (2016-09-28) was used as cross-check (all registers present, all matched Total Reset Values identical; its dump is watermark-noisy). Data sheet quirks: `MSIC` typo in MISC_CTRL0; the registers MISC_CTRL1, 2, 4, 11, 15, 26..29, 45, 46 do not exist; MISC_CTRL12 and MISC_CTRL16 are titled `... bus control register 3` although the previous numbered registers (11/15) are absent; field names of MISC_CTRL39/40 are wrapped across lines in the text (repaired); MISC_CTRL17 gzip_qosmap says `IVE/GZIP`. All 37 registers (names, offsets, fields, resets) were checked against the data sheet on 2026-11-09.
    ";

    reg {
        name = "MSIC function select register 0";
        desc = "MISC_CTRL0 is MSIC function select register 0.

Miscellaneous function select (the data sheet calls it `MSIC function select register 0`, a typo). Reset 0x00200000: vgs_bootram_mode = 1 (the VGS RAM is used as boot RAM). The vendor U-Boot (lib/hw_dec) sets gzip_ddrt_sel (bit 19) to 1 to use the hardware GZIP decompressor, and the vendor Linux DT maps this register (0x12030000, 4 bytes) into the SPI1 node for the SPI1 chip-select select ssp1_cs_sel (bit 4). The Hi3516C V300/E V100 data sheet lists the CPU COMMTX/COMMRX interrupt enable (bit 14) and the MIPI PHY mode (bits 6:5, MIPI/LVDS/CMOS).

Data sheet 3.5.5.2 MISC_CTRL0 (offset 0x0, printed page 3-65, `hi3516cv300--Hi3516CV300-Hi3516EV100-Datasheet.txt` line 8583).";

        enum MISC_CTRL0_vgs_bootram_mode_enum {
            VGS_FUNCTION = 0 { name = "Vgs Function"; desc = "disabled: the RAM serves the VGS function"; };
            BOOT_RAM = 1 { name = "Boot Ram"; desc = "enabled: the VGS RAM is multiplexed as boot RAM (reset default)"; };
        };

        field {
            name = "vgs_bootram_mode";
            desc = "Enable of multiplexing the RAM of the VGS module as the boot RAM. This bit is set to 1 when the boot RAM is required, and it is set to 0 when the VGS function is used.";
            sw = rw;
            hw = r;
            encode = MISC_CTRL0_vgs_bootram_mode_enum;
            reset = 0x1;
        } vgs_bootram_mode[21:21];

        enum MISC_CTRL0_vo_pin_reverse_enum {
            NORMAL = 0 { name = "Normal"; desc = "normal"; };
            REVERSED = 1 { name = "Reversed"; desc = "VOU656_DATA[7:0]/LCD_DATA[5:0] output reversed"; };
        };

        field {
            name = "vo_pin_reverse";
            desc = "Reverse output enable of the VO pin. When this bit is set to 1, the output of VOU656_DATA[7:0]/LCD_DATA[5:0] is reversed.";
            sw = rw;
            hw = r;
            encode = MISC_CTRL0_vo_pin_reverse_enum;
            reset = 0x0;
        } vo_pin_reverse[20:20];

        enum MISC_CTRL0_gzip_ddrt_sel_enum {
            DDRT = 0 { name = "Ddrt"; desc = "DDRT enabled, GZIP disabled"; };
            GZIP = 1 { name = "Gzip"; desc = "GZIP enabled, DDRT disabled"; };
        };

        field {
            name = "gzip_ddrt_sel";
            desc = "GZIP/DDRT function select";
            sw = rw;
            hw = r;
            encode = MISC_CTRL0_gzip_ddrt_sel_enum;
            reset = 0x0;
        } gzip_ddrt_sel[19:19];

        enum MISC_CTRL0_uart_txd_mask_by_lb_enum {
            NOT_MASKED = 0 { name = "Not Masked"; desc = "the UART*_TXD pin is not masked when loopback is enabled"; };
            MASKED = 1 { name = "Masked"; desc = "the UART*_TXD pin is masked when loopback is enabled and stays high"; };
        };

        field {
            name = "uart_txd_mask_by_lb";
            desc = "UART*_TXD pin mask when loopback is enabled";
            sw = rw;
            hw = r;
            encode = MISC_CTRL0_uart_txd_mask_by_lb_enum;
            reset = 0x0;
        } uart_txd_mask_by_lb[16:16];

        enum MISC_CTRL0_commtx_rx_int_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "commtx_rx_int_en";
            desc = "CPU COMMTX/COMMRX interrupt enable control";
            sw = rw;
            hw = r;
            encode = MISC_CTRL0_commtx_rx_int_en_enum;
            reset = 0x0;
        } commtx_rx_int_en[14:14];

        enum MISC_CTRL0_test_clksel_enum {
            PLL_TEST_OUT0 = 0 { name = "Pll Test Out0"; desc = "PLL_TEST_OUT[0]"; };
            PLL_TEST_OUT1 = 1 { name = "Pll Test Out1"; desc = "PLL_TEST_OUT[1]"; };
            PLL_TEST_OUT2 = 2 { name = "Pll Test Out2"; desc = "PLL_TEST_OUT[2]"; };
            PLL_TEST_OUT3 = 3 { name = "Pll Test Out3"; desc = "PLL_TEST_OUT[3]"; };
            CLK_TEST_OUT0 = 4 { name = "Clk Test Out0"; desc = "CLK_TEST_OUT[0]"; };
            CLK_TEST_OUT1 = 5 { name = "Clk Test Out1"; desc = "CLK_TEST_OUT[1]"; };
            CLK_TEST_OUT2 = 6 { name = "Clk Test Out2"; desc = "CLK_TEST_OUT[2]"; };
            CLK_TEST_OUT3 = 7 { name = "Clk Test Out3"; desc = "CLK_TEST_OUT[3]"; };
            CLK_24M = 8 { name = "Clk 24M"; desc = "CLK_24M"; };
            CLK_RTC = 9 { name = "Clk Rtc"; desc = "CLK_RTC"; };
            PLL_TEST_OUT0_10 = 10 { name = "Pll Test Out0 10"; desc = "other values select PLL_TEST_OUT[0]"; };
            PLL_TEST_OUT0_11 = 11 { name = "Pll Test Out0 11"; desc = "other values select PLL_TEST_OUT[0]"; };
            PLL_TEST_OUT0_12 = 12 { name = "Pll Test Out0 12"; desc = "other values select PLL_TEST_OUT[0]"; };
            PLL_TEST_OUT0_13 = 13 { name = "Pll Test Out0 13"; desc = "other values select PLL_TEST_OUT[0]"; };
            PLL_TEST_OUT0_14 = 14 { name = "Pll Test Out0 14"; desc = "other values select PLL_TEST_OUT[0]"; };
            PLL_TEST_OUT0_15 = 15 { name = "Pll Test Out0 15"; desc = "other values select PLL_TEST_OUT[0]"; };
        };

        field {
            name = "test_clksel";
            desc = "TEST_CLK source clock select";
            sw = rw;
            hw = r;
            encode = MISC_CTRL0_test_clksel_enum;
            reset = 0x0;
        } test_clksel[11:8];

        enum MISC_CTRL0_vicap_vpss_online_mode_enum {
            OFFLINE = 0 { name = "Offline"; desc = "offline mode"; };
            ONLINE = 1 { name = "Online"; desc = "online mode"; };
        };

        field {
            name = "vicap_vpss_online_mode";
            desc = "VICAP&VPSS working mode select";
            sw = rw;
            hw = r;
            encode = MISC_CTRL0_vicap_vpss_online_mode_enum;
            reset = 0x0;
        } vicap_vpss_online_mode[7:7];

        enum MISC_CTRL0_mipi_phy_mode_enum {
            MIPI = 0 { name = "Mipi"; desc = "MIPI mode"; };
            LVDS = 1 { name = "Lvds"; desc = "LVDS mode"; };
            CMOS = 2 { name = "Cmos"; desc = "CMOS mode"; };
            RESERVED = 3 { name = "Reserved"; desc = "reserved"; };
        };

        field {
            name = "mipi_phy_mode";
            desc = "MIPI PHY mode select";
            sw = rw;
            hw = r;
            encode = MISC_CTRL0_mipi_phy_mode_enum;
            reset = 0x0;
        } mipi_phy_mode[6:5];

        enum MISC_CTRL0_ssp1_cs_sel_enum {
            CS0 = 0 { name = "Cs0"; desc = "CS0"; };
            CS1 = 1 { name = "Cs1"; desc = "CS1"; };
        };

        field {
            name = "ssp1_cs_sel";
            desc = "SPI1 signal output CS select";
            sw = rw;
            hw = r;
            encode = MISC_CTRL0_ssp1_cs_sel_enum;
            reset = 0x0;
        } ssp1_cs_sel[4:4];

        enum MISC_CTRL0_spi1_cs1_pctrl_enum {
            ACTIVE_LOW = 0 { name = "Active Low"; desc = "SPI1_CSN1 active low"; };
            ACTIVE_HIGH = 1 { name = "Active High"; desc = "SPI1_CSN1 active high"; };
        };

        field {
            name = "spi1_cs1_pctrl";
            desc = "Polarity control of SPI1 CS1";
            sw = rw;
            hw = r;
            encode = MISC_CTRL0_spi1_cs1_pctrl_enum;
            reset = 0x0;
        } spi1_cs1_pctrl[3:3];

        enum MISC_CTRL0_spi1_cs0_pctrl_enum {
            ACTIVE_LOW = 0 { name = "Active Low"; desc = "SPI1_CSN0 active low"; };
            ACTIVE_HIGH = 1 { name = "Active High"; desc = "SPI1_CSN0 active high"; };
        };

        field {
            name = "spi1_cs0_pctrl";
            desc = "Polarity control of SPI1 CS0";
            sw = rw;
            hw = r;
            encode = MISC_CTRL0_spi1_cs0_pctrl_enum;
            reset = 0x0;
        } spi1_cs0_pctrl[2:2];

        enum MISC_CTRL0_spi0_cs0_pctrl_enum {
            ACTIVE_LOW = 0 { name = "Active Low"; desc = "SPI0_CSN active low"; };
            ACTIVE_HIGH = 1 { name = "Active High"; desc = "SPI0_CSN active high"; };
        };

        field {
            name = "spi0_cs0_pctrl";
            desc = "Polarity control of the SPI0 CS";
            sw = rw;
            hw = r;
            encode = MISC_CTRL0_spi0_cs0_pctrl_enum;
            reset = 0x0;
        } spi0_cs0_pctrl[1:1];
    } MISC_CTRL0 @ 0x0;

    reg {
        name = "RAM Retention control register 0";
        desc = "MISC_CTRL3 is an RAM Retention control register 0.

RAM retention control. Reset 0x800000EE: avc_ret1n_bypass = 1 and the six retention controls (emmc, sdio1, sdio0, usb, ir, cipher) = 1 (RAM active). Writing 0 to a *_ret1n bit puts the RAM of a disabled controller into retention to save power.

Data sheet 3.5.5.2 MISC_CTRL3 (offset 0xC, printed page 3-67, `hi3516cv300--Hi3516CV300-Hi3516EV100-Datasheet.txt` line 8694).";

        enum MISC_CTRL3_avc_ret1n_bypass_enum {
            RETENTION_AUTO = 0 { name = "Retention Auto"; desc = "automatic RAM retention function enabled"; };
            RETENTION_BYPASS = 1 { name = "Retention Bypass"; desc = "automatic RAM retention function disabled"; };
        };

        field {
            name = "avc_ret1n_bypass";
            desc = "Automatic RAM retention function control of the VEDU module";
            sw = rw;
            hw = r;
            encode = MISC_CTRL3_avc_ret1n_bypass_enum;
            reset = 0x1;
        } avc_ret1n_bypass[31:31];

        enum MISC_CTRL3_bootrom_pgen_enum {
            POWERED_ON = 0 { name = "Powered On"; desc = "boot ROM powered on"; };
            POWERED_OFF = 1 { name = "Powered Off"; desc = "boot ROM powered off, it cannot work"; };
        };

        field {
            name = "bootrom_pgen";
            desc = "Boot ROM power supply control";
            sw = rw;
            hw = r;
            encode = MISC_CTRL3_bootrom_pgen_enum;
            reset = 0x0;
        } bootrom_pgen[10:10];

        enum MISC_CTRL3_emmc_ret1n_enum {
            RETENTION = 0 { name = "Retention"; desc = "RAM in retention state"; };
            ACTIVE = 1 { name = "Active"; desc = "RAM active"; };
        };

        field {
            name = "emmc_ret1n";
            desc = "RAM retention control of the eMMC";
            sw = rw;
            hw = r;
            encode = MISC_CTRL3_emmc_ret1n_enum;
            reset = 0x1;
        } emmc_ret1n[7:7];

        enum MISC_CTRL3_sdio1_ret1n_enum {
            RETENTION = 0 { name = "Retention"; desc = "RAM in retention state"; };
            ACTIVE = 1 { name = "Active"; desc = "RAM active"; };
        };

        field {
            name = "sdio1_ret1n";
            desc = "RAM retention control of SDIO1";
            sw = rw;
            hw = r;
            encode = MISC_CTRL3_sdio1_ret1n_enum;
            reset = 0x1;
        } sdio1_ret1n[6:6];

        enum MISC_CTRL3_sdio0_ret1n_enum {
