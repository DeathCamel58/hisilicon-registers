            ACTIVE = 1 { name = "Active"; desc = "RAM active"; };
        };

        field {
            name = "usb_ret1n";
            desc = "RAM retention control of the USB";
            sw = rw;
            hw = r;
            encode = MISC_CTRL3_usb_ret1n_enum;
            reset = 0x1;
        } usb_ret1n[3:3];

        enum MISC_CTRL3_ir_ret1n_enum {
            RETENTION = 0 { name = "Retention"; desc = "RAM in retention state"; };
            ACTIVE = 1 { name = "Active"; desc = "RAM active"; };
        };

        field {
