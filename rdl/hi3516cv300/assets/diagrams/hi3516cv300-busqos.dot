// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3516cv300-busqos" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3516C V300: bus master and slave ports</B><BR/><FONT POINT-SIZE="11">ports named in the system controller bus timeout/priority registers (MISC_CTRL5-22); topology between the buses is INFERRED from the slave port list</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  ddrc [label="MDDRC (DDR controller)", fillcolor="#e0b86f"  ];
  sysaxi [label="SYS AXI bus", fillcolor="#9a9a9a"  ];
  mediabus [label="media bus(es)", fillcolor="#9a9a9a"  ];
  sm0 [label="CPU (M1)", fillcolor="#8fb3de"  ];
  sm1 [label="AHB master 0 (M2)", fillcolor="#8fb3de"  ];
  sm2 [label="AHB master 1 (M3)", fillcolor="#8fb3de"  ];
  sm3 [label="AHB master 2 (M4)", fillcolor="#8fb3de"  ];
  ss0 [label="slave S1: AHB_SUBSYS", fillcolor="#7fcdc4"  ];
  ss1 [label="slave S2: SYS APB", fillcolor="#7fcdc4"  ];
  ss2 [label="slave S3: media APB", fillcolor="#7fcdc4"  ];
  media0 [label="VGS (M1)", fillcolor="#a6c98f"  ];
  media1 [label="IVE (M2)", fillcolor="#a6c98f"  ];
  media2 [label="JPGE (M3)", fillcolor="#a6c98f"  ];
  media3 [label="DDRT / GZIP (M4)", fillcolor="#a6c98f"  ];
  vivo0 [label="VICAP (M1)", fillcolor="#a6c98f"  ];
  vivo1 [label="AIAO (M2)", fillcolor="#a6c98f"  ];
  vivo2 [label="VDP (M3)", fillcolor="#a6c98f"  ];
  sysaxi -> ddrc;
  mediabus -> sysaxi;
  sm0 -> sysaxi;
  sm1 -> sysaxi;
  sm2 -> sysaxi;
  sm3 -> sysaxi;
  sysaxi -> ss0;
  sysaxi -> ss1;
  sysaxi -> ss2;
  media0 -> mediabus;
  media1 -> mediabus;
  media2 -> mediabus;
  media3 -> mediabus;
  vivo0 -> mediabus [label="vivo"];
  vivo1 -> mediabus [label="vivo"];
  vivo2 -> mediabus [label="vivo"];
}
