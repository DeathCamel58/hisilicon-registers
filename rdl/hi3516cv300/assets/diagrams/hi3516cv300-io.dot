// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3516cv300-io" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3516C V300: storage, network and USB paths</B><BR/><FONT POINT-SIZE="11">from the architecture and peripheral lists of the data sheet; the controller-to-device wiring shown is the usual board connection (INFERRED where not named in the sheet)</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  cpu [label="CPU + bus", fillcolor="#e0b86f"  ];
  fmc [label="FMC (SPI NOR / NAND)", fillcolor="#8fb3de"  ];
  fmc_x [label="SPI flash", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  sdio [label="SDIO0/1/2 (+ eMMC)", fillcolor="#8fb3de"  ];
  sdio_x [label="SD card, SDIO Wi-Fi / BT / 4G, eMMC", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  eth [label="ETH MAC (RMII)", fillcolor="#8fb3de"  ];
  eth_x [label="external PHY", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  usb [label="USB 2.0 host / device", fillcolor="#8fb3de"  ];
  usb_x [label="USB port", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  cpu -> fmc;
  fmc -> fmc_x;
  cpu -> sdio;
  sdio -> sdio_x;
  cpu -> eth;
  eth -> eth_x;
  cpu -> usb;
  usb -> usb_x;
}
