// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3516cv300-video" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3516C V300: video data path</B><BR/><FONT POINT-SIZE="11">block names from the data sheet logic figure and chapter 1; arrows are the usual camera data path (INFERRED, not tabulated); DDR sits between the stages</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  sens [label="CMOS sensor", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  vin [label="MIPI / LVDS / HiSPi / BT.656 /\nBT.1120 / DC sensor input", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  vicap [label="VICAP (+ MIPI RX)", fillcolor="#a6c98f"  ];
  isp [label="ISP\n3A, DPC, LSC, WDR, NR", fillcolor="#a6c98f"  ];
  vpss [label="VPSS + VGS\n3DNR, scale, rotate,\nOSD overlay", fillcolor="#a6c98f"  ];
  enc [label="VEDU: H.264 / H.265 / MJPEG,\nJPGE: JPEG", fillcolor="#a6c98f"  ];
  ive [label="IVE", fillcolor="#a6c98f"  ];
  vdp [label="VDP\nvideo / graphics layers", fillcolor="#a6c98f"  ];
  lcd [label="VDP: BT.656, RGB565 LCD, CVBS", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  sink [label="FMC flash / SDIO / USB / ETH\n(storage, Wi-Fi, network)", fillcolor="#8fb3de"  ];
  sens -> vin;
  vin -> vicap;
  vicap -> isp;
  isp -> vpss;
  vpss -> enc;
  vpss -> ive;
  vpss -> vdp;
  vdp -> lcd;
  enc -> sink [label="streams"];
}
