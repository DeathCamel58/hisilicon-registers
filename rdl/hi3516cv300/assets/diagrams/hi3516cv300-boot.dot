// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3516cv300-boot" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3516C V300: boot flow</B><BR/><FONT POINT-SIZE="11">data sheet 1.4 (BOOT_SEL1/0 and UPDATE_MODE latched at power-on); straps shown with the pin they share</FONT>>, fontcolor="#808080", rankdir=TB];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  por [label="Power-on reset", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  upd [label="UPDATE_MODE (GPIO0_3) ?", fillcolor="#d6d27a"   shape=diamond];
  upd0 [label="U-Boot update from\nSD card / USB port", fillcolor="#8fb3de"  ];
  sel [label="BOOT_SEL1 (MDCK) ?", fillcolor="#d6d27a"   shape=diamond];
  fb [label="Fastboot: serial download (UART, HiBurn)", fillcolor="#e0b86f"  ];
  to [label="Serial link\ntimed out?", fillcolor="#d6d27a"   shape=diamond];
  s0 [label="BOOT_SEL0 (EPHY_RSTN) ?", fillcolor="#d6d27a"   shape=diamond];
  spi [label="SPI NOR / NAND on the FMC\nSFC_DEVICE_MODE (SENSOR_RSTN),\nSFC_BOOT_MODE (SFC_CLK)", fillcolor="#8fb3de"  ];
  emmc [label="eMMC (4-bit on the C V300)", fillcolor="#8fb3de"  ];
  run [label="Boot program runs", fillcolor="#a6c98f"  ];
  por -> upd;
  upd -> upd0 [label="0"];
  upd -> sel [label="1"];
  sel -> fb [label="1"];
  sel -> s0 [label="0"];
  fb -> to;
  to -> run [label="download done"];
  to -> s0 [label="yes"];
  s0 -> spi [label="0"];
  s0 -> emmc [label="1"];
  spi -> run;
  emmc -> run;
}
