// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3516cv300-power" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3516C V300: power control</B><BR/><FONT POINT-SIZE="11">data sheet 3.10 (Figure 3-10, power controller 3.10.2)</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  rtc [label="RTC (32.768 kHz, AVDD_BAT)", fillcolor="#7fcdc4"  ];
  pc [label="Power controller (always-on)\nPWR_SEQ0/1/2 timing, polarity", fillcolor="#c9a0dc"  ];
  wake [label="PWR_WAKEUP, PWR_BUTTON\n(2 s on, 10 s forced off)", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  alarm [label="RTC scheduled power-on", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  dcdc [label="external DC/DC and LDO supplies,\nSDIO Wi-Fi / BT / 4G module", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  chip [label="power-off area: CPU, DDR controller,\nperipherals, media blocks", fillcolor="#e0b86f"  ];
  lp [label="Low-power means: clock gating, module low power,\nDDR self-refresh, adaptive voltage scaling", fillcolor="#d6d27a"  ];
  rtc -> pc [label="clock"];
  wake -> pc;
  alarm -> pc;
  pc -> dcdc [label="PWR_SEQ"];
  dcdc -> chip [label="supply"];
  lp -> chip;
}
