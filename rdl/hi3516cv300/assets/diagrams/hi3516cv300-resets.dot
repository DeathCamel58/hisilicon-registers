// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3516cv300-resets" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3516C V300: reset sources</B><BR/><FONT POINT-SIZE="11">data sheet 3.1 (reset control figure and Table 3-1)</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  por [label="internal POR\n(low > 12 XIN cycles)", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  wdg [label="watchdog reset", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  npor [label="npor: global hard reset", fillcolor="#d6d27a"   shape=diamond];
  sysc [label="SYS_CTRL global soft reset\nsys_rst_req", fillcolor="#e0b86f"  ];
  sys [label="sys_rst_n: global soft reset\nexcludes clock/test circuits and\nregisters without soft reset;\nreleased after >= 64 ms", fillcolor="#8fb3de"  ];
  crg [label="CRG: xx_srst_req per module", fillcolor="#9aa7e6"  ];
  mod [label="xx_rst_n: module resets", fillcolor="#a6c98f"  ];
  pc [label="Power controller (always-on, RTC clock):\nPWR_SEQ0/1/2, PWR_WAKEUP, PWR_BUTTON", fillcolor="#c9a0dc"  ];
  por -> npor;
  wdg -> sys;
  sysc -> sys;
  npor -> sys;
  crg -> mod;
  sys -> mod;
  npor -> mod;
}
