// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3516cv300-logic" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3516C V300: logic block diagram</B><BR/><FONT POINT-SIZE="11">drawn from the architecture list and logic figure of the data sheet (chapter 1); bus topology as in the sheet figure (AMBA 3.0 AXI/AHB/APB), details in the register pages</FONT>>, fontcolor="#808080", rankdir=LR, compound=true, newrank=true];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  bus [label="AMBA bus", fillcolor="#9a9a9a"  shape=box, height=5.2, width=0.5, fontcolor="white"];
  subgraph cluster_cpu { label="CPU subsystem"; fontcolor="#808080"; color="#808080"; style="rounded";
  cpu [label="ARM926 800 MHz\n32 KB I + 32 KB D", fillcolor="#e0b86f"  ];
  }
  ddrc [label="DDRC", fillcolor="#8fb3de"  ];
  ddrext [label="external 16-bit DDR3/DDR3L\nup to 4 Gbit", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  ddrext -> ddrc [dir=both]; ddrc -> cpu [dir=both]; ddrc -> bus [dir=both, style=dashed];
  subgraph cluster_l0 { label="Storage, network, USB, audio"; fontcolor="#808080"; color="#808080"; style="rounded";
    sdio [label="SDIO 2.0 x3\n(+ eMMC 4.5)", fillcolor="#8fb3de"  ];
    fmc [label="FMC (SPI NOR / NAND)", fillcolor="#8fb3de"  ];
    eth [label="ETH MAC RMII 10/100", fillcolor="#8fb3de"  ];
    usb [label="USB 2.0 host/device", fillcolor="#8fb3de"  ];
    aud [label="audio codec + I2S", fillcolor="#8fb3de"  ];
  }
  sdio -> bus [dir=both];
  fmc -> bus [dir=both];
  eth -> bus [dir=both];
  usb -> bus [dir=both];
  aud -> bus [dir=both];
  subgraph cluster_l1 { label="Security"; fontcolor="#808080"; color="#808080"; style="rounded";
    sec [label="AES / DES / 3DES / RSA /\nHASH / OTP / TRNG", fillcolor="#c9a0dc"  ];
  }
  sec -> bus [dir=both];
  subgraph cluster_r0 { label="Image subsystem"; fontcolor="#808080"; color="#808080"; style="rounded";
    isp [label="ISP (3A, WDR)", fillcolor="#a6c98f"  ];
    vin [label="MIPI / LVDS / HiSPi / BT.656 /\nBT.1120 / DC (VICAP + ISP)", fillcolor="#a6c98f"  ];
    vpss [label="VPSS + TDE / VGS, IVE", fillcolor="#a6c98f"  ];
    vo [label="VDP: CVBS (PAL/NTSC), BT.656,\nRGB565 LCD", fillcolor="#a6c98f"  ];
  }
  bus -> isp [dir=both];
  bus -> vin [dir=both];
  bus -> vpss [dir=both];
  bus -> vo [dir=both];
  subgraph cluster_r1 { label="Video subsystem"; fontcolor="#808080"; color="#808080"; style="rounded";
    enc [label="H.264 BP/MP/HP, H.265 Main,\nMJPEG/JPEG encoder", fillcolor="#a6c98f"  ];
  }
  bus -> enc [dir=both];
  subgraph cluster_r2 { label="Low-speed peripherals (APB)"; fontcolor="#808080"; color="#808080"; style="rounded";
    lsp [label="RTC, I2C x2, SSP x3, GPIO, IR, UART x3,\nPWM x4, LSADC x3", fillcolor="#7fcdc4"  ];
  }
  bus -> lsp [dir=both];
  sd [label="SD card, SDIO Wi-Fi/BT/4G, eMMC", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  sd -> sdio [dir=both, style=dashed];
  nor [label="SPI NOR / NAND flash", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  nor -> fmc [dir=both, style=dashed];
  phy [label="external Ethernet PHY", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  phy -> eth [dir=both, style=dashed];
  usbp [label="USB port", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  usbp -> usb [dir=both, style=dashed];
  bus -> cpu [dir=both];
}
