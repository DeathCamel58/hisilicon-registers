// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3516cv300-clocks" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3516C V300: clock tree</B><BR/><FONT POINT-SIZE="11">data sheet 3.2 (Figures 3-2 to 3-4, Tables 3-2 and 3-3); the figures are not tabulated, module frequencies are Table 3-2</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  xin [label="XIN crystal 24 MHz\n(also USB2 PHY reference)", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  rtc [label="RTC_XIN 32.768 kHz", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  apll [label="APLL (PERI_CRG_PLL0/1)\nprogrammable", fillcolor="#e6a0a0"  ];
  vpll [label="VPLL (PERI_CRG_PLL4/5)\nfixed", fillcolor="#e6a0a0"  ];
  epll [label="EPLL (PERI_CRG_PLL8/9)\nfixed", fillcolor="#e6a0a0"  ];
  arm [label="ARM9: 24 MHz at reset;\nAPLL POSTDIV, VCO/2, 594 MHz", fillcolor="#e0b86f"  ];
  ddr [label="DDR controller: 24 MHz,\nAPLL divided, 250, 198 MHz", fillcolor="#e0b86f"  ];
  apb [label="SYS APB: 24 / 50 MHz", fillcolor="#e0b86f"  ];
  vicap [label="VICAP 83.3-198 MHz,\nISP = VICAP or VICAP/2", fillcolor="#a6c98f"  ];
  vpss [label="VPSS 148.5-250 MHz or\nVICAP (online)", fillcolor="#a6c98f"  ];
  codec [label="VEDU 166.6 / 198, JPGE 198,\nVGS 198-396, IVE 198-297 MHz", fillcolor="#a6c98f"  ];
  io [label="FMC 24-297 MHz, sensor clock\n74.25 / 37.125 / 54 / 27 / 24 / 25 MHz\nAIAO 1188 MHz source, VDP 74.25 / 27 MHz", fillcolor="#8fb3de"  ];
  gate [label="CRG clock gates, selects, resets", fillcolor="#9aa7e6"  ];
  tim [label="Timers: SC_CTRL timeren0ov..3ov\nreference / bus clock", fillcolor="#d6d27a"  ];
  xin -> apll;
  xin -> vpll;
  xin -> epll;
  xin -> arm [label="24 MHz"];
  apll -> arm;
  apll -> ddr;
  xin -> apb;
  vpll -> vicap;
  vpll -> vpss;
  vpll -> codec;
  epll -> io;
  arm -> gate;
  ddr -> gate;
  apb -> tim;
  vicap -> gate;
  vpss -> gate;
  codec -> gate;
  io -> gate;
  rtc -> gate [label="RTC"];
}
