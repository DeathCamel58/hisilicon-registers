    reg {
        name = "System-on-chip (SoC) clock selection register";
        desc = "PERI_CRG12 is an SoC clock selection register.

SoC clock selection. Everything resets to the 24 MHz crystal (reset value 0): CPU clock (cpu_sc_sel), DDR clock (ddr_sc_sel, ddr_clk_div) and the system APB clock (apb_sc_sel). DS Table 3-5 gives the same bit positions. SYSAPB is 24 MHz or 50 MHz directly (the vendor U-Boot get_apb_bus_clk() reads bit 0 and returns 24000000 or 50000000, and uses it as the SP804 timer clock when SC_CTRL selects the bus clock; the vendor Linux apb mux is {24m, 50m} at 0x30 bit 0). Unlike the Hi3518EV200 there is no /4 divider after the bus mux and no separate bus mux: on the Hi3518EV200 PERI_CRG12 bit 0 chose 24/198 MHz and APB was that /4. Switching can be polled in PERI_CRG55.

Data sheet 3.2.7 PERI_CRG12 (offset 0x30, printed page 3-22, `hi3516cv300--Hi3516CV300-Hi3516EV100-Datasheet.txt` line 6186).";

        enum PERI_CRG12_ddr_clk_div_enum {
            DIV1 = 0 { name = "Div1"; desc = "divided by 1"; };
            DIV2 = 1 { name = "Div2"; desc = "divided by 2"; };
            DIV3 = 2 { name = "Div3"; desc = "divided by 3"; };
            DIV4 = 3 { name = "Div4"; desc = "divided by 4"; };
        };

        field {
            name = "ddr_clk_div";
            desc = "Divider applied to the APLL FOUTPOSTDIV clock when it is selected as DDR clock (ddr_sc_sel = 01)";
            sw = rw;
            hw = r;
            encode = PERI_CRG12_ddr_clk_div_enum;
            reset = 0x0;
        } ddr_clk_div[9:8];

        enum PERI_CRG12_cpu_sc_sel_enum {
            XTAL_24MHZ = 0 { name = "Xtal 24Mhz"; desc = "crystal oscillator clock (24 MHz, reset default)"; };
            APLL_POSTDIV = 1 { name = "Apll Postdiv"; desc = "APLL FOUTPOSTDIV clock"; };
            APLL_VCO_DIV2 = 2 { name = "Apll Vco Div2"; desc = "APLL FOUTVCO divide-by-2 clock"; };
            CLK_594MHZ = 3 { name = "Clk 594Mhz"; desc = "594 MHz"; };
        };

        field {
            name = "cpu_sc_sel";
            desc = "CPU (ARM926) clock select. Switch completion is reported in PERI_CRG55 cpu_sc_seled. The 594 MHz clock is the VPLL POSTDIV output.";
            sw = rw;
            hw = r;
            encode = PERI_CRG12_cpu_sc_sel_enum;
            reset = 0x0;
        } cpu_sc_sel[5:4];

        enum PERI_CRG12_ddr_sc_sel_enum {
