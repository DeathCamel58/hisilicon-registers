// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3516av200-logic" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3516A V200: logic block diagram</B><BR/><FONT POINT-SIZE="11">redrawn from the data sheet logic block diagram (chapter 1); bus as in the vendor figure (AMBA 3.0)</FONT>>, fontcolor="#808080", rankdir=LR, compound=true, newrank=true];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  bus [label="AMBA 3.0 bus", fillcolor="#9a9a9a"  shape=box, height=5.2, width=0.5, fontcolor="white"];
  subgraph cluster_cpu { label="CPU subsystem"; fontcolor="#808080"; color="#808080"; style="rounded";
  cpu [label="Cortex-A17 @ 1.25 GHz (32K/32K L1, 256 KB L2)\n+ Cortex-A7 @ 800 MHz (32K/32K L1, 128 KB L2)\nbig.LITTLE, NEON + FPU, GIC-400, CCI", fillcolor="#e0b86f"  ];
  }
  ddrc [label="DDRC", fillcolor="#8fb3de"  ];
  ddrext [label="32-bit DDR4/3/3L/LPDDR3\nup to 800 MHz, 2 GB", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  ddrext -> ddrc [dir=both]; ddrc -> cpu [dir=both]; ddrc -> bus [dir=both, style=dashed];
  subgraph cluster_l0 { label="Storage and network"; fontcolor="#808080"; color="#808080"; style="rounded";
    fmc [label="FMC (SPI NOR / NAND / SPI NAND)", fillcolor="#8fb3de"  ];
    mmc [label="MMC0/1/2: SDIO 3.0 x2, eMMC 5.0", fillcolor="#8fb3de"  ];
    eth [label="GMAC (GSF)\nRGMII/RMII, TSO", fillcolor="#8fb3de"  ];
    usb [label="USB 3.0 / 2.0\nhost + device", fillcolor="#8fb3de"  ];
    pcie [label="PCIe 2.0 x1\nRC or EP", fillcolor="#8fb3de"  ];
    aio [label="AIAO (I2S) +\naudio codec", fillcolor="#8fb3de"  ];
  }
  fmc -> bus [dir=both];
  mmc -> bus [dir=both];
  eth -> bus [dir=both];
  usb -> bus [dir=both];
  pcie -> bus [dir=both];
  aio -> bus [dir=both];
  subgraph cluster_l1 { label="Security"; fontcolor="#808080"; color="#808080"; style="rounded";
    sec [label="CIPHER, HASH, RSA,\nTRNG, OTP key ctrl", fillcolor="#c9a0dc"  ];
  }
  sec -> bus [dir=both];
  subgraph cluster_r0 { label="Image subsystem"; fontcolor="#808080"; color="#808080"; style="rounded";
    vi [label="MIPI0/1 + VICAP0/1 + ISP x2\n(MIPI/LVDS/HiSPi, DC, BT.1120)", fillcolor="#a6c98f"  ];
    vpss [label="VPSS + VGS + GDC", fillcolor="#a6c98f"  ];
    tde [label="TDE + IVE + GZIP", fillcolor="#a6c98f"  ];
    vo [label="VDP: CVBS, BT.1120/656, LCD", fillcolor="#a6c98f"  ];
  }
  bus -> vi [dir=both];
  bus -> vpss [dir=both];
  bus -> tde [dir=both];
  bus -> vo [dir=both];
  subgraph cluster_r1 { label="Video codec"; fontcolor="#808080"; color="#808080"; style="rounded";
    vedu [label="VEDU (H.264 / H.265)", fillcolor="#a6c98f"  ];
    jpge [label="JPGE", fillcolor="#a6c98f"  ];
  }
  bus -> vedu [dir=both];
  bus -> jpge [dir=both];
  subgraph cluster_r2 { label="Low-speed peripherals"; fontcolor="#808080"; color="#808080"; style="rounded";
    lsp [label="UART x5, SSP x4, I2C x4, GPIO, IR, PWM x8,\nLSADC x3, timers, WDG, RTC, DMAC,\nSYS_CTRL, CRG, PMC, power controller,\nI/O MUX + CTRL", fillcolor="#7fcdc4"  ];
    rom [label="BOOTROM 32 KB, BOOTRAM 32 KB", fillcolor="#7fcdc4"  ];
  }
  bus -> lsp [dir=both];
  bus -> rom [dir=both];
  fl [label="SPI NOR / NAND,\nNAND, eMMC", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  fl -> fmc [dir=both, style=dashed];
  fl -> mmc [dir=both, style=dashed];
  sd [label="SD card", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  sd -> mmc [dir=both, style=dashed];
  phy [label="Ethernet PHY", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  phy -> eth [dir=both, style=dashed];
  usbp [label="USB port", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  usbp -> usb [dir=both, style=dashed];
  peer [label="PCIe peer", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  peer -> pcie [dir=both, style=dashed];
  sens [label="2 CMOS sensors", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  vi -> sens [dir=both, style=dashed];
  disp [label="CVBS / BT.1120 / LCD", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  vo -> disp [dir=both, style=dashed];
  bus -> cpu [dir=both];
}
