    reg {
        name = "PCIe/USB 3.0 read outstanding limit control register";
        desc = "MISC_CTRL2 is a PCIe/USB 3.0 read outstanding limit control register.

PCIe/USB 3.0 master read outstanding limit.

Data sheet 3.5.5.2 MISC_CTRL2 (offset 0x8, printed page 3-75, `hi3516av200--Hi3516AV200-Datasheet.txt` line 8033).";

        enum MISC_CTRL2_pcie_m_od_bypass_limit_enum {
