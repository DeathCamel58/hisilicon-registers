    reg {
        name = "RET1N control register";
        desc = "MISC_CTRL4 is an RET1N control register.

RET1N (memory retention) control. The header reset is 0xFFFF_FFFF: every reserved bit also resets to 1 and is modelled as reserved_nz fields (low confidence that these bits have any function).

Data sheet 3.5.5.2 MISC_CTRL4 (offset 0x10, printed page 3-77, `hi3516av200--Hi3516AV200-Datasheet.txt` line 8152).";

        enum MISC_CTRL4_vedu_ret1n_bypass_enum {
            ENABLED = 0 { name = "Enabled"; desc = "enabled"; };
            BYPASSED = 1 { name = "Bypassed"; desc = "bypassed"; };
        };

        field {
            name = "vedu_ret1n_bypass";
            desc = "Automatic memory RET1N function bypass for the VEDU module";
            sw = rw;
            hw = r;
            encode = MISC_CTRL4_vedu_ret1n_bypass_enum;
            reset = 0x1;
        } vedu_ret1n_bypass[31:31];

        field {
            name = "reserved_nz_30_8";
            desc = "Reserved in the bit table, but the data sheet total reset value of this register has these bits set (reset 0x7FFFFF).";
            sw = r;
            hw = w;
            reset = 0x007FFFFF;
        } reserved_nz_30_8[30:8];

        field {
            name = "emmc_ret1n";
            desc = "Memory RET1N signal in the MMC2. Set this bit to 1 when the MMC2 is enabled and set this bit to 0 when the MMC2 is disabled to reduce memory power consumption.";
            sw = rw;
            hw = r;
            reset = 0x1;
        } emmc_ret1n[7:7];

