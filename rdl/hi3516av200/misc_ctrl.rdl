        } dma_01_sel[24:24];

        enum MISC_CTRL1_dma_67_sel_enum {
            UART3 = 0 { name = "Uart3"; desc = "UART3 connects to DMA hardware request lines 6 and 7"; };
            I2C3 = 1 { name = "I2C3"; desc = "I2C3 connects to DMA hardware request lines 6 and 7"; };
            SSP3 = 2 { name = "Ssp3"; desc = "SSP3 connects to DMA hardware request lines 6 and 7 (data sheet 1X)"; };
