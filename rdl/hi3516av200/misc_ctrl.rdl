`ifndef MISC_RDL
`define MISC_RDL

regfile eMISC_CTRL {
    name = "Miscellaneous control (MISC_CTRL), Hi3516A V200";
    desc = "    MISC_CTRLn miscellaneous control registers at 0x12030000 (offset = n x 4 for the MISC_CTRL registers; the OTP root-key and control-bit programming registers live at 0x3000 and 0x5000 inside the block). Data sheet: Hi3516A V200 Professional HD IP Camera SoC, Issue 01 (2018-07-05), chapter 3.5.5 `Peripheral Control Registers` (3.5.5.1 summary, 3.5.5.2 description); the Hi3519 V101 data sheet has the same chapter register for register (checked 2026-11-10). 63 registers: 53 MISC_CTRLn registers (MISC_CTRL0..MISC_CTRL98 with gaps), 4 OTP_ROOTKEY_AES words and 6 OTP_CTRLBIT registers.

    What the block holds: VICAP/MIPI mode (MISC_CTRL0: MIPI0/1 mode, VICAP input select, VICAP0/VPSS0 online mode); peripheral selects (MISC_CTRL1: SSP2 chip select, DMA request line sharing, SPI chip-select polarity, USB 2.0 PHY control source); MMC power switches (MISC_CTRL3); RAM retention (MISC_CTRL4); AXI QoS: per-bus timeout counters, master/slave priorities (MISC_CTRL5..18, 85..98) and the DDR QoS maps (MISC_CTRL21..28); USB 3.0 controller glue (MISC_CTRL29), USB 2.0 controller glue (MISC_CTRL30..32: chip id host/device, power polarity, AHB burst enables, PHY test channel), COMB PHY (PCIe/USB 3.0) test channel and control (MISC_CTRL33/34); the ACODEC analog block (MISC_CTRL45..48, 0xB4-0xC0) and digital block (MISC_CTRL51..54, 0xCC-0xD8), I2S channel select (MISC_CTRL56); MDDRC scrambling (MISC_CTRL62..64); eMMC DLL control (MISC_CTRL80/81); OTP root key (OTP_ROOTKEY_AES_0..3 at 0x3000, readable only before the CPU clears the remap in secure boot) and control-bit programming (OTP_CTRLBIT_PG_MODE/BUSY/BIT0..3 at 0x5000..0x5014: write the magic value to enter programming mode, then one magic value per control bit JTAG_DISABLE, DDR_CA_EN, SECURE_BOOT_EN, BOOTROM_MASK; these are one-time-programmable fuses, never write them without intent).

    Bring-up notes: the vendor U-Boot 2010.06 (`board/hi3519v101/board.c`, `arch-hi3519v101/platform.h`) only touches MISC_CTRL33 (COMB PHY test channel, offset 0x84, called MISC_STRL33 in the sources) with write sequences such as 0x1506/0x11506/0x1506/0x0 to program the PHY. Registers MISC_CTRL45..54 (ACODEC) are not soft-resettable per the data sheet. Reserved bits whose total reset value (header) is non-zero are modelled as RO reserved_nz_<hi>_<lo> fields so the register reset equals the data sheet header: MISC_CTRL1, 4, 8, 14, 21, 25, 29, 30, 45, 46, 47, 48, 51, 52, 53, 54, 88 and 98.

    Known data sheet errors and decisions (dump `hi3516av200--Hi3516AV200-Datasheet.txt`, checked 2026-11-10): the summary table prints truncated names for the OTP rows (OTP_ROOTKE/OTP_CTRLBIT) and omits the OTP_ROOTKEY_AES_0..2 rows; the names of the description blocks are used. The description block of MISC_CTRL32 glues two field names together (usb2_phy_testaddr is the 11-bit address field); MISC_CTRL45 bits 7/6 have wrapped names (acodec_pd_micbias2/1); the extracted descriptions of MISC_CTRL51 are lost in the PDF layout and were rebuilt from the rows; the MISC_CTRL46 LINEINR gain table crosses a page break. The register numbering has gaps (the data sheet documents only MISC_CTRL0-9, 11, 12, 14-16, 18, 21-34, 45-48, 51-54, 56, 62-64, 80, 81, 85, 88, 89, 93-98).

    Sources: HiSilicon's own English data sheet `Hi3516AV200-Datasheet.pdf` (not machine translated; no watermark), dump `hi3516av200--Hi3516AV200-Datasheet.txt`. Registers, fields and reset values were extracted programmatically and compared with this file.
    ";

    reg {
        name = "VICAP/VPSS/MIPI PHY control register";
        desc = "MISC_CTRL0 is a VICAP/VPSS/MIPI PHY control register.

VICAP/VPSS and MIPI PHY mode: MIPI0/MIPI1 work mode, VICAP0/1 input select, VICAP0/VPSS0 online mode, shutter/flash trigger source. Reset 0x54: mipi0_work_mode = 1 and mipi1_work_mode = 1 (LVDS), vicap1_input_sel = 1 (MIPI1).

Data sheet 3.5.5.2 MISC_CTRL0 (offset 0x0, printed page 3-72, `hi3516av200--Hi3516AV200-Datasheet.txt` line 7873).";

        enum MISC_CTRL0_shutter_flash_trig_sel_enum {
            OUTPUT_VICAP0 = 0 { name = "Output Vicap0"; desc = "output by VICAP0"; };
            OUTPUT_VICAP1 = 1 { name = "Output Vicap1"; desc = "output by VICAP1"; };
        };

        field {
            name = "shutter_flash_trig_sel";
            desc = "Shutter_Trig/Flash_Trig output select";
            sw = rw;
            hw = r;
            encode = MISC_CTRL0_shutter_flash_trig_sel_enum;
            reset = 0x0;
        } shutter_flash_trig_sel[10:10];

        enum MISC_CTRL0_vicap0_vpss0_online_enum {
            OFFLINE_MODE = 0 { name = "Offline Mode"; desc = "offline mode"; };
            ONLINE_MODE = 1 { name = "Online Mode"; desc = "online mode"; };
        };

        field {
            name = "vicap0_vpss0_online";
            desc = "VICAP0/VPSS0 mode";
            sw = rw;
            hw = r;
            encode = MISC_CTRL0_vicap0_vpss0_online_enum;
            reset = 0x0;
        } vicap0_vpss0_online[9:9];

        enum MISC_CTRL0_mipi0_work_mode_enum {
            MIPI_MODE = 0 { name = "Mipi Mode"; desc = "MIPI mode"; };
            LVDS_MODE = 1 { name = "Lvds Mode"; desc = "LVDS mode"; };
            CMOS_MODE = 2 { name = "Cmos Mode"; desc = "CMOS mode"; };
            RESERVED_3 = 3 { name = "Reserved 3"; desc = "reserved"; };
        };

        field {
            name = "mipi0_work_mode";
            desc = "MIPI0 mode select";
            sw = rw;
            hw = r;
            encode = MISC_CTRL0_mipi0_work_mode_enum;
            reset = 0x1;
        } mipi0_work_mode[7:6];

        enum MISC_CTRL0_mipi1_work_mode_enum {
            MIPI_MODE = 0 { name = "Mipi Mode"; desc = "MIPI mode"; };
            LVDS_MODE = 1 { name = "Lvds Mode"; desc = "LVDS mode"; };
            CMOS_MODE = 2 { name = "Cmos Mode"; desc = "CMOS mode"; };
            RESERVED_3 = 3 { name = "Reserved 3"; desc = "reserved"; };
        };

        field {
            name = "mipi1_work_mode";
            desc = "MIPI1 mode select";
            sw = rw;
            hw = r;
            encode = MISC_CTRL0_mipi1_work_mode_enum;
            reset = 0x1;
        } mipi1_work_mode[5:4];

        enum MISC_CTRL0_vicap1_input_sel_enum {
            MIPI0 = 0 { name = "Mipi0"; desc = "MIPI0"; };
            MIPI1 = 1 { name = "Mipi1"; desc = "MIPI1"; };
            CMOS0 = 2 { name = "Cmos0"; desc = "CMOS0"; };
            CMOS1 = 3 { name = "Cmos1"; desc = "CMOS1"; };
        };

        field {
            name = "vicap1_input_sel";
            desc = "VICAP1 input select";
            sw = rw;
            hw = r;
            encode = MISC_CTRL0_vicap1_input_sel_enum;
            reset = 0x1;
        } vicap1_input_sel[3:2];

        enum MISC_CTRL0_vicap0_input_sel_enum {
            MIPI0 = 0 { name = "Mipi0"; desc = "MIPI0"; };
            MIPI1 = 1 { name = "Mipi1"; desc = "MIPI1"; };
            CMOS0 = 2 { name = "Cmos0"; desc = "CMOS0"; };
            CMOS1 = 3 { name = "Cmos1"; desc = "CMOS1"; };
        };

        field {
            name = "vicap0_input_sel";
            desc = "VICAP0 input select";
            sw = rw;
            hw = r;
            encode = MISC_CTRL0_vicap0_input_sel_enum;
            reset = 0x0;
        } vicap0_input_sel[1:0];
    } MISC_CTRL0 @ 0x0;

    reg {
        name = "Peripheral function selection register 0";
        desc = "MISC_CTRL1 is peripheral function selection register 0.

Peripheral function selection 0: SSP2 chip-select, DMA request line sharing, USB 2.0 PHY control source, SPI chip-select polarity, BOOTROM/BOOTRAM power. The header reset is 0x0000_0003 but the rows add up to 0 (bits [1:0] are reserved in the rows): modelled as reserved_nz_1_0. The field name `Ssp2_cs_sel` is printed with a capital S in the data sheet; lower-cased here.

Data sheet 3.5.5.2 MISC_CTRL1 (offset 0x4, printed page 3-73, `hi3516av200--Hi3516AV200-Datasheet.txt` line 7940).";

        enum MISC_CTRL1_ssp2_cs_sel_enum {
            CS0 = 0 { name = "Cs0"; desc = "CS0"; };
            CS1 = 1 { name = "Cs1"; desc = "CS1"; };
            RESERVED_2 = 2 { name = "Reserved 2"; desc = "reserved (data sheet 1X)"; };
            RESERVED_3 = 3 { name = "Reserved 3"; desc = "reserved (data sheet 1X)"; };
        };

        field {
            name = "ssp2_cs_sel";
            desc = "SSP2 output CS select";
            sw = rw;
            hw = r;
            encode = MISC_CTRL1_ssp2_cs_sel_enum;
            reset = 0x0;
        } ssp2_cs_sel[27:26];

        enum MISC_CTRL1_dma_01_sel_enum {
            UART0_CONNECTS_DMA = 0 { name = "Uart0 Connects Dma"; desc = "UART0 connects to DMA hardware request lines 0 and 1."; };
            UART4_CONNECTS_DMA = 1 { name = "Uart4 Connects Dma"; desc = "UART4 connects to DMA hardware request lines 0 and 1."; };
        };

        field {
            name = "dma_01_sel";
            desc = "Connection select for the DMA hardware request lines 0 and 1";
