    reg {
        name = "PHY_SYNC_DCT_LINK";
        desc = "PHY_SYNC_DCT_LINK is thelink PHY sync header detection control register in LVDS mode. PHY_SYNC_DCT_LINK (offset 0x0024, total reset 0x0010_1101; PROVEN: Hi3516D V300 data sheet, PDF page 631, section 9.3.6).";
        field {
