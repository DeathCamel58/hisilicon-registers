            desc = "Type1 of the raw data to be transmitted in LVDS or HiSPI mode
- 001: 8-bit raw data
- 010: 10-bit raw data
- 011: 12-bit raw data
- 100: 14-bit raw data
- 101: 16-bit raw data

Other values: reserved";
            sw = rw; hw = r;
            reset = 0x1;
