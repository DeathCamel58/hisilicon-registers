`ifndef EHI3516DV300_MIPI_RX_RDL
`define EHI3516DV300_MIPI_RX_RDL
regfile eHI3516DV300_MIPI_RX {
    name = "MIPI RX";
    desc = "MIPI RX. 103 registers extracted programmatically from the Hi3516D V300 Professional Smart IP Camera SoC data sheet (Issue 01, 2019-09-12); chapter 9.3.6, table 9-11. Field names, bit ranges, access types and reset values are taken from the register tables; reset values are the data sheet total reset values split onto the fields (per-field values where the table has them). Label: PROVEN. Hardware not verified here (no board).";
    reg {
        name = "PHY_MODE_LINK";
        desc = "PHY_MODE_LINK is the link PHY operating mode register. PHY_MODE_LINK (offset 0x0000, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 626, section 9.3.6).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_26[31:26];
        field {
            name = "phy0_rg_mipi_mode1";
            desc = "MIPI/LVDS input mode select. When the PHY works in LVDS mode and the common voltage is greater than or equal to 1.2 V, this bit is set to 0.";
            sw = rw; hw = r;
            reset = 0x0;
        } phy0_rg_mipi_mode1[25:25];
        field {
            name = "phy0_rg_mipi_mode0";
            desc = "MIPI/LVDS input mode select. When the PHY works in LVDS mode and the common voltage is greater than or equal to 1.2 V, this bit is set to 0.
- 0: The common voltage is greater than or equal to 1.2 V.
- 1: The common voltage is less than 1.2 V.";
            sw = rw; hw = r;
            reset = 0x0;
        } phy0_rg_mipi_mode0[24:24];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_23_21[23:21];
        field {
            name = "phy0_rg_en_2l2l";
            desc = "Differential clock source select
- 0: A pair of differential clocks are input externally.
- 1: Two pairs of differential clocks are input externally.";
            sw = rw; hw = r;
            reset = 0x0;
        } phy0_rg_en_2l2l[20:20];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_19_18[19:18];
        field {
            name = "phy0_rg_faclk1_en";
            desc = "Phase of associated clock 1 for the PHY output data
- 0: Output data on the rising edge of the clock
- 1: Output data on the falling edge of the clock";
            sw = rw; hw = r;
            reset = 0x0;
        } phy0_rg_faclk1_en[17:17];
        field {
            name = "phy0_rg_faclk0_en";
            desc = "Phase of associated clock 0 for the PHY output data
- 0: Output data on the rising edge of the clock
- 1: Output data on the falling edge of the clock";
            sw = rw; hw = r;
            reset = 0x0;
        } phy0_rg_faclk0_en[16:16];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_15_14[15:14];
        field {
            name = "phy0_rg_en_lp1";
            desc = "PHY LP1 mode enable. The LP1 mode is enabled in MIPI mode and disabled in other modes.
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } phy0_rg_en_lp1[13:13];
        field {
            name = "phy0_rg_en_lp0";
            desc = "PHY LP0 mode enable. The LP0 mode is enabled in MIPI mode and disabled in other modes.
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } phy0_rg_en_lp0[12:12];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_11_9[11:9];
        field {
            name = "phy0_rg_en_cmos";
            desc = "PHY CMOS mode enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } phy0_rg_en_cmos[8:8];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_7_6[7:6];
        field {
            name = "phy0_rg_en_clk1";
            desc = "Clock lane 1 enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } phy0_rg_en_clk1[5:5];
        field {
            name = "phy0_rg_en_clk0";
            desc = "Clock lane 0 enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } phy0_rg_en_clk0[4:4];
        field {
            name = "phy0_rg_en_d";
