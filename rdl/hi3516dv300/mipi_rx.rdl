    reg {
        name = "PHY_SKEW_LINK";
        desc = "PHY_SKEW_LINK is the link PHY channel delay adjustment register. PHY_SKEW_LINK (offset 0x0004, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 628, section 9.3.6).";
        field {
