// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3516dv300-logic" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3516D V300: logic block diagram</B><BR/><FONT POINT-SIZE="11">redrawn from the data sheet logic block diagram (chapter 1); bus as in the vendor figure (AMBA 3.0)</FONT>>, fontcolor="#808080", rankdir=LR, compound=true, newrank=true];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  bus [label="AMBA 3.0 bus", fillcolor="#9a9a9a"  shape=box, height=5.2, width=0.5, fontcolor="white"];
  subgraph cluster_cpu { label="CPU subsystem"; fontcolor="#808080"; color="#808080"; style="rounded";
  cpu [label="dual Cortex-A7 @ 900 MHz\n32K I + 32K D L1, 256 KB L2\nNEON + FPU", fillcolor="#e0b86f"  ];
  }
  ddrc [label="DDRC", fillcolor="#8fb3de"  ];
  ddrext [label="32-bit DDR3(L) / DDR4\nup to 1800 Mbit/s", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  ddrext -> ddrc [dir=both]; ddrc -> cpu [dir=both]; ddrc -> bus [dir=both, style=dashed];
  subgraph cluster_l0 { label="Storage and network"; fontcolor="#808080"; color="#808080"; style="rounded";
    fmc [label="FMC (SPI NOR / SPI NAND)", fillcolor="#8fb3de"  ];
    mmc [label="SDIO0 / SDIO1 3.0, eMMC 4.5", fillcolor="#8fb3de"  ];
    eth [label="ETH (FEMAC) + FE PHY\nRMII, TSO", fillcolor="#8fb3de"  ];
    usb [label="USB 2.0\nhost / device", fillcolor="#8fb3de"  ];
    aio [label="AIAO (I2S) +\naudio codec", fillcolor="#8fb3de"  ];
  }
  fmc -> bus [dir=both];
  mmc -> bus [dir=both];
  eth -> bus [dir=both];
  usb -> bus [dir=both];
  aio -> bus [dir=both];
  subgraph cluster_l1 { label="Security"; fontcolor="#808080"; color="#808080"; style="rounded";
    sec [label="SPACC (AES/DES/3DES/HASH), RSA x2,\nTRNG, KLAD, OTP", fillcolor="#c9a0dc"  ];
  }
  sec -> bus [dir=both];
  subgraph cluster_r0 { label="Image subsystem"; fontcolor="#808080"; color="#808080"; style="rounded";
    vi [label="MIPI RX + VICAP + ISP\n(MIPI/LVDS/HiSPi, DC, BT.1120)", fillcolor="#a6c98f"  ];
    vpss [label="VIPROC + VPSS + VGS + GDC", fillcolor="#a6c98f"  ];
    vo [label="VDP: BT.656/1120, LCD,\nMIPI TX (DSI), HDMI 1.4", fillcolor="#a6c98f"  ];
  }
  bus -> vi [dir=both];
  bus -> vpss [dir=both];
  bus -> vo [dir=both];
  subgraph cluster_r1 { label="Video codec and AI"; fontcolor="#808080"; color="#808080"; style="rounded";
    vedu [label="VEDU (H.264 / H.265)", fillcolor="#a6c98f"  ];
    jpg [label="JPGE / JPGD", fillcolor="#a6c98f"  ];
    ai [label="NNIE + IVE + TDE + SCD + GZIP", fillcolor="#a6c98f"  ];
  }
  bus -> vedu [dir=both];
  bus -> jpg [dir=both];
  bus -> ai [dir=both];
  subgraph cluster_r2 { label="Low-speed peripherals"; fontcolor="#808080"; color="#808080"; style="rounded";
    lsp [label="UART x5, I2C x8, SPI x3 + 3-wire,\nGPIO, IR, PWM, LSADC x2, timers x8,\nWDG x2, RTC, PMC, DMAC (8 ch),\nSYS_CTRL, MISC, CRG", fillcolor="#7fcdc4"  ];
    rom [label="BOOTROM 64 KB window,\nSRAM 40 KB", fillcolor="#7fcdc4"  ];
  }
  bus -> lsp [dir=both];
  bus -> rom [dir=both];
  fl [label="SPI NOR / NAND,\neMMC", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  fl -> fmc [dir=both, style=dashed];
  fl -> mmc [dir=both, style=dashed];
  sd [label="SD card / Wi-Fi", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  sd -> mmc [dir=both, style=dashed];
  phy [label="RMII PHY (internal FE PHY)", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  phy -> eth [dir=both, style=dashed];
  usbp [label="USB port", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  usbp -> usb [dir=both, style=dashed];
  sens [label="2 CMOS sensors", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  vi -> sens [dir=both, style=dashed];
  disp [label="panel / HDMI / BT.1120", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  vo -> disp [dir=both, style=dashed];
  bus -> cpu [dir=both];
}
