// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3516dv300-power" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3516D V300: power control</B><BR/><FONT POINT-SIZE="11">data sheet 3.10: PMC in the always-on area; PWR_SEQ0/1 control the non-always-on supplies</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  rtc [label="RTC (always on)\n32.768 kHz, AVDD_BAT", fillcolor="#7fcdc4"  ];
  key [label="PWR_BUTTON (10 s = forced off), PWR_STARTUP,\nPWR_WAKEUP, RTC scheduled power-on", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  pmc [label="PMC 0x12090000\nwakeup polarity, sequence timing", fillcolor="#9aa7e6"  ];
  seq [label="PWR_SEQ0, PWR_SEQ1, PWR_EN, PWR_RSTN", fillcolor="#9aa7e6"  ];
  dcdc [label="DC/DC and LDO supplies", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  chip [label="SoC core and I/O supplies", fillcolor="#a6c98f"  ];
  key -> pmc;
  rtc -> pmc [label="clock"];
  pmc -> seq;
  seq -> dcdc;
  dcdc -> chip;
}
