// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3516dv300-io" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3516D V300: storage, USB and Ethernet paths</B><BR/><FONT POINT-SIZE="11">controller blocks with register bases and windows from data sheet Table 1-2</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  fmc [label="FMC 0x10000000\nwindow 0x14000000, 16 MB", fillcolor="#8fb3de"  ];
  emmc [label="eMMC 0x10100000 (4-bit)", fillcolor="#8fb3de"  ];
  sdio [label="SDIO0 0x100F0000, SDIO1 0x10020000", fillcolor="#8fb3de"  ];
  eth [label="ETH FEMAC 0x10010000\n+ internal FE PHY (RMII, TSO)", fillcolor="#8fb3de"  ];
  usb [label="USB ctrl 0x100E0000, PHY 0x10110000\nUSB 2.0 host/device", fillcolor="#8fb3de"  ];
  fl [label="SPI NOR / SPI NAND", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  em [label="eMMC", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  sd [label="SD card (SDIO0) / Wi-Fi (SDIO1)", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  phy [label="RJ45 transformer\n(or external RMII PHY)", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  port [label="USB 2.0 port", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  fmc -> fl;
  emmc -> em;
  sdio -> sd;
  eth -> phy;
  usb -> port;
}
