`ifndef EHI3516DV300_VDP_RDL
`define EHI3516DV300_VDP_RDL
regfile eHI3516DV300_VDP {
    name = "Video display processor (VDP)";
    desc = "Video display processor (VDP). 123 registers extracted programmatically from the Hi3516D V300 Professional Smart IP Camera SoC data sheet (Issue 01, 2019-09-12); chapter 9.2.6, table 9-5. Field names, bit ranges, access types and reset values are taken from the register tables; reset values are the data sheet total reset values split onto the fields (per-field values where the table has them). Label: PROVEN. Hardware not verified here (no board).";
    reg {
        name = "VOCTRL";
        desc = "VOCTRL is a VDP control register. VOCTRL (offset 0x0000, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 557, section 9.2.6).";
        field {
            name = "vo_ck_gt_en";
            desc = "VDP clock gating enable, that is, low power consumption mode
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } vo_ck_gt_en[31:31];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_30_0[30:0];
    } VOCTRL @ 0x0;
    reg {
        name = "VOINTSTA";
        desc = "VOINTSTA is a VDP interrupt status register. VOINTSTA (offset 0x0004, total reset 0x0000_0044; PROVEN: Hi3516D V300 data sheet, PDF page 557, section 9.2.6).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_4[31:4];
        field {
            name = "dhd0uf_int";
            desc = "HD0 low-bandwidth alarm interrupt
- 0: No interrupt is reported.
- 1: An interrupt is reported.";
            sw = r; hw = w;
            reset = 0x0;
        } dhd0uf_int[3:3];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x1;
        } reserved_2_2[2:2];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_1_1[1:1];
        field {
            name = "dhd0vtthd1_int";
            desc = "HD0 vertical timing interrupt 1
- 0: No interrupt is reported.
- 1: An interrupt is reported.";
            sw = r; hw = w;
            reset = 0x0;
        } dhd0vtthd1_int[0:0];
    } VOINTSTA @ 0x4;
    reg {
        name = "VOMSKINTSTA";
        desc = "VOMSKINTSTA is a VO masked interrupt status register. Writing 1 clears this register. VOMSKINTSTA (offset 0x0008, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 558, section 9.2.6).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_4[31:4];
        field {
            name = "dhd0uf_clr";
            desc = "HD0 low-bandwidth alarm interrupt
- 0: No interrupt is reported.
- 1: An interrupt is reported. (data sheet access type WC)";
            sw = rw; hw = r; onwrite = woclr;
            reset = 0x0;
        } dhd0uf_clr[3:3];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_2_2[2:2];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_1_1[1:1];
        field {
            name = "dhd0vtthd1_clr";
            desc = "HD0 vertical timing interrupt 1
- 0: No interrupt is reported.
- 1: An interrupt is reported. (data sheet access type WC)";
            sw = rw; hw = r; onwrite = woclr;
            reset = 0x0;
        } dhd0vtthd1_clr[0:0];
    } VOMSKINTSTA @ 0x8;
    reg {
        name = "VOINTMSK";
        desc = "VOINTMSK is a VDP interrupt mask register. It corresponds to VOINTSTA. When the corresponding bit is set to 1, the interrupt is enabled; when the corresponding bit is set to 0, the interrupt is masked. VOINTMSK (offset 0x000C, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 558, section 9.2.6).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_4[31:4];
        field {
            name = "dhd0uf_intmask";
            desc = "Mask for the HD0 low-bandwidth alarm";
            sw = rw; hw = r;
            reset = 0x0;
        } dhd0uf_intmask[3:3];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_2_2[2:2];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_1_1[1:1];
        field {
            name = "dhd0vtthd1_intmask";
            desc = "Mask for the HD0 vertical timing interrupt 1
- 0: masked
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } dhd0vtthd1_intmask[0:0];
    } VOINTMSK @ 0xc;
    reg {
        name = "VOINTSTA1";
        desc = "VOINTSTA1 is a VDP interrupt status register 1. VOINTSTA1 (offset 0x0014, total reset 0x0000_0044; PROVEN: Hi3516D V300 data sheet, PDF page 559, section 9.2.6).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_4[31:4];
        field {
            name = "dhd0uf_int";
            desc = "HD0 low-bandwidth alarm interrupt
- 0: No interrupt is reported.
- 1: An interrupt is reported.";
            sw = r; hw = w;
            reset = 0x0;
        } dhd0uf_int[3:3];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x1;
        } reserved_2_2[2:2];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_1_1[1:1];
        field {
            name = "dhd0vtthd1_int";
            desc = "HD0 vertical timing interrupt 1
- 0: No interrupt is reported.
- 1: An interrupt is reported.";
            sw = r; hw = w;
            reset = 0x0;
        } dhd0vtthd1_int[0:0];
    } VOINTSTA1 @ 0x14;
    reg {
        name = "VOMSKINTSTA1";
        desc = "VOMSKINTSTA1 is a VDP masked offline interrupt status register 1. Writing 1 clears this register. VOMSKINTSTA1 (offset 0x0018, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 559, section 9.2.6).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_4[31:4];
        field {
            name = "dhd0uf_clr";
            desc = "HD0 low-bandwidth alarm interrupt
- 0: No interrupt is reported.
- 1: An interrupt is reported. (data sheet access type WC)";
            sw = rw; hw = r; onwrite = woclr;
            reset = 0x0;
        } dhd0uf_clr[3:3];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_2_2[2:2];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_1_1[1:1];
        field {
            name = "dhd0vtthd1_clr";
            desc = "HD0 vertical timing interrupt 1
- 0: No interrupt is reported.
- 1: An interrupt is reported. (data sheet access type WC)";
            sw = rw; hw = r; onwrite = woclr;
            reset = 0x0;
        } dhd0vtthd1_clr[0:0];
    } VOMSKINTSTA1 @ 0x18;
    reg {
        name = "VOINTMSK1";
        desc = "VOINTMSK1 is a VDP interrupt mask register 1. It corresponds to VOINTSTA. VOINTMSK1 (offset 0x001C, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 560, section 9.2.6).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_4[31:4];
        field {
            name = "dhd0uf_intmask";
            desc = "Mask for the HD0 low-bandwidth alarm interrupt
- 0: masked
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } dhd0uf_intmask[3:3];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_2_2[2:2];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_1_1[1:1];
        field {
            name = "dhd0vtthd1_intmask";
            desc = "Mask for the HD0 vertical timing interrupt 1
- 0: masked
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } dhd0vtthd1_intmask[0:0];
    } VOINTMSK1 @ 0x1c;
    reg {
        name = "CBM_BKG1";
        desc = "CBM_BKG1 is a CBM mixer 1 overlay background color register. CBM_BKG1 (offset 0x0300, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 560, section 9.2.6).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_30[31:30];
        field {
            name = "cbm_bkgy1";
            desc = "Overlay background color of CBM mixer 1, Y component";
            sw = rw; hw = r;
            reset = 0x0;
        } cbm_bkgy1[29:20];
        field {
            name = "cbm_bkgcb1";
            desc = "Overlay background color of CBM mixer 1, Cb component";
            sw = rw; hw = r;
            reset = 0x0;
        } cbm_bkgcb1[19:10];
        field {
            name = "cbm_bkgcr1";
            desc = "Overlay background color of CBM mixer 1, Cr component";
            sw = rw; hw = r;
            reset = 0x0;
        } cbm_bkgcr1[9:0];
    } CBM_BKG1 @ 0x300;
    reg {
        name = "CBM_MIX1";
        desc = "CBM_MIX2 is a CBM mixer 1 priority configuration register (instant register). The register configuration takes effect only when the vsync signal is valid. mixer_prio_x is overlay layer priority x. CBM_MIX1 (offset 0x0308, total reset 0x0000_0001; PROVEN: Hi3516D V300 data sheet, PDF page 561, section 9.2.6).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_8[31:8];
        field {
            name = "mixer_prio1";
            desc = "Drive layer of CBM mixer 1 with priority 1
- 0x0: no drive layer
- 0x1: V0
- 0x2: G0

Other values: reserved";
            sw = rw; hw = r;
            reset = 0x0;
        } mixer_prio1[7:4];
        field {
            name = "mixer_prio0";
            desc = "Drive layer of CBM mixer 1 with priority 0
- 0x0: no drive layer
- 0x1: V0
- 0x2: G0

Other values: reserved";
            sw = rw; hw = r;
            reset = 0x1;
        } mixer_prio0[3:0];
    } CBM_MIX1 @ 0x308;
    reg {
        name = "V0_CTRL";
        desc = "V0_CTRL is a V0 configuration register (non-instant register). V0_CTRL (offset 0x1000, total reset 0x4000_00FF; PROVEN: Hi3516D V300 data sheet, PDF page 561, section 9.2.6).";
        field {
            name = "surface_en";
            desc = "Surface enable (non-instant)
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } surface_en[31:31];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x1;
        } reserved_30_30[30:30];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_29_8[29:8];
        field {
            name = "galpha";
            desc = "Overlay global alpha value. The value ranges from 0 to 255. The value 255 indicates opaque, and the value 0 indicates completely transparent.";
            sw = rw; hw = r;
            reset = 0xff;
        } galpha[7:0];
    } V0_CTRL @ 0x1000;
    reg {
        name = "V0_UPD";
        desc = "V0_UPD is a V0 channel update enable register. V0_UPD (offset 0x1004, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 562, section 9.2.6).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_1[31:1];
        field {
            name = "regup";
            desc = "Surface register update. After the registers at this layer are configured, the registers are updated when the value 1 is written to this bit. After the registers are updated, this bit is automatically cleared by the hardware. (data sheet access type WC)";
            sw = rw; hw = r; onwrite = woclr;
            reset = 0x0;
        } regup[0:0];
    } V0_UPD @ 0x1004;
    reg {
        name = "V0_0RESO_READ";
        desc = "V0_0RESO_READ is a V0 output resolution read register. V0_0RESO_READ (offset 0x1008, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 562, section 9.2.6).";
        field {
            name = "oh";
            desc = "Height (in lines). The configured value is the actual height minus 1. The frame height is referenced and its unit is line.";
            sw = r; hw = w;
            reset = 0x0;
        } oh[31:16];
        field {
            name = "ow";
            desc = "Width (in pixels). The configured value is the actual width minus 1. The frame width is referenced and its unit is column.";
            sw = r; hw = w;
            reset = 0x0;
        } ow[15:0];
    } V0_0RESO_READ @ 0x1008;
    reg {
        name = "V0_DFPOS";
        desc = "V0_DFPOS is a V0 surface first position (in the display window) register (non-instant register). The unit of the position is pixel. V0_DFPOS (offset 0x1080, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 562, section 9.2.6).";
        field {
            name = "disp_yfpos";
            desc = "Start coordinates of the display row The frame height is referenced and its unit is line.";
            sw = rw; hw = r;
            reset = 0x0;
        } disp_yfpos[31:16];
        field {
            name = "disp_xfpos";
            desc = "Start coordinates of the display column The frame width is referenced and its unit is column.";
            sw = rw; hw = r;
            reset = 0x0;
        } disp_xfpos[15:0];
    } V0_DFPOS @ 0x1080;
    reg {
        name = "V0_DLPOS";
        desc = "V0_DLPOS is a V0 surface last position (in the display window) register (non-instant register). The unit of the position is pixel. V0_DLPOS (offset 0x1084, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 563, section 9.2.6).";
        field {
            name = "disp_ylpos";
            desc = "End coordinates of the display row The frame height is referenced and its unit is line.";
            sw = rw; hw = r;
            reset = 0x0;
        } disp_ylpos[31:16];
        field {
            name = "disp_xlpos";
