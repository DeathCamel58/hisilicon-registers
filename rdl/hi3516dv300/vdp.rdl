        desc = "GFX_IRESO is an input resolution register (non-instant register). GFX_IRESO (offset 0x10E4C, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 602, section 9.2.6).";
        field {
            name = "ireso_h";
            desc = "Height (in lines). The configured value is the actual height minus 1. Note: The actual layer height must be an even number.";
            sw = rw; hw = r;
            reset = 0x0;
        } ireso_h[31:16];
        field {
            name = "ireso_w";
            desc = "Width (in pixels). The configured value is the actual width minus 1. Note: The actual layer width must be an even number.";
            sw = rw; hw = r;
            reset = 0x0;
        } ireso_w[15:0];
    } GFX_IRESO @ 0x10e4c;
    reg {
        name = "GFX_CKEY_MAX";
        desc = "GFX_CKEY_MAX is a maximum colorkey register (non-instant register). GFX_CKEY_MAX (offset 0x10F00, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 602, section 9.2.6).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_24[31:24];
        field {
            name = "key_r_max";
            desc = "Maximum value of the color key R component";
            sw = rw; hw = r;
            reset = 0x0;
        } key_r_max[23:16];
        field {
            name = "key_g_max";
            desc = "Maximum value of the color key G component";
            sw = rw; hw = r;
            reset = 0x0;
        } key_g_max[15:8];
        field {
            name = "key_b_max";
            desc = "Maximum value of the color key B component";
            sw = rw; hw = r;
            reset = 0x0;
        } key_b_max[7:0];
    } GFX_CKEY_MAX @ 0x10f00;
    reg {
        name = "GFX_CKEY_MIN";
        desc = "GFX_CKEY_MIN is a minimum colorkey register (non-instant register). GFX_CKEY_MIN (offset 0x10F04, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 602, section 9.2.6).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_24[31:24];
        field {
            name = "key_r_min";
            desc = "Minimum value of the color key R component";
            sw = rw; hw = r;
            reset = 0x0;
        } key_r_min[23:16];
        field {
            name = "key_g_min";
            desc = "Minimum value of the color key G component";
            sw = rw; hw = r;
            reset = 0x0;
        } key_g_min[15:8];
        field {
            name = "key_b_min";
            desc = "Minimum value of the color key B component";
            sw = rw; hw = r;
            reset = 0x0;
        } key_b_min[7:0];
    } GFX_CKEY_MIN @ 0x10f04;
    reg {
        name = "GFX_CKEY_MASK";
        desc = "GFX_CKEY_MASK is a masked colorkey register (non-instant register). The value 1 indicates that the bit corresponding to a pixel is retained during colorkey comparison; the value 0 indicates that the bit corresponding to a pixel is forcibly set to 0 during color comparison no matter whether the bit is 0 or 1. GFX_CKEY_MASK (offset 0x10F08, total reset 0x00FF_FFFF; PROVEN: Hi3516D V300 data sheet, PDF page 603, section 9.2.6).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_24[31:24];
        field {
            name = "key_r_msk";
            desc = "R component of the masked colorkey";
            sw = rw; hw = r;
            reset = 0xff;
        } key_r_msk[23:16];
        field {
            name = "key_g_msk";
            desc = "G component of the masked colorkey";
            sw = rw; hw = r;
            reset = 0xff;
        } key_g_msk[15:8];
        field {
            name = "key_b_msk";
            desc = "B component of the masked colorkey";
            sw = rw; hw = r;
            reset = 0xff;
        } key_b_msk[7:0];
    } GFX_CKEY_MASK @ 0x10f08;
};

`endif
