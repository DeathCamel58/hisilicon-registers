        desc = "V0_HIPP_CSC_COEF00 is CSC coefficient register 00. V0_HIPP_CSC_COEF00 (offset 0x1204, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 565, section 9.2.6).";
