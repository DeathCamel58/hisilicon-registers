        desc = "V0_VLPOS is a V0 surface content last position (in the display window) register (non-instant register). The unit of the position is pixel. V0_VLPOS (offset 0x108C, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 563, section 9.2.6).";
        field {
            name = "video_ylpos";
            desc = "End coordinates of the video row The frame height is referenced and its unit is line.";
            sw = rw; hw = r;
            reset = 0x0;
        } video_ylpos[31:16];
        field {
