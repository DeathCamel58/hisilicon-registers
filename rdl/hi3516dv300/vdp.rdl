            sw = rw; hw = r;
            reset = 0x0;
        } disp_xlpos[15:0];
    } V0_DLPOS @ 0x1084;
    reg {
        name = "V0_VFPOS";
        desc = "V0_VFPOS is a V0 surface content first position (in the display window) register (non-instant register). The unit of the position is pixel. V0_VFPOS (offset 0x1088, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 563, section 9.2.6).";
        field {
            name = "video_yfpos";
