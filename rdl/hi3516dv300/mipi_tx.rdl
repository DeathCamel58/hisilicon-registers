- 0: No interrupt is generated.
- 1: An interrupt is generated. (data sheet access type RC)";
            sw = r; hw = w; onread = rclr;
            reset = 0x0;
        } dphy_errors_2[18:18];
        field {
            name = "dphy_errors_1";
            desc = "LP data transmission synchronization interrupt. When the number of data bits is not a multiple of 8, an interrupt is generated. The bits are cleared when they are read.
- 0: No interrupt is generated.
- 1: An interrupt is generated. (data sheet access type RC)";
            sw = r; hw = w; onread = rclr;
            reset = 0x0;
        } dphy_errors_1[17:17];
        field {
            name = "dphy_errors_0";
