        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_2[31:2];
        field {
            name = "vcid";
            desc = "Configured value of the virtual channel ID";
            sw = rw; hw = r;
            reset = 0x0;
        } vcid[1:0];
    } VCID @ 0xc;
    reg {
        name = "COLOR_CODING";
        desc = "COLOR_CODING is the data format configuration register. COLOR_CODING (offset 0x0010, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 701, section 9.4.6).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_9[31:9];
        field {
            name = "loosely18_en";
