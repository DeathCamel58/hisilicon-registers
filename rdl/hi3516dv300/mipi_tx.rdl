        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_7_4[7:4];
        field {
            name = "color_coding";
            desc = "Data format configuration. 30-bit RGB and YCbCr formats are not supported in command mode.
- 0000: 16-bit DSI RGB
- 0001: 8-bit CSI YUV422
- 0010: 10-bit CSI YUV422
- 0011: 18-bit DSI RGB
- 0101: 24-bit DSI RGB
- 0110: 20-bit DSI YCbCr422
- 1000: 16-bit DSI YCbCr422
- 1001: 30-bit DSI RGB
- 1011: 12-bit DSI YCbCr420
- 1100: 8-bit CSI YCbCr420 legacy
- 1101: 8-bit CSI YCbCr420
- 1110: 10-bit CSI YCbCr420

Other values: reserved";
            sw = rw; hw = r;
            reset = 0x0;
        } color_coding[3:0];
    } COLOR_CODING @ 0x10;
