- 0: No interrupt is generated.
- 1: An interrupt is generated. (data sheet access type RC)";
            sw = r; hw = w; onread = rclr;
            reset = 0x0;
        } dphy_errors_3[19:19];
        field {
            name = "dphy_errors_2";
