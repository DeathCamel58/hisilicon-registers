`ifndef EHI3516DV300_MIPI_TX_RDL
`define EHI3516DV300_MIPI_TX_RDL
regfile eHI3516DV300_MIPI_TX {
    name = "MIPI TX";
    desc = "MIPI TX. 43 registers extracted programmatically from the Hi3516D V300 Professional Smart IP Camera SoC data sheet (Issue 01, 2019-09-12); chapter 9.4.6, table 9-12. Field names, bit ranges, access types and reset values are taken from the register tables; reset values are the data sheet total reset values split onto the fields (per-field values where the table has them). Label: PROVEN. Hardware not verified here (no board).";
    reg {
        name = "PWR_UP";
        desc = "PWR_UP is the reset register. PWR_UP (offset 0x0004, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 700, section 9.4.6).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_1[31:1];
        field {
            name = "pwr_up";
            desc = "Reset enable
- 0: reset
- 1: reset deasserted";
            sw = rw; hw = r;
            reset = 0x0;
        } pwr_up[0:0];
    } PWR_UP @ 0x4;
    reg {
        name = "CLKMGR_CFG";
        desc = "CLKMGR_CFG is the clock frequency division register. CLKMGR_CFG (offset 0x0008, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 701, section 9.4.6).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_8[31:8];
        field {
            name = "tx_esc_clk_division";
            desc = "TX escape clock divider. The clock source is HSCLK. No clock is generated when the value is configured to 0 and 1.";
            sw = rw; hw = r;
            reset = 0x0;
        } tx_esc_clk_division[7:0];
    } CLKMGR_CFG @ 0x8;
    reg {
        name = "VCID";
