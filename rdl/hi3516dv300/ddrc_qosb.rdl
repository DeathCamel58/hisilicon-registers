            sw = rw; hw = r;
            reset = 0x0;
        } wr_tout12[9:0];
    } QOSB_WRTOUT4 @ 0xac;
    reg {
        name = "QOSB_WRTOUT5";
        desc = "QOSB_WRTOUT5 is QoSBuf write command timeout period register 5. QOSB_WRTOUT5 (offset 0x0B0, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 310, section 4.1.7.2).";
        field {
