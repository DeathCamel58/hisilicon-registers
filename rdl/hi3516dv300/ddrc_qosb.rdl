        field {
            name = "wrtout_map0";
            desc = "There are 16 levels of timeout periods. Four bits are selected from the ID and the level is determined based on the four bits. wrtout_map0 indicates the position of bit";
            sw = rw; hw = r;
            reset = 0x0;
        } wrtout_map0[4:0];
    } QOSB_WRTOUT_MAP @ 0xbc;
    reg {
        name = "QOSB_RDTOUT_MAP";
        desc = "QOSB_RDTOUT_MAP is the QoSBuf read command timeout mapping mode control register. QOSB_RDTOUT_MAP (offset 0x0D0, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 311, section 4.1.7.2).";
        field {
            name = "reserved";
