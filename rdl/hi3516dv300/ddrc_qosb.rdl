        desc = "QOSB_CKG_CFG is the QoSBuf clock control register. QOSB_CKG_CFG (offset 0x108, total reset 0x0000_0001; PROVEN: Hi3516D V300 data sheet, PDF page 311, section 4.1.7.2).";
        field {
