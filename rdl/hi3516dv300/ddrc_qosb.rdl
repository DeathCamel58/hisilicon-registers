- 0: The clock is always enabled.
- 1: The clock gating is automatic when the module is idle.";
            sw = rw; hw = r;
            reset = 0x1;
        } dyn_ck_gate[0:0];
    } QOSB_CKG_CFG @ 0x108;
    reg {
        name = "QOSB_DMC_LVL";
        desc = "QOSB_DMC_LVL is the QoSBuf threshold control register for commands that enter the DMC module. QOSB_DMC_LVL (offset 0x10C + 0x4 x chans, total reset 0x0000_000F; PROVEN: Hi3516D V300 data sheet, PDF page 312, section 4.1.7.2). Per-instance register (offset = 0x10C + 0x4 x chans); the first instance is modelled.";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_5[31:5];
        field {
            name = "dmc_cmd_full_lvl";
            desc = "Number of QoSBuf commands that enter the DMC module. When this threshold is reached, the DMC queue is full. When this field is set to N, the actual number of commands that enter the DMC module is (N + 1) because of the pipeline issue. This register cannot be dynamically configured when it is being accessed.";
            sw = rw; hw = r;
            reset = 0xf;
        } dmc_cmd_full_lvl[4:0];
    } QOSB_DMC_LVL @ 0x10c;
    reg {
