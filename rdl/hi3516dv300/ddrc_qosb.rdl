    } QOSB_WRTOUT3 @ 0xa8;
    reg {
        name = "QOSB_WRTOUT4";
        desc = "QOSB_WRTOUT4 is QoSBuf write command timeout period register 4. QOSB_WRTOUT4 (offset 0x0AC, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 309, section 4.1.7.2).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_30[31:30];
        field {
            name = "wr_tout14";
            desc = "Write command timeout period (level 14) The configuration mode is the same as that of wr_tout0.";
            sw = rw; hw = r;
            reset = 0x0;
        } wr_tout14[29:20];
        field {
            name = "wr_tout13";
            desc = "Write command timeout period (level 13) The configuration mode is the same as that of wr_tout0.";
            sw = rw; hw = r;
