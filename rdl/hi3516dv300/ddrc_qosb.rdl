`ifndef EHI3516DV300_DDRC_QOSB_RDL
`define EHI3516DV300_DDRC_QOSB_RDL
regfile eHI3516DV300_DDRC_QOSB {
    name = "DDRC QoS buffer";
    desc = "DDRC QoS buffer. 29 registers extracted programmatically from the Hi3516D V300 Professional Smart IP Camera SoC data sheet (Issue 01, 2019-09-12); chapter 4.1.7, table 4-8. Field names, bit ranges, access types and reset values are taken from the register tables; reset values are the data sheet total reset values split onto the fields (per-field values where the table has them). Label: PROVEN. Hardware not verified here (no board).";
    reg {
        name = "QOSB_ADPT_CTRL";
        desc = "QOSB_ADPT_CTRL is the QoSBuf adaptation configuration register. QOSB_ADPT_CTRL (offset 0x004, total reset 0x0000_0FF0; PROVEN: Hi3516D V300 data sheet, PDF page 306, section 4.1.7.2).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_20[31:20];
        field {
            name = "adpt_share_cnt";
            desc = "Adapt counter for lower bits. When the value of this counter decreases to 0, the counter for upper bits corresponding to each CMD decreases by 1.";
            sw = rw; hw = r;
            reset = 0xff;
        } adpt_share_cnt[19:4];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_3_3[3:3];
        field {
            name = "adpt_pri_lmt";
            desc = "Adaptivity priority control when the adapt function is enabled
- 0: The command priority can adapt to the second-highest priority when the adapt function is enabled.
- 1: The command priority can adapt to the highest priority when the adapt function is enabled.";
            sw = rw; hw = r;
            reset = 0x0;
        } adpt_pri_lmt[2:2];
        field {
            name = "wr_adpt_en";
            desc = "Write command adapt enable
- 0: The write command adapt function takes effect only when the write command is pushed by the read command.
- 1: The write command adapt function takes effect without the write command being pushed by the read command.";
            sw = rw; hw = r;
            reset = 0x0;
        } wr_adpt_en[1:1];
        field {
            name = "adpt_en";
            desc = "Adapt enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } adpt_en[0:0];
    } QOSB_ADPT_CTRL @ 0x4;
    reg {
        name = "QOSB_BUF_BYP";
        desc = "QOSB_BUF_BYP is the QoSBuf bypass control register. QOSB_BUF_BYP (offset 0x088, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 306, section 4.1.7.2).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_2[31:2];
        field {
            name = "qos_buf_byp";
            desc = "QoSBuf bypass control x0: forcible non-bypass mode. That is, all the";
            sw = rw; hw = r;
            reset = 0x0;
        } qos_buf_byp[1:0];
    } QOSB_BUF_BYP @ 0x88;
    reg {
        name = "QOSB_WRTOUT0";
        desc = "QOSB_WRTOUT0 is QoSBuf write command timeout period register 0. QOSB_WRTOUT0 (offset 0x09C, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 307, section 4.1.7.2).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_30[31:30];
        field {
            name = "wr_tout2";
            desc = "Write command timeout period (level 2)
- 0x0: The timeout function is disabled. 0x01–0xFF: (n x 4) clock cycles

When the timeout period is set to 10 bits, the actual count value is 12 bits. That is, the lower two bits are fixed at 0.";
            sw = rw; hw = r;
            reset = 0x0;
        } wr_tout2[29:20];
        field {
            name = "wr_tout1";
            desc = "Write command timeout period (level 1)
- 0x0: The timeout function is disabled. 0x01–0xFF: (n x 4) clock cycles

When the timeout period is set to 10 bits, the actual count value is 12 bits. That is, the lower two bits are fixed at 0.";
            sw = rw; hw = r;
            reset = 0x0;
        } wr_tout1[19:10];
        field {
            name = "wr_tout0";
            desc = "Write command timeout period (level 0)
- 0x0: The timeout function is disabled. 0x01–0xFF: (n x 4) clock cycles

When the timeout period is set to 10 bits, the actual count value is 12 bits. That is, the lower two bits are fixed at 0.";
            sw = rw; hw = r;
            reset = 0x0;
        } wr_tout0[9:0];
    } QOSB_WRTOUT0 @ 0x9c;
    reg {
        name = "QOSB_WRTOUT1";
        desc = "QOSB_WRTOUT1 is QoSBuf write command timeout period register 1. QOSB_WRTOUT1 (offset 0x0A0, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 308, section 4.1.7.2).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_30[31:30];
        field {
            name = "wr_tout5";
            desc = "Write command timeout period (level 5)
- 0x0: The timeout function is disabled. 0x01–0xFF: (n x 4) clock cycles

When the timeout period is set to 10 bits, the actual count value is 12 bits. That is, the lower two bits are fixed at 0.";
            sw = rw; hw = r;
            reset = 0x0;
        } wr_tout5[29:20];
        field {
            name = "wr_tout4";
            desc = "Write command timeout period (level 4)
- 0x0: The timeout function is disabled. 0x01–0xFF: (n x 4) clock cycles

When the timeout period is set to 10 bits, the actual count value is 12 bits. That is, the lower two bits are fixed at 0.";
            sw = rw; hw = r;
            reset = 0x0;
        } wr_tout4[19:10];
        field {
            name = "wr_tout3";
            desc = "Write command timeout period (level 3)
- 0x0: The timeout function is disabled. 0x01–0xFF: (n x 4) clock cycles

When the timeout period is set to 10 bits, the actual count value is 12 bits. That is, the lower two bits are fixed at 0.";
            sw = rw; hw = r;
            reset = 0x0;
        } wr_tout3[9:0];
    } QOSB_WRTOUT1 @ 0xa0;
    reg {
        name = "QOSB_WRTOUT2";
        desc = "QOSB_WRTOUT2 is QoSBuf write command timeout period register 2. QOSB_WRTOUT2 (offset 0x0A4, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 308, section 4.1.7.2).";
        field {
            name = "reserved";
