        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_7_4[7:4];
        field {
            name = "RG_HSTX_CKG_SEL";
            desc = "Frequency division multiple 0xx: The frequency is divided by 1 when the data rate ranges from 750 Mbit/s to 1000 Mbit/s.
- 100: The frequency is divided by 2 when the data rate ranges from 375 Mbit/s to 750

Mbit/s.
- 101: The frequency is divided by 4 when the data rate ranges from 188 Mbit/s to 375

Mbit/s.
- 110: The frequency is divided by 8 when the data rate ranges from 94 Mbit/s to 188 Mbit/s.
- 111: The frequency is divided by 16 when the data rate ranges from 47 Mbit/s to 94 Mbit/s.";
            sw = rw; hw = r;
            reset = 0x7;
        } RG_HSTX_CKG_SEL[3:1];
        field {
