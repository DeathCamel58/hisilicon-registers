        desc = "PRE_DELAY_D3HS is the HS valid delay configuration register for data lane 3. PRE_DELAY_D3HS (offset 0x58, total reset 0x10; PROVEN: Hi3516D V300 data sheet, PDF page 739, section 9.4.8).";
        field {
            name = "pre_delay_d3hs";
            desc = "Delay duration from the txrequesths_lane3 validity to the time when data lane 3 enters the HS mode, in hsclk cycles";
            sw = rw; hw = r;
            reset = 0x10;
        } pre_delay_d3hs[7:0];
