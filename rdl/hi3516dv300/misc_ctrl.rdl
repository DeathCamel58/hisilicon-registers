`ifndef EHI3516DV300_MISC_CTRL_RDL
`define EHI3516DV300_MISC_CTRL_RDL
regfile eHI3516DV300_MISC_CTRL {
    name = "MISC control registers";
    desc = "MISC control registers. 55 registers extracted programmatically from the Hi3516D V300 Professional Smart IP Camera SoC data sheet (Issue 01, 2019-09-12); chapter 3.5.5, table 3-8. Field names, bit ranges, access types and reset values are taken from the register tables; reset values are the data sheet total reset values split onto the fields (per-field values where the table has them). Label: PROVEN. Hardware not verified here (no board).";
    reg {
        name = "MISC_CTRL0";
        desc = "MISC_CTRL0 is MSIC function select register 0. MISC_CTRL0 (offset 0x0000, total reset 0x0000_2000; PROVEN: Hi3516D V300 data sheet, PDF page 155, section 3.5.5).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_20[31:20];
        field {
            name = "test_clk_sel";
            desc = "Test clock source select
- 0x0: pll_test_out[0]
- 0x1: pll_test_out[1]
- 0x2: pll_test_out[2]
- 0x3: pll_test_out[3]
- 0x4: clk_24m
- 0x5: audiocodec_mclk
- 0x6: usb_phy_clk
- 0x7: mipitx_phy_lanebyte_clk
- 0x8: hdmitx_phy_tmds_clk
- 0x9: rtc_clk_out

Other values: reserved";
            sw = rw; hw = r;
            reset = 0x0;
        } test_clk_sel[19:16];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_15_15[15:15];
        field {
            name = "jtag_on_sdio";
            desc = "JTAG signal multiplexing to the SDIO0 interface
- 0: The JTAG signal is multiplexed to the

JTAG_* pin.
- 1: The JTAG signal is multiplexed to the

SDIO0_* pin.";
            sw = rw; hw = r;
            reset = 0x0;
        } jtag_on_sdio[14:14];
        field {
            name = "vgs_bootram_mode";
            desc = "Enable of multiplexing the RAM of the VGS module as the BootRAM. Set this bit to 1 if the BootRAM is required, and set it to 0 if the VGS function is used.
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x1;
        } vgs_bootram_mode[13:13];
        field {
            name = "emmc_fix_bypass";
            desc = "Logic enable for fixing the bug that the eMMC controller card cannot be identified
- 0: enabled
- 1: disabled";
            sw = rw; hw = r;
            reset = 0x0;
        } emmc_fix_bypass[12:12];
        field {
            name = "sdio1_fix_bypass";
            desc = "Logic enable for fixing the bug that the SDIO1 controller card cannot be identified
- 0: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } sdio1_fix_bypass[11:11];
        field {
            name = "sdio1_pd_mux_bypass";
            desc = "Logic enable for fixing the bug that the SDIO1 controller card turns powered down
- 0: enabled
- 1: disabled";
            sw = rw; hw = r;
            reset = 0x0;
        } sdio1_pd_mux_bypass[10:10];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_9_7[9:7];
        field {
            name = "sdio0_carddetect_pol";
            desc = "Polarity control for the SDIO0 card detection signal
- 0: active low
- 1: active high";
            sw = rw; hw = r;
            reset = 0x0;
        } sdio0_carddetect_pol[6:6];
        field {
            name = "spi2_cs_pctrl";
            desc = "Polarity control of SPI2 chip select (CS)
- 0: active low
- 1: active high";
            sw = rw; hw = r;
            reset = 0x0;
        } spi2_cs_pctrl[5:5];
        field {
            name = "spi1_cs1_pctrl";
            desc = "Polarity control of SPI1 CS1
- 0: active low
- 1: active high";
            sw = rw; hw = r;
            reset = 0x0;
        } spi1_cs1_pctrl[4:4];
        field {
            name = "spi1_cs0_pctrl";
            desc = "Polarity control of SPI1 CS0
- 0: active low
- 1: active high";
            sw = rw; hw = r;
            reset = 0x0;
        } spi1_cs0_pctrl[3:3];
        field {
            name = "ssp1_cs_sel";
            desc = "CS select for the SPI1 signal output
- 0: SPI1_CSN0
- 1: SPI1_CSN1";
            sw = rw; hw = r;
            reset = 0x0;
        } ssp1_cs_sel[2:2];
        field {
            name = "spi_3wire_cs_pctrl";
            desc = "Polarity control of 3-wire SPI CS
- 0: active low
- 1: active high";
            sw = rw; hw = r;
            reset = 0x0;
        } spi_3wire_cs_pctrl[1:1];
        field {
            name = "spi0_cs_pctrl";
            desc = "Polarity control of SPI0 CS
- 0: active low
- 1: active high";
            sw = rw; hw = r;
            reset = 0x0;
        } spi0_cs_pctrl[0:0];
    } MISC_CTRL0 @ 0x0;
    reg {
        name = "MISC_CTRL1";
        desc = "MISC_CTRL1 is MISC function selection register 1. MISC_CTRL1 (offset 0x0004, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 156, section 3.5.5).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_3[31:3];
        field {
            name = "sdio0_pswitch_ctrl_s";
            desc = "Control select of the SDIO0 power switch";
            sw = rw; hw = r;
            reset = 0x0;
        } sdio0_pswitch_ctrl_s[2:2];
        field {
            name = "sdio0_pswitch_sel";
            desc = "Output voltage select of the SDIO0 power switch
- 0: 3.3 V
- 1: 1.8 V";
            sw = rw; hw = r;
            reset = 0x0;
        } sdio0_pswitch_sel[1:1];
        field {
            name = "sdio0_pswitch_en";
            desc = "SDIO0 power switch enable
- 0: disabled
- 1: enabled

The control is valid only when sdio0_pswitch_ctrl_sel is set to 1.";
            sw = rw; hw = r;
            reset = 0x0;
        } sdio0_pswitch_en[0:0];
    } MISC_CTRL1 @ 0x4;
    reg {
        name = "MISC_CTRL3";
        desc = "MISC_CTRL3 is CPU control register 1. MISC_CTRL3 (offset 0x000C, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 157, section 3.5.5).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_7[31:7];
        field {
            name = "a7_smpnamp";
            desc = "Symmetric multiprocessing (SMP) mode or asymmetric multiprocessing (AMP) mode indictor of Cortex-A7 Core 0 or Core 1 a7_smpnamp[0] indicates Core 0, and a7_smpnamp[1] indicates Core 1.
- 0: AMP mode
- 1: SMP mode";
            sw = r; hw = w;
            reset = 0x0;
        } a7_smpnamp[6:5];
        field {
            name = "a7_standbywfi_l2";
            desc = "WFI low-power state indicator of Cortex-A7 L2
- 0: not in the WFI low-power state
- 1: in the WFI low-power state";
            sw = r; hw = w;
            reset = 0x0;
        } a7_standbywfi_l2[4:4];
        field {
            name = "a7_standbywfi";
            desc = "WFI low-power state indicator of Cortex-A7 Core 0 or Core 1 a7_standbywfi[0] indicates the WFI state of Core 0, and a7_standbywfi[1] indicates the WFI state of Core 1.
- 0: not in the WFI low-power state
- 1: in the WFI low-power state";
            sw = r; hw = w;
            reset = 0x0;
        } a7_standbywfi[3:2];
        field {
            name = "a7_standbywfe";
            desc = "WFE low-power state indicator of Cortex-A7 Core 0 or Core 1 a7_standbywfe[0] indicates the WFE state of Core 0, and a7_standbywfe[1] indicates the";
            sw = r; hw = w;
            reset = 0x0;
        } a7_standbywfe[1:0];
    } MISC_CTRL3 @ 0xc;
    reg {
        name = "MISC_CTRL4";
        desc = "MISC_CTRL4 is RAM retention control register 0. MISC_CTRL4 (offset 0x0010, total reset 0x0000_000D; PROVEN: Hi3516D V300 data sheet, PDF page 158, section 3.5.5).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_4[31:4];
        field {
            name = "gzip_ram_clk_gate_en_bypass";
            desc = "RAM automatic clock gating control of the GZIP module
- 0: enabled
- 1: disabled. The RAM clock in the GZIP is always enabled.";
            sw = rw; hw = r;
            reset = 0x1;
        } gzip_ram_clk_gate_en_bypass[3:3];
        field {
            name = "vedu_ret1n_bypass";
            desc = "Automatic RAM retention function control of the VEDU module
- 0: enabled
- 1: disabled";
            sw = rw; hw = r;
            reset = 0x1;
        } vedu_ret1n_bypass[2:2];
        field {
            name = "bootrom_pgen";
            desc = "BootROM power supply control
- 0: powered up
- 1: powered down. In this case, the BootROM cannot work.";
            sw = rw; hw = r;
            reset = 0x0;
        } bootrom_pgen[1:1];
        field {
            name = "spacc_ret1n";
            desc = "RAM retention control of SPACC
- 0: SPACC RAM is in retention state.
- 1: SPACC RAM is in active state.

When the SPACC controller is disabled, set this bit to 0 to save power consumption.";
            sw = rw; hw = r;
            reset = 0x1;
        } spacc_ret1n[0:0];
    } MISC_CTRL4 @ 0x10;
    reg {
        name = "MISC_CTRL6";
        desc = "MISC_CTRL6 is VICAP or VDP mode control register 1. MISC_CTRL6 (offset 0x0018, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 158, section 3.5.5).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_12[31:12];
        field {
            name = "vo_pdata_reverse";
            desc = "Bit inversion enable for the VDP parallel output
- 0: disabled";
            sw = rw; hw = r;
            reset = 0x0;
        } vo_pdata_reverse[11:11];
        field {
            name = "vo_pdata_mode";
            desc = "Mode select for the VDP parallel output
- 000: Parallel 24 bits of LCD data
- 001: Parallel 18 bits of LCD data
- 010: Parallel 16 bits of LCD data
- 011: Serial 8 bits of LCD data
- 100: Serial 6 bits of LCD data
- 101: BT.1120 mode
- 110: BT.656 mode

Other values: reserved";
            sw = rw; hw = r;
            reset = 0x0;
        } vo_pdata_mode[10:8];
        field {
            name = "viproc_vpss_online_mode";
            desc = "Operating mode select of the VIPROC-VPSS data channel
- 0: offline mode
- 1: online mode";
            sw = rw; hw = r;
            reset = 0x0;
        } viproc_vpss_online_mode[7:7];
        field {
            name = "vicap_viproc_online_mode";
            desc = "Operating mode select of the VICAP-VIPROC data channel
- 0: offline mode
- 1: online mode";
            sw = rw; hw = r;
            reset = 0x0;
        } vicap_viproc_online_mode[6:6];
        field {
            name = "vi_port1_input_sel";
            desc = "Video source select of VICAP port 1
- 0: MIPI channel 1
- 1: CMOS input";
            sw = rw; hw = r;
            reset = 0x0;
        } vi_port1_input_sel[5:5];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_4_4[4:4];
        field {
            name = "mipirx1_work_mode";
            desc = "Mode select of MIPI RX channel 1
- 0: MIPI mode
- 1: LVDS mode";
            sw = rw; hw = r;
            reset = 0x0;
        } mipirx1_work_mode[3:2];
        field {
            name = "mipirx0_work_mode";
            desc = "Mode select of MIPI RX channel 0
- 0: MIPI mode
- 1: LVDS mode";
            sw = rw; hw = r;
            reset = 0x0;
        } mipirx0_work_mode[1:0];
    } MISC_CTRL6 @ 0x18;
    reg {
        name = "MISC_CTRL8";
        desc = "MISC_CTRL8 is USB 2.0 control register 0. MISC_CTRL8 (offset 0x0020, total reset 0x0004_00DF; PROVEN: Hi3516D V300 data sheet, PDF page 159, section 3.5.5).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_19[31:19];
        field {
            name = "usb2_fladj_30mhz_r";
            desc = "Horizontal synchronization (HS) clock jitter";
            sw = rw; hw = r;
            reset = 0x20;
        } usb2_fladj_30mhz_r[18:13];
        field {
            name = "usb2_dbg_addr";
            desc = "USB debug address";
            sw = rw; hw = r;
            reset = 0x0;
        } usb2_dbg_addr[12:9];
        field {
            name = "usb2_hub_port_perm_attach";
            desc = "Device attaching mode of the USB port
- 0: The device attached to the USB port is removable.
- 1: The device attached to the USB port is irremovable.";
            sw = rw; hw = r;
            reset = 0x0;
        } usb2_hub_port_perm_attach[8:8];
        field {
            name = "usb2_port_ovrcur_pol";
            desc = "Overcurrent protection polarity control of the USB port
- 0: active low
- 1: active high";
            sw = rw; hw = r;
            reset = 0x1;
        } usb2_port_ovrcur_pol[7:7];
        field {
            name = "usb2_port_pwren_pol";
            desc = "Power enable polarity control of the USB port
- 0: active low
- 1: active high";
            sw = rw; hw = r;
            reset = 0x1;
        } usb2_port_pwren_pol[6:6];
        field {
            name = "usb2_port_ovrcur_ctrl_en";
            desc = "Overcurrent protection enable of the USB port
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } usb2_port_ovrcur_ctrl_en[5:5];
        field {
            name = "usb2_port_pwr_ctrl_en";
            desc = "USB power supply enable
- 0: disabled
- 1: enabled (output by the USB 2.0 controller)";
            sw = rw; hw = r;
            reset = 0x1;
        } usb2_port_pwr_ctrl_en[4:4];
        field {
            name = "usb2_bus_filter_bypass";
            desc = "USB 2.0 bus filter bypass. These bits must be set to 4'b1111.";
            sw = rw; hw = r;
            reset = 0xf;
        } usb2_bus_filter_bypass[3:0];
    } MISC_CTRL8 @ 0x20;
    reg {
        name = "MISC_CTRL10";
        desc = "MISC_CTRL10 is DDR_CA control register 0. MISC_CTRL10 (offset 0x0028, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 160, section 3.5.5).";
        field {
            name = "ddrca_random_l";
            desc = "Bits 31:0 of the random value of the DDR CA function";
            sw = rw; hw = r;
            reset = 0x0;
        } ddrca_random_l[31:0];
    } MISC_CTRL10 @ 0x28;
    reg {
        name = "MISC_CTRL11";
        desc = "MISC_CTRL11 is DDR_CA control register 1. MISC_CTRL11 (offset 0x002C, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 160, section 3.5.5).";
        field {
            name = "ddrca_random_h";
            desc = "Bits 63:32 of the random value of the DDR CA function";
            sw = rw; hw = r;
            reset = 0x0;
        } ddrca_random_h[31:0];
    } MISC_CTRL11 @ 0x2c;
    reg {
        name = "MISC_CTRL12";
        desc = "MISC_CTRL12 is DDR_CA control register 2. MISC_CTRL12 (offset 0x0030, total reset 0x0000_0005; PROVEN: Hi3516D V300 data sheet, PDF page 161, section 3.5.5).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_5[31:5];
        field {
            name = "ddrca_update";
            desc = "Load enable of the DDR scrambling function. When this register changes from 0 to 1, the ddrca_en and ddrca_random parameters are loaded to the DDR controller.";
            sw = rw; hw = r;
            reset = 0x0;
        } ddrca_update[4:4];
        field {
            name = "ddrca_en";
            desc = "Mode of the DDR scrambling function
- 0x0: The MDDRCA function is enabled.
- 0x1: The output data is all 0s.
- 0x3: The output data is all 1s.
- 0x5: The MDDRCA function is bypassed.
- 0xD: The output data is all 1s.

Other values: reserved";
            sw = rw; hw = r;
            reset = 0x5;
        } ddrca_en[3:0];
    } MISC_CTRL12 @ 0x30;
    reg {
        name = "MISC_CTRL14";
        desc = "MISC_CTRL14 is bus priority control register 0. MISC_CTRL14 (offset 0x0038, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 161, section 3.5.5).";
        field {
            name = "syscfg_timeout_en_m2";
            desc = "Timeout count enable of the SYSCFG bus M2 port
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } syscfg_timeout_en_m2[31:31];
        field {
            name = "syscfg_timeout_value_m2";
            desc = "Timeout count value of the SYSCFG bus M2 port Count value = syscfg_timeout_value_m2 x 2";
            sw = rw; hw = r;
            reset = 0x0;
        } syscfg_timeout_value_m2[30:16];
        field {
            name = "syscfg_timeout_en_m1";
            desc = "Timeout count enable of the SYSCFG bus M1 port
- 0: disabled";
            sw = rw; hw = r;
            reset = 0x0;
        } syscfg_timeout_en_m1[15:15];
        field {
            name = "syscfg_timeout_value_m1";
            desc = "Timeout count value of the SYSCFG bus M1 port Count value = syscfg_timeout_value_m1 x 2";
            sw = rw; hw = r;
            reset = 0x0;
        } syscfg_timeout_value_m1[14:0];
    } MISC_CTRL14 @ 0x38;
    reg {
        name = "MISC_CTRL15";
        desc = "MISC_CTRL15 is bus priority control register 1. MISC_CTRL15 (offset 0x003C, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 162, section 3.5.5).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_31[31:31];
        field {
            name = "syscfg_priority_s6";
            desc = "Bus access priority of the SYSCFG bus S6 port The value 7 indicates the highest priority.";
            sw = rw; hw = r;
            reset = 0x0;
        } syscfg_priority_s6[30:28];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_27_27[27:27];
        field {
            name = "syscfg_priority_s5";
            desc = "Bus access priority of the SYSCFG bus S5 port The value 7 indicates the highest priority.";
            sw = rw; hw = r;
            reset = 0x0;
        } syscfg_priority_s5[26:24];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_23_23[23:23];
        field {
            name = "syscfg_priority_s4";
            desc = "Bus access priority of the SYSCFG bus S4 port The value 7 indicates the highest priority.";
            sw = rw; hw = r;
            reset = 0x0;
        } syscfg_priority_s4[22:20];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_19_19[19:19];
        field {
            name = "syscfg_priority_s3";
            desc = "Bus access priority of the SYSCFG bus S3 port The value 7 indicates the highest priority.";
            sw = rw; hw = r;
            reset = 0x0;
        } syscfg_priority_s3[18:16];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_15_15[15:15];
        field {
            name = "syscfg_priority_s2";
            desc = "Bus access priority of the SYSCFG bus S2 port The value 7 indicates the highest priority.";
            sw = rw; hw = r;
            reset = 0x0;
        } syscfg_priority_s2[14:12];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_11_11[11:11];
        field {
            name = "syscfg_priority_s1";
            desc = "Bus access priority of the SYSCFG bus S1 port The value 7 indicates the highest priority.";
            sw = rw; hw = r;
            reset = 0x0;
        } syscfg_priority_s1[10:8];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_7_7[7:7];
        field {
            name = "syscfg_port1_pri_in";
            desc = "Priority of the SYSCFG bus M2 port The value 7 indicates the highest priority.";
            sw = rw; hw = r;
            reset = 0x0;
        } syscfg_port1_pri_in[6:4];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_3_3[3:3];
        field {
            name = "syscfg_port0_pri_in";
            desc = "Priority of the SYSCFG bus M1 port The value 7 indicates the highest priority.";
            sw = rw; hw = r;
            reset = 0x0;
        } syscfg_port0_pri_in[2:0];
    } MISC_CTRL15 @ 0x3c;
    reg {
        name = "MISC_CTRL16";
        desc = "MISC_CTRL16 is bus priority control register 2. MISC_CTRL16 (offset 0x0040, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 163, section 3.5.5).";
        field {
            name = "sysdata_timeout_en_m2";
            desc = "Timeout count enable of the SYSDATA bus M2 port
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } sysdata_timeout_en_m2[31:31];
        field {
            name = "sysdata_timeout_value_m2";
            desc = "Timeout count value of the SYSDATA bus M2 port Count value = sysdata_timeout_value_m2 x 2";
            sw = rw; hw = r;
            reset = 0x0;
        } sysdata_timeout_value_m2[30:16];
        field {
            name = "sysdata_timeout_en_m1";
            desc = "Timeout count enable of the SYSDATA bus M1 port
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } sysdata_timeout_en_m1[15:15];
        field {
            name = "sysdata_timeout_value_m1";
            desc = "Timeout count of the SYSDATA bus M1 port Count value = sysdata_timeout_value_m1 x 2";
            sw = rw; hw = r;
            reset = 0x0;
        } sysdata_timeout_value_m1[14:0];
    } MISC_CTRL16 @ 0x40;
    reg {
        name = "MISC_CTRL17";
        desc = "MISC_CTRL17 is bus priority control register 4. MISC_CTRL17 (offset 0x0044, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 163, section 3.5.5).";
        field {
            name = "reserved";
            desc = "Reserved";
