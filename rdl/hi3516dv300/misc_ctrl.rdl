- 1: non-secure access";
            sw = rw; hw = r;
            reset = 0x0;
        } ive_mst_w_sec_acc[0:0];
    } MISC_CTRL62 @ 0x114;
    reg {
        name = "MISC_CTRL63";
        desc = "MISC_CTRL63 is secure access control register 5. MISC_CTRL63 (offset 0x0118, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 194, section 3.5.5).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_2[31:2];
        field {
            name = "a7_cp15sdisable";
            desc = "Disabling modification of some CPU CP15 registers, active high";
            sw = rw; hw = r;
            reset = 0x0;
        } a7_cp15sdisable[1:0];
    } MISC_CTRL63 @ 0x118;
};

`endif
