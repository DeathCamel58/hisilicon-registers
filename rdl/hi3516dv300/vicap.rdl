`ifndef EHI3516DV300_VICAP_RDL
`define EHI3516DV300_VICAP_RDL
regfile eHI3516DV300_VICAP {
    name = "Video capture (VICAP)";
    desc = "Video capture (VICAP). 90 registers extracted programmatically from the Hi3516D V300 Professional Smart IP Camera SoC data sheet (Issue 01, 2019-09-12); chapter 9.1.6, table 9-4. Field names, bit ranges, access types and reset values are taken from the register tables; reset values are the data sheet total reset values split onto the fields (per-field values where the table has them). Label: PROVEN. Hardware not verified here (no board).";
    reg {
        name = "WK_MODE";
        desc = "WK_MODE is the global operating mode configuration register. WK_MODE (offset 0x0000, total reset 0x0000_0003; PROVEN: Hi3516D V300 data sheet, PDF page 506, section 9.1.6).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_2[31:2];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x1;
        } reserved_1_1[1:1];
        field {
            name = "power_mode";
            desc = "Clock mode
- 0: The low-power mode is disabled.";
            sw = rw; hw = r;
            reset = 0x1;
        } power_mode[0:0];
    } WK_MODE @ 0x0;
    reg {
        name = "AXI_CFG";
