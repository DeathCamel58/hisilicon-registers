            sw = r; hw = na;
            reset = 0x0;
        } reserved_8_8[8:8];
        field {
            name = "VREF_EXMODE";
            desc = "This bit takes effect when PD_VREF is set to 1.
- 0: Power-down (PD) is normal.
- 1: The external VREF is supported.";
            sw = rw; hw = r;
            reset = 0x0;
        } VREF_EXMODE[7:7];
        field {
            name = "POP_RAMPCLK_SEL";
            desc = "Working clock of the popramp circuit
- 00: 48 kHz
- 01: 24 kHz
- 10: 12 kHz";
            sw = rw; hw = r;
            reset = 0x0;
        } POP_RAMPCLK_SEL[6:5];
        field {
            name = "POP_RES_SEL";
            desc = "Resistance between the popfree circuit and main output
- 00: 100 ohms
- 01: 1 kohm
- 10: 10 kohms
- 11: 100 kohms";
            sw = rw; hw = r;
            reset = 0x0;
        } POP_RES_SEL[4:3];
        field {
            name = "DACL_POP_DIRECT";
            desc = "Ramp direction of the left-channel DAC POP circuit
- 0: The POP circuit connects to the GND through a pull-down resistor.
- 1: The POP circuit connects to the VCM through a pull-up resistor.";
            sw = rw; hw = r;
            reset = 0x0;
        } DACL_POP_DIRECT[2:2];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
