            reset = 0x1;
        } ADC_CHOP_CLK_SEL_09[5:4];
        field {
            name = "ADC_CHOP_CLK_PHSEL_09";
            desc = "Chop clock phase select for the ADC module
- 0: same phase as the ADC working clock
- 1: reverse phase of the ADC working clock";
            sw = rw; hw = r;
            reset = 0x1;
        } ADC_CHOP_CLK_PHSEL_09[3:3];
        field {
            name = "ADC_THE_CLK_PHSEL_09";
            desc = "Thermometer code output phase select for the ADC module
- 0: same phase as the ADC working clock
- 1: reverse phase of the ADC working clock";
            sw = rw; hw = r;
            reset = 0x1;
        } ADC_THE_CLK_PHSEL_09[2:2];
        field {
            name = "ADC_BIN_CLK_PHSEL_09";
            desc = "Binary code output phase select for the ADC module
- 0: same phase as the ADC working clock
- 1: reverse phase of the ADC working clock";
            sw = rw; hw = r;
            reset = 0x0;
        } ADC_BIN_CLK_PHSEL_09[1:1];
        field {
            name = "ADC_DWA_BPS_09";
            desc = "ADC DWA module enable
- 0: enabled
- 1: disabled";
