        } reserved_31_16[31:16];
        field {
            name = "ADC_TUNE_09";
            desc = "Control code of the integral capacitance in the ADC. The code value is related to the corner of R and C.
- 0101: Both R and C values are tt corner.
- 1100: Both R and C values are ff corner.
- 0000: Both R and C values are ss corner.

Other values: reserved";
            sw = rw; hw = r;
            reset = 0x1;
        } ADC_TUNE_09[15:12];
        field {
            name = "ADC_TUNE_EN_09";
            desc = "ADC RC coefficient correction circuit working enable
- 0: The RC correction module is disabled.
- 1: The RC correction module starts to work.";
