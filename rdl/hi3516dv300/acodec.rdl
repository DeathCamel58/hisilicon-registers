`ifndef EHI3516DV300_ACODEC_RDL
`define EHI3516DV300_ACODEC_RDL
regfile eHI3516DV300_ACODEC {
    name = "Audio codec";
    desc = "Audio codec. 10 registers extracted programmatically from the Hi3516D V300 Professional Smart IP Camera SoC data sheet (Issue 01, 2019-09-12); chapter 11.2.4, table 11-2. Field names, bit ranges, access types and reset values are taken from the register tables; reset values are the data sheet total reset values split onto the fields (per-field values where the table has them). Label: PROVEN. Hardware not verified here (no board).";
    reg {
        name = "AUDIO_ANA_CTRL_0";
        desc = "AUDIO_ANA_CTRL_0 corresponds to AudioCodec analog registers 0–3. AUDIO_ANA_CTRL_0 (offset 0x0014, total reset 0x0405_78E1; PROVEN: Hi3516D V300 data sheet, PDF page 796, section 11.2.4).";
        field {
            name = "IBADJ_CTCM";
            desc = "Bias current of CTCM, MICBIAS, and LINEIN
- 0: 5 µA (recommended)
- 1: 10 µA";
            sw = rw; hw = r;
            reset = 0x0;
        } IBADJ_CTCM[31:31];
        field {
            name = "SEL_CLK_CHOP_LINEOUT_D";
            desc = "Chopper clock frequency select in lineout differential mode
- 00: 96 kHz
- 01: 192 kHz
- 10: 384 kHz
- 11: 768 kHz";
            sw = rw; hw = r;
            reset = 0x0;
        } SEL_CLK_CHOP_LINEOUT_D[30:29];
        field {
            name = "CTRL_CLK_DAC_PH";
            desc = "DAC working clock edge select (master clock frequency divided by 2)
- 0: rising edge
- 1: falling edge";
            sw = rw; hw = r;
            reset = 0x0;
        } CTRL_CLK_DAC_PH[28:28];
        field {
            name = "IBADJ_DAC";
            desc = "DAC bias current
- 00: 3 µA
- 01: 5 µA (recommended)
- 10: 7 µA";
            sw = rw; hw = r;
            reset = 0x1;
        } IBADJ_DAC[27:26];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_25_24[25:24];
        field {
            name = "SEL_CLK_CHOP_DAC_VREF";
            desc = "DAC VREF chopper clock frequency select
- 00: 96 kHz
- 01: 192 kHz
- 10: 384 kHz
- 11: 768 kHz";
            sw = rw; hw = r;
            reset = 0x0;
        } SEL_CLK_CHOP_DAC_VREF[23:22];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_21_21[21:21];
        field {
            name = "BYP_CHOP_DAC_VREF";
            desc = "DAC_VREF chopper enable
- 0: enabled
- 1: disabled";
            sw = rw; hw = r;
            reset = 0x0;
        } BYP_CHOP_DAC_VREF[20:20];
        field {
            name = "ANA_LOOP";
            desc = "Analog loopback enable control
- 0: normal mode (passing through the digital codec)
- 1: direct analog loopback from the analog

ADC to analog DAC";
            sw = rw; hw = r;
            reset = 0x0;
        } ANA_LOOP[19:19];
        field {
            name = "DACL_POP_EN";
            desc = "Left-channel POP circuit enable control
- 0: The pop tone removal function is disabled.
- 1: The pop tone removal function is enabled.

Note: DACR_POP_EN is set to 1 only when the POP process is suppressed during power- on and power-off. When the DAC channel works properly, DACR_POP_EN needs to be set to 0.";
            sw = rw; hw = r;
            reset = 0x1;
        } DACL_POP_EN[18:18];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_17_17[17:17];
        field {
            name = "DACR_POP_EN";
            desc = "Right-channel POP circuit enable control
- 0: The pop tone removal function is disabled.
- 1: The pop tone removal function is enabled.

Note: DACR_POP_EN is set to 1 only when the POP process is suppressed during power- on and power-off. When the DAC channel works properly, DACR_POP_EN needs to be set to 0.";
            sw = rw; hw = r;
            reset = 0x1;
        } DACR_POP_EN[16:16];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_15_15[15:15];
        field {
            name = "MUTE_DACR";
            desc = "Mute control for the right-channel DAC
- 0: The DAC works normally.
- 1: The analog circuit is muted.";
            sw = rw; hw = r;
            reset = 0x1;
        } MUTE_DACR[14:14];
        field {
            name = "MUTE_DACL";
            desc = "Mute control for the left-channel DAC
- 0: The DAC works normally.";
            sw = rw; hw = r;
            reset = 0x1;
        } MUTE_DACL[13:13];
        field {
            name = "PD_DACR";
            desc = "Power-on/off control for the right-channel DAC
- 0: The DAC works normally.
- 1: The DAC is powered off.";
            sw = rw; hw = r;
            reset = 0x1;
        } PD_DACR[12:12];
        field {
            name = "PD_DACL";
            desc = "Power-on/off control for the left-channel DAC
- 0: The DAC works normally.
- 1: The DAC is powered off.";
            sw = rw; hw = r;
            reset = 0x1;
        } PD_DACL[11:11];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = rw; hw = r;
            reset = 0x0;
        } reserved_10_10[10:10];
        field {
            name = "PA_DACR_DFF";
            desc = "Power-on/off control for the right-channel DAC trigger
- 0: The DAC works normally.
- 1: The DAC is powered off.";
            sw = rw; hw = r;
            reset = 0x0;
        } PA_DACR_DFF[9:9];
        field {
            name = "PA_DACL_DFF";
            desc = "Power-on/off control for the left-channel DAC trigger
- 0: The DAC works normally.
- 1: The DAC is powered off.";
            sw = rw; hw = r;
            reset = 0x0;
        } PA_DACL_DFF[8:8];
        field {
            name = "PD_MICBIAS2";
            desc = "MICBIAS2 power-on/off control
- 0: The MICBIAS2 works normally.
- 1: The MICBIAS2 is powered off.";
            sw = rw; hw = r;
            reset = 0x1;
        } PD_MICBIAS2[7:7];
        field {
            name = "PD_IBIAS";
            desc = "Power-on/off control for the ADC RC coefficient correction circuit
- 0: The ADC RC coefficient correction circuit works normally.
- 1: The ADC RC coefficient correction circuit is powered off.";
            sw = rw; hw = r;
            reset = 0x1;
        } PD_IBIAS[6:6];
        field {
            name = "PD_MICBIAS1";
            desc = "MICBIAS1 power-on/off control
- 0: The MICBIAS1 works normally.
- 1: The MICBIAS1 is powered off.";
            sw = rw; hw = r;
            reset = 0x1;
        } PD_MICBIAS1[5:5];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_4_2[4:2];
        field {
            name = "PDB_CTCM_IBIAS";
            desc = "CTCM_BUFFER bias current switch control
- 0: There is no external bias current.
- 1: The bias current is normal.";
            sw = rw; hw = r;
            reset = 0x0;
        } PDB_CTCM_IBIAS[1:1];
        field {
            name = "PD_VREF";
            desc = "VREF power-on/off control
- 0: The VREF works normally.
- 1: The VREF is powered off.";
            sw = rw; hw = r;
            reset = 0x1;
        } PD_VREF[0:0];
    } AUDIO_ANA_CTRL_0 @ 0x14;
    reg {
        name = "AUDIO_ANA_CTRL_1";
        desc = "AUDIO_ANA_CTRL_1 corresponds to AudioCodec analog registers 4–7. AUDIO_ANA_CTRL_1 (offset 0x0018, total reset 0x1102_0004; PROVEN: Hi3516D V300 data sheet, PDF page 799, section 11.2.4).";
        field {
            name = "ADC_DAC_RL_MIS_SELN";
            desc = "ADC feedback DAC load resistance select control (negative end)
- 0000: The load resistance increases by 15%.
- 0001: The load resistance increases by 14%.
- 0010: The load resistance increases by 13%.
- 0011: The load resistance increases by 12%.
- 0100: The load resistance increases by 11%.
- 0101: The load resistance increases by 10%.
- 0110: The load resistance increases by 9%.
- 0111: The load resistance increases by 8%.
- 1000: The load resistance increases by 7%.
- 1001: The load resistance increases by 6%.
- 1010: The load resistance increases by 5%.
- 1011: The load resistance increases by 4%.
- 1100: The load resistance increases by 3%.
- 1101: The load resistance increases by 2%.
- 1110: The load resistance increases by 1%.
- 1111: The load resistance remains unchanged.";
            sw = rw; hw = r;
            reset = 0x1;
        } ADC_DAC_RL_MIS_SELN[31:28];
        field {
            name = "ADC_DAC_RL_MIS_SELP";
            desc = "ADC feedback DAC load resistance select control (positive end)
- 0000: The load resistance increases by 15%.
- 0001: The load resistance increases by 14%.
- 0010: The load resistance increases by 13%.
- 0011: The load resistance increases by 12%.
- 0100: The load resistance increases by 11%.
- 0101: The load resistance increases by 10%.
- 0110: The load resistance increases by 9%.
- 0111: The load resistance increases by 8%.
- 1000: The load resistance increases by 7%.
- 1001: The load resistance increases by 6%.
- 1010: The load resistance increases by 5%.
- 1011: The load resistance increases by 4%.
- 1100: The load resistance increases by 3%.
- 1101: The load resistance increases by 2%.
- 1110: The load resistance increases by 1%.
- 1111: The load resistance remains unchanged.";
            sw = rw; hw = r;
            reset = 0x1;
        } ADC_DAC_RL_MIS_SELP[27:24];
        field {
            name = "LPGA_BOOST";
            desc = "Left-channel ADC boost enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } LPGA_BOOST[23:23];
        field {
            name = "RPGA_BOOST";
            desc = "Right-channel ADC boost enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } RPGA_BOOST[22:22];
        field {
            name = "ADC_DAC_IB_SEL";
            desc = "Feedback DAC current adjustment in the ADC
- 00: Reference resistance R = 90% x Rf
- 01: Reference resistance R = 95% x Rf
- 10: Reference resistance R = 100% x Rf
- 11: Reference resistance R = 105% x Rf";
            sw = rw; hw = r;
            reset = 0x0;
        } ADC_DAC_IB_SEL[21:20];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = rw; hw = r;
            reset = 0x0;
        } reserved_19_18[19:18];
        field {
            name = "RX_CTCM_PD";
            desc = "Power-on/off control of the uplink channel CTCM_BUFFER
- 0: The CTCM_BUFFER works normally.
- 1: The CTCM_BUFFER is powered off.";
            sw = rw; hw = r;
            reset = 0x1;
        } RX_CTCM_PD[17:17];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_16_16[16:16];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_15_15[15:15];
        field {
            name = "PGA_RIN_MAN_EN";
            desc = "Enable signal for manually controlling the input resistance to float or connect to the common-mode voltage for the unselected channels of the LINEIN module
- 0: The manual control mode is disabled.
- 1: The manual control module is enabled.";
            sw = rw; hw = r;
            reset = 0x0;
        } PGA_RIN_MAN_EN[14:14];
        field {
            name = "PGA_RIN_MAN_FLOAT";
            desc = "When PGA_RIN_MAN_EN is high, this register is valid. It enables the pull-down I/O resistance of the six channels of the LINEIN module to float or connect to the common- mode voltage.
- 0: The common-mode voltage is connected.
- 1: The pull-down I/O resistance is floated.";
            sw = rw; hw = r;
            reset = 0x0;
        } PGA_RIN_MAN_FLOAT[13:8];
        field {
            name = "CTRL_MCLK_PH";
            desc = "IP working clock edge select
- 0: falling edge of the master clock
- 1: rising edge of the master clock";
            sw = rw; hw = r;
            reset = 0x0;
        } CTRL_MCLK_PH[7:7];
        field {
            name = "CTRL_CLK_ADCDAC_PH";
            desc = "Working clock edge select for the feedback DAC in the ADC
- 0: rising edge of the master clock of the feedback DAC
- 1: falling edge of the master clock of the";
            sw = rw; hw = r;
            reset = 0x0;
        } CTRL_CLK_ADCDAC_PH[6:6];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_5_4[5:4];
        field {
            name = "IBADJ_ADC";
            desc = "ADC bias current
- 00: 3 µA
- 01: 5 µA (recommended)
- 10: 7 µA
- 11: 10 µA";
            sw = rw; hw = r;
            reset = 0x1;
        } IBADJ_ADC[3:2];
        field {
            name = "SEL_CLK_CHOP_CTCM";
            desc = "CTCM buffer chopper clock frequency select
- 0: 96 kHz
- 1: 192 kHz";
            sw = rw; hw = r;
            reset = 0x0;
        } SEL_CLK_CHOP_CTCM[1:1];
        field {
            name = "BYP_CHOP_CTCM";
            desc = "CTCM buffer chopper enable
- 0: enabled
- 1: disabled";
            sw = rw; hw = r;
            reset = 0x0;
        } BYP_CHOP_CTCM[0:0];
    } AUDIO_ANA_CTRL_1 @ 0x18;
    reg {
        name = "AUDIO_ANA_CTRL_2";
        desc = "AUDIO_ANA_CTRL_2 corresponds to AudioCodec analog registers 8–11. AUDIO_ANA_CTRL_2 (offset 0x001c, total reset 0x40C0_0013; PROVEN: Hi3516D V300 data sheet, PDF page 801, section 11.2.4).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_31[31:31];
        field {
            name = "PD_CTCM";
            desc = "Power-on/off control for the downstream CTCM
- 0: The downstream CTCM works properly.
- 1: The downstream CTCM is powered off.";
            sw = rw; hw = r;
            reset = 0x1;
        } PD_CTCM[30:30];
        field {
            name = "MICBIAS2_ADJ";
            desc = "MICBIAS2 output voltage select
- 000: 2.1 V
- 001: 2.2 V
- 010: 2.3 V
- 011: 2.4 V …
- 110: 2.7 V
- 111: 2.8 V";
            sw = rw; hw = r;
            reset = 0x0;
        } MICBIAS2_ADJ[29:27];
        field {
            name = "MICBIAS1_ADJ";
            desc = "MICBIAS1 output voltage select
- 000: 2.1 V
- 001: 2.2 V
- 010: 2.3 V";
            sw = rw; hw = r;
            reset = 0x0;
        } MICBIAS1_ADJ[26:24];
        field {
            name = "RST";
            desc = "Analog global reset signal of the codec
- 0: normal working
- 1: reset";
            sw = rw; hw = r;
            reset = 0x1;
        } RST[23:23];
        field {
            name = "VREF_SEL";
            desc = "VREF startup time control
- 00000: 0.38s …
- 00100: 1.543s …
- 11111: 10.7s";
            sw = rw; hw = r;
            reset = 0x10;
        } VREF_SEL[22:18];
        field {
            name = "VREF_FS";
            desc = "VREF power-on speed control
- 0: The VREF is powered on at a normal speed.
- 1: The VREF is powered on quickly.";
            sw = rw; hw = r;
            reset = 0x0;
        } VREF_FS[17:17];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_16_16[16:16];
        field {
            name = "BYP_CHOPPER_LINEIN";
            desc = "Input PGA chopper enable
- 0: enabled
- 1: disabled";
            sw = rw; hw = r;
            reset = 0x0;
        } BYP_CHOPPER_LINEIN[15:15];
        field {
            name = "BYP_CHOPPER_ADC";
            desc = "Chopper enable for the ADC integrator operational amplifier
- 0: enabled
- 1: disabled";
            sw = rw; hw = r;
            reset = 0x0;
        } BYP_CHOPPER_ADC[14:14];
        field {
            name = "BYP_CHOP_CTCM_RX";
            desc = "Upstream CTCM chopper enable
- 0: enabled
- 1: disabled";
            sw = rw; hw = r;
            reset = 0x0;
        } BYP_CHOP_CTCM_RX[13:13];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = rw; hw = r;
            reset = 0x0;
        } reserved_12_8[12:8];
        field {
            name = "ADCL_MODE_SEL";
            desc = "ADCL mode select
- 0: 6.144 MHz sampling rate
- 1: 4.096 MHz sampling rate";
            sw = rw; hw = r;
            reset = 0x0;
        } ADCL_MODE_SEL[7:7];
        field {
            name = "ADCR_MODE_SEL";
            desc = "ADCR mode select
- 0: 6.144 MHz sampling rate
- 1: 4.096 MHz sampling rate";
            sw = rw; hw = r;
            reset = 0x0;
        } ADCR_MODE_SEL[6:6];
        field {
            name = "ADC_VREF";
            desc = "Flash ADC reference voltage select for the ADC module
- 00: 0.5333 V";
            sw = rw; hw = r;
            reset = 0x1;
        } ADC_VREF[5:4];
        field {
            name = "LDO_SEL";
            desc = "LDO output voltage select
- 00: 1.0 V
- 01: 0.95 V
- 10: 0.9 V (recommended)
- 11: 0.85 V";
            sw = rw; hw = r;
            reset = 0x0;
        } LDO_SEL[3:2];
        field {
            name = "LDO_EN_BK";
            desc = "Backup reference voltage generation circuit (direct power voltage divider) enable for the LDO module
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x1;
        } LDO_EN_BK[1:1];
        field {
            name = "LDO_PD";
            desc = "LDO power-on/off control
- 0: The LDO module works normally.
- 1: The LDO module is powered off.";
            sw = rw; hw = r;
            reset = 0x1;
        } LDO_PD[0:0];
    } AUDIO_ANA_CTRL_2 @ 0x1c;
    reg {
        name = "AUDIO_ANA_CTRL_3";
        desc = "AUDIO_ANA_CTRL_3 corresponds to AudioCodec analog registers 12–15. AUDIO_ANA_CTRL_3 (offset 0x0020, total reset 0x1111_FE00; PROVEN: Hi3516D V300 data sheet, PDF page 803, section 11.2.4).";
        field {
            name = "RPGA_SEL_09";
            desc = "Right-channel input PGA channel select
- 000: MIC differential input
- 001: MIC_R input
- 010: MIC_L input
- 011: LINEIN_R input
- 100: LINEIN_L input
- 101: LINEIN differential input

Other values: reserved";
            sw = rw; hw = r;
            reset = 0x0;
        } RPGA_SEL_09[31:29];
        field {
            name = "RPGA_GAIN_09";
            desc = "Right-channel input PGA gain select
- 00000: 0 dB
- 00001: 2 dB
- 00010: 4 dB
- 00011: 6 dB
- 00100: 8 dB
- 00101: 10 dB";
            sw = rw; hw = r;
            reset = 0x11;
        } RPGA_GAIN_09[28:24];
        field {
            name = "LPGA_SEL_09";
            desc = "Left-channel input PGA channel select
- 000: MIC differential input
- 001: MIC_L input
- 010: MIC_R input
- 011: LINEIN_R input
- 100: LINEIN_L input
- 101: LINEIN differential input

Other values: reserved";
            sw = rw; hw = r;
            reset = 0x0;
        } LPGA_SEL_09[23:21];
        field {
            name = "LPGA_GAIN_09";
            desc = "Left-channel input PGA gain select
- 00000: 0 dB
- 00001: 2 dB
- 00010: 4 dB
- 00011: 6 dB
- 00100: 8 dB
- 00101: 10 dB
- 00110: 12 dB
- 00111: 14 dB
- 01000: 16 dB
- 01001: 18 dB
- 01010: 20 dB
- 01011: 22 dB
- 01100: 24 dB
- 01101: 26 dB
- 01110: 28 dB
- 01111: 30 dB
- 10000: –1.6 dB

Other values: reserved";
            sw = rw; hw = r;
            reset = 0x11;
        } LPGA_GAIN_09[20:16];
        field {
            name = "ADCL_PD_09";
            desc = "Power-on/off control for the left-channel ADC
- 0: The left-channel ADC works normally.
- 1: The left-channel ADC is powered off.";
            sw = rw; hw = r;
            reset = 0x1;
        } ADCL_PD_09[15:15];
        field {
            name = "ADCR_PD_09";
            desc = "Power-on/off control for the right-channel ADC
- 0: The right-channel ADC works normally.
- 1: The right-channel ADC is powered off.";
            sw = rw; hw = r;
            reset = 0x1;
        } ADCR_PD_09[14:14];
        field {
            name = "LPGA_PD_09";
            desc = "Power-on/off control for the left-channel input PGA
