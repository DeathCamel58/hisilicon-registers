        } dacl_mute[31:31];
        field {
            name = "dacl_vol";
            desc = "DACL digital volume control, which is not recommended. You are advised to use the digital volume adjustment function in the AIAO to control the digital volume output. The volume is calculated as follows: (6 − dacl_vol) dB When dacl_vol is 0x7F, the DACL is muted.
- 0x00: 6 dB
- 0x01: 5 dB
- 0x02: 4 dB …
- 0x7E: –120 dB
- 0x7F: muted";
