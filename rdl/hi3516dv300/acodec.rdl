            reset = 0x1;
        } PGA_CHOP_CLK_SEL_09[7:6];
        field {
            name = "ADC_CHOP_CLK_SEL_09";
            desc = "Chop clock frequency select for the ADC module
- 00: 48 kHz
- 01: 96 kHz
- 10: 192 kHz
- 11: 384 kHz";
