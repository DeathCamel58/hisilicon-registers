- 0: The POP circuit connects to the GND through a pull-down resistor.
- 1: The POP circuit connects to the VCM through a pull-up resistor.";
            sw = rw; hw = r;
            reset = 0x0;
        } DACR_POP_DIRECT[0:0];
    } AUDIO_ANA_CTRL_3 @ 0x20;
    reg {
        name = "AUDIO_ANA_CTRL_4";
        desc = "AUDIO_ANA_CTRL_4 corresponds to AudioCodec analog registers 16–19. AUDIO_ANA_CTRL_4 (offset 0x0024, total reset 0x0000_105C; PROVEN: Hi3516D V300 data sheet, PDF page 806, section 11.2.4).";
        field {
