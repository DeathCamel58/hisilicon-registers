            reset = 0x0;
        } ADC_DWA_BPS_09[0:0];
    } AUDIO_ANA_CTRL_4 @ 0x24;
    reg {
        name = "AUDIO_CTRL_REG_1";
        desc = "AUDIO_CTRL_REG_1 is AudioCodec control register 1. AUDIO_CTRL_REG_1 (offset 0x0030, total reset 0x00F3_5A4A; PROVEN: Hi3516D V300 data sheet, PDF page 808, section 11.2.4).";
        field {
