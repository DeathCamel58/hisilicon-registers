`ifndef EHI3516DV300_USB_RDL
`define EHI3516DV300_USB_RDL
regfile eHI3516DV300_USB {
    name = "USB controller (DWC3-class)";
    desc = "USB controller (DWC3-class). 42 registers extracted programmatically from the Hi3516D V300 Professional Smart IP Camera SoC data sheet (Issue 01, 2019-09-12); chapter 12.8.7, table 12-30. Field names, bit ranges, access types and reset values are taken from the register tables; reset values are the data sheet total reset values split onto the fields (per-field values where the table has them). Label: PROVEN. Hardware not verified here (no board).";
    reg {
        name = "PERI_USB2_GSBUSCFG0";
        desc = "PERI_USB2_GSBUSCFG0 is global SoC bus configuration register 0. PERI_USB2_GSBUSCFG0 (offset 0xC100, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 971, section 12.8.7).";
        field {
            name = "datrdreqinfo";
            desc = "AHB-prot/AXI-cache/OCP-ReqInfo Data read request";
            sw = rw; hw = r;
            reset = 0x0;
        } datrdreqinfo[31:28];
        field {
            name = "desrdreqinfo";
            desc = "AHB-prot/AXI-cache/OCP-ReqInfo Linked list read request";
            sw = rw; hw = r;
            reset = 0x0;
        } desrdreqinfo[27:24];
        field {
            name = "datwrreqinfo";
            desc = "AHB-prot/AXI-cache/OCP-ReqInfo Data write request";
            sw = rw; hw = r;
            reset = 0x0;
        } datwrreqinfo[23:20];
        field {
            name = "deswrreqinfo";
            desc = "AHB-prot/AXI-cache/OCP-ReqInfo Linked list write request";
            sw = rw; hw = r;
            reset = 0x0;
        } deswrreqinfo[19:16];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = rw; hw = r;
            reset = 0x0;
        } reserved_15_12[15:12];
        field {
            name = "datbigend";
            desc = "Endian mode for accessing data
- 0: little endian
- 1: big endian";
            sw = rw; hw = r;
            reset = 0x0;
        } datbigend[11:11];
        field {
            name = "descbigend";
            desc = "Endian mode for accessing the linked list
- 0: little endian
- 1: big endian";
            sw = rw; hw = r;
            reset = 0x0;
        } descbigend[10:10];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_9_8[9:8];
        field {
            name = "incr256brstena";
            desc = "256-beat burst transfer enable for the AHB master INCR
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } incr256brstena[7:7];
        field {
            name = "incr128brstena";
            desc = "128-beat burst transfer enable for the AHB master INCR
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } incr128brstena[6:6];
        field {
            name = "incr64brstena";
            desc = "64-beat burst transfer enable for the AHB master INCR
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } incr64brstena[5:5];
        field {
            name = "incr32brstena";
            desc = "32-beat burst transfer enable for the AHB master INCR
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } incr32brstena[4:4];
        field {
            name = "incr16brstena";
            desc = "16-beat burst transfer enable for the AHB master INCR
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } incr16brstena[3:3];
        field {
            name = "incr8brstena";
            desc = "8-beat burst transfer enable for the AHB";
            sw = rw; hw = r;
            reset = 0x0;
        } incr8brstena[2:2];
        field {
            name = "incr4brstena";
            desc = "4-beat burst transfer enable for the AHB master INCR
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } incr4brstena[1:1];
        field {
            name = "incrbrstena";
            desc = "1-beat burst transfer enable for the AHB master INCR
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } incrbrstena[0:0];
    } PERI_USB2_GSBUSCFG0 @ 0xc100;
    reg {
        name = "PERI_USB2_GSBUSCFG1";
        desc = "PERI_USB2_GSBUSCFG1 is global SoC bus configuration register 1. PERI_USB2_GSBUSCFG1 (offset 0xC104, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 973, section 12.8.7).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_13[31:13];
        field {
            name = "en1kpage";
            desc = "1 KB boundary select
- 0: 4 KB boundary
- 1: 1 KB boundary";
            sw = rw; hw = r;
            reset = 0x0;
        } en1kpage[12:12];
        field {
            name = "pipetranslimit";
            desc = "Number of AXI master outstanding requests
- 0x0: 1 request
- 0x1: 2 requests
- 0x2: 3 requests
- 0x3: 4 requests ...
- 0xF: 16 requests";
            sw = rw; hw = r;
            reset = 0x0;
        } pipetranslimit[11:8];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_7_0[7:0];
    } PERI_USB2_GSBUSCFG1 @ 0xc104;
    reg {
        name = "PERI_USB2_GTXTHRCFG";
        desc = "PERI_USB2_GTXTHRCFG is a global TX threshold control register. PERI_USB2_GTXTHRCFG (offset 0xC108, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 973, section 12.8.7).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_30[31:30];
        field {
            name = "usbtxpktcntsel";
            desc = "USB TX FIFO threshold select. This field is valid only in super-speed mode.
- 0: The USB module starts transfer only after all packets are read to the specified TX FIFO.
- 1: The USB module starts transfer only after specified packets are read to the specified TX

FIFO.";
            sw = rw; hw = r;
            reset = 0x0;
        } usbtxpktcntsel[29:29];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_28_28[28:28];
        field {
            name = "usbtxpktcnt";
            desc = "TX FIFO threshold. The value range is 1−15.";
            sw = rw; hw = r;
            reset = 0x0;
        } usbtxpktcnt[27:24];
        field {
            name = "usbmaxtxburstsize";
            desc = "Maximum TX burst size. This field is valid only for the OUT endpoint during bulk transfer, isochronous transfer, or interrupt transfer at a super speed in host mode. The value range is 1−16.";
            sw = rw; hw = r;
            reset = 0x0;
        } usbmaxtxburstsize[23:16];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_15_0[15:0];
    } PERI_USB2_GTXTHRCFG @ 0xc108;
    reg {
        name = "PERI_USB2_GRXTHRCFG";
        desc = "PERI_USB2_GRXTHRCFG is a global RX threshold control register. PERI_USB2_GRXTHRCFG (offset 0xC10C, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 974, section 12.8.7).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_30[31:30];
        field {
            name = "usbtxpktcntsel";
            desc = "USB RX FIFO threshold select. This field is valid only in super-speed mode.
- 0: The USB module starts transfer only after all packets are read to the specified RX FIFO.
- 1: The USB module starts transfer only after specified packets are read to the specified RX

FIFO.";
            sw = rw; hw = r;
            reset = 0x0;
        } usbtxpktcntsel[29:29];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_28_28[28:28];
        field {
            name = "usbtxpktcnt";
            desc = "RX FIFO threshold. The value range is 1−15.";
            sw = rw; hw = r;
            reset = 0x0;
        } usbtxpktcnt[27:24];
        field {
            name = "usbmaxtxburstsize";
            desc = "Maximum RX burst size. This field is valid only for the IN endpoint during bulk transfer or interrupt transfer at a super speed in host mode. The value range is 1−16.";
            sw = r; hw = w;
            reset = 0x0;
        } usbmaxtxburstsize[23:19];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_18_0[18:0];
    } PERI_USB2_GRXTHRCFG @ 0xc10c;
    reg {
        name = "PERI_USB2_GCTL";
        desc = "PERI_USB2_GCTL is a global core control register. PERI_USB2_GCTL (offset 0xC110, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 975, section 12.8.7).";
        field {
            name = "pwrdnscale";
            desc = "Suspend_clk The Suspend_clk is calculated as follows: GCTL[31: 19] x 16 kHz = Suspend_clk 32 kHz < Suspend_clk < 125 MHz";
            sw = rw; hw = r;
            reset = 0x0;
        } pwrdnscale[31:19];
        field {
            name = "masterfiltbypass";
            desc = "Filtering select
- 0: Filtering is enabled when

DWC_USB2_EN_BUS_FILTERS is 1.
- 1: Filtering is disabled regardless of the value of DWC_USB2_EN_BUS_FILTERS.";
            sw = rw; hw = r;
            reset = 0x0;
        } masterfiltbypass[18:18];
        field {
            name = "bypssetaddr";
            desc = "SetAddress command in device mode
- 0: The host sends the SetAddress command to the device.
- 1: The host does not send the SetAddress command to the device. The device reads the value of DCFG[DevAddress] as the address value.

Note: This bit is configured only for simulation.";
            sw = rw; hw = r;
            reset = 0x0;
        } bypssetaddr[17:17];
        field {
            name = "u2rstecn";
            desc = "Super-speed connection
- 0: When the super-speed connection fails, the device is in high-speed mode.
- 1: When the super-speed connection fails, the device waits for more than three cycles.

Note: This bit is valid only in device mode.";
            sw = rw; hw = r;
            reset = 0x0;
        } u2rstecn[16:16];
        field {
            name = "frmscldwn";
            desc = "SOF/USOF/ITP interval in super-speed or high-speed mode
- 00: 125 µs
- 01: 62.5 µs
- 10: 31.25 µs
- 11: 15.625 µs

The corresponding value needs to be multiplied by 8 in full-speed mode. Maximum packet size of bulk in or bulk out transfer during simulation in xHCI debug";
            sw = rw; hw = r;
            reset = 0x0;
        } frmscldwn[15:14];
        field {
            name = "prtcapdir";
            desc = "Port configuration type
- 00: reserved
- 01: host configuration
- 10: device configuration
- 11: OTG configuration";
            sw = rw; hw = r;
            reset = 0x0;
        } prtcapdir[13:12];
        field {
            name = "coresoftreset";
            desc = "Core soft reset select
- 0: not reset
- 1: reset

When the core is soft-reset, all interrupts excluding the interrupts of the following registers are cleared. -GCTL -GUCTL -GSTS -GSNPSID -GGPIO -GUID -GUSB2PHYCFGn -DCFG -DCTL -DEVTEN -DSTS";
            sw = rw; hw = r;
            reset = 0x0;
        } coresoftreset[11:11];
        field {
            name = "sofitpsync";
            desc = "- 0: The first port of the UTMI/ULPI PHY is not suspended no matter whether other SS ports are not in the Rx.Detect, SS.Disable, or

U3 state.
- 1: The first port of the UTMI/ULPI PHY is not suspended no matter whether other non-SS ports are not in the non-suspend state.

This field is valid only when the USB controller is in host mode.";
            sw = rw; hw = r;
            reset = 0x0;
        } sofitpsync[10:10];
        field {
            name = "u1u2timerscale";
            desc = "U1/U2 timer scale-down enable
- 0: enabled
- 1: disabled when PERI_USB2_GCTL[5: 4]";
            sw = rw; hw = r;
            reset = 0x0;
        } u1u2timerscale[9:9];
        field {
            name = "debugattach";
            desc = "Debug attach signal When this field is set to 1: After the Ru/Stop bit in the DCTL register is set to 1, the SS controller enters the polling link state without detecting the link of the remote device. The timeout period for link LFPS polling is infinite. The timeout period for TS1 polling is infinite.";
            sw = rw; hw = r;
            reset = 0x0;
        } debugattach[8:8];
        field {
            name = "ramclksel";
            desc = "RAM clock select
- 00: bus clock
- 01: PIPE clock
- 10: PIPE/2 clock
- 11: reserved

In host mode, hardware sets this field to 00 (the ram_clk connects to the bus_clk). Therefore, when the SS port is in P3 state, the PIPE clock is disabled, and the USB 2.0 port does not work.";
            sw = rw; hw = r;
            reset = 0x0;
        } ramclksel[7:6];
        field {
            name = "scaledown";
            desc = "Scale-down timing select In high-speed, full-speed, or low-speed mode:
- 00: All scale-down timings are disabled, and the actual timings are used for simulation.
- 01: All scale-down timings excluding the timings related to the following functions are enabled. -Speed enumeration -HNP/SRP -Suspend and resume in host mode
- 10: Only the scale-down timings related to the suspend and resume functions in device mode are enabled.
- 11: All scale-down timings are enabled.

For the SS mode: In high-speed, full-speed, or low-speed mode:
- 00: All scale-down timings are disabled, and the actual timings are used for simulation.
- 01: The SS scale-down timings are enabled, including -The number of TxEq training sequences is";
            sw = rw; hw = r;
            reset = 0x0;
        } scaledown[5:4];
        field {
            name = "disscramble";
            desc = "Scrambling enable
- 1: disabled
- 0: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } disscramble[3:3];
        field {
            name = "u2exit_lfps";
            desc = "U2 state exit signal
- 0: The link layer considers the 248 ns LFPS signal as an active U2 state exit signal.
- 1: The link layer waits 8 μs after detecting an active U2 state exit signal.";
            sw = rw; hw = r;
            reset = 0x0;
        } u2exit_lfps[2:2];
        field {
            name = "gblhibernationen";
            desc = "Global hibernation enable
- 0: disabled. When the PMU accepts status switching between D0 and D3, the internal status of the core is not retained or restored.
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } gblhibernationen[1:1];
        field {
            name = "dsblclkgtng";
            desc = "Internal clock gating enable
- 0: enabled
- 1: disabled when the core is in LPM mode

This field can be set to 1 after power-on reset.";
            sw = rw; hw = r;
            reset = 0x0;
        } dsblclkgtng[0:0];
    } PERI_USB2_GCTL @ 0xc110;
    reg {
        name = "PERI_USB2_GSTS";
        desc = "PERI_USB2_GSTS is a global status register. PERI_USB2_GSTS (offset 0xC118, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 978, section 12.8.7).";
        field {
            name = "cbelt";
            desc = "Minimum value among all received device BELT values and the BELT value configured by running the Set Latency Tolerance Value command in host mode";
            sw = r; hw = w;
            reset = 0x0;
        } cbelt[31:20];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_19_11[19:11];
        field {
            name = "otg_ip";
            desc = "Indication that an OTG-related interrupt in the";
            sw = r; hw = w;
            reset = 0x0;
        } otg_ip[10:10];
        field {
            name = "bc_ip";
            desc = "Indication that a BC-related interrupt in the BCEVT register is waiting for handling
- 0: There is no indication.
- 1: There is an indication.";
            sw = r; hw = w;
            reset = 0x0;
        } bc_ip[9:9];
        field {
            name = "adp_ip";
            desc = "Indication that an ADP-related interrupt in the ADPEVT register is waiting for handling
- 0: There is no indication.
- 1: There is an indication.";
            sw = r; hw = w;
            reset = 0x0;
        } adp_ip[8:8];
        field {
            name = "host_ip";
            desc = "Indication that an xHCI-related interrupt in the host event queue is waiting for handling
- 0: There is no indication.
- 1: There is an indication.";
            sw = r; hw = w;
            reset = 0x0;
        } host_ip[7:7];
        field {
            name = "device_ip";
            desc = "Indication that an xHCI-related interrupt in the device event queue is waiting for handling
- 0: There is no indication.
- 1: There is an indication.";
            sw = r; hw = w;
            reset = 0x0;
        } device_ip[6:6];
        field {
            name = "csrtimeout";
            desc = "Indication that the duration of accessing registers by software exceeds the time defined by DWC_USB2_CSR_ACCESS_TIMEOUT
- 0: There is no indication.
- 1: There is an indication.";
            sw = r; hw = w;
            reset = 0x0;
        } csrtimeout[5:5];
        field {
            name = "buserraddrvld";
            desc = "GBUSERRADDR register validity indicator and start address for the error position
- 0: There is no indication.
- 1: There is an indication.";
            sw = r; hw = w;
            reset = 0x0;
        } buserraddrvld[4:4];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_3_2[3:2];
        field {
            name = "curmod";
            desc = "Current working mode
- 00: device mode
- 01: host mode

Other values: reserved";
            sw = r; hw = w;
            reset = 0x0;
        } curmod[1:0];
    } PERI_USB2_GSTS @ 0xc118;
    reg {
        name = "PERI_USB2_GUCTL1";
        desc = "PERI_USB2_GUCTL1 is global user control register 1. PERI_USB2_GUCTL1 (offset 0xC11C, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 979, section 12.8.7).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_2[31:2];
        field {
            name = "ovrld_l1_susp_com";
            desc = "If this bit is set to 1, the utmi_l1_suspend_com_n signal will be replaced by the utmi_sleep_n signal. Generally this bit is set to 1 when the PHY enters the L1 sleep mode and stops supplying the clock.";
            sw = rw; hw = r;
            reset = 0x0;
        } ovrld_l1_susp_com[1:1];
        field {
            name = "loa_filter_en";
            desc = "Port disable status detection. When this field is set to 1, the controller sends three consecutive cycles to detect the port status before the port is disabled.";
            sw = rw; hw = r;
            reset = 0x0;
        } loa_filter_en[0:0];
    } PERI_USB2_GUCTL1 @ 0xc11c;
    reg {
        name = "PERI_USB2_GGPIO";
        desc = "PERI_USB2_GGPIO is a global GPIO register. PERI_USB2_GGPIO (offset 0xC124, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 980, section 12.8.7).";
        field {
            name = "gpo";
            desc = "Drive value of gp_o[15: 0]";
            sw = rw; hw = r;
            reset = 0x0;
        } gpo[31:16];
        field {
            name = "gpi";
            desc = "Read value of gp_i[15: 0]";
            sw = r; hw = w;
            reset = 0x0;
        } gpi[15:0];
    } PERI_USB2_GGPIO @ 0xc124;
    reg {
        name = "PERI_USB2_GUID";
        desc = "PERI_USB2_GUID is a global user ID register. PERI_USB2_GUID (offset 0xC128, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 980, section 12.8.7).";
        field {
            name = "reserved";
            desc = "User information including the system version and hardware configuration";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_0[31:0];
    } PERI_USB2_GUID @ 0xc128;
    reg {
        name = "PERI_USB2_GUCTL";
        desc = "PERI_USB2_GUCTL is a global user control register. PERI_USB2_GUCTL (offset 0xC12C, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 980, section 12.8.7).";
        field {
            name = "refclkper";
            desc = "Reference clock (ref_clk), in ns For example, if the ref_clk is 125 MHz, this";
            sw = rw; hw = r;
            reset = 0x0;
        } refclkper[31:22];
        field {
            name = "noextrdl_";
            desc = "Extra delay between the SOF packet and the first packet
- 0: The host transmits the first packet 2 ms later after the SOF packet.
- 1: The host transmits the first packet after the

SOF packet without delay.";
            sw = rw; hw = r;
            reset = 0x0;
        } noextrdl[21:21];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_20_18[20:18];
        field {
            name = "sprsctrltransen";
            desc = "Disperse control transfer enable
- 0: disabled
- 1: enabled

Some devices respond to the control transfer at an extremely slow speed. The devices are abnormal if multiple transfers are performed in a frame or microframe. When this field is set to 1, the host controller disperses a control transfer in multiple frames or microframes.";
            sw = rw; hw = r;
            reset = 0x0;
        } sprsctrltransen[17:17];
        field {
            name = "resbwhseps";
            desc = "85% of the bandwidth is reserved for high-speed periodic endpoints. This field is valid only in host mode or for host operations in DRD mode.";
            sw = rw; hw = r;
            reset = 0x0;
        } resbwhseps[16:16];
        field {
            name = "cmdevaddr";
            desc = "Device address mode
- 0: The device address is the slot ID.
- 1: The device address is incremented based on the address allocation command of each device.";
            sw = rw; hw = r;
            reset = 0x0;
        } cmdevaddr[15:15];
        field {
            name = "usbhstlnautoretryen";
            desc = "Automatic retransmission enable for host inputs
- 0: disabled

If an error occurs during host input transfer, the host automatically replies an ACK indicating termination to the device (Retry = 1 and NumP = 0).
- 1: enabled

If automatic retransmission is enabled and an error occurs during host input transfer, the host automatically replies an ACK not indicating termination to the device (Retry = 1 and NumP ! = 0).";
            sw = rw; hw = r;
            reset = 0x0;
        } usbhstlnautoretryen[14:14];
        field {
            name = "enoverlapchk";
            desc = "LFPS overlap signal detection enable
- 0: The LFPS overlap signal is not detected.
- 1: The LFPS overlap signal is detected to";
            sw = rw; hw = r;
            reset = 0x0;
        } enoverlapchk[13:13];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_12_12[12:12];
        field {
            name = "csr";
            desc = "Extra delay inserted between full-speed BULKOUT transfers
- 1: not insert
- 2: insert";
            sw = rw; hw = r;
            reset = 0x0;
        } csr[11:11];
        field {
            name = "dtct";
            desc = "Rough timeout period that the device responds to the host. If this field is set to 0, the timeout period is defined by the DTFT; if this field is not 0, the timeout period is as follows:
- 00: 0 μs
- 01: 500 μs
- 10: 1.5 ms
- 11: 6.5 ms";
            sw = rw; hw = r;
            reset = 0x0;
        } dtct[10:9];
        field {
            name = "dtft";
