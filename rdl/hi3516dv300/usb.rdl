            reset = 0x0;
        } u3l2l1_susp_en[6:6];
        field {
            name = "hibernation_req_evt_en";
            desc = "Hibernation request enable
- 0: disabled";
            sw = rw; hw = r;
            reset = 0x0;
        } hibernation_req_evt_en[5:5];
        field {
            name = "wkup_evt_en";
            desc = "Recovery/Remote wakeup detection event enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } wkup_evt_en[4:4];
        field {
            name = "ulst_cng_en";
            desc = "USB/Link state switch event enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } ulst_cng_en[3:3];
        field {
            name = "connect_done_en";
            desc = "Connection completion enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } connect_done_en[2:2];
        field {
            name = "usbrst_en";
            desc = "USB reset enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } usbrst_en[1:1];
        field {
            name = "disconn_evt_en";
            desc = "Disconnection detection enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } disconn_evt_en[0:0];
    } PERI_USB2_DEVTEN @ 0xc708;
    reg {
        name = "PERI_USB2_DSTS";
        desc = "PERI_USB2_DSTS is a peripheral status register. PERI_USB2_DSTS (offset 0xC70C, total reset 0x0012_0004; PROVEN: Hi3516D V300 data sheet, PDF page 996, section 12.8.7).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_30[31:30];
        field {
            name = "dcnrd";
            desc = "Indication that device controller is not ready. The state of the controller is being switched after the controller exits the hibernation state.";
            sw = r; hw = w;
            reset = 0x0;
        } dcnrd[29:29];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_28_26[28:26];
        field {
            name = "rss";
            desc = "Recovery state This bit is set to 0 after the controller completes the recovery operation.";
            sw = r; hw = w;
            reset = 0x0;
        } rss[25:25];
        field {
            name = "sss";
            desc = "Save status This bit is set to 0 after the controller completes the save operation.";
            sw = r; hw = w;
            reset = 0x0;
        } sss[24:24];
        field {
            name = "core_idle";
            desc = "Core idle state This bit indicates that the core completes all";
            sw = r; hw = w;
            reset = 0x0;
        } core_idle[23:23];
        field {
            name = "devctrlhlt";
            desc = "Device controller suspend This bit is set to 0 when PERI_USB2_DCTL[run_stop] is 1. The core writes 1 to this bit after software writes 0 to PERI_USB2_DCTL[run_stop], the core is in idle state, and the disconnection operation is complete at the next lower layer.";
            sw = r; hw = w;
            reset = 0x0;
        } devctrlhlt[22:22];
        field {
            name = "usb_lnk_st";
            desc = "USB/Link status In SS mode:
- 0x0: U0
- 0x1: U1
- 0x2: U2
- 0x3: U3
- 0x4: SS_DIS
- 0x5: RX_DET
- 0x6: SS_INACT
- 0x7: POLL
- 0x8: RECOV
- 0x9: HRESET
- 0xa: CMPLY
- 0xb: LPBK
- 0xf: resume/reset

Other values: reserved In HS, FS, or LS mode:
- 0x0: on status
- 0x2: sleep (L1) status
- 0x3: suspend (L2) status
- 0x4: disconnected status (default status)
- 0x5: early suspend status (valid only when the hibernation function is disabled)
- 0xe: reset (valid only when the hibernation function is enabled)
- 0xf: resume (valid only when the hibernation function is enabled)

Other values: reserved";
            sw = r; hw = w;
            reset = 0x4;
        } usb_lnk_st[21:18];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x1;
        } reserved_17_17[17:17];
        field {
            name = "soffn";
            desc = "SOF frame/microframe number";
            sw = r; hw = w;
            reset = 0x0;
        } soffn[16:3];
        field {
            name = "connect_spd";
            desc = "Connection speed indicator
- 000: high speed (the PHY clock frequency is 30 MHz or 60 MHz)
- 001: full speed (the PHY clock frequency is 30 MHz or 60 MHz)
- 010: low speed (the PHY clock frequency is 6

MHz)
- 011: low speed (the PHY clock frequency is 48 MHz)
- 100: super speed (the PHY clock frequency is 125 MHz or 250 MHz)";
            sw = r; hw = w;
            reset = 0x4;
        } connect_spd[2:0];
    } PERI_USB2_DSTS @ 0xc70c;
    reg {
        name = "PERI_USB2_DGCMDPAR";
        desc = "PERI_USB2_DGCMDPAR is a peripheral class command parameter register. PERI_USB2_DGCMDPAR (offset 0xC710, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 998, section 12.8.7).";
        field {
            name = "parameter31_0";
            desc = "Peripheral class command parameter";
            sw = rw; hw = r;
            reset = 0x0;
        } parameter31_0[31:0];
    } PERI_USB2_DGCMDPAR @ 0xc710;
    reg {
        name = "PERI_USB2_DGCMD";
        desc = "PERI_USB2_DGCMD is a peripheral class command register. PERI_USB2_DGCMD (offset 0xC714, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 998, section 12.8.7).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_16[31:16];
        field {
            name = "cmd_status";
            desc = "Command status
- 0: The device controller has successfully processed the command.
- 1: An error occurs when the device controller processes the command.";
            sw = r; hw = w;
            reset = 0x0;
        } cmd_status[15:15];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_14_11[14:11];
        field {
            name = "cmdact";
            desc = "Software sets this bit to 1 to enable the device controller to execute the generated command. This bit is set to 0 after the controller executes the command. (data sheet access type RWSC)";
            sw = rw; hw = r;
            reset = 0x0;
        } cmdact[10:10];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_9_9[9:9];
        field {
            name = "cmdloc";
            desc = "Command completion interrupt Note: This bit is set to 1 when PERI_USB2_DCTL[run_stop] is 0.";
            sw = w; hw = r;
            reset = 0x0;
        } cmdloc[8:8];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_7_4[7:4];
        field {
            name = "cmdtyp";
            desc = "Command type
- 0x0: reserved
- 0x1: Configure the endpoint.
- 0x2: Configure the endpoint transfer source.
- 0x3: Obtain the endpoint status.
- 0x4: Set the suspend state.
- 0x5: Clear the suspend state.
- 0x6: Start the transfer.
- 0x7: Update the transfer.
- 0x8: End the transfer.
- 0x9: Start the new configuration.

Other values: reserved";
            sw = rw; hw = r;
            reset = 0x0;
        } cmdtyp[3:0];
    } PERI_USB2_DGCMD @ 0xc714;
    reg {
        name = "PERI_USB2_DALEPENA";
        desc = "PERI_USB2_DALEPENA is a peripheral USB endpoint enable register. PERI_USB2_DALEPENA (offset 0xC718, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 999, section 12.8.7).";
        field {
            name = "usbactep";
            desc = "Whether the USB port is valid for the current configuration and interface. Each of the 32 USB endpoints (input endpoints 0−15 and output endpoints 0−15) is controlled by one bit. The even bits control the output endpoints, and the odd bits control the input endpoints. For example: Bit[0]: USB output endpoint 0 Bit[1]: USB input endpoint 0";
            sw = rw; hw = r;
            reset = 0x0;
        } usbactep[31:0];
    } PERI_USB2_DALEPENA @ 0xc718;
    reg {
        name = "PERI_USB2_DEPCMDPAR2N";
        desc = "PERI_USB2_DEPCMDPAR2N is peripheral endpoint command parameter register 2. PERI_USB2_DEPCMDPAR2N (offset 0xC810, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 1000, section 12.8.7).";
        field {
            name = "parameter2";
            desc = "Peripheral physical endpoint command parameter register 2. This register must be configured before the command is executed.";
            sw = rw; hw = r;
            reset = 0x0;
        } parameter2[31:0];
    } PERI_USB2_DEPCMDPAR2N @ 0xc810;
    reg {
        name = "PERI_USB2_DEPCMDPAR1N";
        desc = "PERI_USB2_DEPCMDPAR1N is peripheral endpoint command parameter register 1. PERI_USB2_DEPCMDPAR1N (offset 0xC814, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 1000, section 12.8.7).";
        field {
            name = "parameter1";
            desc = "Peripheral physical endpoint command parameter register 1. This register must be configured before the command is executed.";
            sw = rw; hw = r;
            reset = 0x0;
        } parameter1[31:0];
    } PERI_USB2_DEPCMDPAR1N @ 0xc814;
    reg {
        name = "PERI_USB2_DEPCMDPAR0N";
        desc = "PERI_USB2_DEPCMDPAR0N is peripheral endpoint command parameter register 0. PERI_USB2_DEPCMDPAR0N (offset 0xC818, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 1000, section 12.8.7).";
        field {
            name = "parameter0";
            desc = "Peripheral physical endpoint command parameter register 0. This register must be";
            sw = rw; hw = r;
            reset = 0x0;
        } parameter0[31:0];
    } PERI_USB2_DEPCMDPAR0N @ 0xc818;
    reg {
        name = "PERI_USB2_DEPCMDN";
        desc = "PERI_USB2_DEPCMDN is peripheral physical endpoint command register. PERI_USB2_DEPCMDN (offset 0xC81C, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 1001, section 12.8.7).";
        field {
            name = "command_parameters";
            desc = "Command parameter. The meaning of this field varies according to the command type. For the start transfer command: Bit[31: 16] indicate the USB stream ID declared by this transfer. For the start transfer command of the real-time endpoint: Bit[31: 16] indicate the number of microframes (frame) for the first TRB application. For the update transfer, end transfer, or start new configuration command: Bit[22: 16] indicate the transfer resource index (XferRscIdx). Hardware declares the transfer resource index for the transfer. The start transfer command is responded after the index is returned. The application software declares the transfer resource index for the start new configuration command.";
            sw = rw; hw = r;
            reset = 0x0;
        } command_parameters[31:16];
        field {
            name = "cmd_status";
            desc = "Command completion status. This field saves extra information about the command that is executed. The information is the same as that in bit[15: 12] of the endpoint command completion event.";
            sw = rw; hw = r;
            reset = 0x0;
        } cmd_status[15:12];
        field {
            name = "hipri_forcerm";
            desc = "HighPriority: valid only for the start transfer command ForceRM: valid only for the end transfer command";
            sw = rw; hw = r;
            reset = 0x0;
        } hipri_forcerm[11:11];
        field {
            name = "cmd_act";
            desc = "Software writes 1 to this bit to enable the peripheral endpoint controller to execute the class command. The peripheral controller sets this bit to 0";
            sw = rw; hw = r;
            reset = 0x0;
        } cmd_act[10:10];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_9_9[9:9];
        field {
            name = "cmdloc";
            desc = "Command completion interrupt. The value 1 indicates that the peripheral controller generates a general endpoint command completion event after executing the command. Note: This bit cannot be set to 1 when PERI_USB2_DCTL[run_stop] is 0.";
            sw = rw; hw = r;
            reset = 0x0;
        } cmdloc[8:8];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_7_4[7:4];
        field {
            name = "cmdtyp";
            desc = "Type of the command that is required to be executed by the core
- 0x0: reserved
- 0x1: Configure the endpoint (64-bit or 96-bit parameter).
- 0x2: Configure the endpoint transfer resource (32-bit parameter).
- 0x3: Obtain the endpoint status (no parameter is required).
- 0x4: Set the stall (no parameter is required).
- 0x5: Clear the stall (no parameter is required).
- 0x6: Start the transfer (64-bit parameter).
- 0x7: Update the transfer (no parameter is required).
- 0x8: End the transfer (no parameter is required).
- 0x9: Start the new configuration (no parameter is required).

Other values: reserved";
            sw = rw; hw = r;
            reset = 0x0;
        } cmdtyp[3:0];
    } PERI_USB2_DEPCMDN @ 0xc81c;
