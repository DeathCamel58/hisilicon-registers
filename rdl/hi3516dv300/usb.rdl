            desc = "Device address. The device address is configured each time the device receives the SetAddress command. This field is cleared after USB reset.";
            sw = rw; hw = r;
            reset = 0x0;
        } device_address[9:3];
        field {
            name = "device_speed";
            desc = "Device transfer rate select
- 000: high speed
- 001: full speed
- 100: super speed

Other values: reserved";
            sw = rw; hw = r;
            reset = 0x4;
        } device_speed[2:0];
    } PERI_USB2_DCFG @ 0xc700;
    reg {
        name = "PERI_USB2_DCTL";
        desc = "PERI_USB2_DCTL is a peripheral control register. PERI_USB2_DCTL (offset 0xC704, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 991, section 12.8.7).";
        field {
            name = "run_stop";
            desc = "Device start/stop select The device is started after software writes 1 to this bit. To stop the device, stop all transfers and then write 0 to this bit. This bit is configured in the following cases: 1. Software must write 1 to this bit to initialize";
            sw = rw; hw = r;
            reset = 0x0;
        } run_stop[31:31];
        field {
            name = "soft_core_reset";
            desc = "Core soft reset The configuration of this bit has effect on the interrupts and registers of all clock domains. 1. All interrupts are cleared, and all registers are reset except the following ones: GCTL GUCTL GSTS GSNPSID GGPIO GUID GUSB2PHYCFGn registers GUSB2PIPECTLn registers DCFG DCTL DEVTEN DSTS 2. All state machines are restored to the idle state, and all FIFOs are cleared. 3. All transfers on the SoC bus are stopped immediately. (data sheet access type RWSC)";
            sw = rw; hw = r;
            reset = 0x0;
        } soft_core_reset[30:30];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_29_29[29:29];
        field {
            name = "hird_threshold";
            desc = "HIRD threshold The core generates the utmi_l1_suspend_n signal or utmi_sleep_n signal when the corresponding condition is met. 1. The core generates the utmi_l1_suspend_n signal in the L1 state and switches the PHY to the deep low-power mode when the following conditions are met:";
            sw = rw; hw = r;
            reset = 0x0;
        } hird_threshold[28:24];
        field {
            name = "appl1res";
            desc = "LPM response configuration When PERI_USB2_DCFG[lpm_capable] is 0, the core does not respond. When PERI_USB2_DCFG[lpm_capable] is 1, the LPM response is as follows:
- 0: The ACK is returned if the LPM reception/transmission is successful when the following conditions are met:

No check error occurs. The valid message \"bLinkState = 0001B (L1)\" is received. There is no remaining data in the TX FIFFO and the OUT endpoint is not in the flow controller state (except the NYET).
- 1: The ACK is returned if the LPM reception/transmission is successful when the following conditions are met:

No check error occurs. The valid message \"bLinkState = 0001B (L1)\" is received.";
            sw = rw; hw = r;
            reset = 0x0;
        } appl1res[23:23];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_22_20[22:20];
        field {
            name = "keepconnect";
            desc = "Connection status hold If this bit is set to 1 and the run_stop bit is 0, all related models are saved or restored. In addition, if the link enters the U3 or L2 state, the hibernation request event is enabled.";
            sw = rw; hw = r;
            reset = 0x0;
        } keepconnect[19:19];
        field {
            name = "l1_hibernation_en";
            desc = "When the keepconnect bit is 1 and this bit is set to 1, if L1 is enabled and the HIRD value is greater than the threshold configured in the hird_threshold bit, the device core generates a hibernation request event.";
            sw = rw; hw = r;
            reset = 0x0;
        } l1_hibernation_en[18:18];
        field {
            name = "controller_restore_state";
            desc = "Controller recovery status After software writes 1 to this bit, the controller immediately sets";
            sw = rw; hw = r;
            reset = 0x0;
        } controller_restore_state[17:17];
        field {
            name = "controller_save_state";
            desc = "Controller save status After software writes 1 to this bit, the controller immediately sets PERI_USB2_DSTS[sss] to 1. PERI_USB2_DSTS[sss] is set to 0 after the controller is saved. Note: The value 0 is returned when this bit is read.";
            sw = rw; hw = r;
            reset = 0x0;
        } controller_save_state[16:16];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_15_13[15:13];
        field {
            name = "initiate_u2_enable";
            desc = "U2 initialization enable
- 0: not initialized
- 1: initialized";
            sw = rw; hw = r;
            reset = 0x0;
        } initiate_u2_enable[12:12];
        field {
            name = "accept_u2_enable";
            desc = "U2 state enable
- 0: The core refuses to enter the U1 state unless

Force_LinkPM_Accep is 1.
- 1: If no user-end device is waiting, the core agrees to enter the U2 state.

Note: Hardware automatically clears this bit after USB reset.";
            sw = rw; hw = r;
            reset = 0x0;
        } accept_u2_enable[11:11];
        field {
            name = "initiate_u1_enable";
            desc = "U1 initialization enable
- 0: not initialized
- 1: initialized";
            sw = rw; hw = r;
            reset = 0x0;
        } initiate_u1_enable[10:10];
        field {
            name = "accept_u1_enable";
            desc = "U1 state enable
- 0: The core refuses to enter the U1 state unless

Force_LinkPM_Accep is 1.
- 1: If no user-end device is waiting, the core agrees to enter the U1 state.

Note: Hardware automatically clears this bit after USB reset.";
            sw = rw; hw = r;
            reset = 0x0;
        } accept_u1_enable[9:9];
        field {
            name = "ulstchngraq";
            desc = "USB/Link state switch request. Software initiates the corresponding state switch request by configuring this field. In SS mode:
- 0x0: no action
- 0x4: SS.Disabled
- 0x5: Rx.Detect";
            sw = w; hw = r;
            reset = 0x0;
        } ulstchngraq[8:5];
        field {
            name = "test_control";
            desc = "Test control
- 0x0: The test mode is disabled.
- 0x1: Test_J mode
- 0x2: Test_K mode
- 0x3: Test_SE0_NAK mode
- 0x4: Test_Packet mode
- 0x5: Test_Force_Enable

Other values: reserved";
            sw = rw; hw = r;
            reset = 0x0;
        } test_control[4:1];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x0;
        } reserved_0_0[0:0];
    } PERI_USB2_DCTL @ 0xc704;
    reg {
        name = "PERI_USB2_DEVTEN";
        desc = "PERI_USB2_DEVTEN is a peripheral event enable register. PERI_USB2_DEVTEN (offset 0xC708, total reset 0x0000_0000; PROVEN: Hi3516D V300 data sheet, PDF page 995, section 12.8.7).";
        field {
            name = "reserved";
