            sw = r; hw = na;
            reset = 0x0;
        } reserved_8_8[8:8];
        field {
            name = "sof_en";
            desc = "SOF packet enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } sof_en[7:7];
        field {
            name = "u3l2l1_susp_en";
            desc = "U3/L2-L1 suspend event enable
- 0: disabled
- 1: enabled";
