            sw = r; hw = na;
            reset = 0x0;
        } reserved_31_10[31:10];
        field {
            name = "erratic_error_event_enable";
            desc = "Irregular error event enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } erratic_error_event_enable[9:9];
        field {
            name = "reserved";
