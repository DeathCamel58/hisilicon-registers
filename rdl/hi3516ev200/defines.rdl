`ifndef DEFINES_RDL
`define DEFINES_RDL

`define FMC_GEN2   // HISI_FMC.rdl: hifmc100 GEN2 edition (the vendor U-Boot register names of the Hi3516E V200 FMC match it; no data sheet)
`define HISI_PWM_NCH 4   // HISI_PWM.rdl: four channels read from the open pwm driver
`define HISI_LSADC_V2_CV300   // HISI_LSADC_V2.rdl: two-channel 10-bit edition (open adc driver register list)

`define IVE_EXT_REGS   // HISI_IVE.rdl: newer IVE generation register set; offsets 0x00..0x90 of hi3516ev200_ive.ko drv_ive_* match it (docs/research/hi3516ev200-blocks.md)

`define IVE_AV300_REGS   // HISI_IVE.rdl: 0x8C base address / 0x90 memory speed seen in hi3516ev200_ive.ko drv_ive_set_base_addr / drv_ive_set_mem_speed
`define HISI_RSA_RAND_MASK   // HISI_RSA.rdl: random-mask registers 0x7C..0x94 (vendor cipher driver, shared with rdl/hi3516ev300)
`define HISI_SPACC_EXTRA   // HISI_SPACC.rdl: SM1_SK, odd/even key select, HDCP mode, channel owner registers (vendor cipher driver, shared with rdl/hi3516ev300)

`endif
