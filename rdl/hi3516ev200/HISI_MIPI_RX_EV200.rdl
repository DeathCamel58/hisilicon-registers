            desc = "Sync code EOF (lanes 0/1 as in the vendor union U_LVDS_LANE_EOF_01)."; 
            field { name = "lane_eof_0"; desc = "Bits [15:0]."; sw = rw; hw = r; } lane_eof_0[15:0];
            field { name = "lane_eof_1"; desc = "Bits [31:16]."; sw = rw; hw = r; } lane_eof_1[31:16];
        } EOF @ 0x8;
        reg {
            name = "LVDS next-frame sync code SOL";
            desc = "Sync code SOL (lanes 0/1 as in the vendor union U_LVDS_LANE_SOL_01)."; 
            field { name = "lane_sol_0"; desc = "Bits [15:0]."; sw = rw; hw = r; } lane_sol_0[15:0];
            field { name = "lane_sol_1"; desc = "Bits [31:16]."; sw = rw; hw = r; } lane_sol_1[31:16];
        } SOL @ 0x10;
        reg {
            name = "LVDS next-frame sync code EOL";
            desc = "Sync code EOL (lanes 0/1 as in the vendor union U_LVDS_LANE_EOL_01)."; 
            field { name = "lane_eol_0"; desc = "Bits [15:0]."; sw = rw; hw = r; } lane_eol_0[15:0];
            field { name = "lane_eol_1"; desc = "Bits [31:16]."; sw = rw; hw = r; } lane_eol_1[31:16];
        } EOL @ 0x18;
    } LVDS_NEXT_FRAME_SYNC[16] @ 0x1520 += 0x20;

};
`endif