// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3516ev200-video" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3516E V200: video data path</B><BR/><FONT POINT-SIZE="11">same block set as the Hi3516E V300 (brief data sheet and vendor module list); connections by analogy with the V300 data sheet (INFERRED); no TDE / display use on a camera</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  sens [label="CMOS sensor\nMIPI / LVDS / HiSPi / BT.1120 /\nDC timing, sensor clock out", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  mipi [label="MIPI RX\n(D-PHY, LVDS / HiSPi lanes)", fillcolor="#a6c98f"  ];
  vicap [label="VICAP\nISP front end", fillcolor="#a6c98f"  ];
  viproc [label="VIPROC\nISP back end, LDC, DIS", fillcolor="#a6c98f"  ];
  vpss [label="VPSS\n3 output channels, 3DNR,\nscale, cover, rotate", fillcolor="#a6c98f"  ];
  vedu [label="VEDU\nH.264 / H.265", fillcolor="#a6c98f"  ];
  jpge [label="JPGE\nJPEG / MJPEG", fillcolor="#a6c98f"  ];
  ive [label="IVE\nintelligent analysis", fillcolor="#a6c98f"  ];
  vgs [label="VGS\nscale / OSD / rotate", fillcolor="#a6c98f"  ];
  vdp [label="VDP\nLCD / BT.656 / BT.1120", fillcolor="#a6c98f"  ];
  disp [label="display", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  ddr [label="DDR\n(frame buffers in offline mode,\nstream buffers)", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  a7 [label="A7 + MPP software", fillcolor="#e0b86f"  ];
  net [label="FEMAC / SDIO / USB / eMMC\n(streaming, recording)", fillcolor="#8fb3de"  ];
  sens -> mipi;
  mipi -> vicap;
  vicap -> viproc [label="online / offline"];
  viproc -> vpss [label="online / offline"];
  vpss -> vedu;
  vpss -> jpge;
  vpss -> ive;
  vpss -> vgs;
  vpss -> vdp;
  vdp -> disp;
  vicap -> ddr [label="offline"];
  viproc -> ddr [label="offline"];
  vpss -> ddr [label="offline"];
  vedu -> ddr [label="stream"];
  jpge -> ddr [label="stream"];
  ddr -> a7;
  a7 -> net;
}
