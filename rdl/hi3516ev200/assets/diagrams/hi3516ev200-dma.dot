// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3516ev200-dma" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3516E V200: DMA request lines</B><BR/><FONT POINT-SIZE="11">VENDOR-DERIVED: EDMAC with four channels and 32 request lines from the vendor device tree; the line-to-peripheral table is taken from the Hi3516E V300 data sheet (Table 3-8) and agrees with the vendor notes for UART1/2 (18-21) and SPI (26-29) (INFERRED for I2C and UART0)</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  dmac [label="EDMAC (hiedmacv310)\n0x100B0000\n4 channels, linked list, 8/16/32/64-bit", fillcolor="#e0b86f"  ];
  mem [label="DDR memory", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  i2c [label="I2C0 RX 0, TX 1\nI2C1 RX 2, TX 3\nI2C2 RX 4, TX 5", fillcolor="#7fcdc4"  ];
  uart [label="UART0 RX 16, TX 17\nUART1 RX 18, TX 19\nUART2 RX 20, TX 21", fillcolor="#7fcdc4"  ];
  spi [label="SPI0 RX 26, TX 27\nSPI1 RX 28, TX 29", fillcolor="#7fcdc4"  ];
  dmac -> mem [label="mem-to-mem, mem-to-peripheral"];
  i2c -> dmac [label="request lines"];
  uart -> dmac [label="request lines"];
  spi -> dmac [label="request lines"];
}
