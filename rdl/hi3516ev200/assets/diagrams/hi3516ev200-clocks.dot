// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3516ev200-clocks" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3516E V200: clock tree (VENDOR-DERIVED, partly INFERRED)</B><BR/><FONT POINT-SIZE="11">no data sheet CRG chapter: selects from the vendor clock driver and U-Boot (docs/research/hi3516ev200-blocks.md); PLL structure by analogy with the Hi3516E V300 data sheet and not read from an EV200</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  xin [label="XIN 24 MHz crystal", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  pll [label="PLLs (PERI_CRG_PLL0..7, INFERRED layout)\nprogrammed by the boot ROM; frequencies not read", fillcolor="#e6a0a0"  ];
  sel [label="PERI_CRG32 (boot value 0x559):\nA7, DDR, SYSAXI 24 / 200 MHz, SYSCFG, SYSAPB 24 / 50 MHz", fillcolor="#d6d27a"  ];
  fmc [label="FMC: 24 / 100 / 150 / 200 / 300 / 360 MHz\nPERI_CRG81 [4:2]", fillcolor="#8fb3de"  ];
  mmc [label="eMMC / SDIO0 and SDIO1: 100 kHz / 400 kHz /\n25 / 50 / 90 / 112 / 150 MHz\nPERI_CRG125 and PERI_CRG139 [26:24]", fillcolor="#8fb3de"  ];
  sns [label="Sensor clock out: 74.25 / 72 / 54 / 24 /\n37.125 / 36 / 27 / 12 MHz (PERI_CRG60)", fillcolor="#a6c98f"  ];
  vi [label="VI / ISP, MIPI, media block clocks:\nvendor driver values only, no table", fillcolor="#a6c98f"  ];
  uart [label="UART0..2: 24 MHz or 6 MHz (PERI_CRG111)", fillcolor="#7fcdc4"  ];
  eth [label="FEMAC core: 100 / 54 MHz (PERI_CRG91 bit 7)", fillcolor="#8fb3de"  ];
  gate [label="Clock gating and soft reset in the CRG registers\n(clock map in the table below)", fillcolor="#9aa7e6"  ];
  xin -> pll;
  xin -> sel;
  pll -> sel;
  sel -> fmc;
  sel -> mmc;
  sel -> sns;
  sel -> vi;
  sel -> uart;
  sel -> eth;
  fmc -> gate;
  mmc -> gate;
  vi -> gate;
}
