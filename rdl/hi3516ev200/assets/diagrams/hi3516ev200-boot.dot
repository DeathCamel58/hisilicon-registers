// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3516ev200-boot" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3516E V200: boot flow (brief data sheet + VENDOR-DERIVED strap bits)</B><BR/><FONT POINT-SIZE="11">brief data sheet: boot from SPI NOR, SPI NAND or eMMC, secure boot; strap bits from the vendor U-Boot (SYS_CTRL SC_SYSSTAT 0x8C: boot medium bit 4, NOR 4-byte address bit 7, SPI NAND bit 10); pin names and the serial / SD / USB burn modes are not in the brief sheet</FONT>>, fontcolor="#808080", rankdir=TB];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  por [label="Power-on reset", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  rom [label="BOOTROM", fillcolor="#e0b86f"  ];
  sel [label="boot medium strap\n(SC_SYSSTAT bit 4)", fillcolor="#d6d27a"   shape=diamond];
  spi [label="SPI NOR / SPI NAND (FMC)\nSYSSTAT bits 7 and 10 give NOR address width\nand NAND mode", fillcolor="#8fb3de"  ];
  emmc [label="eMMC (4-bit)", fillcolor="#8fb3de"  ];
  sec [label="secure boot enabled?\nverify signature", fillcolor="#d6d27a"   shape=diamond];
  run [label="U-Boot runs (stage 1 in on-chip SRAM,\nthen DDR init table)", fillcolor="#a6c98f"  ];
  por -> rom;
  rom -> sel;
  sel -> spi [label="SPI"];
  sel -> emmc [label="eMMC"];
  spi -> sec;
  emmc -> sec;
  sec -> run;
}
