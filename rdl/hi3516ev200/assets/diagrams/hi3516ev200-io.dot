// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3516ev200-io" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3516E V200: storage, USB and Ethernet paths</B><BR/><FONT POINT-SIZE="11">VENDOR-DERIVED bases and clocks (docs/research/hi3516ev200-blocks.md); one SDIO 2.0 and one SD 2.0 card interface, eMMC 4-bit (brief data sheet)</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  cpu [label="A7 / system bus\nDDRC (master QoS groups)", fillcolor="#e0b86f"  ];
  emmc [label="MMC0 eMMC / SD (SDHCI)\n0x10010000, 4-bit", fillcolor="#8fb3de"  ];
  sd1 [label="MMC1 SDIO (SDHCI)\n0x10020000", fillcolor="#8fb3de"  ];
  mmcclk [label="CRG: clock select, reset, sample / drive DLL\n(PERI_CRG125, PERI_CRG139)", fillcolor="#9aa7e6"  ];
  cardp [label="eMMC / SD card / SDIO Wi-Fi", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  usb [label="USB 2.0 DWC3 (host / device)\n0x10030000", fillcolor="#8fb3de"  ];
  uphy [label="USB2 PHY (hixvp)\n0x100D0000", fillcolor="#8fb3de"  ];
  uclk [label="CRG PERI_CRG80:\nPHY, bus, ref, UTMI clocks and resets", fillcolor="#9aa7e6"  ];
  usbp [label="USB port", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  mac [label="FEMAC (TSO)\n0x10040000, MDIO 0x10041100", fillcolor="#8fb3de"  ];
  fephy [label="FE PHY (MDIO 0x10041100,\nclock / reset MISC 0x12028024)", fillcolor="#8fb3de"  ];
  rj [label="RJ45 transformer", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  fmc [label="FMC (hifmc)\n0x10000000, window 0x14000000", fillcolor="#8fb3de"  ];
  flash [label="SPI NOR / SPI NAND", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  cpu -> emmc;
  cpu -> sd1;
  mmcclk -> emmc;
  mmcclk -> sd1;
  emmc -> cardp;
  sd1 -> cardp;
  cpu -> usb;
  uclk -> usb;
  uclk -> uphy;
  usb -> uphy [label="UTMI"];
  uphy -> usbp;
  cpu -> mac;
  mac -> fephy [label="MII"];
  fephy -> rj;
  cpu -> fmc;
  fmc -> flash;
}
