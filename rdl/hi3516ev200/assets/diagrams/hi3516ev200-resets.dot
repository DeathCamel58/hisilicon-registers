// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3516ev200-resets" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3516E V200: reset tree (VENDOR-DERIVED, structure INFERRED from the V300)</B><BR/><FONT POINT-SIZE="11">no EV200 data sheet chapter: the two-level scheme is assumed equal to the Hi3516E V300 (same CRG family); register groups from the EV200 CRG description</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  por [label="POR (internal) + external reset", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  wdg [label="Watchdog (SP805)", fillcolor="#8fb3de"  ];
  sys [label="SYS_CTRL SC_SYSRES 0x04\n(vendor reboot path)", fillcolor="#e0b86f"  ];
  l1 [label="global reset", fillcolor="#d6d27a"  ];
  crg [label="CRG xx_srst bits", fillcolor="#9aa7e6"  ];
  g3 [label="Image: sensor 0xF0, MIPI RX 0xF8,\nVI / ISP 0xF4", fillcolor="#a6c98f"  ];
  g4 [label="I/O: USB2 0x140, FMC 0x144, FEMAC 0x16C,\nEDMAC 0x194, MMC 0x1F4 / 0x22C", fillcolor="#8fb3de"  ];
  g5 [label="Crypto: KLAD, TRNG, RSA, CIPHER (0x1A0)", fillcolor="#c9a0dc"  ];
  g6 [label="Low speed: UART, I2C 0x1B8, LSADC, SPI 0x1BC", fillcolor="#7fcdc4"  ];
  por -> l1;
  wdg -> l1;
  sys -> l1;
  l1 -> g3;
  l1 -> g4;
  l1 -> g5;
  l1 -> g6;
  crg -> g3;
  crg -> g4;
  crg -> g5;
  crg -> g6;
}
