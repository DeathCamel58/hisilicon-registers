regfile eIO_CONFIG_AHB {
    name = "IO configuration (pin mux + pad control), AHB/peripheral pads (SFC, eMMC/SDIO, USB, IR, SPI1), Hi3516E V200";
    desc = "Base 0x100C0000. One 32-bit register per pad: [3:0] function select, [8]/[9] pull-up/pull-down, [10] slew, [7:4] drive strength (cijliu-uboot hisi_hi3516ev200.c IO_CFG_* macros); pad names for the VIO block are INFERRED from the function written by the vendor sys_config.ko (GPIO numbers and data sheet pin names are not available), so only pads some vendor code touches are listed. Confidence legend (no hardware was read for this block): PROVEN = offset and bits are used by vendor source code or by the vendor boot binary (Xiongmai stock U-Boot of a Hi3516E V200 camera) exactly as described; INFERRED = deduced from naming, from sibling chips or from a value without a bit map; GUESS = plausible only.";

    reg {
        name = "IR_IN pad: IR receive input pad";
        desc = "PAD_08 - IR_IN pad: IR receive input pad. Confidence **INFERRED**. Evidence: openhisilicon sys_config ir_mux(): 0x1D02 selects IR_IN (0 = GPIO0_0, 1 = UPDATE_MODE, 2 = IR_IN). Hardware not read; reset values unknown.";
        field { name = "func"; desc = "Pin function select (value 0 = GPIO/primary function; the vendor writes 1, 2, 3 or 7 for the alternates, see the evidence). [INFERRED]"; sw = rw; hw = r; } func[3:0];
        field { name = "pull_up"; desc = "Pull-up enable (IO_CFG_PULL_UP = BIT(8) in cijliu-uboot). [INFERRED]"; sw = rw; hw = r; } pull_up[8:8];
        field { name = "pull_down"; desc = "Pull-down enable (IO_CFG_PULL_DOWN = BIT(9)). [INFERRED]"; sw = rw; hw = r; } pull_down[9:9];
        field { name = "slew"; desc = "Slew-rate select (IO_CFG_SR = BIT(10)). [INFERRED]"; sw = rw; hw = r; } slew[10:10];
        field { name = "drive"; desc = "Drive strength (IO_CFG_DRV_STR_SEL, [7:4]); vendor values 0x1..0x7. [INFERRED]"; sw = rw; hw = r; } drive[7:4];
        field { name = "hi_cfg"; desc = "Bits 11/12: Schmitt/input-enable style bits; vendor mux writes (0x1000 / 0x1C00 / 0x1D00 / 0x1A00) always set bit 12. [GUESS]"; sw = rw; hw = r; } hi_cfg[12:11];
    } PAD_08 @ 0x8;

    reg {
        name = "SFC_CLK / EMMC_CLK pad: SFC clock (eMMC clock when booting from eMMC)";
