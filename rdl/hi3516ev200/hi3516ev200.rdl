`include "../common/HISI_IVE.rdl"
`include "../common/HISI_MIPI_RX_V4.rdl"
`include "../common/HISI_LSADC_V2.rdl"
`include "../common/HISI_PWM.rdl"
`include "../common/HISI_SPI.rdl"
`include "../common/HISI_TIMER_SP804.rdl"
`include "../common/HISI_TRNG.rdl"
`include "../common/HISI_VIDEO_V4.rdl"
`include "../common/HISI_WDG_SP805.rdl"

addrmap hi3516ev200 {
    name = "hi3516ev200 registers";
    desc = "
        ## Status

        Reconstructed from vendor source and binaries, **no data sheet register chapter and no hardware read** (docs/research/hi3516ev200-blocks.md in the hi3520d-nvr workspace). Brief data sheets only: Hi3516E V200 / V300 Economical HD IP Camera SoC, Issue 03 (2019-05-15), no memory map in them.
        Chip: ARM Cortex-A7 (GIC at 0x10300000, generic timer 50 MHz), DDR at 0x40000000, SPI flash window 0x14000000. Chip name constant in the vendor U-Boot: 0x003516E200.

        Evidence sources: vendor U-Boot (cijliu-uboot, arch-hi3516ev200 + drivers), OpenIPC vendor-style kernel DT (hi3516ev200.dtsi), the open-source osdrv replacement modules (openhisilicon kernel/*), the vendor boot table that is identical in the stock Xiongmai U-Boot of an EV200 camera.

        Confidence per register file: see the desc of every register. Blocks present on the chip but not listed here (no register layout established): SDHCI MMC0/MMC1 0x10010000/0x10020000, DWC3 USB 0x10030000 + USB2 PHY 0x100D0000, SPACC/cipher 0x10050000, KLAD 0x10060000, RSA 0x10070000, OTP 0x10090000, EDMAC 0x100B0000, AIAO 0x100E0000, ACODEC 0x100F0000, GIC 0x10300000, VI 0x11000000/0x11200000, ISP 0x11220000, VO 0x11280000, VGS 0x11300000, GZIP 0x11310000, IVE 0x11320000, DDRT 0x11330000, VPSS 0x11400000, VEDU 0x11410000, JPGE 0x11420000, RTC 0x120E0000.
    ";

    eHISI_FMC              FMC            @ 0x10000000;
    eHISI_FEMAC            ETH            @ 0x10040000;
    eHISI_TRNG             TRNG           @ 0x10080000;
    eIO_CONFIG_AHB         IO_CONFIG_AHB  @ 0x100C0000;
    eHISI_MIPI_RX_V4       MIPI_RX        @ 0x11240000;
    eIO_CONFIG_VIO         IO_CONFIG_VIO  @ 0x112C0000;
    eHISI_TIMER_SP804      TIMER0         @ 0x12000000;
    eHISI_TIMER_SP804      TIMER1         @ 0x12000020;
    eHISI_TIMER_SP804      TIMER2         @ 0x12001000;
    eHISI_TIMER_SP804      TIMER3         @ 0x12001020;
    eCRG                   CRG            @ 0x12010000;
    eSYS_CTRL_EV200        SYS_CTRL       @ 0x12020000;
    eMISC_CTRL             MISC_CTRL      @ 0x12028000;
    eHISI_WDG_SP805        WDG            @ 0x12030000;
    eARM_PL011             UART0          @ 0x12040000;
    eARM_PL011             UART1          @ 0x12041000;
    eARM_PL011             UART2          @ 0x12042000;
    eHISI_I2C_V2           I2C0           @ 0x12060000;
    eHISI_I2C_V2           I2C1           @ 0x12061000;
    eHISI_I2C_V2           I2C2           @ 0x12062000;
    eHISI_SPI              SPI0           @ 0x12070000;
    eHISI_SPI              SPI1           @ 0x12071000;
    eHISI_PWM_GRP          PWM            @ 0x12080000;
    eHISI_LSADC_V2         LSADC          @ 0x120A0000;
    eARM_PL061             GPIO0          @ 0x120B0000;
    eARM_PL061             GPIO1          @ 0x120B1000;
    eARM_PL061             GPIO2          @ 0x120B2000;
    eARM_PL061             GPIO3          @ 0x120B3000;
    eARM_PL061             GPIO4          @ 0x120B4000;
    eARM_PL061             GPIO5          @ 0x120B5000;
    eARM_PL061             GPIO6          @ 0x120B6000;
    eARM_PL061             GPIO7          @ 0x120B7000;
    eARM_PL061             GPIO8          @ 0x120B8000;
    eARM_PL061             GPIO9          @ 0x120B9000;
    eIO_CONFIG_CORE        IO_CONFIG_CORE @ 0x120C0000;
    eDDR_AXI_V4            DDR_AXI        @ 0x120D0000;
    eDDR_DMC_V4            DDR_DMC        @ 0x120D8000;
    eDDR_PHY_V4            DDR_PHY        @ 0x120DC000;
    eISP_VICAP_CH_V4       VICAP_CH       @ 0x11010000;
    eISP_FE_V4             ISP_FE         @ 0x11020000;
    eVIPROC_V4             VIPROC         @ 0x11200000;
    eISP_BE_V4             ISP_BE         @ 0x11220000;
    eHISI_IVE              IVE            @ 0x11320000;
    eVGS_V4                VGS            @ 0x11300000;
    eVPSS_V4               VPSS           @ 0x11400000;
    eVEDU_V4               VEDU           @ 0x11410000;
    eJPGE_V4               JPGE           @ 0x11420000;
};
