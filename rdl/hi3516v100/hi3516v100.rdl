addrmap hi3516v100 {
    name = "hi3516v100 registers";
    desc = "
        ## Datasheets

        * [Full Datasheet](assets/Hi3516-Datasheet.pdf)

        ## Diagrams

        ![Application Block Diagram](assets/Application-Block-Diagram.png)
        ![Logic Block Diagram](assets/Logic-Block-Diagram.png)

        ## Addresses

        | Start Address | End Address | Description                                                                                 | Documented Here |
        |---------------|-------------|---------------------------------------------------------------------------------------------|-----------------|
        | 0x80000000    | 0xFFFFFFFF  | DDR address space 2 GB                                                                               | &#10060;        |
        | 0x5C000000    | 0x7FFFFFFF  | Reserved - -                                                                                      | &#10060;        |
        | 0x58000000    | 0x5BFFFFFF  | SPI FLASH memory space 64 MB                                                                        | &#10060;        |
        | 0x54000000    | 0x57FFFFFF  | Reserved - -                                                                                      | &#10060;        |
        | 0x50000000    | 0x53FFFFFF  | NANDC memory space 64 MB                                                                            | &#10060;        |
        | 0x40000000    | 0x4FFFFFFF  | PCIE configuration space 256 MB                                                                            | &#10060;        |
        | 0x30000000    | 0x3FFFFFFF  | PCIE MEMORY address space 256 MB                                                                    | &#10060;        |
        | 0x20810000    | 0x2FFFFFFF  | Reserved - -                                                                                      | &#10060;        |
        | 0x20800000    | 0x2080FFFF  | PCIE registers 64 KB                                                                              | &#10060;        |
        | 0x20700000    | 0x207FFFFF  | L2 CACHE space 1 MB                                                                            | &#9989;         |
        | 0x20690000    | 0x206FFFFF  | Reserved - -                                                                                      | &#10060;        |
        | 0x20650000    | 0x2068FFFF  | VICAP registers 256 KB                                                                            | &#9989;         |
        | 0x20640000    | 0x2064FFFF  | VDP registers 64 KB                                                                               | &#9989;         |
        | 0x20630000    | 0x2063FFFF  | TDE registers 64 KB                                                                               | &#9989;         |
        | 0x20620000    | 0x2062FFFF  | MD registers 64 KB                                                                                | &#9989;         |
        | 0x20610000    | 0x2061FFFF  | JPEG registers 64 KB                                                                              | &#9989;        |
        | 0x20600000    | 0x2060FFFF  | VEDU registers-see the video encoding chapter                                                                          | &#9989;         |
        | 0x20520000    | 0x205FFFFF  | Reserved - -                                                                                      | &#10060;        |
        | 0x20400000    | 0x2051FFFF  | ARM DEBUG 1152 KB (CoreSight debug APB window of the Cortex-A9, not described; data sheet remark: see the system chapter, which has none)                                                                           | &#10060;        |
        | 0x20310000    | 0x203FFFFF  | Reserved - -                                                                                      | &#10060;        |
        | 0x20300000    | 0x2030FFFF  | ARM wdg/timer/gic and other internal registers 64 KB                                                             | &#9989;         |
        | 0x20240000    | 0x202FFFFF  | Reserved - -                                                                                      | &#10060;        |
        | 0x20220000    | 0x2022FFFF  | GPIO 1064 KB                                                                                | &#9989;         |
        | 0x20210000    | 0x2021FFFF  | GPIO 964 KB                                                                                 | &#9989;         |
        | 0x20200000    | 0x2020FFFF  | GPIO 864 KB                                                                                 | &#9989;         |
        | 0x201F0000    | 0x201FFFFF  | Reserved - -                                                                                      | &#10060;        |
        | 0x201E0000    | 0x201EFFFF  | PWM 164 KB                                                                                  | &#9989;         |
        | 0x201D0000    | 0x201DFFFF  | PWM 064 KB                                                                                  | &#9989;         |
        | 0x201C0000    | 0x201CFFFF  | GPIO 764 KB                                                                                 | &#9989;         |
        | 0x201B0000    | 0x201BFFFF  | GPIO 664 KB                                                                                 | &#9989;         |
        | 0x201A0000    | 0x201AFFFF  | GPIO 564 KB                                                                                 | &#9989;         |
        | 0x20190000    | 0x2019FFFF  | GPIO 464 KB                                                                                 | &#9989;         |
        | 0x20180000    | 0x2018FFFF  | GPIO 364 KB                                                                                 | &#9989;         |
        | 0x20170000    | 0x2017FFFF  | GPIO 264 KB                                                                                 | &#9989;         |
        | 0x20160000    | 0x2016FFFF  | GPIO 164 KB                                                                                 | &#9989;         |
        | 0x20150000    | 0x2015FFFF  | Reserved 64 KB                                                                                    | &#10060;        |
        | 0x20140000    | 0x2014FFFF  | Reserved 64 KB                                                                                    | &#10060;        |
        | 0x20130000    | 0x2013FFFF  | IVE 64 KB                                                                                   | &#9989;         |
        | 0x20120000    | 0x2012FFFF  | Reserved 64 KB                                                                                    | &#10060;        |
        | 0x20110000    | 0x2011FFFF  | DDRC 64 KB                                                                                  | &#9989;         |
        | 0x20100000    | 0x2010FFFF  | Reserved 64 KB                                                                                    | &#10060;        |
        | 0x200F0000    | 0x200FFFFF  | IO config registers 64 KB                                                                         | &#9989;         |
        | 0x200E0000    | 0x200EFFFF  | SPI1 registers 64 KB                                                                              | &#10060;        |
        | 0x200D0000    | 0x200DFFFF  | I2C registers 64 KB                                                                               | &#9989;         |
        | 0x200C0000    | 0x200CFFFF  | SPI0 registers 64 KB                                                                              | &#10060;        |
        | 0x200B0000    | 0x200BFFFF  | UART3 registers 64 KB                                                                             | &#9989;         |
        | 0x200A0000    | 0x200AFFFF  | UART2 registers 64 KB                                                                             | &#9989;         |
        | 0x20090000    | 0x2009FFFF  | UART1 registers 64 KB                                                                             | &#9989;         |
        | 0x20080000    | 0x2008FFFF  | UART0 registers 64 KB                                                                             | &#9989;         |
        | 0x20070000    | 0x2007FFFF  | IR 64 KB                                                                                    | &#9989;         |
        | 0x20060000    | 0x2006FFFF  | RTC 64 KB                                                                                   | &#9989;         |
        | 0x20050000    | 0x2005FFFF  | SYS_CTRL 64 KB                                                                              | &#9989;         |
        | 0x20040000    | 0x2004FFFF  | WDG 64 KB                                                                                   | &#10060;        |
        | 0x20030000    | 0x2003FFFF  | CRG 64 KB                                                                                   | &#9989;         |
        | 0x20020000    | 0x2002FFFF  | Reserved 64 KB                                                                                    | &#10060;        |
        | 0x20000000    | 0x2000FFFF  | Timer0/ 164 KB                                                                              | &#9989;         |
        | 0x10110000    | 0x1FFFFFFF  | Reserved - -                                                                                      | &#10060;        |
        | 0x10100000    | 0x1010FFFF  | Reserved 64 KB                                                                                    | &#10060;        |
        | 0x100E0000    | 0x100EFFFF  | Reserved 64 KB                                                                                    | &#10060;        |
        | 0x100D0000    | 0x100DFFFF  | DMAC registers 64 KB                                                                              | &#9989;         |
        | 0x100C0000    | 0x100CFFFF  | CIPHER registers 64 KB                                                                            | &#9989;         |
        | 0x100B0000    | 0x100BFFFF  | USB20HOST EHCI registers 64 KB                                                                   | &#9989;         |
        | 0x100A0000    | 0x100AFFFF  | USB20HOST OHCI registers 64 KB                                                                   | &#9989;         |
        | 0x10090000    | 0x1009FFFF  | GMAC registers 64 KB                                                                              | &#9989;         |
        | 0x10080000    | 0x1008FFFF  | Reserved 64 KB                                                                                    | &#10060;        |
        | 0x10070000    | 0x1007FFFF  | Efuse registers 64 KB                                                                             | &#10060;        |
        | 0x10060000    | 0x1006FFFF  | SIO2 registers 64 KB                                                                              | &#10060;        |
        | 0x10050000    | 0x1005FFFF  | SIO 1 registers 64 KB                                                                             | &#10060;        |
        | 0x10040000    | 0x1004FFFF  | SIO 0 registers 64 KB                                                                             | &#10060;        |
        | 0x10030000    | 0x1003FFFF  | SDIO1 registers 64 KB                                                                             | &#9989;         |
        | 0x10020000    | 0x1002FFFF  | SDIO0 registers 64 KB                                                                             | &#9989;         |
        | 0x10010000    | 0x1001FFFF  | SPI FLASH registers 64 KB NOTE: This is not the HISFC V350. This is probably the earlier version. | &#9989;         |
        | 0x10000000    | 0x1000FFFF  | NANDC registers 64 KB                                                                             | &#9989;         |
        | 0x04000000    | 0x0FFFFFFF  | Reserved - -                                                                                      | &#10060;        |
        | 0x00000000    | 0x03FFFFFF  | Memory selected by address remapping. 64 MB                                                                         | &#10060;        |
    ";

    eHISI_NANDC         NANDC           @ 0x10000000;
    eHISI_SFC_300       SFC             @ 0x10010000;
    eHISI_DWMMC         SDIO0           @ 0x10020000;
    eHISI_DWMMC         SDIO1           @ 0x10030000;
    eHISI_GMAC          ETH             @ 0x10090000;
    eHISI_USB_OHCI      OHCI            @ 0x100A0000;
    eHISI_USB_EHCI      EHCI            @ 0x100B0000;
    eHISI_CIPHER_MC     CIPHER          @ 0x100C0000;
    eHISI_DMAC          DMAC            @ 0x100D0000;
    eHISI_TIMER_SP804   TIMER0          @ 0x20000000;
    eHISI_TIMER_SP804   TIMER1          @ 0x20000020;
    // TODO: Verify TIMER2/TIMER3
    eHISI_TIMER_SP804   TIMER2          @ 0x20010000;
    eHISI_TIMER_SP804   TIMER3          @ 0x20010020;
    eCRG                CRG             @ 0x20030000;
    eHISI_WDG_SP805     WDG             @ 0x20040000;
    eSYS_CTRL           SYS_CTRL        @ 0x20050000;
    eHISI_RTC           RTC             @ 0x20060000;
    eHISI_IR            IR              @ 0x20070000;
    eARM_PL011          UART0           @ 0x20080000;
    eARM_PL011          UART1           @ 0x20090000;
    eARM_PL011          UART2           @ 0x200A0000;
    eARM_PL011          UART3           @ 0x200B0000;
    eHISI_SPI           SPI0            @ 0x200C0000;
    eHISI_I2C           I2C             @ 0x200D0000;
    eHISI_SPI           SPI1            @ 0x200E0000;
    eIO_CONFIG          IO_CONFIG       @ 0x200F0000;
    eDDRC               DDRC            @ 0x20110000;
    eHISI_IVE           IVE             @ 0x20130000;
    eARM_PL061          GPIO1           @ 0x20160000;
    eARM_PL061          GPIO2           @ 0x20170000;
    eARM_PL061          GPIO3           @ 0x20180000;
    eARM_PL061          GPIO4           @ 0x20190000;
    eARM_PL061          GPIO5           @ 0x201A0000;
    eARM_PL061          GPIO6           @ 0x201B0000;
    eARM_PL061          GPIO7           @ 0x201C0000;
    eHISI_PWM_V1_GRP    PWM0            @ 0x201D0000;
    eHISI_PWM_V1_GRP    PWM1            @ 0x201E0000;
    eARM_PL061          GPIO8           @ 0x20200000;
    eARM_PL061          GPIO9           @ 0x20210000;
    eARM_PL061          GPIO10          @ 0x20220000;
    eARM_A9_MPCORE      A9_PERI         @ 0x20300000;
    aHISI_VEDU          VEDU            @ 0x20600000;
    aHISI_JPGE          JPEG            @ 0x20610000;
    eMOTION_DETECT      MOTION_DETECT   @ 0x20620000;
    aHISI_TDE           TDE             @ 0x20630000;
    eHISI_VDP_3516V100  VDP             @ 0x20640000;
    eHISI_VICAP_3516V100 VICAP           @ 0x20650000;
    eHISI_L2CACHE_V200  L2CACHE         @ 0x20700000;
};

