        enum PERI_CRG5_vpll1_postdivpd_enum {
            off = 0x0 { name = "No clock output"; desc = "no clock output"; };
            on = 0x1 { name = "Normal clock output"; desc = "normal clock output"; };
        };

        field {
            name = "VPLL1 POSTDIV output power-down control";
            desc = "VPLL1 POSTDIV output power-down control (1 = output enabled)";
            sw = rw;
            hw = r;
            encode = PERI_CRG5_vpll1_postdivpd_enum;
            reset = 0x1;
