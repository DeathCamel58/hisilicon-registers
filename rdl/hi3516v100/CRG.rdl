            clk_13_5m = 0x4 { name = "13.5 MHz"; desc = "13.5 MHz"; };
            clk_27m_b = 0x5 { name = "27 MHz (listed twice in the data sheet)"; desc = "27 MHz (listed twice in the data sheet)"; };
            clk_37_125m = 0x6 { name = "37.125 MHz"; desc = "37.125 MHz"; };
            clk_74_25m = 0x7 { name = "74.25 MHz"; desc = "74.25 MHz"; };
        };

        field {
