    } PERI_CRG5 @ 0x0014;

    reg {
        name = "EPLL configuration register 0";
        desc = "PERI_CRG6 is the EPLL configuration register 0.

EPLL (PERI_CRG6/7) provides the GMAC and PCIE clocks. Reset: postdiv2 = 3, postdiv1 = 1, refdiv = 2, fbdiv = 125 -> VCO 24 x 125 / 2 = 1500 MHz, POSTDIV output 500 MHz, the fixed 500 MHz source of the SIO mclk fractional dividers (PERI_CRG11/12). Reset 0x99000000 equals the vendor Hi3520D U-Boot REG_CRG6_VALUE (platform.h).

Data sheet 3.2.5 PERI_CRG6 (offset 0x18, printed page 3-21, `hi3516v100--Hi3516-Datasheet.txt` line 10492).";

        field {
            name = "Reserved in the bit table";
            desc = "Reserved in the bit table, but the data sheet total reset value of this register has these bits set (reset 0x1).";
            sw = r;
            hw = w;
            reset = 0x1;
        } reserved_nz_31_31[31:31];

        enum PERI_CRG6_epll_bypass_enum {
            no_bypass = 0x0 { name = "Not bypassed"; desc = "not bypassed"; };
            bypass = 0x1 { name = "Bypassed"; desc = "bypassed"; };
        };

        field {
            name = "EPLL clock divider bypass control";
            desc = "EPLL clock divider bypass control";
            sw = rw;
            hw = r;
