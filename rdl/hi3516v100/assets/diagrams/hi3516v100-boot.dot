// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3516v100-boot" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3516 V100: boot flow</B><BR/><FONT POINT-SIZE="11">data sheet 1.3 (Chinese, translated)</FONT>>, fontcolor="#808080", rankdir=TB];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  por [label="Power-on reset", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  sel [label="BOOT_SEL1 (PWM1_OUT0),\nBOOT_SEL0 (PWM0_OUT2)", fillcolor="#d6d27a"   shape=diamond];
  nand [label="NAND flash (NANDC)\nBOOT_SEL1 = 0, BOOT_SEL0 = 1", fillcolor="#8fb3de"  ];
  spi [label="SPI flash (SFC)\nBOOT_SEL1 = 0, BOOT_SEL0 = 0", fillcolor="#8fb3de"  ];
  pcie [label="PCIe load: A9 reset held;\nmaster fills DDR over PCIe,\nthen releases the A9 (BOOT_SEL1 = 1)", fillcolor="#c9a0dc"  ];
  run [label="Boot program runs\nfrom the zero address", fillcolor="#a6c98f"  ];
  por -> sel;
  sel -> nand [label="01"];
  sel -> spi [label="00"];
  sel -> pcie [label="1x"];
  nand -> run;
  spi -> run;
  pcie -> run;
}
