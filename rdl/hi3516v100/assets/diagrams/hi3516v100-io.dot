// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3516v100-io" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3516 V100: storage, network and USB paths</B><BR/><FONT POINT-SIZE="11">from the architecture and peripheral lists of the data sheet; the controller-to-device wiring shown is the usual board connection (INFERRED where not named in the sheet)</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  cpu [label="CPU + bus", fillcolor="#e0b86f"  ];
  sdio [label="MMC / SDIO x2", fillcolor="#8fb3de"  ];
  sdio_x [label="SD/MMC, SDIO, eMMC", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  sfc [label="SFC (SPI flash, 2 CS)", fillcolor="#8fb3de"  ];
  sfc_x [label="SPI flash", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  nand [label="NANDC (8-bit, 2 CS)", fillcolor="#8fb3de"  ];
  nand_x [label="NAND flash", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  eth [label="GMAC 10/100/1000", fillcolor="#8fb3de"  ];
  eth_x [label="Gigabit Ethernet PHY", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  usb [label="USB 2.0 host x2", fillcolor="#8fb3de"  ];
  usb_x [label="2 USB ports", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  pcie [label="PCIe 1.1 x1 RC/EP", fillcolor="#8fb3de"  ];
  pcie_x [label="Wi-Fi / DSP over PCIe", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  cpu -> sdio;
  sdio -> sdio_x;
  cpu -> sfc;
  sfc -> sfc_x;
  cpu -> nand;
  nand -> nand_x;
  cpu -> eth;
  eth -> eth_x;
  cpu -> usb;
  usb -> usb_x;
  cpu -> pcie;
  pcie -> pcie_x;
}
