// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3516v100-clocks" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3516 V100: clock tree</B><BR/><FONT POINT-SIZE="11">data sheet 3.2 (Chinese, translated); register names from the CRG description</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  xin [label="XIN crystal 24 MHz", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  viu [label="VIU0_CLK / VIU1_CLK,\nRGMII_RXCK / RGMII_TXCK", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  apll [label="APLL (PERI_CRG0/1)\nA9, DDR controller, bus", fillcolor="#e6a0a0"  ];
  v0 [label="VPLL0 (PERI_CRG2/3)\nVOSD clock", fillcolor="#e6a0a0"  ];
  v1 [label="VPLL1 (PERI_CRG4/5)\nVOHD clock", fillcolor="#e6a0a0"  ];
  epll [label="EPLL (PERI_CRG6/7)\nGMAC, PCIe clocks", fillcolor="#e6a0a0"  ];
  a9f [label="A9 / AXI frequency control\na9_axi_freq_mode 1:1 .. 4:1\na9_max_freq_mode 800 / 750 MHz", fillcolor="#d6d27a"  ];
  ipf [label="IP clock frequency control (IPCLK)", fillcolor="#d6d27a"  ];
  gate [label="Clock gating (PERI_CRGn)", fillcolor="#9aa7e6"  ];
  a9c [label="a9_clk", fillcolor="#e0b86f"  ];
  axi [label="axi_clk", fillcolor="#e0b86f"  ];
  ip [label="IP clocks (XXIP_clk)", fillcolor="#a6c98f"  ];
  tim [label="Timers: SC_CTRL timeren0sel..3sel (3 MHz),\ntimeren0ov..3ov reference / bus clock", fillcolor="#d6d27a"  ];
  xin -> apll;
  xin -> v0;
  xin -> v1;
  xin -> epll;
  apll -> a9f;
  v0 -> ipf;
  v1 -> ipf;
  epll -> ipf;
  viu -> ipf;
  a9f -> gate;
  ipf -> gate;
  gate -> a9c;
  gate -> axi;
  gate -> ip;
  axi -> tim [label="bus clock"];
}
