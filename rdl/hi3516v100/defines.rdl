// PERIPHCTRL23 (0x90) .. PERIPHCTRL29 are the PCIe x1 controller control registers 0..6 in the Hi3516 data sheet (Chinese original);
// the shared file's default bodies at 0x94/0x98/0xA4/0xA8 are the Hi3520D FE PHY / SATA PHY / IO-control fields, so the Hi3516 selects its own:
`define SYS_CTRL_PERIPHCTRL24_VAR1   // PERIPHCTRL24 PCIe controller control register 1 (hi3516 data sheet)
