        desc = "AXI_PUSH_WRMIDn is a priority deliver enable register for write commands with the same MIDs. (offset 0x500, 9 instances at stride 0x10; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.5.2, PDF page 745).";
        field {
            name = "wr_mid_sel";
            desc = "Bit match select of the write command MID (the lowest five bits) When wr_mid_sel[n] is 0, the priority deliver function is disabled for write commands with MID n in the QoSBuf. When wr_mid_sel[n] is 1, the priority deliver function is enabled for write commands with MID n in the QoSBuf.";
            sw = rw; hw = r;
            reset = 0x0;
        } wr_mid_sel[31:0];
    };
    AXI_PUSH_WRMIDn_t AXI_PUSH_WRMID0 @ 0x500;
    AXI_PUSH_WRMIDn_t AXI_PUSH_WRMID1 @ 0x510;
