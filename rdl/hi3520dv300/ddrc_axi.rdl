        field {
            name = "rd_mid_sel";
            desc = "Bit match select of the read command MID (the lowest five bits) When rd_mid_sel[n] is 0, the priority deliver function is disabled for read commands with MID n in the QoSBuf. When rd_mid_sel[n] is 1, the priority deliver function is enabled for read commands with MID n in the QoSBuf.";
            sw = rw; hw = r;
            reset = 0x0;
        } rd_mid_sel[31:0];
    };
    AXI_PUSH_RDMIDn_t AXI_PUSH_RDMID0 @ 0x504;
    AXI_PUSH_RDMIDn_t AXI_PUSH_RDMID1 @ 0x514;
