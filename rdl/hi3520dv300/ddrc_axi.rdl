        } reserved_31_12[31:12];
        field {
            name = "int_ports";
            desc = "Interrupt source indicator When interrupt_ports[n] is 1, the interrupt source is port n. When the command does not pass the security permission check and the interrupt is enabled, the corresponding port generates interrupts.";
            sw = r; hw = w;
            reset = 0x0;
        } int_ports[11:0];
