`ifndef HI3520DV300_DDRC_AXI_RDL
`define HI3520DV300_DDRC_AXI_RDL
regfile eHI3520DV300_DDRC_AXI {
    name = "DDRC AXI interface";
    desc = "DDRC AXI interface of the Hi3521A/Hi3520D V300 at base 0x1211_0000. 20 registers extracted programmatically from the Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10) (Table 4-5 Summary of AXI registers (base address: 0x1211_0000)): register headings, offsets, total reset values, field bit ranges, access types, names, reset values and descriptions, with PDF page numbers in each register description. Field names, bit ranges, access types and offsets are exact; the free-text descriptions are taken from the cell text of the field table and were checked by sampling only. Hardware not verified.";
    reg {
        name = "AXI_CFG_LOCK";
        desc = "AXI_CFG_LOCK is a lock control register. (offset 0x4; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.5.2, PDF page 726).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_1[31:1];
        field {
            name = "apb_cfg_lock";
            desc = "Lock control of all the register configuration modules (AXI_IF/SEC/DMC/PUB) in the MDDRC
- 0: unlocked
- 1: locked (None of the AXI_IF configuration registers can be accessed except this register. Therefore, the power consumption is reduced.)";
            sw = rw; hw = r;
            reset = 0x0;
        } apb_cfg_lock[0:0];
    } AXI_CFG_LOCK @ 0x4;
    reg {
        name = "AXI_CKG";
        desc = "AXI_CKG is a module clock gating register. (offset 0x8; total reset 0x000F1FFF; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.5.2, PDF page 727).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_20[31:20];
        field {
            name = "sta_ckg_dmc";
            desc = "Static clock gating for each DMC When sta_ckg_dmc[n] is 0, the clocks for the DMCn and the corresponding PHY utility block (PUB) are disabled. When sta_ckg_dmc[n] is 1, the clocks for the DMCn and the corresponding PUB are enabled. n = 1, 2 or 3: reserved";
            sw = rw; hw = r;
            reset = 0xf;
        } sta_ckg_dmc[19:16];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_15_13[15:13];
        field {
            name = "dyn_ckg_rdr";
            desc = "Dynamic clock gating for the reorder module
- 0: The clock is always enabled.
- 1: The clock is automatically disabled when the module is idle.";
            sw = rw; hw = r;
            reset = 0x1;
        } dyn_ckg_rdr[12:12];
        field {
            name = "dyn_ckg_axi";
            desc = "Dynamic clock gating for each AXI port When dyn_ckg_axi[n] is 0, the clock for AXI port n is always enabled. When dyn_ckg_axi[n] is 1, the clock is automatically disabled when modules in AXI port n are idle. Notes: n= 6, 7, 8, 9, 10 or 11: reserved";
            sw = rw; hw = r;
            reset = 0xfff;
        } dyn_ckg_axi[11:0];
    } AXI_CKG @ 0x8;
    reg {
        name = "AXI_ACTION";
        desc = "AXI_ACTION is an AXI operating mode register. (offset 0x20; total reset 0x00000003; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.5.2, PDF page 728).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_20[31:20];
        field {
            name = "wr_rcv_mode";
            desc = "Anti-deadlock mode enable When wr_rcv_mode[n] is 0, the anti-deadlock mode for port n is disabled. When wr_rcv_mode[n] is 1, the anti-deadlock mode for port n is enabled. Whether to enable the anti-deadlock mode depends on bus architecture requirements When the anti-deadlock mode is enabled, the OSTD of the write command is restricted to 1.";
            sw = rw; hw = r;
            reset = 0x0;
        } wr_rcv_mode[19:8];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_2[7:2];
        field {
            name = "rd_wrap_split_en";
            desc = "Wrap read command split enable
- 0: no split. The address is wrapped by the DMC.
- 1: split";
            sw = rw; hw = r;
            reset = 0x1;
        } rd_wrap_split_en[1:1];
        field {
            name = "exclusive_en";
            desc = "Exclusive command enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x1;
        } exclusive_en[0:0];
    } AXI_ACTION @ 0x20;
    reg AXI_REGION_MAP_t {
        name = "AXI_REGION_MAP";
        desc = "AXI_REGION_MAP is an address area mapping register. (offset 0x100, 16 instances at stride 0x10; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.5.2, PDF page 729).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_13[31:13];
        field {
            name = "rgn_en";
            desc = "Current address area enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } rgn_en[12:12];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_11_11[11:11];
        field {
            name = "rgn_size";
            desc = "Size of the current address area
- 0x0: 16 MB
- 0x1: 32 MB. In this case, rgn_base_addr/ch_offset[0] must be set to 0.
- 0x2: 64 MB. In this case, rgn_base_addr/ch_offset[1:0] must be set to 0.
- 0x3: 128 MB. In this case, rgn_base_addr/ ch _offset[2:0] must be set to 0.
- 0x4: 256 MB. In this case, rgn_base_addr/ ch _offset[3:0] must be set to 0.
- 0x5: 512 MB. In this case, rgn_base_addr/ ch _offset[4:0] must be set to 0.
- 0x6: 1 GB. In this case, rgn_base_addr/ ch _offset[5:0] must be set to 0.
- 0x7: 2 GB. In this case, rgn_base_addr/ ch _offset[6:0] must be set to 0.

The preceding configuration is valid when the address bit width is 32 bits. The meaning of the configured value varies according to the address bit width. For example, when the address bit width is 40 bits, if this field is set to 0x3, the size of the current address area is 32 GB. In this case, rgn_base_addr[2:0] must be set to 0. When the address mapping mode is the dual-channel-interleaved mode, rgn_size cannot be set to 0. When the addresses of four channels are interleaved, rgn_size cannot be set to 0 or 1.";
            sw = rw; hw = r;
            reset = 0x0;
        } rgn_size[10:8];
        field {
            name = "rgn_base_addr";
            desc = "Base address of the current address area (upper eight bits) The area address alignment granularity varies according to the address bit width because only the upper eight bits of the address can be configured. When the address bit width is 32 bits, the lower 24 bits of the base address of the address area are 0 and the area address is 16-MB-aligned. When the address bit width is 40 bits, the lower 32 bits of the base address of the address area are 0 and the area address is 4-GB-aligned. Only the 32-bit address bit width is supported in this version.";
            sw = rw; hw = r;
            reset = 0x0;
        } rgn_base_addr[7:0];
    };
    AXI_REGION_MAP_t AXI_REGION_MAP_0 @ 0x100;
    AXI_REGION_MAP_t AXI_REGION_MAP_1 @ 0x110;
    AXI_REGION_MAP_t AXI_REGION_MAP_2 @ 0x120;
    AXI_REGION_MAP_t AXI_REGION_MAP_3 @ 0x130;
    AXI_REGION_MAP_t AXI_REGION_MAP_4 @ 0x140;
    AXI_REGION_MAP_t AXI_REGION_MAP_5 @ 0x150;
    AXI_REGION_MAP_t AXI_REGION_MAP_6 @ 0x160;
    AXI_REGION_MAP_t AXI_REGION_MAP_7 @ 0x170;
    AXI_REGION_MAP_t AXI_REGION_MAP_8 @ 0x180;
    AXI_REGION_MAP_t AXI_REGION_MAP_9 @ 0x190;
    AXI_REGION_MAP_t AXI_REGION_MAP_10 @ 0x1A0;
    AXI_REGION_MAP_t AXI_REGION_MAP_11 @ 0x1B0;
    AXI_REGION_MAP_t AXI_REGION_MAP_12 @ 0x1C0;
    AXI_REGION_MAP_t AXI_REGION_MAP_13 @ 0x1D0;
    AXI_REGION_MAP_t AXI_REGION_MAP_14 @ 0x1E0;
    AXI_REGION_MAP_t AXI_REGION_MAP_15 @ 0x1F0;
    reg AXI_REGION_ATTRIB_t {
        name = "AXI_REGION_ATTRIB";
        desc = "AXI_REGION_ATTRIB is an address area attribute register. (offset 0x104, 16 instances at stride 0x10; total reset 0x00010004; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.5.2, PDF page 730).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_31[31:31];
        field {
            name = "bnk_mod";
            desc = "Bank interleaving granularity in the channel of the current address area (the interleaving granularity varies according to the component) 8Byte*2^n (8-bit components); 16Byte*2^n (16-bit components); 32Byte*2^n (32-bit components); 64Byte*2^n (64-bit components). n=0-7 The bank interleaving granularity must be greater than or equal to the address alignment granularity (addr_aligned).";
            sw = rw; hw = r;
            reset = 0x0;
        } bnk_mod[30:28];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_27_26[27:26];
        field {
            name = "rnk_mod";
            desc = "Rank interleaving mode of the channel of the current address area
- 00: The configuration in the DMC is used.
- 01: a single independent rank address
- 10: Two rank addresses are interleaved.
- 11: Four rank addresses are interleaved.

Only a single channel is supported in this version and the channel supports only one rank.";
            sw = rw; hw = r;
            reset = 0x0;
        } rnk_mod[25:24];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_23_19[23:19];
        field {
            name = "addr_aligned";
            desc = "Address boundary alignment granularity of the current address area
- 000: 8 bytes (valid only when the DMC data bit width is 64 bits)
- 001: 16 bytes
- 010: 32 bytes
- 011: 64 bytes
- 100: 128 bytes
- 101: 256 bytes
- 110: 512 bytes
- 111: 1 KB

Commands that cross the address alignment boundary will be split. The address alignment granularity must be less than or equal to the bank interleaving granularity (bnk_mod). When addresses are interleaved, the address alignment granularity must be less than or equal to the address interleaving granularity (ch_intlv). When the address is independent, the address alignment granularity must be less than or equal to the page size of the DDR.";
            sw = rw; hw = r;
            reset = 0x1;
        } addr_aligned[18:16];
        field {
            name = "ch_offset";
            desc = "Offset address of the current address area in the channel (upper eight bits) The offset address is used to replace the upper eight bits of the address in the channel to implement the offset of the mapping address in the channel. The offset address varies according to the address bit width. Bits [31:24] of the 32-bit address after channel mapping can be replaced. Bits [39:32] of the 40-bit address after channel mapping can be replaced. Only the 32-bit address bit width is supported in this version.";
            sw = rw; hw = r;
            reset = 0x0;
        } ch_offset[15:8];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_6[7:6];
        field {
            name = "ch_intlv";
            desc = "Address interleaving granularity of the current address area (invalid in single independent channel address mode)
- 0x0: 64 Byte
- 0x1: 128 bytes
- 0x2: 256 bytes
- 0x3: 512 bytes

Commands are alternately sent to multiple channels based on this granularity. When channels are interleaved, the address interleaving granularity must be greater than or equal to the address alignment granularity (addr_aligned).";
            sw = rw; hw = r;
            reset = 0x0;
        } ch_intlv[5:4];
        field {
            name = "ch_mode";
            desc = "Channel mapping mode of the current address area
- 00: no mapping
- 01: The address of a single channel is mapped to the channel, and the address is independent
- 10: The addresses of two channels are mapped to the channel, and the addresses are interleaved.
- 11: The addresses of four channels are mapped to the channel, and the addresses are interleaved.

Commands that attempt to access the unmapped address areas are processed as incorrect commands. In this case, interrupts are reported, command information is recorded, and the SLVERR response is returned from the AXI bus. Only a single channel is supported in this version.";
            sw = rw; hw = r;
            reset = 0x1;
        } ch_mode[3:2];
        field {
            name = "ch_start";
            desc = "Mapping start channel of the current address area
- 00: channel 0
- 01: channel 1
- 10: channel 2
- 11: channel 3

In single-channel mapping mode, the mapping start channel can be any channel. In dual-channel mapping mode, the mapping start channel must be channel 0 (addresses of channel 0 and channel 1 are interleaved) or channel 2 (addresses of channel 2 and channel 3 are interleaved). In quad-channel mapping mode, the mapping start channel must be channel 0 (addresses of channels 0-3 are interleaved). Only a single channel is supported in this version.";
            sw = rw; hw = r;
            reset = 0x0;
        } ch_start[1:0];
    };
    AXI_REGION_ATTRIB_t AXI_REGION_ATTRIB_0 @ 0x104;
    AXI_REGION_ATTRIB_t AXI_REGION_ATTRIB_1 @ 0x114;
    AXI_REGION_ATTRIB_t AXI_REGION_ATTRIB_2 @ 0x124;
    AXI_REGION_ATTRIB_t AXI_REGION_ATTRIB_3 @ 0x134;
    AXI_REGION_ATTRIB_t AXI_REGION_ATTRIB_4 @ 0x144;
    AXI_REGION_ATTRIB_t AXI_REGION_ATTRIB_5 @ 0x154;
    AXI_REGION_ATTRIB_t AXI_REGION_ATTRIB_6 @ 0x164;
    AXI_REGION_ATTRIB_t AXI_REGION_ATTRIB_7 @ 0x174;
    AXI_REGION_ATTRIB_t AXI_REGION_ATTRIB_8 @ 0x184;
    AXI_REGION_ATTRIB_t AXI_REGION_ATTRIB_9 @ 0x194;
    AXI_REGION_ATTRIB_t AXI_REGION_ATTRIB_10 @ 0x1A4;
    AXI_REGION_ATTRIB_t AXI_REGION_ATTRIB_11 @ 0x1B4;
    AXI_REGION_ATTRIB_t AXI_REGION_ATTRIB_12 @ 0x1C4;
    AXI_REGION_ATTRIB_t AXI_REGION_ATTRIB_13 @ 0x1D4;
    AXI_REGION_ATTRIB_t AXI_REGION_ATTRIB_14 @ 0x1E4;
    AXI_REGION_ATTRIB_t AXI_REGION_ATTRIB_15 @ 0x1F4;
    reg AXI_REGION_SCRMBL_t {
        name = "AXI_REGION_SCRMBL";
        desc = "AXI_REGION_SCRMBL is an address scrambling code mode register for address areas. (offset 0x108, 16 instances at stride 0x10; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.5.2, PDF page 733).";
        field {
            name = "reserved";
            desc = "Reserved. This field is fixed at 0.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_4[31:4];
        field {
            name = "bnk_scrmbl";
            desc = "Bank address scrambling code mode
- 0: no scrambling code
- 1: addr[14:12] = addr[14:12] XOR addr[17:15]
- 2: addr[14:12] = addr[14:12] XOR addr[18:16]
- 3: addr[14:12] = addr[14:12] XOR addr[19:17]
- 4: addr[14:12] = addr[14:12] XOR addr[20:18]
- 5: addr[14:12] = addr[14:12] XOR addr[21:19]
- 6: addr[14:12] = addr[14:12] XOR addr[22:20]
- 7: addr[14:12] = addr[14:12] XOR addr[23:21]

Other values: reserved addr indicates the bus address.";
            sw = rw; hw = r;
            reset = 0x0;
        } bnk_scrmbl[3:0];
    };
    AXI_REGION_SCRMBL_t AXI_REGION_SCRMBL_0 @ 0x108;
    AXI_REGION_SCRMBL_t AXI_REGION_SCRMBL_1 @ 0x118;
    AXI_REGION_SCRMBL_t AXI_REGION_SCRMBL_2 @ 0x128;
    AXI_REGION_SCRMBL_t AXI_REGION_SCRMBL_3 @ 0x138;
    AXI_REGION_SCRMBL_t AXI_REGION_SCRMBL_4 @ 0x148;
    AXI_REGION_SCRMBL_t AXI_REGION_SCRMBL_5 @ 0x158;
    AXI_REGION_SCRMBL_t AXI_REGION_SCRMBL_6 @ 0x168;
    AXI_REGION_SCRMBL_t AXI_REGION_SCRMBL_7 @ 0x178;
    AXI_REGION_SCRMBL_t AXI_REGION_SCRMBL_8 @ 0x188;
    AXI_REGION_SCRMBL_t AXI_REGION_SCRMBL_9 @ 0x198;
    AXI_REGION_SCRMBL_t AXI_REGION_SCRMBL_10 @ 0x1A8;
    AXI_REGION_SCRMBL_t AXI_REGION_SCRMBL_11 @ 0x1B8;
    AXI_REGION_SCRMBL_t AXI_REGION_SCRMBL_12 @ 0x1C8;
    AXI_REGION_SCRMBL_t AXI_REGION_SCRMBL_13 @ 0x1D8;
    AXI_REGION_SCRMBL_t AXI_REGION_SCRMBL_14 @ 0x1E8;
    AXI_REGION_SCRMBL_t AXI_REGION_SCRMBL_15 @ 0x1F8;
    reg AXI_QOS_MAP_t {
        name = "AXI_QOS_MAP";
        desc = "AXI_QOS_MAP is a command priority mapping mode register. (offset 0x200, 9 instances at stride 0x10; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.5.2, PDF page 733).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_22[31:22];
        field {
            name = "qos_rever";
            desc = "QoS inversion enable (for the priority arbitration of the read and write commands from the same port)
- 0: Priority 0 (axqos = 0) is the lowest priority.
- 1: Priority 0 (axqos = 0) is the highest priority.

This register is valid only when rw_arb_mode is 1.";
            sw = rw; hw = r;
            reset = 0x0;
        } qos_rever[21:21];
        field {
            name = "rw_arb_mode";
            desc = "Arbitration mode for the read and write commands from the same port
- 0: The arbitration is based on the command read/write type.

The command that arrives first is arbitrated first. When the read and write commands arrive simultaneously (or the back pressure is imposed on them simultaneously), the read command is arbitrated before the write command.
- 1: The arbitration is based on the command priority.

The command that arrives first is arbitrated first. When the read and write commands arrive simultaneously (or the back pressure is imposed on them simultaneously), the command with a higher priority is arbitrated first. If the priorities of the read and write commands are the same, the command that is not arbitrated last time is arbitrated according to the least recently used (LRU) rule.";
            sw = rw; hw = r;
            reset = 0x0;
        } rw_arb_mode[20:20];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_19_19[19:19];
        field {
            name = "hurry_qos_en";
            desc = "Hurry priority deliver enable
- 0: disabled
- 1: enabled

The hurry signal on the NOC bus can deliver priorities at any time and is involved in the priority deliver in the AXI_IF. This register is valid only when pri_push_en is 1.";
            sw = rw; hw = r;
            reset = 0x0;
        } hurry_qos_en[18:18];
        field {
            name = "push_qos_en";
            desc = "Push priority deliver enable
- 0: disabled
- 1: enabled

The pressure signal on the NOC bus can deliver priorities when the back pressure is imposed on the command bus and is involved in the priority deliver in the AXI_IF. This register is valid only when pri_push_en is 1.";
            sw = rw; hw = r;
            reset = 0x0;
        } push_qos_en[17:17];
        field {
            name = "pri_push_en";
            desc = "Port priority deliver enable
- 0: disabled
- 1: enabled

When the port priority deliver function is enabled, among the multiple commands in the port pipeline and external commands, the one with the highest priority is transferred to the command that is involved in port arbitration. This enables the command to be arbitrated instantly. However, the priority of the transferred command remains unchanged.";
            sw = rw; hw = r;
            reset = 0x0;
        } pri_push_en[16:16];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_15_13[15:13];
        field {
            name = "pri_map_mode";
            desc = "Priority mapping mode of the read/write command
- 0: Any three bits in the command ID or associated signal are used as the mapping index.
- 1: Any three bits in the lower 16 bits of the command ID are used as the mapping index.

The mapping index is obtained by using either of the preceding methods, and the command priority is obtained by mapping the index to the priority lookup table. The lookup table indicates the description of AXI_QOS_WRPRI or AXI_QOS_RDPRI.";
            sw = rw; hw = r;
            reset = 0x0;
        } pri_map_mode[12:12];
        field {
            name = "id_map_idx";
            desc = "Three methods for selecting bits in the command ID as the mapping index when the command ID is used to map the priority id_map_idx[11:8]: Any one bit in the lower 16 bits of the command ID is selected as idx[2]. id_map_idx[7:4]: Any one bit in the lower 16 bits of the command ID is selected as idx[1]. id_map_idx[3:0]: Any one bit in the lower 16 bits of the command ID is selected as idx[0]. For example, if id_map_idx is set to 0x3A0, ID[3], ID[10], and ID[0] of the command form idx[2:0], which is used to map the command priority from the priority lookup table. The lookup table indicates the description of AXI_QOS_WRPRI or AXI_QOS_RDPRI. The command ID indicates the original command ID.";
            sw = rw; hw = r;
            reset = 0x0;
        } id_map_idx[11:0];
    };
    AXI_QOS_MAP_t AXI_QOS_MAP_0 @ 0x200;
    AXI_QOS_MAP_t AXI_QOS_MAP_1 @ 0x210;
    AXI_QOS_MAP_t AXI_QOS_MAP_2 @ 0x220;
    AXI_QOS_MAP_t AXI_QOS_MAP_3 @ 0x230;
    AXI_QOS_MAP_t AXI_QOS_MAP_4 @ 0x240;
    AXI_QOS_MAP_t AXI_QOS_MAP_5 @ 0x250;
    AXI_QOS_MAP_t AXI_QOS_MAP_6 @ 0x260;
    AXI_QOS_MAP_t AXI_QOS_MAP_7 @ 0x270;
    AXI_QOS_MAP_t AXI_QOS_MAP_8 @ 0x280;
    reg AXI_QOS_WRPRIn_t {
        name = "AXI_QOS_WRPRIn";
        desc = "AXI_QOS_WRPRIn is a write command priority mapping table register. (offset 0x204, 9 instances at stride 0x10; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.5.2, PDF page 736).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_31[31:31];
        field {
            name = "wr_pri7";
            desc = "Priority of the write command when the mapping index is 7
- 0x0: highest priority …
- 0x7: lowest priority";
            sw = rw; hw = r;
            reset = 0x0;
        } wr_pri7[30:28];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_27_27[27:27];
        field {
            name = "wr_pri6";
            desc = "Priority of the write command when the mapping index is 6
- 0x0: highest priority …
- 0x7: lowest priority";
            sw = rw; hw = r;
            reset = 0x0;
        } wr_pri6[26:24];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
