- 0x5: The priority adaptation cycle of write commands with priorities 2-5 is configured in wr_adpt_high, and that of write commands with priorities 6-7 is configured in wr_adpt_low.";
            sw = rw; hw = r;
            reset = 0x0;
        } wr_adpt_lvl[22:20];
