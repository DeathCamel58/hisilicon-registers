- 0: No interrupt is generated.
- 1: An interrupt is generated.";
            sw = r; hw = w;
            reset = 0x0;
        } ch3_int_tc_stat[3:3];
        field {
            name = "ch2_int_tc_stat";
            desc = "Status of the masked transfer terminal interrupt of channel 2
- 0: No interrupt is generated.
- 1: An interrupt is generated.";
            sw = r; hw = w;
            reset = 0x0;
        } ch2_int_tc_stat[2:2];
        field {
