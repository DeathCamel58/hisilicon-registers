- 0: No interrupt is generated.
- 1: An interrupt is generated.";
            sw = r; hw = w;
            reset = 0x0;
        } ch0_int_tc_stat[0:0];
    } DMAC_INT_TC_STAT @ 0x4;
    reg {
        name = "DMAC_INT_TC_CLR";
        desc = "DMAC_INT_TC_CLR is a DMAC transfer terminal interrupt clear register. (offset 0x8; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 3.6.6, PDF page 604).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_4[31:4];
        field {
            name = "ch3_int_tc_clr";
            desc = "Transfer terminal interrupt clear for channel 3
- 0: not cleared
- 1: cleared";
            sw = w; hw = r;
            reset = 0x0;
        } ch3_int_tc_clr[3:3];
        field {
            name = "ch2_int_tc_clr";
            desc = "Transfer terminal interrupt clear for channel 2
- 0: not cleared
- 1: cleared";
            sw = w; hw = r;
            reset = 0x0;
        } ch2_int_tc_clr[2:2];
        field {
