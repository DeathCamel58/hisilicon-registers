`ifndef HI3520DV300_DMAC_RDL
`define HI3520DV300_DMAC_RDL
regfile eHI3520DV300_DMAC {
    name = "DMAC";
    desc = "DMAC of the Hi3521A/Hi3520D V300 at base 0x1006_0000. 19 registers extracted programmatically from the Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10) (Table 3-14 Summary of the DMAC registers (base address: 0x1006_0000)): register headings, offsets, total reset values, field bit ranges, access types, names, reset values and descriptions, with PDF page numbers in each register description. Field names, bit ranges, access types and offsets are exact; the free-text descriptions are taken from the cell text of the field table and were checked by sampling only. Hardware not verified.";
    reg {
        name = "DMAC_INT_STAT";
        desc = "DMAC_INT_STAT is an interrupt status register. (offset 0x0; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 3.6.6, PDF page 602).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_4[31:4];
        field {
            name = "ch3_int_stat";
            desc = "Masked interrupt status of channel 3
- 0: No interrupt is generated.
- 1: A transfer error interrupt or transfer terminal interrupt is generated.";
            sw = r; hw = w;
            reset = 0x0;
        } ch3_int_stat[3:3];
        field {
            name = "ch2_int_stat";
            desc = "Masked interrupt status of channel 2
- 0: No interrupt is generated.
- 1: A transfer error interrupt or transfer terminal interrupt is generated.";
            sw = r; hw = w;
            reset = 0x0;
        } ch2_int_stat[2:2];
        field {
            name = "ch1_int_stat";
            desc = "Masked interrupt status of channel 1
- 0: No interrupt is generated.
- 1: A transfer error interrupt or transfer terminal interrupt is generated.";
            sw = r; hw = w;
            reset = 0x0;
        } ch1_int_stat[1:1];
        field {
            name = "ch0_int_stat";
            desc = "Masked interrupt status of channel 0
- 0: No interrupt is generated.
- 1: A transfer error interrupt or transfer terminal interrupt is generated.";
            sw = r; hw = w;
            reset = 0x0;
        } ch0_int_stat[0:0];
    } DMAC_INT_STAT @ 0x0;
    reg {
        name = "DMAC_INT_TC_STAT";
        desc = "DMAC_INT_TC_STAT is a DMAC transfer terminal interrupt status register. (offset 0x4; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 3.6.6, PDF page 603).";
        field {
            name = "reserved";
