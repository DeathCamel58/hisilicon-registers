        field {
            name = "core_pwm_duty";
            desc = "Number of pulse-width modulation (PWM) high-level beats for the core AVS output. If the number is greater than or equal to the number of PWM cycles, the output level is always high. The value cannot be 0. If the configured value is 0, the value 1 is used.";
            sw = rw; hw = r;
            reset = 0x12;
        } core_pwm_duty[31:16];
        field {
            name = "core_pwm_period";
            desc = "Number of PWM cycles for the core AVS output";
