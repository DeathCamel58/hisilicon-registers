    } IR_INT_STATUS @ 0x2C;
    reg {
        name = "IR_INT_CLR";
        desc = "IR_INT_CLR is an IR interrupt clear register. When IR_CFG[ir_mode] is 0, IR_INT_CLR[3:0] are valid. When IR_CFG[ir_mode] is 1, IR_INT_CLR[18:16] are valid. (offset 0x30; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 0.1, PDF page 1572).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_19[31:19];
        field {
            name = "intc_overrun";
            desc = "When IR_CFG[ir_mode] is 1, this bit indicates whether the symbol overflow interrupt request is cleared.
- 0: no effect
- 1: cleared

Access type WC in the data sheet: written 1 clears the bit.";
            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } intc_overrun[18:18];
        field {
            name = "intc_time_out";
            desc = "When IR_CFG[ir_mode] is 1, this bit indicates whether the symbol timeout interrupt request is cleared.
- 0: no effect
- 1: cleared

Access type WC in the data sheet: written 1 clears the bit.";
            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } intc_time_out[17:17];
        field {
            name = "intc_symb_rcv";
            desc = "When IR_CFG[ir_mode] is 1, this bit indicates whether the RX symbol interrupt request is cleared.
- 0: no effect
- 1: cleared

Access type WC in the data sheet: written 1 clears the bit.";
            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } intc_symb_rcv[16:16];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_15_4[15:4];
        field {
            name = "intc_release";
            desc = "When IR_CFG[ir_mode] is 0, this bit indicates whether the key release interrupt request is cleared.
- 0: no effect
- 1: cleared

Access type WC in the data sheet: written 1 clears the bit.";
            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } intc_release[3:3];
        field {
            name = "intc_overflow";
            desc = "When IR_CFG[ir_mode] is 0, this bit indicates whether the RX data overflow error interrupt request is cleared.
- 0: no effect
- 1: cleared

Access type WC in the data sheet: written 1 clears the bit.";
            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } intc_overflow[2:2];
        field {
            name = "intc_frame_error";
            desc = "When IR_CFG[ir_mode] is 0, this bit indicates whether the RX data frame format error interrupt request is cleared.
- 0: no effect
- 1: cleared

Access type WC in the data sheet: written 1 clears the bit.";
            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } intc_frame_error[1:1];
        field {
            name = "intc_rcv";
            desc = "When IR_CFG[ir_mode] is 0, this bit indicates whether the RX data frame interrupt request is cleared.
- 0: no effect
- 1: cleared

If an RX data frame interrupt is generated and the software writes 1 to the bit without reading the data in IR_DATAL, the interrupt cannot be cleared.

Access type WC in the data sheet: written 1 clears the bit.";
            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } intc_rcv[0:0];
    } IR_INT_CLR @ 0x30;
    reg {
        name = "IR_START";
        desc = "IR_START is an IR start configuration register. After other registers are configured, IR_START can be started when any value is written to the corresponding address during the startup of the IR module. (offset 0x34; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 0.1, PDF page 1573).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_1[31:1];
        field {
            name = "ir_start";
            desc = "IR start configuration register";
            sw = w; hw = r;
            reset = 0x0;
        } ir_start[0:0];
    } IR_START @ 0x34;
};
