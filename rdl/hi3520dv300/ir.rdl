        } intms_symb_rcv[24:24];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_23_20[23:20];
        field {
            name = "intms_release";
            desc = "Masked key release interrupt status when IR_CFG[ir_mode] is 0
- 0: No interrupt is generated.
- 1: An interrupt is generated.";
            sw = r; hw = w;
            reset = 0x0;
        } intms_release[19:19];
        field {
