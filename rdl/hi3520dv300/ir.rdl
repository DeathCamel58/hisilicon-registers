        field {
            name = "intrs_release";
            desc = "Raw key release interrupt status when IR_CFG[ir_mode] is 0
- 0: No interrupt is generated.
- 1: An interrupt is generated.";
            sw = r; hw = w;
            reset = 0x0;
        } intrs_release[3:3];
        field {
