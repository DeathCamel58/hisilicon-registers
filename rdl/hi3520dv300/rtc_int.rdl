        regwidth = 8;
        field {
            name = "rtc_mr_d_l";
            desc = "Lower eight bits of the match value of the RTC day counter. This field works with RTC_MR_D_H to indicate the matched day. The day range is 0-65535.";
            sw = rw; hw = r;
            reset = 0xff;
        } rtc_mr_d_l[7:0];
    } RTC_MR_D_L @ 0xA;
    reg {
        name = "RTC_MR_D_H";
        desc = "RTC_MR_D_H is an upper-8-bit match value register for the RTC day counter. (offset 0xB; total reset 0x000000FF; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 3.10.7, PDF page 678).";
        regwidth = 8;
        field {
