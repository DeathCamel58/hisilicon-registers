            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_3[7:3];
        field {
            name = "rtc_lock_bypass";
            desc = "RTC lock enable
- 0: enabled. The RTC count value (0x00-0x05) is updated only after the RTC is successfully locked.
- 1: disabled. The RTC count value (0x00-0x05) is updated in real time.";
            sw = rw; hw = r;
            reset = 0x0;
        } rtc_lock_bypass[2:2];
        field {
            name = "rtc_lock";
            desc = "RTC lock. If software writes 1, this field is automatically cleared by hardware after the RTC is successfully locked. Note: This field is valid only when rtc_lock_bypass is 0.";
