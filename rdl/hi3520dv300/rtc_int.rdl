        desc = "RTC_D_COUNT_L is a lower-8-bit count value register for the RTC day counter. (offset 0x4; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 3.10.7, PDF page 675).";
        regwidth = 8;
        field {
