            sw = r; hw = w;
            reset = 0x0;
        } err_num0_buf0[31:0];
    } FMC_ERR_NUM0_BUF0 @ 0xC0;
    reg {
        name = "FMC_ERR_ALARM_ADDRH";
        desc = "FMC_ERR_ALARM_ADDRH is an upper-byte ECC alarm flash address register. (offset 0xD0; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.2.8, PDF page 981).";
        field {
