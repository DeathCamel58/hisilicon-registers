        desc = "FMC_ERR_ALARM_ADDRL is a lower-byte ECC alarm flash address register. (offset 0xD4; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.2.8, PDF page 982).";
        field {
            name = "fmc_err_alarm_addrl";
            desc = "Lower bytes of the operation address of the flash that triggers the last interrupt when an ECC alarm interrupt is generated";
            sw = r; hw = w;
            reset = 0x0;
        } fmc_err_alarm_addrl[31:0];
    } FMC_ERR_ALARM_ADDRL @ 0xD4;
