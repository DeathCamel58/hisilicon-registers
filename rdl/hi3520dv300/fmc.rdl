        desc = "FMC_BOOT_SET is a boot setting register. (offset 0x74; total reset 0x00000001; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.2.8, PDF page 977).";
        field {
