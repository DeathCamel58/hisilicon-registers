            reset = 0xffffff;
        } timeout_wr[23:0];
    } FMC_TIMEOUT_WR @ 0x6C;
    reg {
        name = "FMC_OP_PARA";
        desc = "FMC_OP_PARA is a data segment ID register for reading/writing to the SPI NAND flash in DMA mode. (offset 0x70; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.2.8, PDF page 977).";
        field {
