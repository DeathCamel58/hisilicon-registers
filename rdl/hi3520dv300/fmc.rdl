- 0: default boot mode
- 1: boot mode without configuring pins

The reset value is determined by the boot_page0_cfg pin.";
            sw = rw; hw = r;
            reset = 0x1;
        } boot_page0_cfg[0:0];
    } FMC_BOOT_SET @ 0x74;
    reg {
        name = "FMC_LP_CTRL";
        desc = "FMC_LP_CTRL is a low-power control register. (offset 0x78; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.2.8, PDF page 978).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_1[31:1];
        field {
            name = "clk_gate_en";
            desc = "Clock gating select. If the clock gating is enabled, the low-power design is used and the module working clocks are disabled by logic.
- 0: All clocks are enabled.
- 1: Clocks are disabled according to the low-power design.";
            sw = rw; hw = r;
            reset = 0x0;
        } clk_gate_en[0:0];
    } FMC_LP_CTRL @ 0x78;
    reg {
        name = "FMC_ERR_THD";
        desc = "FMC_ERR_THD is an ECC alarm threshold register. (offset 0xA8; total reset 0x000000FF; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.2.8, PDF page 979).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_8[31:8];
        field {
            name = "fmc_err_thd";
            desc = "ECC alarm threshold. When the number of error bits reaches the threshold, an ECC alarm interrupt is triggered. If an uncorrectable ECC error occurs, an uncorrectable interrupt is reported regardless of the register value. When the register value is set to 0 or 1, an alarm interrupt is reported as long as an error occurs. When the configured value exceeds the number of correctable error bits, no alarm interrupt is reported regardless of the number of error bits. Only the correctable error interrupt and uncorrectable error interrupt are generated.";
            sw = rw; hw = r;
            reset = 0xff;
        } fmc_err_thd[7:0];
    } FMC_ERR_THD @ 0xA8;
