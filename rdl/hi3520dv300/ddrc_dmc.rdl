    reg {
        name = "DDRC_CFG_SFC";
        desc = "DDRC_CFG_SFC is a DDRC software DDR command attribute register. (offset 0x210; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.8.2, PDF page 825).";
        field {
            name = "wait_en";
            desc = "Enable for exiting a period after the command execution is complete
- 0: disabled
- 1: enabled

The wait period is configured in DDRC_CFG_SFC_TIM.";
            sw = rw; hw = r;
            reset = 0x0;
        } wait_en[31:31];
        field {
            name = "pre_dis";
            desc = "Precharge command transmit disable
- 0: The precharge command is transmitted before the SFC command.
- 1: The precharge command is not transmitted before the SFC command, and the corresponding command is transmitted directly.";
            sw = rw; hw = r;
            reset = 0x0;
        } pre_dis[30:30];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_29_4[29:4];
        field {
            name = "cmd_type";
            desc = "DDR command configuration
- 0000: enter the deep power-down status
- 0001: exit the deep power down mode
- 0010: LMR command
- 0011: ZQCL command. In LPDDRX mode, the ZQ type is controlled by setting cmd_mrs. When cmd_mrs is 0xFF, 0x56, and 0xC3, the ZQ type is ZQINIT, ZQCS, and ZQRESET respectively. When cmd_mrs is set to other values, the ZQ type is

ZQCL.
- 0100: write command
- 0101: read command
- 0110: precharge all command
- 0111: read MRS command
- 1000: AREF command
- 1001: enter the self-refresh status
- 1010: exit the self-refresh status
- 1011: reserved
- 1111: DFI_CTRL_UPD_REQ/DFI_CTRL_UPD_ACK handshake for requesting the PHY to enter the refresh mode (this operation is not supported in this version)";
            sw = rw; hw = r;
            reset = 0x0;
        } cmd_type[3:0];
    } DDRC_CFG_SFC @ 0x210;
    reg {
