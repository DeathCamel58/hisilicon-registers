`ifndef HI3520DV300_DDRC_DMC_RDL
`define HI3520DV300_DDRC_DMC_RDL
regfile eHI3520DV300_DDRC_DMC {
    name = "DDRC DMC";
    desc = "DDRC DMC of the Hi3521A/Hi3520D V300 at base 0x1211_8000. 75 registers extracted programmatically from the Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10) (Table 4-11 Summary of DMC registers (Base address: 0x1211_8000)): register headings, offsets, total reset values, field bit ranges, access types, names, reset values and descriptions, with PDF page numbers in each register description. Field names, bit ranges, access types and offsets are exact; the free-text descriptions are taken from the cell text of the field table and were checked by sampling only. Hardware not verified.";
    reg {
        name = "DDRC_CTRL_SREF";
        desc = "DDRC_CTRL_SREF is a DDRC self-refresh control register. (offset 0x0; total reset 0x00000001; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.8.2, PDF page 794).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_2[31:2];
        field {
            name = "sref_done";
            desc = "DDR PHY self-refresh done
- 0: normal operating mode
- 1: The transition from 0 to 1 indicates that the DDR PHY completes all required operations after exiting the self-refresh status and the DMC can accept new requests.";
            sw = rw; hw = r;
            reset = 0x0;
        } sref_done[1:1];
        field {
            name = "sref_req";
            desc = "SDRAM self-refresh request
- 0: exit the self-refresh status
- 1: enter the self-refresh status";
            sw = rw; hw = r;
            reset = 0x1;
        } sref_req[0:0];
    } DDRC_CTRL_SREF @ 0x0;
    reg {
        name = "DDRC_CTRL_SFC";
        desc = "DDRC_CTRL_SFC is a DDRC software configuration command start register. (offset 0xC; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.8.2, PDF page 794).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_1[31:1];
        field {
            name = "cmd_req";
            desc = "Request of executing the configuration command of the DDRC
- 0: The command is not executed or the parameter is automatically cleared after the command is executed.
- 1: The command is requested to be executed.";
            sw = rw; hw = r;
            reset = 0x0;
        } cmd_req[0:0];
    } DDRC_CTRL_SFC @ 0xC;
    reg {
        name = "DDRC_CTRL_PERF";
        desc = "DDRC_CTRL_PERF is a DDRC performance statistics enable register. (offset 0x10; total reset 0x0014F000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.8.2, PDF page 795).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0xa7800;
        } reserved_31_1[31:1];
        field {
            name = "perf_en";
            desc = "Performance statistics mode
- 0: disabled
- 1: enabled

When perf_mode is 0 and this bit is enabled, the performance statistics register starts cyclic counting. When perf_mode is 1, this bit is automatically cleared after counting is complete.";
            sw = rw; hw = r;
            reset = 0x0;
        } perf_en[0:0];
    } DDRC_CTRL_PERF @ 0x10;
    reg {
        name = "DDRC_CFG_SREF";
        desc = "DDRC_CFG_SREF is a DDRC self-refresh configuration register. (offset 0x20; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.8.2, PDF page 796).";
        field {
            name = "asref_en";
            desc = "SDRAM automatic self-refresh enable
- 1: enabled
- 0: disabled

Each rank corresponds to one control bit. The rank automatically enters the self-refresh status only when DDRC_CFG_PD[PD_EN] and the asref_en corresponding to the rank are valid. This function is not supported in this version.";
            sw = r; hw = w;
            reset = 0x0;
        } asref_en[31:16];
        field {
            name = "sref_arefnum";
            desc = "Number of self-refresh operations initiated after DDR3 SDRAM exits the self-refresh status during the DFS process
- 0x0: No self-refresh operation is initiated. 0x1-0xF: n";
            sw = rw; hw = r;
            reset = 0x0;
        } sref_arefnum[15:12];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_11_9[11:9];
        field {
            name = "clk_switch";
            desc = "DDRC low-power clock switch. Whether to back press AXI interface command when the DDRC enters the low-power status (DDR self-refresh)
- 0: The interface commands are not back pressed, and an error is returned directly.
- 1: The interface commands are back pressed, and the original command is executed after the clock is switched.";
            sw = rw; hw = r;
            reset = 0x0;
        } clk_switch[8:8];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_5[7:5];
        field {
            name = "sref_odis";
            desc = "Output disable for the DDR command and data I/O in self-refresh mode
- 0: enabled
- 1: disabled

The configuration is a static configuration. It is recommended that this bit be set to 1 to disable the output of the DDR command and data I/O after the DDR enters the self-refresh status. It is recommended that this bit be set to 0 to enable the output of the DDR command and data I/O before the DDR exits the self-refresh status.";
            sw = rw; hw = r;
            reset = 0x0;
        } sref_odis[4:4];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_3_1[3:1];
        field {
            name = "sref_cc";
            desc = "SDRAM clock control in self-refresh mode
- 0: The SDRAM clock is enabled.
- 1: The SDRAM clock is disabled.";
            sw = rw; hw = r;
            reset = 0x0;
        } sref_cc[0:0];
    } DDRC_CFG_SREF @ 0x20;
    reg {
        name = "DDRC_CFG_INIT";
        desc = "DDRC_CFG_INIT is a DDR initialization configuration register. (offset 0x24; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.8.2, PDF page 797).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_8[31:8];
        field {
            name = "init_arefnum";
            desc = "Number of auto-refresh operations when the DDR3 SDRAM is being initialized 0x0-0x2: two 0x3-0xF: n";
            sw = rw; hw = r;
            reset = 0x0;
        } init_arefnum[7:0];
    } DDRC_CFG_INIT @ 0x24;
    reg {
        name = "DDRC_CFG_PD";
        desc = "DDRC_CFG_PD is a DDR power-down status register. (offset 0x28; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.8.2, PDF page 798).";
        field {
            name = "asref_prd";
            desc = "SDRAM self-refresh cycle. When the DDRC does not receive any command in consecutive asref_prd cycles, it forces the SDRAM to enter the self-refresh status. When a command is received, the DDRC forces the SDRAM to exit the self-refresh status. 0x0-0xFFF: (n x 16) clock cycles This field is valid only when asref_en is 1.";
            sw = r; hw = w;
            reset = 0x0;
        } asref_prd[31:20];
        field {
            name = "t_clk_cke";
            desc = "Relationship between CLK and CKE 0x0-0x7: Delay relative to CKE when the DDR PHY disables the DDR3 clock. The delay is related to the DDR PHY. This field can be set to 0 when the clock is disabled.";
            sw = rw; hw = r;
            reset = 0x0;
        } t_clk_cke[19:16];
        field {
            name = "pd_prd";
            desc = "SDRAM power-down cycle. When the DDRC does not receive any command in consecutive pd_prd cycles, it forces the SDRAM to enter the power-down status. When a command is received, the DDRC forces the SDRAM to exit the power-down status.
- 0x00: not enter the power-down status 0x01-0xFFF: n clock cycles

This field is valid only when pd_en is 1.";
            sw = rw; hw = r;
            reset = 0x0;
        } pd_prd[15:4];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_3_2[3:2];
        field {
            name = "pd_ac";
            desc = "SDRAM address command dynamic disable in power-down mode
- 1: disable the pin output
- 0: enable the pin output

This field is valid when pd_en is enabled. The control pins do not include CKE, ODT, CSN, and RESET_N.";
            sw = rw; hw = r;
            reset = 0x0;
        } pd_ac[1:1];
        field {
            name = "pd_en";
            desc = "Automatic power-down enable for the SDRAM
- 1: enabled
- 0: disabled";
            sw = rw; hw = r;
            reset = 0x0;
        } pd_en[0:0];
    } DDRC_CFG_PD @ 0x28;
    reg {
        name = "DDRC_CFG_AREF";
        desc = "DDRC_CFG_AREF is a DDRC auto-refresh mode register. (offset 0x2C; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.8.2, PDF page 799).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_16[31:16];
        field {
            name = "aref_alarm_num";
            desc = "The auto-refresh command is forced to be transmitted if a specific number of auto-refresh commands cannot be transmitted. 0x0-0xFF: lack of (n + 1) auto-refresh commands Only one auto-refresh command is considered when n is 255 because the upper bits are lost after the bits of the 8-bit counter are carried. In optimization mode (when aref_opt is 1), an alarm is generated when the number of postponed commands is greater than or equal to 15.";
            sw = rw; hw = r;
            reset = 0x0;
        } aref_alarm_num[15:8];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_5[7:5];
        field {
            name = "aref_alarm_en";
            desc = "Auto-refresh loss alarm enable (AREF function)
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } aref_alarm_en[4:4];
        field {
            name = "aref_dual_rank";
            desc = "REF command transmit mode select
- 0: The REF commands are transmitted to only one rank each time.
- 1: The REF commands are transmitted to two ranks each time.";
            sw = rw; hw = r;
            reset = 0x0;
        } aref_dual_rank[3:3];
        field {
            name = "aref_opt";
            desc = "Auto-refresh optimization enable
- 1: enabled
- 0: disabled

When this function is enabled, it is recommended that aref_mode be set to 00. The DMC dynamically detects whether the DDR is idle during each auto-refresh. If the DDR is idle, the AREF commands are transmitted; otherwise, the DMC waits until nine AREF cycles are reached. Then the DMC forcibly terminates the DDR access and inserts AREF commands.";
            sw = rw; hw = r;
            reset = 0x0;
        } aref_opt[2:2];
        field {
            name = "aref_mode";
            desc = "Auto-refresh mode
- 00: An auto-refresh operation is performed every one tREFI cycle.
- 01: Three auto-refresh operations are performed every three tREFI cycles.
- 10: Four auto-refresh operations are performed every five tREFI cycles.
- 11: Eight auto-refresh operations are performed every nine tREFI cycles.

Optimized auto-refresh mode
- 11: The maximum number of postponed commands is 8.
- 10: The maximum number of postponed commands is 4.
- 01: The maximum number of postponed commands is 2.
- 00: The maximum number of postponed commands is 1.";
            sw = rw; hw = r;
            reset = 0x0;
        } aref_mode[1:0];
    } DDRC_CFG_AREF @ 0x2C;
    reg {
        name = "DDRC_CFG_WORKMODE";
        desc = "DDRC_CFG_WORKMODE is a DDRC operating mode register. (offset 0x40; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.8.2, PDF page 800).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_14[31:14];
        field {
            name = "hdr_mode";
            desc = "DFI interface mode select
- 0: SDR mode
- 1: HDR mode

The Hi3521A supports only the HDR mode.";
            sw = rw; hw = r;
            reset = 0x0;
        } hdr_mode[13:13];
        field {
            name = "read_mode";
            desc = "DDRC read mode
- 0: associated read mode
- 1: delay read mode

The associated read mode is a mode in which the DDRC samples data based on the data valid signal from the PHY. The delay read mode is a mode in which the DDRC samples the data from the PHY after the internal delay of the DDRC.";
            sw = rw; hw = r;
            reset = 0x0;
        } read_mode[12:12];
        field {
            name = "addr_mode";
            desc = "DDR address line reverse mode select
- 00: The address is set to all 1s when the DDR is idle.
- 01: The status of the previous command is retained when the DDR is idle.
- 10: The status opposite to the previous status is restored when the DDR is idle.
- 11: reserved";
            sw = rw; hw = r;
            reset = 0x0;
        } addr_mode[11:10];
        field {
            name = "intlv_en";
            desc = "DMC burst interleave enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } intlv_en[9:9];
        field {
            name = "wrap_en";
            desc = "Wrap command optimization enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } wrap_en[8:8];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_5[7:5];
        field {
            name = "apre_en";
            desc = "Auto-precharge enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } apre_en[4:4];
        field {
            name = "func_clkon";
            desc = "Functional module clock enable
- 0: The clock is internally controlled.
- 1: The clock is forcibly enabled.";
            sw = rw; hw = r;
            reset = 0x0;
        } func_clkon[3:3];
        field {
            name = "data_clkon";
            desc = "Data channel clock enable
- 0: The clock is internally controlled.
- 1: The clock is forcibly enabled.";
            sw = rw; hw = r;
            reset = 0x0;
        } data_clkon[2:2];
        field {
            name = "cmd_clkon";
            desc = "Command channel clock enable
- 0: The clock is internally controlled.
- 1: The clock is forcibly enabled.";
            sw = rw; hw = r;
            reset = 0x0;
        } cmd_clkon[1:1];
        field {
            name = "clk_ratio";
            desc = "Operating mode of the DDRC
- 0: The ratio of the DDRC frequency to the PHY frequency is 1:1.
- 1: The ratio of the frequency of the DDRC to the frequency of the

PHY is 1:2. This field is fixed at 1 in this version.";
            sw = rw; hw = r;
            reset = 0x0;
        } clk_ratio[0:0];
    } DDRC_CFG_WORKMODE @ 0x40;
    reg {
        name = "DDRC_CFG_WORKMODE2";
        desc = "DDRC_CFG_WORKMODE2 is a DDRC operating mode register. (offset 0x44; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.8.2, PDF page 802).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_30[31:30];
        field {
            name = "openpage_time";
            desc = "Open page delay control 0x0-0x1: The open page function is disabled. 0x2-0x3fff: open page delay The open page function is disabled when DDRC_CFG_WORKMODE[apre_en] is enabled.";
            sw = rw; hw = r;
            reset = 0x0;
        } openpage_time[29:16];
        field {
            name = "rank_disable";
            desc = "Rank disable
- 0: normal operating mode
- 1: The auto-refresh/power-down/self-refresh function of a rank is disabled.";
            sw = rw; hw = r;
            reset = 0x0;
        } rank_disable[15:0];
    } DDRC_CFG_WORKMODE2 @ 0x44;
    reg {
        name = "DDRC_CFG_DDRMODE";
        desc = "DDRC_CFG_DDRMODE is a DDR operating mode register. (offset 0x50; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.8.2, PDF page 802).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_31[31:31];
        field {
            name = "bank_mode";
            desc = "Bank interleaving mode For 8-bit bus width:
- 000: 8-byte banks are interleaved.
- 001: 16-byte banks are interleaved. …
- 111: 1 KB banks are interleaved.

For 16-bit bus width:
- 000: 16-byte banks are interleaved.
- 001: 32-byte banks are interleaved. …
- 111: 2 KB banks are interleaved.

For 32-bit bus width:
- 000: 32-byte banks are interleaved.
- 001: 64-byte banks are interleaved. …
- 111: 4 KB banks are interleaved.

For 64-bit bus width:
- 000: 64-byte banks are interleaved.
- 001: 128-byte banks are interleaved. …
- 111: 8 KB banks are interleaved.

When the AXI is set to a non-zero value, this field must be set to 000 and the AXI configuration mode is used. When the AXI is set to 000, the DMC configuration mode is used.";
            sw = rw; hw = r;
            reset = 0x0;
        } bank_mode[30:28];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_27_26[27:26];
        field {
            name = "bank_xor";
            desc = "Scrambling enable for the bank address and row address
- 00: disabled
- 01: The bank address and offset address 0 are scrambled.
- 10: The bank address and offset address 1 are scrambled.
- 11: The bank address and offset address 2 are scrambled.";
            sw = rw; hw = r;
            reset = 0x0;
        } bank_xor[25:24];
        field {
            name = "asref_zqc_en";
            desc = "SDRAM ZQ enable when the ASREF exits.
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } asref_zqc_en[23:23];
        field {
            name = "sref_zqc_en";
            desc = "SDRAM ZQ enable when the SREF exits.
- 0: disabled
- 1: enabled

This field is valid only for the DDR3 SDRAM and is set to 0 by default. In addition, the value of this field cannot be dynamically changed during the self-refresh exit process.";
            sw = rw; hw = r;
            reset = 0x0;
        } sref_zqc_en[22:22];
        field {
            name = "rank";
            desc = "Number of DDRC ranks
- 00: 1
- 01: 2
- 10: 3
- 11: 4

When the number of external DDR ranks is greater than 4, this field is used to control four groups of ranks (0-3, 4-7, 8-11, and 12-16).";
            sw = rw; hw = r;
            reset = 0x0;
        } rank[21:20];
        field {
            name = "rank_mode";
            desc = "Rank interleaving mode
- 00: single rank mode
- 01: single rank mode
- 10: Two ranks are interleaved.
- 11: Four ranks are interleaved.

Multiple ranks can be interleaved only when the configuration of these ranks is the same; otherwise, unpredictable errors may occur.";
            sw = rw; hw = r;
            reset = 0x0;
        } rank_mode[19:18];
        field {
            name = "odt_on";
            desc = "Whether the ODT signal output to the SDRAM is fixed
- 0: The signal is automatically controlled by the DDRC.
- 1: The output is fixed at the wodt configuration of rank 0.";
            sw = rw; hw = r;
            reset = 0x0;
        } odt_on[17:17];
        field {
            name = "zqc_en";
            desc = "AREF ZQ command enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } zqc_en[16:16];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_15_15[15:15];
        field {
            name = "scramb_en";
            desc = "Data scrambling enable (The scrambling code is generated by using the address, and exclusive ORed with the data to reduce synchronous inversion).
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } scramb_en[14:14];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_13_13[13:13];
        field {
            name = "bc_en";
            desc = "DDR3 burst chop mode
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } bc_en[12:12];
        field {
            name = "reserved";
            desc = "Reserved. This bit must be fixed at 1'b0.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_11_11[11:11];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_10_9[10:9];
        field {
            name = "brstlen";
            desc = "Burst length of the DDRC When brstlen2 is set to 0:
- 1: BL8
- 0: BL4

When brstlen2 is set to 1:
- 1: BL32
- 0: BL16

The burst length of the DDR3 SDRAM can be set to only burst 8. The burst length is related to the clock ratio of the DMC to the PHY. The burst length is BLx/n (x indicates the burst type, that is, 4, 8, 16, or 32. n indicates that the clock ratio of the DMC to the PHY is 1:n). For example, when the clock ratio is 1:2, to set the DDRC burst length to BL32, set brstlen to 0 and brstlen2 to 1.";
            sw = rw; hw = r;
            reset = 0x0;
        } brstlen[8:8];
        field {
            name = "brstlen2";
            desc = "Burst length 2 of the DDRC
- 1: extended mode
- 0: basic mode

This field works with brstlen.";
            sw = rw; hw = r;
            reset = 0x0;
        } brstlen2[7:7];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_6_6[6:6];
        field {
            name = "mem_width";
            desc = "Bit width of the storage data bus
- 00: 8 bits
- 01: 16 bits
- 10: 32 bits
- 11: 64 bits";
            sw = rw; hw = r;
            reset = 0x0;
        } mem_width[5:4];
        field {
            name = "dram_type";
            desc = "External memory type
- 110: DDR3

Other values: reserved";
            sw = rw; hw = r;
            reset = 0x0;
        } dram_type[3:0];
    } DDRC_CFG_DDRMODE @ 0x50;
    reg {
        name = "DDRC_CFG_SCRAMB";
        desc = "DDRC_CFG_SCRAMB is a DDR data scrambling configuration register. (offset 0x58; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.8.2, PDF page 806).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_19[31:19];
        field {
            name = "dbi_low_act";
            desc = "DBI active level
- 0: active high
- 1: active low";
            sw = rw; hw = r;
            reset = 0x0;
        } dbi_low_act[18:18];
        field {
            name = "rd_dbi_en";
            desc = "Read DBI enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } rd_dbi_en[17:17];
        field {
            name = "wr_dbi_en";
            desc = "Read DBI enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } wr_dbi_en[16:16];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_15_5[15:5];
        field {
            name = "scramb_seed_type";
            desc = "Address mode for scrambling
- 0: Use the CS and BA for scrambling.
- 1: Use the CS, BA, and low bits of the row address for scrambling.";
            sw = rw; hw = r;
            reset = 0x0;
        } scramb_seed_type[4:4];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_3_3[3:3];
        field {
            name = "scramb_seed_sort";
            desc = "Address arrangement mode for scrambling
- 000: CS_BA_COL arrangement
- 001: CS_COL_BA arrangement
- 010: COL_CS_BA arrangement
- 011: COL_BA_CS arrangement
- 100: BA_CS_COL arrangement
- 101: BA_COL_CS arrangement

Other values: reserved";
            sw = rw; hw = r;
            reset = 0x0;
        } scramb_seed_sort[2:0];
    } DDRC_CFG_SCRAMB @ 0x58;
    reg {
        name = "DDRC_CFG_RNKVOL";
        desc = "DDRC_CFG_RNKVOL is a DDRC-controlled DDR capacity configuration register. (offset 0x60; total reset 0x00000022; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.8.2, PDF page 807).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_17[31:17];
        field {
            name = "mem_x4";
            desc = "4-bit external component combination mode
- 0: 8-/16-/32-bit external components are combined.
- 1: 4-bit external components are combined.";
            sw = rw; hw = r;
            reset = 0x0;
        } mem_x4[16:16];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_15_14[15:14];
        field {
            name = "mem_map";
            desc = "Address translation mode of the SDRAM
- 00: {Rank, Row, Ba, Col, DW} = AXI_Address
- 01: {Rank, Ba, Row, Col, DW}= AXI_Address
- 10: {Rank, Row, Ba, Col, cs, Col, DW}= AXI_Address
- 11: {Rank, Ba, Row, Col, cs, Col, DW}= AXI_Address

This parameter can be set to 10 or 11 only when DDRC_CONFIG1[dual_ch] is valid. When there are multiple ranks, the configuration must be the same for each rank. This field must be set to 00 in the current version.";
            sw = rw; hw = r;
            reset = 0x0;
        } mem_map[13:12];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_11_10[11:10];
        field {
            name = "mem_bank";
            desc = "Number of banks of a single SDRAM
- 00: 4 banks
- 01: 8 banks
- 10:16 banks
- 11: reserved";
            sw = rw; hw = r;
            reset = 0x0;
        } mem_bank[9:8];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_7[7:7];
        field {
            name = "mem_row";
            desc = "Bit width of the row address of a single SDRAM
- 000: 11 bits
- 001: 12 bits
- 010: 13 bits
- 011: 14 bits
- 100: 15 bits
- 101: 16 bits

Other values: reserved";
            sw = rw; hw = r;
            reset = 0x2;
        } mem_row[6:4];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_3_3[3:3];
        field {
            name = "mem_col";
            desc = "Bit width of the column address of a single SDRAM
- 000: 8 bits
- 001: 9 bits
- 010: 10 bits
- 011: 11 bits
- 100: 12 bits

Other values: reserved";
            sw = rw; hw = r;
            reset = 0x2;
        } mem_col[2:0];
    } DDRC_CFG_RNKVOL @ 0x60;
    reg {
        name = "DDRC_CFG_ODT";
        desc = "DDRC_CFG_ODT is a DDR ODT configuration register. (offset 0xA0; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.8.2, PDF page 808).";
        field {
            name = "rodt";
            desc = "ODT read enable for other RANKs when the current RANK transmits the read command
- 1: enabled
- 0: disabled";
            sw = rw; hw = r;
            reset = 0x0;
        } rodt[31:16];
        field {
            name = "wodt";
            desc = "ODT write enable for other RANKs when the current RANK transmits the write command
- 1: enabled
- 0: disabled";
            sw = rw; hw = r;
            reset = 0x0;
        } wodt[15:0];
    } DDRC_CFG_ODT @ 0xA0;
    reg {
        name = "DDRC_CFG_EMRS01";
        desc = "DDRC_CFG_EMRS01 is a configuration register for DDR mode register 0 and mode register 1. (offset 0xF0; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.8.2, PDF page 809).";
        field {
            name = "emrs1";
            desc = "DDR3 SDRAM extended mode register 1 This field corresponds to valid bits 13-0 of mode register 1 (MR1) in the DDR3 SDRAM user manual. MR1[15:14] of most DDRs are not used. DDRC_CFG_EMRS01[31:30] are reserved and set to 2'b00. For details about MR1, see the DDR3 SDRAM user manual.";
            sw = rw; hw = r;
            reset = 0x0;
        } emrs1[31:16];
        field {
            name = "mrs";
            desc = "DDR3 SDRAM mode register This field corresponds to valid bits 13-0 of mode register 0 (MR0) in the DDR3 SDRAM user manual. MR0[15:14] of most DDRs are not used. DDRC_CFG_EMRS01[15:14] are reserved and set to 2'b00. For details about MR0, see the DDR3 SDRAM user manual.";
            sw = rw; hw = r;
            reset = 0x0;
        } mrs[15:0];
    } DDRC_CFG_EMRS01 @ 0xF0;
    reg {
        name = "DDRC_CFG_EMRS23";
        desc = "DDRC_CFG_EMRS23 is a configuration register for DDR mode register 2 and mode register 3. (offset 0xF4; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.8.2, PDF page 809).";
        field {
            name = "emrs3";
            desc = "DDR3 SDRAM extended mode register 3 This field corresponds to valid bits 13-0 of mode register 3 (MR3) in the DDR3 SDRAM user manual. MR3[15:14] of most DDRs are not used. DDRC_CFG_EMRS23[31:30] are reserved and set to 2'b00. For details about MR3, see the DDR3 SDRAM user manual.";
            sw = rw; hw = r;
            reset = 0x0;
        } emrs3[31:16];
        field {
            name = "emrs2";
            desc = "DDR3 SDRAM extended mode register 2 This field corresponds to valid bits 13-0 of mode register 2 (MR2) in the DDR3 SDRAM user manual. MR2[15:14] of most DDRs are not used. DDRC_CFG_EMRS23[15:14] are reserved and set to 2'b00. For details about MR2, see the DDR3 SDRAM user manual.";
            sw = rw; hw = r;
            reset = 0x0;
        } emrs2[15:0];
    } DDRC_CFG_EMRS23 @ 0xF4;
    reg {
        name = "DDRC_CFG_TIMING0";
        desc = "DDRC_CFG_TIMING0 is DDRC timing parameter register 0. (offset 0x100; total reset 0xFFFFFF3F; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.8.2, PDF page 810).";
        field {
            name = "tmrd";
            desc = "Number of wait cycles for the load mode register (LMR) command. The value is tMRD for the DDR3. 0x0-0x1: 1 clock cycle 0x2-0xF: n clock cycles";
            sw = rw; hw = r;
            reset = 0xf;
        } tmrd[31:28];
        field {
            name = "trrd";
            desc = "Number of wait cycles from ACT bank A to ACT bank B 0x0-0x1: 1 clock cycle 0x2-0xF: n clock cycles";
            sw = rw; hw = r;
            reset = 0xf;
        } trrd[27:24];
        field {
            name = "trp";
            desc = "Number of wait cycles for the disable command (PRE period) 0x0-0x1: 1 clock cycle 0x2-0xF: n clock cycles";
            sw = rw; hw = r;
            reset = 0x1f;
        } trp[23:19];
        field {
            name = "trcd";
            desc = "Number of wait cycles from the ACT bank command to the read or write command 0x0-0x3: 3 clock cycles 0x4-0xF: n clock cycles";
            sw = rw; hw = r;
            reset = 0x1f;
        } trcd[18:14];
        field {
            name = "trc";
            desc = "Number of wait cycles from an ACT bank command to the next ACT bank command 0x00-0x01: 1 clock cycle 0x02-0x3F: n clock cycles";
            sw = rw; hw = r;
            reset = 0x3f;
        } trc[13:8];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_6[7:6];
        field {
            name = "tras";
            desc = "Number of wait cycles from the ACT bank command to the disable command (PRE) 0x0-0x1: 1 clock cycle 0x2-0xF: n clock cycles Others: Reserved.";
            sw = rw; hw = r;
            reset = 0x3f;
        } tras[5:0];
    } DDRC_CFG_TIMING0 @ 0x100;
    reg {
        name = "DDRC_CFG_TIMING1";
        desc = "DDRC_CFG_TIMING1 is DDRC timing parameter register 1. (offset 0x84; total reset 0xFF2215FF; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.8.2, PDF page 811).";
        field {
            name = "tsre";
            desc = "Number of wait cycles from the self-refresh exit command to the read command
- 0x0: reserved 0x01-0xFF: (n x 4) clock cycles

This field is set to the larger value between tXSDLL and tXS for the DDR3 SDRAM.";
            sw = rw; hw = r;
            reset = 0xff;
        } tsre[31:24];
        field {
            name = "trtw";
            desc = "Delay from the last read data command to the first write data command 0x0-0x1: 1 clock cycle 0x2-0xF: (n + 1) clock cycles In DDR3 mode, the field value depends on the latency of the board, package, and I/O.";
            sw = rw; hw = r;
            reset = 0x2;
        } trtw[23:20];
        field {
            name = "twl";
            desc = "Number of wait cycles from the write command to the write data command 0x0-0x1: 1 clock cycle 0x2-0xF: n clock cycles For example, 0x3 indicates three clock cycles. The clock cycle is the DDR3 clock cycle.";
            sw = rw; hw = r;
            reset = 0x4;
        } twl[19:15];
        field {
            name = "tcl";
            desc = "Column address strobe (CAS) latency from the read command to the read data operation 0x0-0x1: 1 clock cycle 0x2-0xF: n clock cycles The clock cycle is the DDR3 clock cycle.";
            sw = rw; hw = r;
            reset = 0x5;
        } tcl[14:10];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_9_9[9:9];
        field {
            name = "trfc";
            desc = "Number of wait cycles for the AREF period or AREF to the ACT command. The field value is set to the maximum value of max{trfc, tzqcs}.
- 0x00: reserved 0x01-0x1FF: n clock cycles";
            sw = rw; hw = r;
            reset = 0x1ff;
        } trfc[8:0];
    } DDRC_CFG_TIMING1 @ 0x84;
    reg {
        name = "DDRC_CFG_TIMING2";
        desc = "DDRC_CFG_TIMING2 is DDRC timing parameter register 2. (offset 0x108; total reset 0xF303F000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.8.2, PDF page 812).";
        field {
            name = "tcke";
            desc = "Minimum cycle of retaining the self-refresh mode
- 0x0: reserved 0x1-0xF: n clock cycles

The field value must be the maximum value among tCKESR, tCKSRE, tCKSRX, and tCKE.";
            sw = rw; hw = r;
            reset = 0xf;
        } tcke[31:28];
        field {
            name = "twtr";
            desc = "Number of wait cycles for the last write data to the write-to-read command 0x0-0x1: 1 clock cycle 0x2-0xF: n clock cycles For example, 0x3 indicates three clock cycles.";
            sw = rw; hw = r;
            reset = 0x3;
        } twtr[27:24];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_23_18[23:18];
        field {
            name = "tfaw";
            desc = "Number of clock cycles for four consecutive activation commands 0x00-0x3F: n clock cycles For example, 0x14 indicates 20 clock cycles.";
            sw = rw; hw = r;
            reset = 0x3f;
        } tfaw[17:12];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_11_11[11:11];
        field {
            name = "taref";
            desc = "Number of auto-refresh cycles
- 0x000: forbidden 0x001-0x7FF: The auto-refresh cycle of the SDRAM is (16 x n) clock cycles.

For example, 0x008 indicates 128 (16 x 8) clock cycles. The interval tREFI is 7800/16/tclk. Tclk is twice the running cycle of the SDRAM.";
            sw = rw; hw = r;
            reset = 0x0;
        } taref[10:0];
    } DDRC_CFG_TIMING2 @ 0x108;
    reg {
        name = "DDRC_CFG_TIMING3";
        desc = "DDRC_CFG_TIMING3 is DDRC timing parameter register 3. (offset 0x10C; total reset 0xFFFFE0F2; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.8.2, PDF page 813).";
        field {
            name = "tzq_prd";
            desc = "Number of ZQCS command cycles
- 0x000: The ZQCS command is forbidden. 0x001-0x3FF: (n x 128) AREF cycles

The number of ZQCS command cycles is equal to (n x 128) taref clock cycles.";
            sw = rw; hw = r;
            reset = 0x3ff;
        } tzq_prd[31:22];
        field {
            name = "tzqinit";
            desc = "Number of ZQ initialization delay cycles 0x0-0x1FF: (n x 4) clock cycles The value needs to be set to the larger value between tZQINIT and tDLLK.";
            sw = rw; hw = r;
            reset = 0x1ff;
        } tzqinit[21:13];
        field {
            name = "taond";
            desc = "Number of ODT enable/disable cycles In DDR3 mode, this value is set to tWL - 2 (tWL is DDRC_CFG_TIMING1[twl]).";
            sw = rw; hw = r;
            reset = 0x0;
        } taond[12:8];
        field {
            name = "txard";
            desc = "Number of wait cycles of exiting the DDR low-power mode 0x0-0xF: n clock cycles (in decimal) For example, 0x7 indicates seven clock cycles. The field value is the maximum value among tXP, tXARD, tXARDS, and tXS. In DDR3 mode, the field value is the larger value between tXP and tCKE.";
            sw = rw; hw = r;
            reset = 0xf;
        } txard[7:4];
        field {
            name = "trtp";
            desc = "Wait delay from the read command to the disable command 000-010: 2 clock cycles";
            sw = rw; hw = r;
            reset = 0x2;
        } trtp[3:0];
    } DDRC_CFG_TIMING3 @ 0x10C;
    reg {
        name = "DDRC_CFG_TIMING4";
        desc = "DDRC_CFG_TIMING4 is DDRC timing parameter register 4. (offset 0x110; total reset 0x01FF2000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.8.2, PDF page 814).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_25[31:25];
        field {
            name = "tmod";
            desc = "Delay from the MRS command to ODT and ZQCL validity 0x0-0x1: 1 clock cycle 0x2-0x1F: n clock cycles";
            sw = rw; hw = r;
            reset = 0x1f;
        } tmod[24:20];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0xf2000;
        } reserved_19_0[19:0];
    } DDRC_CFG_TIMING4 @ 0x110;
    reg {
        name = "DDRC_CFG_TIMING5";
        desc = "DDRC_CFG_TIMING5 is DDRC timing parameter register 5. (offset 0x114; total reset 0x1113FF1F; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.8.2, PDF page 814).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x1113;
        } reserved_31_16[31:16];
        field {
            name = "tzqcs";
            desc = "ZQCS calibration delay cycle 0x0-0xFF: (n x 2) clock cycles The field value must be greater than or equal to 10 because of the DMC design.";
            sw = rw; hw = r;
            reset = 0xff;
        } tzqcs[15:8];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_5[7:5];
        field {
            name = "twr";
            desc = "Number of wait cycles of write recovery 0x0-0x1: one clock cycle 0x2-0x1F: n clock cycles When the DFS is required, tWR must be set based on the highest chip frequency that may be used. tWR cannot be changed when the DDR frequency changes.";
            sw = rw; hw = r;
            reset = 0x1f;
        } twr[4:0];
    } DDRC_CFG_TIMING5 @ 0x114;
    reg {
        name = "DDRC_CFG_TIMING6";
        desc = "DDRC_CFG_TIMING6 is DDRC timing parameter register 6. (offset 0x118; total reset 0x000000FF; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.8.2, PDF page 815).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_24[31:24];
        field {
            name = "trrd_l";
            desc = "Number of trrd wait cycles between bank groups 0x0-0x1: one clock cycle 0x2-0xF: n clock cycles";
            sw = rw; hw = r;
            reset = 0x0;
        } trrd_l[23:20];
        field {
            name = "twtr_l";
            desc = "Number of twtr wait cycles between bank groups 0x0-0x1: one clock cycle 0x2-0xF: n clock cycles";
            sw = rw; hw = r;
            reset = 0x0;
        } twtr_l[19:16];
        field {
            name = "tccd_l";
            desc = "Number of tccd wait cycles between bank groups 0x0-0x1: one clock cycle 0x2-0xF: n clock cycles";
            sw = rw; hw = r;
            reset = 0x0;
        } tccd_l[15:12];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_11_8[11:8];
        field {
            name = "tcksrx";
            desc = "tCKSRX for the DDR3. Number of advanced valid beats before the DDR exits the self-refresh status. 0x0-0x1: one clock cycle 0x2-0xF: n clock cycles";
            sw = rw; hw = r;
            reset = 0xf;
        } tcksrx[7:4];
        field {
            name = "tcksre";
            desc = "tCKSRE for the DDR3. Number of beats to be retained after the DDR enters the self-refresh status. 0x0-0x1: one clock cycle 0x2-0xF: n clock cycles";
            sw = rw; hw = r;
            reset = 0xf;
        } tcksre[3:0];
    } DDRC_CFG_TIMING6 @ 0x118;
    reg {
        name = "DDRC_CFG_NXT_TIMING0";
        desc = "DDRC_CFG_NXT_TIMING0 is DDRC timing parameter register 0 for switching the frequency. (offset 0x120; total reset 0xFFFFFF3F; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.8.2, PDF page 816).";
        field {
            name = "tmrd";
            desc = "Number of wait cycles for the loading command of the LMR 0x0 and 0x1: one clock cycle 0x2-0xF: n clock cycles";
            sw = rw; hw = r;
            reset = 0xf;
        } tmrd[31:28];
        field {
            name = "trrd";
            desc = "Number of wait cycles from ACT bank A to ACT bank B 0x0 and 0x1: one clock cycle 0x2-0xF: n clock cycles";
            sw = rw; hw = r;
            reset = 0xf;
        } trrd[27:24];
        field {
            name = "trp";
            desc = "Number of wait cycles for the disable command (PRE period) 0x0 and 0x1: one clock cycle 0x2-0xF: n clock cycles";
            sw = rw; hw = r;
            reset = 0x1f;
        } trp[23:19];
        field {
            name = "trcd";
            desc = "Number of wait cycles from the ACT bank command to the read or write command 0x0-0x3: three clock cycles 0x4-0xF: n clock cycles";
            sw = rw; hw = r;
            reset = 0x1f;
        } trcd[18:14];
        field {
            name = "trc";
            desc = "Number of wait cycles from an ACT bank command to the next ACT bank command 0x00-0x01: one clock cycle 0x02-0x3F: n clock cycles";
            sw = rw; hw = r;
            reset = 0x3f;
        } trc[13:8];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_6[7:6];
        field {
            name = "tras";
            desc = "Number of wait cycles from the ACT bank command to the disable command (PRE) 0x00-0x01: one clock cycle 0x02-0x3F: n clock cycles tras is obtained from DDR user manuals. If DDRC_CFG_WORKMODE[clk_ration] is 1, convert the time specified in the DDR user manuals into the DDR clock cycle and then divide it by 2. If the value has a remainder, add 1 to the value. If DDRC_CFG_WORKMODE[clk_ration] is 0, convert the time specified in the DDR user manuals into the DDR clock cycle and then use it directly.";
            sw = rw; hw = r;
            reset = 0x3f;
        } tras[5:0];
    } DDRC_CFG_NXT_TIMING0 @ 0x120;
    reg {
        name = "DDRC_CFG_NXT_TIMING1";
        desc = "DDRC_CFG_NXT_TIMING1 is DDRC timing parameter register 1 for switching the frequency. (offset 0x124; total reset 0xFF2215FF; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.8.2, PDF page 817).";
        field {
            name = "tsre";
            desc = "Number of wait cycles from the self-refresh exit command to the read command
- 0x0: one clock cycle 0x01-0xFF: (n x 4) clock cycles

When the DDR3 SDRAM is used, the value is set to tXSDLL.";
            sw = rw; hw = r;
            reset = 0xff;
        } tsre[31:24];
        field {
            name = "trtw";
            desc = "Delay from the last read data command to the first write data command 0x0 and 0x1: one clock cycle 0x2-0xF: (n + 1) clock cycles";
            sw = rw; hw = r;
            reset = 0x2;
        } trtw[23:20];
        field {
            name = "twl";
            desc = "Number of wait cycles from the write command to the data write operation 0x0 and 0x1: one clock cycle 0x2-0xF: n clock cycles For example, 0x3 indicates three clock cycles. The clock cycle is the DDR3 clock cycle.";
            sw = rw; hw = r;
            reset = 0x4;
        } twl[19:15];
        field {
            name = "tcl";
            desc = "Column address strobe latency (CL) from the read command to the data read operation 0x0 and 0x1: one clock cycle 0x2-0xF: n clock cycles The clock cycle is the DDR3 clock cycle.";
            sw = rw; hw = r;
            reset = 0x5;
        } tcl[14:10];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_9_9[9:9];
        field {
            name = "trfc";
            desc = "Number of wait cycles for the AREF period or AREF to the ACT command. The field value is set to the maximum value of max{trfc, tzqcs}. 0x00-0x01: one clock cycle 0x02-0xFF: n clock cycles";
            sw = rw; hw = r;
            reset = 0x1ff;
