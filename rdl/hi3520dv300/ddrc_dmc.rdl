    reg {
        name = "DDRC_HIS_FLUXID_RCMD";
        desc = "DDRC_HIS_FLUXID_RCMD is a DDRC all ID read command count register. (offset 0x39C; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.8.2, PDF page 843).";
        field {
            name = "fluxid_rd_cmd";
            desc = "Read command count of the master based on specified IDs. The counting is performed in the valid statistics cycle. When perf_mode is 0, the value is wrapped when an overflow occurs. When perf_mode is 1, the value is retained when an overflow occurs. This field is cleared when the next statistics start.";
            sw = r; hw = w;
            reset = 0x0;
        } fluxid_rd_cmd[31:0];
    } DDRC_HIS_FLUXID_RCMD @ 0x39C;
    reg {
        name = "DDRC_HIS_WLATCNT0";
        desc = "DDRC_HIS_WLATCNT0 is DDRC specified ID write command latency statistics register 0. (offset 0x3A0; total reset 0x0000FFFF; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.8.2, PDF page 844).";
        field {
            name = "wlatcnt_max";
            desc = "Maximum latency of the write command with the specified ID of the DDRC This field is cleared when the next statistics start.";
            sw = r; hw = w;
            reset = 0x0;
        } wlatcnt_max[31:16];
        field {
            name = "wlatcnt_min";
            desc = "Minimum latency of the write command with the specified ID of the DDRC. The maximum value is retained if an overflow occurs. This field is cleared when the next statistics start.";
            sw = r; hw = w;
            reset = 0xffff;
        } wlatcnt_min[15:0];
    } DDRC_HIS_WLATCNT0 @ 0x3A0;
    reg {
        name = "DDRC_HIS_WLATCNT1";
        desc = "DDRC_HIS_WLATCNT1 is DDRC specified ID write command latency statistics register 1. (offset 0x3A4; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.8.2, PDF page 844).";
        field {
            name = "wlatcnt_all";
            desc = "Accumulated latency of the write command with the specified ID in the statistics cycle (the results of the lower four bits are ignored) When perf_mode is 0, the value is wrapped when an overflow occurs. When perf_mode is 1, the value is retained when an overflow occurs. This field is cleared when the next statistics start. Software can obtain the average latency of the write command with the specified ID by dividing wlatcnt_all by fluxid_wr_cmd.";
            sw = r; hw = w;
            reset = 0x0;
        } wlatcnt_all[31:0];
    } DDRC_HIS_WLATCNT1 @ 0x3A4;
    reg {
        name = "DDRC_HIS_RLATCNT0";
        desc = "DDRC_HIS_RLATCNT0 is a DDRC specified ID read command latency statistics register 0. (offset 0x3A8; total reset 0x0000FFFF; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.8.2, PDF page 845).";
        field {
            name = "rlatcnt_max";
            desc = "Maximum latency of the read command with the specified ID of the DDRC The actual maximum read latency is rlatcnt_max plus inhere_rlatcnt. The maximum value is retained if an overflow occurs. This field is cleared when the next statistics start.";
            sw = r; hw = w;
            reset = 0x0;
        } rlatcnt_max[31:16];
        field {
            name = "rlatcnt_min";
            desc = "Minimum latency of the read command with the specified ID of the DDRC Note that the actual minimum read latency is rlatcnt_min plus inhere_rlatcnt. The maximum value is retained if an overflow occurs. This field is cleared when the next statistics start.";
            sw = r; hw = w;
            reset = 0xffff;
        } rlatcnt_min[15:0];
    } DDRC_HIS_RLATCNT0 @ 0x3A8;
    reg {
        name = "DDRC_HIS_RLATCNT1";
        desc = "DDRC_HIS_RLATCNT1 is DDRC specified ID read command latency statistics register 1. (offset 0x3AC; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.8.2, PDF page 845).";
        field {
            name = "rlatcnt_all";
            desc = "Accumulated latency of the read command with the specified ID in the statistics cycle (the results of the lower four bits are ignored) When perf_mode is 0, the value is wrapped when an overflow occurs. When perf_mode is 1, the value is retained when an overflow occurs. This field is cleared when the next statistics start. Software can obtain the average latency of the read command with the specified ID by using rlatcnt_all/fluxid_rd_cmd+inhere_rlatcnt.";
            sw = r; hw = w;
            reset = 0x0;
        } rlatcnt_all[31:0];
    } DDRC_HIS_RLATCNT1 @ 0x3AC;
    reg {
        name = "DDRC_HIS_INHERE_RLAT_CNT";
        desc = "DDRC_HIS_INHERE_RLAT_CNT is a read channel inherent latency register. (offset 0x3B0; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.8.2, PDF page 846).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_16[31:16];
        field {
            name = "inhere_rlatcnt";
            desc = "Inherent latency of the read data channel for the DDRC and PHY. The actual latency can be obtained only by using this register and rlatcnt_min, rlatcnt_max, rlatcnt_all, and fluxid_rd_cmd.";
            sw = r; hw = w;
            reset = 0x0;
        } inhere_rlatcnt[15:0];
    } DDRC_HIS_INHERE_RLAT_CNT @ 0x3B0;
    reg {
        name = "DDRC_STACMD_RPT";
        desc = "DDRC_STACMD_RPT is the read pointer to the DMC accumulated command count register. (offset 0x3B8; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.8.2, PDF page 846).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_3[31:3];
        field {
            name = "stacmd_rpt";
            desc = "In threshold-based statistical mode, the latest eight load statistical results are stored. This pointer is used to indicate the statistical result that the read DDRC_HIS_CMD_SUM value points to.
- 000: latest statistical result
- 001: second to the latest statistical result …
- 111: latest seventh statistical result";
            sw = rw; hw = r;
            reset = 0x0;
        } stacmd_rpt[2:0];
    } DDRC_STACMD_RPT @ 0x3B8;
    reg {
        name = "DDRC_HIS_CMD_SUM";
        desc = "DDRC_HIS_CMD_SUM is a DDRC accumulated command count register. (offset 0x3BC; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.8.2, PDF page 847).";
        field {
            name = "dmc_cmd_sum";
            desc = "Accumulated value of the commands that are temporarily stored in the DMC in the cycle. The value is wrapped if an overflow occurs.";
            sw = r; hw = w;
            reset = 0x0;
        } dmc_cmd_sum[31:0];
    } DDRC_HIS_CMD_SUM @ 0x3BC;
    reg {
        name = "DDRC_HIS_SFC_RDATA0";
        desc = "DDRC_HIS_SFC_RDATA0 is SFC read data register 0. (offset 0x4A8; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.8.2, PDF page 847).";
        field {
            name = "rdata0";
            desc = "Bits 31-0 of the data read by the SFC";
            sw = r; hw = w;
            reset = 0x0;
        } rdata0[31:0];
    } DDRC_HIS_SFC_RDATA0 @ 0x4A8;
    reg {
        name = "DDRC_HIS_SFC_RDATA1";
        desc = "DDRC_HIS_SFC_RDATA1 is an SFC read data register. (offset 0x4AC; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.8.2, PDF page 847).";
        field {
            name = "rdata1";
            desc = "Bits 63-32 of the data read by the SFC";
            sw = r; hw = w;
            reset = 0x0;
        } rdata1[31:0];
    } DDRC_HIS_SFC_RDATA1 @ 0x4AC;
    reg {
        name = "DDRC_HIS_SFC_RDATA2";
        desc = "DDRC_HIS_SFC_RDATA2 is an SFC read data register. (offset 0x4B0; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.8.2, PDF page 848).";
        field {
            name = "rdata2";
            desc = "Bits 95-64 of the data read by the SFC";
            sw = r; hw = w;
            reset = 0x0;
        } rdata2[31:0];
    } DDRC_HIS_SFC_RDATA2 @ 0x4B0;
    reg {
        name = "DDRC_HIS_SFC_RDATA3";
        desc = "DDRC_HIS_SFC_RDATA3 is software configuration read data register 3. (offset 0x4B4; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.8.2, PDF page 848).";
        field {
            name = "rdata3";
            desc = "Bits 127-96 of the data read by the SFC";
            sw = rw; hw = r;
            reset = 0x0;
        } rdata3[31:0];
    } DDRC_HIS_SFC_RDATA3 @ 0x4B4;
};
`endif
