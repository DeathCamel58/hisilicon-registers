        desc = "DDRC_CFG_SFC_ADDR0 is read/write memory address register 0 for the software configuration module. (offset 0x214; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.8.2, PDF page 826).";
        field {
