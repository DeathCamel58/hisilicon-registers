        field {
            name = "dmc_dat_min";
            desc = "Minimum threshold for data statistics. When the data statistical value is less than or equal to this threshold, an interrupt is reported. The threshold is a multiple of 32. That is, if this field is set to n, the actual threshold is n x 32.";
            sw = rw; hw = r;
            reset = 0x0;
        } dmc_dat_min[27:0];
    } DATMIN @ 0x258;
    reg {
