        field {
            name = "inner_bclk_ws_sel_tx_00";
            desc = "Internal BCLK select for TX channel 0
- 0000: BCLK0
- 0001: BCLK1
- 1000: BCLK8
- 1001: BCLK9

Other values: reserved";
            sw = rw; hw = r;
            reset = 0x0;
        } inner_bclk_ws_sel_tx_00[3:0];
    } AIAO_SWITCH_TX_BCLK @ 0x2C;
    reg {
        name = "AIAO_STATUS";
        desc = "AIAO_STATUS is an AIAO status register. (offset 0x30; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 12.1.6, PDF page 1442).";
        field {
            name = "reserved";
