            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_1[31:1];
        field {
            name = "srst_rdy";
            desc = "Soft reset status
- 0: resetting
- 1: reset completed";
            sw = r; hw = w;
            reset = 0x0;
        } srst_rdy[0:0];
    } AIAO_STATUS @ 0x30;
    reg {
        name = "VHB_OUTSTANDING";
        desc = "VHB_OUTSTANDING is a VHB outstanding configuration register. (offset 0x34; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 12.1.6, PDF page 1443).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_3[31:3];
        field {
            name = "vhb_outst_num";
            desc = "Number of VHB outstandings The recommended value is 3.";
            sw = w; hw = r;
            reset = 0x0;
        } vhb_outst_num[2:0];
    } VHB_OUTSTANDING @ 0x34;
    reg {
        name = "I2S_CRG_CFG0_00";
        desc = "I2S_CRG_CFG0_00 is I2S00 CRG configuration register 0. (offset 0x100; total reset 0x00AAAAAA; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 12.1.6, PDF page 1443).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_27[31:27];
        field {
            name = "aiao_mclk_div";
            desc = "Clock divider of the MCLK. The configured value is calculated as follows: (Frequency of the target MCLK clock/Frequency of the MCLK PLL source clock) x 2^27. For details about the frequency of the MCLK PLL source clock, see section 3.2 \"Clock\" in chapter 3 \"System.\"";
            sw = rw; hw = r;
            reset = 0xaaaaaa;
        } aiao_mclk_div[26:0];
    } I2S_CRG_CFG0_00 @ 0x100;
    reg {
        name = "I2S_CRG_CFG1_00";
        desc = "I2S_CRG_CFG1_00 is I2S00 CRG configuration register 1. (offset 0x104; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 12.1.6, PDF page 1444).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_14[31:14];
        field {
            name = "aiao_bclkout_pctrl";
            desc = "BCLKOUT polarity
- 0: positive
- 1: negative";
            sw = rw; hw = r;
            reset = 0x0;
        } aiao_bclkout_pctrl[13:13];
        field {
            name = "aiao_bclkin_pctrl";
            desc = "BCLKIN polarity
- 0: positive
- 1: negative";
            sw = rw; hw = r;
            reset = 0x0;
        } aiao_bclkin_pctrl[12:12];
        field {
            name = "aiao_bclk_sel";
            desc = "BCLK/FCLK select
- 0: Clocks are internally generated.
- 1: Clocks are input from the external audio DAC.";
            sw = rw; hw = r;
            reset = 0x0;
        } aiao_bclk_sel[11:11];
        field {
            name = "aiao_bclk_oen";
            desc = "BCLK/FCLK I/O OEN control
- 0: The BCLK/FCLK I/O is output.
- 1: The BCLK/FCLK I/O is input.

Note: This field needs to work with aiao_bclk_sel to select the master/slave mode of the I2S interface.";
            sw = rw; hw = r;
            reset = 0x0;
        } aiao_bclk_oen[10:10];
        field {
            name = "aiao_srst_req";
            desc = "Soft reset request
- 0: deassert reset
- 1: reset";
            sw = rw; hw = r;
            reset = 0x0;
        } aiao_srst_req[9:9];
        field {
            name = "aiao_cken";
            desc = "Clock status
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } aiao_cken[8:8];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_7[7:7];
        field {
            name = "aiao_fsclk_div";
            desc = "Frequency division relationship between the bit clock BCLK and the sampling clock FS
- 000: The FS is obtained by dividing the BCLK by 16.
- 001: The FS is obtained by dividing the BCLK by 32.
- 010: The FS is obtained by dividing the BCLK by 48.
- 011: The FS is obtained by dividing the BCLK by 64.
- 100: The FS is obtained by dividing the BCLK by 128.
- 101: The FS is obtained by dividing the BCLK by 256.

Other values: The FS is obtained by dividing the BCLK by 8.";
            sw = rw; hw = r;
            reset = 0x0;
        } aiao_fsclk_div[6:4];
        field {
            name = "aiao_bclk_div";
            desc = "Frequency division relationship between the main clock MCLK and the bit clock BCLK
- 0000: The BCLK is obtained by dividing the MCLK by 1.
- 0001: The BCLK is obtained by dividing the MCLK by 3.
- 0010: The BCLK is obtained by dividing the MCLK by 2.
- 0011: The BCLK is obtained by dividing the MCLK by 4.
- 0100: The BCLK is obtained by dividing the MCLK by 6.
- 0101: The BCLK is obtained by dividing the MCLK by 8.
- 0110: The BCLK is obtained by dividing the MCLK by 12.
- 0111: The BCLK is obtained by dividing the MCLK by 16.
- 1000: The BCLK is obtained by dividing the MCLK by 24.
- 1001: The BCLK is obtained by dividing the MCLK by 32.
- 1010: The BCLK is obtained by dividing the MCLK by 48.
- 1011: The BCLK is obtained by dividing the MCLK by 64.

Other values: The BCLK is obtained by dividing the MCLK by 8.";
            sw = rw; hw = r;
            reset = 0x0;
        } aiao_bclk_div[3:0];
    } I2S_CRG_CFG1_00 @ 0x104;
