`include "hi3520dv300_includes.rdl"

addrmap hi3520dv300 {
    name = "hi3520dv300 registers";
    desc = "
        ## Status

        Hi3520D V300: single Cortex-A7 NVR/DVR SoC, 16-bit DDR3 interface, SATA 2.0, GSF gigabit port, USB 2.0 host, FMC.

        Built on 2026-11-14 from the HiSilicon Hi3521A/Hi3520D V300 H.264 CODEC Processor data sheet, Issue 00B07 (2015-12-10), by programmatic extraction (scripts/rdl-extract/dsextract.py + gen_rdl.py in the hi3520d-nvr workspace). Every register block marked modelled below is PROVEN against the data sheet tables (offsets, names, bit ranges, access types, reset values: exact; free-text descriptions taken from the cell text, spot-checked only). Blocks the data sheet has no register chapter for (SCD, DDRT, HDMI, AVC/VEDU, TDE, IVE, JPGD, JPGE, VGS, VPSS, OHCI register window) are not instantiated. The SP804 timers and PL061 GPIOs use the shared common blocks. Hardware not verified.

        ## Addresses

        | Start Address | End Address | Description | Evidence |
        |---------------|-------------|-------------|----------|
        | 0x00000000 | 0x03FFFFFF | Boot window: the boot address space (BOOTROM, NAND/SFC CS0) while the remap is active, on-chip RAM after SC_CTRL.remapclear | data sheet Table 1-2 |
        | 0x04000000 | 0x0400FFFF | BOOTROM (4 KB actually implemented) | Table 1-2 |
        | 0x04010000 | 0x0401FFFF | On-chip RAM (16 KB actually implemented) | Table 1-2 |
        | 0x10000000 | 0x1000FFFF | FMC registers (modelled: FMC) | Table 1-2, 4.x FMC |
        | 0x10030000 | 0x1003FFFF | USB 2.0 host OHCI (standard OHCI registers, not tabulated in the data sheet) | Table 1-2 |
        | 0x10040000 | 0x1004FFFF | USB 2.0 host EHCI, vendor control registers at +0x90 (modelled: USB_EHCI) | Table 1-2, Table 13-15 |
        | 0x10060000 | 0x1006FFFF | DMAC (modelled: DMAC) | Table 1-2, Table 3-14 |
        | 0x10070000 | 0x1007FFFF | CIPHER (modelled: CIPHER) | Table 1-2, Table 3-15 |
        | 0x10080000 | 0x1008FFFF | SCD (not modelled: no register chapter) | Table 1-2 |
        | 0x100A0000 | 0x100AFFFF | GSF gigabit Ethernet MAC (modelled: GSF) | Table 1-2, Table 5-3 |
        | 0x11010000 | 0x1101FFFF | SATA 3.0 (Hi3521A; 2.0 on the Hi3520D V300): AHCI global registers at +0x000, ports at +0x100 + n x 0x80 (modelled: SATA_AHCI, SATA_PORT) | Table 1-2, Tables 13-12, 13-13 |
        | 0x12000000 | 0x1203FFFF | Timer0/1, Timer2/3, Timer4/5, Timer6/7 (SP804, common block) | Table 1-2, Table 3-16 |
        | 0x12040000 | 0x1204FFFF | CRG (modelled: CRG) | Table 1-2, Table 3-6 |
        | 0x12050000 | 0x1205FFFF | System controller (modelled: SYS_CTRL); SC_SYSID 0x3521A100 | Table 1-2, Table 3-8 |
        | 0x12070000 | 0x1207FFFF | Watchdog (modelled: WDG) | Table 1-2, Table 3-17 |
        | 0x12080000 | 0x120AFFFF | UART0, UART1, UART2 (modelled: UART) | Table 1-2, Table 13-2 |
        | 0x120B0000 | 0x120BFFFF | RTC SPI interface (internal RTC register file modelled separately: RTC_INT, byte-wide, address space of the RTC chip) | Table 1-2, Tables 3-18, 3-19 |
        | 0x120C0000 | 0x120CFFFF | I2C (modelled: I2C) | Table 1-2, Table 13-1 |
        | 0x120D0000 | 0x120DFFFF | SSP/SPI (modelled: SPI) | Table 1-2, Table 13-4 |
        | 0x120E0000 | 0x120EFFFF | PMC (modelled: PMC) | Table 1-2, Table 3-20 |
        | 0x120F0000 | 0x120F7FFF | Pin multiplexing (modelled: PINMUX) | Table 1-2, Table 2-28 |
        | 0x120F0800 | 0x120FFFFF | Pin (pad) control (modelled: PADCTRL) | Table 1-2, Table 2-29 |
        | 0x12100000 | 0x12100FFF | DDRT0 (not modelled: no register chapter) | Table 1-2 |
        | 0x12110000 | 0x1211FFFF | DDRC: AXI 0x12110000, QoS buffer 0x12114000, AWADDR surveillance 0x12115000, DMC 0x12118000, DDR PHY 0x1211C000 | Table 1-2, Tables 4-5 to 4-12 |
        | 0x12120000 | 0x1212FFFF | Peripheral control registers (modelled: MISC_CTRL) | Table 1-2, Table 3-9 |
        | 0x12140000 | 0x1214FFFF | IR receiver (modelled: IR) | Table 1-2, Table 13-8 |
        | 0x12150000 | 0x1222FFFF | GPIO0-GPIO13 (PL061, 0x10000 apart, common block) | Table 1-2, Table 13-10 |
        | 0x13010000 | 0x1301FFFF | HDMI (not modelled: no register chapter) | Table 1-2 |
        | 0x13020000 | 0x1302FFFF | VDP (modelled: VDP) | Table 1-2, Table 10-6 |
        | 0x13040000 | 0x1304FFFF | AVC0 H.264 codec (not modelled: no register chapter) | Table 1-2 |
        | 0x13050000 | 0x1305FFFF | TDE (not modelled) | Table 1-2 |
        | 0x13060000 | 0x1306FFFF | IVE (not modelled) | Table 1-2 |
        | 0x13070000 | 0x1307FFFF | JPGD (not modelled) | Table 1-2 |
        | 0x13080000 | 0x1308FFFF | VGS (not modelled) | Table 1-2 |
        | 0x130C0000 | 0x130FFFFF | VICAP (modelled: VICAP) | Table 1-2, Table 10-5 |
        | 0x13100000 | 0x1310FFFF | AVC1 H.264 codec (not modelled) | Table 1-2 |
        | 0x13110000 | 0x1311FFFF | VPSS (not modelled) | Table 1-2 |
        | 0x13120000 | 0x1312FFFF | VOIE (modelled: VOIE) | Table 1-2, Table 11-1 |
        | 0x13130000 | 0x1313FFFF | JPGE (not modelled) | Table 1-2 |
        | 0x13140000 | 0x1314FFFF | AIAO (modelled: AIAO) | Table 1-2, Table 12-2 |
        | 0x13150000 | 0x1315FFFF | MDU motion detection (modelled: MDU) | Table 1-2, Table 8-1 |
        | 0x14000000 | 0x14FFFFFF | SFC NAND/NOR memory window (16 MB) | Table 1-2 |
        | 0x80000000 | 0xFFFFFFFF | DDR (2 GB address space; Hi3521A 32-bit bus up to 1 GB, Hi3520D V300 16-bit bus up to 512 MB) | Table 1-2, 1.2.14 |

        ## Interrupts (GIC interrupt IDs, data sheet Table 3-7)

        | Interrupt bit (GIC ID) | Source |
        |---|---|
        | 0-15 | SGI0-SGI15 |
        | 32 | WDG |
        | 33 | Timer0/Timer1 |
        | 34 | Timer2/Timer3 |
        | 35 | Timer4/Timer5 |
        | 36 | Timer6/Timer7 |
        | 37 | RTC |
        | 38 | UART0 |
        | 39 | UART1 |
        | 40 | UART2 |
        | 41 | IR |
        | 42 | DMA |
        | 43 | FMC |
        | 44 | I2C |
        | 45 | CIPHER |
        | 46 | SSP |
        | 47 | DDRT |
        | 48 | GMAC (GSF) |
        | 49 | SATA |
        | 50 | USB2_OHCI |
        | 51 | USB2_EHCI |
        | 60 | VICAP |
        | 61 | HDMI |
        | 62 | VDP0 |
        | 63 | AVC0 |
        | 64 | TDE |
        | 65 | IVE |
        | 66 | JPGD |
        | 67 | VGS |
        | 68 | AVC1 |
        | 69 | VPSS |
        | 70 | VOIE |
        | 71 | JPGE |
        | 72 | AIAO |
        | 73 | SCD |
        | 74 | VDP1 |
        | 75 | MDU |
        | 83 | SOFTWARE_INT |
        | 84 | A7_COMMTX |
        | 85 | A7_COMMRX |
        | 86 | A7_PMUIRQ |
        | 87 | A7_CTIIRQ |
        | 89 | GPIO0-GPIO4 (shared) |
        | 90 | GPIO5-GPIO9 (shared) |
        | 91 | GPIO10-GPIO13 (shared) |
        | 92 | DDRC_ERR_INT |
        | other | not connected (16-31, 52-59, 76-82, 88, 93-95) |
    ";

    eHI3520DV300_FMC          FMC          @ 0x10000000;
    eHI3520DV300_USB2         USB_EHCI     @ 0x10040000;
    eHI3520DV300_DMAC         DMAC         @ 0x10060000;
    eHI3520DV300_CIPHER       CIPHER       @ 0x10070000;
    eHI3520DV300_GSF          GSF          @ 0x100A0000;
    eHI3520DV300_SATA_AHCI    SATA_AHCI    @ 0x11010000;
    eHI3520DV300_SATA_PORT    SATA_PORT    @ 0x11010100;
    eHI3520DV300_CRG          CRG          @ 0x12040000;
    eHI3520DV300_SYS_CTRL     SYS_CTRL     @ 0x12050000;
    eHI3520DV300_WDG          WDG          @ 0x12070000;
    eHI3520DV300_UART         UART0        @ 0x12080000;
    eHI3520DV300_UART         UART1        @ 0x12090000;
    eHI3520DV300_UART         UART2        @ 0x120A0000;
    eHI3520DV300_RTC          RTC          @ 0x120B0000;
    eHI3520DV300_RTC_INT      RTC_INT      @ 0x120B0100;
    eHI3520DV300_I2C          I2C          @ 0x120C0000;
    eHI3520DV300_SPI          SPI          @ 0x120D0000;
    eHI3520DV300_PMC          PMC          @ 0x120E0000;
    eHI3520DV300_PINMUX       PINMUX       @ 0x120F0000;
    eHI3520DV300_PADCTRL      PADCTRL      @ 0x120F0800;
    eHI3520DV300_DDRC_AXI     DDRC_AXI     @ 0x12110000;
    eHI3520DV300_DDRC_QOSB    DDRC_QOSB    @ 0x12114000;
    eHI3520DV300_DDRC_AWADDR  DDRC_AWADDR  @ 0x12115000;
    eHI3520DV300_DDRC_DMC     DDRC_DMC     @ 0x12118000;
    eHI3520DV300_DDRC_PHY     DDRC_PHY     @ 0x1211C000;
    eHI3520DV300_MISC_CTRL    MISC_CTRL    @ 0x12120000;
    eHI3520DV300_IR           IR           @ 0x12140000;
    eHI3520DV300_VDP          VDP          @ 0x13020000;
    eHI3520DV300_VICAP        VICAP        @ 0x130C0000;
    eHI3520DV300_VOIE         VOIE         @ 0x13120000;
    eHI3520DV300_AIAO         AIAO         @ 0x13140000;
    eHI3520DV300_MDU          MDU          @ 0x13150000;
    eHISI_TIMER_SP804    TIMER0       @ 0x12000000;
    eHISI_TIMER_SP804    TIMER1       @ 0x12000020;
    eHISI_TIMER_SP804    TIMER2       @ 0x12010000;
    eHISI_TIMER_SP804    TIMER3       @ 0x12010020;
    eHISI_TIMER_SP804    TIMER4       @ 0x12020000;
    eHISI_TIMER_SP804    TIMER5       @ 0x12020020;
    eHISI_TIMER_SP804    TIMER6       @ 0x12030000;
    eHISI_TIMER_SP804    TIMER7       @ 0x12030020;
    eARM_PL061           GPIO0        @ 0x12150000;
    eARM_PL061           GPIO1        @ 0x12160000;
    eARM_PL061           GPIO2        @ 0x12170000;
    eARM_PL061           GPIO3        @ 0x12180000;
    eARM_PL061           GPIO4        @ 0x12190000;
    eARM_PL061           GPIO5        @ 0x121A0000;
    eARM_PL061           GPIO6        @ 0x121B0000;
    eARM_PL061           GPIO7        @ 0x121C0000;
    eARM_PL061           GPIO8        @ 0x121D0000;
    eARM_PL061           GPIO9        @ 0x121E0000;
    eARM_PL061           GPIO10       @ 0x121F0000;
    eARM_PL061           GPIO11       @ 0x12200000;
    eARM_PL061           GPIO12       @ 0x12210000;
    eARM_PL061           GPIO13       @ 0x12220000;
};
