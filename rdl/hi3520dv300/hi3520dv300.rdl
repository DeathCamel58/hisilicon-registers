        | 0x02C | PERI_CRG11 | PERI_CRG11 | vi0_cken, vi0_srst_req, vi1_cken, vi1_srst_req, vi2_cken, vi2_srst_req, vi3_cken, vi3_srst_req, vi_ppc_srst_req, vi_bus_srst_req, ... |
        | 0x030 | PERI_CRG12 | PERI_CRG12 | vo_srst_req, vo_cken, vo_hd_cken, vo_sd_cken, vo_pcken, vo_acken, vo_dac_cken, vo_sd_dac_cken, vo_hd_dac_cken |
        | 0x034 | PERI_CRG13 | PERI_CRG13 | ddr_apb_cken, ddr_hipack_cken, ddr_cfg_cken, ddr_apb_srst_req, ddr_hipack_srst_req |
