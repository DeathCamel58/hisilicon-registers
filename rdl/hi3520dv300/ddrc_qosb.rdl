`ifndef HI3520DV300_DDRC_QOSB_RDL
`define HI3520DV300_DDRC_QOSB_RDL
regfile eHI3520DV300_DDRC_QOSB {
    name = "DDRC QoS buffer";
    desc = "DDRC QoS buffer of the Hi3521A/Hi3520D V300 at base 0x1211_4000. 56 registers extracted programmatically from the Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10) (Table 4-7 Summary of QoSBuf registers (base address: 0x1211_4000)): register headings, offsets, total reset values, field bit ranges, access types, names, reset values and descriptions, with PDF page numbers in each register description. Field names, bit ranges, access types and offsets are exact; the free-text descriptions are taken from the cell text of the field table and were checked by sampling only. Hardware not verified.";
    reg {
        name = "QOSB_PUSH_CTRL";
        desc = "QOSB_PUSH_CTRL is a QosBuf push configuration register. (offset 0x0; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.6.2, PDF page 751).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_3[31:3];
        field {
            name = "mid_push_en";
            desc = "Push enable for commands with the same MID
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } mid_push_en[2:2];
        field {
            name = "addr_push_en";
            desc = "Push enable for commands with the same address
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } addr_push_en[1:1];
        field {
            name = "id_push_en";
            desc = "Push enable for commands with the same ID
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } id_push_en[0:0];
    } QOSB_PUSH_CTRL @ 0x0;
    reg {
        name = "QOSB_ADPT_CTRL";
        desc = "QOSB_ADPT_CTRL is a QoSBuf adaptation configuration register. (offset 0x4; total reset 0x00000FF0; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.6.2, PDF page 752).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_20[31:20];
        field {
            name = "adpt_share_cnt";
            desc = "Adapt counter for lower bits. When the value of this counter decreases to 0, the counter for upper bits corresponding to each CMD decreases by 1.";
            sw = rw; hw = r;
            reset = 0xff;
        } adpt_share_cnt[19:4];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_3_1[3:1];
        field {
            name = "adpt_en";
            desc = "Adapt enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } adpt_en[0:0];
    } QOSB_ADPT_CTRL @ 0x4;
    reg QOSB_FLUX_ID_t {
        name = "QOSB_FLUX_ID";
        desc = "QOSB_FLUX_ID is a QoSBuf matched ID register for traffic statistics. (offset 0x8, 7 instances at stride 0x4; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.6.2, PDF page 752).";
        field {
            name = "flux_id";
            desc = "Matched ID for traffic statistics. The ID ranges from 0 to 6, and each ID corresponds to a statistics group. If the traffic ID matches none of the seven IDs, the traffic is included in the default group.";
            sw = rw; hw = r;
            reset = 0x0;
        } flux_id[31:0];
    };
    QOSB_FLUX_ID_t QOSB_FLUX_ID_0 @ 0x8;
    QOSB_FLUX_ID_t QOSB_FLUX_ID_1 @ 0xC;
    QOSB_FLUX_ID_t QOSB_FLUX_ID_2 @ 0x10;
    QOSB_FLUX_ID_t QOSB_FLUX_ID_3 @ 0x14;
    QOSB_FLUX_ID_t QOSB_FLUX_ID_4 @ 0x18;
    QOSB_FLUX_ID_t QOSB_FLUX_ID_5 @ 0x1C;
    QOSB_FLUX_ID_t QOSB_FLUX_ID_6 @ 0x20;
    reg QOSB_FLUX_ID_MASK_t {
        name = "QOSB_FLUX_ID_MASK";
        desc = "QOSB_FLUX_ID_MASK is a QoSBuf traffic statistics ID mask register. (offset 0x24, 7 instances at stride 0x4; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.6.2, PDF page 753).";
        field {
            name = "flux_id_mask";
            desc = "QoSBuf traffic statistics ID mask, corresponding to QOSB_FLUX_ID
- 0: Bits of the corresponding ID are ignored.
- 1: Bits of the corresponding ID are compared.";
            sw = rw; hw = r;
            reset = 0x0;
        } flux_id_mask[31:0];
    };
    QOSB_FLUX_ID_MASK_t QOSB_FLUX_ID_MASK_0 @ 0x24;
    QOSB_FLUX_ID_MASK_t QOSB_FLUX_ID_MASK_1 @ 0x28;
    QOSB_FLUX_ID_MASK_t QOSB_FLUX_ID_MASK_2 @ 0x2C;
    QOSB_FLUX_ID_MASK_t QOSB_FLUX_ID_MASK_3 @ 0x30;
    QOSB_FLUX_ID_MASK_t QOSB_FLUX_ID_MASK_4 @ 0x34;
    QOSB_FLUX_ID_MASK_t QOSB_FLUX_ID_MASK_5 @ 0x38;
    QOSB_FLUX_ID_MASK_t QOSB_FLUX_ID_MASK_6 @ 0x3C;
    reg {
        name = "QOSB_FLUX_PRD";
        desc = "QOSB_FLUX_PRD is a QoSBuf traffic statistical period register. (offset 0x40; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.6.2, PDF page 753).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_16[31:16];
        field {
            name = "flux_prd";
            desc = "Traffic statistical period";
            sw = rw; hw = r;
            reset = 0x0;
        } flux_prd[15:0];
    } QOSB_FLUX_PRD @ 0x40;
    reg QOSB_FLUX_LVL_t {
        name = "QOSB_FLUX_LVL";
        desc = "QOSB_FLUX_LVL is a QoSBuf traffic statistical threshold register. (offset 0x44, 8 instances at stride 0x4; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.6.2, PDF page 754).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_20[31:20];
        field {
            name = "flux_lvl";
            desc = "Traffic statistical threshold. During the statistical period, the priority of the command is decreased to the lowest one when the traffic exceeds the threshold.";
            sw = rw; hw = r;
            reset = 0x0;
        } flux_lvl[19:0];
    };
    QOSB_FLUX_LVL_t QOSB_FLUX_LVL_0 @ 0x44;
    QOSB_FLUX_LVL_t QOSB_FLUX_LVL_1 @ 0x48;
    QOSB_FLUX_LVL_t QOSB_FLUX_LVL_2 @ 0x4C;
    QOSB_FLUX_LVL_t QOSB_FLUX_LVL_3 @ 0x50;
    QOSB_FLUX_LVL_t QOSB_FLUX_LVL_4 @ 0x54;
    QOSB_FLUX_LVL_t QOSB_FLUX_LVL_5 @ 0x58;
    QOSB_FLUX_LVL_t QOSB_FLUX_LVL_6 @ 0x5C;
    QOSB_FLUX_LVL_t QOSB_FLUX_LVL_7 @ 0x60;
    reg {
        name = "QOSB_FLUX_EN";
        desc = "QOSB_FLUX_EN is a QoSBuf traffic statistics enable register. (offset 0x64; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.6.2, PDF page 754).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_1[31:1];
        field {
            name = "flux_en";
            desc = "Traffic statistics enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } flux_en[0:0];
    } QOSB_FLUX_EN @ 0x64;
    reg QOSB_BANK_CTRL_t {
        name = "QOSB_BANK_CTRL";
        desc = "QOSB_BANK_CTRL is a QoSBuf bank rotating control register. (offset 0x68, 2 instances at stride 0x4; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.6.2, PDF page 755).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_8[31:8];
        field {
            name = "ba_cnt_lvl";
            desc = "Bank conflict threshold. When the number of commands with the same bank address exceeds the threshold, bank conflict occurs. Otherwise, there is no bank conflict.";
            sw = rw; hw = r;
            reset = 0x0;
        } ba_cnt_lvl[7:4];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_3_1[3:1];
        field {
            name = "ba_intleav_en";
            desc = "QoSBuf bank rotating enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } ba_intleav_en[0:0];
    };
    QOSB_BANK_CTRL_t QOSB_BANK_CTRL_0 @ 0x68;
    QOSB_BANK_CTRL_t QOSB_BANK_CTRL_1 @ 0x6C;
    reg QOSB_GREEN_CTRL_t {
        name = "QOSB_GREEN_CTRL";
        desc = "QOSB_GREEN_CTRL is a QoSBuf green channel control register. (offset 0x78, 2 instances at stride 0x4; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.6.2, PDF page 755).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_8[31:8];
        field {
            name = "green_lvl";
            desc = "Green channel threshold. That is, the empty locations above this threshold are reserved for green channels. For example, if there are 12 DMC queues (queues 0-11) and the threshold is 9, queues 10 and 11 are reserved for green channels. When this field is set to N, the actual number of allowed commands is (N + 1) because of the pipeline issue. This register cannot be dynamically configured when it is being accessed.";
            sw = rw; hw = r;
            reset = 0x0;
        } green_lvl[7:4];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_3_1[3:1];
        field {
            name = "green_en";
            desc = "Green channel enable (channels are not controlled separately, which needs to be optimized later)
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } green_en[0:0];
    };
    QOSB_GREEN_CTRL_t QOSB_GREEN_CTRL_0 @ 0x78;
    QOSB_GREEN_CTRL_t QOSB_GREEN_CTRL_1 @ 0x7C;
    reg {
        name = "QOSB_BUF_BYP";
        desc = "QOSB_BUF_BYP is a QoSBuf bypass control register. (offset 0x88; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.6.2, PDF page 756).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_2[31:2];
        field {
            name = "qos_buf_byp";
            desc = "QoSBuf bypass control x0: forcible non-bypass mode. That is, all the commands enter the QoSBuf module when the value is set to 00 or 10.
- 01: whether to bypass depends on the queue status in the DMC
- 11: forcible bypass mode. None of the commands enters the

QoSBuf module. These modes need to be configured before the access. The dynamic configuration is forbidden during the access.";
            sw = rw; hw = r;
            reset = 0x0;
        } qos_buf_byp[1:0];
    } QOSB_BUF_BYP @ 0x88;
    reg QOSB_WBUF_CTRL_t {
        name = "QOSB_WBUF_CTRL";
        desc = "QOSB_WBUF_CTRL is a QoSBuf write command priority adjustment control register. (offset 0x8C, 2 instances at stride 0x4; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.6.2, PDF page 757).";
        field {
            name = "wbuf_ptun_en";
            desc = "Write command priority adjustment enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } wbuf_ptun_en[31:31];
        field {
            name = "wbuf_pri2";
            desc = "Priority of write buffer threshold 2";
            sw = rw; hw = r;
            reset = 0x0;
        } wbuf_pri2[30:28];
        field {
            name = "wbuf_lvl2";
            desc = "Write buffer threshold 2. When the number of commands increasingly reaches the threshold, if the priorities of the write commands are lower than wbuf_pri2, the priorities of the write commands are set to wbuf_pri2. If the priorities of the write commands are higher than wbuf_pri2, the priorities of the write commands are restored to their previous priorities. Note that the threshold cannot be dynamically configured. Otherwise, the write buffer adaptation function becomes invalid.";
            sw = rw; hw = r;
            reset = 0x0;
        } wbuf_lvl2[27:20];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_19_19[19:19];
        field {
            name = "wbuf_pri1";
            desc = "Priority of write buffer threshold 1 priority";
            sw = rw; hw = r;
            reset = 0x0;
        } wbuf_pri1[18:16];
        field {
            name = "wbuf_lvl1";
            desc = "Write buffer threshold 1. When the number of commands increasingly or decreasingly reaches the threshold, if the priorities of the write commands are lower than wbuf_pri1, the priorities of the write commands are set to wbuf_pri1. If the priorities of the write commands are higher than wbuf_pri1, the priorities of the write commands are restored to their previous priorities. Note that the threshold cannot be dynamically configured. Otherwise, the write buffer adaptation function becomes invalid.";
            sw = rw; hw = r;
            reset = 0x0;
        } wbuf_lvl1[15:8];
        field {
            name = "wbuf_lvl0";
            desc = "Write buffer threshold 0. When the number of commands decreasingly reaches the threshold, the priorities of the write commands are decreased to the lowest priority. Note that the threshold cannot be dynamically configured. Otherwise, the write buffer adaptation function becomes invalid.";
            sw = rw; hw = r;
            reset = 0x0;
        } wbuf_lvl0[7:0];
    };
    QOSB_WBUF_CTRL_t QOSB_WBUF_CTRL_0 @ 0x8C;
    QOSB_WBUF_CTRL_t QOSB_WBUF_CTRL_1 @ 0x90;
    reg {
        name = "QOSB_WRTOUT0";
        desc = "QOSB_WRTOUT0 is QoSBuf write command timeout period register 0. (offset 0x9C; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.6.2, PDF page 758).";
        field {
            name = "wr_tout3";
            desc = "Write command timeout period (level 3) The configuration mode is the same as that of wr_tout0.";
            sw = rw; hw = r;
            reset = 0x0;
        } wr_tout3[31:24];
        field {
            name = "wr_tout2";
            desc = "Write command timeout period (level 2) The configuration mode is the same as that of wr_tout0.";
            sw = rw; hw = r;
            reset = 0x0;
        } wr_tout2[23:16];
        field {
            name = "wr_tout1";
            desc = "Write command timeout period (level 1) The configuration mode is the same as that of wr_tout0.";
            sw = rw; hw = r;
            reset = 0x0;
        } wr_tout1[15:8];
        field {
            name = "wr_tout0";
            desc = "Write command timeout period (level 0)
- 0x0: The timeout function is disabled. 0x1-0xFF: n x 4 clock cycles

When the timeout period is set to 8 bits, the actual count value is 10 bits. That is, the lower two bits are fixed at 0.";
            sw = rw; hw = r;
            reset = 0x0;
        } wr_tout0[7:0];
    } QOSB_WRTOUT0 @ 0x9C;
    reg {
        name = "QOSB_WRTOUT1";
        desc = "QOSB_WRTOUT1 is QoSBuf write command timeout period register 1. (offset 0xA0; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.6.2, PDF page 758).";
        field {
