// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3520dv300-logic" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3520D V300: logic block diagram</B><BR/><FONT POINT-SIZE="11">drawn from the key-specification list of the data sheet (chapter 1); bus topology is not stated there and is not drawn</FONT>>, fontcolor="#808080", rankdir=LR, compound=true, newrank=true];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  bus [label="system bus", fillcolor="#9a9a9a"  shape=box, height=5.2, width=0.5, fontcolor="white"];
  subgraph cluster_cpu { label="CPU subsystem"; fontcolor="#808080"; color="#808080"; style="rounded";
  cpu [label="Cortex-A7 up to 800 MHz, NEON + FPU\n32 KB I + 32 KB D L1, 128 KB L2", fillcolor="#e0b86f"  ];
  }
  ddrc [label="DDRC", fillcolor="#8fb3de"  ];
  ddrext [label="16-bit DDR3/DDR3L\nup to 800 MHz", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  ddrext -> ddrc [dir=both]; ddrc -> cpu [dir=both]; ddrc -> bus [dir=both, style=dashed];
  subgraph cluster_l0 { label="High-speed peripherals"; fontcolor="#808080"; color="#808080"; style="rounded";
    sata [label="SATA 2.0 x2", fillcolor="#8fb3de"  ];
    fmc [label="SFC (SPI NOR / NAND)", fillcolor="#8fb3de"  ];
    eth [label="GMAC\n1 Gbit/s, TSO", fillcolor="#8fb3de"  ];
    usb [label="USB 2.0 host x2", fillcolor="#8fb3de"  ];
    aiao [label="AIAO (I2S/PCM x3,\naudio codec)", fillcolor="#8fb3de"  ];
  }
  sata -> bus [dir=both];
  fmc -> bus [dir=both];
  eth -> bus [dir=both];
  usb -> bus [dir=both];
  aiao -> bus [dir=both];
  subgraph cluster_l1 { label="Security"; fontcolor="#808080"; color="#808080"; style="rounded";
    cipher [label="CIPHER\nAES / DES / 3DES", fillcolor="#c9a0dc"  ];
  }
  cipher -> bus [dir=both];
  subgraph cluster_r0 { label="Video input and output"; fontcolor="#808080"; color="#808080"; style="rounded";
    vi [label="VICAP", fillcolor="#a6c98f"  ];
    vpss [label="VPSS, VOIE", fillcolor="#a6c98f"  ];
    vo [label="VDP: HDMI 1.4 / VGA /\nCVBS output", fillcolor="#a6c98f"  ];
  }
  bus -> vi [dir=both];
  bus -> vpss [dir=both];
  bus -> vo [dir=both];
  subgraph cluster_r1 { label="Video codec and analysis"; fontcolor="#808080"; color="#808080"; style="rounded";
    codec [label="H.264 / MJPEG / JPEG\ncodec", fillcolor="#a6c98f"  ];
    ive [label="IVE", fillcolor="#a6c98f"  ];
  }
  bus -> codec [dir=both];
  bus -> ive [dir=both];
  subgraph cluster_r2 { label="Low-speed peripherals"; fontcolor="#808080"; color="#808080"; style="rounded";
    lsp [label="UART x3, SPI, I2C, IR, GPIO,\ntimers, WDG, RTC,\nSYS_CTRL, CRG, IO config", fillcolor="#7fcdc4"  ];
    rom [label="BOOTROM 4 KB, SRAM 16 KB", fillcolor="#7fcdc4"  ];
  }
  bus -> lsp [dir=both];
  bus -> rom [dir=both];
  hdd [label="SATA hard disks", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  hdd -> sata [dir=both, style=dashed];
  flash [label="SPI NOR / NAND flash", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  flash -> fmc [dir=both, style=dashed];
  phy [label="external Ethernet PHY", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  phy -> eth [dir=both, style=dashed];
  usbp [label="2 USB ports", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  usbp -> usb [dir=both, style=dashed];
  bus -> cpu [dir=both];
}
