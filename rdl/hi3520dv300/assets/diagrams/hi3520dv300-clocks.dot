// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3520dv300-clocks" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3520D V300 / Hi3521A: clock tree</B><BR/><FONT POINT-SIZE="11">data sheet 3.2.3-3.2.5 (Figure 3-3, Tables 3-2 to 3-5); consumers are grouped by their printed adjacency to each PLL output (INFERRED: the text layer of the figure loses the connector lines)</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  xin [label="XIN\n24 MHz crystal", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  vi [label="VI port clock pads", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  vic [label="VICAP port clocks\nPERI_CRG11: viN_pctrl (phase), viN_ch_cksel,\nvi_ppc_cksel [30:29]", fillcolor="#a6c98f"  ];
  apll [label="APLL (programmable)\nPERI_CRG_PLL0 / PERI_CRG_PLL1\nFOUTPOSTDIV max 800 MHz", fillcolor="#e6a0a0"  ];
  dpll [label="DPLL (programmable)\nPERI_CRG_PLL8 / PERI_CRG_PLL9\nFOUTPOSTDIV max 400 MHz", fillcolor="#e6a0a0"  ];
  vpll0 [label="VPLL0 (programmable)\nPERI_CRG_PLL2 / PERI_CRG_PLL3\nFOUTVCO 1620 MHz; FOUT1PH0 162 MHz (max);\nFOUTPOSTDIV 810 MHz; 405 / 202.5 MHz", fillcolor="#e6a0a0"  ];
  fix [label="fixed PLLs: VPLL2 (PERI_CRG_PLL4/5) and EPLL (PERI_CRG_PLL6/7)\nFOUTVCO 1500 MHz with 750 / 375 / 300 / 187.5 / 150 / 75 / 60 MHz dividers;\nFOUTPOSTDIV 500 MHz, FOUT1PH0 250, FOUT2 125, dividers 100 / 50 / 25 MHz\n(which fixed PLL carries which output is not labeled in the figure text)", fillcolor="#e6a0a0"  ];
  a7 [label="Cortex-A7\nAPLL output (default), 750 MHz option\nddr_cksel PERI_CRG13[1:0], cpu_cksel PERI_CRG13[3:2], bus_cksel PERI_CRG13[13:8]", fillcolor="#e0b86f"  ];
  ddr [label="DDR controller (MDDRC)\nDPLL output (default)", fillcolor="#8fb3de"  ];
  v162 [label="HDMI, HD DAC\n162 MHz", fillcolor="#a6c98f"  ];
  v324 [label="VGS, VICAP PPC, VEDU0, VEDU1\n324 MHz option", fillcolor="#a6c98f"  ];
  v54 [label="VO SD 54 MHz;\nADC0 / ADC1 reference 27 MHz", fillcolor="#a6c98f"  ];
  v270 [label="270 MHz AXI, VPSS\n270 MHz option", fillcolor="#a6c98f"  ];
  v202 [label="SYS_AXI, JPGE, JPGD, SED0/1, SCD, CIPHER,\nHDMI MHL, VDP: 202.5 MHz", fillcolor="#a6c98f"  ];
  f375 [label="VEDU0 / VEDU1 / VPSS 375 MHz option\nVEDU: PERI_CRG15/16, VPSS: PERI_CRG17, skip dividers", fillcolor="#a6c98f"  ];
  f300 [label="VGS, IVE, VICAP PPC, 300 MHz AXI\n300 MHz", fillcolor="#a6c98f"  ];
  f187 [label="SED0 / SED1\n187.5 MHz", fillcolor="#a6c98f"  ];
  f150 [label="FMC, SATA, VICAP PPC\n150 MHz (FMC select PERI_CRG29[3:2])", fillcolor="#8fb3de"  ];
  f75 [label="GSF core\n75 MHz", fillcolor="#8fb3de"  ];
  f500 [label="AIO PLL\n500 MHz", fillcolor="#a6c98f"  ];
  f250 [label="SCD, TDE, 300 MHz AXI, SYS_AXI\n250 MHz", fillcolor="#a6c98f"  ];
  f125 [label="AIO common, GSF GE0, GSF public, HDMI audio\n125 MHz", fillcolor="#8fb3de"  ];
  f100 [label="MDU, VOIE, HDMI audio, SATA PHY\n100 MHz (SATA PHY ref PERI_CRG26)", fillcolor="#8fb3de"  ];
  f50 [label="FE PHY output, SATA alive clock\n50 MHz", fillcolor="#8fb3de"  ];
  f25 [label="FMC, FE PHY output\n25 MHz", fillcolor="#8fb3de"  ];
  f60 [label="HDMI OSC\n60 MHz", fillcolor="#a6c98f"  ];
  xin -> apll;
  xin -> dpll;
  xin -> vpll0;
  xin -> fix;
  xin -> a7 [label="crystal after reset"];
  vi -> vic;
  apll -> a7;
  dpll -> ddr;
  vpll0 -> v162;
  vpll0 -> v324;
  vpll0 -> v54;
  vpll0 -> v270;
  vpll0 -> v202;
  fix -> f375;
  fix -> f300;
  fix -> f187;
  fix -> f150;
  fix -> f75;
  fix -> f500;
  fix -> f250;
  fix -> f125;
  fix -> f100;
  fix -> f50;
  fix -> f25;
  fix -> f60;
  fix -> a7 [label="750 MHz"];
}
