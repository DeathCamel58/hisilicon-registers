// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3521av100-bus" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3520D V300 / Hi3521A: bus clock domains</B><BR/><FONT POINT-SIZE="11">bus clock domains from the data sheet clock chapter; the data sheet has no master/slave bus matrix or QoS table (INFERRED: the role named in each domain label)</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  a7 [label="Cortex-A7 + L2\nAPLL, 800 MHz max (Hi3521A 1.1 GHz)", fillcolor="#e0b86f"  ];
  sys [label="SYS_AXI\n250 / 202.5 MHz: SCD, TDE, JPGE, JPGD, SED0/1, CIPHER, HDMI, VDP", fillcolor="#9a9a9a"  ];
  a300 [label="300 MHz AXI\nVGS, IVE, VICAP PPC, SCD, TDE", fillcolor="#9a9a9a"  ];
  a270 [label="270 MHz AXI\nVPSS", fillcolor="#9a9a9a"  ];
  ddr [label="DDR controller (MDDRC)\nDPLL 400 MHz max", fillcolor="#8fb3de"  ];
  sel [label="bus_cksel PERI_CRG13[13:8]\nddr_cksel [1:0], cpu_cksel [3:2]", fillcolor="#9aa7e6"  ];
  a7 -> sys;
  sel -> sys;
  sel -> a300;
  sel -> a270;
  sys -> ddr;
  a300 -> ddr;
  a270 -> ddr;
}
