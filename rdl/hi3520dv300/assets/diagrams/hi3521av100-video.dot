// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3521av100-video" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3520D V300 / Hi3521A: video data path</B><BR/><FONT POINT-SIZE="11">block names from the data sheet memory map; the arrows are the usual NVR data path (INFERRED, not tabulated in the data sheet); every stage exchanges frames through DDR</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  vi [label="Video input\n(VICAP: 8-bit / 16-bit ports,\nTDM channels)", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  vpss [label="VPSS\nde-interlace, scale, NR, OSD", fillcolor="#a6c98f"  ];
  voie [label="VOIE", fillcolor="#a6c98f"  ];
  ive [label="IVE\nvideo analysis", fillcolor="#a6c98f"  ];
  mdu [label="MDU\nmotion detection", fillcolor="#a6c98f"  ];
  avc0 [label="AVC0 / AVC1\nH.264 codec", fillcolor="#a6c98f"  ];
  jpge [label="JPGE", fillcolor="#a6c98f"  ];
  jpgd [label="JPGD", fillcolor="#a6c98f"  ];
  scd [label="SCD\nstream-chunk detect", fillcolor="#a6c98f"  ];
  tde [label="TDE\n2D graphics", fillcolor="#a6c98f"  ];
  vgs [label="VGS\nvideo graphics", fillcolor="#a6c98f"  ];
  vdp [label="VDP\nvideo, graphics layers, cursor", fillcolor="#a6c98f"  ];
  out [label="HDMI 1.4 / VGA / CVBS", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  io [label="SATA / GSF Ethernet / USB\n(recording and network)", fillcolor="#8fb3de"  ];
  ddr [label="DDR (frame buffers)", fillcolor="#e0b86f"  ];
  vi -> vpss;
  vpss -> avc0;
  vpss -> jpge;
  vpss -> ive;
  vpss -> mdu;
  avc0 -> io [label="streams"];
  jpge -> io [label="snapshots"];
  io -> scd [label="streams"];
  scd -> avc0;
  io -> jpgd;
  jpgd -> vgs;
  avc0 -> vgs [label="decoded"];
  vgs -> vdp;
  tde -> vdp [label="graphics"];
  voie -> vdp;
  vdp -> out;
  vpss -> ddr [label="frames"];
}
