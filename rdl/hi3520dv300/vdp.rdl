        name = "VOCTRL";
        desc = "VOCTRL is a VO control register. It is used to configure the arbitration mode of surface bus requests. (offset 0x0; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 10.2.7, PDF page 1262).";
        field {
            name = "vo_ck_gt_en";
            desc = "VDP clock gating enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } vo_ck_gt_en[31:31];
        field {
            name = "chk_sum_en";
            desc = "Checksum enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
