    reg {
        name = "DHD1_CTRL";
        desc = "DHD1_CTRL is a display channel global control register. You must configure any bit of this register before configuring DHD1_CTRL[intf_en]. Otherwise, the configuration does not take effect. (offset 0xC400; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 5.10, PDF page 1352).";
