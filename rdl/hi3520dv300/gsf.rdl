    reg {
        name = "CRF_TX_FIFO_THRSLD";
        desc = "CRF_TX_FIFO_THRSLD is a TX FIFO threshold register. (offset 0x264; total reset 0x0271017C; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 5.7, PDF page 1038).";
        field {
            name = "reserved";
