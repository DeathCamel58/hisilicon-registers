`ifndef HI3520DV300_GSF_RDL
`define HI3520DV300_GSF_RDL
regfile eHI3520DV300_GSF {
    name = "Gigabit Ethernet MAC (GSF)";
    desc = "Gigabit Ethernet MAC (GSF) of the Hi3521A/Hi3520D V300 at base 0x100a_0000. 164 registers extracted programmatically from the Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10) (Table 5-3 Summary of GSF registers (base address: 0x100a_0000)): register headings, offsets, total reset values, field bit ranges, access types, names, reset values and descriptions, with PDF page numbers in each register description. Field names, bit ranges, access types and offsets are exact; the free-text descriptions are taken from the cell text of the field table and were checked by sampling only. Hardware not verified.";
    reg {
        name = "STATION_ADDR_LOW";
        desc = "STATION_ADDR_LOW is a local MAC address register. (offset 0x0; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 5.7, PDF page 1001).";
        field {
            name = "station_addr_low";
            desc = "Lower 32 bits for the source MAC address of MAC_CORE";
            sw = rw; hw = r;
            reset = 0x0;
        } station_addr_low[31:0];
    } STATION_ADDR_LOW @ 0x0;
    reg {
        name = "STATION_ADDR_HIGH";
        desc = "STATION_ADDR_HIGH is a local MAC address register. (offset 0x4; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 5.7, PDF page 1001).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_16[31:16];
        field {
            name = "station_addr_high";
            desc = "Upper 16 bits of the source MAC address of MAC_CORE. The default configurations can be used.";
            sw = rw; hw = r;
            reset = 0x0;
        } station_addr_high[15:0];
    } STATION_ADDR_HIGH @ 0x4;
    reg {
        name = "DUPLEX_SEL_RGMII";
        desc = "DUPLEX_SEL_RGMII is a half-duplex selection register. (offset 0x8; total reset 0x00000001; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 5.7, PDF page 1002).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_1[31:1];
        field {
            name = "duplex_sel_rgmii";
            desc = "Half-duplex selection signal
- 0: half duplex
- 1: full duplex";
            sw = rw; hw = r;
            reset = 0x1;
        } duplex_sel_rgmii[0:0];
    } DUPLEX_SEL_RGMII @ 0x8;
    reg {
        name = "FD_FC_TYPE";
        desc = "FD_FC_TYPE is a flow control frame type domain register. (offset 0xC; total reset 0x00008808; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 5.7, PDF page 1002).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_16[31:16];
        field {
            name = "fd_fc_type";
            desc = "Flow control frame type domain in full-duplex mode";
            sw = rw; hw = r;
            reset = 0x8808;
        } fd_fc_type[15:0];
    } FD_FC_TYPE @ 0xC;
    reg {
        name = "COL_DISTANCE";
        desc = "COL_DISTANCE is a single retransmission packet length threshold register. (offset 0x14; total reset 0x00000043; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 5.7, PDF page 1003).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_10[31:10];
        field {
            name = "col_distance";
            desc = "Single retransmission packet length threshold";
            sw = rw; hw = r;
            reset = 0x43;
        } col_distance[9:0];
    } COL_DISTANCE @ 0x14;
    reg {
        name = "FC_TX_TIMER";
        desc = "FC_TX_TIMER is a flow control time parameter register. (offset 0x1C; total reset 0x000000FF; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 5.7, PDF page 1003).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_16[31:16];
        field {
            name = "fc_tx_timer";
            desc = "Parameter of the time period during which flow control frames are transmitted. The unit of the time period is measured by how long 512 bits are transmitted. In 100 Mbit/s mode, the unit is equivalent to 128 clock periods. In 1000 Mbit/s mode, the unit is equivalent to 64 clock periods.";
            sw = rw; hw = r;
            reset = 0xff;
        } fc_tx_timer[15:0];
    } FC_TX_TIMER @ 0x1C;
    reg {
        name = "FD_FC_ADDR_LOW";
        desc = "FD_FC_ADDR_LOW is a flow control frame destination address lower 32 bits register. (offset 0x20; total reset 0xC2000001; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 5.7, PDF page 1003).";
        field {
            name = "fd_fc_addr_low";
            desc = "Lower 32 bits of the destination address of the flow control frame";
            sw = rw; hw = r;
            reset = 0xc2000001;
        } fd_fc_addr_low[31:0];
    } FD_FC_ADDR_LOW @ 0x20;
    reg {
        name = "FD_FC_ADDR_HIGH";
        desc = "FD_FC_ADDR_HIGH is a flow control frame destination address upper 16 bits register. (offset 0x24; total reset 0x00000180; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 5.7, PDF page 1004).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_16[31:16];
        field {
            name = "fd_fc_addr_high";
            desc = "Upper 16 bits of the destination address of the flow control frame";
            sw = rw; hw = r;
            reset = 0x180;
        } fd_fc_addr_high[15:0];
    } FD_FC_ADDR_HIGH @ 0x24;
    reg {
        name = "IPG_TX_TIMER";
        desc = "IPG_TX_TIMER is a TX frame IPG register. (offset 0x30; total reset 0x00000008; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 5.7, PDF page 1004).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_8[31:8];
        field {
            name = "ipg_tx_timer";
            desc = "TX frame IPG, in the unit of byte";
            sw = rw; hw = r;
            reset = 0x8;
        } ipg_tx_timer[7:0];
    } IPG_TX_TIMER @ 0x30;
    reg {
        name = "PAUSE_THR";
        desc = "PAUSE_THR is a TX flow control frame IPG register. (offset 0x38; total reset 0x0000002F; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 5.7, PDF page 1004).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_16[31:16];
        field {
            name = "pause_thr";
            desc = "IPG of the flow control frame. If the flow control time is longer than the IPG, the MAC transmits the flow control frame automatically. The unit of the time period is measured by how long 512 bits are transmitted. In 100 Mbit/s mode, the unit is equivalent to 128 clock periods. In 1000 Mbit/s mode, the unit is equivalent to 64 clock periods.";
            sw = rw; hw = r;
            reset = 0x2f;
        } pause_thr[15:0];
    } PAUSE_THR @ 0x38;
    reg {
        name = "MAX_FRM_SIZE";
        desc = "MAX_FRM_SIZE is a maximum frame length register. (offset 0x3C; total reset 0x000005EE; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 5.7, PDF page 1005).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_14[31:14];
        field {
            name = "max_frm_size";
            desc = "Maximum frame length on the MAC side If the length of an RX frame is greater than the maximum length, the RX frame is regarded as an oversized frame. When the length of a frame to be transmitted is greater than the maximum length, the frame is broken up and then transmitted as an error frame.";
            sw = rw; hw = r;
            reset = 0x5ee;
        } max_frm_size[13:0];
    } MAX_FRM_SIZE @ 0x3C;
    reg {
        name = "PORT_MODE";
        desc = "PORT_MODE is a port status register. (offset 0x40; total reset 0x00000001; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 5.7, PDF page 1006).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_3[31:3];
        field {
            name = "port_mode";
            desc = "Current MAC port mode
- 000: 10 Mbit/s
- 001: 100 Mbit/s
- 101: 1000 Mbit/s

Other values: reserved";
            sw = rw; hw = r;
            reset = 0x1;
        } port_mode[2:0];
    } PORT_MODE @ 0x40;
    reg {
        name = "PORT_EN";
        desc = "PORT_EN is a channel enable register. (offset 0x44; total reset 0x00000006; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 5.7, PDF page 1006).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_3[31:3];
        field {
            name = "tx_en";
            desc = "TX channel enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x1;
        } tx_en[2:2];
        field {
            name = "rx_en";
            desc = "RX channel enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x1;
        } rx_en[1:1];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_0_0[0:0];
    } PORT_EN @ 0x44;
    reg {
        name = "PAUSE_EN";
        desc = "PAUSE_EN is a flow control enable register. (offset 0x48; total reset 0x00000007; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 5.7, PDF page 1007).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x1;
        } reserved_31_2[31:2];
        field {
            name = "tx_fdfc";
            desc = "Flow control frame transmit enable in full-duplex mode
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x1;
        } tx_fdfc[1:1];
        field {
            name = "rx_fdfc";
            desc = "Flow control frame response enable in full-duplex mode
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x1;
        } rx_fdfc[0:0];
    } PAUSE_EN @ 0x48;
    reg {
        name = "SHORT_RUNTS_THR";
        desc = "SHORT_RUNTS_THR is a short frame threshold register. (offset 0x50; total reset 0x0000000C; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 5.7, PDF page 1007).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_5[31:5];
        field {
            name = "short_runts_thr";
            desc = "Short frame threshold (for statistics only)";
            sw = rw; hw = r;
            reset = 0xc;
        } short_runts_thr[4:0];
    } SHORT_RUNTS_THR @ 0x50;
    reg {
        name = "DROP_UNK_CTL_FRM";
        desc = "DROP_UNK_CTL_FRM is a drop enable register for unknown control frames. (offset 0x54; total reset 0x00000001; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 5.7, PDF page 1008).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_1[31:1];
        field {
            name = "drop_unk_ctl_frm";
            desc = "Processing method of the unknown control frames
- 0: The unknown control frames are forwarded normally.
- 1: The unknown control frames are dropped.";
            sw = rw; hw = r;
            reset = 0x1;
        } drop_unk_ctl_frm[0:0];
    } DROP_UNK_CTL_FRM @ 0x54;
    reg {
        name = "TRANSMIT_CONTROL";
        desc = "TRANSMIT_CONTROL is a common configuration register. (offset 0x60; total reset 0x000000D0; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 5.7, PDF page 1008).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_8[31:8];
        field {
            name = "pad_enable";
            desc = "PAD addition enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x1;
        } pad_enable[7:7];
        field {
            name = "crc_add";
            desc = "FCS addition enable
- 0: enabled
- 1: disabled";
            sw = rw; hw = r;
            reset = 0x1;
        } crc_add[6:6];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x10;
        } reserved_5_0[5:0];
    } TRANSMIT_CONTROL @ 0x60;
    reg {
        name = "REC_FILT_CONTROL";
        desc = "REC_FILT_CONTROL is an RX frame filter control register. (offset 0x64; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 5.7, PDF page 1009).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_6[31:6];
        field {
            name = "crc_err_pass";
            desc = "CRC error frame filter enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } crc_err_pass[5:5];
        field {
            name = "pause_frm_pass";
            desc = "Flow control frame filter enable
- 0: disabled. This bit takes effect only when flow control is enabled, which is transmitted to the software.
- 1: enabled. This bit takes effect only when flow control is enabled, which is not transmitted to the software.";
            sw = rw; hw = r;
            reset = 0x0;
        } pause_frm_pass[4:4];
        field {
            name = "vlan_drop_en";
            desc = "VLAN frame filter enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } vlan_drop_en[3:3];
        field {
            name = "bc_drop_en";
            desc = "Broadcast frame filter enable
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } bc_drop_en[2:2];
        field {
            name = "mc_match_en";
            desc = "Multicast frame enable with unmatched DA filter
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } mc_match_en[1:1];
        field {
            name = "uc_match_en";
            desc = "Unicast frame enable with unmatched DA filter
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } uc_match_en[0:0];
    } REC_FILT_CONTROL @ 0x64;
    reg {
        name = "PORT_MC_ADDR_LOW";
        desc = "PORT_MC_ADDR_LOW is a multicast address register. (offset 0x68; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 5.7, PDF page 1010).";
        field {
            name = "port_mc_addr_low";
            desc = "Lower 32 bits of the multicast address, used to check whether the multicast frames match";
            sw = rw; hw = r;
            reset = 0x0;
        } port_mc_addr_low[31:0];
    } PORT_MC_ADDR_LOW @ 0x68;
    reg {
        name = "PORT_MC_ADDR_HIGH";
        desc = "PORT_MC_ADDR_HIGH is a multicast address register. (offset 0x6C; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 5.7, PDF page 1010).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_16[31:16];
        field {
            name = "port_mc_addr_high";
            desc = "Upper 16 bits of the multicast address, used to check whether the multicast frames match";
            sw = rw; hw = r;
            reset = 0x0;
        } port_mc_addr_high[15:0];
    } PORT_MC_ADDR_HIGH @ 0x6C;
    reg {
        name = "MAC_CLR";
        desc = "MAC_CLR is a MAC clear register. (offset 0x70; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 5.7, PDF page 1011).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_4[31:4];
        field {
            name = "soft_rst_mdio";
            desc = "MDIO clear signal
- 0: invalid
- 1: valid";
            sw = rw; hw = r;
            reset = 0x0;
        } soft_rst_mdio[3:3];
        field {
            name = "soft_rst_mii";
            desc = "MII clear signal
- 0: invalid
- 1: valid";
            sw = rw; hw = r;
            reset = 0x0;
        } soft_rst_mii[2:2];
        field {
            name = "soft_rst_rx";
            desc = "RX clear signal
- 0: invalid
- 1: valid";
            sw = rw; hw = r;
            reset = 0x0;
        } soft_rst_rx[1:1];
        field {
            name = "soft_rst_tx";
            desc = "TX clear signal
- 0: invalid
- 1: valid";
            sw = rw; hw = r;
            reset = 0x0;
        } soft_rst_tx[0:0];
    } MAC_CLR @ 0x70;
    reg {
        name = "RX_OCTETS_OK_CNT";
        desc = "RX_OCTETS_OK_CNT is a byte count register for valid RX frames. (offset 0x80; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 5.7, PDF page 1011).";
        field {
            name = "rx_octets_ok_cnt";
            desc = "Count of bytes of the valid RX frames, ranging from DA to FCS";
            sw = r; hw = w; onread = rclr;
            reset = 0x0;
        } rx_octets_ok_cnt[31:0];
    } RX_OCTETS_OK_CNT @ 0x80;
    reg {
        name = "RX_OCTETS_BAD_CNT";
        desc = "RX_OCTETS_BAD_CNT is a byte count register for error RX frames. (offset 0x84; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 5.7, PDF page 1012).";
        field {
            name = "rx_octets_bad_cnt";
            desc = "Count of bytes of the frames with CRC errors and alignment errors";
            sw = r; hw = w; onread = rclr;
            reset = 0x0;
        } rx_octets_bad_cnt[31:0];
    } RX_OCTETS_BAD_CNT @ 0x84;
    reg {
        name = "RX_UC_PKTS";
        desc = "RX_UC_PKTS is a MAC frame count register for RX unicast frames. (offset 0x88; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 5.7, PDF page 1012).";
        field {
            name = "rx_uc_pkts_cnt";
            desc = "Count of RX unicast frames, excluding bad frames";
            sw = r; hw = w; onread = rclr;
            reset = 0x0;
        } rx_uc_pkts_cnt[31:0];
    } RX_UC_PKTS @ 0x88;
    reg {
        name = "RX_MC_PKTS";
        desc = "RX_MC_PKTS is a frame count register for RX multicast frames. (offset 0x8C; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 5.7, PDF page 1012).";
        field {
            name = "rx_mc_pkts_cnt";
            desc = "Count of RX multicast frames, excluding bad frames";
            sw = r; hw = w; onread = rclr;
            reset = 0x0;
        } rx_mc_pkts_cnt[31:0];
    } RX_MC_PKTS @ 0x8C;
    reg {
        name = "RX_BC_PKTS";
        desc = "RX_BC_PKTS is a frame count register for RX broadcast frames. (offset 0x90; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 5.7, PDF page 1013).";
        field {
            name = "rx_bc_pkts_cnt";
            desc = "Count of RX broadcast frames, excluding bad frames";
            sw = r; hw = w; onread = rclr;
            reset = 0x0;
        } rx_bc_pkts_cnt[31:0];
    } RX_BC_PKTS @ 0x90;
    reg {
        name = "RX_PKTS_64OCTETS";
        desc = "RX_PKTS_64OCTETS is a frame count register for RX 64-byte frames. (offset 0x94; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 5.7, PDF page 1013).";
        field {
            name = "rx_pks_64oct_cnt";
            desc = "Count of RX 64-byte frames, including bad frames";
            sw = r; hw = w; onread = rclr;
            reset = 0x0;
        } rx_pks_64oct_cnt[31:0];
    } RX_PKTS_64OCTETS @ 0x94;
    reg {
        name = "RX_PKTS_65TO127OCTETS";
        desc = "RX_PKTS_65TO127OCTETS is a frame count register for RX frames ranging from 65 bytes to 127 bytes in length. (offset 0x98; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 5.7, PDF page 1013).";
        field {
            name = "rx_pks_65to127_oct_cnt";
            desc = "Count of RX frames ranging from 65 bytes to 127 bytes in length, including bad frames";
            sw = r; hw = w; onread = rclr;
            reset = 0x0;
        } rx_pks_65to127_oct_cnt[31:0];
    } RX_PKTS_65TO127OCTETS @ 0x98;
    reg {
        name = "RX_PKTS_128TO255OCTETS";
        desc = "RX_PKTS_128TO255OCTETS is a frame count register for RX frames ranging from 128 bytes to 255 bytes in length. (offset 0x9C; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 5.7, PDF page 1014).";
        field {
            name = "rx_pkts_128to255_oct_cnt";
            desc = "Count of RX frames ranging from 128 bytes to 255 bytes in length, including bad frames";
            sw = r; hw = w; onread = rclr;
            reset = 0x0;
        } rx_pkts_128to255_oct_cnt[31:0];
    } RX_PKTS_128TO255OCTETS @ 0x9C;
    reg {
        name = "RX_PKTS_255TO511OCTETS";
        desc = "RX_PKTS_255TO511OCTETS is a frame count register for RX frames ranging from 256 bytes to 511 bytes in length. (offset 0xA0; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 5.7, PDF page 1014).";
        field {
            name = "rx_pkts_256to511_oct_cnt";
            desc = "Count of RX frames ranging from 256 bytes to 511 bytes in length, including bad frames";
            sw = r; hw = w; onread = rclr;
            reset = 0x0;
        } rx_pkts_256to511_oct_cnt[31:0];
    } RX_PKTS_255TO511OCTETS @ 0xA0;
    reg {
        name = "RX_PKTS_512TO1023OCTETS";
