    reg {
        name = "VOIE_LLISTATE6";
        desc = "VOIE_LLISTATE6 is G726 encoding channel variable register 6. (offset 0x68; total reset 0x04000400; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 11.6, PDF page 1418).";
        field {
            name = "DQ1";
            desc = "G726 encoding channel variable. Quantization difference signal when the delay is 1.";
            sw = r; hw = w;
            reset = 0x20;
