`ifndef HI3520DV300_VOIE_RDL
`define HI3520DV300_VOIE_RDL
regfile eHI3520DV300_VOIE {
    name = "Video output image enhancement (VOIE)";
    desc = "Video output image enhancement (VOIE) of the Hi3521A/Hi3520D V300 at base 0x1312_0000. 27 registers extracted programmatically from the Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10) (Table 11-1 Summary of the VOIE registers (base address: 0x1312_0000)): register headings, offsets, total reset values, field bit ranges, access types, names, reset values and descriptions, with PDF page numbers in each register description. Field names, bit ranges, access types and offsets are exact; the free-text descriptions are taken from the cell text of the field table and were checked by sampling only. Hardware not verified.";
    reg {
        name = "VOIE_INTSTAT";
        desc = "VOIE_INTSTAT is an interrupt status register. (offset 0x0; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 11.6, PDF page 1405).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_25[31:25];
        field {
            name = "cfgErr";
            desc = "Configuration error flag.
- 0: correct
- 1: error";
            sw = r; hw = w;
            reset = 0x0;
        } cfgErr[24:24];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_23_17[23:17];
        field {
            name = "chkErr";
            desc = "Channel variable check error flag.
- 0: correct
- 1: error";
            sw = r; hw = w;
            reset = 0x0;
        } chkErr[16:16];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_15_9[15:9];
        field {
            name = "VoieEndofSingle";
            desc = "Single channel encoding completion flag.
- 0: incomplete
- 1: complete";
            sw = r; hw = w;
            reset = 0x0;
        } VoieEndofSingle[8:8];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_1[7:1];
        field {
            name = "VoieEndOfFrame";
            desc = "Frame encoding completion flag.
- 0: incomplete
- 1: complete";
            sw = r; hw = w;
            reset = 0x0;
        } VoieEndOfFrame[0:0];
    } VOIE_INTSTAT @ 0x0;
    reg {
        name = "VOIE_INTMASK";
        desc = "VOIE_INTMASK is an interrupt mask register. (offset 0x4; total reset 0x01010101; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 11.6, PDF page 1406).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_25[31:25];
        field {
            name = "cfgErrMask";
            desc = "Configuration error flag mask enable.
- 0: enabled
- 1: disabled";
            sw = rw; hw = r;
            reset = 0x1;
        } cfgErrMask[24:24];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_23_17[23:17];
        field {
            name = "chkErrMask";
            desc = "Check error flag mask enable.
- 0: enabled
- 1: disabled";
            sw = rw; hw = r;
            reset = 0x1;
        } chkErrMask[16:16];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_15_9[15:9];
        field {
            name = "VoieEndofSingleMask";
            desc = "Single channel encoding completion mask enable.
- 0: enabled
- 1: disabled";
            sw = rw; hw = r;
            reset = 0x1;
        } VoieEndofSingleMask[8:8];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_1[7:1];
        field {
            name = "VoieEndOfPicMask";
            desc = "Frame encoding completion mask enable.
- 0: enabled
- 1: disabled";
            sw = rw; hw = r;
            reset = 0x1;
        } VoieEndOfPicMask[0:0];
    } VOIE_INTMASK @ 0x4;
    reg {
        name = "VOIE_RAWINT";
        desc = "VOIE_RAWINT is a raw interrupt status register. (offset 0x8; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 11.6, PDF page 1407).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_25[31:25];
        field {
            name = "cfgErr";
            desc = "Configuration error flag.
- 0: correct
- 1: incorrect";
            sw = r; hw = w;
            reset = 0x0;
        } cfgErr[24:24];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_23_17[23:17];
        field {
            name = "chkErr";
            desc = "Channel variable check error flag.
- 0: correct
- 1: error";
            sw = r; hw = w;
            reset = 0x0;
        } chkErr[16:16];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_15_9[15:9];
        field {
            name = "VoieEndofSingle";
            desc = "Single channel encoding completion flag.
- 0: incomplete
- 1: complete";
            sw = r; hw = w;
            reset = 0x0;
        } VoieEndofSingle[8:8];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_1[7:1];
        field {
            name = "VoieEndOfFrame";
            desc = "Frame encoding completion flag.
- 0: incomplete
- 1: complete";
            sw = r; hw = w;
            reset = 0x0;
        } VoieEndOfFrame[0:0];
    } VOIE_RAWINT @ 0x8;
    reg {
        name = "VOIE_INTCLR";
        desc = "VOIE_INTCLR is an interrupt clear register. (offset 0xC; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 11.6, PDF page 1408).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_25[31:25];
        field {
            name = "cfgErrClr";
            desc = "Configuration error source interrupt clear. Writing 1 clears this bit.

Access type WC in the data sheet: written 1 clears the bit.";
            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } cfgErrClr[24:24];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_23_17[23:17];
        field {
            name = "chkErrClr";
            desc = "Channel variable check error flag source interrupt clear. Writing 1 clears this bit.

Access type WC in the data sheet: written 1 clears the bit.";
            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } chkErrClr[16:16];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_15_9[15:9];
        field {
            name = "VoieEndofSingleClr";
            desc = "Single channel encoding completion source interrupt clear. Writing 1 clears this bit.

Access type WC in the data sheet: written 1 clears the bit.";
            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } VoieEndofSingleClr[8:8];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_1[7:1];
        field {
            name = "VoieEndOfFrameClr";
            desc = "Frame encoding completion source interrupt clear. Writing 1 clears this bit.

Access type WC in the data sheet: written 1 clears the bit.";
            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } VoieEndOfFrameClr[0:0];
    } VOIE_INTCLR @ 0xC;
    reg {
        name = "VIOE_START";
        desc = "VIOE_START is an encoding start signal register. (offset 0x10; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 11.6, PDF page 1409).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_1[31:1];
        field {
            name = "Start";
            desc = "Encoding start signal.
- 0: not start
- 1: start";
            sw = w; hw = r;
            reset = 0x0;
        } Start[0:0];
    } VIOE_START @ 0x10;
    reg {
        name = "VOIE_OUTSTDING";
        desc = "VOIE_OUTSTDING is an outstanding configuration register. (offset 0x14; total reset 0x00000007; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 11.6, PDF page 1409).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_4[31:4];
        field {
            name = "voieoutstd";
            desc = "Outstanding depth of the AXI port. The depth range is 0-7.";
            sw = rw; hw = r;
            reset = 0x7;
        } voieoutstd[3:0];
    } VOIE_OUTSTDING @ 0x14;
    reg {
        name = "VOIE_MODE";
        desc = "VOIE_MODE is a VOIE working mode register. (offset 0x20; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 11.6, PDF page 1410).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_19[31:19];
        field {
            name = "memClkGateEn";
            desc = "Memory clock gating enable. Note: This field is invalid and can be ignored.";
            sw = rw; hw = r;
            reset = 0x0;
        } memClkGateEn[18:18];
        field {
            name = "clkGateEn";
            desc = "Clock gating enable Note: This field is invalid and can be ignored.";
            sw = rw; hw = r;
            reset = 0x0;
        } clkGateEn[17:16];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_15_9[15:9];
        field {
            name = "accesslockEn";
            desc = "Internal configuration lock enable. Note: This field is invalid and can be ignored.";
            sw = rw; hw = r;
            reset = 0x0;
        } accesslockEn[8:8];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_2[7:2];
        field {
            name = "timeEn";
            desc = "Timeout check enable. Note: This field is invalid and can be ignored.";
            sw = rw; hw = r;
            reset = 0x0;
        } timeEn[1:0];
    } VOIE_MODE @ 0x20;
    reg {
        name = "VOIE_CFG";
        desc = "VOIE_CFG is a first linked list address register. (offset 0x28; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 11.6, PDF page 1411).";
        field {
            name = "AddrOfFirstLLI";
            desc = "Address for the first linked list for storing the current audio frame. Note: The address must be configured before encoding and must be 128-bit-aligned.";
            sw = rw; hw = r;
            reset = 0x0;
        } AddrOfFirstLLI[31:0];
    } VOIE_CFG @ 0x28;
    reg {
        name = "VOIE_LLICFG0";
        desc = "VOIE_LLICFG0 is a linked list member register (SrcPhyAddr). (offset 0x30; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 11.6, PDF page 1411).";
        field {
            name = "SrcPhyAddr";
            desc = "Start physical address for storing the voice frame data to be encoded in the DDR. The address must be 128-bit-aligned. The address is written to the corresponding linked list DDR addresses by the software before encoding and is loaded by the AXI bus after encoding starts. Note: This register is provided only for readback during debugging.";
            sw = r; hw = w;
            reset = 0x0;
        } SrcPhyAddr[31:0];
    } VOIE_LLICFG0 @ 0x30;
    reg {
        name = "VOIE_LLICFG1";
        desc = "VOIE_LLICFG1 is a linked list member register (DstPhyAddr). (offset 0x34; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 11.6, PDF page 1411).";
        field {
            name = "DstPhyAddr";
            desc = "The physical address of streams output to the DDR after encoding. The 128-bit address must be aligned. The address is written to the corresponding linked list DDR addresses by the software before encoding and is loaded by the AXI bus after encoding starts. Note: This register is provided only for readback during debugging.";
            sw = r; hw = w;
            reset = 0x0;
        } DstPhyAddr[31:0];
    } VOIE_LLICFG1 @ 0x34;
    reg {
        name = "VOIE_LLICFG2";
        desc = "VOIE_LLICFG2 is a linked list member register (StatePhyAddr). (offset 0x38; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 11.6, PDF page 1412).";
        field {
            name = "StatePhyAddr";
            desc = "The physical address for storing the voice frame data to be encoded in the DDR. The address must be 128-bit aligned. This address must be configured during the G726 encoding and ADPCM encoding. As channel variables are not used during the G711 encoding, this register can be ignored. The address is written to the corresponding linked list DDR addresses by the software before encoding and is loaded by the AXI bus. Note: This register is provided only for readback during debugging.";
            sw = r; hw = w;
            reset = 0x0;
        } StatePhyAddr[31:0];
    } VOIE_LLICFG2 @ 0x38;
    reg {
        name = "VOIE_LLICFG3";
        desc = "VOIE_LLICFG3 is a linked list member register (NextLLiAddr). (offset 0x3C; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 11.6, PDF page 1412).";
        field {
            name = "NextLLiAddr";
            desc = "Memory address of the next channel linked list. The address must be 128-bit aligned. If the current channel is the last channel of this frame, set the next linked list address to 0x00000000; otherwise, the next linked list address cannot be set to 0. The address is written to the corresponding linked list DDR addresses by the software before encoding and is loaded by the AXI bus after encoding starts. Note: This register is provided only for readback during debugging.";
            sw = r; hw = w;
            reset = 0x0;
        } NextLLiAddr[31:0];
    } VOIE_LLICFG3 @ 0x3C;
    reg {
        name = "VOIE_LLICFG4";
        desc = "VOIE_LLICFG4 is a linked list member register (StCtrl, encoding control). (offset 0x40; total reset 0x00000081; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 11.6, PDF page 1413).";
        field {
            name = "SamplesPerFrame";
            desc = "Number of audio sampling points in the current voice frame. The values range is 80-2880 and the value must an integral multiple of 80. The address is written to the corresponding linked list DDR addresses by the software before encoding and is loaded by the AXI bus after encoding starts. Note: This register is provided only for readback during debugging.";
            sw = r; hw = w;
            reset = 0x0;
        } SamplesPerFrame[31:16];
        field {
            name = "Codec";
            desc = "Encoding type configuration.
- 0x01: G711 Alaw
- 0x02: G711 Ulaw
- 0x03: ADPCM_DIV4
- 0x04: G726_16 kbps
- 0x05: G726_24 kbps
- 0x06: G726_32 kbps
- 0x07: G726_40 kbps
- 0x24: MEDIA_G726_16 kbps
- 0x25: MEDIA_G726_24 kbps
- 0x26: MEDIA_G726_32 kbps
- 0x27: MEDIA_G726_40 kbps
- 0x43: ADPCM_ORG_DIV4

Other values: invalid configuration. If the VOIE receives other configurations, a configuration error interrupt is reported. The address is written to the corresponding linked list DDR addresses by the software before encoding and is loaded by the AXI bus after encoding starts. Note: This register is provided only for readback during debugging.";
            sw = r; hw = w;
            reset = 0x0;
        } Codec[15:8];
        field {
            name = "hisi_head";
            desc = "Output stream HiSilicon frame header enable.
- 0: exclude HiSilicon frame header
- 1: include HiSilicon frame header

This bit is set to 0x1 by default. The address is written to the corresponding linked list DDR addresses by the software before encoding and is loaded by the AXI bus after encoding starts. Note: This register is provided only for readback during debugging.";
            sw = rw; hw = r;
            reset = 0x1;
        } hisi_head[7:7];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x1;
        } reserved_6_0[6:0];
    } VOIE_LLICFG4 @ 0x40;
    reg {
        name = "VOIE_LLISTATE0";
        desc = "VOIE_LLISTATE0 is G726 encoding channel variable register 0. (offset 0x50; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 11.6, PDF page 1415).";
        field {
            name = "A1";
            desc = "G726 encoding channel variable. Two-tap pole predictor coefficient 1.";
            sw = r; hw = w;
            reset = 0x0;
        } A1[31:16];
        field {
            name = "A2";
            desc = "G726 encoding channel variable. Two-tap pole predictor coefficient 2.";
            sw = r; hw = w;
            reset = 0x0;
        } A2[15:0];
    } VOIE_LLISTATE0 @ 0x50;
    reg {
        name = "VOIE_LLISTATE1";
        desc = "VOIE_LLISTATE1 is G726 encoding channel variable register 1. (offset 0x54; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 11.6, PDF page 1415).";
        field {
