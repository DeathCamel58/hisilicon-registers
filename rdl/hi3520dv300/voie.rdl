            desc = "G726 encoding channel variable. Delay speed control.";
            sw = r; hw = w;
            reset = 0x0;
        } AP[31:22];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_21_16[21:16];
        field {
            name = "PK1";
            desc = "G726 encoding channel variable. DQ+SEZ signed bit when the delay is 1.";
            sw = r; hw = w;
            reset = 0x0;
        } PK1[15:15];
        field {
            name = "PK2";
            desc = "G726 encoding channel variable. DQ+SEZ signed bit when the delay is 2.";
            sw = r; hw = w;
            reset = 0x0;
        } PK2[14:14];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_13_1[13:1];
        field {
            name = "TD";
            desc = "G726 encoding channel variable. Single audio detection signal.";
            sw = r; hw = w;
            reset = 0x0;
        } TD[0:0];
    } VOIE_LLISTATE1 @ 0x54;
    reg {
        name = "VOIE_LLISTATE2";
        desc = "VOIE_LLISTATE2 is G726 encoding channel variable register 2. (offset 0x58; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 11.6, PDF page 1416).";
        field {
            name = "B1";
            desc = "G726 encoding channel variable. Six-tap pole predictor coefficient 1.";
            sw = r; hw = w;
            reset = 0x0;
        } B1[31:16];
        field {
            name = "B2";
            desc = "G726 encoding channel variable. Six-tap pole predictor coefficient 2.";
            sw = r; hw = w;
            reset = 0x0;
        } B2[15:0];
    } VOIE_LLISTATE2 @ 0x58;
    reg {
        name = "VOIE_LLISTATE3";
        desc = "VOIE_LLISTATE3 is G726 encoding channel variable register 3. (offset 0x5C; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 11.6, PDF page 1416).";
        field {
            name = "B3";
            desc = "G726 encoding channel variable. Six-tap pole predictor coefficient 3.";
            sw = r; hw = w;
            reset = 0x0;
        } B3[31:16];
        field {
            name = "B4";
            desc = "G726 encoding channel variable. Six-tap pole predictor coefficient 4.";
            sw = r; hw = w;
            reset = 0x0;
        } B4[15:0];
    } VOIE_LLISTATE3 @ 0x5C;
    reg {
        name = "VOIE_LLISTATE4";
        desc = "VOIE_LLISTATE4 is G726 encoding channel variable register 4. (offset 0x60; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 11.6, PDF page 1417).";
        field {
            name = "B5";
            desc = "G726 encoding channel variable. Six-tap pole predictor coefficient 5.";
            sw = r; hw = w;
            reset = 0x0;
        } B5[31:16];
        field {
            name = "B6";
            desc = "G726 encoding channel variable. Six-tap pole predictor coefficient 6.";
            sw = r; hw = w;
            reset = 0x0;
        } B6[15:0];
    } VOIE_LLISTATE4 @ 0x60;
    reg {
        name = "VOIE_LLISTATE5";
        desc = "VOIE_LLISTATE5 is G726 encoding channel variable register 5. (offset 0x64; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 11.6, PDF page 1417).";
        field {
