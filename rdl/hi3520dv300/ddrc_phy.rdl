    reg {
        name = "SWTMODE";
        desc = "SWTMODE is an S/W training mode register. (offset 0xA0; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 888).";
        field {
            name = "wl_wdqs_gated";
            desc = "Write leveling WDQS strobe disable when the related PH/BDL is tuned to prevent glitch.
- 0: not gated
- 1: gated (disable WDQS strobe)";
            sw = rw; hw = r;
            reset = 0x0;
        } wl_wdqs_gated[31:31];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_30_2[30:2];
        field {
            name = "sw_gtmode";
            desc = "Set this bit to 1 when performing S/W gate training or GDS training.";
            sw = rw; hw = r;
            reset = 0x0;
        } sw_gtmode[1:1];
        field {
            name = "sw_wlmode";
            desc = "Set this bit to 1 when performing S/W write leveling training.";
            sw = rw; hw = r;
            reset = 0x0;
        } sw_wlmode[0:0];
    } SWTMODE @ 0xA0;
    reg {
        name = "SWTWLDQS";
        desc = "SWTWLDQS is a write DQS issue register during S/W write leveling training. (offset 0xA4; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 888).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_1[31:1];
        field {
            name = "sw_wl_dqs";
            desc = "Writing 1 to this bit once issues one DQS pulse from the PHY to DRAM.";
            sw = w; hw = r;
            reset = 0x0;
        } sw_wl_dqs[0:0];
    } SWTWLDQS @ 0xA4;
    reg {
        name = "SWTRLT";
        desc = "SWTRLT is an S/W training result register. (offset 0xA8; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 889).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_24[31:24];
        field {
            name = "gds_result";
            desc = "Each bit corresponds to one byte lane.";
            sw = r; hw = w;
            reset = 0x0;
        } gds_result[23:16];
        field {
            name = "gt_result";
            desc = "Each bit corresponds to one byte lane.";
            sw = r; hw = w;
            reset = 0x0;
        } gt_result[15:8];
        field {
            name = "wl_dq_result";
            desc = "Each bit corresponds to one byte lane.";
            sw = r; hw = w;
            reset = 0x0;
        } wl_dq_result[7:0];
    } SWTRLT @ 0xA8;
    reg {
        name = "PHYCTRL2";
        desc = "PHYCTRL2 is PHY control register 2. Register in this field are connected to PHY interface directly (offset 0xAC; total reset 0x0000000B; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 889).";
        field {
            name = "reserved";
