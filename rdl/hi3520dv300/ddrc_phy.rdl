            reset = 0x0;
        } phy_dyn_pupden[4:4];
        field {
            name = "phy_dummypad_use";
            desc = "DATA16BIT_blk.reg_dummypad_use control.";
            sw = rw; hw = r;
            reset = 0x1;
        } phy_dummypad_use[3:3];
        field {
            name = "phy_odten_gated";
            desc = "DATA16BIT_blk.reg_ODTEN_Gated control.";
            sw = rw; hw = r;
            reset = 0x0;
        } phy_odten_gated[2:2];
        field {
            name = "phy_gatetdc";
            desc = "DATA16BIT_blk.BUFRESETCONTN_gated_TDC control.";
            sw = rw; hw = r;
            reset = 0x1;
        } phy_gatetdc[1:1];
        field {
            name = "phy_dqsgerror";
            desc = "DATA16BIT_blk.BUFRESETCONTN_gated_DQSGERROR control.";
            sw = rw; hw = r;
            reset = 0x1;
        } phy_dqsgerror[0:0];
    } PHYCTRL2 @ 0xAC;
    reg {
        name = "IOCTL1";
        desc = "IOCTL1 is I/O PHY control register 1. Register in this field are connected to PHY interface directly (offset 0xB0; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 890).";
        field {
            name = "reserved";
