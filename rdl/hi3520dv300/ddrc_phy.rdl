    reg {
        name = "PHYPLLCTRL_AC";
        desc = "PHYPLLCTRL_AC is PHY PLL control register 1. Register in this field are connected to PHY interface directly (offset 0x98; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 887).";
        field {
