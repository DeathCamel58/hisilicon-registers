            reset = 0x0;
        } ioctl_genvref_refsel_1[23:18];
        field {
            name = "ioctl_genvref_refsel_0";
            desc = "Set this field to default value.";
            sw = rw; hw = r;
            reset = 0x0;
        } ioctl_genvref_refsel_0[17:12];
        field {
            name = "ioctl_genvref_rangel_1";
            desc = "Set this field to default value.";
            sw = rw; hw = r;
            reset = 0x0;
        } ioctl_genvref_rangel_1[11:6];
        field {
            name = "ioctl_genvref_rangel_0";
            desc = "Set this field to default value.";
            sw = rw; hw = r;
            reset = 0x0;
        } ioctl_genvref_rangel_0[5:0];
    } IOCTL2 @ 0xB4;
    reg {
        name = "BISTTIMER";
        desc = "BISTTIMER is a code update period register during BIST running. (offset 0xB8; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 891).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_16[31:16];
        field {
            name = "bstupdt_timer";
            desc = "BIST update code timer. This field controls the code update period. If this field is programmed to a non-zero value, the BIST is temporarily stopped, and the internal delay code is updated to the PHY when the timer reaches the configured value. The BIST will continue if the code update is complete. If this field is programmed to zero, the update code mechanism is disabled.";
            sw = rw; hw = r;
            reset = 0x0;
        } bstupdt_timer[15:0];
    } BISTTIMER @ 0xB8;
    reg {
        name = "TRAINCTRL1";
        desc = "TRAINCTRL1 is data training control register 1. (offset 0xD0; total reset 0xF036F026; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 892).";
        field {
            name = "rdet_lbs_en";
            desc = "Read DET left boundary search enable.";
            sw = rw; hw = r;
            reset = 0x1;
        } rdet_lbs_en[31:31];
        field {
            name = "rdet_ds_en";
            desc = "Read DET deskew enable.";
            sw = rw; hw = r;
            reset = 0x1;
        } rdet_ds_en[30:30];
        field {
            name = "rdet_rbs_en";
            desc = "Read DET right boundary search enable.";
            sw = rw; hw = r;
            reset = 0x1;
        } rdet_rbs_en[29:29];
        field {
            name = "rdet_av_en";
            desc = "Read DET average stage enable";
            sw = rw; hw = r;
            reset = 0x1;
        } rdet_av_en[28:28];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_27_27[27:27];
        field {
            name = "rdet_rb_backtap";
            desc = "Read DET right boundary back tap. This field is used to offset (+) the rdqsbdl before the right boundary search is started to overcome meta-sable zone.";
            sw = rw; hw = r;
            reset = 0x3;
        } rdet_rb_backtap[26:20];
        field {
            name = "rdet_samp_num";
            desc = "Read DET sample number control. The multiple sample is used to overcome the meta situations. Valid value: 1-15";
            sw = rw; hw = r;
            reset = 0x6;
        } rdet_samp_num[19:16];
        field {
            name = "wdet_lbs_en";
            desc = "Write DET left boundary search enable.";
            sw = rw; hw = r;
            reset = 0x1;
        } wdet_lbs_en[15:15];
        field {
            name = "wdet_ds_en";
            desc = "Write DET deskew enable.";
            sw = rw; hw = r;
            reset = 0x1;
        } wdet_ds_en[14:14];
        field {
            name = "wdet_rbs_en";
            desc = "Write DET right boundary search enable.";
            sw = rw; hw = r;
            reset = 0x1;
        } wdet_rbs_en[13:13];
        field {
            name = "wrdet_av_en";
            desc = "Write DET average stage enable.";
            sw = rw; hw = r;
            reset = 0x1;
        } wrdet_av_en[12:12];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_11_8[11:8];
        field {
            name = "wdet_rb_backtap";
            desc = "Write DET right boundary back tap. This field is used to offset (-) the wdqphase before the right boundary search is started to overcome meta-sable zone.";
            sw = rw; hw = r;
            reset = 0x2;
        } wdet_rb_backtap[7:4];
        field {
            name = "wdet_samp_num";
            desc = "Write DET sample number control. The multiple sample is used to overcome the meta situations. Valid value: 1-15";
            sw = rw; hw = r;
            reset = 0x6;
        } wdet_samp_num[3:0];
    } TRAINCTRL1 @ 0xD0;
    reg {
        name = "TRAINCTRL2";
        desc = "TRAINCTRL2 is data training control register 2. (offset 0xD4; total reset 0x0000CC55; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 893).";
        field {
            name = "rdet_method_sel";
            desc = "Read DET method select.
- 0: write-then-read
- 1: MRR32/40 (only for LPDDR3)";
            sw = rw; hw = r;
            reset = 0x0;
        } rdet_method_sel[31:31];
        field {
            name = "mrr_pat_order";
            desc = "MRR pattern order. If MRR is used in the read DET, PACK will issue three MRR commands. The order is indicated by bit 2 -> bit 1 -> bit 0.
- 0: MRR32
- 1: MRR40";
            sw = rw; hw = r;
            reset = 0x0;
        } mrr_pat_order[30:28];
        field {
            name = "mrr_bl4";
            desc = "MRR burst 4 indicator. If MRR is used in the read DET, PACK needs to know whether MRR burst is 4 (LPDDR2) or 8 (LPDDR3).
- 0: MRR32/40 burst length = 8 (default)
- 1: MRR32/40 burst length = 4";
            sw = rw; hw = r;
            reset = 0x0;
        } mrr_bl4[27:27];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_26_25[26:25];
        field {
            name = "gds_automrg_en";
            desc = "GDS training/retraining auto tuning enable.
- 0: disable GDS auto margin tuning (will increase GDS when GDS training/retraining is complete)
- 1: enable GDS auto margin tuning (default)";
            sw = rw; hw = r;
            reset = 0x0;
        } gds_automrg_en[24:24];
        field {
            name = "mrr_pat_mask";
            desc = "MRR pattern mask.
- 0: not masked
- 1: masked (does not compare data)";
            sw = rw; hw = r;
            reset = 0x0;
        } mrr_pat_mask[23:16];
        field {
            name = "mrr_pat_B";
            desc = "MRR40 pattern. This field should comply with the LPDDR2/LPDDR3 specifications.";
            sw = rw; hw = r;
            reset = 0xcc;
        } mrr_pat_B[15:8];
        field {
            name = "mrr_pat_A";
            desc = "MRR32 pattern. This field should comply with the LPDDR2/LPDDR3 specifications.";
            sw = rw; hw = r;
            reset = 0x55;
        } mrr_pat_A[7:0];
    } TRAINCTRL2 @ 0xD4;
    reg {
        name = "REGBANKCTRL";
        desc = "REGBANKCTRL is register bank control register. (offset 0xD8; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 894).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_2[31:2];
        field {
            name = "op_sel";
            desc = "Register bank select related to DFS.
- 0: bank 0 for PHY operating
- 1: bank 1 for PHY operating";
            sw = rw; hw = r;
            reset = 0x0;
        } op_sel[1:1];
        field {
            name = "wr_sel";
            desc = "Register bank select related to DFS.
- 0: bank 0 while APB read/write
- 1: bank 1 while APB read/write";
            sw = rw; hw = r;
            reset = 0x0;
        } wr_sel[0:0];
    } REGBANKCTRL @ 0xD8;
    reg {
        name = "TRAINCTRL3";
        desc = "TRAINCTRL3 is data training control register 3. (offset 0xDC; total reset 0x80020300; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 895).";
        field {
            name = "exd_gtres_en";
            desc = "Extended gate result enable. When this field is set as high, the PACK will use additional information (EN_DQSx_regread) to help extend the gate result in the \"fine tune stage of gate training\" and \"gate retraining.\"
- 0: disabled
- 1: enabled (default)";
            sw = rw; hw = r;
            reset = 0x1;
        } exd_gtres_en[31:31];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_30_19[30:19];
        field {
            name = "gdsrt_backtap";
            desc = "GDS retraining back tap. This field controls the number of back taps during GDS retraining. The value range is 1-7. The recommended value range is 1-2.";
            sw = rw; hw = r;
            reset = 0x2;
        } gdsrt_backtap[18:16];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_15_12[15:12];
        field {
            name = "rpat_cnt_num_open";
            desc = "RDET pattern length control for eye open. This field is used to set the pattern length for eye open. The same RDET pattern will be extended as the following settings (field value + 1):
- 0x0: pattern length = 1
- 0x1: pattern length = 2 ...
- 0xF: pattern length = 16";
            sw = rw; hw = r;
            reset = 0x3;
        } rpat_cnt_num_open[11:8];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_4[7:4];
        field {
            name = "rpat_cnt_num";
            desc = "RDET pattern length control. This field is used to set the pattern length. The same RDET pattern will be extended as the following settings (field value + 1):
- 0x0: pattern length = 1
- 0x1: pattern length = 2 ...
- 0xF: pattern length = 16";
            sw = rw; hw = r;
            reset = 0x0;
        } rpat_cnt_num[3:0];
    } TRAINCTRL3 @ 0xDC;
    reg {
        name = "ACBISTCTRL0";
        desc = "ACBISTCTRL0 is comparison control register 0 while BIST activated. (offset 0x100; total reset 0x40000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 896).";
        field {
            name = "ac_rdffsel";
            desc = "AC loopback read latch select.";
            sw = rw; hw = r;
            reset = 0x2;
        } ac_rdffsel[31:29];
        field {
            name = "aclpbk_tg";
            desc = "AC loopback toggle control. The user should not modify this bit. It is related to the analog PHY design.
- 0: 28LPP PHY (default)
- 1: 40PHY";
            sw = rw; hw = r;
            reset = 0x0;
        } aclpbk_tg[28:28];
        field {
            name = "acbist_en";
            desc = "BIST enable. This field specifies whether the AC block is included for loopback test while bist_op is set to BIST Enable.";
            sw = rw; hw = r;
            reset = 0x0;
        } acbist_en[27:27];
        field {
            name = "rst_cmp_mask";
            desc = "RST loopback compare mask. This field controls whether the comparison of the loopback data on the RST bit is disabled.
- 0: not compared
- 1: compared";
            sw = rw; hw = r;
            reset = 0x0;
        } rst_cmp_mask[26:26];
        field {
            name = "cs_cmp_mask";
            desc = "CS loopback compare mask. This field controls whether the comparison of the loopback data on the CS bits is disabled.
- 0: not compared
- 1: compared";
            sw = rw; hw = r;
            reset = 0x0;
        } cs_cmp_mask[25:22];
        field {
            name = "ras_cmp_mask";
            desc = "RAS loopback compare mask. This field controls whether the comparison of the loopback data on RAS is disabled.
- 0: not compared
- 1: compared";
            sw = rw; hw = r;
            reset = 0x0;
        } ras_cmp_mask[21:21];
        field {
            name = "cas_cmp_mask";
            desc = "CAS loopback compare mask. This field controls whether the comparison of the loopback data on CAS is disabled.
- 0: not compared
- 1: compared";
            sw = rw; hw = r;
            reset = 0x0;
        } cas_cmp_mask[20:20];
        field {
            name = "we_cmp_mask";
            desc = "Write enable loopback compare mask. This field controls whether the comparison of the loopback data on WE is disabled.
- 0: not compared
- 1: compared";
            sw = rw; hw = r;
            reset = 0x0;
        } we_cmp_mask[19:19];
        field {
            name = "ba_cmp_mask";
            desc = "Bank address loopback compare mask. This field controls whether the comparison of the loopback data on bank address bits is disabled.
- 0: not compared
- 1: compared";
            sw = rw; hw = r;
            reset = 0x0;
        } ba_cmp_mask[18:16];
        field {
            name = "addr_cmp_mask";
            desc = "Memory address loopback compare mask. This field controls whether the comparison of the loopback data on address bits is disabled.
- 0: not compared
- 1: compared";
            sw = rw; hw = r;
            reset = 0x0;
        } addr_cmp_mask[15:0];
    } ACBISTCTRL0 @ 0x100;
    reg {
        name = "ACBISTCTRL1";
        desc = "ACBISTCTRL1 is comparison control register 1 while BIST activated. (offset 0x104; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 897).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_16[31:16];
        field {
            name = "ac_lfsr_seed";
            desc = "LFSR seed value. This field specifies the initial seed value of the LFSR generator to this byte lane.";
            sw = rw; hw = r;
            reset = 0x0;
        } ac_lfsr_seed[15:8];
        field {
            name = "cke_cmp_mask";
            desc = "CKE loopback compare mask. This field controls whether the comparison of the loopback data on CKE bits is disabled.
- 0: not compared
- 1: compared";
            sw = rw; hw = r;
            reset = 0x0;
        } cke_cmp_mask[7:4];
        field {
            name = "odt_cmp_mask";
            desc = "ODT loopback compare mask. This field controls whether the comparison of the loopback data on ODT bits is disabled.
