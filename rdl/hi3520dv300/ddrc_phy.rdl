`ifndef HI3520DV300_DDRC_PHY_RDL
`define HI3520DV300_DDRC_PHY_RDL
regfile eHI3520DV300_DDRC_PHY {
    name = "DDR PHY";
    desc = "DDR PHY of the Hi3521A/Hi3520D V300 at base 0x1211_C000. 128 registers extracted programmatically from the Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10) (Table 4-12 Summary of DDR PHY registers (base address: 0x1211_C000)): register headings, offsets, total reset values, field bit ranges, access types, names, reset values and descriptions, with PDF page numbers in each register description. Field names, bit ranges, access types and offsets are exact; the free-text descriptions are taken from the cell text of the field table and were checked by sampling only. Hardware not verified.";
    reg {
        name = "REVISION";
        desc = "REVISION is a PHY control block version register. (offset 0x0; total reset 0x00000012; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 854).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_16[31:16];
        field {
            name = "major";
            desc = "Major version of the PHY control block.";
            sw = r; hw = w;
            reset = 0x0;
        } major[15:8];
        field {
            name = "minor";
            desc = "Minor version of the PHY control block.";
            sw = r; hw = w;
            reset = 0x12;
        } minor[7:0];
    } REVISION @ 0x0;
    reg {
        name = "PHYINITCTRL";
        desc = "PHYINITCTRL is a PHY initialization control register. Writing to this register has no effect if init_en is 1. (offset 0x4; total reset 0x0000000E; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 855).";
        field {
            name = "ctl_cke_bypass";
            desc = "PACK CKE bypass function enable. 1'b1: CKE is controlled by MC even when PACK controls the DFI interface. 1'b0: CKE is controlled by PACK when PACK controls the DFI interface.";
            sw = rw; hw = r;
            reset = 0x0;
        } ctl_cke_bypass[31:31];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_30_16[30:16];
        field {
            name = "phyconn_rst";
            desc = "PHY counter reset. This field is used to set the PHY counter reset signal. To issue a reset signal to PHY counter, this field should be set to 1. To end the reset signal to PHY counter, this field should be cleared. Note that the reset signal connects to the A/C block counter and the counter of all of the data blocks.";
            sw = rw; hw = r;
            reset = 0x0;
        } phyconn_rst[15:15];
        field {
            name = "pack_rst";
            desc = "PACK reset. This field is used to issue reset to all the digital circuits of the PACK including the register file. If this field is set to 1, all of the digital parts (including control registers) of the PHY will be set to default value. The reset will be automatically executed, and this bit will be cleared after reset is complete.";
            sw = rw; hw = r;
            reset = 0x0;
        } pack_rst[14:14];
        field {
            name = "phy_rst";
            desc = "PHY reset. This field is used to set PHY reset signal. To issue a reset signal to the PHY, this field should be set to 1. To end the reset signal to the PHY, this field should be cleared. Note that the reset signal connects to the A/C block and all of the data blocks.";
            sw = rw; hw = r;
            reset = 0x0;
        } phy_rst[13:13];
        field {
            name = "dram_rst";
            desc = "DRAM reset. This field is used to initiate the DRAM reset sequence. If this field is set to 1, RESET# and CKE will be pulled low for t_dram_rst. After t_dram_rst, the CKE RESET# is pulled to high while keeping CKE at low for t_cke_low. After t_cke_low, CKE is pulled to high, and after t_cke_high, this field is cleared automatically. For LPDDR2/LPDDR3, only CKE will be active during DRAM reset sequence.";
            sw = rw; hw = r;
            reset = 0x0;
        } dram_rst[12:12];
        field {
            name = "cat_en";
            desc = "HW CA training enable. Writing 1 to this field starts the HW CA training sequence. This field will be cleared after CA training is complete. Note that the CA training applies only to LPDDR3.";
            sw = rw; hw = r;
            reset = 0x0;
        } cat_en[11:11];
        field {
            name = "dram_init_en";
            desc = "DRAM initialization enable. This field is used to control whether the internal DRAM initialization sequence is executed after PHY initialization is complete. For LPDDR2/LPDDR3, this field will complete the initial sequence including tINIT3-tINIT5 & tZQC.";
            sw = rw; hw = r;
            reset = 0x0;
        } dram_init_en[10:10];
        field {
            name = "wdet_en";
            desc = "Write data eye training enable. Writing 1 to this field starts the write data eye training sequence. This field will be cleared after the write data eye training is complete.";
            sw = rw; hw = r;
            reset = 0x0;
        } wdet_en[9:9];
        field {
            name = "rdet_en";
            desc = "Read data eye training enable. Writing 1 to this field starts the read data eye training sequence. This field will be cleared after the read data eye training is complete.";
            sw = rw; hw = r;
            reset = 0x0;
        } rdet_en[8:8];
        field {
            name = "wl2_en";
            desc = "Second write leveling enable. Writing 1 to this field starts write latency adjustment. This field will be cleared after adjustment is complete. Note that write leveling adjustment applies only to DDR3.";
            sw = rw; hw = r;
            reset = 0x0;
        } wl2_en[7:7];
        field {
            name = "gdst_en";
            desc = "PHY read data latch train enable. Writing 1 to this field starts the read data latch position training. This field will be cleared after write leveling is complete.";
            sw = rw; hw = r;
            reset = 0x0;
        } gdst_en[6:6];
        field {
            name = "gt_en";
            desc = "Gate training enable. Writing 1 to this field starts the gate training sequence. This field will be cleared after the gate training is complete.";
            sw = rw; hw = r;
            reset = 0x0;
        } gt_en[5:5];
        field {
            name = "wl_en";
            desc = "Write leveling enable. Writing 1 to this field starts the write leveling sequence. This field will be cleared after write leveling is complete. Note that write leveling applies only to DDR3.";
            sw = rw; hw = r;
            reset = 0x0;
        } wl_en[4:4];
        field {
            name = "zcal_en";
            desc = "Impedance calibration enable. This field is used to specify whether impedance calibration is executed. This bit will be cleared after impedance calibration is complete.";
            sw = rw; hw = r;
            reset = 0x1;
        } zcal_en[3:3];
        field {
            name = "dlymeas_en";
            desc = "Delay measurement enable. This field is used to enable initial delay measurement of the activated read delay line. If it is set to 1, delay measurement is enabled.";
            sw = rw; hw = r;
            reset = 0x1;
        } dlymeas_en[2:2];
        field {
            name = "pll_init_en";
            desc = "PLL initialization enable. If this field is used to activate the PLL initialization. If it is set to 1, the PLL is reset and waiting for a period of time for PLL to be locked.";
            sw = rw; hw = r;
            reset = 0x1;
        } pll_init_en[1:1];
        field {
            name = "init_en";
            desc = "PHY initialization enable. Writing 1 to this field triggers the PHY initialization sequence. The exact initialization executed is specified in bits 1-15 of this register. If PHY initialization is complete, this bit will be cleared. Note that writing 0 to this field has no effect.";
            sw = rw; hw = r;
            reset = 0x0;
        } init_en[0:0];
    } PHYINITCTRL @ 0x4;
    reg {
        name = "PHYINITSTATUS";
        desc = "PHYINITSTATUS is a PHY status register. (offset 0x8; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 857).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_11[31:11];
        field {
            name = "cat_err";
            desc = "CA training error. This field indicates whether an error occurs during CA training. Writing 1 to this field clears the error status.

Access type RWC in the data sheet: written 1 clears the bit.";
            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } cat_err[10:10];
        field {
            name = "wdet_err";
            desc = "Write data eye calibration error. This field indicates whether an error occurs during write data eye calibration. Writing 1 to this field clears the error status.

Access type RWC in the data sheet: written 1 clears the bit.";
            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } wdet_err[9:9];
        field {
            name = "rdet_err";
            desc = "Read data eye calibration error. This field indicates whether an error occurs during read data eye calibration. Writing 1 to this field clears the error status.

Access type RWC in the data sheet: written 1 clears the bit.";
            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } rdet_err[8:8];
        field {
            name = "wl2_err";
            desc = "Write leveling adjustment error. This field indicates whether an error occurs during write leveling adjustment. Writing 1 to this field clears the error status.

Access type RWC in the data sheet: written 1 clears the bit.";
            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } wl2_err[7:7];
        field {
            name = "gdst_err";
            desc = "PHY read data latch train error. This field indicates whether an error occurs during read data latch training. Writing 1 to this field clears the error status.

Access type RWC in the data sheet: written 1 clears the bit.";
            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } gdst_err[6:6];
        field {
            name = "gt_err";
            desc = "Gate training error. This field indicates whether an error occurs during gate training. Writing 1 to this field clears the error status.

Access type RWC in the data sheet: written 1 clears the bit.";
            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } gt_err[5:5];
        field {
            name = "wl_err";
            desc = "Write leveling error. This field indicates whether an error occurs during write leveling. Writing 1 to this field clears the error status.

Access type RWC in the data sheet: written 1 clears the bit.";
            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } wl_err[4:4];
        field {
            name = "zcal_err";
            desc = "Impedance calibration error. This field indicates whether an error occurs during impedance calibration. Writing 1 to this field clears the error status.

Access type RWC in the data sheet: written 1 clears the bit.";
            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } zcal_err[3:3];
        field {
            name = "dlymeas_err";
            desc = "Delay measurement fail. This field indicates whether one of the initial delay measurements fails. Writing 1 to this field clears the error status.

Access type RWC in the data sheet: written 1 clears the bit.";
            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } dlymeas_err[2:2];
        field {
            name = "pll_lock_err";
            desc = "PLL locked fail. This field indicates whether one of the PLLs within the PHY fails to assert locked flag after t_pll_lock timer. Writing 1 to this field clears the error status.

Access type RWC in the data sheet: written 1 clears the bit.";
            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } pll_lock_err[1:1];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_0_0[0:0];
    } PHYINITSTATUS @ 0x8;
    reg {
        name = "PHYCLKGATED";
        desc = "PHYCLKGATED is a PHY clock gating control register. (offset 0xC; total reset 0x00000400; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 859).";
        field {
            name = "byp_pll_lock";
            desc = "PLL lock bypass. The user can assert this field to bypass the PLL lock signal when re-locking the PLL in the bypass mode (DFS) or when the PLL lock signal cannot be used.
- 0: use the PLL lock to gate the PHY clocks to prevent clock glitch
- 1: bypass the PLL lock (do not use the PLL lock signal to gate the

PHY clocks)";
            sw = rw; hw = r;
            reset = 0x0;
        } byp_pll_lock[31:31];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_30_13[30:13];
        field {
            name = "dx_phgated_men";
            desc = "PHY phase clock gated manual control enable. This field takes effect only when dx_phgated_en is 1'b0. If dx_phgated_en is high and this field is high, the user can use dx_phclkgated to manually control the clock gating of the PHY phase clock.
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } dx_phgated_men[12:12];
        field {
            name = "dx_phclkgated";
            desc = "PHY phase clock gated control. This field takes effect only when dx_phgated_en is 1'b0. If dx_phgated_en is '1b1, this field is used, and the gated function is automatically controlled by PACK FSM.
- 0: The clock is disabled.
- 1: The clock is enabled.";
            sw = rw; hw = r;
            reset = 0x0;
        } dx_phclkgated[11:11];
        field {
            name = "dx_phgated_en";
            desc = "PHY phase clock gated function (automatically controlled by PACK FSM) enable.
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x1;
        } dx_phgated_en[10:10];
        field {
            name = "ck_phy_clkgated";
            desc = "Dedicated clock gated control for the output CK and related circuits.
- 0: The clock is gated.
- 1: The clock is enabled.

This field is automatically set to 1 when the PLL is locked without error.";
            sw = rw; hw = r;
            reset = 0x0;
        } ck_phy_clkgated[9:9];
        field {
            name = "ac_phy_clkgated";
            desc = "Clock gated for the circuits in AC block except CK and CK related circuits.
- 0: The clock is gated.
- 1: The clock is enabled.

This field is automatically set to 1 when the PLL is locked without error.";
            sw = rw; hw = r;
            reset = 0x0;
        } ac_phy_clkgated[8:8];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_4[7:4];
        field {
            name = "dx_phy_clkgated";
            desc = "Clock gated for circuits in data blocks.
- 0: The clock is gated.
- 1: The clock is enabled.

This field is automatically set to 1 when the PLL is locked without error.";
            sw = rw; hw = r;
            reset = 0x0;
        } dx_phy_clkgated[3:0];
    } PHYCLKGATED @ 0xC;
    reg {
        name = "PHYTIMER0";
        desc = "PHYTIMER0 is a PHY timing parameter register. The timing parameters are required by the PHY. (offset 0x10; total reset 0x2710000F; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 860).";
        field {
            name = "t_dram_cke_high";
            desc = "DRAM CKE high initialization. This field specifies the number of PCLK clock cycles of the first DRAM command from CKE pulled to high (LPDDR2/LPDDR3 tINIT3).";
            sw = rw; hw = r;
            reset = 0x27100;
        } t_dram_cke_high[31:12];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_11_8[11:8];
        field {
            name = "t_dram_reset";
            desc = "DDR3 DRAM reset. This field is used to specify the time issuing reset signaling to the DRAM (number of PCLK clock cycles).";
            sw = rw; hw = r;
            reset = 0xf;
        } t_dram_reset[7:0];
    } PHYTIMER0 @ 0x10;
    reg {
        name = "PHYTIMER1";
        desc = "PHYTIMER1 is a DRAM CKE low initialization register. (offset 0x14; total reset 0x00002000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 861).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_16[31:16];
        field {
            name = "t_dram_cke_low";
            desc = "DRAM CKE low initialization. This field specifies the number of PCLK clock cycles during which CKE should be kept low after power is reset and the clock is stable.";
            sw = rw; hw = r;
            reset = 0x2000;
        } t_dram_cke_low[15:0];
    } PHYTIMER1 @ 0x14;
    reg {
        name = "PLLCTRL";
        desc = "PLLCTRL is a timing parameter register for the PLL in both address/command and data block. (offset 0x18; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 861).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_6[31:6];
        field {
            name = "pll_freq_range";
            desc = "PLL frequency range select. This field specifies the frequency input range of the PLLs.";
            sw = rw; hw = r;
            reset = 0x0;
        } pll_freq_range[5:4];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_3_3[3:3];
        field {
            name = "pll_pwdn";
            desc = "PLL power down. This field is used to set the power-down status of the PLL input. If this field is set to 1, the PLL power-down pin is activated. Writing 0 to this field will remove the deactivated PLL power down pin. Bit[2] for AC PLL Bit[1] for DX1 (DATA1) PLL Bit[0] for DX0 (DATA0) PLL";
            sw = rw; hw = r;
            reset = 0x0;
        } pll_pwdn[2:0];
    } PLLCTRL @ 0x18;
    reg {
        name = "PLLTIMER";
        desc = "PLLTIMER is a PLL address/command and data block control register. (offset 0x1C; total reset 0x4E200080; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 862).";
        field {
            name = "t_pll_lock";
            desc = "PLL lock time. This field specifies the number of PCLK clock cycles waiting for the PLL to be locked.";
            sw = rw; hw = r;
            reset = 0x4e20;
        } t_pll_lock[31:16];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_15_8[15:8];
        field {
            name = "t_pll_rst";
            desc = "PLL reset time. This field specifies the number of PCLK clock cycles to issue reset to the PLL.";
            sw = rw; hw = r;
            reset = 0x80;
        } t_pll_rst[7:0];
    } PLLTIMER @ 0x1C;
    reg {
        name = "DLYMEASCTRL";
        desc = "DLYMEASCTRL is a read delay line delay measurement control register. (offset 0x20; total reset 0x00000471; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 862).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_15[31:15];
        field {
            name = "dly_track_limit";
            desc = "Delay tracking limit. This field specifies the maximum number of accumulated taps allowed while dynamic tracking.";
            sw = rw; hw = r;
            reset = 0x4;
        } dly_track_limit[14:8];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_7[7:7];
        field {
            name = "phy_autoref_en";
            desc = "PHY auto-refresh tracking enable.";
            sw = rw; hw = r;
            reset = 0x1;
        } phy_autoref_en[6:6];
        field {
            name = "dynamic_dqsen";
            desc = "Dynamic DQS tracking enable. This field should be set to high during delay measurement.";
            sw = rw; hw = r;
            reset = 0x1;
        } dynamic_dqsen[5:5];
        field {
            name = "dynamic_dqsgen";
            desc = "Dynamic DQSG tracking enable.";
            sw = rw; hw = r;
            reset = 0x1;
        } dynamic_dqsgen[4:4];
        field {
            name = "dynamic_dqsgth";
            desc = "Dynamic DQSG update threshold. This field specifies the number of taps accumulated before the RDQSG delay line is updated.
- 0: update every 4 times
- 1: update every 2 times 2 or 3: update each time";
            sw = rw; hw = r;
            reset = 0x0;
        } dynamic_dqsgth[3:2];
        field {
            name = "dly_track_type";
            desc = "Delay tracking type. This field specifies whether priority updated from the PHY is used during dynamic tracking. If this field is set to 1, the priority updated from the PHY is used.";
            sw = rw; hw = r;
            reset = 0x0;
        } dly_track_type[1:1];
        field {
            name = "dly_meas_type";
            desc = "Delay measurement type. This field specifies whether the delay measurement is for one clock cycle or half a clock cycle. If this field is set to 1, a full clock cycle is measured.";
            sw = rw; hw = r;
            reset = 0x1;
        } dly_meas_type[0:0];
    } DLYMEASCTRL @ 0x20;
    reg {
        name = "IMPCTRL";
        desc = "IMPCTRL is a ZQ calibration control register. (offset 0x24; total reset 0x80008020; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 863).";
        field {
            name = "zcfuzzy_en";
            desc = "ZQ comparator result selection by weighted method. When this function is disabled, the precision is improved but ZQ comparison may fail. When this function is enabled, ZQ comparison is successful.
- 0: disabled
- 1: enabled (default)";
            sw = rw; hw = r;
            reset = 0x1;
        } zcfuzzy_en[31:31];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_30_16[30:16];
        field {
            name = "zcomp_num";
            desc = "ZQ comparator iteration time. This field specifies the iteration time of zcomp changing detection.";
            sw = rw; hw = r;
            reset = 0x8;
        } zcomp_num[15:12];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_11_6[11:6];
        field {
            name = "zcomp_rsp_dly";
            desc = "ZQ comparator response time. This field specifies the delay of the zcomp result after zctrl is used.";
            sw = rw; hw = r;
            reset = 0x20;
        } zcomp_rsp_dly[5:0];
    } IMPCTRL @ 0x24;
    reg {
        name = "IMPSTATUS";
        desc = "IMPSTATUS is a ZQ calibration status register. (offset 0x28; total reset 0x00200020; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 864).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_31[31:31];
        field {
            name = "zcode_pdrv_cal";
            desc = "P-drive impedance calibration code. This field shows the p-drive calibration code during impedance calibration.";
            sw = r; hw = w;
            reset = 0x0;
        } zcode_pdrv_cal[30:24];
        field {
            name = "pdrv_cal_result";
            desc = "P-drive calibration result. This field specifies the ZQ calibration result. The valid values are as follows:
- 0: calibration done with OK.
- 1: calibration done with error.

Writing 1 to this field clears this field.";
            sw = r; hw = w;
            reset = 0x0;
        } pdrv_cal_result[23:23];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_22_22[22:22];
        field {
            name = "zcode_pdrv";
            desc = "P-drive impedance control code. This field is used to specify the p-drive impedance control code. This register is updated by the user or is updated each time the ZQ calibration is complete.";
            sw = rw; hw = r;
            reset = 0x20;
        } zcode_pdrv[21:16];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_15_15[15:15];
        field {
            name = "zcode_ndrv_cal";
            desc = "N-drive impedance calibration code. This field shows the n-driver calibration code during impedance calibration.";
            sw = r; hw = w;
            reset = 0x0;
        } zcode_ndrv_cal[14:8];
        field {
            name = "ndrv_cal_result";
            desc = "N-drive calibration result. This field specifies the ZQ calibration result. The valid values are as follows:
- 0: calibration done with OK.
- 1: calibration done with error

Writing 1 to this field clears this field.";
            sw = r; hw = w;
            reset = 0x0;
        } ndrv_cal_result[7:7];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_6_6[6:6];
        field {
            name = "zcode_ndrv";
            desc = "N-drive impedance control code. This field is used to specify the n-drive impedance control code. This register is updated by the user or is updated each time the ZQ calibration is complete.";
            sw = rw; hw = r;
            reset = 0x20;
        } zcode_ndrv[5:0];
    } IMPSTATUS @ 0x28;
    reg {
        name = "DRAMCFG";
        desc = "DRAMCFG is a DRAM system configuration register. (offset 0x2C; total reset 0x00000405; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 865).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_11[31:11];
        field {
            name = "lpddr23_zqc_en";
            desc = "LPDDR2/LPDDR3 initialization ZQC (init) enable.
- 0: disabled
- 1: issue ZQC(init) commands during initialization sequence rank by rank (default).";
            sw = rw; hw = r;
            reset = 0x1;
        } lpddr23_zqc_en[10:10];
        field {
            name = "lpddr23_mrw1617_en";
            desc = "LPDDR2/LPDDR3 initialization MRW16/17 enable.
- 0: disabled (default)
- 1: issue MRW16 then MRW17 commands during initialization sequence";
            sw = rw; hw = r;
            reset = 0x0;
        } lpddr23_mrw1617_en[9:9];
        field {
            name = "lpddr23_pre_en";
            desc = "LPDDR2/LPDDR3 initialization precharge all enable.
- 0: disabled (default)
- 1: issue the precharge all command before the reset command during initialization sequence";
            sw = rw; hw = r;
            reset = 0x0;
        } lpddr23_pre_en[8:8];
        field {
            name = "reserved";
            desc = "Address mirroring. This bit should be set to 0 in single rank configuration";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_7[7:7];
        field {
            name = "maddr_mir";
            desc = "Address mirroring. This bit should be set to 0 in single rank configuration";
            sw = rw; hw = r;
            reset = 0x0;
        } maddr_mir[6:6];
        field {
            name = "ma2t";
            desc = "Two cycles on address/command. This field specifies whether the 2T timing should be used by the PHY controller that internally generates the DRAM command.";
            sw = rw; hw = r;
            reset = 0x0;
        } ma2t[5:5];
        field {
            name = "nosra";
            desc = "No simultaneous rank access. This field specifies whether simultaneously rank access in the same clock cycle is allowed. If it set to 1, the rank access will be taken in turn. Note that this field can be enabled only when the number of ranks is 2 or 4. This field should be set to 0 in single rank configuration";
            sw = rw; hw = r;
            reset = 0x0;
        } nosra[4:4];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_3_3[3:3];
        field {
            name = "dcfg_type";
            desc = "DRAM type selection. This field specifies the DDR RAM type. The valid values are as follows:
- 010: DDR3
- 101: LPDDR2/LPDDR3

Other values: reserved";
            sw = rw; hw = r;
            reset = 0x5;
        } dcfg_type[2:0];
    } DRAMCFG @ 0x2C;
    reg {
        name = "DRAMTIMER0";
        desc = "DRAMTIMER0 is a DRAM timing parameter register. The command delay specified in this register applies only to the command issued by the PHY controller internally. (offset 0x30; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 866).";
        field {
            name = "t_rc";
            desc = "Activated to activated on same bank command delay.";
            sw = rw; hw = r;
            reset = 0x0;
        } t_rc[31:26];
        field {
            name = "t_rrd";
            desc = "Activated to activated on different bank command delay.";
            sw = rw; hw = r;
            reset = 0x0;
        } t_rrd[25:22];
        field {
            name = "t_ras";
            desc = "Activated to precharge command delay.";
            sw = rw; hw = r;
            reset = 0x0;
        } t_ras[21:16];
        field {
            name = "t_rcd";
            desc = "Activated to read/write delay.";
            sw = rw; hw = r;
            reset = 0x0;
        } t_rcd[15:12];
        field {
            name = "t_rp";
            desc = "Precharge command period. The unit is two clock cycles.";
            sw = rw; hw = r;
            reset = 0x0;
        } t_rp[11:8];
        field {
            name = "t_wtr";
            desc = "Write to read command delay.";
            sw = rw; hw = r;
            reset = 0x0;
        } t_wtr[7:4];
        field {
            name = "t_rtp";
            desc = "Read to precharge command delay.";
            sw = rw; hw = r;
            reset = 0x0;
        } t_rtp[3:0];
    } DRAMTIMER0 @ 0x30;
    reg {
        name = "DRAMTIMER1";
        desc = "DRAMTIMER1 (offset 0x34; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 867).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_30[31:30];
        field {
            name = "t_rtw";
            desc = "Read to write command delay. This field specifies whether to insert extra cycles between read and write commands to compensate tdqsck. This value should be 3 for the common condition when DDR3 is used. This value should be 6 for the common condition when LPDDR2/LPDDR3 is used.";
            sw = rw; hw = r;
            reset = 0x0;
        } t_rtw[29:25];
        field {
            name = "t_rfc";
            desc = "Refresh to refresh command delay.";
            sw = rw; hw = r;
            reset = 0x0;
        } t_rfc[24:16];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_15_15[15:15];
        field {
            name = "t_faw";
            desc = "Four-bank activated period. This field applies only to the 8-bank device.";
            sw = rw; hw = r;
            reset = 0x0;
        } t_faw[14:9];
        field {
            name = "t_mod";
            desc = "Load mode register to non load mode register command delay. This field is used as max (t_mod, t_mrd) in DDR3, max (t_mrw, tmrd) in LPDDR3, and t_mrw in LPDDR2.";
            sw = rw; hw = r;
            reset = 0x0;
        } t_mod[8:4];
        field {
            name = "t_mrd";
            desc = "Load mode register to load mode register command delay. Not used.";
            sw = rw; hw = r;
            reset = 0x0;
        } t_mrd[3:0];
    } DRAMTIMER1 @ 0x34;
    reg {
        name = "DRAMTIMER2";
        desc = "DRAMTIMER2 (offset 0x38; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 868).";
        field {
            name = "t_ccd";
            desc = "Read to read and write to write command delay.
- 0 = BL/2 (for DDR3, this value should be 4)
- 1 = BL/2 + 1 (for DDR3, this value should be 5)";
            sw = rw; hw = r;
            reset = 0x0;
        } t_ccd[31:31];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_30_30[30:30];
        field {
            name = "t_dllk";
            desc = "DLL lock time.";
            sw = rw; hw = r;
            reset = 0x0;
        } t_dllk[29:20];
        field {
            name = "t_cke";
            desc = "CKE minimum pulse width.";
            sw = rw; hw = r;
            reset = 0x0;
        } t_cke[19:16];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_15_15[15:15];
        field {
            name = "t_xp";
            desc = "Power down exit delay.";
            sw = rw; hw = r;
            reset = 0x0;
        } t_xp[14:10];
        field {
            name = "t_xs";
            desc = "Self refresh exit delay.";
            sw = rw; hw = r;
            reset = 0x0;
        } t_xs[9:0];
    } DRAMTIMER2 @ 0x38;
    reg {
        name = "DRAMTIMER3";
        desc = "DRAMTIMER3 (offset 0x3C; total reset 0x00100200; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 868).";
        field {
            name = "t_wr";
            desc = "Write recovery cycle.";
            sw = rw; hw = r;
            reset = 0x0;
        } t_wr[31:28];
        field {
            name = "t_wl";
            desc = "Write latency (AL + CWL).";
            sw = rw; hw = r;
            reset = 0x0;
        } t_wl[27:24];
        field {
            name = "t_init5";
            desc = "LPDDR device initialization time. This field specifies the time during which the LPDDR sets the DAI bit to 1.";
            sw = rw; hw = r;
            reset = 0x400;
        } t_init5[23:10];
        field {
            name = "t_zcal";
            desc = "ZQ calibration to command delay. This field specifies the number of clock cycles to wait after initial ZQ calibration. For DDR3 ZQ normal operation full calibration, this value is divided by 2. For DDR3 ZQ initialization calibration, this value is divided by 4. For LPDDR2/3, this field specifies the value of tZQINIT during initialization.";
            sw = rw; hw = r;
            reset = 0x200;
        } t_zcal[9:0];
    } DRAMTIMER3 @ 0x3C;
    reg {
        name = "DRAMTIMER4";
        desc = "DRAMTIMER4 is a DRAM write leveling timing parameter register. This register applies only to the DDR3/LPDDR3 SDRAM. (offset 0x40; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 869).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_28[31:28];
        field {
            name = "t_odton";
            desc = "ODT turn-on latency (number of cycles from write command to assert of ODT).";
            sw = rw; hw = r;
            reset = 0x0;
        } t_odton[27:24];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_23_16[23:16];
        field {
            name = "t_odt";
            desc = "ODT turn-on cycles.";
            sw = rw; hw = r;
            reset = 0x0;
        } t_odt[15:12];
        field {
            name = "t_wlo";
            desc = "Write leveling output delay. This field specifies the write leveling output delay in cycles (dficlk cycle).";
            sw = rw; hw = r;
            reset = 0x0;
        } t_wlo[11:7];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_6_6[6:6];
        field {
            name = "t_wlmrd";
            desc = "Write leveling mode programmed (load mode register) to first DQS/DQS# rising edge delay (dficlk cycle).";
            sw = rw; hw = r;
            reset = 0x0;
        } t_wlmrd[5:0];
    } DRAMTIMER4 @ 0x40;
    reg {
        name = "ODTCR";
        desc = "ODTCR is a rank ODT control register while reading or writing to particular ranks. (offset 0x44; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 870).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_16[31:16];
        field {
            name = "wodt_rank3";
            desc = "Write rank 3 ODT control. This field specifies the ODT issued while write on rank 3. The valid bit width is the number of ranks.";
            sw = rw; hw = r;
            reset = 0x0;
        } wodt_rank3[15:12];
        field {
            name = "wodt_rank2";
            desc = "Write rank 2 ODT control. This field specifies the ODT issued while write on rank 2. The valid bit width is the number of ranks.";
            sw = rw; hw = r;
            reset = 0x0;
        } wodt_rank2[11:8];
        field {
            name = "wodt_rank1";
            desc = "Write rank 1 ODT control. This field specifies the ODT issued while write on rank 1. The valid bit width is the number of ranks.";
            sw = rw; hw = r;
            reset = 0x0;
        } wodt_rank1[7:4];
        field {
            name = "wodt_rank0";
            desc = "Write rank 0 ODT control. This field specifies the ODT issued while write on rank 0. The valid bit width is the number of ranks.";
            sw = rw; hw = r;
            reset = 0x0;
        } wodt_rank0[3:0];
    } ODTCR @ 0x44;
    reg {
        name = "TRAINCTRL0";
        desc = "TRAINCTRL0 is a training control register. (offset 0x48; total reset 0xD0441080; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 871).";
        field {
            name = "skip_eye_opening";
            desc = "Skip eye opening of data eye training. This field specifies whether the eye opening should be skipped. If this field is set to 1, the eye opening before data eye training is skipped. If this field is set to 0, the eye opening is executed before data eye training.";
            sw = rw; hw = r;
            reset = 0x1;
        } skip_eye_opening[31:31];
        field {
            name = "dtrerrstop";
            desc = "Data training error stop. This field controls whether the data training is terminated if an error occurs. The data training is stopped if this bit is set to 1. If this bit set to 0, the training will continue even an error occurs. The error status is recorded no matter when this field is set to 0 or 1.";
            sw = rw; hw = r;
            reset = 0x1;
        } dtrerrstop[30:30];
        field {
            name = "gtds_rspdly";
            desc = "Gate/Read latch training response delay. This field specifies the waiting time to check the response from PHY while gate and read latch training is performed (dficlk cycle).";
            sw = rw; hw = r;
            reset = 0x10;
        } gtds_rspdly[29:24];
        field {
            name = "dqsg_cstep";
            desc = "Gate training coarse tuning step (the unit is phase). The recommended values are 0x0-0x2. 2'd0: step = 1 2'd1: step = 2 (default) 2'd2: step = 3 2'd3: step = 4";
            sw = rw; hw = r;
            reset = 0x1;
        } dqsg_cstep[23:22];
        field {
            name = "dqsgrt_chk";
            desc = "Gate retraining check window. This field specifies the delta value to be checked during gate retraining check. The delta is added/subtracted to/from the read DQS gate. This position is checked to determine whether gating phase adjustment is required. The phase movement is the configured value multiple by 2. Note that 3'b000 is reserved and should not be used. The recommended values are 0x1-0x3.";
            sw = rw; hw = r;
            reset = 0x4;
        } dqsgrt_chk[21:16];
        field {
            name = "dqsgrt_shft";
            desc = "Gate retraining shift window. This field specifies the value to be shifted if gate phase adjustment is required after gate retraining checks. The phase movement is the configured value multiple by 2. Note that 3'b000 is reserved and should not be used. The recommended value is dqsgrt_chk.";
            sw = rw; hw = r;
            reset = 0x4;
        } dqsgrt_shft[15:10];
        field {
            name = "dqsgsl_mrgn";
            desc = "Read DQS gate margin. This field specifies the margin to be reserved after the DQS gate training. The number of phases specified in this field is decreased to create DQS gating margin. The valid values are as follows: 6'b00100: 1/4 cycle 6'b01000: 1/2 cycle (recommended) 6'b01100: 3/4 cycle 6'b10000: 1 cycle Other values: reserved";
            sw = rw; hw = r;
            reset = 0x8;
        } dqsgsl_mrgn[9:4];
        field {
            name = "dtr_rank";
            desc = "Training rank. This field specifies the rank used for training. After the training, this field is used to select the source of rank specific settings.";
            sw = rw; hw = r;
            reset = 0x0;
        } dtr_rank[3:0];
    } TRAINCTRL0 @ 0x48;
    reg {
        name = "RANKEN";
        desc = "RANKEN is a training rank control register. (offset 0x4C; total reset 0x00000003; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 872).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_16[31:16];
        field {
            name = "rank_en";
            desc = "Training rank enable. This field specifies whether the dtr_rank is enabled.
- 0: disabled
- 1: enabled (default)

Bit 0 indicates rank 0. Bit 1 indicates rank 1. ... Bit 15 indicates rank 15. The maximum number of ranks is specified by the system.";
            sw = rw; hw = r;
            reset = 0x3;
        } rank_en[15:0];
    } RANKEN @ 0x4C;
    reg {
        name = "TRAINMADDR";
        desc = "TRAINMADDR is a data training memory start address register. The minimum space required for the data training is 64 bytes, and the allocated memory must be 64-byte-aligned. (offset 0x50; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 873).";
        field {
            name = "dtrow";
            desc = "Data training row address. This field is used to configure the memory row address required for the data training.";
            sw = rw; hw = r;
            reset = 0x0;
        } dtrow[31:16];
        field {
            name = "dtcol";
            desc = "Data training column address. This field is used to configure the column address required for the data training. The field should be 0.";
            sw = rw; hw = r;
            reset = 0x0;
        } dtcol[15:4];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_3_3[3:3];
        field {
            name = "dtbank";
            desc = "Data training bank address. This field is used to configure the memory bank address required for the data training.";
            sw = rw; hw = r;
            reset = 0x0;
        } dtbank[2:0];
    } TRAINMADDR @ 0x50;
    reg {
        name = "BISTCTRL";
        desc = "BISTCTRL is a BIST behavior register. (offset 0x54; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 874).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_24[31:24];
        field {
            name = "bist_fail_stop";
            desc = "BIST stop error count. This field specifies the number of failures at which the BIST should be stopped. If this field is set to 0x00, the BIST will run infinite until the BIST operation is stopped or reset. If a non-zero value is specified, the BIST is stopped while the accumulated errors reach the count specified in this field.";
            sw = rw; hw = r;
            reset = 0x0;
        } bist_fail_stop[23:16];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_15_10[15:10];
        field {
            name = "bist_pat";
            desc = "BIST pattern generation. This field specifies the BIST pattern generated for test. Note that bist_pat can be changed only when bist_done is 1.
- 00: walking 0
- 01: walking 1
- 10: LFSR-based random generation
- 11: user programmed";
            sw = rw; hw = r;
            reset = 0x0;
        } bist_pat[9:8];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_7[7:7];
        field {
            name = "bist_mode";
            desc = "BIST mode select. This field specifies the BIST mode. The valid values are as follows:
- 000: pattern generated only
- 100: loopback before output buffer
- 101: loopback after output buffer
- 110: DRAM read/write mode

Other values: reserved Note that bist_mode can be changed only when bist_done is 1. When the data loopback mode is selected, swapwl_en/swap_en must be set to all zeros (no swap).";
            sw = rw; hw = r;
            reset = 0x0;
        } bist_mode[6:4];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_3_2[3:2];
        field {
            name = "bist_op";
            desc = "During Reg write, this field is used for selecting the BIST operation. The valid values are as follows:
- 00: BIST stop
- 01: BIST run
- 10: BIST reset
- 11: reserved

Writing the Reset clears all the status registers, and this field is cleared to BIST Stop. During Reg read, this field is for BIST active status (only bit 0 is valid, and bit1 is read as 1'b0).
- 0: BIST inactive
- 1: BIST active";
            sw = rw; hw = r;
            reset = 0x0;
        } bist_op[1:0];
    } BISTCTRL @ 0x54;
    reg {
        name = "BISTDATA0";
        desc = "BISTDATA0 is DRAM loopback test BIST data register 0. This register is valid only when bist_pat is set to \"User Defined.\" (offset 0x58; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 875).";
        field {
            name = "bist_data_b3";
            desc = "BIST data byte 3. This field is used as the fourth beat of burst during BIST test";
            sw = rw; hw = r;
            reset = 0x0;
        } bist_data_b3[31:24];
        field {
            name = "bist_data_b2";
            desc = "BIST data byte 2. This field is used as the third beat of burst during BIST test.";
            sw = rw; hw = r;
            reset = 0x0;
        } bist_data_b2[23:16];
        field {
            name = "bist_data_b1";
            desc = "BIST data byte 1. This field is used as the second beat of burst during BIST test.";
            sw = rw; hw = r;
            reset = 0x0;
        } bist_data_b1[15:8];
        field {
            name = "bist_data_b0";
            desc = "BIST data byte 0. This field is used as the first beat of burst during BIST test.";
            sw = rw; hw = r;
            reset = 0x0;
        } bist_data_b0[7:0];
    } BISTDATA0 @ 0x58;
    reg {
        name = "BISTDATA1";
        desc = "BISTDATA1 is DRAM loopback test BIST data register 1. (offset 0x5C; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 876).";
        field {
            name = "bist_data_b7";
            desc = "BIST data byte 7. This field is used as the eighth beat of burst during BIST test";
            sw = rw; hw = r;
            reset = 0x0;
        } bist_data_b7[31:24];
        field {
            name = "bist_data_b6";
            desc = "BIST data byte 6. This field is used as the sixth beat of burst during BIST test.";
            sw = rw; hw = r;
            reset = 0x0;
        } bist_data_b6[23:16];
        field {
            name = "bist_data_b5";
            desc = "BIST data byte 5. This field is used as the fifth beat of burst during BIST test.";
            sw = rw; hw = r;
            reset = 0x0;
        } bist_data_b5[15:8];
        field {
            name = "bist_data_b4";
            desc = "BIST data byte 4. This field is used as the fourth beat of burst during BIST test.";
            sw = rw; hw = r;
            reset = 0x0;
        } bist_data_b4[7:0];
    } BISTDATA1 @ 0x5C;
    reg {
        name = "BISTSTATUS";
        desc = "BISTSTATUS is a BIST test result and status register. (offset 0x60; total reset 0x00000001; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 876).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_3[31:3];
        field {
            name = "bist_dxerr";
            desc = "BIST error on DX blocks. This bit shows whether any error occurs on the DXn during BIST test.";
            sw = r; hw = w;
            reset = 0x0;
        } bist_dxerr[2:2];
        field {
            name = "bist_acerr";
            desc = "BIST error on AC block. This bit shows whether any error occurs on the AC during BIST test.";
            sw = r; hw = w;
            reset = 0x0;
        } bist_acerr[1:1];
        field {
            name = "bist_done";
            desc = "BIST done. This field shows whether the BIST is complete. Note that if the BIST Stop Error Count field (bist_fail_stop) is set to 0, this field is never asserted.";
            sw = r; hw = w;
            reset = 0x1;
        } bist_done[0:0];
    } BISTSTATUS @ 0x60;
    reg {
        name = "MODEREG01";
        desc = "MODEREG01 is mode register content register 1. (offset 0x64; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 877).";
        field {
            name = "mr1";
            desc = "Mode register 1. For DDR/DDR2/DDR3/LPDDR, this field specifies the content of extend mode register 1. For LPDDR2/LPDDR3, this field defines the content of MR3/MR9 (mode register). bit[31:24]: MR9 OP bit[23:16]: MR3 OP";
            sw = rw; hw = r;
            reset = 0x0;
        } mr1[31:16];
        field {
            name = "mr0";
            desc = "Mode register 0. For DDR/DDR2/DDR3/LPDDR, this field specifies the content of mode register 0. For LPDDR2/LPDDR3, this field defines the mode registers MR1/MR2. bit[15:8]: MR2 OP bit[7:0]: MR1 OP";
            sw = rw; hw = r;
            reset = 0x0;
        } mr0[15:0];
    } MODEREG01 @ 0x64;
    reg {
        name = "MODEREG23";
        desc = "MODEREG23 is mode register content register 2. (offset 0x68; total reset 0xFF0A0000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 878).";
        field {
            name = "mr3";
            desc = "Mode register 3. For DDR/DDR2/DDR3, this field specifies extend mode register 3. For LPDDR2/LPDDR3, this field is for the ZQ commands. bit[31:24]: OP bit[23:16]: MA The ZQ commands are issued rank by rank after tINIT5. bit[31:24]: MR10 OP bit[23:16]: MR10 MA";
            sw = rw; hw = r;
            reset = 0xff0a;
        } mr3[31:16];
        field {
            name = "mr2";
            desc = "Mode register 2. For DDR/DDR2/DDR3, this field specifies extend mode register 2. For LPDDR2/LPDDR3, this field specifies MR16/MR17. bit[15:8]: MR17 OP bit[7:0]: MR16 OP";
            sw = rw; hw = r;
            reset = 0x0;
        } mr2[15:0];
    } MODEREG23 @ 0x68;
    reg {
        name = "DETPATTERN";
        desc = "DETPATTERN is a write/read DET pattern register. These fields are used to fine-tune the training procedure. You are advised not to modify them. (offset 0x6C; total reset 0x00FFAA55; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 878).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_24[31:24];
        field {
            name = "det_patFF";
            desc = "DET pattern 2.";
            sw = rw; hw = r;
            reset = 0xff;
        } det_patFF[23:16];
        field {
            name = "det_patAA";
            desc = "DET pattern 1.";
            sw = rw; hw = r;
            reset = 0xaa;
        } det_patAA[15:8];
        field {
            name = "det_pat55";
            desc = "DET pattern 0.";
            sw = rw; hw = r;
            reset = 0x55;
        } det_pat55[7:0];
    } DETPATTERN @ 0x6C;
    reg {
        name = "MISC";
        desc = "MISC is a miscellaneous control register. (offset 0x70; total reset 0x00080000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 879).";
        field {
            name = "swapdfibyte_en";
            desc = "Swap DFI byte lane.
- 00: no swap
- 01: swap";
            sw = rw; hw = r;
            reset = 0x0;
        } swapdfibyte_en[31:30];
        field {
            name = "swapwl_en";
            desc = "Swap WL/CA result.
- 000: no swap
- 001: swap 1
- 010: swap 2
- 011: swap 3
- 100: swap 4

Note: When the data BIST loopback mode is selected, this field must be set to 0x0.";
            sw = rw; hw = r;
            reset = 0x0;
        } swapwl_en[29:27];
        field {
            name = "swapdm_en";
            desc = "Swap DM bus.
- 00: no swap
- 01: 16-bit T2 swap";
            sw = rw; hw = r;
            reset = 0x0;
        } swapdm_en[26:25];
        field {
            name = "swapaddr_en";
            desc = "Swap address bus.
- 00: no swap
- 01: 32-bit flyby-4, flyby-2 swap
- 10: 16-bit T-2 swap";
            sw = rw; hw = r;
            reset = 0x0;
        } swapaddr_en[24:23];
        field {
            name = "swap_en";
            desc = "Swap DQ bus bit[1:0].
- 000: no swap
- 001: swap 1
- 010: swap 2
- 011: swap 3
- 100: swap 4

When the data BIST loopback mode is selected, this field must be set to 0x0.";
            sw = rw; hw = r;
            reset = 0x0;
        } swap_en[22:21];
        field {
            name = "cfg_dlyupd";
            desc = "Transparent mode for the delay update module. When this bit is set to 1, the delay setting in registers are applied to the PHY immediately.";
            sw = rw; hw = r;
            reset = 0x0;
        } cfg_dlyupd[20:20];
        field {
            name = "addr_delay";
            desc = "Add 1-T delay on address/command. This bit must be set to 1 when CWL is 5.";
            sw = rw; hw = r;
            reset = 0x1;
        } addr_delay[19:19];
        field {
            name = "swap_en_msb";
            desc = "Swap DQ bus bit[2].
- 000: no swap
- 001: swap 1
- 010: swap 2
- 011: swap 3
- 100: swap 4

When the data BIST loopback mode is selected, this field must be set to 0x0.";
            sw = rw; hw = r;
            reset = 0x0;
        } swap_en_msb[18:18];
        field {
            name = "addr_toggle";
            desc = "Toggle address bus every clock cycle. This bit is set to 1 only for the burn-in test.";
            sw = rw; hw = r;
            reset = 0x0;
        } addr_toggle[17:17];
        field {
            name = "scramb_en";
            desc = "Data scrambler enable. Set this field to 1 to enable data scramble function";
            sw = rw; hw = r;
            reset = 0x0;
        } scramb_en[16:16];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_15_12[15:12];
        field {
            name = "cfg_rl";
            desc = "PHY read latency. It defines the number of cycles from read command to assert of rddata_en and is equal to CL + AL - 2 (for LPDDR2/3, the field should be RL-2).";
            sw = rw; hw = r;
            reset = 0x0;
        } cfg_rl[11:7];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_6_5[6:5];
        field {
            name = "cfg_wl";
            desc = "PHY write latency. It defines the number of cycles from write command to assert of wrdata_en and is equal to CWL + AL - 1 (for LPDDR2/3, the field should be WL + 1). If the DFI clock ratio is 1:2, cfg_wl must be greater than or equal to 2.";
            sw = rw; hw = r;
            reset = 0x0;
        } cfg_wl[4:0];
    } MISC @ 0x70;
    reg {
        name = "RNK2RNK";
        desc = "RNK2RNK is a rank-to-rank delay control register. (offset 0x74; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 881).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_20[31:20];
        field {
            name = "trnkwtr";
            desc = "Delay from write to read command targeted to different ranks.";
            sw = rw; hw = r;
            reset = 0x0;
        } trnkwtr[19:15];
        field {
            name = "trnkrtw";
            desc = "Delay from read to write command targeted to different ranks.";
            sw = rw; hw = r;
            reset = 0x0;
        } trnkrtw[14:10];
        field {
            name = "trnkrtr";
            desc = "Delay from read to read command targeted to different ranks.";
            sw = rw; hw = r;
            reset = 0x0;
        } trnkrtr[9:5];
        field {
            name = "trnkwtw";
            desc = "Delay from write to write command targeted to different ranks.";
            sw = rw; hw = r;
            reset = 0x0;
        } trnkwtw[4:0];
    } RNK2RNK @ 0x74;
    reg {
        name = "PHYCTRL0";
        desc = "PHYCTRL0 is PHY control register 0. Register in this field are connected to PHY interface directly (offset 0x78; total reset 0x00003980; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 881).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_14[31:14];
        field {
            name = "resetoen";
            desc = "Set this field to default value.";
            sw = rw; hw = r;
            reset = 0x1;
        } resetoen[13:13];
        field {
            name = "csoen";
            desc = "Set this field to default value.";
            sw = rw; hw = r;
            reset = 0x1;
        } csoen[12:12];
        field {
            name = "ckeoen";
            desc = "Set this field to default value.";
            sw = rw; hw = r;
            reset = 0x1;
        } ckeoen[11:11];
        field {
            name = "ckoen";
            desc = "Set this field to default value.";
            sw = rw; hw = r;
            reset = 0x1;
        } ckoen[10:8];
        field {
            name = "cmdoen";
            desc = "Set this field to default value.";
            sw = rw; hw = r;
            reset = 0x1;
        } cmdoen[7:7];
        field {
            name = "reserved";
            desc = "Set this field to default value.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_6_5[6:5];
        field {
            name = "lp_ck_sel";
            desc = "Set this field to default value.";
            sw = rw; hw = r;
            reset = 0x0;
        } lp_ck_sel[4:3];
        field {
            name = "sel_pos_rx";
            desc = "PHY output trigger edge select.
- 0: falling edge
- 1: rising edge";
            sw = rw; hw = r;
            reset = 0x0;
        } sel_pos_rx[2:2];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_1_0[1:0];
    } PHYCTRL0 @ 0x78;
    reg {
        name = "PHYDBG";
        desc = "PHYDBG is a PHY debug register. (offset 0x7C; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 882).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_24[31:24];
        field {
            name = "dqsb_gated_error";
            desc = "DQSN gated error flag. This error flag can be cleared only by issuing PHY reset.";
            sw = r; hw = w;
            reset = 0x0;
        } dqsb_gated_error[23:16];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_15_8[15:8];
        field {
            name = "dqs_gated_error";
            desc = "DQS gated error flag. This error flag can be cleared only by issuing PHY reset.";
            sw = r; hw = w;
            reset = 0x0;
        } dqs_gated_error[7:0];
    } PHYDBG @ 0x7C;
    reg {
        name = "RETCTRL0";
        desc = "RETCTRL0 is a retraining control register. (offset 0x80; total reset 0x00012400; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 883).";
        field {
            name = "retrain_thrd";
            desc = "Retraining threshold. The PHY counts the number of AREFs issued by MC. When the number reaches the threshold, the retraining operation is triggered to be started. Only a non-zero value is valid.";
            sw = rw; hw = r;
            reset = 0x1;
        } retrain_thrd[31:16];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_15_15[15:15];
        field {
            name = "gtrten";
            desc = "Gate retraining active. This field controls whether the gate retraining is executed during retraining on-going. This field should be asserted only after the initial gate training is complete.";
            sw = rw; hw = r;
            reset = 0x0;
        } gtrten[14:14];
        field {
            name = "retrain_en";
            desc = "PHY retraining enable. This field controls whether the PHY is enabled to request memory controller for retraining.";
            sw = rw; hw = r;
            reset = 0x1;
        } retrain_en[13:13];
        field {
            name = "phyupd_resp";
            desc = "PHY update response latency. When the PHY asserts dfi_phyupd_req to MC, MC should assert dfi_phyupd_ack no later than the number of cycles configured by the response latency.";
            sw = rw; hw = r;
            reset = 0x400;
        } phyupd_resp[12:0];
    } RETCTRL0 @ 0x80;
    reg {
        name = "DMSEL";
        desc = "DMSEL is a DM swap selection register. (offset 0x84; total reset 0x0000000A; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 883).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_4[31:4];
        field {
            name = "dxctl_dmswap_sel";
            desc = "bit[3:2]: DM1 swap select bit[1:0]: DM0 swap select";
            sw = rw; hw = r;
            reset = 0xa;
        } dxctl_dmswap_sel[3:0];
    } DMSEL @ 0x84;
    reg {
        name = "IOCTL";
        desc = "IOCTL is an I/O control register. (offset 0x88; total reset 0x4BFFF801; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 884).";
        field {
            name = "odtsel_dqs";
            desc = "Set this field to default value.";
            sw = rw; hw = r;
            reset = 0x2;
        } odtsel_dqs[31:29];
        field {
            name = "odtsel";
            desc = "Set this field to default value.";
            sw = rw; hw = r;
