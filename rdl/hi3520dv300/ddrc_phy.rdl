        field {
            name = "ronsel_ck";
            desc = "Set this field to default value.";
            sw = rw; hw = r;
            reset = 0x7;
        } ronsel_ck[25:23];
        field {
            name = "ronsel_ac2t";
            desc = "Set this field to default value.";
            sw = rw; hw = r;
