- 1: compared";
            sw = rw; hw = r;
            reset = 0x0;
        } odt_cmp_mask[3:0];
    } ACBISTCTRL1 @ 0x104;
    reg {
        name = "ACBISTSTS0";
        desc = "ACBISTSTS0 is BIST test result and status register 0. This register is read-only, and can only be reset by setting bist_op to BIST Reset. (offset 0x108; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 898).";
        field {
            name = "reserved";
