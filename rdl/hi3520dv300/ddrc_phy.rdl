            desc = "Differential DQS enable.";
            sw = rw; hw = r;
            reset = 0x1;
        } diff_dqs_en[0:0];
    } IOCTL @ 0x88;
    reg {
        name = "DQSSEL";
        desc = "DQSSEL is a PHY DQ swap register. (offset 0x8C; total reset 0xFF00FF00; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 885).";
        field {
            name = "dqswap_sel";
            desc = "DQ swap in PHY. Each bit determines the relative DQS with DQ.
- 0: relative to DQS0
- 1: relative to DQS1";
            sw = rw; hw = r;
            reset = 0xff00ff00;
        } dqswap_sel[31:0];
    } DQSSEL @ 0x8C;
    reg {
        name = "PHYCTRL1";
        desc = "PHYCTRL1 is an AC PHY control register. Register in this field are connected to PHY interface directly (offset 0x90; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 885).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_31[31:31];
        field {
            name = "ac_pll_cal";
