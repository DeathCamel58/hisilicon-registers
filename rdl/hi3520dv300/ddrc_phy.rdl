            sw = r; hw = w;
            reset = 0x0;
        } rst_bist_err[26:26];
        field {
            name = "cs_bist_err";
            desc = "BIST error on CS.";
            sw = r; hw = w;
            reset = 0x0;
        } cs_bist_err[25:22];
        field {
            name = "ras_bist_err";
            desc = "BIST error on RAS.";
            sw = r; hw = w;
            reset = 0x0;
        } ras_bist_err[21:21];
        field {
            name = "cas_bist_err";
            desc = "BIST error on CAS.";
            sw = r; hw = w;
            reset = 0x0;
        } cas_bist_err[20:20];
        field {
            name = "we_bist_err";
