        } ronsel_ac2t[22:20];
        field {
            name = "ronsel_ac1t";
            desc = "Set this field to default value.";
            sw = rw; hw = r;
            reset = 0x7;
        } ronsel_ac1t[19:17];
        field {
            name = "ronsel_dqs";
            desc = "Set this field to default value.";
            sw = rw; hw = r;
            reset = 0x7;
        } ronsel_dqs[16:14];
        field {
            name = "ronsel";
            desc = "Set this field to default value.";
            sw = rw; hw = r;
            reset = 0x7;
        } ronsel[13:11];
        field {
            name = "reserved";
            desc = "Set this field to default value.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_10_10[10:10];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_9_3[9:3];
        field {
            name = "aciopldn";
            desc = "Set this field to default value.";
            sw = rw; hw = r;
            reset = 0x0;
        } aciopldn[2:2];
        field {
            name = "dxiopldn";
            desc = "Set this field to default value.";
            sw = rw; hw = r;
            reset = 0x0;
        } dxiopldn[1:1];
        field {
