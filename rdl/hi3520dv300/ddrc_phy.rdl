            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_28[31:28];
        field {
            name = "ioctl_squeach_pd";
            desc = "Set this field to default value.";
            sw = rw; hw = r;
            reset = 0x0;
        } ioctl_squeach_pd[27:24];
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_23_18[23:18];
        field {
            name = "ioctl_genvref_pd";
            desc = "Set this field to default value.";
            sw = rw; hw = r;
            reset = 0x0;
        } ioctl_genvref_pd[17:12];
        field {
            name = "ioctl_genvref_ie";
            desc = "Set this field to default value.";
            sw = rw; hw = r;
            reset = 0x0;
        } ioctl_genvref_ie[11:6];
        field {
            name = "ioctl_popmode";
            desc = "Set this field to default value.";
            sw = rw; hw = r;
            reset = 0x0;
        } ioctl_popmode[5:0];
    } IOCTL1 @ 0xB0;
    reg {
        name = "IOCTL2";
        desc = "IOCTL2 is I/O PHY control register 2. Register in this field are connected to PHY interface directly (offset 0xB4; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.9.2, PDF page 891).";
        field {
            name = "reserved";
            desc = "Reserved.";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_30[31:30];
        field {
            name = "ioctl_genvref_refsel_2";
