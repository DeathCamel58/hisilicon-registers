`ifndef HI3520DV300_SATA_PORT_RDL
`define HI3520DV300_SATA_PORT_RDL
regfile eHI3520DV300_SATA_PORT {
    name = "SATA port configuration registers";
    desc = "SATA port configuration registers of the Hi3521A/Hi3520D V300 at base 0x1101_0100. 29 registers extracted programmatically from the Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10) (Table 13-13 Summary of the SATA port configuration registers (base address: 0x1101_0100)): register headings, offsets, total reset values, field bit ranges, access types, names, reset values and descriptions, with PDF page numbers in each register description. Field names, bit ranges, access types and offsets are exact; the free-text descriptions are taken from the cell text of the field table and were checked by sampling only. Hardware not verified.";
    reg SATA_PORT_CLB_t {
        name = "SATA_PORT_CLB";
        desc = "SATA_PORT_CLB is a command list base address register. (offset 0x0, 2 instances at stride 0x80; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 13.6.7.2, PDF page 1606).";
        field {
            name = "port_clb";
            desc = "Base address for storing the port command list in the memory Resetting the SATA controller through SATA_GHC_GHC[hab_rst] has no effect on this field.";
            sw = rw; hw = r;
            reset = 0x0;
        } port_clb[31:10];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_9_0[9:0];
    };
    SATA_PORT_CLB_t SATA_PORT_CLB_0 @ 0x0;
    SATA_PORT_CLB_t SATA_PORT_CLB_1 @ 0x80;
    reg SATA_PORT_FB_t {
        name = "SATA_PORT_FB";
        desc = "SATA_PORT_FB is an RX FIS base address register. (offset 0x8, 2 instances at stride 0x80; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 13.6.7.2, PDF page 1606).";
        field {
            name = "port_fb";
            desc = "Base address in the memory for storing the frames received through the port Resetting the SATA controller through SATA_GHC_GHC[hab_rst] has no effect on this field.";
            sw = rw; hw = r;
            reset = 0x0;
        } port_fb[31:8];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_0[7:0];
    };
    SATA_PORT_FB_t SATA_PORT_FB_0 @ 0x8;
    SATA_PORT_FB_t SATA_PORT_FB_1 @ 0x88;
    reg SATA_PORT_IS_t {
        name = "SATA_PORT_IS";
        desc = "SATA_PORT_IS is a port interrupt status register. (offset 0x10, 2 instances at stride 0x80; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 13.6.7.2, PDF page 1607).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_31[31:31];
        field {
            name = "pxis_tfes";
            desc = "Task file data (TFD) error interrupt status
- 0: The value of SATA_PORT_TFD bit[0] is not 1.
- 1: The value of SATA_PORT_TFD bit[0] is 1.

Access type WC in the data sheet: written 1 clears the bit.";
            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } pxis_tfes[30:30];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_29_29[29:29];
        field {
            name = "pxis_hbds";
            desc = "Internal bus error interrupt
- 0: The DMAC accesses the memory properly.
- 1: An error occurs when the DMAC accesses the memory.

Access type WC in the data sheet: written 1 clears the bit.";
            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } pxis_hbds[28:28];
        field {
            name = "pxis_ifs";
            desc = "Fatal error interrupt status
- 0: No error occurs during the data frame transfer.
- 1: An error occurs during the data frame transfer.

Access type WC in the data sheet: written 1 clears the bit.";
            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } pxis_ifs[27:27];
        field {
            name = "pxis_infs";
            desc = "Non-fatal error interrupt status
- 0: No error occurs during the non-data frame transfer.
- 1: An error occurs during the non-data frame transfer.

Access type WC in the data sheet: written 1 clears the bit.";
            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } pxis_infs[26:26];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_25_25[25:25];
        field {
            name = "pxis_ofs";
            desc = "Data transfer overflow interrupt status
- 0: No overflow is detected.
- 1: During the data frame transfer, if the size of the data memory occupied by commands is smaller than the actual data amount, an interrupt is reported at the end of the data transfer.

Access type WC in the data sheet: written 1 clears the bit.";
            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } pxis_ofs[24:24];
        field {
            name = "pxis_ipms";
            desc = "PM port number error interrupt status
- 0: No PM port number error is detected during data reception.
- 1: A PM port number error is detected during data reception.

Access type WC in the data sheet: written 1 clears the bit.";
            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } pxis_ipms[23:23];
        field {
            name = "pxis_prcs";
            desc = "PHY status change interrupt status
- 0: No changes of the phyrdy signal are detected.
- 1: Changes of the phyrdy signal are detected.

This bit directly reflects the value of SATA_PORT_SERR[diag_n].";
            sw = r; hw = w;
            reset = 0x0;
        } pxis_prcs[22:22];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_21_7[21:7];
        field {
            name = "pxis_pcs";
            desc = "Port connection change interrupt status
- 0: No COMINIT signal transmitted from the device is detected.
- 1: A COMINIT signal transmitted from the device is detected.

This bit directly reflects the value of SATA_PORT_SERR[diag.x].";
            sw = r; hw = w;
            reset = 0x0;
        } pxis_pcs[6:6];
        field {
            name = "pxis_dps";
            desc = "Linked list transfer completion interrupt status
- 0: The transfer of the linked list data is complete when no I bit in the PRD is 1.
- 1: The transfer of the linked list data is complete when an I bit in the PRD is 1.

Access type WC in the data sheet: written 1 clears the bit.";
            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } pxis_dps[5:5];
        field {
            name = "pxis_ufs";
            desc = "Unknown FIS interrupt status
- 0: No unknown FIS is received.
- 1: An unknown FIS is received.";
            sw = r; hw = w;
            reset = 0x0;
        } pxis_ufs[4:4];
        field {
            name = "pxis_sdbs";
            desc = "Set device bits FIS interrupt status
- 0: no effect
- 1: A set device bits FIS is received and the I bit is 1.

Access type WC in the data sheet: written 1 clears the bit.";
            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } pxis_sdbs[3:3];
        field {
            name = "pxis_dss";
            desc = "DMA setup FIS interrupt status
- 0: no effect
- 1: A DMA setup FIS is received and the I bit is 1.

Access type WC in the data sheet: written 1 clears the bit.";
            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } pxis_dss[2:2];
        field {
            name = "pxis_pss";
            desc = "PIO setup FIS interrupt status
- 0: no effect
- 1: A PIO setup FIS is received and the I bit is 1.

Access type WC in the data sheet: written 1 clears the bit.";
            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } pxis_pss[1:1];
        field {
            name = "pxis_dhrs";
            desc = "D2H register FIS interrupt status
- 0: no effect
- 1: A D2H register FIS is received and the I bit is 1.

Access type WC in the data sheet: written 1 clears the bit.";
            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } pxis_dhrs[0:0];
    };
    SATA_PORT_IS_t SATA_PORT_IS_0 @ 0x10;
    SATA_PORT_IS_t SATA_PORT_IS_1 @ 0x90;
    reg SATA_PORT_IE_t {
        name = "SATA_PORT_IE";
        desc = "SATA_PORT_IE is a port interrupt mask register. (offset 0x14, 2 instances at stride 0x80; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 13.6.7.2, PDF page 1609).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_31[31:31];
        field {
            name = "pxie_tfee";
            desc = "TFD error interrupt mask
- 0: masked
- 1: not masked";
            sw = rw; hw = r;
            reset = 0x0;
        } pxie_tfee[30:30];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_29_29[29:29];
        field {
            name = "pxie_hbde";
            desc = "Internal bus error interrupt mask
- 0: masked
- 1: not masked";
            sw = rw; hw = r;
            reset = 0x0;
        } pxie_hbde[28:28];
        field {
            name = "pxie_ife";
            desc = "Fatal error interrupt mask
- 0: masked
- 1: not masked";
            sw = rw; hw = r;
            reset = 0x0;
        } pxie_ife[27:27];
        field {
            name = "pxie_infe";
            desc = "Non-fatal error interrupt mask
- 0: masked
- 1: not masked";
            sw = rw; hw = r;
            reset = 0x0;
        } pxie_infe[26:26];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_25_25[25:25];
        field {
            name = "pxie_ofe";
            desc = "Data transfer overflow interrupt mask
- 0: masked
- 1: not masked";
            sw = rw; hw = r;
            reset = 0x0;
        } pxie_ofe[24:24];
        field {
            name = "pxie_ipme";
            desc = "PM port error interrupt mask
- 0: masked
- 1: not masked";
            sw = rw; hw = r;
            reset = 0x0;
        } pxie_ipme[23:23];
        field {
            name = "pxie_prce";
            desc = "PHY status change interrupt mask
- 0: masked
- 1: not masked";
            sw = rw; hw = r;
            reset = 0x0;
        } pxie_prce[22:22];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_21_7[21:7];
        field {
            name = "pxie_pce";
            desc = "Port connection change interrupt mask
- 0: masked
- 1: not masked";
            sw = rw; hw = r;
            reset = 0x0;
        } pxie_pce[6:6];
        field {
            name = "pxie_dpe";
            desc = "Linked list transfer completion interrupt mask
- 0: masked
- 1: not masked";
            sw = rw; hw = r;
            reset = 0x0;
        } pxie_dpe[5:5];
        field {
            name = "pxie_ufe";
            desc = "Unknown FIS interrupt mask
- 0: masked
- 1: not masked";
            sw = rw; hw = r;
            reset = 0x0;
        } pxie_ufe[4:4];
        field {
            name = "pxie_sdbe";
            desc = "Set device bits FIS interrupt mask
- 0: masked
- 1: not masked";
            sw = rw; hw = r;
            reset = 0x0;
        } pxie_sdbe[3:3];
        field {
            name = "pxie_dse";
            desc = "DMA setup FIS interrupt mask
- 0: masked
- 1: not masked";
            sw = rw; hw = r;
            reset = 0x0;
        } pxie_dse[2:2];
        field {
            name = "pxie_pse";
            desc = "PIO setup FIS interrupt mask
- 0: masked
- 1: not masked";
            sw = rw; hw = r;
            reset = 0x0;
        } pxie_pse[1:1];
        field {
            name = "pxie_dhre";
            desc = "D2H register FIS interrupt mask
- 0: masked
- 1: not masked";
            sw = rw; hw = r;
            reset = 0x0;
        } pxie_dhre[0:0];
    };
    SATA_PORT_IE_t SATA_PORT_IE_0 @ 0x14;
    SATA_PORT_IE_t SATA_PORT_IE_1 @ 0x94;
    reg SATA_PORT_CMD_t {
        name = "SATA_PORT_CMD";
        desc = "SATA_PORT_CMD is a port command and status register. (offset 0x18, 2 instances at stride 0x80; total reset 0x00600000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 13.6.7.2, PDF page 1610).";
        field {
            name = "cmd_icc";
            desc = "Port communication control signal
- 0x0: No operation. It indicates that the next port status request is allowed.
- 0x1: Request to enable the port to be in the active status.
- 0x2: Request to enable the port to be in the partial status.
- 0x6: Request to enable the port to be in the slumber status.

Other values: reserved When the software writes any of the preceding values rather than the reserved value, the controller clears the cmd_icc bit after performing related operations. When the software requests the current status of the port, the controller clears the cmd_icc bit directly. If the software requests the port status change from a low-power status to another low-power status, such as from the partial status to the slumber status, it needs to request the status change from the partial status to the active status, and then to the slumber status.";
            sw = rw; hw = r;
            reset = 0x0;
        } cmd_icc[31:28];
        field {
            name = "cmd_asp";
            desc = "Slumber or partial status select for power management
- 0: proactively enter the partial status.
- 1: proactively enter the slumber status.";
            sw = rw; hw = r;
            reset = 0x0;
        } cmd_asp[27:27];
        field {
            name = "cmd_alpe";
            desc = "Automatic power management enable
- 0: disabled
- 1: enabled If SATA_PORT_CI and SATA_PORT_SACT are cleared, the controller enters the power-management status automatically. To be specific, if cmd_asp is 1, the controller enters the partial status; if cmd_asp is 0, the controller enters the slumber status.";
            sw = rw; hw = r;
            reset = 0x0;
        } cmd_alpe[26:26];
        field {
            name = "cmd_dlae";
            desc = "LED drive enable in ATAPI mode
- 0: The LED pin can be driven when cmd_atapi is 0 and commands are being executed.
- 1: The LED pin can be driven when commands are being executed.";
            sw = rw; hw = r;
            reset = 0x0;
        } cmd_dlae[25:25];
        field {
            name = "cmd_atapi";
            desc = "ATAPI device indicator
- 0: The current device is not an ATAPI device.
- 1: The current device is an ATAPI device.";
            sw = rw; hw = r;
            reset = 0x0;
        } cmd_atapi[24:24];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_23_23[23:23];
        field {
            name = "fbscp";
            desc = "Whether the port supports FIS-based switching. When SATA_GHC_CAP1[spm] and SATA_GHC_CAP1[FBSS] are set to 1, this bit must be set to 1.
- 0: not supported
- 1: supported";
            sw = r; hw = w;
            reset = 0x1;
        } fbscp[22:22];
        field {
            name = "cmd_esp";
            desc = "Fixed at 1, indicating that the external SATA device is supported";
            sw = r; hw = w;
            reset = 0x1;
        } cmd_esp[21:21];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_20_18[20:18];
        field {
            name = "cmd_pma";
            desc = "Port multiplier detection indicator
- 0: No port multiplier is connected to the port.
- 1: A port multiplier is connected to the port.";
            sw = rw; hw = r;
            reset = 0x0;
        } cmd_pma[17:17];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_16_16[16:16];
        field {
            name = "cmd_cr";
            desc = "Command list processing indicator
- 0: No command is being executed.
- 1: A command is being executed.";
            sw = r; hw = w;
            reset = 0x0;
        } cmd_cr[15:15];
        field {
            name = "cmd_fr";
            desc = "FIS receive processing indicator
- 0: No FIS is being received.
- 1: An FIS is being received.";
            sw = r; hw = w;
            reset = 0x0;
        } cmd_fr[14:14];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_13_13[13:13];
        field {
            name = "cmd_ccs";
            desc = "Slot number of the current command This field is valid when cmd_st is 1 and is cleared when cmd_st is 0.";
            sw = r; hw = w;
            reset = 0x0;
        } cmd_ccs[12:8];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_5[7:5];
        field {
            name = "cmd_fre";
            desc = "FIS receive enable control
- 0: forbid to write the received FISs to the system memory
- 1: enable the received FISs and write them to the system memory

The software needs to set the receive FIS base address register SATA_PORT_FB before enabling this bit to receive FISs. When cmd_st is 1, this bit must be set to 1.";
            sw = rw; hw = r;
            reset = 0x0;
        } cmd_fre[4:4];
        field {
            name = "cmd_clo";
            desc = "BSY/DQR clear control. The software can forcibly clear the BSY and DRQ bits through this bit and transmit commands to the device.
- 0: no effect
- 1: Clear the BSY and DRQ bits of SATA_PORT_TFD[tfd_sts].

After the BSY and DRQ bits are 0, the cmd_clo bit is automatically cleared. The cmd_clo bit can be written as 1 only before the value of cmd_st is changed from 0 to 1. In addition, the software must write 1 to cmd_st after the cmd_clo bit is cleared.";
            sw = rw; hw = r;
            reset = 0x0;
        } cmd_clo[3:3];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_2_2[2:2];
        field {
            name = "cmd_sud";
            desc = "Spin-up device control
- 0: When SATA_PORT_SCTL[det] is 0, the controller enters the listen mode.
- 1: After the system is powered on or the HBA is reset, the controller is enabled to transmit a COMRESET sequence to initialize the hardware device.";
            sw = rw; hw = r;
            reset = 0x0;
        } cmd_sud[1:1];
        field {
            name = "cmd_st";
            desc = "Command list processing enable
- 0: The controller enters the idle status.
- 1: The controller processes the commands from slot 0 that are identified as valid slots by SATA_PORT_CI.

The cmd_st bit can be set to 1 only after cmd_fre is 1.";
            sw = rw; hw = r;
            reset = 0x0;
        } cmd_st[0:0];
    };
    SATA_PORT_CMD_t SATA_PORT_CMD_0 @ 0x18;
    SATA_PORT_CMD_t SATA_PORT_CMD_1 @ 0x98;
    reg SATA_PORT_TFD_t {
        name = "SATA_PORT_TFD";
        desc = "SATA_PORT_TFD is a port task file register. (offset 0x20, 2 instances at stride 0x80; total reset 0x0000007F; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 13.6.7.2, PDF page 1613).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_16[31:16];
        field {
            name = "tfd_err";
            desc = "Task file error The controller updates this field after receiving a D2H register FIS, a PIO setup FIS, or an SDB FIS.";
            sw = r; hw = w;
            reset = 0x0;
        } tfd_err[15:8];
        field {
            name = "tfd_sts";
            desc = "Task file status bit[7]: BSY bit. It indicates that the device is busy. bit[6:4]: The meaning of this field varies according to commands. bit[3]: DRQ bit. It indicates that there is the data to be transferred in the device. bit[2:1]: The meaning of this field varies according to commands. bit[0]: ERR bit. It indicates that an error occurs during the data transfer. The controller updates this field after receiving a D2H register FIS, a PIO setup FIS, or an SDB FIS.";
            sw = r; hw = w;
            reset = 0x7f;
        } tfd_sts[7:0];
    };
    SATA_PORT_TFD_t SATA_PORT_TFD_0 @ 0x20;
    SATA_PORT_TFD_t SATA_PORT_TFD_1 @ 0xA0;
    reg SATA_PORT_SIG_t {
        name = "SATA_PORT_SIG";
        desc = "SATA_PORT_SIG is a port signature register. (offset 0x24, 2 instances at stride 0x80; total reset 0xFFFFFFFF; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 13.6.7.2, PDF page 1614).";
        field {
            name = "signature";
            desc = "LBA address and sector addressing. The allocated addresses are as follows: bit[31:24]: LBA upper-bit address bit[23:16]: LBA middle-bit address bit[15:8]: LBA lower-bit address bit[7:0]: number of sectors The controller updates this register when receiving the first D2H register FIS after the hardware device is reset.";
            sw = r; hw = w;
            reset = 0xffffffff;
        } signature[31:0];
    };
    SATA_PORT_SIG_t SATA_PORT_SIG_0 @ 0x24;
    SATA_PORT_SIG_t SATA_PORT_SIG_1 @ 0xA4;
    reg SATA_PORT_SSTS_t {
        name = "SATA_PORT_SSTS";
        desc = "SATA_PORT_SSTS is a port status register. (offset 0x28, 2 instances at stride 0x80; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 13.6.7.2, PDF page 1614).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_12[31:12];
        field {
            name = "pxssts_ipm";
            desc = "Current port status
- 0x0: No devices exist or no communication is set up.
- 0x1: active
- 0x2: partial
- 0x6: slumber

Other values: reserved";
            sw = r; hw = w;
            reset = 0x0;
        } pxssts_ipm[11:8];
        field {
            name = "pxssts_spd";
            desc = "Port negotiation speed
- 0x0: No devices exist or no communication is set up.
- 0x1: Rate 1 is negotiated for communication.
- 0x2: Rate 2 is negotiated for communication.
- 0x3: Rate 3 is negotiated for communication.

Other values: reserved";
            sw = r; hw = w;
            reset = 0x0;
        } pxssts_spd[7:4];
        field {
            name = "pxssts_det";
            desc = "Device detection and PHY status
- 0x0: No device is detected and no PHY communication is set up.
- 0x1: A device is detected but no PHY communication is set up.
- 0x3: A device is detected but the PHY communication is set up.
- 0x4: The PHY is offline or in the built-in self test (BIST) status.

Other values: reserved";
            sw = r; hw = w;
            reset = 0x0;
        } pxssts_det[3:0];
    };
    SATA_PORT_SSTS_t SATA_PORT_SSTS_0 @ 0x28;
    SATA_PORT_SSTS_t SATA_PORT_SSTS_1 @ 0xA8;
    reg SATA_PORT_SCTL_t {
        name = "SATA_PORT_SCTL";
        desc = "SATA_PORT_SCTL is a port control register. (offset 0x2C, 2 instances at stride 0x80; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 13.6.7.2, PDF page 1615).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_12[31:12];
        field {
            name = "pxsctl_ipm";
            desc = "Port power management status control
- 0x0: no requirements
- 0x1: forbid to enter the partial status
- 0x2: forbid to enter the slumber status
- 0x3: forbid to enter the partial or slumber state

Other values: reserved";
            sw = rw; hw = r;
            reset = 0x0;
        } pxsctl_ipm[11:8];
        field {
            name = "pxsctl_spd";
            desc = "Port communication speed control
- 0x0: no requirements
- 0x1: limit the communication speed to rate 1
- 0x2: limit the communication speed to rate 2
- 0x3: limit the communication speed to rate 3

Other values: reserved";
            sw = rw; hw = r;
            reset = 0x0;
        } pxsctl_spd[7:4];
        field {
            name = "pxsctl_det";
            desc = "Device detection and port initialization control
- 0x0: no device detection or initialization request
- 0x1: request the port to reset the initialization sequence

COMRESET
- 0x4: force the port to be offline

Other values: reserved When pxsctl_det is set to 1, the controller transmits the COMRESET sequence to the device. In this case, to ensure that the device receives the COMRESET sequence, the software must retain the value 1 of pxsctl_det for at least 1 ms.";
            sw = rw; hw = r;
            reset = 0x0;
        } pxsctl_det[3:0];
    };
