        desc = "SATA_PORT_SNTF is an async notification event indicator register. (offset 0x3C, 2 instances at stride 0x80; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 13.6.7.2, PDF page 1619).";
        field {
