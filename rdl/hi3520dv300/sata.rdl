            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } diag_s[23:23];
        field {
            name = "diag_h";
            desc = "Handshake error status
- 0: No R_ERR primitive transmitted from the device is received.
- 1: One or more R_ERR primitives transmitted from the device are received.

Access type WC in the data sheet: written 1 clears the bit.";
            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } diag_h[22:22];
        field {
            name = "diag_c";
