            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } diag_x[26:26];
        field {
            name = "diag_f";
            desc = "Detection status of the unknown FIS
- 0: No unknown FIS is received.
- 1: An unknown FIS is received and this bit is set to 1 when the cyclic redundancy check (CRC) is correct.

Access type WC in the data sheet: written 1 clears the bit.";
            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } diag_f[25:25];
