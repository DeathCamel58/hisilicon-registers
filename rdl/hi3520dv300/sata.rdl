    reg SATA_PORT_SERR_t {
        name = "SATA_PORT_SERR";
        desc = "SATA_PORT_SERR is an error diagnosis status register. (offset 0x30, 2 instances at stride 0x80; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 13.6.7.2, PDF page 1616).";
