    name = "DDRC AWADDR surveillance";
    desc = "DDRC AWADDR surveillance of the Hi3521A/Hi3520D V300 at base 0x1211_5000. 4 registers extracted programmatically from the Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10) (Table 4-9 Summary of AWADDR_SRVLNC registers (base address: 0x1211_5000)): register headings, offsets, total reset values, field bit ranges, access types, names, reset values and descriptions, with PDF page numbers in each register description. Field names, bit ranges, access types and offsets are exact; the free-text descriptions are taken from the cell text of the field table and were checked by sampling only. Hardware not verified.";
    reg {
        name = "WADDR_SRVLNC_CLKCFG";
        desc = "AWADDR_SRVLNC_CLKCFG is a MUX clock gating configuration register. (offset 0x0; total reset 0x00000007; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.7.2, PDF page 785).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x1;
        } reserved_31_2[31:2];
        field {
            name = "detaddr_gt_en";
            desc = "Static clock gating for the address monitoring module
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x1;
        } detaddr_gt_en[1:1];
        field {
            name = "apg_gt_en";
            desc = "Static clock gating for the register module in the address monitoring module
- 0: disabled
- 1: enabled";
            sw = rw; hw = r;
            reset = 0x1;
        } apg_gt_en[0:0];
    } WADDR_SRVLNC_CLKCFG @ 0x0;
    reg {
        name = "AWADDR_SRVLNC_STARTN";
        desc = "AWADDR_SRVLNC_STARTN is a start address register for segment n in the monitored address area. (offset 0x100; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.7.2, PDF page 786).";
        field {
            name = "awaddr_srvlnc_start";
            desc = "Start address of segment n in the address area Note: The lower 4-bit addresses can be ignored.";
            sw = rw; hw = r;
            reset = 0x0;
        } awaddr_srvlnc_start[31:0];
    } AWADDR_SRVLNC_STARTN @ 0x100;
    reg {
        name = "AWADDR_SRVLNC_ENDN";
        desc = "AWADDR_SRVLNC_ENDN is an end address register for segment n in the monitored address area. (offset 0x104; total reset 0x00000000; PROVEN: Hi3521A/Hi3520D V300 data sheet (Issue 00B07, 2015-12-10), section 4.1.7.2, PDF page 786).";
        field {
            name = "awaddr_srvlnc_end";
            desc = "End address of segment n in the address area Note: The lower 4-bit addresses can be ignored. The configured value is the actual end address + 1.";
            sw = rw; hw = r;
            reset = 0x0;
        } awaddr_srvlnc_end[31:0];
    } AWADDR_SRVLNC_ENDN @ 0x104;
