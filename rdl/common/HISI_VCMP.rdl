`ifndef HISI_VCMP_RDL
`define HISI_VCMP_RDL

addrmap aHISI_VCMP {
    name = "HiSilicon VCMP (registers not described)";
    desc = "Not described: no register of this block is described; the registers exist only in closed vendor libraries (the MPP binary modules), not in the data sheet or any vendor source in the tree. The 64 KB window is kept only so that the block base address and size exist in the address map (STUB). Video compress unit (data sheet 8.3, overview/features only): graphics bandwidth compression (ARGB1555 / ARGB8888 in, variable-length-code streams out to separate A, R, G, B buffers, direct-transfer self-test mode, task-completion interrupt; the VDP G0 layer decompresses them, see the G0DCMP* registers in `eHISI_VDP`). Register names that the data sheet mentions only in prose (8.3.3 limitations): SRC_ADDR, SRC_STRIDE (128-bit aligned), VCMP_A_ADDR, VCMP_R_ADDR, VCMP_G_ADDR, VCMP_B_ADDR (128-bit aligned, writeback width = n x 256 - 1); their offsets are not given. Registers may only be configured while the module is idle (after its interrupt). Clock/reset PERI_CRG29. No vendor source. Base address 0x206B0000, GIC interrupt ID 71. Listed as an open item in docs/rdl-sweep/PORT-BLOCKS.md.";

    external mem {
        name = "Undocumented register window";
        desc = "The whole 64 KB window of the block. Register layout unknown; placeholder so the block base address and size exist in the map. No registers are described.";
        mementries = 16384;
        memwidth = 32;
        sw = rw;
    } REGS;
};

`endif
