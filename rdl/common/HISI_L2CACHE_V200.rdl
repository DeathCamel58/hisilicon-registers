            desc = "AXI DECERR on a write buffer access - inject.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } decerr_wb[11:11];

        field {
            name = "slverr_wb";
            desc = "AXI SLVERR on a write buffer access - inject.";
            sw = rw;
            hw = r;
