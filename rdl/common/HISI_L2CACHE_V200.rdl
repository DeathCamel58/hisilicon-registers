    reg {
        name = "L2 interrupt test";
        desc = "Test-mode interrupt injection (bits 11:0, same names as the L2_RINT error bits).

Vendor driver `arch/arm/mm/cache-hil2v200.c` / `cache-hil2v200.h` (REG_L2_INTTEST, L2_INTTEST_*).";

        field {
