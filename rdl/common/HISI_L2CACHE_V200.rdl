            sw = rw;
            hw = r;
            reset = 0x0;
        } value[31:0];
    } L2_INTCLR_EXT_MON @ 0x12C;

    reg {
        name = "L2 sync";
        desc = "Cache sync. The driver's `cache_sync()` only reads this register (reading drains the outstanding operations).

Vendor driver `arch/arm/mm/cache-hil2v200.c` / `cache-hil2v200.h` (REG_L2_SYNC).";

        field {
            name = "sync";
            desc = "Sync (BIT_L2_SYNC_SYNC).";
            sw = rw;
            hw = r;
            reset = 0x0;
        } sync[0:0];
    } L2_SYNC @ 0x200;

    reg {
        name = "L2 automatic maintenance";
        desc = "Clean or invalidate a whole way in hardware. The driver writes way << 2 | start (invalidate) or way << 2 | start | 0x2 (clean); completion is `L2_RINT.auto_end`.

Vendor driver `arch/arm/mm/cache-hil2v200.c` / `cache-hil2v200.h` (REG_L2_MAINT_AUTO).";

        field {
            name = "way";
            desc = "Way number 0..7 (BIT_L2_MAINT_AUTO_WAYADDRESS = 2).";
            sw = rw;
            hw = r;
            reset = 0x0;
        } way[4:2];

        field {
            name = "clean";
            desc = "1 = clean the way, 0 = invalidate it (the driver ORs 0x2).";
            sw = rw;
            hw = r;
            reset = 0x0;
        } clean[1:1];

        field {
            name = "start";
            desc = "Start the operation.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } start[0:0];
    } L2_MAINT_AUTO @ 0x20C;

    reg {
        name = "L2 invalidate";
        desc = "Invalidate a line by address: the driver writes `line address | 0x2` (BIT_L2_INVALID_BYADDRESS = 1) once per 32-byte line; flush_range writes `address | 1` to this and to L2_CLEAN.

Vendor driver `arch/arm/mm/cache-hil2v200.c` / `cache-hil2v200.h` (REG_L2_INVALID, BIT_L2_INVALID_*).";

        field {
            name = "address";
            desc = "Physical address bits 31:5 (by-address mode). The header also defines BIT_L2_INVALID_WAYADDRESS = 29 and LINEADDRESS = 5 for the way/index mode (way in bits 31:29, line index from bit 5).";
            sw = rw;
            hw = r;
            reset = 0x0;
        } address[31:5];

        field {
            name = "byaddress";
            desc = "1 = operate by address (BIT_L2_INVALID_BYADDRESS).";
            sw = rw;
            hw = r;
            reset = 0x0;
        } byaddress[1:1];

        field {
            name = "flush_flag";
            desc = "Written as 1 by the driver's flush_range (meaning not documented).";
            sw = rw;
            hw = r;
            reset = 0x0;
        } flush_flag[0:0];
    } L2_INVALID @ 0x210;

    reg {
        name = "L2 clean";
        desc = "Clean a line by address (same layout as L2_INVALID).

Vendor driver `arch/arm/mm/cache-hil2v200.c` / `cache-hil2v200.h` (REG_L2_CLEAN, BIT_L2_CLEAN_*).";

        field {
            name = "address";
            desc = "Physical address bits 31:5 (way in 31:29 and line index from bit 5 for the way/index mode).";
            sw = rw;
            hw = r;
            reset = 0x0;
        } address[31:5];

        field {
            name = "byaddress";
            desc = "1 = operate by address (BIT_L2_CLEAN_BYADDRESS).";
            sw = rw;
            hw = r;
            reset = 0x0;
        } byaddress[1:1];

        field {
            name = "flush_flag";
            desc = "Written as 1 by the driver's flush_range (meaning not documented).";
            sw = rw;
            hw = r;
            reset = 0x0;
        } flush_flag[0:0];
    } L2_CLEAN @ 0x214;

    reg {
        name = "L2 data lockdown by way";
