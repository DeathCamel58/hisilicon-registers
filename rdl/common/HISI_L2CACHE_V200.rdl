`ifndef HISI_L2CACHE_V200_RDL
`define HISI_L2CACHE_V200_RDL

regfile eHISI_L2CACHE_V200 {
    name = "HiSilicon L2 cache controller v200";
    desc = "
    HiSilicon \"L2 cache v200\" outer cache controller (vendor `CONFIG_CACHE_HIL2V200`), 128 KB on the Hi3520D/Hi3515A/Hi3515C (256 KB on other SoCs using the same driver), 8 ways, 32-byte lines
    (way size 16 KB, 512 lines per way). It is **not** an ARM PL310 / L2C-310: the register layout is unrelated (a mainline `arm,pl310-cache` node hangs in `l2c_enable()`, docs/TODO.md).
    The block is at 0x20700000 (1 MB window, Table 1-1 'L2 Cache Space').

    **The data sheet does not document these registers.** Section 3.10.2 only lists the features (128 KB, physical tag, lockdown in format C, 32-byte lines, write-back/write-through, ECC with 1-bit
    correction on tag and data RAM, exclusive cache mode, clean/invalidate by way, way+index or address, performance statistics counters; DS 3.10.2) and Table 3-25 the L2 : AXI clock ratio (2:1 = L2 660 MHz / bus 330 MHz, 1:1 = 330/330 MHz)
    (PERI_CRG10 freqmode_a9_sys). The registers below are transcribed from the vendor driver and its header (`REG_L2_*`, `BIT_L2_*`); every offset and bit used by the driver is exact, the
    remaining registers (test mode, region, counters, special control) are present in the header but never used by the driver, so their field layout is unknown (modelled as plain 32-bit registers
    with a description). The data sheet gives no reset values; the reset values here were read on hardware (nvr0408, stock U-Boot with the L2 off, right after power cycle) on 2026-11-08 (`docs/rdl-sweep/hw-reads-2026-11-08.md`): L2_CTRL 0, L2_AUCTRL 0x01000011 (bits 24, 4, 0 are not named in the vendor header), L2_STATUS 0x2, interrupt/maintenance/lock/test/region registers 0, INT_COUNTER and EXT_COUNTER arrays read 0xFFFFFFFF in every element (all 11 words at 0x600..0x628 and all 28 words at 0x700..0x76C, read on hardware 2026-11-08), L2_SPECIAL_CHECK0 0x6DF7B1BE (read as 0x6DF7B1BC on 2026-11-08, see that register), L2_SPECIAL_CHECK1 0. Behaviour of the registers beyond the reset values is not hardware verified.

    Interrupts (GIC IDs, DS Table 3-16): 61 `L2CACHE_CHK0_INT`, 62 `L2CACHE_CHK1_INT`, 63 `L2CACHE_INT_COMB`.

    Driver sequence (`l2cache_init`): disable (`L2_CTRL` = 0), set `event_bus_en` and `monitor_en` in `L2_AUCTRL`, write 0 to `L2_INTCLR`, `L2_SPECIAL_CHECK0/1`, write 0x3FFF to `L2_INTMASK`, invalidate all
    ways with `L2_MAINT_AUTO` (poll `L2_RINT.auto_end`, clear via `L2_INTCLR`), then enable (`L2_CTRL` = 1). Range maintenance writes `address | flag` to `L2_INVALID` / `L2_CLEAN` once per 32-byte line.
    ";

    reg {
        name = "L2 control";
        desc = "Cache enable.

Vendor driver `arch/arm/mm/cache-hil2v200.c` / `cache-hil2v200.h` (REG_L2_CTRL, BIT_L2_CTRL_CACHE_ENABLE).";

        field {
            name = "cache_enable";
            desc = "1 = L2 cache enabled, 0 = disabled (bypassed, all L1 operations pass through to memory).";
            sw = rw;
            hw = r;
            reset = 0x0;
        } cache_enable[0:0];
    } L2_CTRL @ 0x0;

    reg {
        name = "L2 auxiliary control";
        desc = "Auxiliary control bits.

