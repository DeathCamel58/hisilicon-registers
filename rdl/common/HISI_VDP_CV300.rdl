            sw = rw;
            hw = r;
            encode = VO_DAC_0_CTRL_dac0en_enum;
            reset = 0x0;
        } dac0en[31:31];

        enum VO_DAC_0_CTRL_dac0gc_enum {
            V_0_52_V = 0x0 { name = "V 0 52 V"; desc = "0.52 V ..."; };
            V_1_37_V = 0x3F { name = "V 1 37 V"; desc = "1.37 V"; };
        };

        field {
            name = "dac0gc";
            desc = "DAC output amplitude control The full-scale output voltage ranges from 0.52 V to 1.37 V. The output amplitude is divided into 64 orders for adjustment. The adjustment precision is 1%. The formula is as follows: Ifs = 13.9 + GAIN x 0.358 (m A)";
            sw = rw;
            hw = r;
            encode = VO_DAC_0_CTRL_dac0gc_enum;
            reset = 0x0;
        } dac0gc[9:4];

