            V_10 = 1 { name = "V 10"; desc = "-10%"; };
            V_20 = 2 { name = "V 20"; desc = "-20%"; };
            V_10_2 = 3 { name = "V 10 2"; desc = "+10%"; };
        };

        field {
            name = "cablectr0";
            desc = "VREF_CABLE reference voltage adjustment of the DAC";
            sw = rw;
            hw = r;
            encode = VO_DAC_0_CTRL_cablectr0_enum;
            reset = 0x0;
        } cablectr0[1:0];
    } VO_DAC_0_CTRL @ 0x134;

