            SONY_DOL_MODE = 5 { name = "Sony Dol Mode"; desc = "SONY DOL mode. In this mode, the synchronization code consists of four fields. The SAV-EAV flag mode is used. The long and short exposure frames share a group of sync code, and the region between the long and short exposure frames is the blanking region."; };
