        name = "Key 0 (configured by MCU) register";
        desc = "MCU_KEY0 is an HMAC input key register (bits 0-31, configured by the CPU).

Data sheet 13.2.6 MCU_KEY0 (offset 0x70, printed page 13-49, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 93900).";

        field {
