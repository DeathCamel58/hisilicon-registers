`ifndef HISI_HDMI_RDL
`define HISI_HDMI_RDL

regfile eHISI_HDMI {
    name = "HiSilicon HDMI transmitter (SiI9134-style)";
    desc = "Partly described: offsets and names are exact for the 74 registers the vendor U-Boot header (`defstx.h`) defines (and the access method: 8-bit registers at a 32-bit stride, I2C pages memory-mapped); bit names are the vendor `BIT_*` macros; the five PHY registers at 0x1800.. are known only by the values the vendor writes. NOT known: reset values (none were read on hardware), the names and layouts of the PHY registers, every SiI9134 register the vendor header does not define (info-frame data, DDC/EDID, ...), and whether the silicon behaves exactly like a SiI9134 (the identification as a SiI9134-style core is inferred from the vendor sources, unverified). Registers whose meaning is guessed say \"Meaning unverified\". Not in the data sheet.

    HiSilicon HDMI transmitter at 0x201F0000 (GIC interrupt ID 66), Table 1-1 of the data sheet lists only the 64 KB window; **the data sheet has no register description**. In the Hi3520D vendor U-Boot (`product/hiosd/hdmi/hdmi_v1/hi3520d`) the transmitter is a Silicon Image SiI9134-style TX core (Silicon Image copyright in `defstx.h`/`registers.h`) whose two I2C register pages are memory mapped: the byte registers of the slave 0x72 page are at 0x201F0000 + 4 x register (`HDMI_TX_SLV0_ADDR_BASE`), those of the slave 0x7A page at 0x201F0400 + 4 x register (`HDMI_TX_SLV1_ADDR_BASE`), i.e. 8-bit registers at a 32-bit stride (modelled as 32-bit registers, data in bits 7:0). A small PHY block sits at 0x201F1800.. (five registers written by `hdmiPhyInit()`). Clock and soft reset of the block are in PERI_CRG15 (CRG 0x2003003C, `HDMI_HARDWARE_RESET_ADDR` in `drv_hlviic.c`; `HdmiHardwareReset()` toggles it). Page 0 holds system control, HDCP, video timing/colour and interrupt registers; page 1 the audio, info-frame and packet registers. Only the registers that the vendor code uses (names from `defstx.h`; bit names from the `BIT_*` macros) are listed; the SiI9134 has many more (info-frame data at 0x40+ on page 1, EDID/DDC registers, ...), they are not defined in the vendor header copy and are not invented here. Reset values: unknown (not read on hardware). The `HDMI_REG_BASE 0x205D0000` of the Hi3531-family platform header does not apply to the Hi3520D (the data sheet puts HDMI at 0x201F0000 and 0x205D0000 is Reserved); `HDMI_PHY_BASE_ADDR 0x205d0000` in `hlviic.h` is a leftover of that family. AOP1 of the AIO feeds the transmitter over I2S (data sheet chapter 13, I2S master, MCLK 256 x fs). Audio registers (page 1 0x01..0x24, 0x0D, 0x14, 0x1D, 0x21..0x24, 0x2F, infoframe slot 0x80, INF_CTRL1 bits 5:4) were cross-checked against the vendor module hi3520D_hdmi.ko (OEM firmware, static analysis, 2026-11-11): the I2S 2 channel PCM programming sequence is documented in docs/hdmi-audio-design.md of the workspace.
    ";

    reg {
        name = "Software reset";
        desc = "Page 0 register 0x05 (host address base + 0x0 + 4 x 0x05). 8-bit register at a 32-bit stride.

Vendor U-Boot `product/hiosd/hdmi/hdmi_v1/hi3520d/` (`defstx.h`, `drv_hlviic.c`, `hdmitx.c`).";

        field {
            name = "fifo_rst";
            desc = "FIFO reset (BIT_TX_FIFO_RST).";
            sw = rw;
            hw = r;
        } fifo_rst[1:1];

        field {
            name = "sw_rst";
            desc = "Transmitter soft reset (BIT_TX_SW_RST).";
            sw = rw;
            hw = r;
        } sw_rst[0:0];
    } SWRST @ 0x14;

    reg {
        name = "System control 1";
        desc = "Page 0 register 0x08 (host address base + 0x0 + 4 x 0x08). 8-bit register at a 32-bit stride.

Vendor U-Boot `product/hiosd/hdmi/hdmi_v1/hi3520d/` (`defstx.h`, `drv_hlviic.c`, `hdmitx.c`).";

        field {
            name = "data";
            desc = "8-bit register value (bit layout not given in the vendor header).";
            sw = rw;
            hw = r;
        } data[7:0];
    } SYS_CTRL1 @ 0x20;

    reg {
        name = "Status";
        desc = "Page 0 register 0x09 (host address base + 0x0 + 4 x 0x09). 8-bit register at a 32-bit stride.

Vendor U-Boot `product/hiosd/hdmi/hdmi_v1/hi3520d/` (`defstx.h`, `drv_hlviic.c`, `hdmitx.c`).";

        field {
            name = "rsen";
            desc = "Receiver sense (BIT_RSEN).";
            sw = r;
            hw = w;
        } rsen[2:2];

        field {
            name = "hpd_pin";
            desc = "Hot-plug detect pin (BIT_HPD_PIN).";
            sw = r;
            hw = w;
        } hpd_pin[1:1];

        field {
            name = "pstable";
            desc = "Pixel clock stable (BIT_HDMI_PSTABLE).";
            sw = r;
            hw = w;
        } pstable[0:0];
    } STAT @ 0x24;

    reg {
        name = "System control 4";
        desc = "Page 0 register 0x0C (host address base + 0x0 + 4 x 0x0C). 8-bit register at a 32-bit stride.

Vendor U-Boot `product/hiosd/hdmi/hdmi_v1/hi3520d/` (`defstx.h`, `drv_hlviic.c`, `hdmitx.c`).";

