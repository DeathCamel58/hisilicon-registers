`ifndef HISI_JPGE_RDL
`define HISI_JPGE_RDL

addrmap aHISI_JPGE {
    name = "HiSilicon JPGE (registers not described)";
    desc = "Not described: no register of this block is described; the registers exist only in closed vendor libraries (the MPP binary modules), not in the data sheet or any vendor source in the tree. The 64 KB window is kept only so that the block base address and size exist in the address map (STUB). JPEG encoder (data sheet 6.3, overview/features only): ISO 10918-1 baseline, YCbCr 4:2:0/4:2:2/4:4:4, planar/semi-planar/YUYV input, up to 8192x8192, separate Y/Cb/Cr quantization tables, 8-region OSD overlay. The vendor MPP JPEGE is a closed-source module (openhisilicon `kernel/jpege` is for other SoCs). No register description anywhere. Base address 0x20660000, GIC interrupt ID 73. Listed as an open item in docs/rdl-sweep/PORT-BLOCKS.md.";

    external mem {
        name = "Undocumented register window";
        desc = "The whole 64 KB window of the block. Register layout unknown; placeholder so the block base address and size exist in the map. No registers are described.";
        mementries = 16384;
        memwidth = 32;
        sw = rw;
    } REGS;
};

`endif
