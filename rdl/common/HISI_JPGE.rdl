`ifndef HISI_JPGE_RDL
`define HISI_JPGE_RDL


regfile eHISI_JPGE {
    name = "HiSilicon JPEG encoder (JPGE, r004 register layout)";
    desc = "
    LAYOUT PARTLY CONFIRMED ON THE Hi3520D BOARD (2026-11-10): the registers used by the Linux hisi-jpge driver (interrupts, PICFG, IMGSIZE, source addresses and strides for semi-planar input, stream address/length, QPT writes, START, OUTSTD, VERSION) produced correct JPEG files on the board, so offsets and the main field positions are confirmed; each register description below states its own source and confidence in the fixed forms 'Source: data sheet', 'Source: HiSTB driver (register semantics only), confidence HIGH|MEDIUM|LOW', 'Source: Hi3520D board read-back 2026-11-10' and 'Not verified on hardware'. Previously: CANDIDATE LAYOUT, LOW-MEDIUM CONFIDENCE, NOT HARDWARE VERIFIED. JPEG encoder (JPGE) of the Hi3520D SDK generation: 40 registers transcribed from the header `jpge_reg(r004).h` (file `product/hiosd/dec/jpeg_reg.h`, Huawei copyright 2012-05-16, version 2.0) that ships unused inside the Hi3520D vendor U-Boot 2010.06 uploads (https://github.com/Axl-zhang/hisilicon-hi3520d-uboot, https://github.com/hi35xx/hi35xx-buildroot `boot/uboot/u-boot-2010.06`; GPL-2.0 U-Boot tree). The header names no chip and gives no base address; the Hi3520D data sheet (Table 1-1) places the JPGE window at 0x20660000 (GIC interrupt 73) and its 6.3 feature list (baseline JPEG, 4:2:0/4:2:2/4:4:4, planar/semi-planar/packed input, 8192x8192, 8-region OSD, separate Y/Cb/Cr quantization tables) matches this register set (8 VPP_OSD regions, 48-word quantization table). Layout: interrupt set 0x0-0xC (end of picture, buffer full, time-out, config error), picture config 0x10-0x24, source addresses/strides 0x30-0x3C, stream buffer 0x40-0x4C (start, read/write pointers, length), PTS 0x70-0x7C, time-out/timer 0x80/0x84, OUTSTD 0xA4, VERSION 0xFC, VPP overlay 0x500-0x5D0 (8 OSD regions: alpha, position, size, address, stride, layer order, colour inversion), quantization table JPGE_QPT[48] at 0x1000. Reset values and access types are unknown (no data sheet register description; modelled RW, no reset). Hardware probe to confirm the layout before relying on it: read 0x20660000 + 0xFC (JPGE_VERSION, expect a non-zero version word), + 0x0 / + 0x8 (JPGE_INTSTAT / JPGE_RAWINT, expect 0) and + 0x1000.. (JPGE_QPT, read/write test) with the JPGE clock enabled (PERI_CRG). The HiSTB SDK `source/msp/drv/jpge/src/jpge_reg.h` is a later revision of the same register family (same names, extra registers) and was not used. Every register and field desc below is marked `[inferred]` (names from the header, meanings inferred from the names).

    Generated 2026-11-10 by build/rdl-audit/video-rdl-scratch/gen_blocks.py: mechanical transcription of the data sheet register tables (ds_extract2 + description extraction from the PDF) merged with the vendor header; not hardware verified.

    Register sources: 0 registers from the data sheet (-, section -); 40 registers (5 of them arrays) and 0 fields from vendor U-Boot 2010.06 upload `product/hiosd/dec/jpeg_reg.h` = `jpge_reg(r004).h` (GPL-2.0 U-Boot tree, Huawei copyright 2012; github.com/Axl-zhang/hisilicon-hi3520d-uboot) (GPL-2.0; same SDK generation as the Hi3520D, chip not named in the file), each marked `[inferred]` in its desc (names from the header, meanings inferred from the names, reset/access unknown). ";

    reg {
        name = "JPGE INTSTAT";
        desc = "Interrupt status (masked by INTMASK). Bit 0 end of picture, 1 stream buffer full, 2 time-out, 3 configuration error. Layout: vendor header jpge_reg(r004).h (Hi3520D U-Boot 2010.06 upload), not in the data sheet. Reads 0 when idle; the end-of-picture bit is delivered as the interrupt of every encode (Source: Hi3520D board read-back 2026-11-10). Meaning of bits 1..3: Source: HiSTB driver (register semantics only), confidence MEDIUM. Not verified on hardware: the buffer-full, time-out and configuration-error interrupts were never raised in the board test. Access type (read-only) not verified.";

        field {
            name = "cfgErr";
            desc = "[inferred] Configuration error interrupt. (vendor header `jpeg_reg.h` (JPGE r004) field `cfgErr`; access and reset unknown, modelled RW)";
            sw = rw;
            hw = r;
        } cfgErr[3:3];

        field {
            name = "JpgeTimeout";
            desc = "[inferred] Encoder time-out interrupt (see JPGE_TIMEOUT/JPGE_TIMER). (vendor header `jpeg_reg.h` (JPGE r004) field `JpgeTimeout`; access and reset unknown, modelled RW)";
            sw = rw;
            hw = r;
        } JpgeTimeout[2:2];

        field {
            name = "VencBufFull";
            desc = "[inferred] Stream buffer full interrupt. (vendor header `jpeg_reg.h` (JPGE r004) field `VencBufFull`; access and reset unknown, modelled RW)";
            sw = rw;
            hw = r;
        } VencBufFull[1:1];

        field {
            name = "VencEndOfPic";
            desc = "[inferred] End-of-picture (frame encoded) interrupt. (vendor header `jpeg_reg.h` (JPGE r004) field `VencEndOfPic`; access and reset unknown, modelled RW)";
            sw = rw;
            hw = r;
        } VencEndOfPic[0:0];
    } JPGE_INTSTAT @ 0x0;

    reg {
        name = "JPGE INTMASK";
        desc = "Interrupt mask/enable: 1 = interrupt enabled (the Linux driver writes bits 0, 1 and 3 and gets the end-of-picture interrupt: Source: Hi3520D board read-back 2026-11-10). Layout: vendor header jpge_reg(r004).h (Hi3520D U-Boot 2010.06 upload), not in the data sheet. Reset value not read. Bit 2 (time-out) enable: Source: HiSTB driver (register semantics only), confidence MEDIUM, Not verified on hardware.";

        field {
            name = "cfgErrMask";
            desc = "[inferred] Mask of the configuration-error interrupt. (vendor header `jpeg_reg.h` (JPGE r004) field `cfgErrMask`; access and reset unknown, modelled RW)";
            sw = rw;
            hw = r;
        } cfgErrMask[3:3];

        field {
            name = "JpgeTimeoutMask";
            desc = "[inferred] Mask of the time-out interrupt. (vendor header `jpeg_reg.h` (JPGE r004) field `JpgeTimeoutMask`; access and reset unknown, modelled RW)";
            sw = rw;
            hw = r;
        } JpgeTimeoutMask[2:2];

        field {
            name = "VencBufFullMask";
            desc = "[inferred] Mask of the buffer-full interrupt. (vendor header `jpeg_reg.h` (JPGE r004) field `VencBufFullMask`; access and reset unknown, modelled RW)";
            sw = rw;
            hw = r;
        } VencBufFullMask[1:1];

        field {
            name = "VencEndOfPicMask";
            desc = "[inferred] Mask of the end-of-picture interrupt. (vendor header `jpeg_reg.h` (JPGE r004) field `VencEndOfPicMask`; access and reset unknown, modelled RW)";
            sw = rw;
            hw = r;
        } VencEndOfPicMask[0:0];
    } JPGE_INTMASK @ 0x4;

    reg {
        name = "JPGE RAWINT";
        desc = "Raw (unmasked) interrupt status, same bits as INTSTAT. Reads 0 when idle (Source: Hi3520D board read-back 2026-11-10). Layout: vendor header jpge_reg(r004).h (Hi3520D U-Boot 2010.06 upload), not in the data sheet. Not verified on hardware: behavior while an interrupt is masked.";

        field {
            name = "cfgErr";
            desc = "[inferred] Configuration error interrupt. (vendor header `jpeg_reg.h` (JPGE r004) field `cfgErr`; access and reset unknown, modelled RW)";
            sw = rw;
            hw = r;
        } cfgErr[3:3];

        field {
            name = "JpgeTimeout";
            desc = "[inferred] Encoder time-out interrupt (see JPGE_TIMEOUT/JPGE_TIMER). (vendor header `jpeg_reg.h` (JPGE r004) field `JpgeTimeout`; access and reset unknown, modelled RW)";
            sw = rw;
            hw = r;
        } JpgeTimeout[2:2];

        field {
            name = "VencBufFull";
            desc = "[inferred] Stream buffer full interrupt. (vendor header `jpeg_reg.h` (JPGE r004) field `VencBufFull`; access and reset unknown, modelled RW)";
            sw = rw;
            hw = r;
        } VencBufFull[1:1];

        field {
            name = "VencEndOfPic";
            desc = "[inferred] End-of-picture (frame encoded) interrupt. (vendor header `jpeg_reg.h` (JPGE r004) field `VencEndOfPic`; access and reset unknown, modelled RW)";
            sw = rw;
            hw = r;
        } VencEndOfPic[0:0];
    } JPGE_RAWINT @ 0x8;

    reg {
        name = "JPGE INTCLR";
        desc = "Interrupt clear: write 1 to clear the matching bit. The Linux driver writes the status it read and the interrupt deasserts (Source: Hi3520D board read-back 2026-11-10, encode loops of 3000 frames). The HiSTB ISR path (jpge_hal.c Jpge_ReadReg, after reading INTSTAT) writes 0xFFFFFFFF to clear every bit (Source: HiSTB driver (register semantics only), confidence MEDIUM). Layout: vendor header jpge_reg(r004).h (Hi3520D U-Boot 2010.06 upload), not in the data sheet.";

        field {
            name = "cfgErrClr";
            desc = "[inferred] Clear the configuration-error interrupt. (vendor header `jpeg_reg.h` (JPGE r004) field `cfgErrClr`; access and reset unknown, modelled RW)";
            sw = rw;
            hw = r;
        } cfgErrClr[3:3];

        field {
            name = "JpgeTimeoutClr";
            desc = "[inferred] Clear the time-out interrupt. (vendor header `jpeg_reg.h` (JPGE r004) field `JpgeTimeoutClr`; access and reset unknown, modelled RW)";
            sw = rw;
            hw = r;
        } JpgeTimeoutClr[2:2];

        field {
            name = "VencBufFullClr";
            desc = "[inferred] Clear the buffer-full interrupt. (vendor header `jpeg_reg.h` (JPGE r004) field `VencBufFullClr`; access and reset unknown, modelled RW)";
            sw = rw;
            hw = r;
        } VencBufFullClr[1:1];

        field {
            name = "VencEndOfPicClr";
            desc = "[inferred] Clear the end-of-picture interrupt. (vendor header `jpeg_reg.h` (JPGE r004) field `VencEndOfPicClr`; access and reset unknown, modelled RW)";
            sw = rw;
            hw = r;
        } VencEndOfPicClr[0:0];
    } JPGE_INTCLR @ 0xC;

    reg {
        name = "JPGE PICFG";
        desc = "Picture configuration. Reset value 0x0D880000 (Source: Hi3520D board read-back 2026-11-10): roundEn = 1, packageSel = 0xD8 (YUYV), everything else 0. Layout: vendor header jpge_reg(r004).h (Hi3520D U-Boot 2010.06 upload), not in the data sheet. The Linux driver writes the whole register per job with roundEn = 0 (as the HiSTB driver does) and the encodes work on the board. Fields not covered by the encode test are marked per field.";

        field {
            name = "col2grayEn";
            desc = "Color to gray conversion (name only). Source: HiSTB driver (register semantics only), confidence LOW. Reset 0 (Source: Hi3520D board read-back 2026-11-10). The data sheet lists no 4:0:0 encoding. Not verified on hardware.";
            sw = rw;
            hw = r;
            reset = 0;
        } col2grayEn[29:29];

        field {
            name = "jcpi_clip_en";
            desc = "Enable clipping with JPGE_CLIP_THR. Source: HiSTB driver (register semantics only), confidence LOW. Reset 0 (Source: Hi3520D board read-back 2026-11-10). Not verified on hardware.";
            sw = rw;
            hw = r;
            reset = 0;
        } jcpi_clip_en[28:28];

        field {
            name = "packageSel";
            desc = "Component byte order of packed input, four 2 bit fields = byte position (0..3) in a 4 byte Y0 Cb/Cr Y1 Cr/Cb group: [1:0] Y0, [3:2] Y1, [5:4] Cb, [7:6] Cr. Reset 0xD8 = YUYV (Source: Hi3520D board read-back 2026-11-10; YUYV is the packed format the data sheet lists, Source: data sheet 6.3.2). The rule is derived from three vendor constants: UYVY 0x8D, YUYV 0xD8, YVYU 0x78 (Source: HiSTB driver (register semantics only), confidence MEDIUM; constants from the HiSTB VENC code, same field name); VYUY 0x2D follows from the rule (LOW). Not verified on hardware for non-default values and for any effect on planar or semi-planar input.";
            sw = rw;
            hw = r;
            reset = 0xD8;
        } packageSel[27:20];

        field {
            name = "roundEn";
            desc = "Rounding control. Reset 1 (Source: Hi3520D board read-back 2026-11-10); the HiSTB driver and the Linux driver write 0 and the output decodes correctly, so the effect of the bit is unknown. Not verified on hardware.";
            sw = rw;
            hw = r;
            reset = 1;
        } roundEn[19:19];

        field {
            name = "timeoutEn";
            desc = "Enable the hardware encode time-out (JPGE_TIMEOUT / JPGE_TIMER). Source: HiSTB driver (register semantics only), confidence LOW. Reset 0 (Source: Hi3520D board read-back 2026-11-10). The Linux driver uses a software watchdog instead. Not verified on hardware.";
            sw = rw;
            hw = r;
            reset = 0;
        } timeoutEn[18:18];

        field {
            name = "configlockEn";
            desc = "Lock the configuration registers while encoding. Source: HiSTB driver (register semantics only), confidence LOW. Reset 0 (Source: Hi3520D board read-back 2026-11-10). Not verified on hardware.";
            sw = rw;
            hw = r;
            reset = 0;
        } configlockEn[17:17];

        field {
            name = "memClkGateEn";
            desc = "Memory clock gating enable; the HiSTB driver and the Linux driver write 1 (Source: Hi3520D board read-back 2026-11-10: works). Reset 0 (Source: Hi3520D board read-back 2026-11-10). Effect of 0 during encoding: Not verified on hardware.";
            sw = rw;
            hw = r;
            reset = 0;
        } memClkGateEn[16:16];

        field {
            name = "clkGateEn";
            desc = "Clock gating level; the HiSTB driver writes 2 (frame and block level gating). The Linux driver writes 2 and encodes correctly (Source: Hi3520D board read-back 2026-11-10). Other values: Not verified on hardware.";
            sw = rw;
            hw = r;
            reset = 0;
        } clkGateEn[15:14];

        field {
            name = "rotationAngle";
            desc = "Rotation of the source picture: 0 = none, 1 = 90, 2 = 270, 3 = 180 degrees (direction unknown). For 90/270 the HiSTB driver swaps width and height in the JFIF header and turns 4:2:2 into 4:2:0 with a doubled chroma stride. Source: HiSTB driver (register semantics only), confidence MEDIUM. Not used by the Linux driver. Not verified on hardware.";
            sw = rw;
            hw = r;
            reset = 0;
        } rotationAngle[13:12];

        field {
            name = "chnId";
            desc = "Channel ID copied into the packet descriptor (descriptor bytes 12..15). Source: HiSTB driver (register semantics only), confidence LOW. The Linux driver writes 0. Not verified on hardware.";
            sw = rw;
            hw = r;
            reset = 0;
        } chnId[11:4];

        field {
            name = "yuvFmt";
            desc = "Chroma sampling of the picture and of the JPEG: 0 = 4:2:0, 1 = 4:2:2 (Source: Hi3520D board read-back 2026-11-10: NV21 and NV61 encodes decode correctly with SOF sampling 0x22 and 0x21), 2 = 4:4:4 (Source: HiSTB driver (register semantics only), confidence MEDIUM, Not verified on hardware). Value 3: unknown, the HiSTB JPGE driver rejects it (not verified, LOW). With 4:2:2 data and yuvFmt = 0 plus a doubled chroma stride the encoder skips every second chroma line (4:2:0 JPEG from 4:2:2 input): Source: HiSTB driver (register semantics only), confidence MEDIUM (used by the HiSTB driver for rotation and 4:2:2 semi-planar), Not verified on hardware.";
            sw = rw;
            hw = r;
            reset = 0;
        } yuvFmt[3:2];

        field {
            name = "strFmt";
            desc = "Input storage: 0 = semi-planar (Y plane + interleaved Cr/Cb plane, Cr first; Source: Hi3520D board read-back 2026-11-10: NV21/NV61 encodes give correct colors), 1 = planar (separate Y, Cb, Cr planes), 2 = packed (YUYV family). Values 1 and 2: Source: HiSTB driver (register semantics only), confidence MEDIUM (JPGE_STORE_* enum of the HiSTB VENC code; the HiSTB H.264 encoder uses a different numbering, 0 semi-planar, 1 packed, 2 planar). Not verified on hardware for 1 and 2.";
            sw = rw;
            hw = r;
            reset = 0;
        } strFmt[1:0];
    } JPGE_PICFG @ 0x10;

    reg {
        name = "JPGE ECSCFG";
        desc = "Restart interval (entropy-coded segment) configuration. Field positions: Layout: vendor header jpge_reg(r004).h (Hi3520D U-Boot 2010.06 upload), not in the data sheet. Semantics: Source: HiSTB driver (register semantics only), confidence LOW. The HiSTB driver writes ecsSplit = enable and ecsSize = interval in MCUs minus 1 and puts a DRI marker with the same interval in the JFIF header, but its JPGE configuration check refuses restart intervals, so the behavior is undocumented. Open questions (all Not verified on hardware): whether the hardware writes the RSTn markers, and whether it emits one 64-byte-descriptor packet per segment (the descriptor has a last-slice flag at byte 11). The Linux driver supports both outcomes and writes 0 here by default.";

        field {
            name = "ecsSize";
            desc = "Segment size in MCUs minus 1 (the DRI interval minus 1). Source: HiSTB driver (register semantics only), confidence LOW. Not verified on hardware.";
            sw = rw;
            hw = r;
            reset = 0;
        } ecsSize[20:1];

        field {
            name = "ecsSplit";
            desc = "Enable the split into entropy-coded segments (restart intervals). Source: HiSTB driver (register semantics only), confidence LOW. Not verified on hardware.";
            sw = rw;
            hw = r;
            reset = 0;
        } ecsSplit[0:0];
    } JPGE_ECSCFG @ 0x14;

    reg {
        name = "JPGE START";
        desc = "Start one picture: the driver writes 0 and then 1 (HiSTB sequence; Source: Hi3520D board read-back 2026-11-10: every encode starts this way, 3000 back-to-back frames). Whether the bit self-clears: Not verified on hardware. Layout: vendor header jpge_reg(r004).h (Hi3520D U-Boot 2010.06 upload), not in the data sheet.";

        field {
            name = "VStart";
            desc = "[inferred] Start encoding one picture (self-clearing start bit). (vendor header `jpeg_reg.h` (JPGE r004) field `VStart`; access and reset unknown, modelled RW)";
            sw = rw;
            hw = r;
        } VStart[0:0];
    } JPGE_START @ 0x1C;

    reg {
        name = "JPGE VEDIMGSIZE";
        desc = "Picture size minus 1, 13 bits each (maximum 8192). Layout: vendor header jpge_reg(r004).h (Hi3520D U-Boot 2010.06 upload), not in the data sheet. Sizes 64x64, 640x480, 644x484, 1280x720 and 1920x1080 encode with these values (Source: Hi3520D board read-back 2026-11-10). Size limits 64x64 to 8192x8192 in steps of 4: Source: data sheet 6.3.2. Whether sizes that are not a multiple of the MCU are padded correctly by the hardware: Not verified on hardware (the encode completes; the picture content at the edge was not compared).";

        field {
            name = "ImgHeightInPixelsMinus1";
            desc = "[inferred] Picture height in pixels minus 1. (vendor header `jpeg_reg.h` (JPGE r004) field `ImgHeightInPixelsMinus1`; access and reset unknown, modelled RW)";
            sw = rw;
            hw = r;
        } ImgHeightInPixelsMinus1[28:16];

        field {
            name = "ImgWidthInPixelsMinus1";
            desc = "[inferred] Picture width in pixels minus 1. (vendor header `jpeg_reg.h` (JPGE r004) field `ImgWidthInPixelsMinus1`; access and reset unknown, modelled RW)";
            sw = rw;
            hw = r;
        } ImgWidthInPixelsMinus1[12:0];
    } JPGE_VEDIMGSIZE @ 0x20;

    reg {
        name = "JPGE clip THR";
        desc = "[inferred] JPGE clip THR. Not in the data sheet. Source: vendor U-Boot 2010.06 upload `product/hiosd/dec/jpeg_reg.h` = `jpge_reg(r004).h` (GPL-2.0 U-Boot tree, Huawei copyright 2012; github.com/Axl-zhang/hisilicon-hi3520d-uboot), union `U_JPGE_CLIP_THR`, struct offset 0x24 (GPL-2.0; same SDK generation as the Hi3520D, chip not named in the file). Reset value and access type unknown (modelled RW, no reset). Confidence: medium (vendor header for this chip family, not hardware verified).";

        field {
            name = "jcpi_chr_max";
            desc = "[inferred] Chroma clip maximum. (vendor header `jpeg_reg.h` (JPGE r004) field `jcpi_chr_max`; access and reset unknown, modelled RW)";
            sw = rw;
            hw = r;
        } jcpi_chr_max[31:24];

        field {
            name = "jcpi_chr_min";
            desc = "[inferred] Chroma clip minimum. (vendor header `jpeg_reg.h` (JPGE r004) field `jcpi_chr_min`; access and reset unknown, modelled RW)";
            sw = rw;
            hw = r;
        } jcpi_chr_min[23:16];

        field {
            name = "jcpi_luma_max";
            desc = "[inferred] Luma clip maximum. (vendor header `jpeg_reg.h` (JPGE r004) field `jcpi_luma_max`; access and reset unknown, modelled RW)";
            sw = rw;
            hw = r;
        } jcpi_luma_max[15:8];

        field {
            name = "jcpi_luma_min";
            desc = "[inferred] Luma clip minimum. (vendor header `jpeg_reg.h` (JPGE r004) field `jcpi_luma_min`; access and reset unknown, modelled RW)";
            sw = rw;
            hw = r;
        } jcpi_luma_min[7:0];
    } JPGE_CLIP_THR @ 0x24;

    reg {
        name = "JPGE SRCYADDR";
        desc = "Source luma plane address (semi-planar, planar) or the whole picture (packed). Must be 16-byte aligned (Source: HiSTB driver (register semantics only), confidence MEDIUM, alignment check in the HiSTB VENC code). Works as such for semi-planar input (Source: Hi3520D board read-back 2026-11-10). Packed input: Not verified on hardware.";

        field {
            name = "value";
            desc = "[inferred] Register value (the header union has no named bits).";
            sw = rw;
            hw = r;
        } value[31:0];
    } JPGE_SRCYADDR @ 0x30;

    reg {
        name = "JPGE SRCCADDR";
        desc = "Source chroma address. Semi-planar: the interleaved Cr/Cb plane, Cr first (Source: Hi3520D board read-back 2026-11-10: NV21/NV61 give correct colors). Planar: assumed to be the Cb plane (Source: HiSTB driver (register semantics only), confidence MEDIUM, naming in the HiSTB VENC code), Not verified on hardware. 16-byte alignment: Source: HiSTB driver (register semantics only), confidence MEDIUM.";

        field {
            name = "value";
            desc = "[inferred] Register value (the header union has no named bits).";
            sw = rw;
            hw = r;
        } value[31:0];
    } JPGE_SRCCADDR @ 0x34;

    reg {
        name = "JPGE SRCVADDR";
        desc = "Source Cr plane address for planar input (Source: HiSTB driver (register semantics only), confidence MEDIUM, Not verified on hardware). Unused for semi-planar input: the Linux driver writes 0 and encodes correctly (Source: Hi3520D board read-back 2026-11-10).";

        field {
            name = "value";
            desc = "[inferred] Register value (the header union has no named bits).";
            sw = rw;
            hw = r;
        } value[31:0];
    } JPGE_SRCVADDR @ 0x38;

    reg {
        name = "JPGE SSTRIDE";
        desc = "Source line strides in bytes: luma/packed in [15:0], chroma in [31:16] (one chroma stride for Cb and Cr in planar mode). 16-byte multiples: Source: HiSTB driver (register semantics only), confidence MEDIUM. Semi-planar strides equal to bytesperline for both fields work (Source: Hi3520D board read-back 2026-11-10, 640 to 1920 wide). Doubling the chroma stride to read every second chroma line: Source: HiSTB driver (register semantics only), confidence MEDIUM, Not verified on hardware. Layout: vendor header jpge_reg(r004).h (Hi3520D U-Boot 2010.06 upload), not in the data sheet.";

        field {
            name = "SrcCStride";
            desc = "[inferred] Source chroma stride in bytes. (vendor header `jpeg_reg.h` (JPGE r004) field `SrcCStride`; access and reset unknown, modelled RW)";
            sw = rw;
            hw = r;
        } SrcCStride[31:16];

        field {
            name = "SrcYStride";
            desc = "[inferred] Source luma stride in bytes. (vendor header `jpeg_reg.h` (JPGE r004) field `SrcYStride`; access and reset unknown, modelled RW)";
            sw = rw;
            hw = r;
        } SrcYStride[15:0];
    } JPGE_SSTRIDE @ 0x3C;

    reg {
        name = "JPGE STRMADDR";
        desc = "Stream buffer start address (64-byte aligned in the Linux driver). The hardware writes a 64-byte packet descriptor here (dword 0 PacketLen including the descriptor, a multiple of 64; dword 1 InvalidBytes = padding at the end of the packet; byte 11 last-slice flag, dwords 3 channel id: Source: HiSTB driver (register semantics only), confidence MEDIUM for the layout) followed by the entropy-coded scan data and the EOI marker FF D9 (Source: Hi3520D board read-back 2026-11-10: every encode ends with ff d9, the PacketLen/InvalidBytes semantics gave correct file sizes). Layout: vendor header jpge_reg(r004).h (Hi3520D U-Boot 2010.06 upload), not in the data sheet.";

        field {
            name = "value";
            desc = "[inferred] Register value (the header union has no named bits).";
            sw = rw;
            hw = r;
        } value[31:0];
    } JPGE_STRMADDR @ 0x40;

    reg {
        name = "JPGE SRPTRADDR";
        desc = "Stream read/write pointer address (not used by the encoder as a pointer in single-picture mode). The Linux driver points it 16 bytes (SRPTR) or 32 bytes (SWPTR) below the stream address, as the HiSTB driver does. Board finding (Source: Hi3520D board read-back 2026-11-10, functional test): the 32 bytes below the stream address must not hold stale data; with a reused buffer that still held the previous JFIF header the second and later pictures lost their packet descriptor and the scan data started early; clearing those bytes (and the descriptor area) before every job fixed it, a per-job hardware reset did not. What the block reads there is Not verified on hardware. Layout: vendor header jpge_reg(r004).h (Hi3520D U-Boot 2010.06 upload), not in the data sheet.";

        field {
            name = "value";
            desc = "[inferred] Register value (the header union has no named bits).";
            sw = rw;
            hw = r;
        } value[31:0];
    } JPGE_SRPTRADDR @ 0x44;

    reg {
        name = "JPGE SWPTRADDR";
        desc = "Stream read/write pointer address (not used by the encoder as a pointer in single-picture mode). The Linux driver points it 16 bytes (SRPTR) or 32 bytes (SWPTR) below the stream address, as the HiSTB driver does. Board finding (Source: Hi3520D board read-back 2026-11-10, functional test): the 32 bytes below the stream address must not hold stale data; with a reused buffer that still held the previous JFIF header the second and later pictures lost their packet descriptor and the scan data started early; clearing those bytes (and the descriptor area) before every job fixed it, a per-job hardware reset did not. What the block reads there is Not verified on hardware. Layout: vendor header jpge_reg(r004).h (Hi3520D U-Boot 2010.06 upload), not in the data sheet.";

        field {
            name = "value";
            desc = "[inferred] Register value (the header union has no named bits).";
            sw = rw;
            hw = r;
        } value[31:0];
    } JPGE_SWPTRADDR @ 0x48;

    reg {
        name = "JPGE STRMBUFLEN";
        desc = "Stream buffer length in bytes, low 6 bits not stored (the Linux driver writes the length with bits [5:0] clear). Source: HiSTB driver (register semantics only), confidence MEDIUM; Source: Hi3520D board read-back 2026-11-10: values up to a few MiB accept full pictures. The buffer-full interrupt behavior is Not verified on hardware (never reached in the test). Previously: described as 64-byte units; the register value is the byte count with the low bits cleared. Layout: vendor header jpge_reg(r004).h (Hi3520D U-Boot 2010.06 upload), not in the data sheet.";

        field {
            name = "BufferLength";
            desc = "Stream buffer length in bytes (bits [5:0] not stored). Source: HiSTB driver (register semantics only), confidence MEDIUM; Not verified on hardware at the limit.";
            sw = rw;
            hw = r;
        } BufferLength[31:6];
    } JPGE_STRMBUFLEN @ 0x4C;

    reg {
        name = "JPGE PTS0";
        desc = "Frame time stamp word. Observed in the HiSTB driver: written (never read) with the caller's frame PTS in jpge_set_register(), just before OUTSTD and START; its purpose in the hardware (copied into the packet descriptor?) is unknown. The Linux driver does not write it. Source: HiSTB driver (register semantics only), confidence LOW. Not verified on hardware. Layout: vendor header jpge_reg(r004).h (Hi3520D U-Boot 2010.06 upload), not in the data sheet.";

        field {
            name = "value";
            desc = "[inferred] Register value (the header union has no named bits).";
            sw = rw;
            hw = r;
        } value[31:0];
    } JPGE_PTS0 @ 0x70;

