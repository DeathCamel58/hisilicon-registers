    reg {
        name = "JPGE QPT";
        desc = "Quantization tables, 48 words: Y at words 0..15, Cb at 16..31, Cr at 32..47 (Source: HiSTB driver (register semantics only), confidence MEDIUM; the Linux driver writes Y, then the chroma table twice). Packing (HiSTB driver, MEDIUM): word n holds the 8-bit divisors of the natural-order (raster) entries s, s+8, s+16, s+24 in QP0..QP3 with s = (n & 1) * 32 + n / 2. Previously: 'entry 4n+k' (a guess from the field names); the vendor driver does not store the table that way. Board facts (Source: Hi3520D board read-back 2026-11-10): the window reads back 0 after a write (devmem write 0x12345678, read 0), so it is write-only or its read port is not wired (inferred, Not verified on hardware); the encoded size follows the quality setting (5812/6429/9075/11917 bytes at quality 10/50/95/100), so the writes take effect. Only entry 0 and the overall scale are confirmed by those pictures (flat color bars): the position of the other 63 entries is Not verified on hardware until a textured picture is compared with libjpeg at the same quality. Layout: vendor header jpge_reg(r004).h (Hi3520D U-Boot 2010.06 upload), not in the data sheet.";

        field {
            name = "QP3";
            desc = "Quantization divisor of natural-order entry s + 24 (word n = 0..15 of a table, s = (n & 1) * 32 + n / 2). Source: HiSTB driver (register semantics only), confidence MEDIUM; entry 0 and the scale confirmed (Source: Hi3520D board read-back 2026-11-10), the rest Not verified on hardware. Previously: entry 4n+3. Reads back 0 (Source: Hi3520D board read-back 2026-11-10).";
            sw = w;
            hw = r;
        } QP3[31:24];

        field {
            name = "QP2";
            desc = "Quantization divisor of natural-order entry s + 16 (word n = 0..15 of a table, s = (n & 1) * 32 + n / 2). Source: HiSTB driver (register semantics only), confidence MEDIUM; entry 0 and the scale confirmed (Source: Hi3520D board read-back 2026-11-10), the rest Not verified on hardware. Previously: entry 4n+2. Reads back 0 (Source: Hi3520D board read-back 2026-11-10).";
            sw = w;
            hw = r;
        } QP2[23:16];

        field {
            name = "QP1";
            desc = "Quantization divisor of natural-order entry s + 8 (word n = 0..15 of a table, s = (n & 1) * 32 + n / 2). Source: HiSTB driver (register semantics only), confidence MEDIUM; entry 0 and the scale confirmed (Source: Hi3520D board read-back 2026-11-10), the rest Not verified on hardware. Previously: entry 4n+1. Reads back 0 (Source: Hi3520D board read-back 2026-11-10).";
            sw = w;
            hw = r;
        } QP1[15:8];

        field {
            name = "QP0";
            desc = "Quantization divisor of natural-order entry s (word n = 0..15 of a table, s = (n & 1) * 32 + n / 2). Source: HiSTB driver (register semantics only), confidence MEDIUM; entry 0 and the scale confirmed (Source: Hi3520D board read-back 2026-11-10), the rest Not verified on hardware. Previously: entry 4n+0. Reads back 0 (Source: Hi3520D board read-back 2026-11-10).";
            sw = w;
            hw = r;
        } QP0[7:0];
    } JPGE_QPT[48] @ 0x1000 += 0x4;
};

addrmap aHISI_JPGE {
    name = "HiSilicon JPGE (registers not described)";
    desc = "Not described: no register of this block is described; the registers exist only in closed vendor libraries (the MPP binary modules), not in the data sheet or any vendor source in the tree. The 64 KB window is kept only so that the block base address and size exist in the address map (STUB). JPEG encoder (data sheet 6.3, overview/features only): ISO 10918-1 baseline, YCbCr 4:2:0/4:2:2/4:4:4, planar/semi-planar/YUYV input, up to 8192x8192, separate Y/Cb/Cr quantization tables, 8-region OSD overlay. The vendor MPP JPEGE is a closed-source module (openhisilicon `kernel/jpege` is for other SoCs). No register description anywhere. Base address 0x20660000, GIC interrupt ID 73. Listed as an open item in docs/rdl-sweep/PORT-BLOCKS.md.";

    external mem {
        name = "Undocumented register window";
        desc = "The whole 64 KB window of the block. Register layout unknown; placeholder so the block base address and size exist in the map. No registers are described.";
        mementries = 16384;
        memwidth = 32;
        sw = rw;
    } REGS;
};

`endif
