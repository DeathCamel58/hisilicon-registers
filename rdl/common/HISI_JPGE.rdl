    reg {
        name = "JPGE QPT";
        desc = "Quantization tables, 48 words: Y at words 0..15, Cb at 16..31, Cr at 32..47 (Source: HiSTB driver (register semantics only), confidence MEDIUM; the Linux driver writes Y, then the chroma table twice). Packing (HiSTB driver, MEDIUM): word n holds the 8-bit divisors of the natural-order (raster) entries s, s+8, s+16, s+24 in QP0..QP3 with s = (n & 1) * 32 + n / 2. Previously: 'entry 4n+k' (a guess from the field names); the vendor driver does not store the table that way. Board facts (Source: Hi3520D board read-back 2026-11-10): the window reads back 0 after a write (devmem write 0x12345678, read 0), so it is write-only or its read port is not wired (inferred, Not verified on hardware); the encoded size follows the quality setting (5812/6429/9075/11917 bytes at quality 10/50/95/100), so the writes take effect. Only entry 0 and the overall scale are confirmed by those pictures (flat color bars): the position of the other 63 entries is Not verified on hardware until a textured picture is compared with libjpeg at the same quality. Layout: vendor header jpge_reg(r004).h (Hi3520D U-Boot 2010.06 upload), not in the data sheet. Hi3536D vendor module (Hi3536D V100 vendor module hi3536dv100_jpege.ko (SDK V1.0.1.0): static analysis plus execution of its register writer under qemu-arm on a RAM window, 2026-11-22 (shows what the vendor PROGRAMS, not what the silicon does)): the module scales three 64-byte tables (Y, Cb, Cr) from its base tables (the T.81 example tables by default; user tables are used unchanged at quality 50) with the plain IJG formula, factor = 5000 / q for q < 50 else 200 - 2q, entry = clamp((base * factor + 50) / 100, 1, 255), for every quality 1..99 (the vendor interface limits Qfactor to 1..99; at 100 and above the module would use factor 2, which is unreachable). The three tables are written as 16 words each at words 0..15 (Y), 16..31 (Cb), 32..47 (Cr), each word = four consecutive bytes of the table kept in COLUMN-major (transposed natural) order, low byte first. This packing is algebraically and numerically identical to the packing of this description (word n = natural entries s, s+8, s+16, s+24 with s = (n & 1) * 32 + n / 2): verified for q = 0..101 against the module output, zero differences. No dead-zone tables or other quantization registers are programmed. Confidence PROVEN for the programmed words.";

        field {
            name = "QP3";
            desc = "Quantization divisor of natural-order entry s + 24 (word n = 0..15 of a table, s = (n & 1) * 32 + n / 2). Source: HiSTB driver (register semantics only), confidence MEDIUM; entry 0 and the scale confirmed (Source: Hi3520D board read-back 2026-11-10), the rest Not verified on hardware. Previously: entry 4n+3. Reads back 0 (Source: Hi3520D board read-back 2026-11-10).";
            sw = w;
            hw = r;
        } QP3[31:24];

        field {
            name = "QP2";
            desc = "Quantization divisor of natural-order entry s + 16 (word n = 0..15 of a table, s = (n & 1) * 32 + n / 2). Source: HiSTB driver (register semantics only), confidence MEDIUM; entry 0 and the scale confirmed (Source: Hi3520D board read-back 2026-11-10), the rest Not verified on hardware. Previously: entry 4n+2. Reads back 0 (Source: Hi3520D board read-back 2026-11-10).";
            sw = w;
            hw = r;
        } QP2[23:16];

        field {
            name = "QP1";
            desc = "Quantization divisor of natural-order entry s + 8 (word n = 0..15 of a table, s = (n & 1) * 32 + n / 2). Source: HiSTB driver (register semantics only), confidence MEDIUM; entry 0 and the scale confirmed (Source: Hi3520D board read-back 2026-11-10), the rest Not verified on hardware. Previously: entry 4n+1. Reads back 0 (Source: Hi3520D board read-back 2026-11-10).";
            sw = w;
            hw = r;
        } QP1[15:8];

        field {
            name = "QP0";
            desc = "Quantization divisor of natural-order entry s (word n = 0..15 of a table, s = (n & 1) * 32 + n / 2). Source: HiSTB driver (register semantics only), confidence MEDIUM; entry 0 and the scale confirmed (Source: Hi3520D board read-back 2026-11-10), the rest Not verified on hardware. Previously: entry 4n+0. Reads back 0 (Source: Hi3520D board read-back 2026-11-10).";
            sw = w;
            hw = r;
        } QP0[7:0];
    } JPGE_QPT[48] @ 0x1000 += 0x4;
};

addrmap aHISI_JPGE {
    name = "HiSilicon JPGE (window only, registers not described)";
    desc = "Window only (GAP RECORD, no invented registers): the 64 KB JPEG encoder window exists in the data sheet memory map but no register of this chip's JPEG encoder is described anywhere in the local corpus (no data sheet register table, no vendor module, no vendor source). Instantiated by the Hi3516 V100 only (JPEG window 0x20610000, 64 KB, interrupt 54, clock/reset PERI_CRG19 [3:2] clock frequency, [1] clock gate, [0] soft reset, data sheet 6.3). The Hi3516 V100 data sheet 6.3 JPGE feature list (baseline ISO 10918-1, YCbCr 4:2:0/4:2:2/4:4:4, planar/semi-planar/packed YUYV input, 32x32 to 8192x8192 in steps of 4, one quantization table per component, up to 8 OSD regions with 129 alpha levels, interrupt, software configures the quantization table and handles the interrupt) is the same as the Hi3520D one, which suggests the Hi3520D register layout (eHISI_JPGE above) but that is an INFERENCE from a feature list, confidence LOW, and is not recorded as registers; a hardware read of JPGE_VERSION (offset 0xFC) would confirm it. See docs/rdl-campaign/jpge-crosschip.md.";

    external mem {
        name = "Undocumented register window";
        desc = "The whole 64 KB window of the block. Register layout unknown; placeholder so the block base address and size exist in the map. No registers are described.";
        mementries = 16384;
        memwidth = 32;
        sw = rw;
    } REGS;
};

`endif
