    } JPGE_PTS3 @ 0x7C;

    reg {
        name = "JPGE TIMEOUT";
        desc = "Hardware encode time-out threshold (name only). Not accessed by the HiSTB driver (PICFG timeoutEn is never set there) and not by the Linux driver, which uses a software watchdog; unit and purpose unknown. Source: HiSTB driver (register semantics only), confidence LOW. Not verified on hardware. Layout: vendor header jpge_reg(r004).h (Hi3520D U-Boot 2010.06 upload), not in the data sheet. Hi3536D vendor module (Hi3536D V100 vendor module hi3536dv100_jpege.ko (SDK V1.0.1.0): static analysis plus execution of its register writer under qemu-arm on a RAM window, 2026-11-22 (shows what the vendor PROGRAMS, not what the silicon does)): never written (JPEGU_SetTimeOut and JPEGU_GetTimeOut are empty functions); PICFG timeoutEn is still set to 1. Board 2026-11-23 (Hi3536D V100, NBD80XXS, source: board, confidence HIGH): reads 0 after the reset and is never written by the vendor stack (the vendor sets the PICFG time-out enable and leaves the limit at 0); the hardware time-out was not exercised beyond that.";

        field {
            name = "value";
            desc = "[inferred] Register value (the header union has no named bits).";
            sw = rw;
            hw = r;
        } value[31:0];
    } JPGE_TIMEOUT @ 0x80;

    reg {
        name = "JPGE TIMER";
        desc = "Hardware encode timer (name only). Not accessed by the HiSTB driver or the Linux driver; unit and purpose unknown. Source: HiSTB driver (register semantics only), confidence LOW. Not verified on hardware. Layout: vendor header jpge_reg(r004).h (Hi3520D U-Boot 2010.06 upload), not in the data sheet. Hi3536D vendor module (Hi3536D V100 vendor module hi3536dv100_jpege.ko (SDK V1.0.1.0): static analysis plus execution of its register writer under qemu-arm on a RAM window, 2026-11-22 (shows what the vendor PROGRAMS, not what the silicon does)): read once, for a debug print (JPEGU_OutputDebugInfo); never written. Board 2026-11-23 (Hi3536D V100, NBD80XXS, source: board, confidence HIGH): reads 0 after the reset; after a 320 x 240 4:2:0 encode it reads 0x00039E5B, 0x00039E44, 0x00039ECE (about 0.24 million ticks, stable from run to run), so it is the tick count of the last picture; with PICFG timeoutEn (bit 18) set the end of the picture additionally raises RAWINT bit 2 (0x4, masked in INTSTAT because INTMASK bit 2 is 0).";

        field {
            name = "value";
            desc = "[inferred] Register value (the header union has no named bits).";
            sw = rw;
            hw = r;
        } value[31:0];
    } JPGE_TIMER @ 0x84;

    reg {
        name = "JPGE OUTSTD";
        desc = "AXI outstanding request count. Reset 0 (Source: Hi3520D board read-back 2026-11-10); the HiSTB driver and the Linux driver write 2 and the encodes work. Other values: Not verified on hardware. Layout: vendor header jpge_reg(r004).h (Hi3520D U-Boot 2010.06 upload), not in the data sheet. Hi3536D vendor module (Hi3536D V100 vendor module hi3536dv100_jpege.ko (SDK V1.0.1.0): static analysis plus execution of its register writer under qemu-arm on a RAM window, 2026-11-22 (shows what the vendor PROGRAMS, not what the silicon does)): the HAL init writes outstdNum = 1 (read-modify-write of bits [3:0]); the value is never changed afterwards.";

        field {
            name = "outstdNum";
            desc = "AXI outstanding request count (reset 0: Source: Hi3520D board read-back 2026-11-10; written 2 by the drivers).";
            sw = rw;
            hw = r;
            reset = 0;
        } outstdNum[3:0];
    } JPGE_OUTSTD @ 0xA4;

    reg {
        name = "JPGE VERSION";
        desc = "Version word. Reads 0x56325234 (ASCII 'V2R4') on the Hi3520D (Source: Hi3520D board read-back 2026-11-10); also 0x56325234 on the Hi3518E V200 (Night Owl camera, 2026-11-11, PERI_CRG24 clock on, CRG restored; +0x010 reads 0x0D880000, +0x030..+0x048 0xFFFFFFFF, all else 0); matches the r004 layout name of the vendor header. Read-only is assumed from the name (Not verified on hardware). Layout: vendor header jpge_reg(r004).h (Hi3520D U-Boot 2010.06 upload), not in the data sheet. Hi3536D vendor module (Hi3536D V100 vendor module hi3536dv100_jpege.ko (SDK V1.0.1.0): static analysis plus execution of its register writer under qemu-arm on a RAM window, 2026-11-22 (shows what the vendor PROGRAMS, not what the silicon does)): the module never reads this register and has no code path that depends on it (its chip-version variable is not used); the Linux driver is the only reader.";

        field {
            name = "value";
            desc = "Version, 0x56325234 = 'V2R4' (Source: Hi3520D board read-back 2026-11-10).";
            sw = r;
            hw = r;
            reset = 0x56325234;
        } value[31:0];
    } JPGE_VERSION @ 0xFC;

    reg {
        name = "VPP configuration";
        desc = "[inferred] VPP configuration. Not in the data sheet. Source: vendor U-Boot 2010.06 upload `product/hiosd/dec/jpeg_reg.h` = `jpge_reg(r004).h` (GPL-2.0 U-Boot tree, Huawei copyright 2012; github.com/Axl-zhang/hisilicon-hi3520d-uboot), union `U_JPGE_CFG`, struct offset 0x500 (GPL-2.0; same SDK generation as the Hi3520D, chip not named in the file). Reset value and access type unknown (modelled RW, no reset). Confidence: medium (vendor header for this chip family, not hardware verified). Hi3536D vendor module (Hi3536D V100 vendor module hi3536dv100_jpege.ko (SDK V1.0.1.0): static analysis plus execution of its register writer under qemu-arm on a RAM window, 2026-11-22 (shows what the vendor PROGRAMS, not what the silicon does)): for a plain encode (no overlay) the module does a read-modify-write of this register that CLEARS osdEn (bit 5) on every picture and writes nothing else of the VPP window; with an overlay it sets osdEn and programs 0x510-0x5C0 as described there. Board read 2026-11-22 (Hi3536D NBD80XXS, before and after the first encode): reads 0. Confidence PROVEN. Board 2026-11-23 (Hi3536D V100, NBD80XXS, source: board, confidence HIGH): the whole window 0x500 to 0x56C reads 0 after the reset and 0x590 to 0x5D0 reads 0, 0x570 to 0x58C (the region DMA address words) read 0xFFFFFFFF, before and after encodes: no overlay state is left in the block.";

        field {
            name = "osdEn";
            desc = "[inferred] OSD overlay enable. (vendor header `jpeg_reg.h` (JPGE r004) field `osdEn`; access and reset unknown, modelled RW)";
            sw = rw;
            hw = r;
        } osdEn[5:5];
    } VPP_CFG @ 0x500;

