            reset = 0x0;
        } clk_out_sel[1:0];
    } RTC_CLK @ 0x17;

    reg {
        name = "RTC reset control register";
        desc = "RTC_POR_N is an RTC reset control register.

Soft reset: write 0, wait 30 ms (DS 3.9.4.2); after reset all RTC registers return to their defaults and must be re-initialised. The bit sets itself back to 1.

Data sheet 3.9.7 RTC_POR_N (internal address 0x18, printed page 3-154, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 30652).";
        regwidth = 8;

        field {
            name = "rtc_por_n";
            desc = "RTC reset. This field is automatically set to 1 after the RTC is successfully reset. 0: reset";
            sw = rw;
            hw = r;
            reset = 0x1;
        } rtc_por_n[0:0];
    } RTC_POR_N @ 0x18;

    reg {
        name = "Upper 4-bit external frequency divider register";
        desc = "SDM_COEF_OUSIDE_H is an upper 4-bit external frequency divider register.

The data sheet names the registers 0x51/0x52 `Sdm_coef_ouside_h/l` (sic); the register names here are the summary-table spelling, the field of the _H register is `Sdm_coef_ouside_h` as in the bit table.

Data sheet 3.9.7 SDM_COEF_OUSIDE_H (internal address 0x51, printed page 3-155, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 30686).";
        regwidth = 8;

        field {
            name = "Sdm_coef_ouside_h";
            desc = "Upper four bits of the frequency divider";
            sw = rw;
            hw = r;
            reset = 0x8;
        } Sdm_coef_ouside_h[3:0];
    } SDM_COEF_OUSIDE_H @ 0x51;

    reg {
        name = "Lower 8-bit external frequency divider register";
        desc = "SDM_COEF_OUSIDE_L is a lower 8-bit external frequency divider register.

Read/write the upper four bits (0x51) and then the lower eight bits (0x52) consecutively. Divider = (f - 32700) x 30.52 where f is the external crystal frequency (about 32700..32800 Hz). Reset 0x81B (= 32768 Hz).

Data sheet 3.9.7 SDM_COEF_OUSIDE_L (internal address 0x52, printed page 3-155, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 30708).";
        regwidth = 8;

        field {
            name = "sdm_coef_ouside_l";
            desc = "Lower eight bits of the frequency divider Note: When clock divider registers (addresses of 0x51 and 0x52) are read or written, you need to read or write to the upper four bits and then the lower eight bits continuously. The clock divider is calculated as follows: (f - 32700) x 30.52. f indicates the oscillation frequency of the external crystal and ranges from 32700 to 32799.";
            sw = rw;
            hw = r;
            reset = 0x1B;
        } sdm_coef_ouside_l[7:0];
    } SDM_COEF_OUSIDE_L @ 0x52;

    reg {
        name = "64-bit user register 1";
        desc = "USER_REGISTER1 is 64-bit user register 1.

Data sheet 3.9.7 USER_REGISTER1 (internal address 0x53, printed page 3-155, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 30732).";
        regwidth = 8;

        field {
            name = "user_register1";
            desc = "64-bit user register 1 corresponding to bit[7:0]";
            sw = rw;
            hw = r;
            reset = 0x0;
        } user_register1[7:0];
    } USER_REGISTER1 @ 0x53;

    reg {
        name = "64-bit user register 2";
        desc = "USER_REGISTER2 is 64-bit user register 2.

Data sheet 3.9.7 USER_REGISTER2 (internal address 0x54, printed page 3-156, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 30759).";
        regwidth = 8;

