    } RTC_MR_S @ 0x7;

    reg {
        name = "Match value register for the RTC minute counter";
        desc = "RTC_MR_M is a match value register for the RTC minute counter.

Data sheet 3.9.7 RTC_MR_M (internal address 0x08, printed page 3-147, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 30193).";
        regwidth = 8;

        field {
            name = "rtc_mr_m";
            desc = "Match value of the RTC minute counter The value range is 0-59.";
            sw = rw;
            hw = r;
            reset = 0x3F;
        } rtc_mr_m[5:0];
    } RTC_MR_M @ 0x8;

    reg {
        name = "Match value register for the RTC hour counter";
        desc = "RTC_MR_H is a match value register for the RTC hour counter.

Data sheet 3.9.7 RTC_MR_H (internal address 0x09, printed page 3-147, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 30219).";
        regwidth = 8;

        field {
            name = "rtc_mr_h";
            desc = "Match value of the RTC hour counter The value range is 0-23.";
            sw = rw;
            hw = r;
            reset = 0x1F;
        } rtc_mr_h[4:0];
    } RTC_MR_H @ 0x9;

    reg {
        name = "Lower-8-bit match value register for the RTC day counter";
        desc = "RTC_MR_D_L is a lower-8-bit match value register for the RTC day counter.

Data sheet 3.9.7 RTC_MR_D_L (internal address 0x0A, printed page 3-148, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 30251).";
        regwidth = 8;

        field {
            name = "rtc_mr_d_l";
            desc = "Lower eight bits of the match value of the RTC day counter. This field works with RTC_MR_D_H to indicate the matched day. The day range is 0-65535.";
            sw = rw;
