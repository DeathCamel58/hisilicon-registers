    reg {
        name = "Match value register for the RTC second counter";
        desc = "RTC_MR_S is a match value register for the RTC second counter.

Data sheet 3.9.7 RTC_MR_S (internal address 0x07, printed page 3-146, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 30161).";
        regwidth = 8;

