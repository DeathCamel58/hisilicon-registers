            hw = r;
            reset = 0x0;
        } user_register2[7:0];
    } USER_REGISTER2 @ 0x54;

    reg {
        name = "64-bit user register 3";
        desc = "USER_REGISTER3 is 64-bit user register 3.

Data sheet 3.9.7 USER_REGISTER3 (internal address 0x55, printed page 3-156, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 30778).";
        regwidth = 8;

