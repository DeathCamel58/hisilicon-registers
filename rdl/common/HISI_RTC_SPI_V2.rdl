    reg {
        name = "Upper-8-bit match value register for the RTC day counter";
        desc = "RTC_MR_D_H is an upper-8-bit match value register for the RTC day counter.

Data sheet 3.9.7 RTC_MR_D_H (internal address 0x0B, printed page 3-148, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 30272).";
        regwidth = 8;

        field {
            name = "rtc_mr_d_h";
            desc = "Upper eight bits of the match value of the RTC day counter. This field works with RTC_MR_D_L to indicate the matched day. The day range is 0-65535.";
