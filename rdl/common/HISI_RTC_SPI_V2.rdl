    reg {
        name = "RTC output clock select register";
        desc = "RTC_CLK is an RTC output clock select register.

Test clock output select; 1x selects the 1 Hz clock.

Data sheet 3.9.7 RTC_CLK (internal address 0x17, printed page 3-154, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 30622).";
        regwidth = 8;

        enum RTC_CLK_clk_out_sel_enum {
            CRYSTAL_OSCILLATOR_CLOCK = 0 { name = "Crystal Oscillator Clock"; desc = "crystal oscillator clock"; };
            CORRECTED_100_HZ = 1 { name = "Corrected 100 Hz"; desc = "corrected 100 Hz clock 1x: 1 Hz clock"; };
        };

        field {
            name = "clk_out_sel";
            desc = "Output test clock of the RTC";
            sw = rw;
            hw = r;
