    reg {
        name = "Upper-8-bit configured value register for the RTC day counter";
        desc = "RTC_LR_D_H is an upper-8-bit configured value register for the RTC day counter.

Data sheet 3.9.7 RTC_LR_D_H (internal address 0x11, printed page 3-151, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 30443).";
        regwidth = 8;

