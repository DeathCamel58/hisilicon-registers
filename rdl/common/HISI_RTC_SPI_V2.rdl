`ifndef HISI_RTC_SPI_V2_RDL
`define HISI_RTC_SPI_V2_RDL

regfile eHISI_RTC_SPI_INTERNAL_V2 {
    name = "HiSilicon SPI-bridged RTC (internal registers, Hi3518E V20X layout)";
    desc = "
    Internal (SPI-bridged) register space of the Hi3518E V20X / Hi3516C V200 RTC (data sheet 3.9.7, Table 3-21): 35 byte-wide registers. The offsets are **SPI internal addresses** (`spi_add`,
    0-127, of `SPI_RW` in the APB part `eHISI_RTC_SPI`, which is identical to the Hi3520D one: same SPI_CLK_DIV 0x3B reset, SPI_RW layout and temperature-sensor interface 0x80..0xA0, checked
    register by register against this data sheet); this is not a CPU address space. It differs from the Hi3520D map `eHISI_RTC_SPI_INTERNAL`: **this data sheet documents only 0x00-0x18 and
    0x51-0x5A** - the temperature-compensation registers 0x19-0x50 of the Hi3520D (LUT1..47, TEMP_SEL, ...) are not documented for this SoC (they are not modelled here; the SDM_COEF registers at 0x51/0x52
    are) - and it adds `rtc_lock_bypass` / `rtc_lock` to RTC_LORD and eight 8-bit `USER_REGISTERn` (a 64-bit user data area that survives as long as the RTC supply: 0x53-0x5A).

    Counter: RTC_10MS_COUNT 0x00 .. RTC_D_COUNT_H 0x05 (read-only 40-bit up counter at 100 Hz: 10 ms [6:0] 0-99, seconds 0-59, minutes 0-59, hours 0-23, days 16-bit). Match (alarm) value RTC_MR_* 0x06-0x0B
    (reset all ones), load value RTC_LR_* 0x0C-0x11, loaded into the counter by RTC_LORD.rtc_load = 1 (wait 5 ms). Interrupts: RTC_IMSC 0x13, RTC_INT_CLR 0x14, RTC_MSC_INT 0x15, RTC_RAW_INT 0x16; the
    interrupt is VIC line 2 (shared with the temperature-capture interrupt, \"RTC/Temper_Cap\", Table 3-8). RTC soft reset: write 0 to RTC_POR_N and wait 30 ms; the CRG soft reset of the APB side is PERI_CRG57 `rtc_srst_req` [2].

    **SPI_RW protocol (DS 3.9.4.5):** wait until SPI_RW bit 31 (`spi_busy`) is 0; write `spi_start` (bit 24) | `spi_rw` (bit 23: 0 = write, 1 = read) | `spi_add` [22:16] | `spi_wdata` [7:0]. Example write of 0x10 to
    RTC_MR_10MS (0x06): write 0x01060010. A read of internal address 0x06 is started with 0x01860000 (the data sheet text says `spi_rw is 0` for this read example but the value 0x01860000 has bit 23 set,
    i.e. spi_rw = 1: DS text error); then poll `spi_busy` and take SPI_RW[15:8].

    Source: data sheet 3.9.5-3.9.7 (`hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` lines 29466-31113). Names/offsets/resets cross-checked with the Hi3520D internal regfile for the common registers 0x00-0x18 (all agree except the RTC_LORD and
    interrupt field names). Data-sheet only, not hardware verified; no vendor driver source (`hi_rtc` is closed-source MPP code).
    ";

    reg {
        name = "Count value register for the RTC 10 ms counter";
        desc = "RTC_10MS_COUNT is a count value register for the RTC 10 ms counter.

Data sheet 3.9.7 RTC_10MS_COUNT (internal address 0x00, printed page 3-143, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 29969).";
        regwidth = 8;

        field {
            name = "rtc_10ms_count";
            desc = "RTC 10 ms counter value. It indicates the currently counted time. Its unit is 10 ms. The value range is 0-99.";
            sw = r;
            hw = w;
            reset = 0x0;
        } rtc_10ms_count[6:0];
    } RTC_10MS_COUNT @ 0x0;

    reg {
        name = "Count value register for the RTC second counter";
        desc = "RTC_S_COUNT is a count value register for the RTC second counter.

Data sheet 3.9.7 RTC_S_COUNT (internal address 0x01, printed page 3-143, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 29994).";
        regwidth = 8;

        field {
            name = "rtc_s_count";
            desc = "RTC second counter value. It indicates the currently counted seconds. The value range is 0-59.";
            sw = r;
            hw = w;
            reset = 0x0;
        } rtc_s_count[5:0];
    } RTC_S_COUNT @ 0x1;

    reg {
        name = "Count value register for the RTC minute counter";
        desc = "RTC_M_COUNT is a count value register for the RTC minute counter.

Data sheet 3.9.7 RTC_M_COUNT (internal address 0x02, printed page 3-144, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 30027).";
        regwidth = 8;

        field {
            name = "rtc_m_count";
            desc = "RTC minute counter value. It indicates the currently counted minutes. The value range is 0-59.";
            sw = r;
            hw = w;
            reset = 0x0;
        } rtc_m_count[5:0];
    } RTC_M_COUNT @ 0x2;

    reg {
        name = "Count value register for the RTC";
        desc = "RTC_H_COUNT is a count value register for the RTC hour counter.

Data sheet 3.9.7 RTC_H_COUNT (internal address 0x03, printed page 3-144, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 30053).";
        regwidth = 8;

