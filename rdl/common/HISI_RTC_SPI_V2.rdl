        name = "Match value register for the RTC 10 ms counter";
        desc = "RTC_MR_10MS is a match value register for the RTC 10 ms counter.

Data sheet 3.9.7 RTC_MR_10MS (internal address 0x06, printed page 3-146, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 30135).";
        regwidth = 8;

