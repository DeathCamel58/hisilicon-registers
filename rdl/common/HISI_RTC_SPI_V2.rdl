// Top-level wrapper so the internal address space can be elaborated and exported on its own (not instantiated in any SoC: the registers have no CPU address).
addrmap aHISI_RTC_SPI_INTERNAL_V2 {
    name = "HiSilicon SPI-bridged RTC internal address space (Hi3518E V20X)";
    desc = "Internal 8-bit register space of the RTC, reached only through SPI_RW (see eHISI_RTC_SPI). Offsets are the SPI internal addresses.";
    eHISI_RTC_SPI_INTERNAL_V2 INTERNAL @ 0x0;
};

