        name = "Upper-8-bit count value register for the RTC day counter";
        desc = "RTC_D_COUNT_H is an upper-8-bit count value register for the RTC day counter.

Data sheet 3.9.7 RTC_D_COUNT_H (internal address 0x05, printed page 3-145, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 30109).";
        regwidth = 8;

        field {
            name = "rtc_d_count_h";
            desc = "Upper eight bits of the RTC day counter value. This field works with RTC_D_COUNT_L to indicate the currently counted day. The day range is 0-65535.";
            sw = r;
            hw = w;
            reset = 0x0;
        } rtc_d_count_h[7:0];
