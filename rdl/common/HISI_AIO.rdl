`ifndef HISI_AIO_RDL
`define HISI_AIO_RDL


regfile eHISI_AIO {
    name = "HiSilicon audio input/output interface";
    desc = "
    HiSilicon audio input/output interface (AIO) at 0x20650000, GIC interrupt ID 47 (SPI 15): one audio input port (AIP: 2/4/8/16-channel PCM or I2S, 8- or 16-bit multi-channel, 8-32 bit single) and two output ports (AOP0: pads AIO_SD_TX/WS_TX/BCLK_TX; AOP1: I2S master wired inside the chip to the HDMI transmitter, no pads). I2S or PCM, master or slave (AOP1 master only), 8-192 kHz.

    Data moves by the block's own DMA between cyclic buffers in DDR and the port: there is no general DMA controller involved. Per port: BUF_SADDR (multiple of 128), BUF_SIZE (multiple of 128, bytes, 24 bits), BUF_WPTR, BUF_RPTR (byte offsets into the buffer, 24 bits), an almost-full/almost-empty threshold, TRANS_SIZE (a transfer-complete interrupt every TRANS_SIZE bytes, the *_TMP registers latch the pointers at that interrupt), INT_ENA/RAW/STATUS/CLR, STOP (enable and stop_done). The producer owns the write pointer (the block for AIP, software for AOP) and the consumer the read pointer; software must keep at least 32 bytes of free space when it advances an AOP write pointer and must queue at least 128 bytes before enabling an AOP (data sheet 13.4). A port must be stopped (enable 0, stop_done 1) before its soft reset. All three ports share the one interrupt line, AIO_INT_STATUS tells which port fired.

    Register layout: global interrupt registers at 0x0, AIP registers at 0x1000.., AOP0 at 0x2000.., AOP1 at 0x2100.. (data sheet Table 13-1). Registers are from the Hi3520D/Hi3515A/Hi3515C data sheet chapter 13.5/13.6.

    Clocks and resets are NOT in this block, they are in the CRG (offsets from the CRG base 0x20030000, data sheet 3.2.3/3.2.4 and 13.4): PERI_CRG32/33/34 (0x80/0x84/0x88) = AIP/AOP0/AOP1 MCLK fractional divider, 24-bit ckcfg = MCLK / 675 MHz * 2^27 (MCLK at most 62.5 MHz; example: 12.288 MHz = 0x25485F); PERI_CRG32 bit 24 aip_clk_sel (0 = AIP shares the AOP0 BCLK/FS, i.e. 4-wire codec; 1 = own); PERI_CRG35 (0x8C) = AIO bus clock gate (bit 1) and bus soft reset (bit 0): the AIO registers must not be accessed while the bus clock is off; PERI_CRG36/37/38 (0x90/0x94/0x98) = AIP/AOP0/AOP1 fsclk_div [14:12], bclk_div [11:8], bclk_sel [4] (1 = internal master clock), bclkout/bclk polarity [3:2], cken [1] (AIP cken also gates the AIO_MCLK pad) and srst_req [0] (the data sheet says: no separate soft reset is needed after a normal system reset). AOP1 always needs PERI_CRG34/38 programmed as master because the HDMI transmitter takes its clocks from it. The AIO pads are muxed through muxctrl_reg5-11 (IO_CONFIG 0x14-0x2C, function 0 = AIO; AIO_MCLK doubles as BOOT_SEL and AIO_SD_TX as JTAG_SEL at reset).

    Vendor cross-check (2026-11-11, static analysis only, nothing executed: OpenIPC copy of hi3520D_sio.ko, V = vendor module): the module ioremaps only 0x20650000 size 0x10000, programs only registers documented here (observed offsets 0x1000-0x1038 and 0x2028/0x202C by a scripted scan, the AOP0/AOP1 copies use the same HAL with a port index), writes AIP_INF_ATTRI with bit 12 set (the reserved must-be-1 field) and keeps the reserved bits of AIP_CTRL at 0x3210, and does the CRG programming through the sys module (command numbers 0x1D-0x22, 0x2B), not in the AIO module. Vendor MCLK values (confidence HIGH, same formula as the data sheet): 0x0025485F (12.288 MHz = 256 x 48 kHz) for 8/12/16/24/32/48 kHz, 0x002240E4 (11.2896 MHz = 256 x 44.1 kHz) for 11.025/22.05/44.1 kHz, 0x0018DAEA (8.192 MHz = 256 x 32 kHz) in one special case; BCLK/MCLK and FS/BCLK dividers follow the table in data sheet 3.2.3. No undocumented AIO register was seen, so no UNK stubs. Audit record: docs/rdl-campaign/aio.md. Not verified on hardware.
    ";

    reg {
        name = "AIO global interrupt enable register";
        desc = "AIO_INT_ENA is an AIO global interrupt enable register.

Source: data sheet (Hi3520D/Hi3515A/Hi3515C user guide, 13.6 AIO_INT_ENA, offset 0x0, printed page 13-12), confidence HIGH: offset, fields, access and reset compared by script with the Chinese issue 02 edition on 2026-11-11, no difference. Not verified on hardware.";

        enum AIO_INT_ENA_aop1_int_ena_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "aop1_int_ena";
            desc = "AOP1 interrupt enable.";
            sw = rw;
            hw = r;
            encode = AIO_INT_ENA_aop1_int_ena_enum;
            reset = 0x0;
        } aop1_int_ena[17:17];

        enum AIO_INT_ENA_aop0_int_ena_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "aop0_int_ena";
            desc = "AOP0 interrupt enable.";
            sw = rw;
            hw = r;
            encode = AIO_INT_ENA_aop0_int_ena_enum;
            reset = 0x0;
        } aop0_int_ena[16:16];

        enum AIO_INT_ENA_aip_int_ena_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "aip_int_ena";
            desc = "AIP interrupt enable.";
            sw = rw;
            hw = r;
            encode = AIO_INT_ENA_aip_int_ena_enum;
            reset = 0x0;
        } aip_int_ena[0:0];
    } AIO_INT_ENA @ 0x0;

    reg {
        name = "AIO global interrupt status register";
        desc = "AIO_INT_STATUS is an AIO global interrupt status register.

Source: data sheet (Hi3520D/Hi3515A/Hi3515C user guide, 13.6 AIO_INT_STATUS, offset 0x4, printed page 13-13), confidence HIGH: offset, fields, access and reset compared by script with the Chinese issue 02 edition on 2026-11-11, no difference. Not verified on hardware.";

        enum AIO_INT_STATUS_aop1_int_status_enum {
            NO_INTERRUPT_GENERATED = 0 { name = "No Interrupt Generated"; desc = "No interrupt is generated."; };
            INTERRUPT_GENERATED = 1 { name = "Interrupt Generated"; desc = "An interrupt is generated."; };
        };

        field {
            name = "aop1_int_status";
            desc = "AOP1 interrupt status.";
            sw = r;
            hw = w;
            encode = AIO_INT_STATUS_aop1_int_status_enum;
            reset = 0x0;
        } aop1_int_status[17:17];

        enum AIO_INT_STATUS_aop0_int_status_enum {
            NO_INTERRUPT_GENERATED = 0 { name = "No Interrupt Generated"; desc = "No interrupt is generated."; };
            INTERRUPT_GENERATED = 1 { name = "Interrupt Generated"; desc = "An interrupt is generated."; };
        };

        field {
            name = "aop0_int_status";
            desc = "AOP0 interrupt status.";
            sw = r;
            hw = w;
            encode = AIO_INT_STATUS_aop0_int_status_enum;
            reset = 0x0;
        } aop0_int_status[16:16];

        enum AIO_INT_STATUS_aip_int_status_enum {
            NO_INTERRUPT_GENERATED = 0 { name = "No Interrupt Generated"; desc = "No interrupt is generated."; };
            INTERRUPT_GENERATED = 1 { name = "Interrupt Generated"; desc = "An interrupt is generated."; };
        };

        field {
            name = "aip_int_status";
            desc = "AIP interrupt status.";
            sw = r;
            hw = w;
            encode = AIO_INT_STATUS_aip_int_status_enum;
            reset = 0x0;
        } aip_int_status[0:0];
    } AIO_INT_STATUS @ 0x4;

    reg {
        name = "Raw AIO global interrupt register";
        desc = "AIO_INT_RAW is a raw AIO global interrupt register.

Source: data sheet (Hi3520D/Hi3515A/Hi3515C user guide, 13.6 AIO_INT_RAW, offset 0x8, printed page 13-14), confidence HIGH: offset, fields, access and reset compared by script with the Chinese issue 02 edition on 2026-11-11, no difference. Not verified on hardware.";

        enum AIO_INT_RAW_aop1_int_raw_enum {
            NO_RAW_INTERRUPT = 0 { name = "No Raw Interrupt"; desc = "No raw interrupt is generated."; };
            RAW_INTERRUPT_GENERATED = 1 { name = "Raw Interrupt Generated"; desc = "A raw interrupt is generated."; };
        };

        field {
            name = "aop1_int_raw";
            desc = "Raw AOP1 interrupt status.";
            sw = r;
            hw = w;
            encode = AIO_INT_RAW_aop1_int_raw_enum;
            reset = 0x0;
        } aop1_int_raw[17:17];

        enum AIO_INT_RAW_aop0_int_raw_enum {
            NO_RAW_INTERRUPT = 0 { name = "No Raw Interrupt"; desc = "No raw interrupt is generated."; };
            RAW_INTERRUPT_GENERATED = 1 { name = "Raw Interrupt Generated"; desc = "A raw interrupt is generated."; };
        };

        field {
            name = "aop0_int_raw";
            desc = "Raw AOP0 interrupt status.";
            sw = r;
            hw = w;
            encode = AIO_INT_RAW_aop0_int_raw_enum;
            reset = 0x0;
        } aop0_int_raw[16:16];

        enum AIO_INT_RAW_aip_int_raw_enum {
            NO_RAW_INTERRUPT = 0 { name = "No Raw Interrupt"; desc = "No raw interrupt is generated."; };
            RAW_INTERRUPT_GENERATED = 1 { name = "Raw Interrupt Generated"; desc = "A raw interrupt is generated."; };
        };

        field {
            name = "aip_int_raw";
            desc = "Raw AIP interrupt status.";
            sw = r;
            hw = w;
            encode = AIO_INT_RAW_aip_int_raw_enum;
            reset = 0x0;
        } aip_int_raw[0:0];
    } AIO_INT_RAW @ 0x8;

    reg {
        name = "AIP attribute configuration register";
        desc = "AIP_INF_ATTRI is an AIP attribute configuration register.

Source: data sheet (Hi3520D/Hi3515A/Hi3515C user guide, 13.6 AIP_INF_ATTRI, offset 0x1000, printed page 13-15), confidence HIGH: offset, fields, access and reset compared by script with the Chinese issue 02 edition on 2026-11-11, no difference. Not verified on hardware.";

        enum AIP_INF_ATTRI_aip_samp_precision_enum {
            V_8_BITS = 0 { name = "V 8 Bits"; desc = "8 bits"; };
            V_16_BITS = 1 { name = "V 16 Bits"; desc = "16 bits"; };
            V_24_BITS = 2 { name = "V 24 Bits"; desc = "24 bits"; };
            V_32_BITS_IF = 3 { name = "V 32 Bits If"; desc = "32 bits If multi-channel RX is enabled, only the 8-/16-bit sampling accuracy is supported. If multi-channel RX is not enabled, the 8-/16-/24-/32-bit sampling accuracy is supported in I 2 S mode. The 8-/16-bit sampling accuracy is supported in PCM standard or customized mode."; };
        };

        field {
            name = "aip_samp_precision";
            desc = "Sampling accuracy of data received over the AIP.";
            sw = rw;
            hw = r;
            encode = AIP_INF_ATTRI_aip_samp_precision_enum;
            reset = 0x0;
        } aip_samp_precision[11:10];

        field {
            name = "reserved_must_be_1";
            desc = "Reserved, RW; the data sheet says it must be configured to 0x1 (total reset value 0x0000_1000).";
            sw = rw;
            hw = r;
            reset = 0x1;
        } reserved_must_be_1[31:12];

        enum AIP_INF_ATTRI_aip_clk_edge_sel_enum {
            DATA_SAMPLED_AT = 0 { name = "Data Sampled At"; desc = "Data is sampled at the rising edge of the clock."; };
            DATA_SAMPLED_AT_2 = 1 { name = "Data Sampled At 2"; desc = "Data is sampled at the falling edge of the clock."; };
        };

        field {
            name = "aip_clk_edge_sel";
            desc = "AIP data sampling edge select.";
            sw = rw;
            hw = r;
            encode = AIP_INF_ATTRI_aip_clk_edge_sel_enum;
            reset = 0x0;
        } aip_clk_edge_sel[7:7];

        enum AIP_INF_ATTRI_aip_timedivision_sel_enum {
