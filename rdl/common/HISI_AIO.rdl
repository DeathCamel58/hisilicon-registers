            hw = r;
            encode = AIP_INF_ATTRI_aip_timedivision_sel_enum;
            reset = 0x0;
        } aip_timedivision_sel[6:6];

        enum AIP_INF_ATTRI_aip_routes_sel_enum {
            V_2_CHANNELS = 0 { name = "V 2 Channels"; desc = "2 channels"; };
            V_4_CHANNELS = 1 { name = "V 4 Channels"; desc = "4 channels"; };
            V_8_CHANNELS = 2 { name = "V 8 Channels"; desc = "8 channels"; };
            V_16_CHANNELS = 3 { name = "V 16 Channels"; desc = "16 channels"; };
        };

        field {
            name = "aip_routes_sel";
            desc = "Number of channels in AIP multi-channel RX mode.";
            sw = rw;
            hw = r;
            encode = AIP_INF_ATTRI_aip_routes_sel_enum;
            reset = 0x0;
        } aip_routes_sel[5:4];

        enum AIP_INF_ATTRI_aip_mode_enum {
            I_2_S = 0 { name = "I 2 S"; desc = "I 2 S mode"; };
            PCM_STANDARD_MODE = 1 { name = "Pcm Standard Mode"; desc = "PCM standard mode"; };
            PCM_CUSTOMIZED_MODE = 2 { name = "Pcm Customized Mode"; desc = "PCM customized mode"; };
            RESERVED = 3 { name = "Reserved"; desc = "reserved"; };
        };

        field {
            name = "aip_mode";
            desc = "AIP mode select.";
            sw = rw;
            hw = r;
            encode = AIP_INF_ATTRI_aip_mode_enum;
            reset = 0x0;
        } aip_mode[1:0];
    } AIP_INF_ATTRI @ 0x1000;

    reg {
        name = "AIP control register";
        desc = "AIP_CTRL is an AIP control register.

Source: data sheet (Hi3520D/Hi3515A/Hi3515C user guide, 13.6 AIP_CTRL, offset 0x1004, printed page 13-16), confidence HIGH: offset, fields, access and reset compared by script with the Chinese issue 02 edition on 2026-11-11, no difference. Not verified on hardware.";

        enum AIP_CTRL_aip_shift8_en_enum {
            DISABLED_DATA_STORED = 0 { name = "Disabled Data Stored"; desc = "disabled. Data is stored to the memory in 8-bit format."; };
            ENABLED_DATA_STORED = 1 { name = "Enabled Data Stored"; desc = "enabled. Data is stored to the memory in 16-bit format. Each received sampling data segment is shifted 8 bits left. The lower 8 bits are filled with 0."; };
        };

        field {
            name = "aip_shift8_en";
            desc = "AIP data shifting storage enable. (This bit is valid only if the sampling accuracy of the received data is 8 bits.)";
            sw = rw;
            hw = r;
            encode = AIP_CTRL_aip_shift8_en_enum;
            reset = 0x0;
        } aip_shift8_en[14:14];

        field {
            name = "reserved_must_be_0x3210";
            desc = "Reserved, RW; the data sheet says it must be configured to 0x3210 (total reset value 0x0000_3210). Bits [31:15] are reserved too and must be 0.";
            sw = rw;
            hw = r;
            reset = 0x3210;
        } reserved_must_be_0x3210[13:0];
    } AIP_CTRL @ 0x1004;

