            sw = rw;
            hw = r;
        } b[7:0];
    } TDE_COLOR_FILLED @ 0x1C;

    reg {
        name = "Colour-key maximum";
        desc = "[inferred] Colour-key maximum as packed 8-bit R/G/B (MiniGUI `src/newgal/hisi/tde_reg.h` (GPL-3.0, Feynman Software 2007, Hi3510 SDK register layout; https://github.com/VincentWei/MiniGUI)).";

        field {
