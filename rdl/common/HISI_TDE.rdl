    } TDE_COLOR_SPACE_MAX @ 0x20;

    reg {
        name = "Colour-key minimum";
        desc = "[inferred] Colour-key minimum as packed 8-bit R/G/B (MiniGUI `src/newgal/hisi/tde_reg.h` (GPL-3.0, Feynman Software 2007, Hi3510 SDK register layout; https://github.com/VincentWei/MiniGUI)).";

        field {
            name = "r";
