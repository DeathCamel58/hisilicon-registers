`ifndef HISI_TDE_RDL
`define HISI_TDE_RDL

addrmap aHISI_TDE {
    name = "HiSilicon TDE (registers not described)";
    desc = "Not described: no register of this block is described; the registers exist only in closed vendor libraries (the MPP binary modules), not in the data sheet or any vendor source in the tree. The 64 KB window is kept only so that the block base address and size exist in the address map (STUB). Two-dimensional engine (data sheet 8.1, overview/features only): RGB/YCbCr conversion, direct copy and fill, 2D resize, anti-flicker, clip, alpha blending, colorkey, clip mask, status interrupts. No register description in the data sheet; the only vendor source is the TDE API header (`openhisilicon/include/tde_api.h`, no register map). Instances, per data sheet memory map and interrupt table (cross-chip audit 2026-11-11, docs/rdl-campaign/tde.md; every data sheet checked: none has a TDE register table, only the chapter with features): Hi3515 and Hi3520 V100 0x20140000 (VIC interrupt 18); Hi3516 V100 0x20630000 (IRQ 53); Hi3516C V100, Hi3518A/C, Hi3518E V100/V200 and Hi3516C V200 0x20610000 (IRQ 27); Hi3516A/D 0x20610000 (GIC 69); Hi3520D/Hi3515A/Hi3515C 0x20610000 (GIC 70); Hi3516A V200 and Hi3519 V101 0x11100000 (GIC 66); Hi3516A V300 0x11210000 (GIC 67). Hi3511/Hi3512 (interrupt 31, 0x90010000 reserved in the memory map) and Hi3516C V300/Hi3516E V100 (no TDE) have no window in the data sheet. Source: data sheet, confidence HIGH for base and IRQ. Listed as an open item in docs/rdl-sweep/PORT-BLOCKS.md. VENDOR MODULES (2026-11-11, docs/rdl-campaign/tde-vendor.md): static analysis of the vendor MPP TDE modules found four register generations, modelled as eHISI_TDE_G0 (Hi3518/Hi3516C V100), eHISI_TDE_G1 (Hi3520D/Hi3515A/C), eHISI_TDE_G2 (Hi3516A/D, Hi3518E V200/Hi3516C V200) and eHISI_TDE_G3 (Hi3516A V300); chips without a vendor module in the corpus (Hi3511/Hi3515 V100/Hi3520 V100, Hi3516 V100, Hi3516A V200, Hi3519) keep this window-only block.";

    external mem {
        name = "Undocumented register window";
        desc = "The whole 64 KB window of the block. Register layout unknown; placeholder so the block base address and size exist in the map. No registers are described.";
        mementries = 16384;
        memwidth = 32;
        sw = rw;
    } REGS;
};

regfile eHISI_TDE_V0 {
    name = "HiSilicon TDE, Hi3510-style register map (candidate)";
    desc = "CANDIDATE LAYOUT, LOW CONFIDENCE, NOT HARDWARE VERIFIED, NOT INSTANTIATED. First-generation two-dimensional engine register map of the Hi3510 as used by the MiniGUI NEWGAL HiSilicon backend (MiniGUI `src/newgal/hisi/tde_reg.h` (GPL-3.0, Feynman Software 2007, Hi3510 SDK register layout; https://github.com/VincentWei/MiniGUI)): 11 registers in a 0x84-byte window at Hi3510 address 0x90010300 (TDE_REG_BASE_ADDR), i.e. offset 0x300 inside a 0x90010000 block. Applicability: the Hi3511/Hi3512 data sheet describes the TDE in chapter 2D engine (VIC interrupt 31, AHB master/slave, direct copy/fill, ROP, colour key, resize) without a register chapter and lists 0x9001_0000 only as a reserved 64 KB window; the Hi3515 lists a TDE window at 0x20140000 and the Hi3520 V100 likewise, but their TDE generation is unknown. Instantiate only after a probe: read TDE_STATUS (+0x380 from the block base on the Hi3511 if the Hi3510 placement holds) and write/read TDE_SIZE. Everything is marked `[inferred]`: field names from the header, meanings from the names, reset values and access types unknown (modelled RW, no reset).

    Generated 2026-11-10 by build/rdl-audit/video-rdl-scratch/gen_tde.py.";

    reg {
        name = "TDE control / start";
        desc = "[inferred] Control register: start bit, ROP code, command bits, global alpha and in/out colour formats (MiniGUI `src/newgal/hisi/tde_reg.h` (GPL-3.0, Feynman Software 2007, Hi3510 SDK register layout; https://github.com/VincentWei/MiniGUI), union TDE_Reg_Control).";

        field {
            name = "in_color_format";
            desc = "[inferred] Input colour format code.";
            sw = rw;
            hw = r;
        } in_color_format[31:28];

        field {
            name = "out_color_format";
            desc = "[inferred] Output colour format code.";
            sw = rw;
            hw = r;
        } out_color_format[27:24];

        field {
            name = "alpha";
            desc = "[inferred] Global alpha value.";
            sw = rw;
            hw = r;
        } alpha[23:16];

        field {
            name = "tde_cmd_cmd";
            desc = "[inferred] Command type (2 bits).";
            sw = rw;
            hw = r;
        } tde_cmd_cmd[12:11];

        field {
            name = "tde_cmd_colorspace";
            desc = "[inferred] Colour-space conversion select.";
            sw = rw;
            hw = r;
        } tde_cmd_colorspace[10:10];

        field {
            name = "tde_cmd_data_opt";
            desc = "[inferred] Data operation select (2 bits).";
            sw = rw;
            hw = r;
        } tde_cmd_data_opt[9:8];

        field {
            name = "tde_cmd_outalphafrom";
            desc = "[inferred] Output alpha source select.";
            sw = rw;
            hw = r;
        } tde_cmd_outalphafrom[7:7];

        field {
            name = "rop_code";
            desc = "[inferred] Raster operation code (4 bits).";
            sw = rw;
            hw = r;
        } rop_code[5:2];

        field {
            name = "tde_start";
            desc = "[inferred] Start the operation (self-clearing).";
            sw = rw;
            hw = r;
        } tde_start[0:0];
    } TDE_CTRL @ 0x0;

    reg {
        name = "Blit size";
        desc = "[inferred] Width and height of the blit (MiniGUI `src/newgal/hisi/tde_reg.h` (GPL-3.0, Feynman Software 2007, Hi3510 SDK register layout; https://github.com/VincentWei/MiniGUI), union TDE_Reg_Size).";

        field {
            name = "blt_height";
            desc = "[inferred] Blit height in pixels.";
            sw = rw;
            hw = r;
        } blt_height[23:12];

        field {
            name = "blt_width";
            desc = "[inferred] Blit width in pixels.";
            sw = rw;
            hw = r;
        } blt_width[11:0];
    } TDE_SIZE @ 0x4;

    reg {
        name = "Source address";
        desc = "[inferred] Source bitmap physical address (MiniGUI `src/newgal/hisi/tde_reg.h` (GPL-3.0, Feynman Software 2007, Hi3510 SDK register layout; https://github.com/VincentWei/MiniGUI)).";

        field {
            name = "value";
            desc = "[inferred] 32-bit register value (bit layout not in the source).";
            sw = rw;
            hw = r;
        } value[31:0];
    } TDE_SRC_ADDR @ 0x8;

    reg {
        name = "Destination address";
        desc = "[inferred] Destination bitmap physical address (MiniGUI `src/newgal/hisi/tde_reg.h` (GPL-3.0, Feynman Software 2007, Hi3510 SDK register layout; https://github.com/VincentWei/MiniGUI)).";

        field {
            name = "value";
            desc = "[inferred] 32-bit register value (bit layout not in the source).";
            sw = rw;
            hw = r;
        } value[31:0];
    } TDE_DST_ADDR @ 0xC;

    reg {
        name = "Output address";
        desc = "[inferred] Output bitmap physical address (MiniGUI `src/newgal/hisi/tde_reg.h` (GPL-3.0, Feynman Software 2007, Hi3510 SDK register layout; https://github.com/VincentWei/MiniGUI)).";

        field {
            name = "value";
            desc = "[inferred] 32-bit register value (bit layout not in the source).";
            sw = rw;
            hw = r;
        } value[31:0];
    } TDE_OUT_ADDR @ 0x10;

    reg {
        name = "Source / destination stride";
        desc = "[inferred] Strides in bytes (MiniGUI `src/newgal/hisi/tde_reg.h` (GPL-3.0, Feynman Software 2007, Hi3510 SDK register layout; https://github.com/VincentWei/MiniGUI), union TDE_Reg_SrcDstStride).";

