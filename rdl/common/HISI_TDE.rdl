            name = "ck_b_mod";
            desc = "Color key mode, blue/V/index (0 inside, 1 outside, 2 ignore per the HiSTB constants). VERIFIED IN THE HI3520D MODULE (HIGH): position seen in hi3520D_tde.ko. Not verified on hardware. Third pass (PROVEN, TdeHalNodeSetColorKey ARGB branch): the component mode is 2 if the ignore flag is set, else 1 if the out-of-range flag is set, else 0 (inside the [min, max] range). Unverified on hardware.";
            sw = rw;
            hw = r;
        } ck_b_mod[22:21];
        field {
            name = "ck_g_mod";
            desc = "Color key mode, green/U. VERIFIED IN THE HI3520D MODULE (HIGH): position seen in hi3520D_tde.ko. Not verified on hardware.";
            sw = rw;
            hw = r;
        } ck_g_mod[24:23];
        field {
            name = "ck_r_mod";
            desc = "Color key mode, red/Y. VERIFIED IN THE HI3520D MODULE (HIGH): position seen in hi3520D_tde.ko. Not verified on hardware.";
            sw = rw;
            hw = r;
