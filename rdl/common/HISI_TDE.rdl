        field {
            name = "ck_sel";
            desc = "Color key source select. VERIFIED IN THE HI3520D MODULE (HIGH): position seen in hi3520D_tde.ko. Not verified on hardware. Third pass: the value is the first word of the vendor color key command (PROVEN). The OSI layer passes 0 for a background key and, for a foreground key on a non-CLUT format, 3 (HiSTB OSI source, MEDIUM; 2 is used when a CLUT expands first). Unverified on hardware.";
            sw = rw;
            hw = r;
        } ck_sel[30:29];
        field {
            name = "blend_reverse";
            desc = "Swap foreground and background of the blend (TdeHalNodeSetBlendRvs). VERIFIED IN THE HI3520D MODULE (HIGH): position seen in hi3520D_tde.ko. Not verified on hardware.";
            sw = rw;
            hw = r;
        } blend_reverse[31:31];
    } NODE_ALU @ 0x68;

    reg {
