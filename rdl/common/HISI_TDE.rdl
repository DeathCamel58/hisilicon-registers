        field {
            name = "addr";
            desc = "Physical address. VERIFIED IN THE HI3520D MODULE (HIGH): position seen in hi3520D_tde.ko. Not verified on hardware.";
            sw = rw;
            hw = r;
        } addr[31:0];
    } NODE_VF_COEF_ADDR @ 0x48;

