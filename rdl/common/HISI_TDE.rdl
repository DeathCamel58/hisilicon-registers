            sw = rw;
            hw = r;
        } fifo_wrprotect[31:31];

        field {
            name = "endian_sel";
            desc = "[inferred] Endian select.";
            sw = rw;
            hw = r;
        } endian_sel[30:30];

        field {
            name = "pattern_width";
            desc = "[inferred] Pattern width (pattern fill).";
            sw = rw;
            hw = r;
        } pattern_width[25:21];

        field {
            name = "pattern_height";
            desc = "[inferred] Pattern height (pattern fill).";
            sw = rw;
            hw = r;
        } pattern_height[20:16];

        field {
            name = "gout_stride";
            desc = "[inferred] Output stride in bytes.";
            sw = rw;
            hw = r;
        } gout_stride[15:0];
    } TDE_MISC @ 0x18;

    reg {
        name = "Fill colour";
        desc = "[inferred] Fill colour as packed 8-bit R/G/B (MiniGUI `src/newgal/hisi/tde_reg.h` (GPL-3.0, Feynman Software 2007, Hi3510 SDK register layout; https://github.com/VincentWei/MiniGUI)).";

        field {
            name = "r";
            desc = "[inferred] Red component.";
            sw = rw;
            hw = r;
        } r_f[23:16];

        field {
            name = "g";
            desc = "[inferred] Green component.";
            sw = rw;
            hw = r;
        } g[15:8];

        field {
            name = "b";
