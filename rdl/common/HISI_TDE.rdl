        field {
            name = "blue";
            desc = "Blue/V mask. VERIFIED IN THE HI3520D MODULE (HIGH): position seen in hi3520D_tde.ko. Not verified on hardware.";
            sw = rw;
            hw = r;
        } blue[7:0];
        field {
