        } gout_stride[15:0];
    } TDE_MISC @ 0x18;

    reg {
        name = "Fill colour";
        desc = "[inferred] Fill colour as packed 8-bit R/G/B (MiniGUI `src/newgal/hisi/tde_reg.h` (GPL-3.0, Feynman Software 2007, Hi3510 SDK register layout; https://github.com/VincentWei/MiniGUI)).";

        field {
            name = "r";
            desc = "[inferred] Red component.";
            sw = rw;
            hw = r;
        } r_f[23:16];

        field {
            name = "g";
