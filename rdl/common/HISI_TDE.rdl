            desc = "[inferred] 32-bit register value (bit layout not in the source).";
            sw = rw;
            hw = r;
        } value[31:0];
    } TDE_S1_ADDR @ 0x4;

    reg {
        name = "S1 Type (node word 2)";
        desc = "[inferred] Source 1 type (colour format, pitch...). Node word 2 of the TDE_HWNode_S register image: the engine loads these 42 words from the linked list (AQ) in DDR; the same words are readable here (HiSTB SDK `source/msp/drv/tde/adp/tde_v1_0/tde_hal.h` + `tde_hal_k.c` (proprietary SDK upload, https://github.com/JasonFreeLab/HiSTBLinuxV100R005C00SPC050; offsets, names and written values only, no text copied)).";

        field {
            name = "value";
            desc = "[inferred] 32-bit register value (bit layout not in the source).";
            sw = rw;
            hw = r;
        } value[31:0];
    } TDE_S1_TYPE @ 0x8;

    reg {
        name = "S1 Xy (node word 3)";
        desc = "[inferred] Source 1 start position. Node word 3 of the TDE_HWNode_S register image: the engine loads these 42 words from the linked list (AQ) in DDR; the same words are readable here (HiSTB SDK `source/msp/drv/tde/adp/tde_v1_0/tde_hal.h` + `tde_hal_k.c` (proprietary SDK upload, https://github.com/JasonFreeLab/HiSTBLinuxV100R005C00SPC050; offsets, names and written values only, no text copied)).";

