        desc = "[inferred] List control: completion mode 0x0 = start the next list after the current list, 0x4 = after the current node and line. (HiSTB SDK `source/msp/drv/tde/adp/tde_v1_0/tde_hal.h` + `tde_hal_k.c` (proprietary SDK upload, https://github.com/JasonFreeLab/HiSTBLinuxV100R005C00SPC050; offsets, names and written values only, no text copied); the control-register offsets are those listed in docs/rdl-campaign/video-online-sources.md from that driver).";

        field {
            name = "value";
            desc = "[inferred] 32-bit register value (bit layout not in the source).";
            sw = rw;
            hw = r;
        } value[31:0];
    } TDE_AQ_CTRL @ 0x82C;

    reg {
        name = "AQ next node address";
        desc = "[inferred] Physical address of the next node to execute. (HiSTB SDK `source/msp/drv/tde/adp/tde_v1_0/tde_hal.h` + `tde_hal_k.c` (proprietary SDK upload, https://github.com/JasonFreeLab/HiSTBLinuxV100R005C00SPC050; offsets, names and written values only, no text copied); the control-register offsets are those listed in docs/rdl-campaign/video-online-sources.md from that driver).";

        field {
            name = "value";
            desc = "[inferred] 32-bit register value (bit layout not in the source).";
            sw = rw;
            hw = r;
        } value[31:0];
    } TDE_AQ_NADDR @ 0x830;

    reg {
        name = "AQ update mask (low)";
        desc = "[inferred] Low 32 bits of the 64-bit node-field update mask (which node words the list entry updates). (HiSTB SDK `source/msp/drv/tde/adp/tde_v1_0/tde_hal.h` + `tde_hal_k.c` (proprietary SDK upload, https://github.com/JasonFreeLab/HiSTBLinuxV100R005C00SPC050; offsets, names and written values only, no text copied); the control-register offsets are those listed in docs/rdl-campaign/video-online-sources.md from that driver).";

        field {
            name = "value";
            desc = "[inferred] 32-bit register value (bit layout not in the source).";
            sw = rw;
            hw = r;
        } value[31:0];
    } TDE_AQ_UPDATE @ 0x834;

    reg {
        name = "Bus limiter";
        desc = "[inferred] The driver writes 0x80770000. (HiSTB SDK `source/msp/drv/tde/adp/tde_v1_0/tde_hal.h` + `tde_hal_k.c` (proprietary SDK upload, https://github.com/JasonFreeLab/HiSTBLinuxV100R005C00SPC050; offsets, names and written values only, no text copied); the control-register offsets are those listed in docs/rdl-campaign/video-online-sources.md from that driver).";

        field {
            name = "value";
            desc = "[inferred] 32-bit register value (bit layout not in the source).";
            sw = rw;
            hw = r;
        } value[31:0];
    } TDE_BUS_LIMITER @ 0x844;

    reg {
        name = "AQ update mask (high)";
        desc = "[inferred] High 32 bits of the node-field update mask. (HiSTB SDK `source/msp/drv/tde/adp/tde_v1_0/tde_hal.h` + `tde_hal_k.c` (proprietary SDK upload, https://github.com/JasonFreeLab/HiSTBLinuxV100R005C00SPC050; offsets, names and written values only, no text copied); the control-register offsets are those listed in docs/rdl-campaign/video-online-sources.md from that driver).";

        field {
            name = "value";
            desc = "[inferred] 32-bit register value (bit layout not in the source).";
            sw = rw;
            hw = r;
        } value[31:0];
    } TDE_AQ_UPDATE2 @ 0x85C;

    reg {
        name = "Request threshold";
        desc = "[inferred] The driver writes 0x01FEF7CF. (HiSTB SDK `source/msp/drv/tde/adp/tde_v1_0/tde_hal.h` + `tde_hal_k.c` (proprietary SDK upload, https://github.com/JasonFreeLab/HiSTBLinuxV100R005C00SPC050; offsets, names and written values only, no text copied); the control-register offsets are those listed in docs/rdl-campaign/video-online-sources.md from that driver).";

        field {
            name = "value";
            desc = "[inferred] 32-bit register value (bit layout not in the source).";
            sw = rw;
            hw = r;
        } value[31:0];
    } TDE_REQ_TH @ 0x868;

    reg {
        name = "AXI ID";
        desc = "[inferred] The driver writes 0x3010. (HiSTB SDK `source/msp/drv/tde/adp/tde_v1_0/tde_hal.h` + `tde_hal_k.c` (proprietary SDK upload, https://github.com/JasonFreeLab/HiSTBLinuxV100R005C00SPC050; offsets, names and written values only, no text copied); the control-register offsets are those listed in docs/rdl-campaign/video-online-sources.md from that driver).";

        field {
            name = "value";
            desc = "[inferred] 32-bit register value (bit layout not in the source).";
            sw = rw;
            hw = r;
        } value[31:0];
    } TDE_AXI_ID @ 0x86C;
};

// ---- vendor-derived generations (2026-11-11, docs/rdl-campaign/tde-vendor.md) ----

regfile eHISI_TDE_G0 {
    name = "HiSilicon TDE, Hi3518 / Hi3516C V100 generation (vendor-derived)";
    desc = "VENDOR-DERIVED, CONFIDENCE MEDIUM/LOW, NOT VERIFIED ON HARDWARE. No data sheet has a TDE register table. Static analysis (objdump, nothing executed) of hi3518_tde.ko (HiSilicon MPP, Linux 3.0.8, OpenIPC Hi3518EV100 rootfs; unstripped, HAL functions TdeHal*) shows a compact control block in the first 0x48 bytes of the window (the module maps the base 0x20610000 and takes IRQ 27, both matching the data sheets); the operation itself is described by a node in DDR (physical address in TDE_NODE_ADDR), which is why the register set is so small. This layout is different from every later generation (those put the same ID word at 0x800 and the list control at 0x800-0x86C); ID constant 0x20080228 is common to all. Used by: Hi3518A/C V100; Hi3516C V100 (same MPP family: the Hi3518 module serves it, data-sheet base/IRQ identical, no Hi3516C-specific module in the corpus). Documented in docs/rdl-campaign/tde-vendor.md. Registers not named here were not seen accessed.";

    reg {
        name = "TDE version / ID";
        desc = "Read-only ID word; the module's version check (bTdeHalSwVersion) compares it with 0x20080228, the same constant every other TDE generation compares against at its own offset (0x800 there). Source: vendor module hi3518_tde.ko (bTdeHalSwVersion), confidence HIGH for the offset and constant, static analysis of the disassembly. Not verified on hardware.";

        field {
            name = "value";
            desc = "32 bit value, single field (bit layout not observed in the vendor code). Not verified on hardware.";
            sw = r;
            hw = w;
        } value[31:0];
    } TDE_VERSION @ 0x0;

    reg {
        name = "TDE soft reset";
        desc = "Written with 1 by TdeHalCtlReset and TdeHalResumeInit (engine reset), always followed by clearing all interrupt status bits (TDE_INT = 0xFF). Name taken from the same function in the HiSTB v1 driver (TDE_RST at 0x804 there). Source: vendor module hi3518_tde.ko (TdeHalCtlReset, TdeHalResumeInit), confidence MEDIUM, static analysis of the disassembly. Not verified on hardware.";

        field {
            name = "value";
            desc = "32 bit value, single field (bit layout not observed in the vendor code). Not verified on hardware.";
            sw = w;
            hw = r;
        } value[31:0];
    } TDE_RST @ 0x8;

    reg {
        name = "TDE control / start";
        desc = "Read-modify-write with bit 0 set as the very last step of TdeHalNodeExecute, after the node address and update word were written: starts the job. Other bits never touched. Source: vendor module hi3518_tde.ko (TdeHalNodeExecute), confidence MEDIUM, static analysis of the disassembly. Not verified on hardware.";

        field {
            name = "start";
            desc = "Set by TdeHalNodeExecute to start the queued node (vendor-observed).";
            sw = rw;
            hw = rw;
        } start[0:0];

        field {
            name = "rest";
            desc = "Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";
            sw = rw;
            hw = rw;
        } rest[31:1];
    } TDE_CTRL @ 0xC;

    reg {
        name = "UNK_0010";
        desc = "Written with 0x80000000 by TdeHalOpen and TdeHalResumeInit, after TDE_NODE_ADDR was cleared. Access observed: written. Neighbors: TDE_NODE_ADDR. Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";

        field {
            name = "value";
            desc = "Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";
            sw = w;
            hw = r;
        } value[31:0];
    } UNK_0010 @ 0x10;

    reg {
        name = "TDE node list address";
        desc = "Physical address of the first node of the job (wgetphy of the node buffer + 32, i.e. the engine-visible part of the node), written by TdeHalNodeExecute before TDE_CTRL.start; cleared to 0 by TdeHalOpen/TdeHalResumeInit. Name by analogy with the HiSTB v1 TDE_AQ_NADDR. Source: vendor module hi3518_tde.ko (TdeHalNodeExecute, TdeHalOpen), confidence MEDIUM, static analysis of the disassembly. Not verified on hardware.";

        field {
            name = "value";
            desc = "32 bit value, single field (bit layout not observed in the vendor code). Not verified on hardware.";
            sw = w;
            hw = r;
        } value[31:0];
    } TDE_NODE_ADDR @ 0x14;

    reg {
        name = "UNK_0018";
        desc = "Written by TdeHalNodeExecute with its third argument right after TDE_NODE_ADDR (in the HiSTB v1 / later generations the corresponding argument is the node field update mask, so this is probably the update mask, inferred, LOW). Access observed: written. Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";

        field {
            name = "value";
            desc = "Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";
            sw = w;
            hw = r;
        } value[31:0];
    } UNK_0018 @ 0x18;

    reg {
        name = "UNK_0024";
        desc = "Read-modify-write with bit 31 set by TdeHalCtlReset, TdeHalResumeInit and TdeHalInit (after the soft reset), no other bit touched. Access observed: read-modify-write, value 0x80000000 OR-ed in. Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";

        field {
            name = "bit31_unk";
            desc = "Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";
            sw = rw;
            hw = rw;
        } bit31_unk[31:31];

        field {
            name = "rest";
            desc = "Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";
            sw = rw;
            hw = rw;
        } rest[30:0];
    } UNK_0024 @ 0x24;

    reg {
        name = "TDE interrupt status";
        desc = "Read and written back unchanged by TdeHalCtlIntStats (acknowledge of every status bit that read as set, i.e. write-1-clear); TdeHalCtlReset writes 0xFF (clear all 8 status bits). Name by analogy with the HiSTB v1 TDE_INT (0x818 there). Source: vendor module hi3518_tde.ko (TdeHalCtlIntStats, TdeHalCtlReset), confidence MEDIUM, static analysis of the disassembly. Not verified on hardware.";

        field {
            name = "value";
            desc = "32 bit value, single field (bit layout not observed in the vendor code). Not verified on hardware.";
            sw = rw;
            hw = rw;
        } value[31:0];
    } TDE_INT @ 0x30;

    reg {
        name = "TDE status";
        desc = "Bit 0 is the busy bit: TdeHalCtlIsIdle returns !bit0; TdeHalCtlIsIdleSafely polls it ten times in a row and TdeHalNodeExecute refuses to start (-1) when it is set. Other bits never examined. Source: vendor module hi3518_tde.ko (TdeHalCtlIsIdle, TdeHalCtlIsIdleSafely, TdeHalNodeExecute), confidence HIGH, static analysis of the disassembly. Not verified on hardware.";

        field {
            name = "busy";
            desc = "1 = a job is running (vendor-observed idle test).";
            sw = r;
            hw = w;
        } busy[0:0];

        field {
            name = "rest";
            desc = "Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";
            sw = r;
            hw = w;
        } rest[31:1];
    } TDE_STA @ 0x38;

    reg {
        name = "TDE finished node address";
        desc = "Read by TdeHalNodeGetFinishHandle: the value (when non-zero) is converted back to the kernel address of the node (physical address minus 32, wgetvrt) and the node's handle field (+28) is returned as the finished job handle. So it reads the engine-visible address of the node that just completed. Source: vendor module hi3518_tde.ko (TdeHalNodeGetFinishHandle), confidence MEDIUM, static analysis of the disassembly. Not verified on hardware.";

        field {
            name = "value";
            desc = "32 bit value, single field (bit layout not observed in the vendor code). Not verified on hardware.";
            sw = r;
            hw = w;
        } value[31:0];
    } TDE_FINISH_NODE @ 0x44;
};

regfile eHISI_TDE_G1 {
    name = "HiSilicon TDE, Hi3520D / Hi3515A / Hi3515C generation (vendor-derived)";
    desc = "VENDOR-DERIVED, CONFIDENCE MEDIUM/LOW, NOT VERIFIED ON HARDWARE. No data sheet has a TDE register table. Static analysis (objdump, nothing executed) of hi3520D_tde.ko (HiSilicon MPP V2.0.5.1, Linux 3.0.8, unstripped, HAL TdeHal*; init: ioremap of 0x20610000, size 0x3000, request_irq 70 = GIC ID 70, matching the data sheet). The list-control block at 0x800 (version, reset, status, interrupt, list control, next node, bus limiter) has the same offsets and meaning as the later Hi3516A/Hi3518E/Hi3521 generation (eHISI_TDE_G2), whose names follow the HiSTB v1 driver; this module differs in three ways: (1) every write to that block is repeated at +0x1000 (second copy 0x1800-0x1844, only the first is read), (2) it does not use the 0x868/0x86C registers, (3) jobs are submitted through a second register bank at 0x2000-0x2054 (TdeHalSubJob, the interrupt path reads 0x2030-0x2040), not through the async list node-address register. The node itself is a DDR structure of 42 words followed by a 64 bit update mask at +0xA8/+0xAC (TdeHalNodeGetNdSize), the layout of the HiSTB v1 node (see eHISI_TDE_V1). Registers not listed were not seen accessed. Documented in docs/rdl-campaign/tde-vendor.md. SECOND PASS (2026-11-11, docs/rdl-campaign/tde-vendor.md): (1) bring-up order in the vendor module (HIGH): SYS command 0x51 = SYS_HAL_TdeClkEn(1) sets PERI_CRG22 (0x20030058) bit 1, then command 0x50 = SYS_HAL_TdeResetSel(0) clears bit 0, then the bus limiter and the 0x2050 write; (2) the job node (DDR) is documented in eHISI_TDE_G1_NODE (42 words, bit fields; positions verified in this module, names from HiSTB v1); (3) the 0x2000 bank looks like a job FIFO (handle, node address, control, 64 bit update mask, completion count/handle); register names given in the UNK_ descriptions are GUESSES; (4) TdeHalNodeSetRop is an empty stub in this module (returns 0xA064800B): ROP is not usable with this vendor build; pattern fill (modes 9 and 10 of TdeHalNodeSetBaseOperate) and quick copy/fill exist; (5) at least five resize filter-coefficient tables are loaded into MMZ memory at init (TdeHalInit/TdeHalLoadFiltParam) and referenced by node words HF_COEF_ADDR/VF_COEF_ADDR.";

    reg {
        name = "TDE version / ID";
        desc = "Read-only ID word; bTdeHalSwVersion compares it with 0x20080228. BOARD-READ on the Hi3520D (nvr0408, 2026-11-11, U-Boot and Linux): 0x20110322, not the vendor constant (a date-code style value, 2011-03-22; the meaning is INFERRED); a driver must not insist on 0x20080228. (same constant on every TDE generation). Source: vendor module hi3520D_tde.ko (bTdeHalSwVersion), confidence HIGH, static analysis of the disassembly. Not verified on hardware.";

        field {
            name = "value";
            desc = "32 bit value, single field (bit layout not observed in the vendor code). Not verified on hardware.";
            sw = r;
            hw = w;
        } value[31:0];
    } TDE_VERSION @ 0x800;

    reg {
        name = "TDE soft reset";
        desc = "Written with 0xFFFFFFFF by TdeHalInit, TdeHalCtlReset and TdeHalResumeInit (engine reset); HiSTB v1 name. The module writes every register of this bank twice, at this offset and at +0x1000 (a second copy of the bank at 0x1800-0x1844; the mirror is only ever written, except TDE_INT which is read and written back at both); reads use the first copy. Source: vendor module hi3520D_tde.ko (TdeHalCtlReset), confidence MEDIUM, static analysis of the disassembly. Not verified on hardware.";

        field {
            name = "value";
            desc = "32 bit value, single field (bit layout not observed in the vendor code). Not verified on hardware.";
            sw = w;
            hw = r;
        } value[31:0];
    } TDE_RST @ 0x804;

    reg {
        name = "TDE status";
        desc = "Bit 0 is the (asynchronous-queue) busy bit: TdeHalCtlIsIdle returns !bit0 and TdeHalCtlIsIdleSafely polls it ten times. HiSTB v1 name. Source: vendor module hi3520D_tde.ko (TdeHalCtlIsIdle, TdeHalCtlIsIdleSafely), confidence HIGH, static analysis of the disassembly. Not verified on hardware.";

        field {
            name = "busy";
            desc = "1 = busy (vendor-observed idle test).";
            sw = r;
            hw = w;
        } busy[0:0];

        field {
            name = "rest";
            desc = "Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";
            sw = r;
            hw = w;
        } rest[31:1];
    } TDE_STA @ 0x814;

    reg {
        name = "TDE interrupt status / mask";
        desc = "TdeHalCtlIntStats reads it and writes the value back (acknowledge, write-1-clear); TdeHalCtlReset/TdeHalInit/TdeHalResumeInit write 0x800F001F. In the HiSTB v1 driver the register is split [15:0] status and [31:16] mask (inferred, LOW). The module writes every register of this bank twice, at this offset and at +0x1000 (a second copy of the bank at 0x1800-0x1844; the mirror is only ever written, except TDE_INT which is read and written back at both); reads use the first copy. Source: vendor module hi3520D_tde.ko (TdeHalCtlIntStats, TdeHalCtlReset), confidence MEDIUM, static analysis of the disassembly. Not verified on hardware. SECOND PASS: the interrupt service routine tde_osr_isr does NOT read this register; the only function that reads it (TdeHalCtlIntStats, which reads and writes back 0x818 and 0x1818 and returns the 0x1818 value) has no caller inside hi3520D_tde.ko, and the completion path uses the 0x2000 bank. Meaning of the status bits is therefore still unknown (the node's INS.aq_irq_mask = 8 enables the node-complete interrupt, INFERRED). The module never calls TdeHalCtlReset either; the engine reset is the CRG reset bit (PERI_CRG22 bit 0).";

        field {
            name = "value";
            desc = "32 bit value, single field (bit layout not observed in the vendor code). Not verified on hardware.";
            sw = rw;
            hw = rw;
        } value[31:0];
    } TDE_INT @ 0x818;

    reg {
        name = "TDE async list control";
        desc = "Read-modify-write by TdeHalSystemInit, TdeHalOpen and TdeHalResumeInit: bit 24 set, bits [23:20] = 4. The same value (enable plus mode 4 = start next list after the current node and line) is what the HiSTB v1 driver writes to its TDE_AQ_CTRL (u32AqEn bit 24, u32AqOperMode [23:20]). The module writes every register of this bank twice, at this offset and at +0x1000 (a second copy of the bank at 0x1800-0x1844; the mirror is only ever written, except TDE_INT which is read and written back at both); reads use the first copy. Source: vendor module hi3520D_tde.ko (TdeHalOpen, TdeHalSystemInit), confidence MEDIUM, static analysis of the disassembly. Not verified on hardware.";

        field {
            name = "aq_oper_mode";
            desc = "List operating mode; the module writes 4 (HiSTB v1: 0 = next list after the current list, 4 = after the current node and line).";
            sw = rw;
            hw = rw;
        } aq_oper_mode[23:20];

        field {
            name = "aq_en";
            desc = "Async list enable; set by the module.";
            sw = rw;
            hw = rw;
        } aq_en[24:24];

        field {
            name = "rest";
            desc = "Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";
            sw = rw;
            hw = rw;
        } rest[31:25];

        field {
            name = "rest_lo";
            desc = "Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";
            sw = rw;
            hw = rw;
        } rest_lo[19:0];
    } TDE_AQ_CTRL @ 0x82C;

    reg {
        name = "TDE async list next node address";
        desc = "Written with 0 by TdeHalOpen, TdeHalSystemInit and TdeHalResumeInit (list cleared); this module never writes a node address here, jobs are submitted through the 0x2000 bank (TdeHalSubJob). HiSTB v1 name (TDE_AQ_NADDR). The module writes every register of this bank twice, at this offset and at +0x1000 (a second copy of the bank at 0x1800-0x1844; the mirror is only ever written, except TDE_INT which is read and written back at both); reads use the first copy. Source: vendor module hi3520D_tde.ko (TdeHalOpen), confidence MEDIUM for the clear, LOW for the name, static analysis of the disassembly. Not verified on hardware.";

        field {
            name = "value";
            desc = "32 bit value, single field (bit layout not observed in the vendor code). Not verified on hardware.";
            sw = w;
            hw = r;
        } value[31:0];
    } TDE_AQ_NADDR @ 0x830;

    reg {
        name = "TDE bus limiter";
        desc = "Read-modify-write by TdeHalSetClock: OR-ed with 0x80220000 (bit 31 and bits 17 and 21; HiSTB v1 writes 0x80770000, the later generations 0x80220000). Called when the clock is switched on. HiSTB v1 name. The module writes every register of this bank twice, at this offset and at +0x1000 (a second copy of the bank at 0x1800-0x1844; the mirror is only ever written, except TDE_INT which is read and written back at both); reads use the first copy. Source: vendor module hi3520D_tde.ko (TdeHalSetClock), confidence MEDIUM, static analysis of the disassembly. Not verified on hardware.";

        field {
            name = "value";
            desc = "32 bit value, single field (bit layout not observed in the vendor code). Not verified on hardware.";
            sw = rw;
            hw = rw;
        } value[31:0];
    } TDE_BUS_LIMITER @ 0x844;

    reg {
        name = "UNK_2000";
        desc = "Read by TdeHalSubJob: bit 0 set means busy, the job is refused (-1). This is probably the synchronous-queue status (the data sheet says the engine has a sync and an async list). Access observed: read, bit 0 tested. Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware. SECOND PASS: refused when bit 0 is set, i.e. a submit FIFO full/busy flag (INFERRED, MEDIUM). GUESS name: SUBMIT_STATUS.";

        field {
            name = "busy_unk";
            desc = "Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";
            sw = r;
            hw = w;
        } busy_unk[0:0];

        field {
            name = "rest";
            desc = "Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";
            sw = r;
            hw = w;
        } rest[31:1];
    } UNK_2000 @ 0x2000;

    reg {
        name = "UNK_2008";
        desc = "Written with 0 as the last register write of TdeHalSubJob (after the node address, i.e. probably the submit/start trigger of the 0x2000 bank). Access observed: written, value 0. Neighbors: UNK_2010..UNK_201C. Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware. SECOND PASS: GUESS name: SUBMIT (write 0 = submit the staged job), confidence MEDIUM.";

        field {
            name = "value";
            desc = "Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";
            sw = w;
            hw = r;
        } value[31:0];
    } UNK_2008 @ 0x2008;

    reg {
        name = "UNK_2010";
        desc = "Written by TdeHalSubJob with its first argument (a job/handle word of the caller). Access observed: written. Neighbors: UNK_2014 (node address). Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware. SECOND PASS (2026-11-11, docs/rdl-campaign/tde-vendor.md): the value is the job handle (TdeOsiListSubJob passes the handle of the job, [job+8]); the interrupt path gets the same handle back from UNK_2038 bits [7:0] and uses it to find the finished job. GUESS name: JOB_HANDLE, confidence MEDIUM.";

        field {
            name = "value";
            desc = "Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";
            sw = w;
            hw = r;
        } value[31:0];
    } UNK_2010 @ 0x2010;

    reg {
        name = "UNK_2014";
        desc = "Written by TdeHalSubJob with the physical address of the node (wgetphy of the node buffer + 32, same address convention as the other generations' node address register). Access observed: written. Probably the node (list) address of the 0x2000 bank, inferred, LOW. Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware. SECOND PASS: the address points at the compact node (eHISI_TDE_G1_NODE: only the words with an update-mask bit set, then next address and next mask). GUESS name: NODE_ADDR, confidence MEDIUM.";

        field {
            name = "value";
            desc = "Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";
            sw = w;
            hw = r;
        } value[31:0];
    } UNK_2014 @ 0x2014;

    reg {
        name = "UNK_2018";
        desc = "Written by TdeHalSubJob with 0x01000000 (bit 24 set, bits [23:20] = 0), the same bit layout as TDE_AQ_CTRL (bit 24 enable, [23:20] mode) with mode 0, so probably the control register of this bank (inferred, LOW). Access observed: written. Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware. SECOND PASS: GUESS name: SUBMIT_CTRL, confidence MEDIUM.";

        field {
            name = "value";
            desc = "Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";
            sw = w;
            hw = r;
        } value[31:0];
    } UNK_2018 @ 0x2018;

    reg {
        name = "UNK_201C";
        desc = "Written by TdeHalSubJob with its third argument (a word supplied by the caller, probably the update mask of the node). Access observed: written. Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware. SECOND PASS: the register pair UNK_201C (low) and UNK_2054 (high) takes the 64 bit update mask of the first node (TdeOsiListSubJob loads it as a 64 bit value from the node record and TdeHalSubJob passes the two halves to these registers). GUESS name: NODE_UPDATE_LO, confidence MEDIUM.";

        field {
            name = "value";
            desc = "Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";
            sw = w;
            hw = r;
        } value[31:0];
    } UNK_201C @ 0x201C;

    reg {
        name = "UNK_2030";
        desc = "Read by TdeHalCtlFifoIntStats (interrupt service path): a value of 0xFFFFFFFF makes the module print a diagnostic and the value is passed on to TdeOsiListIntProc as the first word of the status record. Access observed: read. Neighbors: UNK_2038, UNK_2040. Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware. SECOND PASS: the interrupt service loop (TdeOsiListIntProc) reads the status record, completes the job whose handle is in UNK_2038, submits the next waiting job and repeats while this first word is greater than 1, so this word is probably a count of completion records (INFERRED, LOW-MEDIUM; value 0xFFFFFFFF is reported as an error). GUESS name: DONE_COUNT.";

        field {
            name = "value";
            desc = "Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";
            sw = r;
            hw = w;
        } value[31:0];
    } UNK_2030 @ 0x2030;

    reg {
        name = "UNK_2038";
        desc = "Read by TdeHalCtlFifoIntStats; the low 8 bits are stored as the second word of the status record, CORRECTION (2026-11-11, disassembly of TdeOsiListIntProc, HIGH): TdeOsiListIntProc does NOT use this word, it uses the third word (0x2040) as the job handle. Board: the low byte read 1 after the first job, so this is a status or count, not the handle (GUESS: completion status). Access observed: read, bits [7:0] used. Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware. SECOND PASS: handle of the finished job. Reading it probably pops the completion FIFO (INFERRED: the ISR reads three words per record and loops). GUESS name: DONE_HANDLE, confidence MEDIUM.";

        field {
            name = "handle_unk";
            desc = "Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";
            sw = r;
            hw = w;
        } handle_unk[7:0];

        field {
            name = "rest";
            desc = "Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";
            sw = r;
            hw = w;
        } rest[31:8];
    } UNK_2038 @ 0x2038;

    reg {
        name = "UNK_2040";
        desc = "Read by TdeHalCtlFifoIntStats and stored as the third word of the status record CORRECTION (2026-11-11, HIGH, disassembly of TdeOsiListIntProc): the full 32 bit word is compared with the job handles of the pending list (the handle written to 0x2010; handles 1..1024 select list 1, others list 0). Access observed: read. Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";

        field {
            name = "value";
            desc = "Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";
            sw = r;
            hw = w;
        } value[31:0];
    } UNK_2040 @ 0x2040;

    reg {
        name = "UNK_2050";
        desc = "Written with 4 by TdeHalSetClock after the clock was enabled (same mode value 4 as TDE_AQ_CTRL). Access observed: written. Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";

        field {
            name = "value";
            desc = "Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";
            sw = w;
            hw = r;
        } value[31:0];
    } UNK_2050 @ 0x2050;

    reg {
        name = "UNK_2054";
        desc = "Written by TdeHalSubJob with its fourth argument (caller-supplied word). Access observed: written. Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware. SECOND PASS: upper 32 bits of the update mask (see UNK_201C). GUESS name: NODE_UPDATE_HI, confidence MEDIUM.";

        field {
            name = "value";
            desc = "Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";
            sw = w;
            hw = r;
        } value[31:0];
    } UNK_2054 @ 0x2054;

    reg {
        name = "UNK_1804";
        desc = "Mirror of TDE_RST (0x804): every write the module makes to TDE_RST is repeated here (TdeHalCtlReset, TdeHalInit, TdeHalResumeInit, TdeHalOpen, TdeHalSetClock); TDE_RST itself is the copy that is read, except TdeHalCtlIntStats which also reads and writes back 0x1818. Purpose of the duplicate unknown (probably a second list context, the data sheet mentions a sync and an async list). Access observed: written (0x1818 read and written back). Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";

        field {
            name = "value";
            desc = "Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";
            sw = w;
            hw = r;
        } value[31:0];
    } UNK_1804 @ 0x1804;

    reg {
        name = "UNK_1818";
        desc = "Mirror of TDE_INT (0x818): every write the module makes to TDE_INT is repeated here (TdeHalCtlReset, TdeHalInit, TdeHalResumeInit, TdeHalOpen, TdeHalSetClock); TDE_INT itself is the copy that is read, except TdeHalCtlIntStats which also reads and writes back 0x1818. Purpose of the duplicate unknown (probably a second list context, the data sheet mentions a sync and an async list). Access observed: written (0x1818 read and written back). Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";

        field {
            name = "value";
            desc = "Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";
            sw = rw;
            hw = rw;
        } value[31:0];
    } UNK_1818 @ 0x1818;

    reg {
        name = "UNK_182C";
        desc = "Mirror of TDE_AQ_CTRL (0x82C): every write the module makes to TDE_AQ_CTRL is repeated here (TdeHalCtlReset, TdeHalInit, TdeHalResumeInit, TdeHalOpen, TdeHalSetClock); TDE_AQ_CTRL itself is the copy that is read, except TdeHalCtlIntStats which also reads and writes back 0x1818. Purpose of the duplicate unknown (probably a second list context, the data sheet mentions a sync and an async list). Access observed: written (0x1818 read and written back). Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";

        field {
            name = "value";
            desc = "Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";
            sw = rw;
            hw = rw;
        } value[31:0];
    } UNK_182C @ 0x182C;

    reg {
        name = "UNK_1830";
        desc = "Mirror of TDE_AQ_NADDR (0x830): every write the module makes to TDE_AQ_NADDR is repeated here (TdeHalCtlReset, TdeHalInit, TdeHalResumeInit, TdeHalOpen, TdeHalSetClock); TDE_AQ_NADDR itself is the copy that is read, except TdeHalCtlIntStats which also reads and writes back 0x1818. Purpose of the duplicate unknown (probably a second list context, the data sheet mentions a sync and an async list). Access observed: written (0x1818 read and written back). Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";

        field {
            name = "value";
            desc = "Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";
            sw = w;
            hw = r;
        } value[31:0];
    } UNK_1830 @ 0x1830;

    reg {
        name = "UNK_1844";
        desc = "Mirror of TDE_BUS_LIMITER (0x844): every write the module makes to TDE_BUS_LIMITER is repeated here (TdeHalCtlReset, TdeHalInit, TdeHalResumeInit, TdeHalOpen, TdeHalSetClock); TDE_BUS_LIMITER itself is the copy that is read, except TdeHalCtlIntStats which also reads and writes back 0x1818. Purpose of the duplicate unknown (probably a second list context, the data sheet mentions a sync and an async list). Access observed: written (0x1818 read and written back). Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";

        field {
            name = "value";
            desc = "Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";
            sw = rw;
            hw = rw;
        } value[31:0];
    } UNK_1844 @ 0x1844;
};

regfile eHISI_TDE_G1_NODE {
    name = "HiSilicon TDE, Hi3520D job node image (in DDR, NOT MMIO registers)";
    desc = "NOT A REGISTER FILE: this is the layout of one hardware job node in DDR, described as a regfile only so that the words and bit fields can be documented here. NOT INSTANTIATED. Vendor-derived (static analysis of hi3520D_tde.ko, docs/rdl-campaign/tde-vendor.md), NOT VERIFIED ON HARDWARE. Confidence per field: a field note 'VERIFIED IN THE HI3520D MODULE' means the bit position was read from the Hi3520D module disassembly (HIGH; every bfi/orr into the node word was checked against the HiSTB v1 layout and matched; names and meanings come from the HiSTB v1 driver names, so the MEANING of a named bit is MEDIUM); a field note 'HiSTB v1 layout only' means only the HiSTB layout is known (INFERRED, MEDIUM-LOW). STRUCTURE (HIGH): the module builds a software node whose hardware part is 42 words at offsets 0x00-0xA4 plus a 64 bit update mask at +0xA8/+0xAC (bit n = word n was set; TdeHalNodeGetNdSize accepts bits 0..41). The node the engine reads (TdeHalNodeMakeNd) is COMPACT: only the words whose update-mask bit is set, in index order, followed by 12 bytes (next-node physical address, next update mask low, next update mask high; TdeHalFillLastNodeNextInfo writes them into the last three words, 0 = end of list). Allocated size = 44 + 4 * popcount(mask), with a 32 byte software header in front (the hardware address is node + 32, wgetphy(node + 32)). TdeHalNodeInitNd zeroes 0xD8 bytes, sets update mask = 1 (word 0 only), INS.aq_irq_mask = 8, clears TAR_TYPE bits 24 and 25 (scan direction). Words must be 32 bit aligned; the node address written to the engine is a physical address below 4 GiB. Coordinates are 12 bits (0..4095), pitch 16 bits.";
    reg {
        name = "Instruction word (node word 0)";
        desc = "Node word 0 at node offset 0x00. Selects the operation. The module starts every node with only this word updated and AqIrqMask = 8 (TdeHalNodeInitNd). Source: hi3520D_tde.ko TdeHalNodeSet* (offsets and bit positions) and HiSTB v1 tde_hal.h (names).";
        field {
            name = "src1_mod";
            desc = "Source 1 mode: 0 disabled, 1 bitmap, 2 pattern, 3 fill, 5 quick copy, 7 quick fill (TdeHalNodeSetBaseOperate switch: the 11 cases and the [2:0] field position are in the module, the values 0, 1 seen directly; 2, 3, 5, 7 by the HiSTB enum, MEDIUM). VERIFIED IN THE HI3520D MODULE (HIGH): position seen in hi3520D_tde.ko. Not verified on hardware. OPERATION MODES (third pass, 2026-11-11, PROVEN in TdeHalNodeSetBaseOperate jump table of hi3520D_tde.ko): quick fill 7 with src2 0; quick copy 5 with src2 0; normal one-source blit 0 with src2 1 (bitmap); two-source blit 1 and src2 1; fill with a bitmap 1 and src2 3; single-source pattern fill 0 and src2 2; double-source pattern fill 1 and src2 2. Unverified on hardware.";
            sw = rw;
            hw = r;
        } src1_mod[2:0];
        field {
            name = "src2_mod";
            desc = "Source 2 mode: 0 disabled, 1 bitmap, 2 pattern, 3 fill (SetBaseOperate). VERIFIED IN THE HI3520D MODULE (HIGH): position seen in hi3520D_tde.ko. Not verified on hardware. Values per operation: see src1_mod (third pass). The normal one-source blit of the vendor (format convert, colorize, mirror, resize) uses the SOURCE 2 slot with src1 disabled and ALU mode 7.";
            sw = rw;
            hw = r;
        } src2_mod[4:3];
        field {
            name = "ics_conv";
            desc = "Input color space conversion enable (HiSTB name IcsConv). HiSTB v1 layout only (MEDIUM, INFERRED: not seen in the Hi3520D module code). Not verified on hardware.";
            sw = rw;
            hw = r;
        } ics_conv[5:5];
        field {
            name = "resize";
            desc = "2D resize enable (HiSTB name Resize); set by TdeHalNodeSetResize, bit not isolated in the module. HiSTB v1 layout only (MEDIUM, INFERRED: not seen in the Hi3520D module code). Not verified on hardware.";
            sw = rw;
            hw = r;
        } resize[6:6];
        field {
            name = "dfe_en";
            desc = "De-flicker enable (set with 0x80 by TdeHalNodeSetFlicker). VERIFIED IN THE HI3520D MODULE (HIGH): position seen in hi3520D_tde.ko. Not verified on hardware.";
            sw = rw;
            hw = r;
        } dfe_en[7:7];
        field {
            name = "y1_en";
            desc = "Y1 channel enable: macroblock source 1 (set with 0x100 by TdeHalNodeSetSrc1 for MB formats). VERIFIED IN THE HI3520D MODULE (HIGH): position seen in hi3520D_tde.ko. Not verified on hardware.";
            sw = rw;
            hw = r;
        } y1_en[8:8];
        field {
            name = "y2_en";
            desc = "Y2 channel enable: macroblock source 2 (set with 0x200 by TdeHalNodeSetSrc2 for MB formats). VERIFIED IN THE HI3520D MODULE (HIGH): position seen in hi3520D_tde.ko. Not verified on hardware.";
            sw = rw;
            hw = r;
        } y2_en[9:9];
        field {
            name = "clut";
            desc = "CLUT enable (set with 0x800 by TdeHalNodeSetClutOpt). VERIFIED IN THE HI3520D MODULE (HIGH): position seen in hi3520D_tde.ko. Not verified on hardware.";
            sw = rw;
            hw = r;
        } clut[11:11];
        field {
            name = "color_key";
            desc = "Color key enable (set with 0x1000 by TdeHalNodeSetColorKey). VERIFIED IN THE HI3520D MODULE (HIGH): position seen in hi3520D_tde.ko. Not verified on hardware.";
            sw = rw;
            hw = r;
        } color_key[12:12];
        field {
            name = "icsc_sel";
            desc = "Input color space conversion select (HiSTB name IcscSel). HiSTB v1 layout only (MEDIUM, INFERRED: not seen in the Hi3520D module code). Not verified on hardware.";
            sw = rw;
            hw = r;
        } icsc_sel[13:13];
        field {
            name = "clip";
            desc = "Clip enable (set with 0x4000 by TdeHalNodeSetClipping and InitChildNd). VERIFIED IN THE HI3520D MODULE (HIGH): position seen in hi3520D_tde.ko. Not verified on hardware.";
            sw = rw;
            hw = r;
        } clip[14:14];
        field {
            name = "mb_mode";
            desc = "Macroblock operation mode (3 bits, TdeHalNodeSetMbMode). VERIFIED IN THE HI3520D MODULE (HIGH): position seen in hi3520D_tde.ko. Not verified on hardware.";
            sw = rw;
            hw = r;
        } mb_mode[17:15];
        field {
            name = "mb_en";
            desc = "Macroblock operation enable (HiSTB name MbEn); BaseOperate sets it for the MB modes (MbEn named in the HiSTB union). HiSTB v1 layout only (MEDIUM, INFERRED: not seen in the Hi3520D module code). Not verified on hardware.";
            sw = rw;
            hw = r;
        } mb_en[18:18];
        field {
            name = "aq_irq_mask";
            desc = "Asynchronous list interrupt mask: TdeHalNodeInitNd and InitChildNd write the value 8 (bit 22) into every node; the HiSTB name for the 8 is the node-complete interrupt enable (INFERRED, MEDIUM). VERIFIED IN THE HI3520D MODULE (HIGH): position seen in hi3520D_tde.ko. Not verified on hardware.";
            sw = rw;
            hw = r;
        } aq_irq_mask[22:19];
        field {
            name = "sq_irq_mask";
            desc = "Synchronous list interrupt mask (HiSTB name SqIrqMask). HiSTB v1 layout only (MEDIUM, INFERRED: not seen in the Hi3520D module code). Not verified on hardware.";
            sw = rw;
            hw = r;
        } sq_irq_mask[27:23];
        field {
            name = "ocs_conv";
            desc = "Output color space conversion enable (HiSTB name OcsConv). HiSTB v1 layout only (MEDIUM, INFERRED: not seen in the Hi3520D module code). Not verified on hardware.";
            sw = rw;
            hw = r;
        } ocs_conv[28:28];
        field {
            name = "block_flag";
            desc = "Block (slice) flag for wide pictures (HiSTB name BlockFlag). HiSTB v1 layout only (MEDIUM, INFERRED: not seen in the Hi3520D module code). Not verified on hardware.";
            sw = rw;
            hw = r;
        } block_flag[29:29];
        field {
            name = "first_block";
            desc = "First block flag. HiSTB v1 layout only (MEDIUM, INFERRED: not seen in the Hi3520D module code). Not verified on hardware.";
            sw = rw;
            hw = r;
        } first_block[30:30];
        field {
            name = "last_block";
            desc = "Last block flag. HiSTB v1 layout only (MEDIUM, INFERRED: not seen in the Hi3520D module code). Not verified on hardware.";
            sw = rw;
            hw = r;
        } last_block[31:31];
    } NODE_INS @ 0x00;

    reg {
        name = "Source 1 address";
        desc = "Node word 1 at node offset 0x04. Physical address of source 1 (for macroblock formats the chroma address; the luma address goes to Y1_ADDR). Source: hi3520D_tde.ko TdeHalNodeSet* (offsets and bit positions) and HiSTB v1 tde_hal.h (names).";
        field {
            name = "addr";
            desc = "Physical address (TdeHalNodeSetSrc1). VERIFIED IN THE HI3520D MODULE (HIGH): position seen in hi3520D_tde.ko. Not verified on hardware.";
            sw = rw;
            hw = r;
        } addr[31:0];
    } NODE_S1_ADDR @ 0x04;

    reg {
        name = "Source 1 type";
        desc = "Node word 2 at node offset 0x08. Layout shared with S2_TYPE. Source: hi3520D_tde.ko TdeHalNodeSet* (offsets and bit positions) and HiSTB v1 tde_hal.h (names).";
        field {
            name = "pitch";
            desc = "Line pitch in bytes (for MB formats the chroma pitch). VERIFIED IN THE HI3520D MODULE (HIGH): position seen in hi3520D_tde.ko. Not verified on hardware.";
            sw = rw;
            hw = r;
        } pitch[15:0];
        field {
            name = "fmt";
            desc = "Pixel format: 0 RGB444, 1 RGB555, 2 RGB565, 3 RGB888, 4 ARGB4444, 5 ARGB1555, 6 ARGB8565, 7 ARGB8888, 8..11 CLUT1/2/4/8, 12 ACLUT44, 13 ACLUT88, 16 A1, 17 A8, 18 YCbCr888, 19 AYCbCr8888, 20 YCbCr422, 22 byte, 23 halfword, 24..28 macroblock formats (values from the HiSTB enum; the module separates <=23 from >=24 and <=7 for the ARGB order, matching the enum). VERIFIED IN THE HI3520D MODULE (HIGH): position seen in hi3520D_tde.ko. Not verified on hardware.";
            sw = rw;
            hw = r;
        } fmt[20:16];
        field {
            name = "alpha_range";
            desc = "Alpha range (0..255 versus 0..128). VERIFIED IN THE HI3520D MODULE (HIGH): position seen in hi3520D_tde.ko. Not verified on hardware.";
            sw = rw;
            hw = r;
        } alpha_range[21:21];
        field {
            name = "colorize";
            desc = "Colorize enable (Src2 only; set by TdeHalNodeSetColorize). VERIFIED IN THE HI3520D MODULE (HIGH): position seen in hi3520D_tde.ko. Not verified on hardware.";
            sw = rw;
            hw = r;
        } colorize[22:22];
        field {
            name = "hscan";
            desc = "Horizontal scan direction (0 left to right, 1 reversed). VERIFIED IN THE HI3520D MODULE (HIGH): position seen in hi3520D_tde.ko. Not verified on hardware.";
            sw = rw;
            hw = r;
        } hscan[24:24];
        field {
            name = "vscan";
            desc = "Vertical scan direction. VERIFIED IN THE HI3520D MODULE (HIGH): position seen in hi3520D_tde.ko. Not verified on hardware.";
            sw = rw;
            hw = r;
        } vscan[25:25];
        field {
            name = "rgb_exp";
            desc = "RGB expand mode: cleared by SetSrc1/SetSrc2, set by TdeHalNodeSetExpAlpha (ARGB1555 alpha expansion). VERIFIED IN THE HI3520D MODULE (HIGH): position seen in hi3520D_tde.ko. Not verified on hardware.";
            sw = rw;
            hw = r;
        } rgb_exp[29:29];
    } NODE_S1_TYPE @ 0x08;

    reg {
        name = "Source 1 position";
        desc = "Node word 3 at node offset 0x0C. Layout shared with S2_XY. Source: hi3520D_tde.ko TdeHalNodeSet* (offsets and bit positions) and HiSTB v1 tde_hal.h (names).";
        field {
            name = "x";
            desc = "First X. VERIFIED IN THE HI3520D MODULE (HIGH): position seen in hi3520D_tde.ko. Not verified on hardware.";
            sw = rw;
            hw = r;
        } x[11:0];
        field {
            name = "y";
            desc = "First Y. VERIFIED IN THE HI3520D MODULE (HIGH): position seen in hi3520D_tde.ko. Not verified on hardware.";
            sw = rw;
            hw = r;
        } y[27:16];
    } NODE_S1_XY @ 0x0C;

    reg {
        name = "Source 1 fill value";
        desc = "Node word 4 at node offset 0x10. Fill color for quick fill (TdeHalNodeSetBaseOperate, mode 0). Source: hi3520D_tde.ko TdeHalNodeSet* (offsets and bit positions) and HiSTB v1 tde_hal.h (names).";
        field {
            name = "data";
            desc = "Fill data, packed in the target pixel format. VERIFIED IN THE HI3520D MODULE (HIGH): position seen in hi3520D_tde.ko. Not verified on hardware.";
            sw = rw;
            hw = r;
        } data[31:0];
    } NODE_S1_FILL @ 0x10;

    reg {
        name = "Source 2 address";
        desc = "Node word 5 at node offset 0x14. As S1_ADDR. Source: hi3520D_tde.ko TdeHalNodeSet* (offsets and bit positions) and HiSTB v1 tde_hal.h (names).";
        field {
            name = "addr";
            desc = "Physical address (TdeHalNodeSetSrc2). VERIFIED IN THE HI3520D MODULE (HIGH): position seen in hi3520D_tde.ko. Not verified on hardware.";
            sw = rw;
            hw = r;
        } addr[31:0];
    } NODE_S2_ADDR @ 0x14;

    reg {
        name = "Source 2 type";
        desc = "Node word 6 at node offset 0x18. Same layout as S1_TYPE (TdeHalNodeSetSrc2 writes the identical bit positions). Source: hi3520D_tde.ko TdeHalNodeSet* (offsets and bit positions) and HiSTB v1 tde_hal.h (names).";
        field {
            name = "pitch";
            desc = "Line pitch. VERIFIED IN THE HI3520D MODULE (HIGH): position seen in hi3520D_tde.ko. Not verified on hardware.";
            sw = rw;
            hw = r;
        } pitch[15:0];
        field {
            name = "fmt";
            desc = "Pixel format (as S1_TYPE). VERIFIED IN THE HI3520D MODULE (HIGH): position seen in hi3520D_tde.ko. Not verified on hardware.";
            sw = rw;
            hw = r;
        } fmt[20:16];
        field {
            name = "alpha_range";
            desc = "Alpha range. VERIFIED IN THE HI3520D MODULE (HIGH): position seen in hi3520D_tde.ko. Not verified on hardware.";
            sw = rw;
            hw = r;
        } alpha_range[21:21];
        field {
            name = "colorize";
            desc = "Colorize enable. VERIFIED IN THE HI3520D MODULE (HIGH): position seen in hi3520D_tde.ko. Not verified on hardware.";
            sw = rw;
            hw = r;
        } colorize[22:22];
        field {
            name = "hscan";
            desc = "Horizontal scan direction. VERIFIED IN THE HI3520D MODULE (HIGH): position seen in hi3520D_tde.ko. Not verified on hardware.";
            sw = rw;
            hw = r;
        } hscan[24:24];
        field {
            name = "vscan";
            desc = "Vertical scan direction. VERIFIED IN THE HI3520D MODULE (HIGH): position seen in hi3520D_tde.ko. Not verified on hardware.";
            sw = rw;
            hw = r;
        } vscan[25:25];
        field {
            name = "rgb_exp";
            desc = "RGB expand mode. VERIFIED IN THE HI3520D MODULE (HIGH): position seen in hi3520D_tde.ko. Not verified on hardware.";
            sw = rw;
            hw = r;
        } rgb_exp[29:29];
    } NODE_S2_TYPE @ 0x18;

    reg {
        name = "Source 2 position";
        desc = "Node word 7 at node offset 0x1C. As S1_XY. Source: hi3520D_tde.ko TdeHalNodeSet* (offsets and bit positions) and HiSTB v1 tde_hal.h (names).";
        field {
            name = "x";
            desc = "First X. VERIFIED IN THE HI3520D MODULE (HIGH): position seen in hi3520D_tde.ko. Not verified on hardware.";
