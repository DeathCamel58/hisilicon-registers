regfile eHISI_TDE_V1 {
    name = "HiSilicon TDE v1 (linked-list engine), candidate register map";
    desc = "CANDIDATE LAYOUT, LOW CONFIDENCE, NOT HARDWARE VERIFIED, NOT INSTANTIATED. Register map of the HiSilicon TDE v1 (2013-2016 'AQ' linked-list 2D engine) as programmed by the HiSTB SDK driver (HiSTB SDK `source/msp/drv/tde/adp/tde_v1_0/tde_hal.h` + `tde_hal_k.c` (proprietary SDK upload, https://github.com/JasonFreeLab/HiSTBLinuxV100R005C00SPC050; offsets, names and written values only, no text copied)): a 42-word node image at 0x0-0xA4 (TDE_HWNode_S: instruction, two sources, target, colour conversion, CLUT, resize, de-flicker, ALU, colour key, clip, macro-block addresses, ARGB order, colorize, alpha blend, CSC tables) and control registers at 0x804-0x86C (reset, start, list address/next address/update masks, status, interrupt, bus limiter, request threshold, AXI ID); TDE_REG_SIZE 0x1000. Applicability to the Hi3520D (TDE at 0x20610000, GIC interrupt 70), Hi3516 V100, Hi3516A/D, Hi3518E/3516C, Hi3519 generations: the Hi3520D data sheet 8.1 feature list (ROP, colour key, clip, alpha, 2D resize, anti-flicker, register linked list) is the TDE v1 feature set, but the revision is unverified. Probe before use: read 0x20610000 + 0x814 (TDE_STA, expect bit 0 clear when idle) and + 0x818 (TDE_INT) with the TDE clock enabled; a Hi3510-style engine would instead answer at + 0x0/+0x80 (`eHISI_TDE_V0`). Node word bit layouts are not in the fetched files (they are in the SDK's TDE union header); only the packings visible in the driver are noted. Everything is marked `[inferred]`; reset values and access types unknown (modelled RW, no reset).

    Generated 2026-11-10 by build/rdl-audit/video-rdl-scratch/gen_tde.py.";

    reg {
        name = "Ins (node word 0)";
        desc = "[inferred] Instruction word of the node (operation type, enables; bit 14 = clip enable per the driver). Node word 0 of the TDE_HWNode_S register image: the engine loads these 42 words from the linked list (AQ) in DDR; the same words are readable here (HiSTB SDK `source/msp/drv/tde/adp/tde_v1_0/tde_hal.h` + `tde_hal_k.c` (proprietary SDK upload, https://github.com/JasonFreeLab/HiSTBLinuxV100R005C00SPC050; offsets, names and written values only, no text copied)).";

        field {
            name = "value";
            desc = "[inferred] 32-bit register value (bit layout not in the source).";
            sw = rw;
            hw = r;
        } value[31:0];
    } TDE_INS @ 0x0;

    reg {
        name = "S1 Addr (node word 1)";
        desc = "[inferred] Source 1 address. Node word 1 of the TDE_HWNode_S register image: the engine loads these 42 words from the linked list (AQ) in DDR; the same words are readable here (HiSTB SDK `source/msp/drv/tde/adp/tde_v1_0/tde_hal.h` + `tde_hal_k.c` (proprietary SDK upload, https://github.com/JasonFreeLab/HiSTBLinuxV100R005C00SPC050; offsets, names and written values only, no text copied)).";

        field {
            name = "value";
            desc = "[inferred] 32-bit register value (bit layout not in the source).";
            sw = rw;
            hw = r;
        } value[31:0];
    } TDE_S1_ADDR @ 0x4;

    reg {
        name = "S1 Type (node word 2)";
        desc = "[inferred] Source 1 type (colour format, pitch...). Node word 2 of the TDE_HWNode_S register image: the engine loads these 42 words from the linked list (AQ) in DDR; the same words are readable here (HiSTB SDK `source/msp/drv/tde/adp/tde_v1_0/tde_hal.h` + `tde_hal_k.c` (proprietary SDK upload, https://github.com/JasonFreeLab/HiSTBLinuxV100R005C00SPC050; offsets, names and written values only, no text copied)).";

        field {
            name = "value";
            desc = "[inferred] 32-bit register value (bit layout not in the source).";
            sw = rw;
            hw = r;
        } value[31:0];
    } TDE_S1_TYPE @ 0x8;

    reg {
        name = "S1 Xy (node word 3)";
        desc = "[inferred] Source 1 start position. Node word 3 of the TDE_HWNode_S register image: the engine loads these 42 words from the linked list (AQ) in DDR; the same words are readable here (HiSTB SDK `source/msp/drv/tde/adp/tde_v1_0/tde_hal.h` + `tde_hal_k.c` (proprietary SDK upload, https://github.com/JasonFreeLab/HiSTBLinuxV100R005C00SPC050; offsets, names and written values only, no text copied)).";

        field {
