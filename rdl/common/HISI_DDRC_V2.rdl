            RATIO_DDRC_FREQUENCY_2 = 1 { name = "Ratio Ddrc Frequency 2"; desc = "The ratio of the DDRC frequency to the PHY frequency is 1:2. Only the HDR mode is supported. Therefore, this bit is fixed at 1."; };
