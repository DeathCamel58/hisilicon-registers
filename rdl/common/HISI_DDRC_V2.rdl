Data sheet 4.1.5 AXI_FLUX0 (offset 0x280, printed page 4-39, dump line 33726).";

        enum AXI_FLUX0_flux_port_en0_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "flux_port_en0";
            desc = "AXI interface DDRC traffic statistics enable";
            sw = rw;
            hw = r;
            encode = AXI_FLUX0_flux_port_en0_enum;
            reset = 0x0;
        } flux_port_en0[21:21];

        enum AXI_FLUX0_flux_ovfl_en0_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED_WHEN_THIS = 1 { name = "Enabled When This"; desc = "enabled When this field is set to 1, the bandwidth of the AXI interface can exceed the configured traffic if the AXI interface traffic exceeds the bandwidth limit, there is no AXI interface with traffic overflow, and a command request is initiated."; };
        };

        field {
            name = "flux_ovfl_en0";
            desc = "AXI interface traffic overflow allow enable";
            sw = rw;
            hw = r;
            encode = AXI_FLUX0_flux_ovfl_en0_enum;
            reset = 0x0;
        } flux_ovfl_en0[20:20];

        field {
            name = "flux_ovfl_lvl0";
            desc = "AXI interface traffic overflow threshold 0x0-0x10: DMC threshold for allowing traffic overflow Other values: reserved When the AXI interface traffic exceeds the configured bandwidth of flux, flux_ovfl is 1, and the number of commands to be processed in the DMC is less than the configured threshold, transmission is allowed. Otherwise, no arbitration is performed.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } flux_ovfl_lvl0[16:12];

        field {
            name = "flux_cfg0";
            desc = "Allowed bandwidth of the AXI interface 0x0-0x3FF: ratio of the maximum DDR bandwidth to the total bandwidth accessed by the AXI interface. The total bandwidth is 1024. The configured value is a ratio of the allowed bandwidth to the total bandwidth. Other values: reserved";
            sw = rw;
            hw = r;
            reset = 0x0;
        } flux_cfg0[9:0];
    } AXI_FLUX0[7] @ 0x280 += 0x4;

};

regfile eHISI_DDRC_V2_DMC {
    name = "DDRC V2 DMC registers";
    desc = "DMC (DDR memory controller) registers of the DDRC, data sheet 4.1.6 (Table 4-6, base 0x20111000): self-refresh/init/software-command control, SDRAM configuration (mode, rank volume, EMRS, timing 0-6 and their `NXT` shadow set), ODT, PHY interface, statistics counters, interrupts and status.

Initialisation order (data sheet 4.1.4.3 / vendor stock U-Boot image): CFG_SREF, CFG_AREF/CFG_PD off, CFG_WORKMODE, CFG_DDRMODE, CFG_RNKVOL, CFG_TIMING0-5, CFG_ODT, then the PHY registers (see eHISI_DDRC_V2_PHY), PHYINITCTRL, CFG_TIMING2 (enables auto-refresh), CTRL_SREF = 2 (exit self-refresh) and poll CURR_FUNC.in_sref == 0, then CTRL_SREF.sref_done = 1.";

    reg {
        name = "DDRC self-refresh control register";
        desc = "DDRC_CTRL_SREF is a DDRC self-refresh control register.

Data sheet 4.1.6 DDRC_CTRL_SREF (offset 0x0, printed page 4-44, dump line 33988).";

        field {
            name = "sref_done";
            desc = "DDR PHY self-refresh done 1: The transition from 0 to 1 indicates that the DDR PHY completes all required operations after exiting the self-refresh status and the DMC can accept new requests.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } sref_done[1:1];

        enum DDRC_CTRL_SREF_sref_req_enum {
            EXIT_SELF_REFRESH = 0 { name = "Exit Self Refresh"; desc = "exit the self-refresh status"; };
            ENTER_SELF_REFRESH = 1 { name = "Enter Self Refresh"; desc = "enter the self-refresh status"; };
        };

        field {
            name = "sref_req";
            desc = "SDRAM self-refresh request";
            sw = rw;
            hw = r;
            encode = DDRC_CTRL_SREF_sref_req_enum;
            reset = 0x1;
        } sref_req[0:0];
    } DDRC_CTRL_SREF @ 0x0;

    reg {
        name = "DDRC initialization control register";
        desc = "DDRC_CTRL_INIT is a DDRC initialization control register.

Data sheet 4.1.6 DDRC_CTRL_INIT (offset 0x4, printed page 4-44, dump line 34019).";

        enum DDRC_CTRL_INIT_dfi_init_start_enum {
            NORMAL_STATE = 0 { name = "Normal State"; desc = "normal state"; };
            DFI_INTERFACE_INITIALIZATION = 1 { name = "Dfi Interface Initialization"; desc = "DFI interface initialization is started, and the PHY implements related control processes. This bit is automatically cleared by hardware after initialization is complete."; };
        };

        field {
            name = "dfi_init_start";
            desc = "DFI initialization start";
            sw = rw;
            hw = r;
            encode = DDRC_CTRL_INIT_dfi_init_start_enum;
            reset = 0x0;
        } dfi_init_start[1:1];

        enum DDRC_CTRL_INIT_init_req_enum {
            INITIALIZATION_COMPLETE_INITIA = 0 { name = "Initialization Complete Initia"; desc = "Initialization is complete or initialization is performed properly."; };
            SDRAM_STARTS_INITIALIZED = 1 { name = "Sdram Starts Initialized"; desc = "The SDRAM starts to be initialized."; };
        };

        field {
            name = "init_req";
            desc = "Initialization enable";
            sw = rw;
            hw = r;
            encode = DDRC_CTRL_INIT_init_req_enum;
            reset = 0x0;
        } init_req[0:0];
    } DDRC_CTRL_INIT @ 0x4;

    reg {
        name = "DDRC software configuration command start register";
        desc = "DDRC_CTRL_SFC is a DDRC software configuration command start register.

Data sheet 4.1.6 DDRC_CTRL_SFC (offset 0xC, printed page 4-45, dump line 34064).";

        enum DDRC_CTRL_SFC_cmd_req_enum {
            COMMAND_NOT_EXECUTED = 0 { name = "Command Not Executed"; desc = "The command is not executed or the parameter is automatically cleared after the command is executed."; };
            COMMAND_REQUESTED_EXECUTED = 1 { name = "Command Requested Executed"; desc = "The command is requested to be executed."; };
        };

        field {
            name = "cmd_req";
            desc = "Request of executing the configuration command of the DDRC";
            sw = rw;
            hw = r;
            encode = DDRC_CTRL_SFC_cmd_req_enum;
            reset = 0x0;
        } cmd_req[0:0];
    } DDRC_CTRL_SFC @ 0xC;

    reg {
        name = "DDRC performance statistics control register";
        desc = "DDRC_CTRL_PERF is a DDRC performance statistics enable register.

The data sheet Total Reset Value is 0x0014F000 although the bit table lists only perf_en [0]; the non-zero reserved bits are modelled as a `reserved_*` field so that the total matches.

Data sheet 4.1.6 DDRC_CTRL_PERF (offset 0x10, printed page 4-45, dump line 34093).

Hardware (Hi3518E V200 board, live dump): reads 0x00000000 at U-Boot and under Linux, with nothing in the vendor init writing it, although the data sheet total reset value is 0x0014F000 (reserved non-zero bits). The reserved bits are probably read as 0.";

        field {
            name = "reserved_31_1";
            desc = "Reserved in the data sheet bit table, but the data sheet Total Reset Value has non-zero bits here (reset 0xA7800). Modelled so that the register reset matches the data sheet.";
            sw = r;
            hw = w;
            reset = 0x000A7800;
        } reserved_31_1[31:1];

        enum DDRC_CTRL_PERF_perf_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "perf_en";
            desc = "Performance statistics mode";
            sw = rw;
            hw = r;
            encode = DDRC_CTRL_PERF_perf_en_enum;
            reset = 0x0;
        } perf_en[0:0];
    } DDRC_CTRL_PERF @ 0x10;

    reg {
        name = "DDR self-refresh configuration register";
        desc = "DDRC_CFG_SREF is a DDRC self-refresh configuration register.

Data sheet 4.1.6 DDRC_CFG_SREF (offset 0x20, printed page 4-46, dump line 34131).";

        field {
            name = "sref_arefnum";
            desc = "Number of self-refresh operations initiated after DDRn SDRAM exits the self-refresh status during the DFS process 0x0: No self-refresh operation is initiated. 0x1-0xF: n";
            sw = rw;
            hw = r;
            reset = 0x0;
        } sref_arefnum[15:12];

        enum DDRC_CFG_SREF_clk_switch_enum {
            INTERFACE_COMMANDS_NOT = 0 { name = "Interface Commands Not"; desc = "The interface commands are not back pressed, and an error is returned directly."; };
            INTERFACE_COMMANDS_BACK = 1 { name = "Interface Commands Back"; desc = "The interface commands are back pressed, and the original command is executed after the clock is switched."; };
        };

        field {
            name = "clk_switch";
            desc = "DDRC low-power clock switch. Whether to back press AXI interface command when the DDRC enters the low-power status (DDR self-refresh).";
            sw = rw;
            hw = r;
            encode = DDRC_CFG_SREF_clk_switch_enum;
            reset = 0x0;
        } clk_switch[8:8];

        enum DDRC_CFG_SREF_sref_odis_enum {
            ENABLED = 0 { name = "Enabled"; desc = "enabled"; };
            DISABLED = 1 { name = "Disabled"; desc = "disabled"; };
        };

        field {
            name = "sref_odis";
            desc = "Output disable for the DDR command and data I/O in self-refresh mode.";
            sw = rw;
            hw = r;
            encode = DDRC_CFG_SREF_sref_odis_enum;
            reset = 0x0;
        } sref_odis[4:4];

        enum DDRC_CFG_SREF_sref_cc_enum {
            SDRAM_CLOCK_ENABLED = 0 { name = "Sdram Clock Enabled"; desc = "The SDRAM clock is enabled."; };
            SDRAM_CLOCK_DISABLED = 1 { name = "Sdram Clock Disabled"; desc = "The SDRAM clock is disabled."; };
        };

        field {
            name = "sref_cc";
            desc = "SDRAM clock control in self-refresh mode";
            sw = rw;
            hw = r;
            encode = DDRC_CFG_SREF_sref_cc_enum;
            reset = 0x0;
        } sref_cc[0:0];
    } DDRC_CFG_SREF @ 0x20;

    reg {
        name = "DDRC vendor register at 0x24 (not in the data sheet)";
        desc = "Not in the Hi3518E V20X / Hi3516C V200 data sheet (the DMC list jumps from DDRC_CFG_SREF 0x20 to DDRC_CFG_PD 0x28). The vendor register table (OpenIPC/vendor U-Boot reg_info for Hi3518E V200, DDR2) writes 0x00000008 here before DDRC_CFG_PD, and a live dump of a Hi3518E V200 board reads 0x00000008 at U-Boot and under Linux, so the register exists and holds the written value. [inferred] Probably a self-refresh / power-down related timing word next to DDRC_CFG_SREF and DDRC_CFG_PD; meaning unknown. Reset value unknown (not 0x8 necessarily).";
        field { name = "value"; desc = "[inferred] Undocumented word (vendor table writes 0x8)"; sw = rw; hw = r; } value[31:0];
    } DDRC_VENDOR_24 @ 0x24;

    reg {
        name = "DDR power-down status register";
        desc = "DDRC_CFG_PD is a DDR power-down status register.

The data sheet titles this register 'power-down status register' but all its fields are read/write configuration fields. The vendor U-Boot writes 0x401 (pd_prd = 0x40, pd_en = 1) after DDR training (lowlevel_init_v300.c: `the value should config after training, or it will cause chip compatibility problems`) and 0 during initialisation.

Data sheet 4.1.6 DDRC_CFG_PD (offset 0x28, printed page 4-47, dump line 34197).

Hardware (Hi3518E V200 board, live dump): reads 0x00000401 (pd_en 1, pd_prd 0x40) at U-Boot and under Linux. The vendor register table writes 0 first; the value 0x401 is written by the SPL AFTER DDR training (start_ddr_training, 'should config after training, or it will cause chip compatibility problems'), so the live value confirms that write.";

        field {
            name = "t_clk_cke";
            desc = "Relationship between CKL and CKE 0x0-0x7: The delay relative to CKE when the PHY disables the clock is related to the DDR PHY. For example, it is set to 5 for SNPS G2 MULTIPHY or 0 for SNPS 32PHY.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } t_clk_cke[23:20];

        enum DDRC_CFG_PD_pd_ac_enum {
            ENABLED = 0 { name = "Enabled"; desc = "enabled"; };
            DISABLED = 1 { name = "Disabled"; desc = "disabled"; };
        };

        field {
            name = "pd_ac";
            desc = "SDRAM address command dynamic disable in power-down mode";
            sw = rw;
            hw = r;
            encode = DDRC_CFG_PD_pd_ac_enum;
            reset = 0x0;
        } pd_ac[16:16];

        enum DDRC_CFG_PD_pd_cc_enum {
            SDRAM_CLOCK_ENABLED = 0 { name = "Sdram Clock Enabled"; desc = "The SDRAM clock is enabled."; };
            SDRAM_CLOCK_DISABLED = 1 { name = "Sdram Clock Disabled"; desc = "The SDRAM clock is disabled. Note: This field is valid only when the LPDDR SDRAM or LPDDR2 SDRAM is used."; };
        };

        field {
            name = "pd_cc";
            desc = "SDRAM clock control in power-down mode";
            sw = rw;
            hw = r;
            encode = DDRC_CFG_PD_pd_cc_enum;
            reset = 0x0;
        } pd_cc[12:12];

        field {
            name = "pd_prd";
            desc = "SDRAM power-down cycle. When the DDRC does not receive any command in consecutive pd_prd cycles, it forces the SDRAM to enter the power-down status. When a command is received, the DDRC forces the SDRAM to exit the power-down status. 0x00: not to enter the power-down status 0x01-0xFF: n clock cycles";
            sw = rw;
            hw = r;
            reset = 0x0;
        } pd_prd[11:4];

        enum DDRC_CFG_PD_pd_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "pd_en";
            desc = "Automatic power-down enable for the SDRAM";
            sw = rw;
            hw = r;
            encode = DDRC_CFG_PD_pd_en_enum;
            reset = 0x0;
        } pd_en[0:0];
