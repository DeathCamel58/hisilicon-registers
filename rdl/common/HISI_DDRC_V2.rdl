regfile eHISI_DDRC_V2_PHY {
    name = "DDRC V2 DDR PHY registers";
    desc = "DDR PHY registers, data sheet 4.1.7 (Table 4-7, base 0x20118000): PHY initialisation control/status, PLL, delay measurement, ZQ impedance calibration, DRAM configuration/timers, training (write leveling, gate, read/write data eye), BIST, address/command block (AC*) and the four data blocks `DX[n]`.";

    reg {
        name = "PHY control block version register";
        desc = "REVISION is a PHY control block version register.

Data sheet 4.1.7 REVISION (offset 0x0, printed page 4-96, dump line 37030).

Hardware: reads 0x00000012 on a Hi3518E V200 board (matches the reset value; never written).";

        field {
            name = "major";
            desc = "Major version of the PHY control block";
            sw = r;
            hw = w;
            reset = 0x0;
        } major[15:8];

        field {
            name = "minor";
            desc = "Minor version of the PHY control block";
            sw = r;
            hw = w;
            reset = 0x12;
        } minor[7:0];
    } REVISION @ 0x0;

    reg {
        name = "PHY initialization control register";
        desc = "Data sheet 4.1.7 PHYINITCTRL (offset 0x4, printed page 4-97, dump line 37063).

Hardware (Hi3518E V200 board, live dump of the PHY window): reads 0x80000000 at U-Boot and under Linux, i.e. after init and training only ctl_cke_bypass (bit 31) remains set and all trigger bits are 0 (the vendor table writes 0x80000021 for gate training, polls until the low bits clear, then clears phyconn_rst).";

        field {
            name = "ctl_cke_bypass";
            desc = "PACK CKE bypass function enable 1'b1: CKE is controlled by MC even when PACK controls the DFI interface. 1'b0: CKE is controlled by PACK when PACK controls the DFI interface.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } ctl_cke_bypass[31:31];

        field {
            name = "phyconn_rst";
            desc = "PHY counter reset This field is used to set the PHY counter reset signal. To issue a reset signal to PHY counter, this field should be set to 1. To end the reset signal to PHY counter, this field should be cleared. Note that the reset signal connects to the A/C block counter and the counter of all of the data blocks.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } phyconn_rst[15:15];

        field {
            name = "pack_rst";
            desc = "PACK reset This field is used to issue reset to all the digital circuits of the PACK including the register file. If this field is set to 1, all of the digital parts (including control registers) of the PHY will be set to default value. The reset will be automatically executed, and this bit will be cleared after reset is complete.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } pack_rst[14:14];

        field {
            name = "phy_rst";
            desc = "PHY reset This field is used to set PHY reset signal. To issue a reset signal to the PHY, this field should be set to 1. To end the reset signal to the PHY, this field should be cleared. Note that the reset signal connects to the A/C block and all of the data blocks.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } phy_rst[13:13];

        field {
            name = "dram_rst";
            desc = "DRAM reset This field is used to initiate the DRAM reset sequence. If this field is set to 1, RESET# and CKE will be pulled low for t_dram_rst. After t_dram_rst, the CKE RESET# is pulled to high while keeping CKE at low for t_cke_low. After t_cke_low, CKE is pulled to high, and after t_cke_high, this field is cleared automatically. For LPDDR2/LPDDR3, only CKE will be active during DRAM reset sequence.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } dram_rst[12:12];

        field {
            name = "cat_en";
            desc = "HW CA training enable Writing 1 to this field starts the HW CA training sequence. This field will be cleared after CA training is complete. Note that the CA training applies only to LPDDR3.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } cat_en[11:11];

        field {
            name = "dram_init_en";
            desc = "DRAM initialization enable This field is used to control whether the internal DRAM initialization sequence is executed after PHY initialization is complete. For LPDDR2/LPDDR3, this field will complete the initial sequence including tINIT3-tINIT5 & tZQC.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } dram_init_en[10:10];

        field {
            name = "wdet_en";
            desc = "Write data eye training enable Writing 1 to this field starts the write data eye training sequence. This field will be cleared after the write data eye training is complete.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } wdet_en[9:9];

        field {
            name = "rdet_en";
            desc = "Read data eye training enable Writing 1 to this field starts the read data eye training sequence. This field will be cleared after the read data eye training is complete.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } rdet_en[8:8];

        field {
            name = "wl2_en";
            desc = "Second write leveling enable Writing 1 to this field starts write latency adjustment. This field will be cleared after adjustment is complete. Note that write leveling adjustment applies only to DDR3.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } wl2_en[7:7];

        field {
            name = "gdst_en";
            desc = "PHY read data latch train enable Writing 1 to this field starts the read data latch position training. This field will be cleared after write leveling is complete.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } gdst_en[6:6];

        field {
            name = "gt_en";
            desc = "Gate training enable Writing 1 to this field starts the gate training sequence. This field will be cleared after the gate training is complete.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } gt_en[5:5];

        field {
            name = "wl_en";
            desc = "Write leveling enable Writing 1 to this field starts the write leveling sequence. This field will be cleared after write leveling is complete. Note that write leveling applies only to DDR3.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } wl_en[4:4];

        field {
            name = "zcal_en";
            desc = "Impedance calibration enable This field is used to specify whether impedance calibration is executed. This bit will be cleared after impedance calibration is complete.";
            sw = rw;
            hw = r;
            reset = 0x1;
        } zcal_en[3:3];

        field {
            name = "dlymeas_en";
            desc = "Delay measurement enable This field is used to enable initial delay measurement of the activated read delay line. If it is set to 1, delay measurement is enabled.";
            sw = rw;
            hw = r;
            reset = 0x1;
        } dlymeas_en[2:2];

        field {
            name = "pll_init_en";
            desc = "PLL initialization enable If this field is used to activate the PLL initialization. If it is set to 1, the PLL is reset and waiting for a period of time for PLL to be locked.";
            sw = rw;
            hw = r;
            reset = 0x1;
        } pll_init_en[1:1];

        field {
            name = "init_en";
            desc = "PHY initialization enable Writing 1 to this field triggers the PHY initialization sequence. The exact initialization executed is specified in bits 1-15 of this register. If PHY initialization is complete, this bit will be cleared. Note that writing 0 to this field has no effect.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } init_en[0:0];
    } PHYINITCTRL @ 0x4;

    reg {
        name = "PHY status register";
        desc = "PHYINITSTATUS is a PHY status register.

All error flags are `RWC` in the data sheet: modelled write-1-to-clear (the text of each field says writing 1 clears the error status).

Data sheet 4.1.7 PHYINITSTATUS (offset 0x8, printed page 4-99, dump line 37194).";

        field {
            name = "cat_err";
            desc = "CA training error This field indicates whether an error occurs during CA training. Writing 1 to this field clears the error status.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            reset = 0x0;
        } cat_err[10:10];

        field {
            name = "wdet_err";
            desc = "Write data eye calibration error This field indicates whether an error occurs during write data eye calibration. Writing 1 to this field clears the error status.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            reset = 0x0;
        } wdet_err[9:9];

        field {
            name = "rdet_err";
            desc = "Read data eye calibration error This field indicates whether an error occurs during read data eye calibration. Writing 1 to this field clears the error status.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            reset = 0x0;
        } rdet_err[8:8];

        field {
            name = "wl2_err";
            desc = "Write leveling adjustment error This field indicates whether an error occurs during write leveling adjustment. Writing 1 to this field clears the error status.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            reset = 0x0;
        } wl2_err[7:7];

        field {
            name = "gdst_err";
            desc = "PHY read data latch train error This field indicates whether an error occurs during read data latch training. Writing 1 to this field clears the error status.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            reset = 0x0;
        } gdst_err[6:6];

        field {
            name = "gt_err";
            desc = "Gate training error This field indicates whether an error occurs during gate training. Writing 1 to this field clears the error status.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            reset = 0x0;
        } gt_err[5:5];

        field {
            name = "wl_err";
            desc = "Write leveling error This field indicates whether an error occurs during write leveling. Writing 1 to this field clears the error status.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            reset = 0x0;
        } wl_err[4:4];

        field {
            name = "zcal_err";
            desc = "Impedance calibration error This field indicates whether an error occurs during impedance calibration. Writing 1 to this field clears the error status.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            reset = 0x0;
        } zcal_err[3:3];

        field {
            name = "dlymeas_err";
            desc = "Delay measurement fail This field indicates whether one of the initial delay measurements fails. Writing 1 to this field clears the error status.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            reset = 0x0;
        } dlymeas_err[2:2];

        field {
            name = "pll_lock_err";
            desc = "PLL locked fail This field indicates whether one of the PLLs within the PHY fails to assert locked flag after t_pll_lock timer. Writing 1 to this field clears the error status.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            reset = 0x0;
        } pll_lock_err[1:1];
    } PHYINITSTATUS @ 0x8;

    reg {
        name = "PHY clock gating control register";
        desc = "PHYCLKGATED is a PHY clock gating control register.

Data sheet 4.1.7 PHYCLKGATED (offset 0xC, printed page 4-100, dump line 37263).

Hardware (Hi3518E V200 board, live dump): the vendor table writes 0x80000F0F, the PHY reads 0x80000F03 at U-Boot and under Linux, so dx_phy_clkgated[3:2] (data lanes 2 and 3, unused with the 16-bit bus) read 0. Nothing in the vendor training writes this register; the change is made by the PHY or the init.";

        enum PHYCLKGATED_byp_pll_lock_enum {
            USE_PLL_LOCK = 0 { name = "Use Pll Lock"; desc = "use the PLL lock to gate the PHY clocks to prevent clock glitch"; };
            BYPASS_PLL_LOCK = 1 { name = "Bypass Pll Lock"; desc = "bypass the PLL lock (do not use the PLL lock signal to gate the PHY clocks)"; };
        };

        field {
            name = "byp_pll_lock";
            desc = "PLL lock bypass. The user can assert this field to bypass the PLL lock signal when re-locking the PLL in the bypass mode (DFS) or when the PLL lock signal cannot be used.";
            sw = rw;
            hw = r;
            encode = PHYCLKGATED_byp_pll_lock_enum;
            reset = 0x0;
        } byp_pll_lock[31:31];

        enum PHYCLKGATED_dx_phgated_men_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "dx_phgated_men";
            desc = "PHY phase clock gated manual control enable. This field takes effect only when dx_phgated_en is 1'b0. If dx_phgated_en is high and this field is high, the user can use dx_phclkgated to manually control the clock gating of the PHY phase clock.";
            sw = rw;
            hw = r;
            encode = PHYCLKGATED_dx_phgated_men_enum;
            reset = 0x0;
        } dx_phgated_men[12:12];

        enum PHYCLKGATED_dx_phclkgated_enum {
            CLOCK_DISABLED = 0 { name = "Clock Disabled"; desc = "The clock is disabled."; };
            CLOCK_ENABLED = 1 { name = "Clock Enabled"; desc = "The clock is enabled."; };
        };

        field {
            name = "dx_phclkgated";
            desc = "PHY phase clock gated control. This field takes effect only when dx_phgated_en is 1'b0. If dx_phgated_en is '1b1, this field is used, and the gated function is automatically controlled by PACK FSM.";
            sw = rw;
            hw = r;
            encode = PHYCLKGATED_dx_phclkgated_enum;
            reset = 0x0;
        } dx_phclkgated[11:11];

        enum PHYCLKGATED_dx_phgated_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "dx_phgated_en";
            desc = "PHY phase clock gated function (automatically controlled by PACK FSM) enable";
            sw = rw;
            hw = r;
            encode = PHYCLKGATED_dx_phgated_en_enum;
            reset = 0x1;
        } dx_phgated_en[10:10];

        enum PHYCLKGATED_ck_phy_clkgated_enum {
            CLOCK_GATED = 0 { name = "Clock Gated"; desc = "The clock is gated."; };
            CLOCK_ENABLED = 1 { name = "Clock Enabled"; desc = "The clock is enabled."; };
        };

        field {
            name = "ck_phy_clkgated";
            desc = "Dedicated clock gated control for the output CK and related circuits";
            sw = rw;
            hw = r;
            encode = PHYCLKGATED_ck_phy_clkgated_enum;
            reset = 0x0;
        } ck_phy_clkgated[9:9];

        enum PHYCLKGATED_ac_phy_clkgated_enum {
            CLOCK_GATED = 0 { name = "Clock Gated"; desc = "The clock is gated."; };
            CLOCK_ENABLED = 1 { name = "Clock Enabled"; desc = "The clock is enabled."; };
        };

        field {
            name = "ac_phy_clkgated";
            desc = "Clock gated for the circuits in AC block except CK and CK related circuits";
            sw = rw;
            hw = r;
            encode = PHYCLKGATED_ac_phy_clkgated_enum;
            reset = 0x0;
        } ac_phy_clkgated[8:8];

        enum PHYCLKGATED_dx_phy_clkgated_enum {
            CLOCK_GATED = 0 { name = "Clock Gated"; desc = "The clock is gated."; };
            CLOCK_ENABLED = 1 { name = "Clock Enabled"; desc = "The clock is enabled."; };
        };

        field {
            name = "dx_phy_clkgated";
            desc = "Clock gated for circuits in data blocks";
            sw = rw;
            hw = r;
            encode = PHYCLKGATED_dx_phy_clkgated_enum;
            reset = 0x0;
        } dx_phy_clkgated[3:0];
    } PHYCLKGATED @ 0xC;

    reg {
        name = "PHY timing parameter register";
        desc = "PHYTIMER0 is a PHY timing parameter register. The timing parameters are required by the PHY.

Data sheet 4.1.7 PHYTIMER0 (offset 0x10, printed page 4-102, dump line 37361).";

        field {
            name = "t_dram_cke_high";
            desc = "DRAM CKE high initialization This field specifies the number of PCLK clock cycles of the first DRAM command from CKE pulled to high (LPDDR2/LPDDR3 tINIT3).";
            sw = rw;
            hw = r;
            reset = 0x00027100;
        } t_dram_cke_high[31:12];

        field {
            name = "t_dram_reset";
            desc = "DDR3 DRAM reset. This field is used to specify the time issuing reset signaling to the DRAM (number of PCLK clock cycles).";
            sw = rw;
            hw = r;
            reset = 0xF;
        } t_dram_reset[7:0];
    } PHYTIMER0 @ 0x10;

    reg {
        name = "DRAM CKE low initialization register";
        desc = "PHYTIMER1 is a DRAM CKE low initialization register.

Data sheet 4.1.7 PHYTIMER1 (offset 0x14, printed page 4-102, dump line 37386).";

        field {
            name = "t_dram_cke_low";
            desc = "DRAM CKE low initialization This field specifies the number of PCLK clock cycles during which CKE should be kept low after power is reset and the clock is stable.";
            sw = rw;
            hw = r;
            reset = 0x2000;
        } t_dram_cke_low[15:0];
    } PHYTIMER1 @ 0x14;

    reg {
        name = "Timing parameter register for the PLL in both address/command and data block";
        desc = "PLLCTRL is a timing parameter register for the PLL in both address/command and data block.

Data sheet 4.1.7 PLLCTRL (offset 0x18, printed page 4-103, dump line 37419).";

        field {
            name = "pll_freq_range";
            desc = "PLL frequency range select This field specifies the frequency input range of the PLLs.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } pll_freq_range[5:4];

        field {
            name = "pll_pwdn";
            desc = "PLL power down This field is used to set the power-down status of the PLL input. If this field is set to 1, the PLL power-down pin is activated. Writing 0 to this field will remove the deactivated PLL power down pin. Bit[2] for AC PLL Bit[1] for DX1 (DATA1) PLL Bit[0] for DX0 (DATA0) PLL";
            sw = rw;
            hw = r;
            reset = 0x0;
        } pll_pwdn[2:0];
    } PLLCTRL @ 0x18;

    reg {
        name = "PLL address/command and data block control register";
        desc = "PLLTIMER is a PLL address/command and data block control register.

Data sheet 4.1.7 PLLTIMER (offset 0x1C, printed page 4-103, dump line 37456).";

        field {
            name = "t_pll_lock";
            desc = "PLL lock time This field specifies the number of PCLK clock cycles waiting for the PLL to be locked.";
            sw = rw;
            hw = r;
            reset = 0x4E20;
        } t_pll_lock[31:16];

        field {
            name = "t_pll_rst";
            desc = "PLL reset time This field specifies the number of PCLK clock cycles to issue reset to the PLL.";
            sw = rw;
            hw = r;
            reset = 0x80;
        } t_pll_rst[7:0];
    } PLLTIMER @ 0x1C;

    reg {
        name = "Read delay line delay measurement control register";
        desc = "DLYMEASCTRL is a read delay line delay measurement control register.

Data sheet 4.1.7 DLYMEASCTRL (offset 0x20, printed page 4-104, dump line 37492).";

        field {
            name = "dly_track_limit";
            desc = "Delay tracking limit This field specifies the maximum number of accumulated taps allowed while dynamic tracking.";
            sw = rw;
            hw = r;
            reset = 0x4;
        } dly_track_limit[14:8];

        field {
            name = "phy_autoref_en";
            desc = "PHY auto-refresh tracking enable";
            sw = rw;
            hw = r;
            reset = 0x1;
        } phy_autoref_en[6:6];

        field {
            name = "dynamic_dqsen";
            desc = "Dynamic DQS tracking enable This field should be set to high during delay measurement.";
            sw = rw;
            hw = r;
            reset = 0x1;
        } dynamic_dqsen[5:5];

        field {
            name = "dynamic_dqsgen";
            desc = "Dynamic DQSG tracking enable";
            sw = rw;
            hw = r;
            reset = 0x1;
        } dynamic_dqsgen[4:4];

        enum DLYMEASCTRL_dynamic_dqsgth_enum {
            UPDATE_EVERY_4 = 0 { name = "Update Every 4"; desc = "update every 4 times"; };
            UPDATE_EVERY_2 = 1 { name = "Update Every 2"; desc = "update every 2 times 2 or 3: update each time"; };
        };

        field {
            name = "dynamic_dqsgth";
            desc = "Dynamic DQSG update threshold This field specifies the number of taps accumulated before the RDQSG delay line is updated.";
            sw = rw;
            hw = r;
            encode = DLYMEASCTRL_dynamic_dqsgth_enum;
            reset = 0x0;
        } dynamic_dqsgth[3:2];

        field {
            name = "dly_track_type";
            desc = "Delay tracking type This field specifies whether priority updated from the PHY is used during dynamic tracking. If this field is set to 1, the priority updated from the PHY is used.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } dly_track_type[1:1];

        field {
            name = "dly_meas_type";
            desc = "Delay measurement type This field specifies whether the delay measurement is for one clock cycle or half a clock cycle. If this field is set to 1, a full clock cycle is measured.";
            sw = rw;
            hw = r;
            reset = 0x1;
        } dly_meas_type[0:0];
    } DLYMEASCTRL @ 0x20;

    reg {
        name = "ZQ calibration control register";
        desc = "IMPCTRL is a ZQ calibration control register.

Data sheet 4.1.7 IMPCTRL (offset 0x24, printed page 4-105, dump line 37553).";

        enum IMPCTRL_zcfuzzy_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled (default)"; };
        };

        field {
            name = "zcfuzzy_en";
            desc = "ZQ comparator result selection by weighted method. When this function is disabled, the precision is improved but ZQ comparison may fail. When this function is enabled, ZQ comparison is successful.";
            sw = rw;
            hw = r;
            encode = IMPCTRL_zcfuzzy_en_enum;
            reset = 0x1;
        } zcfuzzy_en[31:31];

        field {
            name = "zcomp_num";
            desc = "ZQ comparator iteration time This field specifies the iteration time of zcomp changing detection.";
            sw = rw;
            hw = r;
            reset = 0x8;
        } zcomp_num[15:12];

        field {
            name = "zcomp_rsp_dly";
            desc = "ZQ comparator response time This field specifies the delay of the zcomp result after zctrl is used.";
            sw = rw;
            hw = r;
            reset = 0x20;
        } zcomp_rsp_dly[5:0];
    } IMPCTRL @ 0x24;

    reg {
        name = "ZQ calibration result register";
        desc = "IMPSTATUS is a ZQ calibration status register.

The stock vendor image writes 0x121B0B18 here: the writable zcode_pdrv [21:16] / zcode_ndrv [5:0] manual impedance codes (the other fields are read-only calibration results).

Data sheet 4.1.7 IMPSTATUS (offset 0x28, printed page 4-106, dump line 37601).

Hardware (Hi3518E V200 board, live dump): the vendor table writes 0x121B0B18 (manual impedance codes) but the register reads 0x001B0018 at U-Boot and under Linux, so the PHY updates it (impedance calibration result), treat it as a status the PHY overwrites.";

        field {
            name = "zcode_pdrv_cal";
            desc = "P-drive impedance calibration code This field shows the p-drive calibration code during impedance calibration.";
            sw = r;
            hw = w;
            reset = 0x0;
        } zcode_pdrv_cal[30:24];

        enum IMPSTATUS_pdrv_cal_result_enum {
            CALIBRATION_COMPLETE_WITHOUT = 0 { name = "Calibration Complete Without"; desc = "The calibration is complete without error."; };
            CALIBRATION_COMPLETE_WITH = 1 { name = "Calibration Complete With"; desc = "The calibration is complete with an error. Writing 1 to this field clears this field."; };
        };

        field {
            name = "pdrv_cal_result";
            desc = "P-drive calibration result This field specifies the ZQ calibration result. The valid values are as follows:";
            sw = r;
            hw = w;
            encode = IMPSTATUS_pdrv_cal_result_enum;
            reset = 0x0;
        } pdrv_cal_result[23:23];

        field {
            name = "zcode_pdrv";
            desc = "P-drive impedance control code This field is used to specify the p-drive impedance control code. This register is updated by the user or is updated each time the ZQ calibration is complete.";
            sw = rw;
            hw = r;
            reset = 0x20;
        } zcode_pdrv[21:16];

        field {
            name = "zcode_ndrv_cal";
            desc = "N-drive impedance calibration code This field shows the n-driver calibration code during impedance calibration.";
            sw = r;
            hw = w;
            reset = 0x0;
        } zcode_ndrv_cal[14:8];

        enum IMPSTATUS_ndrv_cal_result_enum {
            CALIBRATION_COMPLETE_WITHOUT = 0 { name = "Calibration Complete Without"; desc = "The calibration is complete without error."; };
            CALIBRATION_COMPLETE_WITH = 1 { name = "Calibration Complete With"; desc = "The calibration is complete with an error. Writing 1 to this field clears this field."; };
        };

        field {
            name = "ndrv_cal_result";
            desc = "N-drive calibration result This field specifies the ZQ calibration result. The valid values are as follows:";
            sw = r;
            hw = w;
            encode = IMPSTATUS_ndrv_cal_result_enum;
            reset = 0x0;
        } ndrv_cal_result[7:7];

        field {
            name = "zcode_ndrv";
            desc = "N-drive impedance control code This field is used to specify the n-drive impedance control code. This register is updated by the user or is updated each time the ZQ calibration is complete.";
            sw = rw;
            hw = r;
            reset = 0x20;
        } zcode_ndrv[5:0];
    } IMPSTATUS @ 0x28;

    reg {
        name = "DRAM system configuration register";
