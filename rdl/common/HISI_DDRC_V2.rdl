            sw = rw;
            hw = r;
            encode = DDRC_CFG_AREF_aref_alarm_en_enum;
            reset = 0x0;
        } aref_alarm_en[4:4];

        enum DDRC_CFG_AREF_aref_mode_enum {
            AUTO_REFRESH_OPERATION = 0 { name = "Auto Refresh Operation"; desc = "An auto-refresh operation is performed every one tREFI cycle."; };
            THREE_AUTO_REFRESH = 1 { name = "Three Auto Refresh"; desc = "Three auto-refresh operations are performed every three tREFI cycles."; };
            FOUR_AUTO_REFRESH = 2 { name = "Four Auto Refresh"; desc = "Four auto-refresh operations are performed every five tREFI cycles."; };
            EIGHT_AUTO_REFRESH = 3 { name = "Eight Auto Refresh"; desc = "Eight auto-refresh operations are performed every nine tREFI cycles."; };
