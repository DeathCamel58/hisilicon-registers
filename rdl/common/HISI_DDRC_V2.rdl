            reset = 0x0;
        } lp_pll_powerdown_disable[16:16];

        field {
            name = "t_resp";
            desc = "DFI low-power control interface timing parameter. The field value must be smaller than DFI tlp_resp.";
            sw = rw;
            hw = r;
            reset = 0x8;
        } t_resp[15:12];

        field {
            name = "t_wakeup_thrd_lv3";
            desc = "DFI low-power control interface timing threshold >= wakeup_thrd_lv2: PHY clock gating, disable AC output enable >= wakeup_thrd_lv3: PHY clock gating, disable AC output enable, PHY PLL power down Note: wakeup_thrd_lv3 should >= wakeup_thrd_lv2";
            sw = rw;
            hw = r;
            reset = 0x6;
        } t_wakeup_thrd_lv3[11:8];

        field {
            name = "t_dram_clk_disable";
