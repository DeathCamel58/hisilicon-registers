Data sheet 4.1.6 DDRC_CFG_AREF (offset 0x2C, printed page 4-48, dump line 34263).";

        field {
            name = "aref_alarm_num";
            desc = "The auto-refresh command is forced to be transmitted if a specific number of auto-refresh commands cannot be transmitted. 0x0-0xFF: lack of (n + 1) auto-refresh commands Note that only one auto-refresh command is considered when n is 255 because the upper bits are lost after the bits of the 8-bit counter are carried.";
            sw = rw;
