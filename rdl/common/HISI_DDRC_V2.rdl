            OUTPUT_FIXED_AT = 1 { name = "Output Fixed At"; desc = "The output is fixed at the wodt configuration of rank 0."; };
        };

        field {
            name = "odt_on";
            desc = "Whether the ODT signal output to the SDRAM is fixed";
            sw = rw;
            hw = r;
            encode = DDRC_CFG_DDRMODE_odt_on_enum;
            reset = 0x0;
        } odt_on[17:17];

        enum DDRC_CFG_DDRMODE_zqc_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "zqc_en";
            desc = "DDR3 SDRAM ZQ enable";
            sw = rw;
