            NON_GREEN_PORT_2 = 3 { name = "Non Green Port 2"; desc = "non-green port mode 1. The mode is controlled by channel. If the accumulated OSTD of all ports reaches dmc_ostd_lvl or the OSTD of the current port reaches port_ostd_lvl, the current port is blocked."; };
        };

        field {
            name = "ostd_mode0";
            desc = "OSTD mode of port 0";
            sw = rw;
            hw = r;
            encode = AXI_OSTDCFG2_ostd_mode0_enum;
            reset = 0x0;
        } ostd_mode0[1:0];
    } AXI_OSTDCFG2 @ 0x244;

    reg {
        name = "DDRC channel command outstanding status register";
        desc = "AXI_OSTDSTATUS is a DDRC channel command outstanding status register.

Data sheet 4.1.5 AXI_OSTDSTATUS (offset 0x248, printed page 4-38, dump line 33692).";

        field {
