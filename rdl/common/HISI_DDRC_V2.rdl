`define HISI_DDRC_V2_RDL

regfile eHISI_DDRC_V2_AXI {
    name = "DDRC V2 AXI registers";
    desc = "AXI-side registers of the DDR2/DDR3 controller (DDRC), data sheet 4.1.5 (Table 4-5 'Summary of EMI registers', base 0x20110000): function configuration, clock gating, channel configuration, low power, per-port QoS / priority / timeout / outstanding / flux configuration. Port-indexed registers (`ports` = 0..6, stride 4) are register arrays of 7 elements.";

    reg {
        name = "DDRC function configuration register";
        desc = "AXI_CONFIG is a DDRC function configuration register.

Data sheet 4.1.5 AXI_CONFIG (offset 0x0, printed page 4-15, dump line 32425).";

        enum AXI_CONFIG_wr_rcv_mode_enum {
            WRITE_COMMAND_RECEIVED = 0 { name = "Write Command Received"; desc = "The write command is received directly."; };
            WRITE_COMMAND_RECEIVED_2 = 1 { name = "Write Command Received 2"; desc = "The write command is received only after the expected written data arrives."; };
        };

        field {
            name = "wr_rcv_mode";
            desc = "Mode of receiving the write command over the DDRC AXI port";
            sw = rw;
            hw = r;
            encode = AXI_CONFIG_wr_rcv_mode_enum;
            reset = 0x1;
        } wr_rcv_mode[18:18];

        enum AXI_CONFIG_exclusive_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "exclusive_en";
            desc = "Exclusive command enable";
            sw = rw;
            hw = r;
            encode = AXI_CONFIG_exclusive_en_enum;
            reset = 0x1;
        } exclusive_en[17:17];

        enum AXI_CONFIG_rd_wrap_split_en_enum {
            NOT_SPLIT = 0 { name = "Not Split"; desc = "not split"; };
            SPLIT = 1 { name = "Split"; desc = "split"; };
        };

        field {
            name = "rd_wrap_split_en";
            desc = "WRAP read command split enable";
            sw = rw;
            hw = r;
            encode = AXI_CONFIG_rd_wrap_split_en_enum;
            reset = 0x0;
        } rd_wrap_split_en[16:16];

        enum AXI_CONFIG_bank_width_enum {
            V_256_BITS = 8 { name = "V 256 Bits"; desc = "256 bits"; };
            V_512_BITS = 9 { name = "V 512 Bits"; desc = "512 bits"; };
            V_1_KB = 10 { name = "V 1 Kb"; desc = "1 KB"; };
            V_2_KB = 11 { name = "V 2 Kb"; desc = "2 KB"; };
            V_4_KB = 12 { name = "V 4 Kb"; desc = "4 KB"; };
            V_8_KB = 13 { name = "V 8 Kb"; desc = "8 KB"; };
            V_16_KB = 14 { name = "V 16 Kb"; desc = "16 KB"; };
            V_32_KB_OTHER = 15 { name = "V 32 Kb Other"; desc = "32 KB Other values: reserved For example, if the column is 10 for a 32-bit DDR, the bank width is calculated as follows: bank_width = (32/8) x (2^10) = 4 KB"; };
        };

        field {
            name = "bank_width";
            desc = "Bank bit width";
            sw = rw;
            hw = r;
            encode = AXI_CONFIG_bank_width_enum;
            reset = 0xC;
        } bank_width[3:0];
    } AXI_CONFIG @ 0x0;

