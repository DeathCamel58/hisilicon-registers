    eHISI_DDRC_V2_PHY_DX DX[4] @ 0x200 += 0x80;

    reg {
        name = "Local delay line control register (m = 1 copy)";
        desc = "DXNRDQSGDLY is a local delay line control register.

Copy m = 1 of DXNRDQSGDLY (offset formula `0x23C + n x 0x80 + m x 0x400` of the data sheet, m = 1). Not used by any vendor code; the formula looks inherited from a two-rank PHY (the Hi3518E has one rank).

Data sheet 4.1.7 DXNRDQSGDLY (offset 0x23C, printed page 4-178, dump line 41732).";

        field {
            name = "org_rdqsgph";
            desc = "Original read DQS gate phase before HW gate training post-update stage (for debugging)";
            sw = r;
            hw = w;
            reset = 0x0;
        } org_rdqsgph[29:24];

        field {
            name = "rdqsgtxbdl";
            desc = "Read DQS gate delay select This field specifies the delay value of the read gating delay before DQS dummy PAD.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } rdqsgtxbdl[20:16];

        field {
            name = "rdqsgphase";
            desc = "Read DQS gating clock phase select";
            sw = rw;
            hw = r;
            reset = 0x0;
        } rdqsgphase[13:8];

        field {
            name = "rdqsgbdl";
            desc = "Read DQS gating delay select This field specifies the delay value of the read gating delay after DQS dummy PAD.";
            sw = rw;
            hw = r;
            reset = 0x10;
        } rdqsgbdl[5:0];
    } DXNRDQSGDLY_M1[4] @ 0x63C += 0x80;
};

regfile eHISI_DDRC_V2 {
    name = "HiSilicon DDRC V2 (DDR2/DDR3 controller and DDR PHY, Hi3518E V20X / Hi3516C V200 / Hi3516A/D V100 / Hi3516C V300)";
    desc = "
    DDR2/DDR3/DDR3L SDRAM controller with its AXI front end, DMC and DDR PHY as found in the Hi3518E V200/V201 and Hi3516C V200 (data sheet chapter 4.1), the Hi3516A/D V100 and the Hi3516C V300 / E V100. Not the same IP as `eHISI_DDRC` (Hi3520D / Hi3518 V100): none of its register layout matches.

    Chips and editions (data-sheet table comparison, 2026-11-10):
    - Hi3518E V200/V201: embedded 16-bit DDR2 SDRAM (512 Mbit / 256 Mbit, max 360 MHz, 720 Mbit/s); Hi3516C V200: 16-bit DDR2/DDR3/DDR3L up to 4 Gbit and 400 MHz. One chip select. Instance base 0x20110000: AXI registers at +0x0000, DMC registers at +0x1000 (0x20111000), DDR PHY registers at +0x8000 (0x20118000), as printed in the data sheet summary tables. This is the default (unguarded) edition; the register and field descriptions were written from this data sheet, and the vendor-settled values quoted in some descs (e.g. DRAMCFG 0x21, DDRMODE 0x15) are Hi3518E V200 stock-image values.
    - Hi3516A/D V100 (data sheet chapter 4.1, Tables 4-5/4-6/4-7): one 32-bit DDR3/DDR3L interface up to 600 MHz (16-bit on the Hi3516D, 4 Gbit per 16-bit device, two devices max). The AXI, DMC and DDR PHY tables are register-for-register identical to the Hi3518E V20X ones (214 of 216 registers byte-identical; the two differences are PDF extraction artefacts in IOCTL/IOCTL2), same bases 0x20110000 / 0x20111000 / 0x20118000, so the chip instantiates this regfile unchanged. Values quoted from the Hi3518E stock image do not apply.
    - Hi3516C V300 / E V100 (`DDRC_V2_CV300`, data sheet 4.1 Tables 4-4/4-5): AXI base 0x12060000 (the address map calls the window 'MDDRC register'), DMC at 0x12061000. 16-bit DDR3. AXI and DMC tables identical to the Hi3518E V20X ones except the end of the DMC: the data sheet documents DDRC_HIS_SFC_RDATA0..3 (0x4A8..0x4B4) as the four read-data words 127:0 (confirming the vendor `ddr_ddrc_v500.h` layout) plus a new DDRC_TEST_GENPOSE0 (0x4BC), and has no RDATA4..7 / RDATA_ECC (0x4B8..0x4C8). The data sheet has no DDR PHY chapter and the PHY regfile is NOT instantiated for this chip: the vendor U-Boot (`hi3516cv300/ddr_training_custom.h`) puts a 28 nm 'T28' PHY at DDRC0_REG_BASE + 0x8000 (0x12068000) whose layout differs from the 'S40' PHY of the Hi3518E V20X / Hi3516A/D described by `eHISI_DDRC_V2_PHY` (vendor `drivers/ddr/ddr_phy_t28.h` vs `ddr_phy_s40.h`: AC block ACCMDBDL2/ACPHYCTL4/ACPHYCTL7 at 0x1040/0x1064/0x1070 instead of 0x128/0x180/0x18C, new DVRFTCTRL 0xC4 and CATSWAPINDEX/CATSWAPSEL 0x1B8/0x1BC, DXNOEBDL at DX+0x28 instead of +0x58, DXNRDQSGDLY at DX+0x40 instead of +0x3C, 7-bit instead of 5-bit BDLs, DVREFT/HVREFT_STATUS at DX+0x70/0x74). The same T28 PHY (with the V510 DMC) is selected for the Hi3516A V200 / Hi3519 V101 / Hi3519 / Hi3559, so it belongs to the MDDRC generation; no data sheet in the workspace documents it.

    The DDRC cannot be reset separately (global soft reset only) and must be re-initialised after any reset.
    ";

    eHISI_DDRC_V2_AXI   AXI @ 0x0000;
    eHISI_DDRC_V2_DMC   DMC @ 0x1000;
`ifndef DDRC_V2_CV300
    eHISI_DDRC_V2_PHY   PHY @ 0x8000;
`endif
};

`endif
