`ifndef HISI_VDP_AV200_RDL
`define HISI_VDP_AV200_RDL


regfile eHISI_VDP_AV200 {
    name = "HiSilicon video display processor (Hi3516A V200, Hi3519 V101)";
    desc = "
    HiSilicon video display processor (VDP) of the Hi3516A V200 and Hi3519 V101 at 0x11000000 (interrupt 59). The two data sheets (Hi3516AV200 9.2.6, Hi3519V101 9.2.6) list the same 116 registers: video layer V1 (0x1000, with DCMP decompression state), graphics layer G2 (0x7000), display channel DHD1 (0xC400), BT.1120 interface (BT_* 0xD200) and the LCD interface (LCD_CTRL 0xD400). The vendor header (hi3519/vou_reg.h == hi3516av200/vou_reg.h, byte-identical) adds the full V0 layer (0x0800, 16 regions, scaler, DCMP), the video-processing block VP0 (0x4000: ACC/ACM, CSC, DOF), graphics layers G0 (0x6000), G1 (0x6800), G3 (0x7800), graphics-processing GP0/GP1, write-back channels, DHD0 (0xC000), the parameter loader (COEF_DATA/`*_PARARD` 0x400-0x4F4), DAC control and the interface/dither/clip registers. Non-instant registers take effect after the `*_UPD` bits. The Hi3516A V300 VDP (120 data-sheet registers) is a close relative; Hi3516C V300 shares 59 of these registers by name.

    Generated 2026-11-10 by build/rdl-audit/video-rdl-scratch/gen_blocks.py: mechanical transcription of the data sheet register tables (ds_extract2 + description extraction from the PDF) merged with the vendor header; not hardware verified.

    Register sources: 116 registers from the data sheet (hi3516av200--Hi3516AV200-Datasheet.txt, section 9.2.6); 561 registers (5 of them arrays) and 101 fields from vendor U-Boot 2010.06 `product/hiosd/vo/hi3519/vou_reg.h` (GPL-2.0 U-Boot tree, HiSilicon copyright, created 2015-05-26; mirror github.com/OpenIPC/u-boot-hi3516cv200) (GPL-2.0, same-chip vendor header, byte-identical for Hi3516A V200 and Hi3519 V101), each marked `[inferred]` in its desc (names from the header, meanings inferred from the names, reset/access unknown). Name differences, data sheet kept: 0x134 name DS VO_DAC_0_CTRL / header VO_DAC_R_CTRL.";

    reg {
        name = "VO control register";
        desc = "VOCTRL is a VO control register. It is used to configure the arbitration mode of surface bus requests.

Data sheet 9.2.6 VOCTRL (offset 0x0, printed page 9-88, `hi3516av200--Hi3516AV200-Datasheet.txt` line 42316).";

        enum VOCTRL_vo_ck_gt_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "vo_ck_gt_en";
            desc = "VDP clock gating enable";
            sw = rw;
            hw = r;
            encode = VOCTRL_vo_ck_gt_en_enum;
            reset = 0x0;
        } vo_ck_gt_en[31:31];

        field {
            name = "chk_sum_en";
            desc = "[inferred] Chk sum enable. (bits reserved in the data sheet; vendor header `product/hiosd/vo/hi3519/vou_reg.h` field `chk_sum_en`; access and reset unknown, modelled RW)";
            sw = rw;
            hw = r;
        } chk_sum_en[30:30];

        field {
