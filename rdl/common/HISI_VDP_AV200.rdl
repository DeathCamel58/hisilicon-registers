            sw = rw;
            hw = r;
        } one_sync2_en[28:28];

        field {
            name = "chn2_select";
            desc = "[inferred] Chn2 select. (bits reserved in the data sheet; vendor header `product/hiosd/vo/hi3519/vou_reg.h` field `chn2_select`; access and reset unknown, modelled RW)";
            sw = rw;
            hw = r;
        } chn2_select[27:27];

        enum VOCTRL_m0_arb_mode_enum {
            POLLING = 0 { name = "Polling"; desc = "polling"; };
            GRAPHICS_LAYER_FIRST = 1 { name = "Graphics Layer First"; desc = "graphics layer first Other values: reserved"; };
        };

        field {
            name = "m0_arb_mode";
            desc = "Arbitration mode of data requests of internal surface buses of VO MAC0";
            sw = rw;
            hw = r;
            encode = VOCTRL_m0_arb_mode_enum;
            reset = 0x0;
        } m0_arb_mode[3:0];
