`ifndef ARM_PL011_RDL
`define ARM_PL011_RDL

regfile eARM_PL011 {
    name = "UART (ARM PrimeCell PL011)";
    desc = "
    ARM PrimeCell PL011 UART, the UART of every HiSilicon SoC on this site (the vendor kernels register them as AMBA devices, `core.c` `HIL_AMBA_DEVICE(uart0 ..)`, and
    mainline binds `arm,pl011`): 16 x 8-bit transmit FIFO, 16 x 12-bit receive FIFO, 5-8 data bits, 1-2 stop bits, parity, hardware flow control on the four-wire instance
    (UART1 on most chips), receive timeout and error interrupts. The UART reference clock and the per-UART clock gates / soft resets are in the chip's CRG or system controller
    (Hi3520D: PERI_CRG57 `uart_cksel`, hardware polarity 0 = APB 82.5 MHz, 1 = 2 MHz, which contradicts the data sheet; the reset value 1 means the UART runs from 2 MHz at reset,
    see CRG.rdl PERI_CRG57; Hi3518E V20X: PERI_CRG57 `uart_cksel`; Hi3516A V200 / Hi3519 V101 / Hi3516C V300 / Hi3516A V300: PERI_CRG for the UART clock select and gates).

    Registers UART_DR .. UART_ICR with their reset values are from the Hi3520D data sheet 14.3.6 (printed pages 14-31 .. 14-50, `datasheet.txt` lines 53660-54554) and were checked
    against the UART chapter of every other data sheet listed below: offsets, bit layouts and resets agree (the Hi3516A V300 data sheet gives UART_FR the reset 0x0096 instead of 0x0012,
    see `PL011_FR_RESET_G2` below). The data sheets show 16-bit (UART_RSR, UART_FBRD 8-bit) register widths; all registers are modelled as 32-bit APB registers with the upper bits
    unused (as in the PL011). The data sheets omit UART_ILPR, UART_DMACR, the modem status bits and the PrimeCell ID registers; they are added from the ARM PL011 TRM (fields marked
    so) and are not hardware verified, except that the PrimeCell identification is what the AMBA bus reads at probe. The data sheet total reset values of UART_FR (0x0012) and
    UART_RIS (0x0002) include a set bit 1 (DSR / CTS modem status) that the data sheet lists as reserved; it is modelled in those added fields. The older data sheets (Hi3511, Hi3515,
    Hi3516 V100, Hi3516C V100, Hi3518 V100) print the UART_RIS total reset as 0x0000 (bit 1 clear); the PL011 TRM gives UARTRIS a reset of 0x00- with the modem bits [3:0] undefined.

    Macros (chip `defines.rdl`): `PL011_FR_RESET_G2` - UART_FR total reset 0x0096 (`txfe` and `dcd` read 1 at reset in addition to `rxfe` and `dsr`; Hi3516A V300 data sheet).
    The PL011 TRM resets UARTFR to 0b-10010--- (TXFE = 1, RXFE = 1, modem bits from the pins), so a transmit-FIFO-empty flag set at reset is what the hardware does on every chip;
    the 0x0012 of the other data sheets is a documentation value and is kept as printed.

    ## Instances per SoC

    | SoC | UARTs | Base addresses | Interrupt |
    |-----|-------|----------------|-----------|
    | Hi3511 / Hi3512 | UART0-2 | 0x101F1000, 0x101F2000, 0x101F3000 | VIC 12, 13, 14 |
    | Hi3515 / Hi3520 V100 | UART0-3 | 0x20090000, 0x200A0000, 0x200B0000, 0x200C0000 (0x20080000 is reserved) | VIC 12 (UART0 or UART1), 13 (UART2 or UART3) |
    | Hi3516C V100 / Hi3518 V100 | UART0-2 | 0x20080000, 0x20090000, 0x200A0000 | VIC 5 (UART0/UART1), 25 (UART2) |
    | Hi3516 V100 | UART0-3 | 0x20080000 .. 0x200B0000 | GIC 46-49 |
    | Hi3516A / Hi3516D V100 | UART0-3 | 0x20080000, 0x20090000, 0x200A0000, 0x20230000 | GIC 40-43 |
    | Hi3520D V100 | UART0-3 | 0x20080000 .. 0x200B0000 (UART0 debug console, UART1 PTZ four-wire) | GIC 40-43 |
    | Hi3518E V20X / Hi3516C V200 | UART0-2 | 0x20080000, 0x20090000, 0x200A0000 | VIC 5 (UART0), 30 (UART1), 25 (UART2) |
    | Hi3516A V200 / Hi3519 V101 | UART0-4 | 0x12100000 + n x 0x1000 | GIC 36-40 |
    | Hi3516C V300 / Hi3516E V100 | UART0-2 | 0x12100000, 0x12101000, 0x12102000 | VIC 5 (UART0), 30 (UART1), 25 (UART2) |
    | Hi3516A V300 | UART0-4 | 0x120A0000 + n x 0x1000 | GIC 38-42 |
    ";

    reg {
        name = "Data register";
        desc = "UART_DR is a UART data register that stores the received data and the data to be transmitted. The receive status can be queried by reading this register.

Data sheet 14.3.6 UART_DR (offset 0x0, printed page 14-36, `datasheet.txt` line 53895).";

        enum UART_DR_oe_enum {
            NO_OVERFLOW_ERROR = 0 { name = "No Overflow Error"; desc = "No overflow error occurs."; };
            OVERFLOW_ERROR_OCCURS = 1 { name = "Overflow Error Occurs"; desc = "An overflow error occurs. That is, a data segment is received when the receive FIFO is full."; };
        };

        field {
            name = "oe";
            desc = "Overflow error.";
            sw = r;
            hw = w;
            encode = UART_DR_oe_enum;
            reset = 0x0;
        } oe[11:11];

        enum UART_DR_be_enum {
            NO_BREAK_ERROR = 0 { name = "No Break Error"; desc = "No break error occurs."; };
            BREAK_ERROR_OCCURS = 1 { name = "Break Error Occurs"; desc = "A break error occurs. That is, the time of receive data input signal keeping low is longer than a full word transfer. A full word consists of a start bit, a data bit, a parity bit, and a stop bit."; };
        };

        field {
            name = "be";
            desc = "Break error.";
            sw = r;
            hw = w;
            encode = UART_DR_be_enum;
            reset = 0x0;
        } be[10:10];

        enum UART_DR_pe_enum {
            NO_PARITY_ERROR = 0 { name = "No Parity Error"; desc = "No parity error occurs."; };
            PARITY_ERROR_OCCURS = 1 { name = "Parity Error Occurs"; desc = "A parity error occurs."; };
        };

        field {
            name = "pe";
            desc = "Parity error.";
            sw = r;
            hw = w;
            encode = UART_DR_pe_enum;
            reset = 0x0;
        } pe[9:9];

        enum UART_DR_fe_enum {
            NO_FRAME_ERROR = 0 { name = "No Frame Error"; desc = "No frame error occurs."; };
            FRAME_ERROR_OCCURS = 1 { name = "Frame Error Occurs"; desc = "A frame error (namely, stop bit error) occurs."; };
        };

        field {
            name = "fe";
            desc = "Frame error.";
            sw = r;
            hw = w;
            encode = UART_DR_fe_enum;
            reset = 0x0;
        } fe[8:8];

        field {
            name = "data";
            desc = "Data received and to be transmitted.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } data[7:0];
    } UART_DR @ 0x0;

    reg {
        name = "Receive status register / error clear register";
        desc = "UART_RSR is the receive status register (read) or the error clear register (any write clears all four error bits).

Data sheet 14.3.6 UART_RSR (offset 0x4, printed page 14-37, `datasheet.txt` line 53948).";

        enum UART_RSR_oe_enum {
            NO_OVERFLOW_ERROR = 0 { name = "No Overflow Error"; desc = "No overflow error occurs."; };
            OVERFLOW_ERROR_OCCURS = 1 { name = "Overflow Error Occurs"; desc = "An overflow error occurs. When the FIFO is full, the next data segment cannot be written to the FIFO and an overflow occurs in the shift register. Therefore, the contents in the FIFO are valid. In this case, the CPU must read the data immediately to spare the FIFO."; };
        };

        field {
            name = "oe";
            desc = "Overflow error.";
            sw = rw;
            hw = r;
            encode = UART_RSR_oe_enum;
            reset = 0x0;
        } oe[3:3];

        enum UART_RSR_be_enum {
            NO_BREAK_ERROR = 0 { name = "No Break Error"; desc = "No break error occurs."; };
            BREAK_ERROR_OCCURS = 1 { name = "Break Error Occurs"; desc = "A break error occurs. A break error occurs when the time of the receive data signal keeping low is longer than a full word transfer. A full word consists of a start bit, a data bit, a parity bit, and a stop bit."; };
        };

        field {
            name = "be";
            desc = "Break error.";
            sw = rw;
            hw = r;
            encode = UART_RSR_be_enum;
            reset = 0x0;
        } be[2:2];

        enum UART_RSR_pe_enum {
            NO_PARITY_ERROR = 0 { name = "No Parity Error"; desc = "No parity error occurs."; };
            PARITY_ERROR_OCCURS = 1 { name = "Parity Error Occurs"; desc = "A parity error occurs when the received data is checked. In FIFO mode, the error is associated with the data at the top of the FIFO."; };
        };

        field {
            name = "pe";
            desc = "Parity error.";
            sw = rw;
            hw = r;
            encode = UART_RSR_pe_enum;
            reset = 0x0;
        } pe[1:1];

        enum UART_RSR_fe_enum {
            NO_FRAME_ERROR = 0 { name = "No Frame Error"; desc = "No frame error occurs."; };
            STOP_BIT_RECEIVED = 1 { name = "Stop Bit Received"; desc = "The stop bit of the received data is incorrect. The valid stop bit is 1."; };
        };

        field {
            name = "fe";
            desc = "Frame error.";
            sw = rw;
            hw = r;
            encode = UART_RSR_fe_enum;
            reset = 0x0;
        } fe[0:0];
    } UART_RSR @ 0x4;

    reg {
        name = "Flag register";
        desc = "UART_FR is a UART flag register.

Data sheet 14.3.6 UART_FR (offset 0x18, printed page 14-38, `datasheet.txt` line 54004).";

        field {
            name = "ri";
            desc = "Ring indicator. (ARM PrimeCell UART (PL011) TRM; not in the Hi3520D data sheet.)";
            sw = r;
            hw = w;
            reset = 0x0;
        } ri[8:8];

        field {
            name = "txfe";
            desc = "The definition of the bit is determined by the status of UART_LCR_H [fen]. If UART_LCR_H [fen] is 0, this bit is set to 1 when the transmit holding register is empty. If UART_LCR_H [fen] is 1, the bit is set to 1 when the transmit FIFO is empty.";
            sw = r;
            hw = w;
`ifdef PL011_FR_RESET_G2
            reset = 0x1;
`else
            reset = 0x0;
`endif
        } txfe[7:7];

        field {
            name = "rxff";
            desc = "The definition of the bit is determined by the status of UART_LCR_H [fen]. If UART_LCR_H [fen] is 0, this bit is set to 1 when the receive holding register is full. If UART_LCR_H [fen] is 1, this bit is set to 1 when the receive FIFO is full.";
            sw = r;
            hw = w;
            reset = 0x0;
        } rxff[6:6];

        field {
            name = "txff";
            desc = "The definition of the bit is determined by the status of UART_LCR_H [fen]. If UART_LCR_H [fen] is 0, this bit is set to 1 when the transmit holding register is full. If UART_LCR_H [fen] is 1, the bit is set to 1 when the transmit FIFO is full.";
            sw = r;
            hw = w;
            reset = 0x0;
        } txff[5:5];

        field {
            name = "rxfe";
            desc = "The definition of the bit is determined by the status of UART_LCR_H [fen]. If UART_LCR_H [fen] is 0, this bit is set to 1 when the receive holding register is empty. If UART_LCR_H [fen] is 1, this bit is set to 1 when the receive FIFO is empty.";
            sw = r;
            hw = w;
            reset = 0x1;
        } rxfe[4:4];

        enum UART_FR_busy_enum {
            UART_IDLE_DATA = 0 { name = "Uart Idle Data"; desc = "The UART is idle or data transmission is complete."; };
            UART_BUSY_TRANSMITTING = 1 { name = "Uart Busy Transmitting"; desc = "The UART is busy in transmitting data. If the bit is set to 1, the status is kept until the entire byte (including all stop bits) is transmitted from the shift register. Regardless of whether the UART is enabled, this bit is set to 1 when the transmit FIFO is not empty."; };
        };

        field {
            name = "busy";
            desc = "UART busy/idle status.";
            sw = r;
            hw = w;
            encode = UART_FR_busy_enum;
            reset = 0x0;
        } busy[3:3];

        field {
            name = "dcd";
            desc = "Data carrier detect. (ARM PrimeCell UART (PL011) TRM; not in the Hi3520D data sheet. The Hi3516A V300 data sheet total reset 0x0096 has this bit set.)";
            sw = r;
            hw = w;
`ifdef PL011_FR_RESET_G2
            reset = 0x1;
`else
            reset = 0x0;
`endif
        } dcd[2:2];

        field {
            name = "dsr";
            desc = "Data set ready (the data sheet total reset 0x0012 has this bit set, in a field it lists as reserved). (ARM PrimeCell UART (PL011) TRM; not in the Hi3520D data sheet.)";
            sw = r;
            hw = w;
            reset = 0x1;
        } dsr[1:1];

        field {
            name = "cts";
            desc = "Clear to send. (ARM PrimeCell UART (PL011) TRM; not in the Hi3520D data sheet.)";
            sw = r;
            hw = w;
            reset = 0x0;
        } cts[0:0];
    } UART_FR @ 0x18;

    reg {
        name = "Integer baud rate register";
        desc = "UART_IBRD is an integral baud rate register.

Data sheet 14.3.6 UART_IBRD (offset 0x24, printed page 14-39, `datasheet.txt` line 54067).";

        field {
            name = "baud";
            desc = "Clock frequency divider corresponding to the integral part of the baud rate. All bits are cleared after reset.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } baud[15:0];
    } UART_IBRD @ 0x24;

    reg {
        name = "Fractional baud rate register";
        desc = "UART_FBRD is the fractional baud rate register (the data sheet names the field `band`, a typo for the baud-rate fraction; it is 6 bits wide: DIVFRAC).

Data sheet 14.3.6 UART_FBRD (offset 0x28, printed page 14-39, `datasheet.txt` line 54102).";

        field {
            name = "band";
            desc = "Clock frequency divider corresponding to the fractional part of the baud rate. All bits are cleared after reset.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } band[5:0];
    } UART_FBRD @ 0x28;

    reg {
        name = "Line control register (transfer mode control)";
        desc = "UART_LCR_H is a transfer mode control register. The registers UART_LCR_H, UART_IBRD, and UART_FBRD are combined to form a 30-bit register. If UART_IBRD and UART_FBRD are updated, UART_LCR_H must be updated at the same time.

Data sheet 14.3.6 UART_LCR_H (offset 0x2C, printed page 14-40, `datasheet.txt` line 54136).";

        field {
            name = "sps";
            desc = "Parity select. When bit 1, bit 2, and bit 7 of this register are set to 1, the parity bit is 0 during transmission and detection. When bit 1 and bit 7 of this register are set to 1 and bit 2 is set to 0, the parity bit is 1 during transmission and detection. When bit 1, bit 2, and bit 7 are cleared, the stick parity bit is disabled.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } sps[7:7];

        enum UART_LCR_H_wlen_enum {
            V_5_BITS = 0 { name = "V 5 Bits"; desc = "5 bits"; };
            V_6_BITS = 1 { name = "V 6 Bits"; desc = "6 bits"; };
            V_7_BITS = 2 { name = "V 7 Bits"; desc = "7 bits"; };
            V_8_BITS = 3 { name = "V 8 Bits"; desc = "8 bits"; };
        };

        field {
            name = "wlen";
            desc = "Count of bits in a transmitted or received frame.";
            sw = rw;
            hw = r;
            encode = UART_LCR_H_wlen_enum;
            reset = 0x0;
        } wlen[6:5];

        enum UART_LCR_H_fen_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "fen";
            desc = "Transmit/receive FIFO enable.";
            sw = rw;
            hw = r;
            encode = UART_LCR_H_fen_enum;
            reset = 0x0;
        } fen[4:4];

        enum UART_LCR_H_stp2_enum {
            THERE_NO_2 = 0 { name = "There No 2"; desc = "There is no 2-bit stop bit at the end of the transmitted frame."; };
            THERE_2_BIT = 1 { name = "There 2 Bit"; desc = "There is a 2-bit stop bit at the end of the transmitted frame. The receive logic does not check for the 2-bit stop bit during data reception."; };
        };

        field {
            name = "stp2";
            desc = "2-bit stop bit at the end of a transmitted frame.";
            sw = rw;
            hw = r;
            encode = UART_LCR_H_stp2_enum;
            reset = 0x0;
        } stp2[3:3];

        enum UART_LCR_H_eps_enum {
            ODD_PARITY_GENERATED = 0 { name = "Odd Parity Generated"; desc = "The odd parity is generated or checked during data transmission and reception."; };
            EVEN_PARITY_GENERATED = 1 { name = "Even Parity Generated"; desc = "The even parity is generated or checked during data transmission and reception. When UART_LCR_H [fen] is 0, this bit becomes invalid."; };
        };

        field {
            name = "eps";
            desc = "Parity select during data transmission and reception.";
            sw = rw;
            hw = r;
            encode = UART_LCR_H_eps_enum;
            reset = 0x0;
        } eps[2:2];

        enum UART_LCR_H_pen_enum {
            PARITY_DISABLED = 0 { name = "Parity Disabled"; desc = "The parity is disabled."; };
            PARITY_GENERATED_TRANSMIT = 1 { name = "Parity Generated Transmit"; desc = "The parity is generated on the transmit side and checked on the receive side."; };
        };

        field {
            name = "pen";
            desc = "Parity enable.";
            sw = rw;
            hw = r;
            encode = UART_LCR_H_pen_enum;
            reset = 0x0;
        } pen[1:1];

        enum UART_LCR_H_brk_enum {
            INVALID = 0 { name = "Invalid"; desc = "invalid"; };
            AFTER_CURRENT_DATA = 1 { name = "After Current Data"; desc = "After the current data transmission is complete, UTXD outputs low level continuously. Note: This bit must retain 1 during the period of at least two full frames to ensure the break command is executed properly. In general, the bit must be set to 0."; };
        };

        field {
            name = "brk";
            desc = "Break transmit.";
            sw = rw;
            hw = r;
            encode = UART_LCR_H_brk_enum;
            reset = 0x0;
        } brk[0:0];
    } UART_LCR_H @ 0x2C;

    reg {
        name = "Control register";
        desc = "UART_CR is a UART control register. To configure UART_CR: write 0 to uarten, wait for the current transfer to complete, clear UART_LCR_H.fen, configure UART_CR, write 1 to uarten (DS 14.3.4).

Data sheet 14.3.6 UART_CR (offset 0x30, printed page 14-42, `datasheet.txt` line 54226).";

        enum UART_CR_ctsen_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED_DATA_TRANSMITTED = 1 { name = "Enabled Data Transmitted"; desc = "enabled. Data is transmitted only when the nUARTCTS signal is valid."; };
        };

        field {
            name = "ctsen";
            desc = "CTS hardware flow control enable.";
            sw = rw;
            hw = r;
            encode = UART_CR_ctsen_enum;
            reset = 0x0;
        } ctsen[15:15];

        enum UART_CR_rtsen_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED_DATA_RECEPTION = 1 { name = "Enabled Data Reception"; desc = "enabled. The data reception request is raised only when the receive FIFO has available space."; };
        };

        field {
            name = "rtsen";
            desc = "RTS hardware flow control enable.";
            sw = rw;
            hw = r;
            encode = UART_CR_rtsen_enum;
            reset = 0x0;
        } rtsen[14:14];

        field {
            name = "out";
            desc = "Out2 (bit 13) and Out1 (bit 12) modem outputs. (ARM PrimeCell UART (PL011) TRM; not in the Hi3520D data sheet.)";
            sw = rw;
            hw = r;
            reset = 0x0;
        } out[13:12];

        enum UART_CR_rts_enum {
            OUTPUT_SIGNAL_RETAINS = 0 { name = "Output Signal Retains"; desc = "The output signal retains."; };
            WHEN_THIS_BIT = 1 { name = "When This Bit"; desc = "When this bit is set to 1, the output signal is 0."; };
        };

        field {
            name = "rts";
            desc = "Request transmit. This bit is the inversion of the status output signal nUARTRTS of the UART modem.";
            sw = rw;
            hw = r;
            encode = UART_CR_rts_enum;
            reset = 0x0;
        } rts[11:11];

        enum UART_CR_dtr_enum {
            OUTPUT_SIGNAL_RETAINS = 0 { name = "Output Signal Retains"; desc = "The output signal retains."; };
            WHEN_THIS_BIT = 1 { name = "When This Bit"; desc = "When this bit is set to 1, the output signal is 0."; };
        };

        field {
            name = "dtr";
            desc = "Data transmit ready. This bit is the inversion of the status output signal nUARTDTR of the UART modem.";
            sw = rw;
            hw = r;
            encode = UART_CR_dtr_enum;
            reset = 0x0;
        } dtr[10:10];

        enum UART_CR_rxe_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED_IF_UART = 1 { name = "Enabled If Uart"; desc = "enabled If the UART is disabled during data reception, the current data reception is stopped abnormally."; };
        };

        field {
            name = "rxe";
            desc = "UART receive enable.";
            sw = rw;
            hw = r;
            encode = UART_CR_rxe_enum;
            reset = 0x1;
        } rxe[9:9];

        enum UART_CR_txe_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED_IF_UART = 1 { name = "Enabled If Uart"; desc = "enabled If the UART is disabled during data transmission, the current data transmission is stopped abnormally."; };
        };

        field {
            name = "txe";
            desc = "UART transmit enable.";
            sw = rw;
            hw = r;
            encode = UART_CR_txe_enum;
            reset = 0x1;
        } txe[8:8];

        enum UART_CR_lbe_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            UARTTXD_LOOPED_BACK = 1 { name = "Uarttxd Looped Back"; desc = "UARTTXD is looped back to UARTRXD."; };
        };

        field {
            name = "lbe";
            desc = "Loopback enable.";
            sw = rw;
            hw = r;
            encode = UART_CR_lbe_enum;
            reset = 0x0;
        } lbe[7:7];

        field {
            name = "sir";
            desc = "SIREN (bit 1) and SIRLP (bit 2) IrDA SIR control; the data sheet lists them reserved. (ARM PrimeCell UART (PL011) TRM; not in the Hi3520D data sheet.)";
            sw = rw;
            hw = r;
            reset = 0x0;
        } sir[2:1];

        enum UART_CR_uarten_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED_IF_UART = 1 { name = "Enabled If Uart"; desc = "enabled If the UART is disabled during data reception and transmission, the data transfer is stopped abnormally."; };
        };

        field {
            name = "uarten";
            desc = "UART enable.";
            sw = rw;
            hw = r;
            encode = UART_CR_uarten_enum;
            reset = 0x0;
        } uarten[0:0];
    } UART_CR @ 0x30;

    reg {
        name = "Interrupt FIFO level select register";
        desc = "UART_IFLS is an interrupt FIFO threshold select register. It is used to set a threshold for triggering a FIFO interrupt (UART_TXINTR or UART_RXINTR).

Data sheet 14.3.6 UART_IFLS (offset 0x34, printed page 14-43, `datasheet.txt` line 54301).";

        enum UART_IFLS_rxiflsel_enum {
            RECEIVE_FIFO_1 = 0 { name = "Receive Fifo 1"; desc = "receive FIFO >= 1/8 full"; };
            RECEIVE_FIFO_1_2 = 1 { name = "Receive Fifo 1 2"; desc = "receive FIFO >= 1/4 full"; };
            RECEIVE_FIFO_1_3 = 2 { name = "Receive Fifo 1 3"; desc = "receive FIFO >= 1/2 full"; };
            RECEIVE_FIFO_3 = 3 { name = "Receive Fifo 3"; desc = "receive FIFO >= 3/4 full"; };
            RECEIVE_FIFO_7 = 4 { name = "Receive Fifo 7"; desc = "receive FIFO >= 7/8 full 101-111: reserved"; };
        };

        field {
            name = "rxiflsel";
            desc = "Receive interrupt FIFO threshold select. A receive interrupt is triggered when any of the following conditions is met:";
            sw = rw;
            hw = r;
            encode = UART_IFLS_rxiflsel_enum;
            reset = 0x2;
        } rxiflsel[5:3];

        enum UART_IFLS_txiflsel_enum {
            TRANSMIT_FIFO_1 = 0 { name = "Transmit Fifo 1"; desc = "transmit FIFO <= 1/8 full"; };
            TRANSMIT_FIFO_1_2 = 1 { name = "Transmit Fifo 1 2"; desc = "transmit FIFO <= 1/4 full"; };
            TRANSMIT_FIFO_3 = 3 { name = "Transmit Fifo 3"; desc = "transmit FIFO <= 3/4 full"; };
            TRANSMIT_FIFO_1_3 = 2 { name = "Transmit Fifo 1 3"; desc = "transmit FIFO <= 1/2 full"; };
            TRANSMIT_FIFO_7 = 4 { name = "Transmit Fifo 7"; desc = "transmit FIFO <= 7/8 full 101-111: reserved"; };
        };

