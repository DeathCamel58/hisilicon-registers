            desc = "DCD modem raw interrupt status (reset 0x0002 per the data sheet total reset: the CTS modem interrupt bit is set). (ARM PrimeCell UART (PL011) TRM; not in the Hi3520D data sheet.)";
            sw = r;
            hw = w;
