    reg {
        name = "DMAC software burst transfer request register";
        desc = "DMAC_SOFT_BREQ is a DMAC software burst transfer request register. Software controls the generation of DMA burst transfer requests by using this register. When this register is read, the peripherals that are requesting a DMA burst transfer can be queried.

Data sheet 3.6.6 DMAC_SOFT_BREQ (offset 0x20, printed page 3-109, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 28040).";

        field {
            name = "soft_breq";
            desc = "Controls whether to generate a DMA burst transfer request When this register is written: 0: no effect 1: A DMA burst transfer request is generated. When the transfer is complete, the corresponding bit is cleared. When this register is read: 0: The peripheral corresponding to the request signal DMACBREQ[15:0] does not send any DMA burst request. 1: The peripheral corresponding to the request signal DMACBREQ[15:0] is requesting the DMA burst transfer.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } soft_breq[15:0];
    } DMAC_SOFT_BREQ @ 0x20;

    reg {
        name = "DMAC software single transfer request register";
        desc = "DMAC_SOFT_SREQ is a DMAC software single transfer request register. Software controls the generation of DMA single transfer requests by using this register. When this register is read, the device that is requesting the DMA single transfer can be queried. This register and any of the 16 DMA request input signals of the DMAC can generate a DMA request each.

Data sheet 3.6.6 DMAC_SOFT_SREQ (offset 0x24, printed page 3-109, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 28073).";

        enum DMAC_SOFT_SREQ_soft_sreq_enum {
            NO_EFFECT = 0x0 { name = "No Effect"; desc = "no effect"; };
            DMA_SINGLE_TRANSFER = 0x1 { name = "Dma Single Transfer"; desc = "A DMA single transfer request is generated. When the transfer is complete, the corresponding bit is cleared."; };
        };

        field {
            name = "soft_sreq";
            desc = "Controls whether to generate a DMA single transfer request When this register is written:";
            sw = rw;
            hw = r;
            encode = DMAC_SOFT_SREQ_soft_sreq_enum;
            reset = 0x0;
        } soft_sreq[15:0];
    } DMAC_SOFT_SREQ @ 0x24;

