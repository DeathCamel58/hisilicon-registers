    reg {
        name = "DMAC configuration register";
        desc = "DMAC_CONFIG is a DMAC configuration register.

The vendor driver writes 0x01 (little endian, DMAC enabled) here at init (`DMAC_CONFIG_VAL`). Clock gate and soft reset of the DMAC: PERI_CRG54 `dma_cken` [5], `dma_srst_req` [4].

Data sheet 3.6.6 DMAC_CONFIG (offset 0x30, printed page 3-111, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 28174).";

        enum DMAC_CONFIG_m2_endianness_enum {
            LITTLE_ENDIAN = 0 { name = "Little Endian"; desc = "little endian"; };
            BIG_ENDIAN = 1 { name = "Big Endian"; desc = "big endian"; };
        };

        field {
            name = "m2_endianness";
            desc = "Byte endianness of master 2";
            sw = rw;
            hw = r;
            encode = DMAC_CONFIG_m2_endianness_enum;
            reset = 0x0;
        } m2_endianness[2:2];

        enum DMAC_CONFIG_m1_endianness_enum {
            LITTLE_ENDIAN = 0 { name = "Little Endian"; desc = "little endian"; };
            BIG_ENDIAN = 1 { name = "Big Endian"; desc = "big endian"; };
        };

        field {
            name = "m1_endianness";
            desc = "Byte endianness of master 1";
            sw = rw;
            hw = r;
            encode = DMAC_CONFIG_m1_endianness_enum;
            reset = 0x0;
        } m1_endianness[1:1];

        enum DMAC_CONFIG_dmac_enable_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "dmac_enable";
            desc = "DMA enable";
            sw = rw;
            hw = r;
            encode = DMAC_CONFIG_dmac_enable_enum;
            reset = 0x0;
        } dmac_enable[0:0];
    } DMAC_CONFIG @ 0x30;

    reg {
        name = "DMAC request line sync enable register";
        desc = "DMAC_SYNC is a DMAC request line sync enable register.

The vendor driver writes 0 (sync logic enabled for all 16 request lines, `DMAC_SYNC_VAL`).

Data sheet 3.6.6 DMAC_SYNC (offset 0x34, printed page 3-112, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 28215).";

        enum DMAC_SYNC_dmac_sync_enum {
            SYNC_LOGIC_PROVIDED = 0x0 { name = "Sync Logic Provided"; desc = "The sync logic provided for the DMA request signals of the corresponding peripheral is enabled."; };
            SYNC_LOGIC_PROVIDED_2 = 0x1 { name = "Sync Logic Provided 2"; desc = "The sync logic provided for the DMA request signals of the corresponding peripheral is disabled."; };
        };

        field {
            name = "dmac_sync";
            desc = "Controls whether to synchronize the request signals";
            sw = rw;
            hw = r;
            encode = DMAC_SYNC_dmac_sync_enum;
            reset = 0x0;
        } dmac_sync[15:0];
    } DMAC_SYNC @ 0x34;

