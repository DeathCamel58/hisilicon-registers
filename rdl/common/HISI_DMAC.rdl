`ifndef HISI_DMAC_RDL
`define HISI_DMAC_RDL

// Number of DMA channels (CH array size and width of the per-channel status bits): 4 by default (Hi3518EV200/Hi3516CV200, Hi3518 V100, Hi3516C V100,
// Hi3516A/D, Hi3516A V200, Hi3516C V300/E V100, Hi3519 V101), 8 when the chip's defines.rdl defines HISI_DMAC_8CH (Hi3511, Hi3515, Hi3520, Hi3516 V100).
// HISI_DMAC_INT1 (defines.rdl): second interrupt output for the slave ARM (DMAC_INT_*STAT1 at 0x40-0x48, DMAC_Cn_CONFIG.tc_int_msk1/err_int_msk1): Hi3515, Hi3520.
`ifdef HISI_DMAC_8CH
`define HISI_DMAC_NCH 8
`else
`define HISI_DMAC_NCH 4
`endif

regfile eHISI_DMAC_CH {
    name = "HiSilicon DMAC channel registers (one channel)";
    desc = "Registers of DMA channel n (n = 0-3; 0-7 on the 8-channel chips) at 0x100 + n x 0x20 (data sheet names: DMAC_Cn_SRC_ADDR, DMAC_Cn_DEST_ADDR, DMAC_Cn_LLI, DMAC_Cn_CONTROL, DMAC_Cn_CONFIG). Offsets are relative to the channel base.";

    reg {
        name = "Source address register of DMA channel n (n = 0-3)";
        desc = "DMAC_Cn_SRC_ADDR is a source address register of DMA channel n (n = 0-3). Its offset address is 0x100 + n x 0x20. The value of n ranges from 0 to 3. The values 0-3 correspond to DMA channels 0-3. Before a channel is enabled, its corresponding register must be programmed by using software. After the channel is enabled, the register is updated in any of the following cases:     The source address is incremented.     A complete data block is transferred and then loaded from LLI nodes.     If a channel is active, no valid information is obtained when this register is read. This is because that after software obtains the register value, the value changes during data transfer. Therefore, the register is read after the channel stops data transfer. At this time, the read value is the last source address read by the DMAC.

Data sheet 3.6.6 DMAC_Cn_SRC_ADDR (offset 0x100, printed page 3-112, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 28250).";

        field {
            name = "src_addr";
            desc = "DMA source address";
            sw = rw;
            hw = r;
            reset = 0x0;
        } src_addr[31:0];
    } SRC_ADDR @ 0x0;

    reg {
        name = "Destination address register of DMA channel n (n = 0-3)";
        desc = "DMAC_Cn_DEST_ADDR is a destination address register of DMA channel n (n = 0-3). Its offset address is 0x104 + n x 0x20. The value of n ranges from 0 to 3. The values 0-3 correspond to DMA channels 0-3. This register contains the destination address for the data to be transferred. Before a channel is enabled, its corresponding register must be programmed by using software. After the channel is enabled, the register is updated in any of the following cases:     Destination address increment.     A complete data block is transferred and then loaded from LLI nodes.     If a channel is active, no valid information is obtained when this register is read. This is because that after software obtains the register value, the value changes during data transfer. Therefore, the register is read after the channel stops data transfer. At this time, the read value is the last destination address written by the DMAC.

Data sheet 3.6.6 DMAC_Cn_DEST_ADDR (offset 0x104, printed page 3-113, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 28288).";

        field {
            name = "dest_addr";
            desc = "DMA destination address";
            sw = rw;
            hw = r;
            reset = 0x0;
        } dest_addr[31:0];
    } DEST_ADDR @ 0x4;

    reg {
        name = "Linked-list item (LLI) information register of DMA channel n (n = 0-3)";
        desc = "DMAC_Cn_LLI is the linked-list item (LLI) information register of DMA channel n (n = 0-3). Its offset address is 0x108 + n x 0x20. It holds the address of the next LLI node (SRC_ADDR, DEST_ADDR, LLI, CONTROL, in this order); 0 means the current node is the last one. The LLI address must be less than or equal to 0xFFFF_FFF0.

Data sheet 3.6.6 DMAC_Cn_LLI (offset 0x108, printed page 3-114, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 28321).";

        field {
            name = "ll_item";
            desc = "The bit[31:2] in the next LLI node address and the address bit[1:0] are set to 0. A linked list address must be 4-byte aligned.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } ll_item[31:2];

        enum LLI_ll_master_enum {
            MASTER_1 = 0 { name = "Master 1"; desc = "master 1"; };
            MASTER_2 = 1 { name = "Master 2"; desc = "master 2"; };
        };

        field {
            name = "ll_master";
            desc = "Master for loading the next LLI node";
            sw = rw;
            hw = r;
            encode = LLI_ll_master_enum;
            reset = 0x0;
        } ll_master[0:0];
    } LLI @ 0x8;

    reg {
        name = "Control register of DMA channel n (n = 0-3)";
        desc = "DMAC_Cn_CONTROL is the control register of DMA channel n (n = 0-3). Its offset address is 0x10C + n x 0x20. Before a channel is enabled it must be programmed by software; after the channel is enabled it is updated when the next LLI node is loaded. Never do common write/read tests on it: `trans_size` is a control field when written and a status field (remaining data count) when read.

Data sheet 3.6.6 DMAC_Cn_CONTROL (offset 0x10C, printed page 3-115, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 28368).";

        enum CONTROL_int_tc_enable_enum {
            DO_NOT_TRIGGER = 0 { name = "Do Not Trigger"; desc = "do not trigger"; };
            TRIGGER = 1 { name = "Trigger"; desc = "trigger"; };
        };

        field {
            name = "int_tc_enable";
            desc = "Transfer terminal interrupt enable. This bit determines whether the current LLI node triggers a transfer terminal interrupt.";
            sw = rw;
            hw = r;
            encode = CONTROL_int_tc_enable_enum;
            reset = 0x0;
        } int_tc_enable[31:31];

        field {
            name = "prot_stat";
            desc = "Protection bits transmitted by the master, called HPROT[2:0] in the bit table; the data sheet Table 3-15 defines them as: bit 2 cacheable (0 = non-cacheable, 1 = cacheable; drives the bus signal HPROT[3]), bit 1 bufferable (0 = non-bufferable, 1 = bufferable; HPROT[2]), bit 0 privileged (0 = user mode, 1 = privileged mode; HPROT[1]).";
            sw = rw;
            hw = r;
            reset = 0x0;
        } prot_stat[30:28];

        enum CONTROL_dest_incr_enum {
            DESTINATION_ADDRESS_NOT = 0 { name = "Destination Address Not"; desc = "The destination address is not incremented"; };
            DESTINATION_ADDRESS_INCREMENTE = 1 { name = "Destination Address Incremente"; desc = "The destination address is incremented once after a data segment is transferred If the destination device is a peripheral, the destination address is not incremented. If the destination device is a memory, the destination address is incremented."; };
        };

        field {
            name = "dest_incr";
            desc = "Destination address increment";
            sw = rw;
            hw = r;
            encode = CONTROL_dest_incr_enum;
            reset = 0x0;
        } dest_incr[27:27];

        enum CONTROL_src_incr_enum {
            SOURCE_ADDRESS_NOT = 0 { name = "Source Address Not"; desc = "The source address is not incremented"; };
            SOURCE_ADDRESS_INCREMENTED = 1 { name = "Source Address Incremented"; desc = "The source address is incremented once after a data segment is transferred If the source device is a peripheral, the source address is not incremented. If the source device is a memory, the source address is incremented."; };
        };

        field {
            name = "src_incr";
            desc = "Source address increment";
            sw = rw;
            hw = r;
            encode = CONTROL_src_incr_enum;
            reset = 0x0;
        } src_incr[26:26];

        enum CONTROL_dest_select_enum {
            MASTER_1 = 0 { name = "Master 1"; desc = "master 1"; };
            MASTER_2 = 1 { name = "Master 2"; desc = "master 2"; };
        };

        field {
            name = "dest_select";
            desc = "Master for accessing the destination device";
            sw = rw;
            hw = r;
            encode = CONTROL_dest_select_enum;
            reset = 0x0;
        } dest_select[25:25];

        enum CONTROL_src_select_enum {
            MASTER_1 = 0 { name = "Master 1"; desc = "master 1"; };
            MASTER_2 = 1 { name = "Master 2"; desc = "master 2"; };
        };

        field {
            name = "src_select";
            desc = "Master for accessing the source device";
            sw = rw;
            hw = r;
            encode = CONTROL_src_select_enum;
            reset = 0x0;
        } src_select[24:24];

        enum CONTROL_dwidth_enum {
            BYTE = 0 { name = "Byte"; desc = "BYTE (byte, 8 bits)"; };
            HALFWORD = 1 { name = "Halfword"; desc = "HALFWORD (halfword, 16 bits)"; };
            WORD = 2 { name = "Word"; desc = "WORD (word, 32 bits)"; };
        };

        field {
            name = "dwidth";
            desc = "Transfer bit width of the destination device (Table 3-14). The transfer bit width is invalid if it is greater than the bit width of the master. The data widths of the destination and source devices can differ; the hardware packs and unpacks the data. Values 011..111 are reserved.";
            sw = rw;
            hw = r;
            encode = CONTROL_dwidth_enum;
            reset = 0x0;
        } dwidth[23:21];

        enum CONTROL_swidth_enum {
            BYTE = 0 { name = "Byte"; desc = "BYTE (byte, 8 bits)"; };
            HALFWORD = 1 { name = "Halfword"; desc = "HALFWORD (halfword, 16 bits)"; };
            WORD = 2 { name = "Word"; desc = "WORD (word, 32 bits)"; };
        };

        field {
            name = "swidth";
            desc = "Transfer bit width of the source device (Table 3-14). The transfer bit width is invalid if it is greater than the bit width of the master. Values 011..111 are reserved.";
            sw = rw;
            hw = r;
            encode = CONTROL_swidth_enum;
            reset = 0x0;
        } swidth[20:18];

        enum CONTROL_dbsize_enum {
            BURST_1 = 0 { name = "Burst 1"; desc = "BURST_1 (burst length 1)"; };
            BURST_4 = 1 { name = "Burst 4"; desc = "BURST_4 (burst length 4)"; };
            BURST_8 = 2 { name = "Burst 8"; desc = "BURST_8 (burst length 8)"; };
            BURST_16 = 3 { name = "Burst 16"; desc = "BURST_16 (burst length 16)"; };
            BURST_32 = 4 { name = "Burst 32"; desc = "BURST_32 (burst length 32)"; };
            BURST_64 = 5 { name = "Burst 64"; desc = "BURST_64 (burst length 64)"; };
            BURST_128 = 6 { name = "Burst 128"; desc = "BURST_128 (burst length 128)"; };
            BURST_256 = 7 { name = "Burst 256"; desc = "BURST_256 (burst length 256)"; };
        };

        field {
            name = "dbsize";
            desc = "Burst size of the destination device: the number of data segments transferred by the destination device in a burst transfer (when DMACCxBREQ is valid). It must be a burst size supported by the destination device; for a memory it is set to the storage area size beyond the storage address boundary (Table 3-13). Values 011..111 select 16..256 as in Table 3-13.";
            sw = rw;
            hw = r;
            encode = CONTROL_dbsize_enum;
            reset = 0x0;
        } dbsize[17:15];

        enum CONTROL_sbsize_enum {
            BURST_1 = 0 { name = "Burst 1"; desc = "BURST_1 (burst length 1)"; };
            BURST_4 = 1 { name = "Burst 4"; desc = "BURST_4 (burst length 4)"; };
            BURST_8 = 2 { name = "Burst 8"; desc = "BURST_8 (burst length 8)"; };
            BURST_16 = 3 { name = "Burst 16"; desc = "BURST_16 (burst length 16)"; };
            BURST_32 = 4 { name = "Burst 32"; desc = "BURST_32 (burst length 32)"; };
            BURST_64 = 5 { name = "Burst 64"; desc = "BURST_64 (burst length 64)"; };
            BURST_128 = 6 { name = "Burst 128"; desc = "BURST_128 (burst length 128)"; };
            BURST_256 = 7 { name = "Burst 256"; desc = "BURST_256 (burst length 256)"; };
        };

        field {
            name = "sbsize";
            desc = "Burst size of the source device: the amount of data transferred by the source device in a burst transfer (when DMACCxBREQ is valid). It must be a burst size supported by the source device; for a memory it is set to the storage area size beyond the storage address boundary (Table 3-13).";
            sw = rw;
            hw = r;
            encode = CONTROL_sbsize_enum;
            reset = 0x0;
        } sbsize[14:12];

        field {
            name = "trans_size";
            desc = "The DMA transfer size can be configured by writing to this register only when the DMAC is a flow controller. This field indicates the amount of data to be transferred by the source device. When this register is read, the amount of data transferred through the bus connected to the destination device is obtained. If a channel is active, no valid information is obtained when this register is read. This is because that after software obtains the register value, the value changes during data transfer. Therefore, the register is read after the channel is enabled and data transfer stops.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } trans_size[11:0];
    } CONTROL @ 0xC;

    reg {
        name = "Configuration register of channel n (n = 0-3)";
        desc = "DMAC_Cn_CONFIG is a configuration register of channel n (n = 0-3). Its offset address is 0x110 + n x 0x20. The value of n ranges from 0 to 3. The values 0-3 correspond to DMA channels 0-3. This register is not updated when a new LLI node is loaded.

The data sheet lists `ch_active` (bit 17) as RW; in the ARM PL080 this bit is read-only status (vendor code only reads it). The data sheet access type is kept. `tc_int_msk` / `err_int_msk`: 1 = interrupt NOT masked (enabled), as printed. The vendor header uses CONFIG values 0xC000 (M2M, both interrupts enabled), 0xD000/0xC800 style values for P2M/M2P.

Data sheet 3.6.6 DMAC_Cn_CONFIG (offset 0x110, printed page 3-117, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 28485).";

`ifdef HISI_DMAC_INT1
        enum CONFIG_tc_int_msk1_enum {
            TC_MASKED = 0 { name = "Masked"; desc = "The transfer terminal interrupt of the channel to the slave ARM is masked."; };
            TC_NOT_MASKED = 1 { name = "Not Masked"; desc = "The transfer terminal interrupt of the channel to the slave ARM is not masked."; };
        };

        field {
            name = "tc_int_msk1";
            desc = "Transfer terminal interrupt mask for the slave ARM (data sheet name `itc1`; Hi3520/Hi3515 only)";
            sw = rw;
            hw = r;
            encode = CONFIG_tc_int_msk1_enum;
            reset = 0x0;
        } tc_int_msk1[20:20];

        enum CONFIG_err_int_msk1_enum {
            ERR_MASKED = 0 { name = "Masked"; desc = "The error interrupt of the channel to the slave ARM is masked."; };
            ERR_NOT_MASKED = 1 { name = "Not Masked"; desc = "The error interrupt of the channel to the slave ARM is not masked."; };
        };

        field {
            name = "err_int_msk1";
            desc = "Error interrupt mask for the slave ARM (data sheet name `ie1`; Hi3520/Hi3515 only)";
            sw = rw;
            hw = r;
            encode = CONFIG_err_int_msk1_enum;
            reset = 0x0;
        } err_int_msk1[19:19];
`endif

        enum CONFIG_ch_halt_enum {
            DMA_REQUEST_ALLOWED = 0 { name = "Dma Request Allowed"; desc = "The DMA request is allowed."; };
            SUBSEQUENT_DMA_REQUESTS = 1 { name = "Subsequent Dma Requests"; desc = "The subsequent DMA requests are ignored and the contents in the channel FIFO are completely transmitted. This bit can disable a DMA channel without data loss by working with the Active bit and the Channel Enable bit."; };
        };

        field {
            name = "ch_halt";
            desc = "Halt bit";
            sw = rw;
            hw = r;
            encode = CONFIG_ch_halt_enum;
            reset = 0x0;
        } ch_halt[18:18];

        enum CONFIG_ch_active_enum {
            THERE_NO_DATA = 0 { name = "There No Data"; desc = "There is no data in the channel FIFO."; };
            THERE_DATA_CHANNEL = 1 { name = "There Data Channel"; desc = "There is data in the channel FIFO. This bit can disable a DMA channel without data loss by working with the Halt bit and Channel Enable bit."; };
        };

        field {
            name = "ch_active";
            desc = "Active bit";
            sw = rw;
            hw = r;
            encode = CONFIG_ch_active_enum;
            reset = 0x0;
        } ch_active[17:17];

        enum CONFIG_ch_lock_enum {
            LOCK_TRANSFER_BUS = 0 { name = "Lock Transfer Bus"; desc = "Lock transfer on the bus is disabled."; };
            LOCK_TRANSFER_BUS_2 = 1 { name = "Lock Transfer Bus 2"; desc = "Lock transfer on the bus is enabled."; };
        };

        field {
            name = "ch_lock";
            desc = "Lock bit";
            sw = rw;
            hw = r;
            encode = CONFIG_ch_lock_enum;
            reset = 0x0;
        } ch_lock[16:16];

        enum CONFIG_tc_int_msk_enum {
            TRANSFER_TERMINAL_INTERRUPTS = 0 { name = "Transfer Terminal Interrupts"; desc = "The transfer terminal interrupts of the channel are masked."; };
            TRANSFER_TERMINAL_INTERRUPTS_2 = 1 { name = "Transfer Terminal Interrupts 2"; desc = "The transfer terminal interrupts of the channel are not masked."; };
        };

        field {
            name = "tc_int_msk";
            desc = "Transfer terminal interrupt mask";
            sw = rw;
            hw = r;
            encode = CONFIG_tc_int_msk_enum;
            reset = 0x0;
        } tc_int_msk[15:15];

        enum CONFIG_err_int_msk_enum {
            ERROR_INTERRUPTS_CHANNEL = 0 { name = "Error Interrupts Channel"; desc = "The error interrupts of the channel are masked."; };
            ERROR_INTERRUPTS_CHANNEL_2 = 1 { name = "Error Interrupts Channel 2"; desc = "The error interrupts of the channel are not masked."; };
        };

        field {
            name = "err_int_msk";
            desc = "Transfer error interrupt mask";
            sw = rw;
            hw = r;
            encode = CONFIG_err_int_msk_enum;
            reset = 0x0;
        } err_int_msk[14:14];

        enum CONFIG_flow_ctrl_enum {
            M2M_DMAC = 0 { name = "M2M Dmac"; desc = "M2M DMAC (memory to memory, flow controller is the DMAC)"; };
            M2P_DMAC = 1 { name = "M2P Dmac"; desc = "M2P DMAC (memory to peripheral, flow controller is the DMAC)"; };
            P2M_DMAC = 2 { name = "P2M Dmac"; desc = "P2M DMAC (peripheral to memory, flow controller is the DMAC)"; };
            S2D_DMAC = 3 { name = "S2D Dmac"; desc = "S2D DMAC (source device to destination device, flow controller is the DMAC)"; };
            S2D_DEST = 4 { name = "S2D Dest"; desc = "S2D DEST (source device to destination device, flow controller is the destination device)"; };
            M2P_DEST = 5 { name = "M2P Dest"; desc = "M2P DEST (memory to peripheral, flow controller is the destination device)"; };
            P2M_SRC = 6 { name = "P2M Src"; desc = "P2M SRC (peripheral to memory, flow controller is the source device)"; };
            S2D_SRC = 7 { name = "S2D Src"; desc = "S2D SRC (source device to destination device, flow controller is the source device)"; };
        };

        field {
            name = "flow_ctrl";
            desc = "Flow control and transfer type. It specifies the flow controller (DMAC, source device or destination device) and the transfer type (Table 3-16).";
            sw = rw;
            hw = r;
            encode = CONFIG_flow_ctrl_enum;
            reset = 0x0;
        } flow_ctrl[13:11];

        field {
            name = "dest_periph";
            desc = "Destination device. This field is used to select a peripheral request signal as the request signal for the DMA destination device of the channel. If the destination device for DMA transfer is a memory, this field is ignored.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } dest_periph[9:6];

        field {
            name = "src_periph";
            desc = "Source device. This field is used to select a peripheral request signal as the request signal for the DMA source device of the channel. If the source device for DMA transfer is a memory, this field is ignored.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } src_periph[4:1];

        enum CONFIG_ch_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED_CLEARING_THIS = 1 { name = "Enabled Clearing This"; desc = "enabled Clearing this bit can disable a channel. When this bit is cleared, the current bus transfer continues until the data transfer is complete. Then, the channel is disabled and the remaining data in the FIFO is lost. When the last LLI node is transferred or an error occurs during transfer, the channel is also disabled and this bit is cleared. If you want to disable a channel without data loss, the Halt bit must be set to 1 so the subsequent DMA requests are ignored by the channel. After this, the Active bit must be polled until its value becomes 0, indicating that there is no data in the channel FIFO. At this time, the Enable bit can be cleared. Before enabling a channel by setting this bit to 1, you must reinitialize the channel; otherwise, unexpected results may occur. When a channel is disabled by writing DMAC_Cn_CONFIG [ch_en], DMAC_Cn_CONFIG [ch_en] can be reset again only after the corresponding bit of DMAC_ENABLED_CHNS is 0. This is because the channel is not disabled immediately after the Channel Enable bit is cleared. The running delay during a bus"; };
        };

        field {
            name = "ch_en";
            desc = "Channel enable. The current status of the channel can be queried by reading this field or DMAC_ENABLED_CHNS.";
            sw = rw;
            hw = r;
            encode = CONFIG_ch_en_enum;
            reset = 0x0;
        } ch_en[0:0];
    } CONFIG @ 0x10;

};

regfile eHISI_DMAC {
    name = "HiSilicon DMA controller (PL080-compatible, 4 or 8 channels)";
    desc = "
    PL080-style DMA controller of the HiSilicon IP-cam / NVR SoCs up to the Hi3519 V101 (the Hi3516A V300 has a different, EDMAC-style controller: `HISI_DMAC_V2.rdl`). Written from the Hi3518E V20X / Hi3516C V200 data sheet
    (issue 02, section 3.6, interrupt 14 of the VIC) and cross-checked against the data sheets of Hi3511, Hi3515, Hi3520, Hi3516 V100, Hi3516C V100, Hi3518 V100, Hi3516A/D, Hi3516A V200, Hi3516C V300/E V100 and Hi3519 V101
    (Hi3520D V100 has no DMAC chapter; its vendor kernel uses `DMAC_BASE` 0x100D0000, the same base as the Hi3520). It has the register layout of an **ARM PrimeCell PL080**
    (the vendor driver `hi_pl08x.c` is derived from the Linux `amba-pl08x` driver) but with **4 or 8 channels** and 16 request lines; the data sheets document no PrimeCell ID registers (PL080
    has PeriphID/PCellID at 0xFE0..0xFFC): they are not modelled here and the DMAC is not AMBA-probed on these SoCs (the vendor device tree binds it as the platform device
    `hisilicon,hisi-dmac`). Global registers 0x000-0x034, per-channel registers `CH[HISI_DMAC_NCH]` at 0x100 + n x 0x20 (SRC_ADDR, DEST_ADDR, LLI, CONTROL, CONFIG; the data sheets name them DMAC_Cn_* / DMAC_CX_*).
    Two AHB masters (`src_select`/`dest_select`, `ll_master`, `DMAC_CONFIG.m1/m2_endianness`).

    **Per-chip configuration** (macros of the chip's `defines.rdl`; the common file defaults to the Hi3518EV200 form: 4 channels, no slave-ARM interrupt):

    | Chip | Base | Interrupt (data sheet number) | Channels | Macros |
    |---|---|---|---|---|
    | Hi3511 / Hi3512 V100 | 0x10130000 | 17 | 8 | `HISI_DMAC_8CH` |
    | Hi3515 | 0x100D0000 | 15 | 8 | `HISI_DMAC_8CH`, `HISI_DMAC_INT1` |
    | Hi3520 V100 | 0x100D0000 | 15 (VIC0 for the master ARM and VIC1 for the slave ARM, DS tables 3-20/3-21; not in the DMAC chapter) | 8 | `HISI_DMAC_8CH`, `HISI_DMAC_INT1` |
    | Hi3516 V100 | 0x100D0000 | 67 | 8 | `HISI_DMAC_8CH` |
    | Hi3516C V100, Hi3518 V100 | 0x100D0000 | 14 | 4 | none |
    | Hi3518E V20X / Hi3516C V200 | 0x10060000 | 14 | 4 | none |
    | Hi3516C V300 / Hi3516E V100 | 0x10030000 | 14 | 4 | none |
    | Hi3516A / Hi3516D | 0x10060000 | 37 (GIC) | 4 | none |
    | Hi3516A V200 | 0x10030000 | 49 (GIC) | 4 | none |
    | Hi3519 V101 | 0x10030000 | 49 (GIC) | 4 | none |

    Differences between the data sheets that are *not* modelled per chip (same bit layout, only the description or the access type differs):
    - The status registers of the older data sheets (Hi3511, Hi3515, Hi3516 V100, Hi3516C V100, Hi3518 V100, Hi3520) describe one vector field `int_stat[N-1:0]` (`int_tc_stat`, `int_tc_clr`, ...); the Hi3518EV200-style one-bit-per-channel fields `chN_*` are used for all chips (same bits). The Hi3511/Hi3520 data sheets call register 0x1C `DMAC_ENBLD_CHNS`.
    - `DMAC_SOFT_LBREQ` / `DMAC_SOFT_LSREQ`: write-only in the older data sheets, read/write (as in PL080) in the Hi3518EV200 one; modelled read/write. `DMAC_Cn_CONFIG.ch_active` is read-only in the older data sheets and in the PL080 but RW in the Hi3516A and later ones; modelled as in the Hi3518EV200 data sheet (RW, low confidence, only ever read).
    - The Hi3515 and Hi3520 data sheets list the channel `DMAC_Cn_CONFIG` halt bit [18] only in the bit diagram (Hi3511 also in the table); it is kept for all chips (PL080 `H`).
    - Older chips (Hi3511, Hi3515, Hi3520, Hi3516 V100, Hi3516C/Hi3518 V100) call the CONFIG fields `e`, `h`, `a`, `l`, `itc`, `ie`, `flow_cntrl`, `dest_peripheral`, `src_peripheral`; the CONTROL fields `i`, `prot`, `di`, `si`, `d`, `s`, `dwidth`, ...; DMAC_CONFIG `e`, `m1`, `m2`; DMAC_Cn_LLI `lm` / `lli` (bit 1 reserved, as here).
    - Per-channel FIFOs: 4 x 32 bit (channels 0, 1) and 16 x 32 bit (channels 2, 3) on the 4-channel chips; Hi3515: 4 x 32 for channels 0-5, 16 x 32 for 6-7.

    Bring-up: clock/reset in the chip's CRG (Hi3518EV200: PERI_CRG54 `dma_cken` [5] / `dma_srst_req` [4], reset = 0: clock off, not in reset; Hi3516 V100: PERI_CRG27 `dma_cken`); initialisation sequence (DS 3.6.4): write DMAC_CONFIG (endianness, `dmac_enable`), write 1s to
    DMAC_INT_TC_CLR / DMAC_INT_ERR_CLR, write DMAC_SYNC, disable all channels (`ch_en` = 0). Enabling a channel: pick an idle channel from DMAC_ENABLED_CHNS, clear its interrupts, program SRC_ADDR, DEST_ADDR,
    LLI, CONTROL, CONFIG, then set `ch_en`. For memory-to-memory transfers use channel 2 or 3 on the 4-channel chips, channel 6 or 7 on the 8-channel ones (an idle cycle is inserted after each bus operation on those channels, DS 3.6.3). The register descriptions
    below keep the Hi3518EV200 wording (n = 0-3); n runs 0-7 on the 8-channel chips.

    **DMA request line numbers (`DMAC_Cn_CONFIG.src_periph` / `dest_periph`, 4 bits, 16 lines; needed for the `dmas` cells):**
    - Hi3518E V20X / Hi3516C V200 (DS Table 3-12; the vendor header `hidmac_hi3518ev20x.h` agrees): 0 I2C0 RX, 1 I2C0 TX, 2 I2C1 RX, 3 I2C1 TX, 4 UART0 RX, 5 UART0 TX, 6 UART1 RX, 7 UART1 TX,
      8 UART2 RX, 9 UART2 TX, 10 I2C2 RX, 11 I2C2 TX, 12 SSP1 RX, 13 SSP1 TX, 14 SSP0 RX, 15 SSP0 TX.
    - Hi3516C V300 / Hi3516E V100 (DS Table 3-12): 0 I2C0 RX, 1 I2C0 TX, 2-3 reserved, 4 I2C1 RX, 5 I2C1 TX, 6 UART0 RX, 7 UART0 TX, 8 UART1 RX, 9 UART1 TX, 10 UART2 RX, 11 UART2 TX, 12 SSP0 RX, 13 SSP0 TX, 14 SSP1 RX, 15 SSP1 TX
      (the data sheet's worked example calls request 5 the UART0 RX request: it contradicts its own table, the table is kept).
    - Hi3516C V100 / Hi3518 V100 (A/C) (DS Table 3-24): 0 SIO RX, 1 SIO TX, 2-5 reserved, 6 UART0 RX, 7 UART0 TX, 8 UART1 RX, 9 UART1 TX, 10 UART2 RX, 11 UART2 TX, 12 SSP1 RX, 13 SSP1 TX, 14 SSP0 RX, 15 SSP0 TX
      (the Hi3518 data sheet marks the SSP lines 12-15 as reserved for the Hi3518C).
    - Hi3516A / Hi3516D (DS Table 3-11; the I2C/SSP lines are shared and selected by `MISC_CTRL1.i2c1_dma_ch_sel`): 0 I2C1/I2C0 RX, 1 I2C1/I2C0 TX, 2 I2C1/I2C2 RX, 3 I2C1/I2C2 TX, 4 UART0 RX, 5 UART0 TX, 6 UART1 RX, 7 UART1 TX,
      8 UART2 RX, 9 UART2 TX, 10 UART3 RX, 11 UART3 TX, 12 I2C1/SSP1 RX, 13 I2C1/SSP1 TX, 14 I2C1/SSP0 RX, 15 I2C1/SSP0 TX.
    - Hi3516A V200 / Hi3519 V101 (DS Table 3-11; selected by `MISC_CTRL1.dma_01_sel` / `dma_67_sel` / `dma_89_sel` / `dma_ab_sel`): 0 UART0/UART4 RX, 1 UART0/UART4 TX, 2 UART1 RX, 3 UART1 TX, 4 UART2 RX, 5 UART2 TX, 6 UART3/I2C3/SSP3 RX, 7 UART3/I2C3/SSP3 TX,
      8 I2C0/SSP0 RX, 9 I2C0/SSP0 TX, 10 I2C1/SSP1 RX, 11 I2C1/SSP1 TX, 12 SSP2 RX, 13 SSP2 TX, 14 I2C2 RX, 15 I2C2 TX.
    - Hi3516 V100 (8 channels, DS Table 3-21): 0 SIO0 RX, 1 SIO0 TX, 2 SIO1 RX, 3 SIO1 TX, 4 SIO2 RX (printed \"SIO2 TX\", obvious typo), 5 SIO2 TX, 6 SSP0 RX, 7 SSP0 TX, 8 SSP1 RX, 9 SSP1 TX, 10 UART0 RX, 11 UART0 TX, 12 UART1 RX, 13 UART1 TX, 14 UART2 RX, 15 UART2 TX.
    - Hi3520 V100 (8 channels, DS Table 3-23): 0 SIO0 RX, 1 SIO0 TX, 2 SIO1 RX, 3 SIO1 TX, 4 SIO2 RX, 5 SIO2 TX, 6 SPI RX, 7 SPI TX, 8 SDIO read, 9 SDIO write, 10 UART0 RX, 11 UART0 TX, 12 UART1 RX, 13 UART1 TX, 14 UART2 RX, 15 UART2 TX.
    - Hi3515 (8 channels, DS Table 3-18): 0 SIO0 RX, 1 SIO0 TX, 2 SIO1 RX, 3 SIO1 TX, 4 UART RX, 5 UART TX, 6 SPI RX, 7 SPI TX, 8 MMC read, 9 MMC write, 10 UART0 RX, 11 UART0 TX, 12 UART1 RX, 13 UART1 TX, 14 UART2 RX, 15 UART2 TX
      (lines 4/5 are the data sheet's generic \"UART\" entries and are probably vestigial).
    - Hi3511 / Hi3512 (8 channels, DS Table 3-15): 0-1 reserved, 2 SIO0 RX, 3 SIO0 TX, 4 SIO1 RX, 5 reserved (printed; probably SIO1 TX), 6-7 reserved, 8 SSP RX, 9 SSP TX, 10-11 reserved, 12 MMC RX, 13 MMC TX, 14 UART0 RX, 15 UART0 TX.

    Source: Hi3518E V20X data sheet 3.6.5/3.6.6 (`hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` lines 27600-28696) and the vendor driver `drivers/hidmac/hidmac_hi3518ev20x.h` (register offsets and the channel control/config values the driver writes agree with the data sheet);
    the other data sheets are compared register by register (offsets, bit ranges and resets all agree except for the points above). The channel registers
    are modelled as the nested regfile `eHISI_DMAC_CH` instantiated `CH[HISI_DMAC_NCH] @ 0x100 += 0x20`. No hardware verification.
    Second pass (2026-11-11, scripted): 13 data-sheet editions (every chip above) compared by offset, bit, access and reset with the RDL of all 16 PL080-type chip roots, plus request tables, bases and interrupt numbers: no register difference beyond the points listed above (Hi3515/Hi3520 ITC1/IE1 are R/W as modelled; the Hi3516 V100 data sheet also prints reserved bit 1 of DMAC_Cn_LLI as a field `r`).
    ";


