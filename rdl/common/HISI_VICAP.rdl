Data sheet 11.1.6 CH_CHFIR_OFFSET (offset 0x1094C, printed page 11-50, `datasheet.txt` line 35651).";

        field {
            name = "hchroma_offset";
            desc = "Chrominance horizontal start position offset, in the format of (s, 5). That is, the offset value consists of a 1-bit signed bit and 4-bit integral part. The value is expressed as a complementary code and the offset value ranges from -6 to +15.";
            sw = rw;
