            encode = CH_CHFIR_SPH_hchmsc_en_enum;
            reset = 0x0;
        } hchmsc_en[31:31];

        field {
            name = "hchratio";
            desc = "Not in the Hi3520D data sheet issue 02, which lists bits [30:0] of CH_CHFIR_SPH as reserved (read-only); kept from a later data sheet issue. Chrominance horizontal scaling ratio. It is calculated by dividing the output width by the input width. If horizontal pre-processing is enabled, the input width after pre-processing is used. The ratio is in the format of (u, 4). That is, the ratio is an unsigned number and consists of a 4-bit integral part.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } hchratio[15:12];
    } CH_CHFIR_SPH @ 0x944;

    reg {
        name = "Luminance scaling horizontal offset SET register";
        desc = "CH_LHFIR_OFFSET is a luminance scaling horizontal offset register.

Data sheet 11.1.6 CH_LHFIR_OFFSET (offset 0x10948, printed page 11-50, `datasheet.txt` line 35627).";

        field {
            name = "hluma_offset";
            desc = "Luminance horizontal start position offset, in the format of (s, 5). That is, the offset value consists of a 1-bit signed bit and 4-bit integral part. The value is expressed as a complementary code and the offset value ranges from -6 to +15.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } hluma_offset[16:12];
    } CH_LHFIR_OFFSET @ 0x948;

    reg {
        name = "Chrominance scaling horizontal offset SET register";
