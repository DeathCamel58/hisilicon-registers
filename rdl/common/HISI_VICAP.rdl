            desc = "The data channel is selected based on the channel ID when the channel 0 ID is enabled.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } ch0_id[13:12];

        enum PT_INTF_MOD_port_cap_mode_enum {
            BT_656_BT = 0 { name = "Bt 656 Bt"; desc = "BT.656/BT.1120 mode"; };
            INTERLEAVE_MODE_OTHER = 3 { name = "Interleave Mode Other"; desc = "interleave mode Other values: reserved"; };
        };

        field {
            name = "port_cap_mode";
            desc = "Port mode. Vendor writes the INPUT INTERFACE type here (0 BT.656/BT.1120 standard, 1 BT.601, 2 and 3 other, 3 = BT.1120 interleaved), not the multiplex count (Source: vendor module hi3520D_viu.ko (Hi3520D_MPP_V2.0.5.1, HiMPP kernel module from the OpenIPC Hi3520D rootfs; static disassembly), VIU_HAL_SetPortInputMode, confidence HIGH for the position, MEDIUM for the value names). Not verified on hardware.";
            sw = rw;
            hw = r;
            encode = PT_INTF_MOD_port_cap_mode_enum;
            reset = 0x0;
        } port_cap_mode[11:10];

        enum PT_INTF_MOD_port_mux_mode_enum {
            V_1_CHANNEL_MULTIPLEXING = 0 { name = "V 1 Channel Multiplexing"; desc = "1-channel multiplexing mode"; };
            V_2_CHANNEL_MULTIPLEXING = 1 { name = "V 2 Channel Multiplexing"; desc = "2-channel multiplexing mode"; };
            V_4_CHANNEL_MULTIPLEXING = 2 { name = "V 4 Channel Multiplexing"; desc = "4-channel multiplexing mode"; };
            RESERVED = 3 { name = "Reserved"; desc = "reserved"; };
        };

        field {
            name = "port_mux_mode";
            desc = "Multiplexing mode. Vendor writes the MULTIPLEX COUNT here (0 = 1 channel, 1 = 2 channel (or BT.1120 interleaved), 2 = 4 channel) (Source: vendor module hi3520D_viu.ko (Hi3520D_MPP_V2.0.5.1, HiMPP kernel module from the OpenIPC Hi3520D rootfs; static disassembly), VIU_HAL_SetPortWorkMode, confidence HIGH for the position). Not verified on hardware.";
            sw = rw;
            hw = r;
            encode = PT_INTF_MOD_port_mux_mode_enum;
            reset = 0x0;
        } port_mux_mode[9:8];

        enum PT_INTF_MOD_fix_code_enum {
            MSB_1 = 0 { name = "Msb 1"; desc = "The MSB is 1."; };
            MSB_0 = 1 { name = "Msb 0"; desc = "The MSB is 0."; };
        };

        field {
            name = "fix_code";
            desc = "MSB of the sync code.";
            sw = rw;
            hw = r;
            encode = PT_INTF_MOD_fix_code_enum;
            reset = 0x0;
        } fix_code[7:7];

        enum PT_INTF_MOD_port_mod_enum {
            SINGLE_COMPONENT_INPUT = 0 { name = "Single Component Input"; desc = "single-component input"; };
            DUAL_COMPONENT_INPUT = 1 { name = "Dual Component Input"; desc = "dual-component input Other values: reserved"; };
        };

        field {
            name = "port_mod";
            desc = "Port mode.";
            sw = rw;
            hw = r;
            encode = PT_INTF_MOD_port_mod_enum;
            reset = 0x0;
        } port_mod[4:3];

        enum PT_INTF_MOD_clk_mode_enum {
