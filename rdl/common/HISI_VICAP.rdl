            desc = "Channel 0 ID enable.";
            sw = rw;
            hw = r;
            encode = PT_INTF_MOD_ch0_id_en_enum;
            reset = 0x0;
        } ch0_id_en[20:20];

        field {
            name = "ch3_id";
            desc = "The data channel is selected based on the channel ID when the channel 3 ID is enabled.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } ch3_id[19:18];

        field {
            name = "ch2_id";
            desc = "The data channel is selected based on the channel ID when the channel 2 ID is enabled.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } ch2_id[17:16];

        field {
            name = "ch1_id";
            desc = "The data channel is selected based on the channel ID when the channel 1 ID is enabled.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } ch1_id[15:14];

        field {
