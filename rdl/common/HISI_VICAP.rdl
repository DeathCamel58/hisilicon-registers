            reset = 0x0;
        } reg_newer[0:0];
    } CH_REG_NEWER @ 0x404;

    reg {
        name = "Crop start position register";
        desc = "CH_CROP_START is a crop start position register.

Data sheet 11.1.6 CH_CROP_START (offset 0x10410, printed page 11-30, `datasheet.txt` line 34458).";

        field {
