        name = "Chrominance horizontal scaling parameter configuration register";
        desc = "CH_CHFIR_SPH is a chrominance horizontal scaling parameter configuration register.

Data sheet 11.1.6 CH_CHFIR_SPH (offset 0x10944, printed page 11-49, `datasheet.txt` line 35586).";

        enum CH_CHFIR_SPH_hchmsc_en_enum {
