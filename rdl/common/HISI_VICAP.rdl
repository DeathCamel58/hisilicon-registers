`ifndef HISI_VICAP_RDL
`define HISI_VICAP_RDL

regfile eHISI_VICAP_CH {
    name = "HiSilicon VICAP port/channel registers";
    desc = "
    One VICAP port/channel register group (`CH[16]` at 0x10000 + n x 0x2000). Offsets are rebased to the start of the group (the data sheet lists the registers of PORT 0 / CH 0 as 0x10000.. and 0x10300..; Figure 11-17 shows PORTn registers at 0x10000 + n x 0x4000 and CHn registers at 0x10300 + n x 0x2000). The PT_* registers (offsets 0x000..0x044) exist only in channels 0 and 4 (at most two external ports are supported; port 0 serves channels 0-3, port 1 channels 4-7); they are present but not implemented in the other groups. The Hi3520D has 8 channels (Hi3515A: 4), the data sheet space allocation shows 16.
    ";

    reg {
        name = "Port mode register";
        desc = "PT_INTF_MOD is a port mode register.

Data sheet 11.1.6 PT_INTF_MOD (offset 0x10000, printed page 11-21, `datasheet.txt` line 33933).";

        enum PT_INTF_MOD_interleave_seq_enum {
            C_COMPONENT_BEFORE = 0 { name = "C Component Before"; desc = "The C component is before the Y component."; };
            Y_COMPONENT_BEFORE = 1 { name = "Y Component Before"; desc = "The Y component is before the C component."; };
        };

        field {
            name = "interleave_seq";
            desc = "Y/C sequence during interleaving.";
            sw = rw;
            hw = r;
            encode = PT_INTF_MOD_interleave_seq_enum;
            reset = 0x0;
        } interleave_seq[24:24];

        enum PT_INTF_MOD_ch3_id_en_enum {
            CHANNEL_ID_NOT = 0 { name = "Channel Id Not"; desc = "The channel ID is not checked."; };
            DATA_CHANNEL_SELECTED = 1 { name = "Data Channel Selected"; desc = "The data channel is selected based on the channel ID."; };
        };

        field {
            name = "ch3_id_en";
            desc = "Channel 3 ID enable.";
            sw = rw;
            hw = r;
            encode = PT_INTF_MOD_ch3_id_en_enum;
            reset = 0x0;
        } ch3_id_en[23:23];

        enum PT_INTF_MOD_ch2_id_en_enum {
            CHANNEL_ID_NOT = 0 { name = "Channel Id Not"; desc = "The channel ID is not checked."; };
            DATA_CHANNEL_SELECTED = 1 { name = "Data Channel Selected"; desc = "The data channel is selected based on the channel ID."; };
        };

        field {
            name = "ch2_id_en";
            desc = "Channel 2 ID enable.";
            sw = rw;
            hw = r;
            encode = PT_INTF_MOD_ch2_id_en_enum;
            reset = 0x0;
        } ch2_id_en[22:22];

        enum PT_INTF_MOD_ch1_id_en_enum {
            CHANNEL_ID_NOT = 0 { name = "Channel Id Not"; desc = "The channel ID is not checked."; };
            DATA_CHANNEL_SELECTED = 1 { name = "Data Channel Selected"; desc = "The data channel is selected based on the channel ID."; };
        };

        field {
            name = "ch1_id_en";
            desc = "Channel 1 ID enable.";
            sw = rw;
            hw = r;
            encode = PT_INTF_MOD_ch1_id_en_enum;
            reset = 0x0;
        } ch1_id_en[21:21];

        enum PT_INTF_MOD_ch0_id_en_enum {
            CHANNEL_ID_NOT = 0 { name = "Channel Id Not"; desc = "The channel ID is not checked."; };
            DATA_CHANNEL_SELECTED = 1 { name = "Data Channel Selected"; desc = "The data channel is selected based on the channel ID."; };
        };

        field {
            name = "ch0_id_en";
            desc = "Channel 0 ID enable.";
            sw = rw;
            hw = r;
            encode = PT_INTF_MOD_ch0_id_en_enum;
            reset = 0x0;
        } ch0_id_en[20:20];

        field {
            name = "ch3_id";
            desc = "The data channel is selected based on the channel ID when the channel 3 ID is enabled.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } ch3_id[19:18];

        field {
            name = "ch2_id";
            desc = "The data channel is selected based on the channel ID when the channel 2 ID is enabled.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } ch2_id[17:16];

        field {
            name = "ch1_id";
            desc = "The data channel is selected based on the channel ID when the channel 1 ID is enabled.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } ch1_id[15:14];

        field {
            name = "ch0_id";
            desc = "The data channel is selected based on the channel ID when the channel 0 ID is enabled.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } ch0_id[13:12];

        enum PT_INTF_MOD_port_cap_mode_enum {
            BT_656_BT = 0 { name = "Bt 656 Bt"; desc = "BT.656/BT.1120 mode"; };
            INTERLEAVE_MODE_OTHER = 3 { name = "Interleave Mode Other"; desc = "interleave mode Other values: reserved"; };
        };

        field {
            name = "port_cap_mode";
            desc = "Port mode.";
            sw = rw;
            hw = r;
            encode = PT_INTF_MOD_port_cap_mode_enum;
            reset = 0x0;
        } port_cap_mode[11:10];

        enum PT_INTF_MOD_port_mux_mode_enum {
            V_1_CHANNEL_MULTIPLEXING = 0 { name = "V 1 Channel Multiplexing"; desc = "1-channel multiplexing mode"; };
            V_2_CHANNEL_MULTIPLEXING = 1 { name = "V 2 Channel Multiplexing"; desc = "2-channel multiplexing mode"; };
            V_4_CHANNEL_MULTIPLEXING = 2 { name = "V 4 Channel Multiplexing"; desc = "4-channel multiplexing mode"; };
            RESERVED = 3 { name = "Reserved"; desc = "reserved"; };
        };

        field {
            name = "port_mux_mode";
            desc = "Multiplexing mode.";
            sw = rw;
            hw = r;
            encode = PT_INTF_MOD_port_mux_mode_enum;
            reset = 0x0;
        } port_mux_mode[9:8];

        enum PT_INTF_MOD_fix_code_enum {
            MSB_1 = 0 { name = "Msb 1"; desc = "The MSB is 1."; };
            MSB_0 = 1 { name = "Msb 0"; desc = "The MSB is 0."; };
        };

        field {
            name = "fix_code";
            desc = "MSB of the sync code.";
            sw = rw;
            hw = r;
            encode = PT_INTF_MOD_fix_code_enum;
            reset = 0x0;
        } fix_code[7:7];

        enum PT_INTF_MOD_port_mod_enum {
            SINGLE_COMPONENT_INPUT = 0 { name = "Single Component Input"; desc = "single-component input"; };
            DUAL_COMPONENT_INPUT = 1 { name = "Dual Component Input"; desc = "dual-component input Other values: reserved"; };
        };

        field {
            name = "port_mod";
            desc = "Port mode.";
            sw = rw;
            hw = r;
            encode = PT_INTF_MOD_port_mod_enum;
            reset = 0x0;
        } port_mod[4:3];

        enum PT_INTF_MOD_clk_mode_enum {
            SAMPLING_RISING_EDGE = 0 { name = "Sampling Rising Edge"; desc = "sampling on the rising edge"; };
            SAMPLING_FALLING_EDGE = 1 { name = "Sampling Falling Edge"; desc = "sampling on the falling edge"; };
        };

        field {
            name = "clk_mode";
            desc = "Clock mode.";
            sw = rw;
            hw = r;
            encode = PT_INTF_MOD_clk_mode_enum;
            reset = 0x0;
        } clk_mode[1:1];

        enum PT_INTF_MOD_port_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "port_en";
            desc = "Port enable.";
            sw = rw;
            hw = r;
            encode = PT_INTF_MOD_port_en_enum;
            reset = 0x0;
        } port_en[0:0];
    } PT_INTF_MOD @ 0x0;

    reg {
        name = "R component mask register";
        desc = "PT_R_MASK_L is R component mask register.

Data sheet 11.1.6 PT_R_MASK_L (offset 0x10004, printed page 11-23, `datasheet.txt` line 34036).";

        field {
            name = "r_mask";
            desc = "R component mask.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } r_mask[31:0];
    } PT_R_MASK_L @ 0x4;

    reg {
        name = "B component mask register";
        desc = "PT_B_MASK_L is B component mask register.

Data sheet 11.1.6 PT_B_MASK_L (offset 0x10008, printed page 11-24, `datasheet.txt` line 34065).";

        field {
            name = "b_mask";
            desc = "B component mask.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } b_mask[31:0];
    } PT_B_MASK_L @ 0x8;

    reg {
        name = "G component mask register";
        desc = "PT_G_MASK_L is G component mask register.

Data sheet 11.1.6 PT_G_MASK_L (offset 0x1000C, printed page 11-24, `datasheet.txt` line 34084).";

        field {
            name = "g_mask";
            desc = "G component mask.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } g_mask[31:0];
    } PT_G_MASK_L @ 0xC;

    reg {
        name = "R component offset register";
        desc = "PT_R_OFFSET_L is R component offset register.

Data sheet 11.1.6 PT_R_OFFSET_L (offset 0x10014, printed page 11-24, `datasheet.txt` line 34102).";

        field {
            name = "r_offset";
            desc = "R component offset.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } r_offset[7:0];
    } PT_R_OFFSET_L @ 0x14;

    reg {
        name = "B component offset register";
        desc = "PT_B_OFFSET_L is B component offset register.

Data sheet 11.1.6 PT_B_OFFSET_L (offset 0x10018, printed page 11-25, `datasheet.txt` line 34130).";

        field {
            name = "b_offset";
            desc = "B component offset.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } b_offset[7:0];
    } PT_B_OFFSET_L @ 0x18;

    reg {
        name = "G component offset register";
        desc = "PT_G_OFFSET_L is G component offset register.

Data sheet 11.1.6 PT_G_OFFSET_L (offset 0x1001C, printed page 11-25, `datasheet.txt` line 34150).";

        field {
            name = "g_offset";
            desc = "G component offset.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } g_offset[7:0];
    } PT_G_OFFSET_L @ 0x1C;

    reg {
        name = "Port test configuration register";
        desc = "PT_TEST_CFG is a port test configuration register.

Data sheet 11.1.6 PT_TEST_CFG (offset 0x10040, printed page 11-25, `datasheet.txt` line 34169).";

        field {
            name = "interlace";
            desc = "interlace";
            sw = rw;
            hw = r;
            reset = 0x0;
        } interlace[2:2];

        field {
            name = "hsync_sel";
            desc = "hsync_sel";
            sw = rw;
            hw = r;
            reset = 0x0;
        } hsync_sel[1:1];

        field {
            name = "cbar_en";
            desc = "cbar_en";
            sw = rw;
            hw = r;
            reset = 0x0;
        } cbar_en[0:0];
    } PT_TEST_CFG @ 0x40;

    reg {
        name = "Port ID status register";
        desc = "PT_ID_STATUS is a port ID status register.

Data sheet 11.1.6 PT_ID_STATUS (offset 0x10044, printed page 11-26, `datasheet.txt` line 34226).";

        field {
            name = "id3";
            desc = "Channel 3 ID.";
            sw = r;
            hw = w;
            reset = 0x0;
        } id3[7:6];

        field {
            name = "id2";
            desc = "Channel 2 ID.";
            sw = r;
            hw = w;
            reset = 0x0;
        } id2[5:4];

        field {
            name = "id1";
            desc = "Channel 1 ID.";
            sw = r;
            hw = w;
            reset = 0x0;
        } id1[3:2];

        field {
            name = "id0";
            desc = "Channel 0 ID.";
            sw = r;
            hw = w;
            reset = 0x0;
        } id0[1:0];
    } PT_ID_STATUS @ 0x44;

    reg {
        name = "Port timing register 0";
        desc = "CH_INTF_CFG0 is timing register 0.

Data sheet 11.1.6 CH_INTF_CFG0 (offset 0x10300, printed page 11-27, `datasheet.txt` line 34256).";

        field {
            name = "port_scan_mod";
            desc = "Port data input mode. Bit[8]: Scan_mode[1] 0: Y/C composite input mode 1: Y/C separation input mode Bit[7]: Scan_mode[0] 0: interlaced input mode 1: progressive input mode";
            sw = rw;
            hw = r;
            reset = 0x0;
        } port_scan_mod[8:7];

        field {
            name = "port_mode";
            desc = "Port data receive mode. 00: BT.656/BT.1120 mode Other values: reserved";
            sw = rw;
            hw = r;
            reset = 0x0;
        } port_mode[6:5];
    } CH_INTF_CFG0 @ 0x300;

    reg {
        name = "Port timing register 1";
        desc = "CH_INTF_CFG1 is timing register 1.

Data sheet 11.1.6 CH_INTF_CFG1 (offset 0x10304, printed page 11-28, `datasheet.txt` line 34314).";

        enum CH_INTF_CFG1_port_mod_enum {
            SINGLE_COMPONENT_INPUT = 0 { name = "Single Component Input"; desc = "single-component input"; };
            DUAL_COMPONENT_INPUT = 1 { name = "Dual Component Input"; desc = "dual-component input"; };
            TRIPLE_COMPONENT_INPUT = 2 { name = "Triple Component Input"; desc = "triple -component input"; };
            RESERVED = 3 { name = "Reserved"; desc = "reserved"; };
        };

        field {
            name = "port_mod";
            desc = "Port mode.";
            sw = rw;
            hw = r;
            encode = CH_INTF_CFG1_port_mod_enum;
            reset = 0x0;
        } port_mod[15:14];

        field {
            name = "yuv_seq";
            desc = "YUV input sequence. 00: UYVY 01: VYUY 10: YUYV 11: YVYU UV sequence in dual-component mode. 00: VUVU 01: UVUV 10: reserved 11: reserved";
            sw = rw;
            hw = r;
            reset = 0x0;
        } yuv_seq[5:4];

        enum CH_INTF_CFG1_ftc_cfg_enum {
            FIXED_AT_1 = 0 { name = "Fixed At 1"; desc = "fixed at 1"; };
            FIXED_AT_0 = 1 { name = "Fixed At 0"; desc = "fixed at 0"; };
        };

        field {
            name = "ftc_cfg";
            desc = "MSB of the BT.656 timing reference code.";
            sw = rw;
            hw = r;
            encode = CH_INTF_CFG1_ftc_cfg_enum;
            reset = 0x0;
        } ftc_cfg[3:3];

        enum CH_INTF_CFG1_ftc_polar_enum {
            V_1ST_FIELD_F = 0 { name = "V 1St Field F"; desc = "1st field:F = 0 and 2nd field:F = 1 (standard)"; };
            V_1ST_FIELD_F_2 = 1 { name = "V 1St Field F 2"; desc = "1st field:F = 1 and 2nd field:F = 0 (non-standard)"; };
        };

        field {
            name = "ftc_polar";
            desc = "Polarity of the field indication bit (F) of the BT.656 timing reference code.";
            sw = rw;
            hw = r;
            encode = CH_INTF_CFG1_ftc_polar_enum;
            reset = 0x0;
        } ftc_polar[2:2];

        enum CH_INTF_CFG1_sav_ver_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
