            sw = rw;
            hw = r;
            encode = CH_INTF_CFG1_sav_ver_en_enum;
            reset = 0x0;
        } sav_ver_en[0:0];
    } CH_INTF_CFG1 @ 0x304;

    reg {
        name = "Frame sync delay register";
        desc = "CH_FSTART_DLY is frame sync delay register. The data sheet lists no bit fields for it.

Data sheet 11.1.6 CH_FSTART_DLY (offset 0x10360, printed page 11-29, `datasheet.txt` line 34379).";

        field {
            name = "value";
            desc = "Register value (the data sheet gives no bit table for this register).";
            sw = rw;
            hw = r;
            reset = 0x0;
        } value[31:0];
    } CH_FSTART_DLY @ 0x360;

    reg {
        name = "Channel control register";
        desc = "CH_CTRL is a channel control register.

Data sheet 11.1.6 CH_CTRL (offset 0x10400, printed page 11-29, `datasheet.txt` line 34398).";

        enum CH_CTRL_ch_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "ch_en";
            desc = "Channel enable.";
            sw = rw;
            hw = r;
            encode = CH_CTRL_ch_en_enum;
            reset = 0x0;
        } ch_en[0:0];
    } CH_CTRL @ 0x400;

    reg {
        name = "Capture control register";
        desc = "CH_REG_NEWER is a capture control register.

Data sheet 11.1.6 CH_REG_NEWER (offset 0x10404, printed page 11-30, `datasheet.txt` line 34431).";

        field {
            name = "reg_newer";
            desc = "Channel updated. This bit is automatically cleared when a frame is received.";
            sw = rw;
