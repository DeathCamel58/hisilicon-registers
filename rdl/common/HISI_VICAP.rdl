            desc = "Port data input mode. Bit[8]: Scan_mode[1] 0: Y/C composite input mode 1: Y/C separation input mode Bit[7]: Scan_mode[0] 0: interlaced input mode 1: progressive input mode";
            sw = rw;
            hw = r;
            reset = 0x0;
        } port_scan_mod[8:7];

        field {
            name = "port_mode";
            desc = "Port data receive mode. 00: BT.656/BT.1120 mode Other values: reserved";
            sw = rw;
            hw = r;
            reset = 0x0;
        } port_mode[6:5];

