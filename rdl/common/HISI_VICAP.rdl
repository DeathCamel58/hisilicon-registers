        desc = "CH_INT_RAW is a channel raw interrupt register.

Data sheet 11.1.6 CH_INT_RAW (offset 0x10430, printed page 11-33, `datasheet.txt` line 34650).";

        enum CH_INT_RAW_bus_err_enum {
            NO_RAW_INTERRUPT = 0 { name = "No Raw Interrupt"; desc = "No raw interrupt is generated."; };
            RAW_INTERRUPT_GENERATED = 1 { name = "Raw Interrupt Generated"; desc = "A raw interrupt is generated."; };
        };

        field {
            name = "bus_err";
            desc = "Status of the bus error interrupt. Writing 1 clears this interrupt.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            encode = CH_INT_RAW_bus_err_enum;
            reset = 0x0;
        } bus_err[18:18];

        enum CH_INT_RAW_buf_ovf_enum {
            NO_RAW_INTERRUPT = 0 { name = "No Raw Interrupt"; desc = "No raw interrupt is generated."; };
            RAW_INTERRUPT_GENERATED = 1 { name = "Raw Interrupt Generated"; desc = "A raw interrupt is generated."; };
        };

        field {
            name = "buf_ovf";
            desc = "Status of the internal FIFO overflow error interrupt. Writing 1 clears this interrupt.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            encode = CH_INT_RAW_buf_ovf_enum;
            reset = 0x0;
        } buf_ovf[17:17];

