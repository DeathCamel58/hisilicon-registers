        desc = "CH_C_CLIP_CFG is a chrominance clip configuration register.

Source: data sheet 11.1.6 CH_C_CLIP_CFG (offset 0x10B04, printed page 11-51, `datasheet.txt` line 35707).";

        field {
            name = "max";
            desc = "Maximum output value.";
            sw = rw;
            hw = r;
            reset = 0xFF;
        } max[23:16];

        field {
            name = "min";
            desc = "Minimum output value.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } min[7:0];
    } CH_C_CLIP_CFG @ 0xB04;

    reg {
        name = "Input picture total luminance statistics register";
        desc = "CH_SUM_Y is an input picture total luminance statistics register.

Source: data sheet 11.1.6 CH_SUM_Y (offset 0x10C00, printed page 11-52, `datasheet.txt` line 35739).

Source: vendor module hi3520D_viu.ko (Hi3520D_MPP_V2.0.5.1, HiMPP kernel module from the OpenIPC Hi3520D rootfs; static disassembly), VIU_HAL_GetLuma (+0x900), confidence HIGH. Not verified on hardware.";

        field {
            name = "sum_y";
            desc = "Total luminance statistics.";
            sw = r;
            hw = w;
            reset = 0x0;
        } sum_y[31:0];
    } CH_SUM_Y @ 0xC00;

};

regfile eHISI_VICAP {
    name = "HiSilicon video capture";
    desc = "
    HiSilicon video capture (VICAP) at 0x20580000 (256 KB window), GIC interrupt ID 68. Receives BT.656 (mux) or BT.1120 (mux) video on two 8-bit ports or one 16-bit port (Hi3520D; Hi3515A: one BT.656 port), 8 channels (Hi3515A: 4) of up to 1080p/D1/960H, optional horizontal down-scaling (2x integral), crop window, mirror/flip, luminance statistics, SP420/SP422 output into DDR, two bus priority levels per channel. Registers 0x0000-0x0200 are system registers (WK_MODE, AXI_CFG, MIXER0_PRO_CFG0, VICAP_INT); everything from 0x10000 is per-port/per-channel (see `eHISI_VICAP_CH`). Registers and reset values are from Hi3520D/Hi3515A/Hi3515C data sheet issue 07, chapter 11.1 (`datasheet.txt` lines 32831-35753). Not hardware verified. The data sheet also marks 4-channel 720p input as \"Hi3520D V200 only\". Clock and reset: PERI_CRG (VICAP bits).

    **Other chips (data sheet cross-check 2026-11-09):** no other data sheet in the tree carries this multi-channel VICAP layout (WK_MODE / AXI_CFG / MIXER0_PRO_CFG0 at 0x0000 and
    16 x 0x2000 channel blocks from 0x10000). The Hi3511 / Hi3512 / Hi3515 / Hi3520 VIU, the Hi3516 V100 VICAP (226 registers), the Hi3518 V100 / Hi3518E V100 / Hi3516C V100 VICAP (116
    registers) and the single-port Hi3518E V20X / Hi3516A / Hi3516C V300 / Hi3519 VICAP (`eHISI_VICAP_V2`, PT/DES/CH names) are other generations.
    ";

    reg {
        name = "Global working configuration register";
        desc = "WK_MODE is a global working configuration register.

Source: data sheet 11.1.6 WK_MODE (offset 0x0, printed page 11-18, `datasheet.txt` line 33726).

Source: vendor module hi3520D_viu.ko (Hi3520D_MPP_V2.0.5.1, HiMPP kernel module from the OpenIPC Hi3520D rootfs; static disassembly), VIU_HAL_SetPowerWorkMode (bit 0 = power_mode), VIU_HAL_SetPortMode (bit 16 for port 0, bit 17 for port 1), confidence HIGH for the positions. Vendor use: ptN_mode is set to 1 when the device interface type is 2, 3 or 4 (BT.1120 standard/interleaved and the digital camera type; VIU_DRV_SetDevAttrByChip: type - 2 <= 2) and to 0 for BT.656 and BT.601 -- it follows the INTERFACE type, not the line count. The board script sysctl_hi3520D.sh writes WK_MODE = 0 ('vicap lowpower'), i.e. power_mode 0. Previously: our Linux driver sets ptN_mode for inputs above 576 lines (derived from the data sheet text only). Not verified on hardware. Board: reads 0 at idle (confirmed).";

        enum WK_MODE_pt1_mode_enum {
            D1_960H = 0 { name = "D1 960H"; desc = "D1 or 960H"; };
            V_720P = 1 { name = "V 720P"; desc = "720p"; };
        };

        field {
            name = "pt1_mode";
            desc = "Operating mode of port 1.";
            sw = rw;
            hw = r;
            encode = WK_MODE_pt1_mode_enum;
            reset = 0x0;
        } pt1_mode[17:17];

        enum WK_MODE_pt0_mode_enum {
            D1_960H = 0 { name = "D1 960H"; desc = "D1 or 960H"; };
            V_720P_1080P = 1 { name = "V 720P 1080P"; desc = "720p or 1080p"; };
        };

        field {
            name = "pt0_mode";
            desc = "Operating mode of port 0.";
            sw = rw;
            hw = r;
            encode = WK_MODE_pt0_mode_enum;
            reset = 0x0;
        } pt0_mode[16:16];

        enum WK_MODE_power_mode_enum {
            LOW_POWER_MODE = 0 { name = "Low Power Mode"; desc = "The low-power mode is disabled."; };
            LOW_POWER_MODE_2 = 1 { name = "Low Power Mode 2"; desc = "The low-power mode is enabled."; };
        };

        field {
            name = "power_mode";
            desc = "Clock mode.";
            sw = rw;
            hw = r;
            encode = WK_MODE_power_mode_enum;
            reset = 0x0;
        } power_mode[0:0];
    } WK_MODE @ 0x0;

    reg {
        name = "Bus configuration register";
        desc = "AXI_CFG is a bus configuration register.

Source: data sheet 11.1.6 AXI_CFG (offset 0x4, printed page 11-18, `datasheet.txt` line 33762).

Source: vendor module hi3520D_viu.ko (Hi3520D_MPP_V2.0.5.1, HiMPP kernel module from the OpenIPC Hi3520D rootfs; static disassembly), VIU_HAL_BoardInit (0x140cc: read-modify-write of [3:0] = 2 right after ioremap of 0x20580000 size 0x20000) and board script sysctl_hi3520D.sh ('himm 0x20580004 0xf0f00002 # vicap outstanding'), confidence HIGH: the vendor always programs m0_otd = 2 (the Linux driver leaves it at the reset value 0). Whether m0_otd = 0 stalls the write master is UNKNOWN. Not verified on hardware. Board: reads 0xF0F00000 (confirmed).";

        field {
            name = "reserved_nz";
            desc = "Reserved (RO); reads 0xF0F: the data sheet total reset value of AXI_CFG is 0xF0F0_0000 (bits 31:28 and 23:20 set).";
            sw = r;
            hw = w;
            reset = 0xF0F;
        } reserved_nz[31:20];

        field {
            name = "m0_id";
            desc = "ID.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } m0_id[19:16];

        field {
            name = "m0_otd";
            desc = "Number of outstandings. The number must be between 0 and 4.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } m0_otd[3:0];
    } AXI_CFG @ 0x4;

    reg {
        name = "Master priority configuration register";
        desc = "MIXER0_PRO_CFG0 is master priority configuration register.

Source: data sheet 11.1.6 MIXER0_PRO_CFG0 (offset 0x8, printed page 11-19, `datasheet.txt` line 33795).

Source: vendor module hi3520D_viu.ko (Hi3520D_MPP_V2.0.5.1, HiMPP kernel module from the OpenIPC Hi3520D rootfs; static disassembly), VIU_HAL_SetMasterPro (0x13f30): pair n (0..7) writes bit 2n and bit 2n+1 (luma/chroma priority of channel n); VIU_HAL_BoardInit writes all pairs 0 (highest priority, = reset), confidence HIGH. Not verified on hardware.";

        field {
            name = "ch7_c_pro";
            desc = "Chrominance priority of channel 7. The value 0 indicates the highest priority.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } ch7_c_pro[15:15];

        field {
            name = "ch7_y_pro";
            desc = "Luminance priority of channel 7. The value 0 indicates the highest priority.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } ch7_y_pro[14:14];

        field {
            name = "ch6_c_pro";
            desc = "Chrominance priority of channel 6. The value 0 indicates the highest priority.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } ch6_c_pro[13:13];

        field {
            name = "ch6_y_pro";
            desc = "Luminance priority of channel 6. The value 0 indicates the highest priority.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } ch6_y_pro[12:12];

        field {
            name = "ch5_c_pro";
            desc = "Chrominance priority of channel 5. The value 0 indicates the highest priority.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } ch5_c_pro[11:11];

        field {
            name = "ch5_y_pro";
            desc = "Luminance priority of channel 5. The value 0 indicates the highest priority.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } ch5_y_pro[10:10];

        field {
            name = "ch4_c_pro";
            desc = "Chrominance priority of channel 4. The value 0 indicates the highest priority.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } ch4_c_pro[9:9];

        field {
            name = "ch4_y_pro";
            desc = "Luminance priority of channel 4. The value 0 indicates the highest priority.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } ch4_y_pro[8:8];

        field {
            name = "ch3_c_pro";
            desc = "Chrominance priority of channel 3. The value 0 indicates the highest priority.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } ch3_c_pro[7:7];

        field {
            name = "ch3_y_pro";
            desc = "Luminance priority of channel 3. The value 0 indicates the highest priority.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } ch3_y_pro[6:6];

        field {
            name = "ch2_c_pro";
            desc = "Chrominance priority of channel 2. The value 0 indicates the highest priority.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } ch2_c_pro[5:5];

        field {
            name = "ch2_y_pro";
            desc = "Luminance priority of channel 2. The value 0 indicates the highest priority.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } ch2_y_pro[4:4];

        field {
            name = "ch1_c_pro";
            desc = "Chrominance priority of channel 1. The value 0 indicates the highest priority.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } ch1_c_pro[3:3];

        field {
            name = "ch1_y_pro";
            desc = "Luminance priority of channel 1. The value 0 indicates the highest priority.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } ch1_y_pro[2:2];

        field {
            name = "ch0_c_pro";
            desc = "Chrominance priority of channel 0. The value 0 indicates the highest priority.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } ch0_c_pro[1:1];

        field {
            name = "ch0_y_pro";
            desc = "Luminance priority of channel 0. The value 0 indicates the highest priority.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } ch0_y_pro[0:0];
    } MIXER0_PRO_CFG0 @ 0x8;

    reg {
        name = "Interrupt indicator register";
        desc = "VICAP_INT is an interrupt indicator register.

Source: data sheet 11.1.6 VICAP_INT (offset 0x100, printed page 11-20, `datasheet.txt` line 33877).

Source: vendor module hi3520D_viu.ko (Hi3520D_MPP_V2.0.5.1, HiMPP kernel module from the OpenIPC Hi3520D rootfs; static disassembly), VIU_HAL_GetIntIndicator (+0x100, one bit per channel as read by the vendor ISR before the per-channel status registers), confidence MEDIUM for the bit meaning, HIGH for the offset. Not verified on hardware.";

        enum VICAP_INT_int_ch7_enum {
            NO_INTERRUPT_GENERATED = 0 { name = "No Interrupt Generated"; desc = "No interrupt is generated."; };
            INTERRUPT_GENERATED = 1 { name = "Interrupt Generated"; desc = "An interrupt is generated."; };
        };

        field {
            name = "int_ch7";
            desc = "Interrupt indicator of channel 7.";
            sw = r;
            hw = w;
            encode = VICAP_INT_int_ch7_enum;
            reset = 0x0;
        } int_ch7[7:7];

        enum VICAP_INT_int_ch6_enum {
            NO_INTERRUPT_GENERATED = 0 { name = "No Interrupt Generated"; desc = "No interrupt is generated."; };
            INTERRUPT_GENERATED = 1 { name = "Interrupt Generated"; desc = "An interrupt is generated."; };
        };

        field {
            name = "int_ch6";
            desc = "Interrupt indicator of channel 6.";
            sw = r;
            hw = w;
            encode = VICAP_INT_int_ch6_enum;
            reset = 0x0;
        } int_ch6[6:6];

        enum VICAP_INT_int_ch5_enum {
            NO_INTERRUPT_GENERATED = 0 { name = "No Interrupt Generated"; desc = "No interrupt is generated."; };
            INTERRUPT_GENERATED = 1 { name = "Interrupt Generated"; desc = "An interrupt is generated."; };
        };

        field {
            name = "int_ch5";
            desc = "Interrupt indicator of channel 5.";
            sw = r;
            hw = w;
            encode = VICAP_INT_int_ch5_enum;
            reset = 0x0;
        } int_ch5[5:5];

        enum VICAP_INT_int_ch4_enum {
            NO_INTERRUPT_GENERATED = 0 { name = "No Interrupt Generated"; desc = "No interrupt is generated."; };
            INTERRUPT_GENERATED = 1 { name = "Interrupt Generated"; desc = "An interrupt is generated."; };
        };

        field {
            name = "int_ch4";
            desc = "Interrupt indicator of channel 4.";
            sw = r;
            hw = w;
            encode = VICAP_INT_int_ch4_enum;
            reset = 0x0;
        } int_ch4[4:4];

        enum VICAP_INT_int_ch3_enum {
            NO_INTERRUPT_GENERATED = 0 { name = "No Interrupt Generated"; desc = "No interrupt is generated."; };
            INTERRUPT_GENERATED = 1 { name = "Interrupt Generated"; desc = "An interrupt is generated."; };
        };

        field {
            name = "int_ch3";
            desc = "Interrupt indicator of channel 3.";
            sw = r;
            hw = w;
            encode = VICAP_INT_int_ch3_enum;
            reset = 0x0;
        } int_ch3[3:3];

        enum VICAP_INT_int_ch2_enum {
            NO_INTERRUPT_GENERATED = 0 { name = "No Interrupt Generated"; desc = "No interrupt is generated."; };
            INTERRUPT_GENERATED = 1 { name = "Interrupt Generated"; desc = "An interrupt is generated."; };
        };

        field {
            name = "int_ch2";
            desc = "Interrupt indicator of channel 2.";
            sw = r;
            hw = w;
            encode = VICAP_INT_int_ch2_enum;
            reset = 0x0;
        } int_ch2[2:2];

        enum VICAP_INT_int_ch1_enum {
            NO_INTERRUPT_GENERATED = 0 { name = "No Interrupt Generated"; desc = "No interrupt is generated."; };
            INTERRUPT_GENERATED = 1 { name = "Interrupt Generated"; desc = "An interrupt is generated."; };
        };

        field {
            name = "int_ch1";
            desc = "Interrupt indicator of channel 1.";
            sw = r;
            hw = w;
            encode = VICAP_INT_int_ch1_enum;
            reset = 0x0;
        } int_ch1[1:1];

        enum VICAP_INT_int_ch0_enum {
            NO_INTERRUPT_GENERATED = 0 { name = "No Interrupt Generated"; desc = "No interrupt is generated."; };
            INTERRUPT_GENERATED = 1 { name = "Interrupt Generated"; desc = "An interrupt is generated."; };
        };

        field {
            name = "int_ch0";
            desc = "Interrupt indicator of channel 0.";
            sw = r;
            hw = w;
            encode = VICAP_INT_int_ch0_enum;
            reset = 0x0;
        } int_ch0[0:0];
    } VICAP_INT @ 0x100;

    eHISI_VICAP_CH CH[16] @ 0x10000 += 0x2000;

};

