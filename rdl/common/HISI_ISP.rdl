        } isp_bypass[0:0];
    } ISP_ISPBYPASS @ 0x94;

    reg {
        name = "ISP interrupt indicator register";
        desc = "ISP_INT is an ISP interrupt indicator register.

Data sheet 10.6 ISP_INT (offset 0x200F0, printed page 10-47, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 62003).";

        enum ISP_INT_update_cfg_yuv444_enum {
