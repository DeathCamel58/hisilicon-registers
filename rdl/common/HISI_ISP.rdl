`ifndef HISI_ISP_RDL
`define HISI_ISP_RDL

// ISP (image signal processor) of the Hi3518EV200 / Hi3516CV200 (data sheet chapter 10); offsets rebased by -0x20000, instantiate at 0x205A0000.
regfile eHISI_ISP {
    name = "ISP (image signal processor)";
    desc = "
    Image signal processor (ISP) of the Hi3518E V20X / Hi3516C V200 (data sheet chapter 10): the pipeline between the VICAP sensor input and the VPSS: black level, static/dynamic defect pixel
    correction, FPN removal, bayer denoising, demosaic, gamma, DRC, sensor built-in WDR, AWB/AE/AF statistics, lens shading and distortion correction, sharpening, DIS, anti-fog, colour management;
    up to 14-bit bayer input, 2048 x 1208 maximum / 480 x 240 minimum. The ISP interrupt is part of the VICAP interrupt (VIC 22, data sheet 10.3: ISP_INT_* registers at 0x20080..0x200A4
    of this block).

    **Address:** the data sheet lists the ISP registers in the VICAP window with offsets 0x20080-0x32324 from the VICAP base 0x20580000 (Table 10-10 'base address 0x2058_0000'). This regfile
    is written with those offsets minus 0x20000 and is meant to be instantiated at 0x205A0000, so that it does not overlap the VICAP regfile at 0x20580000 (register ISP_VERSION is then at
    0x205A0080 = data sheet 0x20080). Register groups (data sheet 10.5): 0x20080 global/interrupt/timing, 0x200E0 input and format, 0x201xx YUV444/422 timing, 0x22000 AE, 0x22200 AF, 0x23000
    RGBIR/WB/..., 0x24000 sharpen/NR/LSC, 0x25000 ..., up to 0x32324.

    Register table: data sheet 10.5 / 10.6 (`hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` lines 60690-75460), 465 registers transcribed mechanically from the data sheet (fields, access types, reset values, descriptions); 4 registers have
    no field descriptions in the data sheet. The ISP firmware of the vendor SDK is binary; nothing is hardware verified. Many registers are indirect table accesses (`*_WADDR` / `*_WDATA` /
    `*_RADDR` / `*_RDATA` pairs) into internal memories (gamma, LSC, DRC, histogram ...).
    ";

    reg {
        name = "ISP version register";
        desc = "ISP_VERSION is an ISP version register.

Data sheet 10.6 ISP_VERSION (offset 0x20080, printed page 10-43, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 61786).";

        enum ISP_VERSION_version_enum {
            V100 = 0x1 { name = "V100"; desc = "V100"; };
            V200 = 0x2 { name = "V200"; desc = "V200"; };
            V300_SAME_RULE = 0x3 { name = "V300 Same Rule"; desc = "V300 The same rule applies to other values."; };
        };

        field {
            name = "version";
            desc = "ISP version";
            sw = r;
            hw = w;
            encode = ISP_VERSION_version_enum;
            reset = 0x1;
        } version[31:20];

        enum ISP_VERSION_build_enum {
            B01 = 1 { name = "B01"; desc = "B01"; };
            B02_SAME_RULE = 2 { name = "B02 Same Rule"; desc = "B02 The same rule applies to other values."; };
        };

        field {
            name = "build";
            desc = "Subversion number";
            sw = r;
            hw = w;
            encode = ISP_VERSION_build_enum;
            reset = 0x0;
        } build[19:16];

        field {
            name = "sn";
            desc = "Sequence number of the ISP version";
            sw = r;
            hw = w;
            reset = 0x0;
        } sn[15:0];
    } ISP_VERSION @ 0x80;

    reg {
        name = "ISP internal module position select register";
        desc = "ISP_MODULE_POS is an ISP internal module position select register.

Data sheet 10.6 ISP_MODULE_POS (offset 0x20088, printed page 10-43, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 61815).";

        enum ISP_MODULE_POS_af_sel_enum {
            AF_MODULE_AFTER = 0 { name = "Af Module After"; desc = "The AF module is after the DG module."; };
            AF_MODULE_Y = 1 { name = "Af Module Y"; desc = "The AF module is in the Y field after the CSC module."; };
        };

        field {
            name = "af_sel";
            desc = "AF position adjustment register";
            sw = rw;
            hw = r;
            encode = ISP_MODULE_POS_af_sel_enum;
            reset = 0x0;
        } af_sel[3:3];

        enum ISP_MODULE_POS_ae_sel_enum {
            AE_MODULE_AFTER = 0 { name = "Ae Module After"; desc = "The AE module is after the DG module."; };
            AE_MODULE_AFTER_2 = 1 { name = "Ae Module After 2"; desc = "The AE module is after the WB module."; };
            AE_MODULE_AFTER_3 = 2 { name = "Ae Module After 3"; desc = "The AE module is after the DRC module."; };
        };

        field {
            name = "ae_sel";
            desc = "AE position adjustment register";
            sw = rw;
            hw = r;
            encode = ISP_MODULE_POS_ae_sel_enum;
            reset = 0x1;
        } ae_sel[2:1];

        enum ISP_MODULE_POS_dcg_sel_enum {
            DPC_GE_MODULE = 0 { name = "Dpc Ge Module"; desc = "The DPC/GE module is after the BLC module."; };
            DPC_GE_MODULE_2 = 1 { name = "Dpc Ge Module 2"; desc = "The DPC/GE module is after the DRC module."; };
        };

        field {
            name = "dcg_sel";
            desc = "DPC/GE position adjustment register";
            sw = rw;
            hw = r;
            encode = ISP_MODULE_POS_dcg_sel_enum;
            reset = 0x0;
        } dcg_sel[0:0];
    } ISP_MODULE_POS @ 0x88;

    reg {
        name = "ISP input switch register";
        desc = "ISP_CH_SWITCH is an ISP input switch register.

Data sheet 10.6 ISP_CH_SWITCH (offset 0x2008C, printed page 10-44, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 61860).";

        enum ISP_CH_SWITCH_isp_ch_switch_4_enum {
            CHANNEL_0_INPUT = 0 { name = "Channel 0 Input"; desc = "channel 0 input"; };
            CHANNEL_1_INPUT = 1 { name = "Channel 1 Input"; desc = "channel 1 input"; };
            CHANNEL_2_INPUT = 2 { name = "Channel 2 Input"; desc = "channel 2 input"; };
            CHANNEL_3_INPUT = 3 { name = "Channel 3 Input"; desc = "channel 3 input Other values: FPN black frame input"; };
        };

        field {
            name = "isp_ch_switch_4";
            desc = "ISP FPN black frame input data select";
            sw = rw;
            hw = r;
            encode = ISP_CH_SWITCH_isp_ch_switch_4_enum;
            reset = 0x0;
        } isp_ch_switch_4[22:20];

        enum ISP_CH_SWITCH_isp_ch_switch_3_enum {
            CHANNEL_0_INPUT = 0 { name = "Channel 0 Input"; desc = "channel 0 input"; };
            CHANNEL_1_INPUT = 1 { name = "Channel 1 Input"; desc = "channel 1 input"; };
            CHANNEL_2_INPUT = 2 { name = "Channel 2 Input"; desc = "channel 2 input"; };
            FPN_BLACK_FRAME = 4 { name = "Fpn Black Frame"; desc = "FPN black frame input Other values: channel 3 input"; };
        };

        field {
            name = "isp_ch_switch_3";
            desc = "Input data select for ISP channel 3";
            sw = rw;
            hw = r;
            encode = ISP_CH_SWITCH_isp_ch_switch_3_enum;
            reset = 0x0;
        } isp_ch_switch_3[18:16];

        enum ISP_CH_SWITCH_isp_ch_switch_2_enum {
            CHANNEL_0_INPUT = 0 { name = "Channel 0 Input"; desc = "channel 0 input"; };
            CHANNEL_1_INPUT = 1 { name = "Channel 1 Input"; desc = "channel 1 input"; };
            CHANNEL_3_INPUT = 3 { name = "Channel 3 Input"; desc = "channel 3 input"; };
            FPN_BLACK_FRAME = 4 { name = "Fpn Black Frame"; desc = "FPN black frame input Other values: channel 2 input"; };
        };

        field {
            name = "isp_ch_switch_2";
            desc = "Input data select for ISP channel 2";
            sw = rw;
            hw = r;
            encode = ISP_CH_SWITCH_isp_ch_switch_2_enum;
            reset = 0x0;
        } isp_ch_switch_2[14:12];

        enum ISP_CH_SWITCH_isp_ch_switch_1_enum {
            CHANNEL_0_INPUT = 0 { name = "Channel 0 Input"; desc = "channel 0 input"; };
            CHANNEL_2_INPUT = 2 { name = "Channel 2 Input"; desc = "channel 2 input"; };
            CHANNEL_3_INPUT = 3 { name = "Channel 3 Input"; desc = "channel 3 input"; };
            FPN_BLACK_FRAME = 4 { name = "Fpn Black Frame"; desc = "FPN black frame input Other values: channel 1 input"; };
        };

        field {
            name = "isp_ch_switch_1";
            desc = "Input data select for ISP channel 1";
            sw = rw;
            hw = r;
            encode = ISP_CH_SWITCH_isp_ch_switch_1_enum;
            reset = 0x0;
        } isp_ch_switch_1[10:8];

        enum ISP_CH_SWITCH_isp_ch_switch_0_enum {
            CHANNEL_1_INPUT = 1 { name = "Channel 1 Input"; desc = "channel 1 input"; };
            CHANNEL_2_INPUT = 2 { name = "Channel 2 Input"; desc = "channel 2 input"; };
            CHANNEL_3_INPUT = 3 { name = "Channel 3 Input"; desc = "channel 3 input"; };
            FPN_BLACK_FRAME = 4 { name = "Fpn Black Frame"; desc = "FPN black frame input Other values: channel 0 input"; };
        };

        field {
            name = "isp_ch_switch_0";
            desc = "Input data select for ISP channel 0";
            sw = rw;
            hw = r;
            encode = ISP_CH_SWITCH_isp_ch_switch_0_enum;
            reset = 0x0;
        } isp_ch_switch_0[6:4];

        field {
            name = "isp_ch_switch_en";
            desc = "ISP input switch enable";
            sw = rw;
            hw = r;
            reset = 0x0;
        } isp_ch_switch_en[0:0];
    } ISP_CH_SWITCH @ 0x8C;

    reg {
        name = "ISP adjustable interrupt trigger time configuration register";
        desc = "ISP_INT_TIMING_CTRL is an ISP adjustable interrupt trigger time configuration register.

Data sheet 10.6 ISP_INT_TIMING_CTRL (offset 0x20090, printed page 10-46, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 61945).";

        field {
