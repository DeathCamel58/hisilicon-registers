        } timing_cnt[31:0];
    } ISP_INT_TIMING_CTRL @ 0x90;

    reg {
        name = "ISP bypass register";
        desc = "ISP_ISPBYPASS is an ISP bypass register.

Data sheet 10.6 ISP_ISPBYPASS (offset 0x20094, printed page 10-46, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 61964).";

        enum ISP_ISPBYPASS_isp_bypass_enum {
            EMBEDDED_ISP_USED = 0 { name = "Embedded Isp Used"; desc = "The embedded ISP is used."; };
            ISP_BYPASSED_DATA = 1 { name = "Isp Bypassed Data"; desc = "The ISP is bypassed and data is transparently transmitted from the FPN module to the 2DNR/demosaic module"; };
        };

        field {
