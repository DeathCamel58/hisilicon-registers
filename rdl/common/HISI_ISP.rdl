            desc = "Reserved ISP YUV444 register update interrupt status. Writing 1 clears this interrupt.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            encode = ISP_INT_update_cfg_yuv444_enum;
            reset = 0x0;
        } update_cfg_yuv444[14:14];

        enum ISP_INT_cfg_loss_yuv444_enum {
