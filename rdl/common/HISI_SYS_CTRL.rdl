`ifdef SYS_CTRL_PERIPHCTRL3_REG
    reg {
        name = "Peripheral control register 3";
        desc = "SATA PHY control register device. On the Hi3520D (DS 3.4.5, `datasheet.txt` line 10979) it holds the MPLL reference offset (`sata_phy0_ref_clk_sel`, 0 = no offset) and the spread-spectrum select (`sata_phy0_mpll_ss_sel`, must be 0); the vendor SATA driver never writes it. The DS total reset 0x5D75F000 has non-zero bits in the reserved field [31:10] (not modelled). PHY clocks/resets: PERI_CRG45; PHY test options: PERIPHCTRL25. Hardware (Hi3520D V100 board, read on hardware 2026-11-08, stock U-Boot prompt after a cold boot): reads 0x5D75F000, which equals the data sheet total reset; the RDL reset was 0 because the reserved bits [31:10] were not modelled (now the field reserved_nz). The value may be set by the BootROM before the prompt (it is the value at the stock U-Boot prompt after a cold boot; stock U-Boot does not touch SATA).";
`ifdef SYS_CTRL_PERIPHCTRL3_VAR1
        field {
            name = "siolrclk_sel";
            reset = 0x0;
        } siolrclk_sel[29:27];

        field {
            name = "siobclk_sel";
            reset = 0x0;
        } siobclk_sel[26:24];

        field {
            name = "sioclk_sel";
            reset = 0x0;
        } sioclk_sel[23:0];
`endif
`ifdef SYS_CTRL_PERIPHCTRL3_VAR2
        field {
            name = "vpll0_reset";
            reset = 0x0;
        } vpll0_reset[22:22];

        field {
            name = "vpll0_pd";
            reset = 0x0;
        } vpll0_pd[21:21];

        field {
            name = "vpll0_foutvcopd";
            reset = 0x0;
        } vpll0_foutvcopd[20:20];

        field {
            name = "vpll0_postdivpd";
            reset = 0x0;
        } vpll0_postdivpd[19:19];

        field {
            name = "vpll0_fout4phasepd";
            reset = 0x0;
        } vpll0_fout4phasepd[18:18];

        field {
            name = "vpll0_refdiv";
            reset = 0x0;
        } vpll0_refdiv[17:12];

        field {
            name = "vpll0_fbdiv";
            reset = 0x0;
        } vpll0_fbdiv[11:0];
`endif
`ifdef SYS_CTRL_PERIPHCTRL3_VAR3
        field {
            name = "ive_ctrl";
            reset = 0x0;
        } ive_ctrl[17:17];

        field {
            name = "mdu_ddrt_ctrl";
            reset = 0x0;
        } mdu_ddrt_ctrl[7:7];

        field {
            name = "jpge_ctrl";
            reset = 0x0;
        } jpge_ctrl[6:6];

        field {
            name = "tde_ctrl";
            reset = 0x0;
        } tde_ctrl[5:5];

        field {
            name = "vpss_ctrl";
            reset = 0x0;
        } vpss_ctrl[4:4];

        field {
            name = "venc_ctrl";
            reset = 0x0;
        } venc_ctrl[3:3];

        field {
            name = "vicap_ctrl";
            reset = 0x0;
        } vicap_ctrl[1:1];

        field {
            name = "vou_ctrl";
            reset = 0x0;
        } vou_ctrl[0:0];
`endif
`ifdef SYS_CTRL_PERIPHCTRL3_VAR4
        field {
            name = "sata_phy0_mpll_ss_sel";
            reset = 0x0;
        } sata_phy0_mpll_ss_sel[9:8];

        enum PERIPHCTRL3_sata_phy0_ref_clk_sel_enum {
            NO_OFFSET = 0x0 { desc = "no offset (default)"; };
        };

        field {
            name = "sata_phy0_ref_clk_sel";
            encode = PERIPHCTRL3_sata_phy0_ref_clk_sel_enum;
            reset = 0x0;
        } sata_phy0_ref_clk_sel[7:0];

        field {
            name = "reserved_nz";
            desc = "Reserved in the data sheet, but the data sheet total reset 0x5D75F000 and the value read on hardware (2026-11-08, stock U-Boot prompt after a cold boot, twice) both have these bits non-zero. Possibly set by the BootROM before the prompt; the value is that at the stock U-Boot prompt after a cold boot. Keep the value when writing the register (the vendor SATA driver never writes it).";
            reset = 0x175D7C;
        } reserved_nz[31:10];
`endif
    } PERIPHCTRL3 @ 0x0038;
`endif

