`ifdef SYS_CTRL_PERIPHCTRL24_REG
    reg {
        name = "Peripheral control register 24";
        desc = "The peripheral control register 24 (FE PHY address configuration register). Hardware (Hi3520D V100 board, read on hardware 2026-11-08, stock U-Boot prompt after a cold boot): reads 0x00000000, reset here 0x1000 (data sheet). Possible boot value; left at the data sheet value, open question.";

        enum PERIPHCTRL24_fephy_led_ctrl_enum {
            NOT_REVERSED = 0x0 { desc = "Polarity is not reversed."; };
            REVERSED     = 0x1 { desc = "Polarity is reversed."; };
        };

        field {
            name = "fephy_led_ctrl";
            desc = "FE PHY led light polarity control.";
            encode = PERIPHCTRL24_fephy_led_ctrl_enum;
            reset = 0x1;
        } fephy_led_ctrl[12:12];

        enum PERIPHCTRL24_fephy_sel_enum {
            INTERNAL = 0x0 { desc = "Select the internally integrated FE PHY."; };
            EXTERNAL = 0x1 { desc = "Select external FE PHY."; };
        };

        field {
            name = "fephy_sel";
            desc = "FE PHY selection.";
            encode = PERIPHCTRL24_fephy_sel_enum;
            reset = 0x0;
        } fephy_sel[8:8];

        field {
            name = "fephy_ad";
            desc = "PHY address of internally integrated FE PHY.";
            reset = 0x0;
        } fephy_ad[4:0];

    } PERIPHCTRL24 @ 0x0094;
`endif

