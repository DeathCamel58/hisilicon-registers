`ifdef SYS_CTRL_PERIPHCTRL20_REG
    reg {
        name = "Peripheral control register 20";
        desc = "USB control register. On the Hi3520D: configuration of the USB 2.0 host controllers at 0x100B0000 (EHCI) / 0x100A0000 (OHCI): AHB burst enables, UTMI/ULPI bypass, port power and over-current polarity, OHCI suspend clocking (DS 3.4.5, `datasheet.txt` lines 11721-11835). The vendor driver `hiusb-hi3520d.c` (`PERI_USB` = SYS_CTRL + 0x80) on start sets `ulpi_bypass_en` (bit 3, UTMI mode) and clears `wordinterface` (bit 0, 8-bit UTMI), `ss_ena_incr16_i` (bit 9, EHCI burst16 off) and `usbovr_p_ctrl` (bit 17, over-current active low); on stop it undoes all four. Hardware (Hi3520D V100 board, read on hardware 2026-11-08, stock U-Boot prompt after a cold boot): reads 0x000333A8 (phy1_pwr_en bit 13 set) at the stock U-Boot prompt after a cold boot, equal to the reset here. A value of 0x000111A8 seen once under Linux was a hand write that survived a soft reboot (SYS_CTRL registers are not reset by SC_SYSRES).";
`ifdef SYS_CTRL_PERIPHCTRL20_VAR1
        field {
            name = "preamble_sel";
        } preamble_sel[20:20];

        field {
            name = "ovr_merge_en";
        } ovr_merge_en[19:19];

        field {
            name = "pwr_merge_en";
        } pwr_merge_en[18:18];

        field {
            name = "usbovr_p_ctrl";
        } usbovr_p_ctrl[17:17];

        field {
            name = "usbpwr_p_ctrl";
        } usbpwr_p_ctrl[16:16];

        field {
            name = "phy1_ovrcur_en";
        } phy1_ovrcur_en[15:15];

        field {
            name = "phy0_ovrcur_en";
        } phy0_ovrcur_en[14:14];

        field {
            name = "phy1_pwr_en";
        } phy1_pwr_en[13:13];

        field {
            name = "phy0_pwr_en";
        } phy0_pwr_en[12:12];

        field {
            name = "ss_ena_incr16_i";
        } ss_ena_incr16_i[9:9];

        field {
            name = "ss_ena_incr8_i";
        } ss_ena_incr8_i[8:8];

        field {
            name = "ss_ena_incr4_i";
        } ss_ena_incr4_i[7:7];

        field {
            name = "ss_ena_incrx_align_i";
        } ss_ena_incrx_align_i[6:6];

        field {
            name = "ss_autoppd_on_overcur_en_i";
        } ss_autoppd_on_overcur_en_i[5:5];

        field {
            name = "ulpi_bypass_en";
        } ulpi_bypass_en[3:3];

        field {
            name = "app_start_clk_i";
        } app_start_clk_i[2:2];

        field {
            name = "ohci_susp_lgcy_i";
        } ohci_susp_lgcy_i[1:1];

        field {
            name = "wordinterface";
        } wordinterface[0:0];
`endif
`ifdef SYS_CTRL_PERIPHCTRL20_VAR2
        field {
            name = "usbovr_p_ctrl";
        } usbovr_p_ctrl[17:17];

