`ifdef SYS_CTRL_PERIPHCTRL27_0xA0_REG
    reg {
        name = "Peripheral control register 27 (undocumented)";
        desc = "Undocumented: not in the Hi3520D data sheet (other chips have a DDR training register DDRT4 at this offset, which is not known to apply here). Seen in the vendor boot register table (decoded from the OEM boot image; its comment calls it SC_PERIPHCTRL27, 'undocumented on Hi3520D, kept as the SDK table has it'): after the PLLs are locked and the CPU is switched to PLL mode the boot clears bit 0 (read-modify-write, bit 0 only), before the DDR PHY setup. Partial meaning from the Hi3520D V200 vendor U-Boot (`arch/arm/cpu/hi3520d/start.S`, `product/hiddrtv200/ddrtraining.c`, `platform.h`: DDRT_OPTION_REG2 = 0x200500a0, with DDRT_OPTION_REG1 = 0x2005009c): this is the DDR-training option/result register; start.S runs the DDR gate training only if bit 0 is 1 and afterwards stores 0xF (training failed) or 0xA (success) in it, so the vendor boot table clearing bit 0 disables the gate training (meaning unverified on a V100 chip). Field layout otherwise unknown (modelled as one 32-bit field); no reset value known. Other chips call this offset DDRT4 (`DDR Training Register 4`, not reset by a soft reset) which fits.";
        field {
            name = "value";
            desc = "Undocumented: whole register; the vendor boot clears bit 0.";
            sw = rw;
        } value[31:0];
    } PERIPHCTRL27 @ 0x00A0;
`endif

