`ifdef SYS_CTRL_SYSID_REG
    reg {
        name = "Chip ID register";
        desc = "
        The chip model and version number

        !!! NOTE
            A working U-Boot driver can be downloaded here: [`sys-ctrl-chipid-driver.c`](assets/sys-ctrl-chipid-driver.c)

            To implement this driver in a device tree, use this:

                chipid@20050ee0 {
                    compatible = \"hisilicon,hi35xx-chipid\"; // Use the chipid driver
                    reg = <0x20050ee0 0x10>;
                    bootph-pre-ram; // This device should be available before relocation
                };

            This device can also be a subnode of the sys_ctrl device:

                sysctl: system-controller@20050000 {
                    compatible = \"hisilicon,hi3520d-sysctrl\", \"syscon\", \"simple-mfd\";
                    reg = <0x20050000 0x1000>;
                    #address-cells = <1>;
                    #size-cells = <1>;
                    ranges = <0x0 0x20050000 0x1000>;
                    bootph-pre-ram; // This device should be available before relocation

                    chipid@ee0 {
                        compatible = \"hisilicon,hi35xx-chipid\"; // Use the chipid driver
                        reg = <0xee0 0x10>;
                        bootph-pre-ram; // This device should be available before relocation
                    };
                };
        ";

        enum SYSID_enum {
            HI3516AV200 = 0x06000001 { desc = "Hi3516A V200"; };
            HI3516AV300 = 0x3516A300 { desc = "Hi3516A V300"; };
            // TODO: Add other SYSID values as I run across them
        };

        field {
            name = "sysid";
            encode = SYSID_enum;
            sw = r;
            hw = na;
            reset = `SYS_CTRL_SYSID_RESET;
        } sysid[31:0];

    } SYSID @ 0x0EE0;
`endif

`ifdef SYS_CTRL_SYSID0_REG
    reg {
        name = "Chip ID register 0";
`ifdef SYS_CTRL_SYSID_REGWIDTH8
        regwidth = 8; // the Hi3520D data sheet shows SYSID0..3 as 8-bit registers (stride stays 4)
`endif
        desc = "
        The last two characters of the chip version number

        ![SYS_ID](assets/sys-ctrl-system-id.png)

        !!! NOTE
            A working U-Boot driver can be downloaded here: [`sys-ctrl-chipid-driver.c`](assets/sys-ctrl-chipid-driver.c)

            To implement this driver in a device tree, use this:

                chipid@20050ee0 {
                    compatible = \"hisilicon,hi35xx-chipid\"; // Use the chipid driver
                    reg = <0x20050ee0 0x10>;
                    all-sys-id; // Use individual sysid registers
                    bootph-pre-ram; // This device should be available before relocation
                };

            This device can also be a subnode of the sys_ctrl device:

                sysctl: system-controller@20050000 {
                    compatible = \"hisilicon,hi3520d-sysctrl\", \"syscon\", \"simple-mfd\";
                    reg = <0x20050000 0x1000>;
                    #address-cells = <1>;
                    #size-cells = <1>;
                    ranges = <0x0 0x20050000 0x1000>;
                    bootph-pre-ram; // This device should be available before relocation

                    chipid@ee0 {
                        compatible = \"hisilicon,hi35xx-chipid\"; // Use the chipid driver
                        reg = <0xee0 0x10>;
                        all-sys-id; // Use individual sysid registers
                        bootph-pre-ram; // This device should be available before relocation
                    };
                };
        ";

        // The reset value of sysid0..sysid3 is the chip ID of the SoC, taken from the `SYS_CTRL_SYSIDn_RESET`
        // macros that each rdl/<chip>/defines.rdl must define (SYS_CTRL_SYSID_RESET for the single 32-bit register).
        enum SYSID0_enum {
            HIXXXX_VX00     = 0x0 { desc = "Version ending in `00`"; };
            HIXXXX_VX01     = 0x1 { desc = "Version ending in `01`"; };
            // TODO: Add other SYSID values as I run across them
        };

        field {
            name = "sysid0";
            desc = "Least significant byte of the chip ID (the chip version number digits, `HIXXXX VYXX`, where `XX` is this field). The value is SoC-specific.";
            encode = SYSID0_enum;
            sw = r;
            hw = na;
            reset = `SYS_CTRL_SYSID0_RESET;
        } sysid0[7:0];

    } SYSID0 @ 0x0EE0;
`endif

`ifdef SYS_CTRL_SYSID1_REG
    reg {
        name = "Chip ID register 1";
`ifdef SYS_CTRL_SYSID_REGWIDTH8
        regwidth = 8; // the Hi3520D data sheet shows SYSID0..3 as 8-bit registers (stride stays 4)
`endif
        desc = "The last character of the chip model, and first character of the version number";

        enum SYSID1_enum {
            HIXXXX_V1XX     = 0x1 { desc = "Chip `HIXXXX V1XX`"; };
            HIXXXXA_V1XX     = 0xA1 { desc = "Chip `HIXXXXA V1XX`"; };
            HIXXXXC_V3XX     = 0xC3 { desc = "Chip `HIXXXXC V3XX`"; };
            HIXXXXD_V1XX     = 0xD1 { desc = "Chip `HIXXXXD V1XX`"; };
            // TODO: Add other SYSID values as I run across them
        };

        field {
            name = "sysid1";
            desc = "Chip ID byte 1: the last character of the chip model and the first character of the version number (`HIXXXX VYXX`, where `X VY` is this field). The value is SoC-specific.";
            encode = SYSID1_enum;
            sw = r;
            hw = na;
            reset = `SYS_CTRL_SYSID1_RESET;
        } sysid1[7:0];

    } SYSID1 @ 0x0EE4;
`endif

`ifdef SYS_CTRL_SYSID2_REG
    reg {
        name = "Chip ID register 2";
`ifdef SYS_CTRL_SYSID_REGWIDTH8
        regwidth = 8; // the Hi3520D data sheet shows SYSID0..3 as 8-bit registers (stride stays 4)
`endif
        desc = "The third and fourth characters of the chip model.";

        enum SYSID2_enum {
            HIXX11 = 0x11 { desc = "Chip `HIXX11`"; };
            HIXX15 = 0x15 { desc = "Chip `HIXX15`"; };
            HIXX16 = 0x16 { desc = "Chip `HIXX16`"; };
            HIXX18 = 0x18 { desc = "Chip `HIXX18`"; };
            HIXX19 = 0x19 { desc = "Chip `HIXX19`"; };
            HIXX20 = 0x20 { desc = "Chip `HIXX20`"; };
            HIXX31 = 0x31 { desc = "Chip `HIXX31`"; };
            HIXX35 = 0x35 { desc = "Chip `HIXX35`"; };
            // TODO: Add other SYSID values as I run across them
        };

        field {
            name = "sysid2";
            desc = "Chip ID byte 2: the third and fourth characters of the chip model (`HI35XX...`, where `XX` is this field). The value is SoC-specific.";
            encode = SYSID2_enum;
            sw = r;
            hw = na;
            reset = `SYS_CTRL_SYSID2_RESET;
        } sysid2[7:0];

    } SYSID2 @ 0x0EE8;
`endif

`ifdef SYS_CTRL_SYSID3_REG
    reg {
        name = "Chip ID register 3";
`ifdef SYS_CTRL_SYSID_REGWIDTH8
        regwidth = 8; // the Hi3520D data sheet shows SYSID0..3 as 8-bit registers (stride stays 4)
`endif
        desc = "The first and second characters of the chip model.";

        enum SYSID3_enum {
            HI35XX = 0x35 { desc = "Chip `HI35XX`"; };
            // TODO: Add other SYSID values as I run across them
        };

        field {
            name = "sysid3";
            desc = "Chip ID byte 3: the first and second characters of the chip model (`HIXX...`, where `XX` is this field).";
            encode = SYSID3_enum;
            sw = r;
            hw = na;
            reset = `SYS_CTRL_SYSID3_RESET;
        } sysid3[7:0];

    } SYSID3 @ 0x0EEC;
`endif

};
`endif
