    reg {
        name = "Ddrt Intclr";
        desc = "Interrupt clear (vendor name DDRT_INTCLR). Defined, never accessed. Source: vendor U-Boot `product/hiddrtv200/ddrtv200.h` (Hi3520D DDR training), confidence LOW, not verified on hardware.";

        field {
            name = "value";
            desc = "32 bit value, single field (bit layout not observed). Not verified on hardware.";
            sw = w;
