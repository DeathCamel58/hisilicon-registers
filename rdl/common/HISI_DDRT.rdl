`ifdef DDRT_V200_REGS

    reg {
        name = "Ddrt Waddr Offset1";
        desc = "Second write-address offset (vendor name DDRT_WADDR_OFFSET1). Defined in the Hi3520D training header, never accessed by its code. Source: vendor U-Boot `product/hiddrtv200/ddrtv200.h` (Hi3520D DDR training), confidence LOW, not verified on hardware.";

        field {
            name = "value";
            desc = "32 bit value, single field (bit layout not observed). Not verified on hardware.";
            sw = rw;
            hw = r;
        } value[31:0];
    } DDRT_WADDR_OFFSET1 @ 0x28;

    reg {
        name = "Ddrt Reversed Bit Higher";
        desc = "Upper 32 bits of the data-reversal indicator (the lower half is DDRT_REVERSED_DQ at 0x30). Written by the Hi3520D training (ddrt_config_ddrt) from the test configuration (value 0 in all calls seen). Source: vendor U-Boot `product/hiddrtv200/ddrtv200.h` (Hi3520D DDR training), confidence MEDIUM, not verified on hardware.";

        field {
            name = "value";
            desc = "32 bit value, single field (bit layout not observed). Not verified on hardware.";
            sw = rw;
            hw = r;
        } value[31:0];
    } DDRT_REVERSED_BIT_HIGHER @ 0x34;

    reg {
