    reg {
        name = "DMA address register for device OUT endpoint n";
        desc = "DOEPDMAN is a DMA address register for device OUT endpoint n.

Data sheet 12.7.5.2 DOEPDMAN (offset 0xB14, printed page 12-242, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 90597).";

        field {
            name = "dmaaddr";
            desc = "DMA address";
            sw = rw;
            hw = r;
            reset = 0x0;
