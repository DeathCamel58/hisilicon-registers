            V_3_PIN_BIDIRECTIONAL = 1 { name = "V 3 Pin Bidirectional"; desc = "3-pin bidirectional full-speed serial interface If the USB 1.1 full-speed serial transceiver is not selected, this bit is always 0 and write-only. If the USB 1.1 full-speed interface is selected, this bit can be used to select the 3-pin or 6-pin interface and can be read or written."; };
