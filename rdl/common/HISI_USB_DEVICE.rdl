    reg {
        name = "Reset hardware feature register";
        desc = "GRSTCTL is a reset hardware feature register.

The data sheet table for this register is garbled (access words broken across lines, rxfflsh and frmcntrrst printed as RO, the descriptions of txfflsh, rxfflsh, intknqflsh and frmcntrrst shifted by one row, csftrst without text). The fields are rebuilt from the data sheet text and the DWC_otg databook: the four flush/reset bits are set by software and cleared by hardware (`R_WS_SC`).

Data sheet 12.7.5.2 GRSTCTL (offset 0x10, printed page 12-175, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 86865).";

        enum GRSTCTL_ahbidle_enum {
            NO = 0 { name = "No"; desc = "no"; };
            YES = 1 { name = "Yes"; desc = "yes"; };
        };

        field {
            name = "ahbidle";
            desc = "Whether the AHB master state machine is idle";
            sw = r;
            hw = w;
            encode = GRSTCTL_ahbidle_enum;
            reset = 0x1;
        } ahbidle[31:31];

        enum GRSTCTL_dmareq_enum {
            OTHER_CASES = 0 { name = "Other Cases"; desc = "other cases"; };
            DMA_REQUEST_BEING = 1 { name = "Dma Request Being"; desc = "The DMA request is being processed."; };
        };

        field {
            name = "dmareq";
            desc = "DMA request signal, indicating that the DMA request is being processed. This bit is only for debugging.";
            sw = r;
            hw = w;
            encode = GRSTCTL_dmareq_enum;
            reset = 0x0;
        } dmareq[30:30];

        enum GRSTCTL_txfnum_enum {
            HOST_MODE_NON = 0x0 { name = "Host Mode Non"; desc = "In host mode, non-periodic TX FIFOs are flushed. During shared FIFO operations, non-periodic TX FIFOs are flushed in device mode. In dedicated FIFO mode, TX FIFO 0 is flushed in device mode."; };
            HOST_MODE_PERIODIC = 0x1 { name = "Host Mode Periodic"; desc = "In host mode, periodic TX FIFOs are flushed. During shared FIFO operations, periodic TX FIFO 1 is flushed in device mode. In dedicated FIFO mode, TX FIFO 1 is flushed in device mode."; };
            DURING_SHARED_FIFO = 0x2 { name = "During Shared Fifo"; desc = "During shared FIFO operations, periodic TX FIFO 2 is flushed in device mode. In dedicated FIFO mode, TX FIFO 2 is flushed in device mode."; };
            DURING_SHARED_FIFO_2 = 0xF { name = "During Shared Fifo 2"; desc = "During shared FIFO operations, periodic TX FIFO 15 is flushed in device mode. In dedicated FIFO mode, TX FIFO 15 is flushed in device mode."; };
            ALL_TX_FIFOS = 0x10 { name = "All Tx Fifos"; desc = "All TX FIFOs are flushed in device or host mode."; };
        };

        field {
            name = "txfnum";
            desc = "TX FIFO ID, which must be updated by using the TX FIFO flush bit. This field cannot be overwritten before the controller core clears the TX FIFO flush bit.";
            sw = rw;
            hw = r;
            encode = GRSTCTL_txfnum_enum;
            reset = 0x0;
        } txfnum[10:6];

        enum GRSTCTL_txfflsh_enum {
            NOT_FLUSHED = 0 { name = "Not Flushed"; desc = "not flushed"; };
            FLUSHED = 1 { name = "Flushed"; desc = "flushed"; };
        };

        field {
            name = "txfflsh";
            desc = "TX FIFO flush. This bit can be used to flush one or all TX FIFOs (selected by txfnum); the FIFOs cannot be flushed during transactions. This bit can be written only after the application program confirms that the controller core does not read or write the FIFO. It takes eight clock cycles to clear this bit, during which the application program must wait.";
            sw = rw;
            hw = w;
            encode = GRSTCTL_txfflsh_enum;
            reset = 0x0;
        } txfflsh[5:5];

        enum GRSTCTL_rxfflsh_enum {
            NOT_FLUSHED = 0 { name = "Not Flushed"; desc = "not flushed"; };
            FLUSHED = 1 { name = "Flushed"; desc = "flushed"; };
        };

        field {
            name = "rxfflsh";
            desc = "RX FIFO flush. This bit flushes all RX FIFOs; the FIFOs cannot be flushed during transactions. This bit can be written only after the application program confirms that the controller core does not read or write the FIFO. It takes eight clock cycles to clear this bit, during which the application program must wait.";
            sw = rw;
            hw = w;
            encode = GRSTCTL_rxfflsh_enum;
            reset = 0x0;
        } rxfflsh[4:4];

        enum GRSTCTL_intknqflsh_enum {
            NOT_FLUSHED = 0 { name = "Not Flushed"; desc = "not flushed"; };
            FLUSHED = 1 { name = "Flushed"; desc = "flushed"; };
        };

        field {
            name = "intknqflsh";
            desc = "In token sequence learning queue flush. This bit is valid only when OTG_EN_DED_TX_FIFO is 0.";
            sw = rw;
            hw = w;
            encode = GRSTCTL_intknqflsh_enum;
            reset = 0x0;
        } intknqflsh[3:3];

        enum GRSTCTL_frmcntrrst_enum {
            NOT_RESET = 0 { name = "Not Reset"; desc = "not reset"; };
            RESET_F = 1 { name = "Reset F"; desc = "reset"; };
        };

        field {
            name = "frmcntrrst";
            desc = "Host frame counter reset. This bit is used to reset the frame number counter. When the frame number counter is reset, the ID of the next transmitted SOF micro-frame is 0.";
            sw = rw;
            hw = w;
            encode = GRSTCTL_frmcntrrst_enum;
            reset = 0x0;
        } frmcntrrst[2:2];

        field {
            name = "csftrst";
            desc = "Core soft reset. All interrupts and CSR registers are cleared except the bits kept by the controller (PCGCCTL[rstpdwnmodule], PCGCCTL[gatehclk], PCGCCTL[pwrclmp], PCGCCTL[stoppphylpwrclkselclk], GUSBCFG[phylpwrclksel, ddrsel, physel, fsintf, ulpi_utmi_sel, phyif, txenddelay, termseldlpulse, ulpiclksusm, ulpiautores, ulpifsls], GGPIO, GPWRDN, GADPCTL). The bit clears itself when the reset is done; software must wait for it (and GRSTCTL[ahbidle]) before using the core.";
            sw = rw;
            hw = w;
            reset = 0x0;
        } csftrst[0:0];
    } GRSTCTL @ 0x10;

    reg {
        name = "System interrupt register";
        desc = "GINTSTS is a system interrupt register.

Bits that the data sheet marks RWSC are modelled write-1-to-clear (`wc`): hardware sets them, software clears them by writing 1. The `lpm_int` bit (bit 27) has reset 1 and `goutnakeff` (bit 7) has reset 1 per the data sheet's Total Reset Value 0x08000080. The data sheet text of `iepint` refers to DOEPINTn (should be DIEPINTn).

Data sheet 12.7.5.2 GINTSTS (offset 0x14, printed page 12-178, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 87006).";

        field {
            name = "wkupint";
            desc = "Suspend/Resume detection interrupt. Setting this bit to 1 clears the interrupt.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            reset = 0x0;
        } wkupint[31:31];

        field {
            name = "sessreqint";
            desc = "In host mode, an interrupt is generated when a device session request is detected. In device mode, an interrupt is generated when utmisrp_bvalid is 1. Setting this bit to 1 clears the interrupt.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            reset = 0x0;
        } sessreqint[30:30];

        field {
            name = "disconnint";
            desc = "An interrupt is generated when the system detects that the device is disconnected. Setting this bit to 1 clears the interrupt.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            reset = 0x0;
        } disconnint[29:29];

        field {
            name = "conidstschng";
            desc = "An interrupt is generated when the slot ID changes. Setting this bit to 1 clears the interrupt.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            reset = 0x0;
        } conidstschng[28:28];

        field {
            name = "lpm_int";
            desc = "In device mode, an interrupt is generated when the device receives an LPM transaction and transmits a response indicating no errors. In host mode, an interrupt is generated when the device receives an LPM transaction and transmits a response indicating no errors, or when the host core completes the preset LPM transactions.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            reset = 0x1;
        } lpm_int[27:27];

        field {
            name = "ptxfemp";
            desc = "Periodic TX FIFO empty interrupt An interrupt is generated when the periodic TX FIFO is empty or half empty.";
            sw = r;
            hw = w;
            reset = 0x0;
        } ptxfemp[26:26];

        field {
            name = "hchint";
            desc = "In host mode, an interrupt is generated in a core channel. This bit is cleared by clearing the corresponding status bit.";
            sw = r;
            hw = w;
            reset = 0x0;
        } hchint[25:25];

        field {
            name = "prtint";
            desc = "In host mode, an interrupt is generated when the status of a port of the DWC_otg core changes.";
            sw = r;
            hw = w;
            reset = 0x0;
        } prtint[24:24];

        field {
            name = "resetdet";
            desc = "In device mode, an interrupt is generated when the device is suspended and the system detects that the USB module is reset in power-down module. In host mode, this interrupt is not generated.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            reset = 0x0;
        } resetdet[23:23];

        field {
            name = "fetsusp";
            desc = "This interrupt is valid only in DMA mode. This interrupt indicates that the core stops obtaining data from IN endpoints.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            reset = 0x0;
        } fetsusp[22:22];

        field {
            name = "isochronous";
            desc = "In host mode, an interrupt is generated if there are pending transactions. In device mode, an interrupt is generated when there are isochronous OUT transfers to be completed.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            reset = 0x0;
        } isochronous[21:21];

        field {
