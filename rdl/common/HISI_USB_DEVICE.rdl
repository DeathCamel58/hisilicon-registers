`ifndef HISI_USB_DEVICE_RDL
`define HISI_USB_DEVICE_RDL

regfile eHISI_USB_DEVICE_INEP0 {
    name = "USB device IN endpoint 0 registers";
    desc = "Per-endpoint device register set (offsets relative to the start of the set; endpoint n is at 0x900 + 0x20 x n). Endpoint 0 has its own control and transfer-size layouts.";

    reg {
        name = "Control register for device control IN endpoint 0";
        desc = "DIEPCTL0 is a control register for device control IN endpoint 0.

Data sheet 12.7.5.2 DIEPCTL0 (offset 0x900, printed page 12-224, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 89586).";

        enum DIEPCTL_epena_enum {
            INVALID = 0 { name = "Invalid"; desc = "invalid"; };
            VALID = 1 { name = "Valid"; desc = "valid"; };
        };

        field {
            name = "epena";
            desc = "Endpoint enable When the IN endpoint works in scatter or gather DMA mode, this bit indicates that the descriptor structure and data buffer used for transmitting data have been set up. When the scatter or gather DMA mode is disabled, this bit indicates that data to be transmitted is ready.";
            sw = rw;
            hw = w;
            encode = DIEPCTL_epena_enum;
            reset = 0x0;
        } epena[31:31];

        enum DIEPCTL_epdis_enum {
            INVALID = 0 { name = "Invalid"; desc = "invalid"; };
            VALID = 1 { name = "Valid"; desc = "valid"; };
        };

        field {
            name = "epdis";
            desc = "Endpoint disable The application program sets this bit to 1 to end the data transmission of this endpoint. This bit is enabled only in DMA mode.";
            sw = rw;
            hw = w;
            encode = DIEPCTL_epdis_enum;
            reset = 0x0;
        } epdis[30:30];

        enum DIEPCTL_snak_enum {
            INVALID = 0 { name = "Invalid"; desc = "invalid"; };
            VALID = 1 { name = "Valid"; desc = "valid"; };
        };

        field {
            name = "snak";
            desc = "NAK configuration Writing to this bit sets the NAK bit of the endpoint to 1. The application program can use this bit to control the NAK handshake of an endpoint during a transfer. The controller core can set this bit of an endpoint after this endpoint receives the setup packet.";
            sw = w;
            hw = r;
            encode = DIEPCTL_snak_enum;
            reset = 0x0;
        } snak[27:27];

        enum DIEPCTL_cnak_enum {
            INVALID = 0 { name = "Invalid"; desc = "invalid"; };
            VALID = 1 { name = "Valid"; desc = "valid"; };
        };

        field {
            name = "cnak";
            desc = "NAK clear Writing to this bit clears the NAK bit of the endpoint.";
            sw = w;
            hw = r;
            encode = DIEPCTL_cnak_enum;
            reset = 0x0;
        } cnak[26:26];

        field {
            name = "txfnum";
            desc = "Number of TX FIFOs";
            sw = rw;
            hw = r;
            reset = 0x0;
        } txfnum[25:22];

        enum DIEPCTL_stall_enum {
            INVALID = 0 { name = "Invalid"; desc = "invalid"; };
            VALID = 1 { name = "Valid"; desc = "valid"; };
        };

        field {
            name = "stall";
            desc = "Stall handshake The application program can set this bit. The controller core clears this bit after the endpoint receives the setup packet.";
            sw = rw;
            hw = w;
            encode = DIEPCTL_stall_enum;
            reset = 0x0;
        } stall[21:21];

        enum DIEPCTL_eptype_enum {
            CONTROL_TRANSFER_ENDPOINT = 0 { name = "Control Transfer Endpoint"; desc = "control transfer endpoint"; };
            REAL_TIME_TRANSFER = 1 { name = "Real Time Transfer"; desc = "real-time transfer endpoint"; };
            BULK_TRANSFER_ENDPOINT = 2 { name = "Bulk Transfer Endpoint"; desc = "bulk transfer endpoint"; };
            INTERRUPT_TRANSFER_ENDPOINT = 3 { name = "Interrupt Transfer Endpoint"; desc = "interrupt transfer endpoint"; };
        };

        field {
            name = "eptype";
            desc = "Endpoint type";
            sw = r;
            hw = w;
            encode = DIEPCTL_eptype_enum;
            reset = 0x0;
        } eptype[19:18];

        enum DIEPCTL_naksts_enum {
            NON_NAK_HANDSHAKE = 0 { name = "Non Nak Handshake"; desc = "non-NAK handshake TX"; };
            NAK_HANDSHAKE_TX = 1 { name = "Nak Handshake Tx"; desc = "NAK handshake TX"; };
        };

        field {
            name = "naksts";
            desc = "NAK status";
            sw = r;
            hw = w;
            encode = DIEPCTL_naksts_enum;
            reset = 0x0;
        } naksts[17:17];

        enum DIEPCTL_usbactep_enum {
            INVALID = 0 { name = "Invalid"; desc = "invalid"; };
            VALID = 1 { name = "Valid"; desc = "valid"; };
        };

        field {
            name = "usbactep";
            desc = "USB activation endpoint 0 This bit is always 1, indicating that control endpoint 0 is always valid.";
            sw = r;
            hw = w;
            encode = DIEPCTL_usbactep_enum;
            reset = 0x1;
        } usbactep[15:15];

        field {
            name = "nextep";
            desc = "Next endpoint This field specifies the ID of the next endpoint that receives data.";
            sw = r;
            hw = w;
            reset = 0x0;
        } nextep[14:11];

        enum DIEPCTL_mps_enum {
            V_64_BYTES = 0 { name = "V 64 Bytes"; desc = "64 bytes"; };
            V_32_BYTES = 1 { name = "V 32 Bytes"; desc = "32 bytes"; };
            V_16_BYTES = 2 { name = "V 16 Bytes"; desc = "16 bytes"; };
            V_8_BYTES = 3 { name = "V 8 Bytes"; desc = "8 bytes"; };
        };

        field {
            name = "mps";
            desc = "Minimum packet size";
            sw = rw;
            hw = r;
            encode = DIEPCTL_mps_enum;
            reset = 0x0;
        } mps[1:0];
    } DIEPCTL @ 0x0;

    reg {
        name = "Device IN endpoint interrupt register";
        desc = "DIEPINT is an interrupt register for device IN endpoint n.

The data sheet prints one field table for both registers whose field names are partly garbled (`An`, `endpoints`, `TimeOUT_SetUp`) and merges the IN and OUT bit descriptions; the bit layout here follows the standard DWC_otg 2.x/3.x register map (which the data sheet's DIEPMSK/DOEPMSK registers confirm), the descriptions use the data sheet text. Bits are set by hardware and cleared by writing 1.

Data sheet 12.7.5.2 DIEPINTn (printed page 12-234, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 90114).";

        enum DIEPINT_nyetintrpt_enum {
            INTERRUPT_CLEARED = 0 { name = "Interrupt Cleared"; desc = "An interrupt is cleared."; };
            INTERRUPT_GENERATED_WRITING = 1 { name = "Interrupt Generated Writing"; desc = "An interrupt is generated. Writing 1 clears the bit."; };
        };

        field {
            name = "nyetintrpt";
            desc = "NYET interrupt. NYET response TX interrupt.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            encode = DIEPINT_nyetintrpt_enum;
            reset = 0x0;
        } nyetintrpt[14:14];

        enum DIEPINT_nakintrpt_enum {
            INTERRUPT_CLEARED = 0 { name = "Interrupt Cleared"; desc = "An interrupt is cleared."; };
            INTERRUPT_GENERATED_WRITING = 1 { name = "Interrupt Generated Writing"; desc = "An interrupt is generated. Writing 1 clears the bit."; };
        };

        field {
            name = "nakintrpt";
            desc = "NAK interrupt. NAK TX interrupt.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            encode = DIEPINT_nakintrpt_enum;
            reset = 0x0;
        } nakintrpt[13:13];

        enum DIEPINT_bbleerr_enum {
            INTERRUPT_CLEARED = 0 { name = "Interrupt Cleared"; desc = "An interrupt is cleared."; };
            INTERRUPT_GENERATED_WRITING = 1 { name = "Interrupt Generated Writing"; desc = "An interrupt is generated. Writing 1 clears the bit."; };
        };

        field {
            name = "bbleerr";
            desc = "Babble error interrupt. Endpoint received babble interrupt.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            encode = DIEPINT_bbleerr_enum;
            reset = 0x0;
        } bbleerr[12:12];

        enum DIEPINT_pktdrpsts_enum {
            INTERRUPT_CLEARED = 0 { name = "Interrupt Cleared"; desc = "An interrupt is cleared."; };
            INTERRUPT_GENERATED_WRITING = 1 { name = "Interrupt Generated Writing"; desc = "An interrupt is generated. Writing 1 clears the bit."; };
        };

        field {
            name = "pktdrpsts";
            desc = "Packet drop status interrupt";
            sw = rw;
            hw = w;
            onwrite = woclr;
            encode = DIEPINT_pktdrpsts_enum;
            reset = 0x0;
        } pktdrpsts[11:11];

        enum DIEPINT_bnaintr_enum {
            INTERRUPT_CLEARED = 0 { name = "Interrupt Cleared"; desc = "An interrupt is cleared."; };
            INTERRUPT_GENERATED_WRITING = 1 { name = "Interrupt Generated Writing"; desc = "An interrupt is generated. Writing 1 clears the bit."; };
        };

        field {
            name = "bnaintr";
            desc = "BNA interrupt. An interrupt is generated when descriptor access is not ready.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            encode = DIEPINT_bnaintr_enum;
            reset = 0x0;
        } bnaintr[9:9];

        enum DIEPINT_txfifoundrn_enum {
            INTERRUPT_CLEARED = 0 { name = "Interrupt Cleared"; desc = "An interrupt is cleared."; };
            INTERRUPT_GENERATED_WRITING = 1 { name = "Interrupt Generated Writing"; desc = "An interrupt is generated. Writing 1 clears the bit."; };
        };

        field {
            name = "txfifoundrn";
            desc = "FIFO underrun interrupt. An interrupt is generated when the FIFO underrun conditions are detected. Valid when OTG_EN_DED_TX_FIFO is 1 and thresholding is enabled.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            encode = DIEPINT_txfifoundrn_enum;
            reset = 0x0;
        } txfifoundrn[8:8];

        enum DIEPINT_txfemp_enum {
            INTERRUPT_CLEARED = 0 { name = "Interrupt Cleared"; desc = "An interrupt is cleared."; };
            INTERRUPT_GENERATED = 1 { name = "Interrupt Generated"; desc = "An interrupt is generated."; };
        };

        field {
            name = "txfemp";
            desc = "TX FIFO empty status interrupt. An interrupt is generated when the TX FIFO is empty or half empty.";
            sw = r;
            hw = w;
            encode = DIEPINT_txfemp_enum;
            reset = 0x0;
        } txfemp[7:7];

        enum DIEPINT_inepnakeff_enum {
            INTERRUPT_CLEARED = 0 { name = "Interrupt Cleared"; desc = "An interrupt is cleared."; };
            INTERRUPT_GENERATED_WRITING = 1 { name = "Interrupt Generated Writing"; desc = "An interrupt is generated. Writing 1 clears the bit."; };
        };

        field {
            name = "inepnakeff";
            desc = "IN endpoint NAK effective interrupt. An interrupt is generated when the IN endpoint NAK bit is set.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            encode = DIEPINT_inepnakeff_enum;
            reset = 0x0;
        } inepnakeff[6:6];

        enum DIEPINT_intknepmis_enum {
            INTERRUPT_CLEARED = 0 { name = "Interrupt Cleared"; desc = "An interrupt is cleared."; };
            INTERRUPT_GENERATED_WRITING = 1 { name = "Interrupt Generated Writing"; desc = "An interrupt is generated. Writing 1 clears the bit."; };
        };

        field {
            name = "intknepmis";
            desc = "IN token received with EP mismatch interrupt. An interrupt is generated when IN tokens with mismatched EP are received.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            encode = DIEPINT_intknepmis_enum;
            reset = 0x0;
        } intknepmis[5:5];

        enum DIEPINT_intktxfemp_enum {
            INTERRUPT_CLEARED = 0 { name = "Interrupt Cleared"; desc = "An interrupt is cleared."; };
            INTERRUPT_GENERATED_WRITING = 1 { name = "Interrupt Generated Writing"; desc = "An interrupt is generated. Writing 1 clears the bit."; };
        };

        field {
            name = "intktxfemp";
            desc = "IN token received when TX FIFO empty interrupt. An interrupt is generated if IN tokens are received when the corresponding TX FIFO is empty.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            encode = DIEPINT_intktxfemp_enum;
            reset = 0x0;
        } intktxfemp[4:4];

        enum DIEPINT_timeout_enum {
            INTERRUPT_CLEARED = 0 { name = "Interrupt Cleared"; desc = "An interrupt is cleared."; };
            INTERRUPT_GENERATED_WRITING = 1 { name = "Interrupt Generated Writing"; desc = "An interrupt is generated. Writing 1 clears the bit."; };
        };

        field {
            name = "timeout";
            desc = "Timeout interrupt. An interrupt is generated when timeout conditions are detected.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            encode = DIEPINT_timeout_enum;
            reset = 0x0;
        } timeout[3:3];

        enum DIEPINT_ahberr_enum {
            INTERRUPT_CLEARED = 0 { name = "Interrupt Cleared"; desc = "An interrupt is cleared."; };
            INTERRUPT_GENERATED_WRITING = 1 { name = "Interrupt Generated Writing"; desc = "An interrupt is generated. Writing 1 clears the bit."; };
        };

        field {
            name = "ahberr";
            desc = "AHB error interrupt. An interrupt is generated when an AHB error occurs during AHB read/write operations in internal DMA mode.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            encode = DIEPINT_ahberr_enum;
            reset = 0x0;
        } ahberr[2:2];

        enum DIEPINT_epdisbld_enum {
            INTERRUPT_CLEARED = 0 { name = "Interrupt Cleared"; desc = "An interrupt is cleared."; };
            INTERRUPT_GENERATED_WRITING = 1 { name = "Interrupt Generated Writing"; desc = "An interrupt is generated. Writing 1 clears the bit."; };
        };

        field {
            name = "epdisbld";
            desc = "Endpoint disabled interrupt";
            sw = rw;
            hw = w;
            onwrite = woclr;
            encode = DIEPINT_epdisbld_enum;
            reset = 0x0;
        } epdisbld[1:1];

        enum DIEPINT_xfercompl_enum {
            INTERRUPT_CLEARED = 0 { name = "Interrupt Cleared"; desc = "An interrupt is cleared."; };
            INTERRUPT_GENERATED_WRITING = 1 { name = "Interrupt Generated Writing"; desc = "An interrupt is generated. Writing 1 clears the bit."; };
        };

        field {
            name = "xfercompl";
            desc = "Transfer completion interrupt";
            sw = rw;
            hw = w;
            onwrite = woclr;
            encode = DIEPINT_xfercompl_enum;
            reset = 0x0;
        } xfercompl[0:0];
    } DIEPINT @ 0x8;

    reg {
        name = "Transfer size register for device IN endpoint 0";
        desc = "DIEPTSIZ0 is a transfer size register for device IN endpoint 0.

Data sheet 12.7.5.2 DIEPTSIZ0 (offset 0x910, printed page 12-239, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 90398).";

        field {
            name = "pktcnt";
            desc = "Number of packets";
            sw = rw;
            hw = r;
            reset = 0x0;
        } pktcnt[20:19];

        field {
            name = "xfersize";
            desc = "Transferred data size";
            sw = rw;
            hw = r;
            reset = 0x0;
        } xfersize[6:0];
    } DIEPTSIZ @ 0x10;

    reg {
        name = "DMA address register for device IN endpoint n";
        desc = "DIEPDMAN is a DMA address register for device IN endpoint n.

Data sheet 12.7.5.2 DIEPDMAN (offset 0x914, printed page 12-242, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 90576).";

        field {
            name = "dmaaddr";
            desc = "DMA address";
            sw = rw;
            hw = r;
            reset = 0x0;
        } dmaaddr[31:0];
    } DIEPDMA @ 0x14;

    reg {
        name = "Device IN endpoint TX FIFO status register";
        desc = "DTXFSTSn is a TX FIFO status register for device IN endpoints.

Data sheet offset error: the summary lists a single register at 0x0938 (= IN endpoint 1 in this layout) without an array; every IN endpoint has this register at +0x18 of its register set (0x918 + 0x20 x n, as in the DWC_otg databook).

Data sheet 12.7.5.2 DTXFSTSn (offset 0x938, printed page 12-243, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 90665).";

        enum DTXFSTS_ineptxfspcavail_enum {
            ENDPOINT_TX_FIFO = 0x0 { name = "Endpoint Tx Fifo"; desc = "The endpoint TX FIFO is full."; };
            ONE_WORD_AVAILABLE = 0x1 { name = "One Word Available"; desc = "One word is available."; };
            TWO_WORDS_AVAILABLE = 0x2 { name = "Two Words Available"; desc = "Two words are available. 0xn: n words (0 <= n <= 32768) are available."; };
            V_32768_WORDS_AVAILABLE = 0x8000 { name = "V 32768 Words Available"; desc = "32768 words are available. Other values: reserved"; };
        };

        field {
            name = "ineptxfspcavail";
            desc = "Available space for the IN endpoint TX FIFO";
            sw = r;
            hw = w;
            encode = DTXFSTS_ineptxfspcavail_enum;
            reset = 0x0;
        } ineptxfspcavail[15:0];
    } DTXFSTS @ 0x18;

    reg {
        name = "DMA buffer address register for device IN endpoint n";
        desc = "DIEPDMABN is a DMA buffer address register for device IN endpoint n.

Data sheet 12.7.5.2 DIEPDMABN (offset 0x91C, printed page 12-242, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 90618).";

        field {
            name = "dmabufferaddr";
            desc = "DMA buffer address";
            sw = r;
            hw = w;
            reset = 0x0;
        } dmabufferaddr[31:0];
    } DIEPDMAB @ 0x1C;
};

regfile eHISI_USB_DEVICE_INEP {
    name = "USB device IN endpoint n registers";
    desc = "Per-endpoint device register set (offsets relative to the start of the set; endpoint n is at 0x900 + 0x20 x n). Used for n = 1..15.";

    reg {
        name = "Control register for device control IN endpoint 0";
        desc = "DIEPCTLN is a control register for device IN endpoint n.

Endpoint n = 1..15 (endpoint 0 is the separate IN_EP0 register set).

Data sheet 12.7.5.2 DIEPCTLN (offset 0x900, printed page 12-228, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 89794).";

        field {
            name = "epena";
            desc = "Endpoint enable When the scatter or gather DMA is enabled: 0: The descriptor structure and the data TX function of the data buffer are disabled. 1: The descriptor structure and the data TX function of the data buffer are disabled. When the scatter/gather DMA is disabled: 0: The data on endpoints is not ready. 1: The data on endpoints is ready.";
            sw = rw;
            hw = w;
            reset = 0x0;
        } epena[31:31];

        enum DIEPCTL_epdis_enum {
            ENABLED = 0 { name = "Enabled"; desc = "enabled"; };
            DISABLED = 1 { name = "Disabled"; desc = "disabled"; };
        };

        field {
            name = "epdis";
            desc = "Endpoint disable This bit applies to the IN and OUT endpoints. The application program can set this bit to 1 to stop the data transmission/reception of an IN/OUT endpoint.";
            sw = rw;
            hw = w;
            encode = DIEPCTL_epdis_enum;
            reset = 0x0;
        } epdis[30:30];

        field {
            name = "setd1pid_setoddfr";
            desc = "DATA1 PID/odd micro-frame configuration The data PID of the interrupt endpoint and bulk IN/OUT endpoint can be set to DATA1 by setting this bit to 1. 0: invalid 1: valid For the real-time IN/OUT endpoint, the odd and even micro-frames can be set to odd micro-frames by setting this bit to 1. 0: invalid 1: valid";
            sw = w;
            hw = r;
            reset = 0x0;
        } setd1pid_setoddfr[29:29];

        field {
            name = "setd0pid_setevenfr";
            desc = "DATA0 PID/even micro-frame configuration The data PID of the interrupt endpoint and bulk IN/OUT endpoint can be set to DATA0 by setting this bit to 1. 0: invalid 1: valid For the real-time IN/OUT endpoint, the odd and even micro-frames can be set to even micro-frames by setting this bit to 1. 0: invalid 1: valid";
            sw = w;
            hw = r;
            reset = 0x0;
        } setd0pid_setevenfr[28:28];

        enum DIEPCTL_snak_enum {
            INVALID = 0 { name = "Invalid"; desc = "invalid"; };
            VALID = 1 { name = "Valid"; desc = "valid"; };
        };

        field {
            name = "snak";
            desc = "NAK configuration Writing to this bit sets the NAK bit of the endpoint to 1. The application program can use this bit to control the NAK handshake of an endpoint during a transfer. For an OUT endpoint, this bit is set after the controller core receives the transfer completion interrupt or the OUT endpoint receives the setup packet.";
            sw = w;
            hw = r;
            encode = DIEPCTL_snak_enum;
            reset = 0x0;
        } snak[27:27];

        enum DIEPCTL_cnak_enum {
            INVALID = 0 { name = "Invalid"; desc = "invalid"; };
            VALID = 1 { name = "Valid"; desc = "valid"; };
        };

        field {
            name = "cnak";
            desc = "NAK clear Writing to this bit clears the NAK bit of an IN/OUT endpoint.";
            sw = w;
            hw = r;
            encode = DIEPCTL_cnak_enum;
            reset = 0x0;
        } cnak[26:26];

        field {
            name = "txfnum";
            desc = "Number of TX FIFOs Shared FIFO operation: 0: non-periodic TX FIFO Other values: specified periodic TX FIFO number Dedicated FIFO operation: Number of FIFOs This field is valid only for IN endpoints.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } txfnum[25:22];

        field {
            name = "stall";
            desc = "Stall handshake (RW) This bit applies to the non-control transfer and non-real-time transfer IN and OUT endpoints. If this bit is set to 1, the application program blocks the token packets transmitted from the USB host controller to the endpoint. 0: invalid 1: valid For the control endpoint (RWSC), this bit is set to 1 by the application program and cleared by the controller core only when the endpoint receives the setup token. 0: invalid 1: valid";
            sw = rw;
            hw = r;
            reset = 0x0;
        } stall[21:21];

        enum DIEPCTL_snp_enum {
            INVALID = 0 { name = "Invalid"; desc = "invalid"; };
            VALID = 1 { name = "Valid"; desc = "valid"; };
        };

        field {
            name = "snp";
            desc = "Snooping mode This bit is used to set the OUT endpoints to the snooping mode. In snooping mode, the controller core does not check whether the OUT packet is correct before sending the packet to the application memory.";
            sw = rw;
            hw = r;
            encode = DIEPCTL_snp_enum;
            reset = 0x0;
        } snp[20:20];

        enum DIEPCTL_eptype_enum {
            CONTROL_TRANSFER_ENDPOINT = 0 { name = "Control Transfer Endpoint"; desc = "control transfer endpoint"; };
            REAL_TIME_TRANSFER = 1 { name = "Real Time Transfer"; desc = "real-time transfer endpoint"; };
            BULK_TRANSFER_ENDPOINT = 2 { name = "Bulk Transfer Endpoint"; desc = "bulk transfer endpoint"; };
            INTERRUPT_TRANSFER_ENDPOINT = 3 { name = "Interrupt Transfer Endpoint"; desc = "interrupt transfer endpoint"; };
        };

        field {
            name = "eptype";
            desc = "Endpoint type";
            sw = rw;
            hw = r;
            encode = DIEPCTL_eptype_enum;
            reset = 0x0;
        } eptype[19:18];

        enum DIEPCTL_naksts_enum {
            NON_NAK_HANDSHAKE = 0 { name = "Non Nak Handshake"; desc = "non-NAK handshake TX"; };
            NAK_HANDSHAKE_TX = 1 { name = "Nak Handshake Tx"; desc = "NAK handshake TX"; };
        };

        field {
            name = "naksts";
            desc = "NAK status";
            sw = r;
            hw = w;
            encode = DIEPCTL_naksts_enum;
            reset = 0x0;
        } naksts[17:17];

        field {
            name = "dpid_eo_frnum";
            desc = "Endpoint data PID 0: DATA0 1: DATA1 Even/Odd frame Non-scatter/Gather DMA mode: 0: even frame 1: odd frame Scatter/Gather DMA mode: Reserved";
            sw = r;
            hw = w;
            reset = 0x0;
        } dpid_eo_frnum[16:16];

        enum DIEPCTL_usbactep_enum {
            INVALID = 0 { name = "Invalid"; desc = "invalid"; };
            VALID = 1 { name = "Valid"; desc = "valid"; };
        };

        field {
            name = "usbactep";
            desc = "USB activation endpoint 0 This bit is always 1, indicating that control endpoint 0 is always valid.";
            sw = rw;
            hw = w;
            encode = DIEPCTL_usbactep_enum;
            reset = 0x0;
        } usbactep[15:15];

        field {
            name = "nextep";
            desc = "Next endpoint This field specifies the ID of the next endpoint that receives data.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } nextep[14:11];

        field {
            name = "mps";
            desc = "Maximum packet size";
            sw = rw;
            hw = r;
            reset = 0x0;
        } mps[10:0];
    } DIEPCTL @ 0x0;

    reg {
        name = "Device IN endpoint interrupt register";
