regfile eHISI_USB_DEVICE_OUTEP {
    name = "USB device OUT endpoint n registers";
    desc = "Per-endpoint device register set (offsets relative to the start of the set; endpoint n is at 0xB00 + 0x20 x n). Used for n = 1..15.";

    reg {
        name = "Control register for device control OUT endpoint 0";
        desc = "DOEPCTLN is a control register for device OUT endpoint n.

Endpoint n = 1..15 (endpoint 0 is the separate OUT_EP0 register set).

Data sheet 12.7.5.2 DOEPCTLN (offset 0xB00, printed page 12-231, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 89958).";

        field {
            name = "epena";
            desc = "Endpoint enable When the scatter or gather DMA is enabled: 0: The descriptor structure and the data RX function of the data buffer are disabled. 1: The descriptor structure and the data RX function of the data buffer are enabled. When the scatter/gather DMA is disabled: 0: The function of receiving data from the USB module to the memory is disabled. 1: The function of receiving data from the USB module to the memory is enabled.";
            sw = rw;
            hw = w;
            reset = 0x0;
        } epena[31:31];

        enum DOEPCTL_epdis_enum {
            ENABLED = 0 { name = "Enabled"; desc = "enabled"; };
            DISABLED = 1 { name = "Disabled"; desc = "disabled"; };
        };

        field {
            name = "epdis";
            desc = "Endpoint disable This bit applies to the IN and OUT endpoints. The application program can set this bit to 1 to stop the data transmission/reception of an IN/OUT endpoint.";
            sw = rw;
            hw = w;
            encode = DOEPCTL_epdis_enum;
            reset = 0x0;
        } epdis[30:30];

        field {
            name = "setd1pid_setoddfr";
            desc = "DATA1 PID/odd micro-frame configuration The data PID of the interrupt endpoint and bulk IN/OUT endpoint can be set to DATA1 by setting this bit to 1. 0: invalid 1: valid For the real-time IN/OUT endpoint, the odd and even micro-frames can be set to odd micro-frames by setting this bit to 1. 0: invalid 1: valid";
            sw = w;
            hw = r;
            reset = 0x0;
        } setd1pid_setoddfr[29:29];

        field {
            name = "setd0pid_setevenfr";
            desc = "DATA0 PID/even micro-frame configuration The data PID of the interrupt endpoint and bulk IN/OUT endpoint can be set to DATA0 by setting this bit to 1. 0: invalid 1: valid For the real-time IN/OUT endpoint, the odd and even micro-frames can be set to even micro-frames by setting this bit to 1. 0: invalid 1: valid";
            sw = w;
            hw = r;
            reset = 0x0;
        } setd0pid_setevenfr[28:28];

        enum DOEPCTL_snak_enum {
            INVALID = 0 { name = "Invalid"; desc = "invalid"; };
            VALID = 1 { name = "Valid"; desc = "valid"; };
        };

        field {
            name = "snak";
            desc = "NAK configuration Writing to this bit sets the NAK bit of the endpoint to 1. The application program can use this bit to control the NAK handshake of an endpoint during a transfer. For an OUT endpoint, this bit is set after the controller core receives the transfer completion interrupt or the OUT endpoint receives the setup packet.";
            sw = w;
            hw = r;
            encode = DOEPCTL_snak_enum;
            reset = 0x0;
        } snak[27:27];

        enum DOEPCTL_cnak_enum {
            INVALID = 0 { name = "Invalid"; desc = "invalid"; };
            VALID = 1 { name = "Valid"; desc = "valid"; };
        };

        field {
            name = "cnak";
            desc = "NAK clear Writing to this bit clears the NAK bit of an IN/OUT endpoint.";
            sw = w;
            hw = r;
            encode = DOEPCTL_cnak_enum;
            reset = 0x0;
        } cnak[26:26];

        field {
            name = "txfnum";
            desc = "Number of TX FIFOs Shared FIFO operation: 0: non-periodic TX FIFO Other values: specified periodic TX FIFO.number Dedicated FIFO operation: Number of FIFOs This field is valid only for IN endpoints.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } txfnum[25:22];

        field {
            name = "stall";
            desc = "Stall handshake (RW) Endpoint control (RWSC)";
            sw = rw;
            hw = r;
            reset = 0x0;
        } stall[21:21];

        enum DOEPCTL_snp_enum {
            INVALID = 0 { name = "Invalid"; desc = "invalid"; };
            VALID = 1 { name = "Valid"; desc = "valid"; };
        };

        field {
            name = "snp";
            desc = "Snooping mode This bit is used to set the OUT endpoint to the snooping mode. In snooping mode, the controller core does not check whether the OUT packet is correct before sending the packet to the application memory.";
            sw = rw;
            hw = r;
            encode = DOEPCTL_snp_enum;
            reset = 0x0;
        } snp[20:20];

        enum DOEPCTL_eptype_enum {
            CONTROL_TRANSFER_ENDPOINT = 0 { name = "Control Transfer Endpoint"; desc = "control transfer endpoint"; };
            REAL_TIME_TRANSFER = 1 { name = "Real Time Transfer"; desc = "real-time transfer endpoint"; };
            BULK_TRANSFER_ENDPOINT = 2 { name = "Bulk Transfer Endpoint"; desc = "bulk transfer endpoint"; };
            INTERRUPT_TRANSFER_ENDPOINT = 3 { name = "Interrupt Transfer Endpoint"; desc = "interrupt transfer endpoint"; };
        };

        field {
            name = "eptype";
            desc = "Endpoint type";
            sw = rw;
            hw = r;
            encode = DOEPCTL_eptype_enum;
            reset = 0x0;
        } eptype[19:18];

        enum DOEPCTL_naksts_enum {
            NON_NAK_HANDSHAKE = 0 { name = "Non Nak Handshake"; desc = "non-NAK handshake TX"; };
            NAK_HANDSHAKE_TX = 1 { name = "Nak Handshake Tx"; desc = "NAK handshake TX"; };
        };

        field {
            name = "naksts";
            desc = "NAK status";
            sw = r;
            hw = w;
            encode = DOEPCTL_naksts_enum;
            reset = 0x0;
        } naksts[17:17];

        field {
            name = "dpid_eo_frnum";
            desc = "Endpoint data PID 0: DATA0 1: DATA1 Even/Odd frame Non-scatter/Gather DMA mode: 0: even frame 1: odd frame Scatter/Gather DMA mode: Reserved";
            sw = r;
            hw = w;
            reset = 0x0;
        } dpid_eo_frnum[16:16];

        enum DOEPCTL_usbactep_enum {
            INVALID = 0 { name = "Invalid"; desc = "invalid"; };
            VALID = 1 { name = "Valid"; desc = "valid"; };
        };

        field {
            name = "usbactep";
            desc = "USB activation endpoint This bit applies to the IN and OUT endpoints and indicates whether an endpoint is valid.";
            sw = rw;
            hw = w;
            encode = DOEPCTL_usbactep_enum;
            reset = 0x0;
        } usbactep[15:15];

        field {
            name = "nextep";
            desc = "Next endpoint This field specifies the ID of the next endpoint that receives data.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } nextep[14:11];

        field {
            name = "mps";
            desc = "Maximum packet size";
            sw = rw;
            hw = r;
            reset = 0x0;
        } mps[10:0];
    } DOEPCTL @ 0x0;

    reg {
        name = "Device OUT endpoint interrupt register";
        desc = "DOEPINT is an interrupt register for device OUT endpoint n.

The data sheet prints one field table for both registers whose field names are partly garbled (`An`, `endpoints`, `TimeOUT_SetUp`) and merges the IN and OUT bit descriptions; the bit layout here follows the standard DWC_otg 2.x/3.x register map (which the data sheet's DIEPMSK/DOEPMSK registers confirm), the descriptions use the data sheet text. Bits are set by hardware and cleared by writing 1.

Data sheet 12.7.5.2 DOEPINTn (printed page 12-236, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 90253).";

        enum DOEPINT_stuppktrcvd_enum {
            INTERRUPT_CLEARED = 0 { name = "Interrupt Cleared"; desc = "An interrupt is cleared."; };
            INTERRUPT_GENERATED_WRITING = 1 { name = "Interrupt Generated Writing"; desc = "An interrupt is generated. Writing 1 clears the bit."; };
        };

        field {
            name = "stuppktrcvd";
            desc = "Setup packet received. Whether setup packets are received.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            encode = DOEPINT_stuppktrcvd_enum;
            reset = 0x0;
        } stuppktrcvd[15:15];

        enum DOEPINT_nyetintrpt_enum {
            INTERRUPT_CLEARED = 0 { name = "Interrupt Cleared"; desc = "An interrupt is cleared."; };
            INTERRUPT_GENERATED_WRITING = 1 { name = "Interrupt Generated Writing"; desc = "An interrupt is generated. Writing 1 clears the bit."; };
        };

        field {
            name = "nyetintrpt";
            desc = "NYET interrupt. NYET response TX interrupt.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            encode = DOEPINT_nyetintrpt_enum;
            reset = 0x0;
        } nyetintrpt[14:14];

        enum DOEPINT_nakintrpt_enum {
            INTERRUPT_CLEARED = 0 { name = "Interrupt Cleared"; desc = "An interrupt is cleared."; };
            INTERRUPT_GENERATED_WRITING = 1 { name = "Interrupt Generated Writing"; desc = "An interrupt is generated. Writing 1 clears the bit."; };
        };

        field {
            name = "nakintrpt";
            desc = "NAK interrupt. NAK TX interrupt.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            encode = DOEPINT_nakintrpt_enum;
            reset = 0x0;
        } nakintrpt[13:13];

        enum DOEPINT_bbleerr_enum {
            INTERRUPT_CLEARED = 0 { name = "Interrupt Cleared"; desc = "An interrupt is cleared."; };
            INTERRUPT_GENERATED_WRITING = 1 { name = "Interrupt Generated Writing"; desc = "An interrupt is generated. Writing 1 clears the bit."; };
        };

        field {
            name = "bbleerr";
            desc = "Babble error interrupt. Endpoint received babble interrupt.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            encode = DOEPINT_bbleerr_enum;
            reset = 0x0;
        } bbleerr[12:12];

        enum DOEPINT_pktdrpsts_enum {
            INTERRUPT_CLEARED = 0 { name = "Interrupt Cleared"; desc = "An interrupt is cleared."; };
            INTERRUPT_GENERATED_WRITING = 1 { name = "Interrupt Generated Writing"; desc = "An interrupt is generated. Writing 1 clears the bit."; };
        };

        field {
            name = "pktdrpsts";
            desc = "Packet drop status interrupt";
            sw = rw;
            hw = w;
            onwrite = woclr;
            encode = DOEPINT_pktdrpsts_enum;
            reset = 0x0;
        } pktdrpsts[11:11];

        enum DOEPINT_bnaintr_enum {
            INTERRUPT_CLEARED = 0 { name = "Interrupt Cleared"; desc = "An interrupt is cleared."; };
            INTERRUPT_GENERATED_WRITING = 1 { name = "Interrupt Generated Writing"; desc = "An interrupt is generated. Writing 1 clears the bit."; };
        };

        field {
            name = "bnaintr";
            desc = "BNA interrupt. An interrupt is generated when descriptor access is not ready.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            encode = DOEPINT_bnaintr_enum;
            reset = 0x0;
        } bnaintr[9:9];

        enum DOEPINT_outpkterr_enum {
            INTERRUPT_CLEARED = 0 { name = "Interrupt Cleared"; desc = "An interrupt is cleared."; };
            INTERRUPT_GENERATED_WRITING = 1 { name = "Interrupt Generated Writing"; desc = "An interrupt is generated. Writing 1 clears the bit."; };
        };

        field {
            name = "outpkterr";
            desc = "OUT packet error interrupt. An interrupt is generated when an overrun or CRC error is detected. Valid when OTG_EN_DED_TX_FIFO is 1 and thresholding is enabled.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            encode = DOEPINT_outpkterr_enum;
            reset = 0x0;
        } outpkterr[8:8];

        enum DOEPINT_back2backsetup_enum {
            INTERRUPT_CLEARED = 0 { name = "Interrupt Cleared"; desc = "An interrupt is cleared."; };
            INTERRUPT_GENERATED_WRITING = 1 { name = "Interrupt Generated Writing"; desc = "An interrupt is generated. Writing 1 clears the bit."; };
        };

        field {
            name = "back2backsetup";
            desc = "Back-to-back setup packets received interrupt. An interrupt is generated when the core receives more than three back-to-back setup packets.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            encode = DOEPINT_back2backsetup_enum;
            reset = 0x0;
        } back2backsetup[6:6];

        enum DOEPINT_stsphsercvd_enum {
            INTERRUPT_CLEARED = 0 { name = "Interrupt Cleared"; desc = "An interrupt is cleared."; };
            INTERRUPT_GENERATED_WRITING = 1 { name = "Interrupt Generated Writing"; desc = "An interrupt is generated. Writing 1 clears the bit."; };
        };

        field {
            name = "stsphsercvd";
            desc = "Status phase received interrupt (control write)";
            sw = rw;
            hw = w;
            onwrite = woclr;
            encode = DOEPINT_stsphsercvd_enum;
            reset = 0x0;
        } stsphsercvd[5:5];

        enum DOEPINT_outtknepdis_enum {
            INTERRUPT_CLEARED = 0 { name = "Interrupt Cleared"; desc = "An interrupt is cleared."; };
            INTERRUPT_GENERATED_WRITING = 1 { name = "Interrupt Generated Writing"; desc = "An interrupt is generated. Writing 1 clears the bit."; };
        };

        field {
            name = "outtknepdis";
            desc = "OUT token received when endpoint disabled interrupt. An interrupt is generated if OUT tokens are received when endpoints are disabled.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            encode = DOEPINT_outtknepdis_enum;
            reset = 0x0;
        } outtknepdis[4:4];

        enum DOEPINT_setup_enum {
            INTERRUPT_CLEARED = 0 { name = "Interrupt Cleared"; desc = "An interrupt is cleared."; };
            INTERRUPT_GENERATED_WRITING = 1 { name = "Interrupt Generated Writing"; desc = "An interrupt is generated. Writing 1 clears the bit."; };
        };

        field {
            name = "setup";
            desc = "Setup phase done interrupt";
            sw = rw;
            hw = w;
            onwrite = woclr;
            encode = DOEPINT_setup_enum;
            reset = 0x0;
        } setup[3:3];

        enum DOEPINT_ahberr_enum {
            INTERRUPT_CLEARED = 0 { name = "Interrupt Cleared"; desc = "An interrupt is cleared."; };
            INTERRUPT_GENERATED_WRITING = 1 { name = "Interrupt Generated Writing"; desc = "An interrupt is generated. Writing 1 clears the bit."; };
        };

        field {
            name = "ahberr";
            desc = "AHB error interrupt. An interrupt is generated when an AHB error occurs during AHB read/write operations in internal DMA mode.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            encode = DOEPINT_ahberr_enum;
            reset = 0x0;
        } ahberr[2:2];

        enum DOEPINT_epdisbld_enum {
            INTERRUPT_CLEARED = 0 { name = "Interrupt Cleared"; desc = "An interrupt is cleared."; };
            INTERRUPT_GENERATED_WRITING = 1 { name = "Interrupt Generated Writing"; desc = "An interrupt is generated. Writing 1 clears the bit."; };
        };

        field {
            name = "epdisbld";
            desc = "Endpoint disabled interrupt";
            sw = rw;
            hw = w;
            onwrite = woclr;
            encode = DOEPINT_epdisbld_enum;
            reset = 0x0;
        } epdisbld[1:1];

        enum DOEPINT_xfercompl_enum {
            INTERRUPT_CLEARED = 0 { name = "Interrupt Cleared"; desc = "An interrupt is cleared."; };
            INTERRUPT_GENERATED_WRITING = 1 { name = "Interrupt Generated Writing"; desc = "An interrupt is generated. Writing 1 clears the bit."; };
        };

        field {
            name = "xfercompl";
            desc = "Transfer completion interrupt";
            sw = rw;
            hw = w;
            onwrite = woclr;
            encode = DOEPINT_xfercompl_enum;
            reset = 0x0;
        } xfercompl[0:0];
    } DOEPINT @ 0x8;

    reg {
        name = "Transfer size register for device OUT endpoint 0";
        desc = "DOEPTSIZn is a transfer size register for device OUT endpoint n.

Data sheet 12.7.5.2 DOEPTSIZn (offset 0xB10, printed page 12-241, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 90519).";

        field {
            name = "mc_rxdpid_supcnt";
            desc = "Number of packets (IN endpoint, RW) 00: 0 packet 01: 1 packet 10: 2 packets 11: 3 packets Number of packets (non-periodic IN endpoints, RO) This field is valid only in internal DMA mode. PID of the received data (isochronous OUT endpoints, RO) 00: DATA0 01: DATA2 10: DATA1 11: MDATA Number of setup packets (OUT endpoint, RW) 01: 1 packet 10: 2 packets 11: 3 packets";
            sw = rw;
            hw = r;
            reset = 0x0;
        } mc_rxdpid_supcnt[30:29];

        field {
            name = "pktcnt";
            desc = "Number of packets";
            sw = rw;
            hw = r;
            reset = 0x0;
        } pktcnt[28:19];

        field {
            name = "xfersize";
            desc = "Transferred data size";
            sw = rw;
            hw = r;
            reset = 0x0;
        } xfersize[18:0];
