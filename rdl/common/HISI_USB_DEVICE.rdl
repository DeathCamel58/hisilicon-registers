    reg {
        name = "AHB configuration register";
        desc = "GAHBCFG is an AHB configuration register.

Linux `dwc2` sets glblintrmsk (bit 0), hbstlen (burst type, 5 = INCR4 is typical) and dmaen (bit 5) for DMA operation.

Data sheet 12.7.5.2 GAHBCFG (offset 0x8, printed page 12-170, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 86579).";

        enum GAHBCFG_invdescendianness_enum {
            DESCRIPTOR_BYTE_SEQUENCE = 0 { name = "Descriptor Byte Sequence"; desc = "The descriptor byte sequence is similar to the AHB master byte sequence."; };
            WHEN_AHB_MASTER = 1 { name = "When Ahb Master"; desc = "When the AHB master byte sequence is big endian, the descriptor byte sequence is little endian. When the AHB master byte sequence is little endian, the descriptor byte sequence is big endian."; };
        };

        field {
            name = "invdescendianness";
            desc = "Descriptor byte invert";
            sw = rw;
            hw = r;
            encode = GAHBCFG_invdescendianness_enum;
            reset = 0x0;
        } invdescendianness[24:24];

        enum GAHBCFG_ahbsingle_enum {
            REMAINING_DATA_TRANSMITTED = 0 { name = "Remaining Data Transmitted"; desc = "The remaining data is transmitted based on the INCR burst size."; };
            REMAINING_DATA_TRANSMITTED_2 = 1 { name = "Remaining Data Transmitted 2"; desc = "The remaining data is transmitted based on the single burst size."; };
        };

        field {
            name = "ahbsingle";
            desc = "Transfer in DMA mode";
            sw = rw;
            hw = r;
            encode = GAHBCFG_ahbsingle_enum;
            reset = 0x0;
        } ahbsingle[23:23];

        field {
            name = "notialldmawrit";
            desc = "DMA write operation notification. This bit is valid only when GAHBCFG[remmemsupp] is 1.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } notialldmawrit[22:22];

        enum GAHBCFG_remmemsupp_enum {
            INT_DMA_REQ = 0 { name = "Int Dma Req"; desc = "int_dma_req and int_dma_done are not set to 1, and the controller core handles the XferComp interrupt immediately after the DMA write operation is complete."; };
            INT_DMA_REQ_2 = 1 { name = "Int Dma Req 2"; desc = "int_dma_req is set to 1 when the HSOTG DMA starts writing data to an external memory; int_dma_done is set to 1 when the transfer of the controller core is complete, indicating that the HSOTG write operation is complete. In this case, the controller core waits until the system sys_dma_done signal becomes valid, and then starts the next DMA transfer."; };
        };

        field {
            name = "remmemsupp";
            desc = "Remote memory support";
            sw = rw;
            hw = r;
            encode = GAHBCFG_remmemsupp_enum;
            reset = 0x0;
        } remmemsupp[21:21];

