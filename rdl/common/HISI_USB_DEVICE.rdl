            desc = "AHB error interrupt. An interrupt is generated when an AHB error occurs during AHB read/write operations in internal DMA mode.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            encode = DOEPINT_ahberr_enum;
            reset = 0x0;
        } ahberr[2:2];

        enum DOEPINT_epdisbld_enum {
            INTERRUPT_CLEARED = 0 { name = "Interrupt Cleared"; desc = "An interrupt is cleared."; };
            INTERRUPT_GENERATED_WRITING = 1 { name = "Interrupt Generated Writing"; desc = "An interrupt is generated. Writing 1 clears the bit."; };
        };

        field {
            name = "epdisbld";
            desc = "Endpoint disabled interrupt";
            sw = rw;
            hw = w;
            onwrite = woclr;
            encode = DOEPINT_epdisbld_enum;
            reset = 0x0;
        } epdisbld[1:1];

        enum DOEPINT_xfercompl_enum {
            INTERRUPT_CLEARED = 0 { name = "Interrupt Cleared"; desc = "An interrupt is cleared."; };
            INTERRUPT_GENERATED_WRITING = 1 { name = "Interrupt Generated Writing"; desc = "An interrupt is generated. Writing 1 clears the bit."; };
        };

        field {
            name = "xfercompl";
            desc = "Transfer completion interrupt";
            sw = rw;
            hw = w;
            onwrite = woclr;
            encode = DOEPINT_xfercompl_enum;
            reset = 0x0;
        } xfercompl[0:0];
    } DOEPINT @ 0x8;

    reg {
        name = "Transfer size register for device OUT endpoint 0";
        desc = "DOEPTSIZ0 is a transfer size register for device OUT endpoint 0.

Data sheet 12.7.5.2 DOEPTSIZ0 (offset 0xB10, printed page 12-239, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 90422).";

        enum DOEPTSIZ_supcnt_enum {
            V_0_PACKET = 0 { name = "V 0 Packet"; desc = "0 packet"; };
            V_1_PACKET = 1 { name = "V 1 Packet"; desc = "1 packet"; };
            V_2_PACKETS = 2 { name = "V 2 Packets"; desc = "2 packets"; };
            V_3_PACKETS = 3 { name = "V 3 Packets"; desc = "3 packets"; };
        };

        field {
            name = "supcnt";
            desc = "Number of setup packets";
            sw = rw;
            hw = r;
