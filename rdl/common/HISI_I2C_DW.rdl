            hw = rw;
            onwrite = woclr;
            reset = 0x0;
        } mode2_clr_int_rx[3:3];

        field {
            name = "mode2_clr_int_ack_err";
            desc = "Slave ACK error interrupt flag clear.";
            sw = rw;
            hw = rw;
            onwrite = woclr;
            reset = 0x0;
        } mode2_clr_int_ack_err[2:2];

        field {
            name = "mode2_clr_int_arb_loss";
            desc = "Bus arbitration failure interrupt flag clear.";
            sw = rw;
            hw = rw;
            onwrite = woclr;
            reset = 0x0;
        } mode2_clr_int_arb_loss[1:1];

        field {
            name = "mode2_clr_int_done";
            desc = "Bus transfer completion interrupt flag clear.";
            sw = rw;
            hw = rw;
            onwrite = woclr;
            reset = 0x0;
        } mode2_clr_int_done[0:0];
    } MODE2_I2C_ICR @ 0x808;

    reg {
        name = "I2C status register (non-standard timing mode)";
        desc = "MODE2_I2C_SR is the I2C status register in non-standard timing mode. Bit [1] indicates an I2C bus arbitration failure.

Data sheet 12.1.5 MODE2_I2C_SR (offset 0x80C, Hi3516A V200 printed page 12-37, `hi3516av200--Hi3516AV200-Datasheet.txt` line 91926).";

        enum MODE2_int_enum {
            NO_INTERRUPT = 0 { desc = "No interrupt is generated."; };
            INTERRUPT    = 1 { desc = "An interrupt is generated."; };
        };

        enum MODE2_busy_enum {
            IDLE = 0 { desc = "idle"; };
            BUSY = 1 { desc = "busy"; };
        };

        field {
            name = "mode2_bus_busy";
            desc = "I2C bus status.";
            sw = r;
            hw = w;
            encode = MODE2_busy_enum;
            reset = 0x0;
        } mode2_bus_busy[7:7];

        field {
            name = "mode2_int_start";
            desc = "Master start bit TX completion interrupt flag.";
            sw = r;
            hw = w;
            encode = MODE2_int_enum;
            reset = 0x0;
        } mode2_int_start[6:6];

        field {
            name = "mode2_int_stop";
            desc = "Master stop bit TX completion interrupt flag.";
            sw = r;
            hw = w;
            encode = MODE2_int_enum;
            reset = 0x0;
        } mode2_int_stop[5:5];

        field {
            name = "mode2_int_tx";
            desc = "Master TX interrupt flag.";
            sw = r;
            hw = w;
            encode = MODE2_int_enum;
            reset = 0x0;
        } mode2_int_tx[4:4];

        field {
            name = "mode2_int_rx";
            desc = "Master RX interrupt flag (MODE2_I2C_RXR is valid when this bit is 1).";
            sw = r;
            hw = w;
            encode = MODE2_int_enum;
            reset = 0x0;
        } mode2_int_rx[3:3];

        field {
            name = "mode2_int_ack_err";
            desc = "Slave ACK error interrupt flag.";
            sw = r;
            hw = w;
            encode = MODE2_int_enum;
            reset = 0x0;
        } mode2_int_ack_err[2:2];

        field {
            name = "mode2_int_arb_loss";
            desc = "Bus arbitration failure interrupt flag.";
            sw = r;
            hw = w;
            encode = MODE2_int_enum;
            reset = 0x0;
        } mode2_int_arb_loss[1:1];

        field {
            name = "mode2_int_done";
            desc = "Bus transfer completion interrupt flag.";
            sw = r;
            hw = w;
            encode = MODE2_int_enum;
            reset = 0x0;
        } mode2_int_done[0:0];
    } MODE2_I2C_SR @ 0x80C;

    reg {
        name = "I2C SCL high level cycle number register (non-standard timing mode)";
        desc = "MODE2_I2C_SCL_H configures the number of SCL high-level cycles in non-standard timing mode. During or before system initialization, set MODE2_I2C_CTRL bit[7] to 0.

Data sheet 12.1.5 MODE2_I2C_SCL_H (offset 0x810, Hi3516A V200 printed page 12-38, `hi3516av200--Hi3516AV200-Datasheet.txt` line 91999).";

        field {
            name = "mode2_scl_h";
            desc = "SCL high level time in non-standard timing mode, in units of the I2C working reference clock (FI2C = 49.5 MHz): TH = (1/FI2C) x (m + 1) x 2 for a configured value m.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } mode2_scl_h[15:0];
    } MODE2_I2C_SCL_H @ 0x810;

    reg {
        name = "I2C SCL low level cycle number register (non-standard timing mode)";
        desc = "MODE2_I2C_SCL_L configures the number of SCL low-level cycles in non-standard timing mode.

Data sheet 12.1.5 MODE2_I2C_SCL_L (offset 0x814, Hi3516A V200 printed page 12-39, `hi3516av200--Hi3516AV200-Datasheet.txt` line 92045).";

        field {
            name = "mode2_scl_l";
            desc = "SCL low level time in non-standard timing mode, in units of the I2C working reference clock (FI2C = 49.5 MHz): TL = (1/FI2C) x (n + 1) x 2 for a configured value n.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } mode2_scl_l[15:0];
    } MODE2_I2C_SCL_L @ 0x814;

    reg {
        name = "I2C TX register (non-standard timing mode)";
        desc = "MODE2_I2C_TXR holds the data to be transmitted in non-standard timing mode. After the transmission is complete the I2C does not modify its content.

Data sheet 12.1.5 MODE2_I2C_TXR (offset 0x818, Hi3516A V200 printed page 12-40, `hi3516av200--Hi3516AV200-Datasheet.txt` line 92080).";

        field {
            name = "mode2_i2c_txr";
            desc = "Data to be transmitted by the master in non-standard timing mode.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } mode2_i2c_txr[7:0];
    } MODE2_I2C_TXR @ 0x818;

    reg {
        name = "I2C RX register (non-standard timing mode)";
        desc = "MODE2_I2C_RXR stores the data received by the master from the slave in non-standard timing mode. It is valid when MODE2_I2C_SR bit[3] is 1 and is retained until the next read operation starts.

Data sheet 12.1.5 MODE2_I2C_RXR (offset 0x81C, Hi3516A V200 printed page 12-40, `hi3516av200--Hi3516AV200-Datasheet.txt` line 92117).";

        field {
            name = "mode2_i2c_rxr";
            desc = "Data received by the master in non-standard timing mode.";
            sw = r;
            hw = w;
            reset = 0x0;
        } mode2_i2c_rxr[7:0];
    } MODE2_I2C_RXR @ 0x81C;
`endif

