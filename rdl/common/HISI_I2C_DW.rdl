            sw = rw;
            hw = r;
            encode = MODE2_mask_enum;
            reset = 0x0;
        } mode2_int_start_mask[6:6];

        field {
            name = "mode2_int_stop_mask";
            desc = "Master stop condition TX completion interrupt mask in non-standard timing mode.";
            sw = rw;
            hw = r;
            encode = MODE2_mask_enum;
            reset = 0x0;
        } mode2_int_stop_mask[5:5];

        field {
