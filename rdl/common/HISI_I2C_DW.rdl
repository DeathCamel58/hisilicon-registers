`ifdef I2C_DW_MODE2
    /* Non-standard timing mode (MODE2) registers, Hi3516A V200 / Hi3519 V101 data sheet 12.1.5 (offsets 0x800..0x81C): the old HiSilicon APB I2C
       (`eHISI_I2C`, Hi3520D 14.1) register set, selected by I2C_CON[31] `i2c_mode_sel` = 1. Bit layouts, resets and descriptions are the data sheet's. */

    reg {
        name = "I2C control register (non-standard timing mode)";
        desc = "MODE2_I2C_CTRL is the I2C control register in non-standard timing mode. It enables the module and masks its interrupts.

Data sheet 12.1.5 MODE2_I2C_CTRL (offset 0x800, Hi3516A V200 printed page 12-33, `hi3516av200--Hi3516AV200-Datasheet.txt` line 91686; Hi3519 V101 `hi3519v101--Hi3519V101-Datasheet.txt` line 91635).";

        enum MODE2_enable_enum {
            DISABLED = 0 { desc = "disabled"; };
            ENABLED  = 1 { desc = "enabled"; };
        };

        enum MODE2_mask_enum {
            MASKED     = 0 { desc = "masked"; };
            NOT_MASKED = 1 { desc = "not masked"; };
        };

        field {
            name = "mode2_i2c_en";
            desc = "I2C enable in non-standard timing mode.";
            sw = rw;
            hw = r;
            encode = MODE2_enable_enum;
            reset = 0x0;
        } mode2_i2c_en[8:8];

        field {
