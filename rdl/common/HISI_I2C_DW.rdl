            sw = rw;
            hw = r;
            encode = I2C_DMA_CR_rdmae_enum;
            reset = 0x0;
        } rdmae[1:1];

        enum I2C_DMA_CR_tdmae_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
