`ifndef HISI_JPGE_AV300_RDL
`define HISI_JPGE_AV300_RDL

regfile eHISI_JPGE_AV300 {
    name = "HiSilicon JPEG encoder (JPGE), Hi3516A V300 generation (vendor-derived stubs)";
    desc = "
    VENDOR-DERIVED STUBS, CONFIDENCE LOW, NOT VERIFIED ON HARDWARE. The Hi3516A V300 data sheet (Chinese user guide) lists the JPGE window (0x11220000, 64 KB, interrupt 68, clock gate PERI_CRG44 bit 1 jpge_cken, soft reset bit 0 jpge_srst_req, clock 396 MHz) and a feature list only; it has NO register table. Every register below was found by static analysis (objdump, never executed) of the vendor kernel module open_jpege.ko from the OpenIPC Hi3516AV300 nightly firmware (Linux 4.9.37, 2026-11-10; symbols kept): functions jpege_drv_write_regs (all per-frame register writes, called from jpege_config_regs), jpege_drv_read_regs (interrupt path), jpege_drv_set_osd (OSD block) and jpege_drv_set_quant_table (quantization table). Each register is named UNK_<offset> (no name exists in the module) and described with the access seen, the bit layout the code composes and the configuration-structure offsets it is composed from; the text 'same offset is X in the older generation' is an INFERENCE from the Hi3520D-generation layout (eHISI_JPGE, confidence LOW) and no more.

    This layout is NOT the layout of eHISI_JPGE (Hi3520D, Hi3516A V100 and the other chips of that family): the offsets differ (picture configuration at 0x30 instead of 0x10, image size at 0x34 with 16 bit fields instead of 0x20 with 13 bit fields, quantization table at 0x800 as 23 bit reciprocals (0x800000 / quantizer) instead of the 48 packed words at 0x1000, extra register groups at 0x200..0x21C, 0x300.. and 0x320..0x334); the interrupt-status offsets 0x00/0x04/0x08 and the eight-region OSD concept are shared with the older generation. Probably the same JPEG core as the Hi3516C V500 / Hi3516D V300 generation (an assumption from the module name hi3516cv500_jpege in the OpenHarmony and tekuconcept SDK trees, not verified).

    NOT FOUND in this module (so NOT in this file, open): the START register, the interrupt clear register and the stream buffer address / length / write-pointer registers. The module has no ioremap of its own (the register base is handed over by the sys/venc modules; the constant 0x11220000 appears in open_venc.ko, not analyzed) and the start / acknowledge sequence probably lives in open_chnl.ko / open_venc.ko. The quantization table (UNK_0800) was analyzed only for the three 64 entry runs and one computed run; coverage of all 256 words is not confirmed. Next step if the register map is wanted: analyze open_venc.ko / open_chnl.ko (jpege start path), then a hardware read of offset 0xFC and 0x00 on the Hi3516A V300 (no such board here).
    ";

    reg {
        name = "UNK_0000";
        desc = "Read by jpege_drv_read_regs (the interrupt service path): bit 0 and bit 1 are extracted and stored as two separate flags of the channel status (bit 0 = frame finished, bit 1 = second flag, probably stream buffer full: inferred only from the Hi3520D-generation JPGE_INTSTAT bits 0/1 at the same offset, LOW). Access observed: read. Same offset is JPGE_INTSTAT (bit 0 end of picture, bit 1 stream buffer full) in the older generation (eHISI_JPGE), inferred, LOW. Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";

        field {
            name = "value";
            desc = "32 bit value, single field (bit layout, if any, is in the register description). Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";
            sw = r;
            hw = r;
        } value[31:0];
    } UNK_0000 @ 0x0;

    reg {
        name = "UNK_0004";
        desc = "Written with the value 0x3 (bit 6 explicitly cleared) at the start of every jpege_drv_write_regs call. Access observed: written. Same offset is JPGE_INTMASK in the older generation (written 3 there too), inferred, LOW. Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";

        field {
            name = "value";
            desc = "32 bit value, single field (bit layout, if any, is in the register description). Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";
            sw = w;
            hw = r;
        } value[31:0];
    } UNK_0004 @ 0x4;

    reg {
        name = "UNK_0008";
        desc = "Read by jpege_drv_read_regs (conditionally, after the first read): bit 3 and bit 2 are extracted and OR-ed into one error flag of the channel status. Access observed: read. Same offset is JPGE_RAWINT in the older generation (bit 2 time-out, bit 3 configuration error there), inferred, LOW. Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";

        field {
            name = "value";
            desc = "32 bit value, single field (bit layout, if any, is in the register description). Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";
            sw = r;
            hw = r;
        } value[31:0];
    } UNK_0008 @ 0x8;

    reg {
        name = "UNK_0024";
        desc = "Written by jpege_drv_write_regs (called per frame by jpege_config_regs): bits [7:0] = a byte from the channel configuration (offset 0x80), bit 8 = a flag (offset 0x7c). Access observed: written. Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";

        field {
            name = "value";
            desc = "32 bit value, single field (bit layout, if any, is in the register description). Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";
            sw = w;
            hw = r;
        } value[31:0];
    } UNK_0024 @ 0x24;

    reg {
        name = "UNK_0030";
        desc = "Written by jpege_drv_write_regs (called per frame by jpege_config_regs) with several fields: [1:0] = 0 or 3 (from a configuration word, offset 0xb4c), bit 2 cleared, [4:3] = 0 or 1 (input pixel format code in {25, 26, 28, 29, 40} of configuration word 4 selects the value; the same selection also sets [27:20] to 0 or 1), bit 16 cleared, bit 18 cleared, [15:8] = configuration word 0 (looks like the channel number), bit 19 = 1 when configuration word 0xb40 equals 1. Access observed: written. Corresponds by position of its role to JPGE_PICFG (0x10, older generation; channel number at [11:4] there, [15:8] here): inferred, LOW. Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";

        field {
            name = "value";
            desc = "32 bit value, single field (bit layout, if any, is in the register description). Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";
            sw = w;
            hw = r;
        } value[31:0];
    } UNK_0030 @ 0x30;

    reg {
        name = "UNK_0034";
        desc = "Written by jpege_drv_write_regs (called per frame by jpege_config_regs): [15:0] = configuration word 2 (offset 8), [31:16] = configuration word 3 (offset 12); 16 bit fields (the older generation has 13 bit fields at 0x20). Looks like picture width and height. Access observed: written. Role similar to JPGE_VEDIMGSIZE (0x20, older generation): inferred, LOW. Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";

        field {
            name = "value";
            desc = "32 bit value, single field (bit layout, if any, is in the register description). Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";
            sw = w;
            hw = r;
