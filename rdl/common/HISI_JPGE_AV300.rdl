    reg {
        name = "UNK_0800 (quantization reciprocal table, array of 256)";
        desc = "Written by jpege_drv_set_quant_table at word index 512 + n (offset 0x800 + 4n): the value written is 0x800000 divided by a quantizer byte (23 bit reciprocal, the quantizer clamped to 1..255 for the computed run); three runs of 64 entries (n = 0..63, 64..127, 128..191) are filled from three 64 byte tables of the channel structure (offsets 0x15c, 0x19c, 0x1dc) and a further run of 64 entries (n = 0..63 of a second pass, index base 512 again) is computed from a table with a rounding adjustment that depends on a quality value (below/above 79). Whether the hardware has 192 or 256 entries and which run is luma/chroma is not determined. Access observed: written. Compare JPGE_QPT (0x1000, 48 packed words, older generation): different format, inferred only that it is the quantization table. Unknown purpose beyond that, vendor-observed only, confidence LOW, not verified on hardware.";

        field {
            name = "value";
            desc = "32 bit reciprocal value. Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";
            sw = w;
