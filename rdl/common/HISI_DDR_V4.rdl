        field { name = "ma2t"; desc = "2T command mode. [PROVEN]"; sw = rw; hw = r; } ma2t[5:5];
    } DRAMCFG @ 0x2C;

    reg {
        name = "Training control 0";
        desc = "TRAINCTRL0 - Training control 0. Confidence **PROVEN**. Evidence: ddr_phy_t28.h DDR_PHY_TRAINCTRL0 = 0x48 (mask 0xF). Hardware not read; reset values unknown.";
        field { name = "trainctrl0"; desc = "Training control nibble. [PROVEN]"; sw = rw; hw = r; } trainctrl0[3:0];
    } TRAINCTRL0 @ 0x48;

    reg {
        name = "Mode registers 0/1";
        desc = "MODEREG01 - Mode registers 0/1. Confidence **PROVEN**. Evidence: ddr_phy_t28.h DDR_PHY_MODEREG01 = 0x64, MR1 at [31:16]. Hardware not read; reset values unknown.";
        field { name = "mr0"; desc = "MR0. [PROVEN]"; sw = rw; hw = r; } mr0[15:0];
        field { name = "mr1"; desc = "MR1. [PROVEN]"; sw = rw; hw = r; } mr1[31:16];
    } MODEREG01 @ 0x64;

    reg {
        name = "Mode registers 2/3";
        desc = "MODEREG23 - Mode registers 2/3. Confidence **PROVEN**. Evidence: ddr_phy_t28.h DDR_PHY_MODEREG23 = 0x68. Hardware not read; reset values unknown.";
        field { name = "mr2"; desc = "MR2. [PROVEN]"; sw = rw; hw = r; } mr2[15:0];
        field { name = "mr3"; desc = "MR3. [PROVEN]"; sw = rw; hw = r; } mr3[31:16];
    } MODEREG23 @ 0x68;

    reg {
        name = "PHY miscellaneous control";
        desc = "MISC - PHY miscellaneous control. Confidence **PROVEN**. Evidence: ddr_phy_t28.h DDR_PHY_MISC = 0x70; bit 19 = update (PHY_MISC_UPDATE_BIT 19), bit 16 = scrambling (PHY_MISC_SCRAMB_DIS = 0xFFFEFFFF). Hardware not read; reset values unknown.";
        field { name = "scramb"; desc = "Data scrambling enable. [PROVEN]"; sw = rw; hw = r; } scramb[16:16];
