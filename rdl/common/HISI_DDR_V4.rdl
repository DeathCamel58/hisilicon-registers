regfile eDDR_PHY_EV200 {
    name = "DDR PHY (T28), Hi3516E V200 (window 0x120DC000, extends to 0x120DD000)";
    desc = "DDR PHY type DDR_PHY_T28 per cijliu-uboot. Only registers named by the vendor U-Boot DDR trainer headers are listed. Confidence legend (no hardware was read for this block): PROVEN = offset and bits are used by vendor source code or by the vendor boot binary (Xiongmai stock U-Boot of a Hi3516E V200 camera) exactly as described; INFERRED = deduced from naming, from sibling chips or from a value without a bit map; GUESS = plausible only.";

    reg {
        name = "PHY initialization control";
        desc = "PHYINITCTRL - PHY initialization control. Confidence **PROVEN**. Evidence: ddr_phy_t28.h DDR_PHY_PHYINITCTRL = 0x4 with the per-step enable bits (INIT_EN, PLL_INIT_EN, DLYMEAS, ZCAL, WL, GT, GDST, WL2, RDET, WDET, DRAM_INIT, CAT, DRAM_RST, PHY_RST, PACK_RST, PHYCONN_RST bit 15, DVREFT, HVREFT, ... JTMT/CST, REFRET, PHYUPD_REQ); exact positions are given by PHY_PHYINITCTRL_* in the header, not copied here. Hardware not read; reset values unknown.";
        field { name = "init_en"; desc = "Bit 0 = INIT_EN (start of hardware initialization); other bits per the vendor header. [INFERRED]"; sw = rw; hw = r; } init_en[0:0];
        field { name = "phyconn_rst"; desc = "PHYCONN_RST (PHY_PHYCONN_RST_BIT = 15). [PROVEN]"; sw = rw; hw = r; } phyconn_rst[15:15];
    } PHYINITCTRL @ 0x4;

    reg {
        name = "PHY initialization status";
