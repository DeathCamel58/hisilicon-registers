regfile eDDR_AXI_EV200 {
    name = "DDR AXI/QoS switch (window 0x120D0000), Hi3516E V200";
    desc = "Only registers named by the vendor U-Boot DDR trainer headers are listed. Confidence legend (no hardware was read for this block): PROVEN = offset and bits are used by vendor source code or by the vendor boot binary (Xiongmai stock U-Boot of a Hi3516E V200 camera) exactly as described; INFERRED = deduced from naming, from sibling chips or from a value without a bit map; GUESS = plausible only.";

    reg {
        name = "AXI region 0 attributes (channel mode)";
        desc = "AXI_REGION_ATTRIB0 - AXI region 0 attributes (channel mode). Confidence **PROVEN**. Evidence: cijliu-uboot drivers/ddr/hisilicon/default/ddr_ddrc_v520.h DDR_AXI_REGION_ATTRIB0 (0x104), channel field [3:0] cleared by the trainer (AXI_REGION_ATTRIB_CH_MASK 0xFFFFFFF0); values 0..3 select the DMC channel start (AXI_RNG_ATTR_CH_START_n), 4 = channel mode. Hardware not read; reset values unknown.";
        field { name = "region_ch"; desc = "Channel / interleave select of address region 0. [PROVEN]"; sw = rw; hw = r; } region_ch[3:0];
    } AXI_REGION_ATTRIB0 @ 0x104;

    reg {
        name = "AXI region 1 attributes (channel mode)";
        desc = "AXI_REGION_ATTRIB1 - AXI region 1 attributes (channel mode). Confidence **PROVEN**. Evidence: ddr_ddrc_v520.h DDR_AXI_REGION_ATTRIB1 (0x114). Hardware not read; reset values unknown.";
        field { name = "region_ch"; desc = "Channel / interleave select of address region 1. [PROVEN]"; sw = rw; hw = r; } region_ch[3:0];
    } AXI_REGION_ATTRIB1 @ 0x114;

    reg {
        name = "AXI/QoS register 0x410C (vendor boot value 0xB)";
        desc = "AXI_QOS_410C - AXI/QoS register 0x410C (vendor boot value 0xB). Confidence **INFERRED**. Evidence: Written 0x0000000B by the vendor boot table and by sys_config sys_ctl(). Hardware not read; reset values unknown.";
        field { name = "v"; desc = "Unknown QoS parameter. [GUESS]"; sw = rw; hw = r; } v[31:0];
    } AXI_QOS_410C @ 0x410C;

    reg {
        name = "AXI/QoS register 0x4110 (vendor boot value 0xB)";
        desc = "AXI_QOS_4110 - AXI/QoS register 0x4110 (vendor boot value 0xB). Confidence **INFERRED**. Evidence: Same as 0x410C. Hardware not read; reset values unknown.";
        field { name = "v"; desc = "Unknown QoS parameter. [GUESS]"; sw = rw; hw = r; } v[31:0];
    } AXI_QOS_4110 @ 0x4110;

    reg {
        name = "AXI/QoS register 0x41F0 (vendor boot value 1)";
        desc = "AXI_QOS_41F0 - AXI/QoS register 0x41F0 (vendor boot value 1). Confidence **INFERRED**. Evidence: Same as 0x410C. Hardware not read; reset values unknown.";
        field { name = "v"; desc = "Unknown. [GUESS]"; sw = rw; hw = r; } v[31:0];
    } AXI_QOS_41F0 @ 0x41F0;

    reg {
        name = "AXI/QoS register 0x4300 (vendor boot value 0x80)";
        desc = "AXI_QOS_4300 - AXI/QoS register 0x4300 (vendor boot value 0x80). Confidence **INFERRED**. Evidence: Same as 0x410C. Hardware not read; reset values unknown.";
        field { name = "v"; desc = "Unknown. [GUESS]"; sw = rw; hw = r; } v[31:0];
    } AXI_QOS_4300 @ 0x4300;

};
`endif

`ifndef HI3516EV200_DDR_DMC_RDL
