regfile eDDR_DMC_EV200 {
    name = "DDR DMC (DDRC V520), Hi3516E V200 (window 0x120D8000)";
    desc = "DDRC type DDR_DDRC_V520 per cijliu-uboot ddr_training_custom.h (PHY T28, DDRT V2.0 SHF0). Only registers named by the vendor U-Boot DDR trainer headers are listed. Confidence legend (no hardware was read for this block): PROVEN = offset and bits are used by vendor source code or by the vendor boot binary (Xiongmai stock U-Boot of a Hi3516E V200 camera) exactly as described; INFERRED = deduced from naming, from sibling chips or from a value without a bit map; GUESS = plausible only.";

    reg {
        name = "Self-refresh control";
        desc = "DMC_CTRL_SREF - Self-refresh control. Confidence **PROVEN**. Evidence: ddr_ddrc_v520.h DDR_DMC_CTRL_SREF = 0x0; lowlevel_init_v300.c: write 1 = enter, 2 = exit self-refresh (DMC_CTRL_SREF_ENTER/EXIT). Hardware not read; reset values unknown.";
        field { name = "sref_enter"; desc = "1 = enter self-refresh. [PROVEN]"; sw = rw; hw = r; } sref_enter[0:0];
        field { name = "sref_exit"; desc = "1 = exit self-refresh. [PROVEN]"; sw = rw; hw = r; } sref_exit[1:1];
    } DMC_CTRL_SREF @ 0x0;

    reg {
        name = "SFC (software command) request";
        desc = "DMC_SFCREQ - SFC (software command) request. Confidence **PROVEN**. Evidence: ddr_ddrc_v520.h DDR_DMC_SFCREQ = 0xC. Hardware not read; reset values unknown.";
        field { name = "sfcreq"; desc = "Software DRAM command request/done. [PROVEN]"; sw = rw; hw = r; } sfcreq[31:0];
    } DMC_SFCREQ @ 0xC;

    reg {
        name = "Self-refresh configuration";
        desc = "DMC_CFG_SREF - Self-refresh configuration. Confidence **PROVEN**. Evidence: ddr_ddrc_v520.h DDR_DMC_CFG_SREF = 0x20. Hardware not read; reset values unknown.";
        field { name = "cfg_sref"; desc = "Auto self-refresh timing/enable. [PROVEN]"; sw = rw; hw = r; } cfg_sref[31:0];
    } DMC_CFG_SREF @ 0x20;

    reg {
        name = "Power-down configuration";
        desc = "DMC_CFG_PD - Power-down configuration. Confidence **PROVEN**. Evidence: ddr_ddrc_v520.h DDR_DMC_CFG_PD = 0x28 (DMC_POWER_DOWN_DIS = ~1: bit 0 enables power-down). Hardware not read; reset values unknown.";
        field { name = "pd_en"; desc = "Power-down enable. [PROVEN]"; sw = rw; hw = r; } pd_en[0:0];
    } DMC_CFG_PD @ 0x28;

    reg {
        name = "DDR mode";
        desc = "DMC_CFG_DDRMODE - DDR mode. Confidence **PROVEN**. Evidence: ddr_ddrc_v520.h DDR_DMC_CFG_DDRMODE = 0x50: [3:0] DRAM type (7 DDR4, 8 LPDDR4 per the common header; DDR2/DDR3 on this chip), [5:4] memory width (DMC_MEM_WIDTH_BIT 4), [11:10] bank groups (DMC_CFG_MEM_BG_BIT 10); lowlevel_init_v300.c: the channel is valid when [3:0] != 0. Hardware not read; reset values unknown.";
        field { name = "dram_type"; desc = "DRAM type code; 0 = channel not present. [PROVEN]"; sw = rw; hw = r; } dram_type[3:0];
        field { name = "mem_width"; desc = "Memory data width code. [PROVEN]"; sw = rw; hw = r; } mem_width[5:4];
        field { name = "mem_bg"; desc = "Bank-group count code. [PROVEN]"; sw = rw; hw = r; } mem_bg[11:10];
    } DMC_CFG_DDRMODE @ 0x50;

    reg {
        name = "Data scrambling configuration";
        desc = "DMC_CFG_SCRAMB - Data scrambling configuration. Confidence **PROVEN**. Evidence: ddr_ddrc_v520.h DDR_DMC_CFG_SCRAMB = 0x58: bit 14 scrambling enable (DMC_SCRAMB_DIS = 0xFFFFBFFF), low bits 3..4 configured by DMC_SCRAMB_CFG (0xFFFFFFE8 mask). Hardware not read; reset values unknown.";
        field { name = "scramb_en"; desc = "Scrambler enable. [PROVEN]"; sw = rw; hw = r; } scramb_en[14:14];
    } DMC_CFG_SCRAMB @ 0x58;

    reg {
        name = "Rank 0 volume configuration";
        desc = "DMC_CFG_RNKVOL0 - Rank 0 volume configuration. Confidence **PROVEN**. Evidence: ddr_ddrc_v520.h DDR_DMC_CFG_RNKVOL(n) = 0x60 + n x 4: [9:8] bank (DMC_RNKVOL_MEM_BANK_BIT 8), [6:4] row (bit 4), [2:0] column. Hardware not read; reset values unknown.";
        field { name = "mem_col"; desc = "Column address bits code. [PROVEN]"; sw = rw; hw = r; } mem_col[2:0];
        field { name = "mem_row"; desc = "Row address bits code. [PROVEN]"; sw = rw; hw = r; } mem_row[6:4];
        field { name = "mem_bank"; desc = "Bank count code. [PROVEN]"; sw = rw; hw = r; } mem_bank[9:8];
    } DMC_CFG_RNKVOL0 @ 0x60;

    reg {
        name = "Rank 1 volume configuration";
        desc = "DMC_CFG_RNKVOL1 - Rank 1 volume configuration. Confidence **PROVEN**. Evidence: DDR_DMC_CFG_RNKVOL(1) = 0x64, same layout as rank 0. Hardware not read; reset values unknown.";
        field { name = "mem_col"; desc = "Column address bits code. [PROVEN]"; sw = rw; hw = r; } mem_col[2:0];
        field { name = "mem_row"; desc = "Row address bits code. [PROVEN]"; sw = rw; hw = r; } mem_row[6:4];
        field { name = "mem_bank"; desc = "Bank count code. [PROVEN]"; sw = rw; hw = r; } mem_bank[9:8];
    } DMC_CFG_RNKVOL1 @ 0x64;

    reg {
        name = "Extended mode registers 0/1";
        desc = "DMC_CFG_EMRS01 - Extended mode registers 0/1. Confidence **PROVEN**. Evidence: ddr_ddrc_v520.h DDR_DMC_CFG_EMRS01 = 0xF0. Hardware not read; reset values unknown.";
        field { name = "emrs01"; desc = "MR1/MR0 image used by the DMC for initialization. [PROVEN]"; sw = rw; hw = r; } emrs01[31:0];
    } DMC_CFG_EMRS01 @ 0xF0;

    reg {
        name = "Timing register 2";
        desc = "DMC_TIMING2 - Timing register 2. Confidence **PROVEN**. Evidence: ddr_ddrc_v520.h DDR_DMC_TIMING2 = 0x108 (DMC_AUTO_TIMING_DIS = 0xFFFFF000: low 12 bits hold the auto refresh timing). Hardware not read; reset values unknown.";
        field { name = "auto_timing"; desc = "Auto-refresh timing field. [PROVEN]"; sw = rw; hw = r; } auto_timing[11:0];
    } DMC_TIMING2 @ 0x108;

    reg {
        name = "SFC command";
        desc = "DMC_SFCCMD - SFC command. Confidence **PROVEN**. Evidence: ddr_ddrc_v520.h DDR_DMC_SFCCMD = 0x210: [3:0] command type (2 LMR, 5 READ, 6 PRECHARGE_ALL), [12] MRS (DMC_SFC_CMD_MRS_BIT 12), [16] rank (DMC_SFC_RANK_BIT 16), [30] pre-disable. Hardware not read; reset values unknown.";
        field { name = "cmd"; desc = "SFC command type. [PROVEN]"; sw = rw; hw = r; } cmd[3:0];
        field { name = "mrs"; desc = "MRS value / flag field. [INFERRED]"; sw = rw; hw = r; } mrs[15:12];
        field { name = "rank"; desc = "Rank select mask. [PROVEN]"; sw = rw; hw = r; } rank[17:16];
        field { name = "pre_dis"; desc = "Precharge disable. [PROVEN]"; sw = rw; hw = r; } pre_dis[30:30];
    } DMC_SFCCMD @ 0x210;

    reg {
        name = "SFC address";
        desc = "DMC_SFCADDR - SFC address. Confidence **PROVEN**. Evidence: ddr_ddrc_v520.h DDR_DMC_SFCADDR = 0x214. Hardware not read; reset values unknown.";
        field { name = "addr"; desc = "SFC command address. [PROVEN]"; sw = rw; hw = r; } addr[31:0];
    } DMC_SFCADDR @ 0x214;

    reg {
        name = "SFC bank";
        desc = "DMC_SFCBANK - SFC bank. Confidence **PROVEN**. Evidence: ddr_ddrc_v520.h DDR_DMC_SFCBANK = 0x218. Hardware not read; reset values unknown.";
        field { name = "bank"; desc = "SFC command bank (DMC_BANK_MR1 = 1, MR3 = 3). [PROVEN]"; sw = rw; hw = r; } bank[31:0];
    } DMC_SFCBANK @ 0x218;

    reg {
        name = "Current function status";
        desc = "DMC_CURR_FUNC - Current function status. Confidence **PROVEN**. Evidence: ddr_ddrc_v520.h DDR_DMC_CURR_FUNC = 0x294; bit 0 = in self-refresh (DMC_CURR_FUNC_IN_SREF_MASK). Hardware not read; reset values unknown.";
        field { name = "in_sref"; desc = "1 = the controller is in self-refresh. [PROVEN]"; sw = rw; hw = r; } in_sref[0:0];
    } DMC_CURR_FUNC @ 0x294;

    reg {
        name = "SFC read data 0";
        desc = "DMC_SFC_RDATA0 - SFC read data 0. Confidence **PROVEN**. Evidence: ddr_ddrc_v520.h DDR_DMC_SFC_RDATA0 = 0x4A8 (RDATA0..7 at 0x4A8..0x4C4). Hardware not read; reset values unknown.";
        field { name = "rdata"; desc = "Read data of the last SFC read. [PROVEN]"; sw = rw; hw = r; } rdata[31:0];
    } DMC_SFC_RDATA0 @ 0x4A8;

};
`endif

