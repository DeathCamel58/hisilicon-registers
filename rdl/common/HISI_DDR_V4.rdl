    reg {
        name = "PHY reset control";
        desc = "PHYRSCTRL - PHY reset control. Confidence **PROVEN**. Evidence: ddr_phy_t28.h DDR_PHY_PHYRSCTRL = 0xB0. Hardware not read; reset values unknown.";
