        desc = "CORNER_DETECTOR - Process corner detector. Confidence **PROVEN**. Evidence: ddr_phy_t28.h DDR_PHY_CORNER_DETECTOR = 0x104C. The PHY window therefore spans at least 0x1000 + (spans PHY0 0x120DC000 and PHY1 0x120DD000: the vendor table also programs 0x120DD0xx/0x120DD2xx). Hardware not read; reset values unknown.";
        field { name = "v"; desc = "Corner detector status. [PROVEN]"; sw = rw; hw = r; } v[31:0];
