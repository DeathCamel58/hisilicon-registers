        field { name = "gt_err"; desc = "Gate training error. [PROVEN]"; sw = rw; hw = r; } gt_err[5:5];
        field { name = "rdet_err"; desc = "Read-eye detect error. [PROVEN]"; sw = rw; hw = r; } rdet_err[8:8];
