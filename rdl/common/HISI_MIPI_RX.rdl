            sw = rw;
            hw = r;
            encode = MIPI_USERDEF_DT_user_def1_dt_enum;
            reset = 0x0;
        } user_def1_dt[6:4];

        enum MIPI_USERDEF_DT_user_def0_dt_enum {
            V_8_BITS = 0 { name = "V 8 Bits"; desc = "8 bits"; };
            V_10_BITS = 1 { name = "V 10 Bits"; desc = "10 bits"; };
            V_12_BITS = 2 { name = "V 12 Bits"; desc = "12 bits"; };
            V_14_BITS_OTHER = 3 { name = "V 14 Bits Other"; desc = "14 bits Other values: reserved"; };
