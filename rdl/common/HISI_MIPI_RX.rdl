`ifndef HISI_MIPI_RX_RDL
`define HISI_MIPI_RX_RDL

// MIPI RX (MIPI D-PHY / LVDS / HiSPI / CMOS sensor receiver) of the Hi3518EV200 / Hi3516CV200 (data sheet 9.3).
regfile eHISI_MIPI_RX {
    name = "MIPI RX (sensor serial interface receiver)";
    desc = "
    MIPI RX of the Hi3518E V20X / Hi3516C V200 at 0x20680000 (data sheet 9.3), VIC interrupt 28: combo PHY and controller receiving 1/2/3/4-lane MIPI D-PHY (CSI-2, up to 1 Gbit/s per lane,
    RAW8/10/12/14 and user-defined data types, virtual channels), 1/2/4-lane LVDS / sub-LVDS / HiSPI (SOF/EOF/SOL/EOL or SAV/EAV sync codes, big/little endian) or a CMOS parallel 1.8 V / 3.3 V
    sensor, and feeding the VICAP as DC timing. Registers: 0x0000-0x0024 common controller (MIPI_START, memory controls, image size, LVDS mode, user data types, crop); 0x1000-0x1068 link 0
    (interrupts, lane enable/order, PHY enables and configuration, MIPI data IDs, MIPI packet error interrupts MIPI_INTR1/2, FSM timeout and parameters); 0x1080-0x10F8 per-lane LVDS sync-code
    registers (SOF/EOF/SOL/EOL, two 16-bit codes each) for lanes 0-3 of link 0. The MIPI/LVDS/CMOS input mode itself is selected in the system controller / IO configuration (data sheet 9.3.3),
    not in this block.

    Register table: data sheet 9.3.5 / 9.3.6 (`hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` lines 57289-59726), 42 registers transcribed with fields, access types (RC = cleared on read) and reset values; vendor driver `hi_mipi` of the
    Hi3518EV200 SDK is not in the local trees; no hardware verification.
    ";

    reg {
        name = "MIPI configuration enable register";
        desc = "MIPI_START is an MIPI configuration enable register.

Data sheet 9.3.6 MIPI_START (offset 0x0, printed page 9-139, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 57403).";

        enum MIPI_START_mipi_start_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLE_APB_CLOCK = 1 { name = "Enable Apb Clock"; desc = "Enable the APB clock domain configuration signal and convert it into the MIPI working clock domain output."; };
        };

        field {
            name = "mipi_start";
            desc = "Configuration enable";
            sw = rw;
            hw = r;
            encode = MIPI_START_mipi_start_enum;
            reset = 0x0;
        } mipi_start[0:0];
    } MIPI_START @ 0x0;

    reg {
        name = "MIPI controller configuration register";
        desc = "MIPI_CTRL_MODE is an MIPI controller configuration register.

Total reset value 0x222: emab = emaa = 2, ret1n = 1 (memory macro controls).

Data sheet 9.3.6 MIPI_CTRL_MODE (offset 0x4, printed page 9-139, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 57434).";

        field {
            name = "emab";
            desc = "memory emab";
            sw = rw;
            hw = r;
            reset = 0x2;
        } emab[10:8];

        field {
            name = "emaa";
            desc = "memory emaa";
            sw = rw;
            hw = r;
            reset = 0x2;
        } emaa[6:4];

        field {
            name = "ret1n";
            desc = "memory ret1n";
            sw = rw;
            hw = r;
            reset = 0x1;
        } ret1n[1:1];

        enum MIPI_CTRL_MODE_mipi_mem_ck_gt_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "mipi_mem_ck_gt";
            desc = "MIPI memory clock gating enable";
            sw = rw;
            hw = r;
            encode = MIPI_CTRL_MODE_mipi_mem_ck_gt_enum;
            reset = 0x0;
        } mipi_mem_ck_gt[0:0];
    } MIPI_CTRL_MODE @ 0x4;

    reg {
        name = "MIPI image size register";
        desc = "LVDS_IMGSIZE is an MIPI image size register.

Data sheet 9.3.6 LVDS_IMGSIZE (offset 0xC, printed page 9-140, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 57478).";

        field {
            name = "lvds_imgheight";
            desc = "Image height. The value is the actual image height minus 1, and the value range is [0, 8191].";
            sw = rw;
            hw = r;
            reset = 0x0;
        } lvds_imgheight[28:16];

        field {
            name = "lvds_imgwidth";
            desc = "Image width. The value is the actual image width minus 1, and the value range is [0, 8191].";
            sw = rw;
            hw = r;
            reset = 0x0;
        } lvds_imgwidth[12:0];
    } LVDS_IMGSIZE @ 0xC;

    reg {
        name = "LVDS operating mode configuration E register";
        desc = "LVDS_CTRL_MODE is an LVDS operating mode configuration register.

Data sheet 9.3.6 LVDS_CTRL_MODE (offset 0x14, printed page 9-141, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 57518).";

        enum LVDS_CTRL_MODE_lvds_link_seq_enum {
            SYNCHRONOUS_TRANSMISSION_MODE = 0 { name = "Synchronous Transmission Mode"; desc = "synchronous transmission mode for two links of the normal sensor"; };
            ASYNCHRONOUS_TRANSMISSION_MODE = 1 { name = "Asynchronous Transmission Mode"; desc = "asynchronous transmission mode for two links of the Panasonic sensor"; };
        };

        field {
            name = "lvds_link_seq";
            desc = "Sequence of two links in LVDS mode";
            sw = rw;
            hw = r;
            encode = LVDS_CTRL_MODE_lvds_link_seq_enum;
            reset = 0x0;
        } lvds_link_seq[12:12];

        enum LVDS_CTRL_MODE_lvds_code_big_endian_enum {
            LSB_LEAST_SIGNIFICANT = 0 { name = "Lsb Least Significant"; desc = "LSB. Least significant bits are transmitted first. The serial data sequence of the synchronization code (sync_code) received is bit 0, bit 1, …, bit 11."; };
            MSB_MOST_SIGNIFICANT = 1 { name = "Msb Most Significant"; desc = "MSB. Most significant bits are transmitted first. The serial data sequence of the synchronization code (sync_code) received is bit 11, bit 10, …, bit 0."; };
        };

        field {
            name = "lvds_code_big_endian";
            desc = "Serial bit transmission sequence for the synchronization code (sync_code) of raw data to be transmitted in LVDS or HiSPI mode";
            sw = rw;
            hw = r;
            encode = LVDS_CTRL_MODE_lvds_code_big_endian_enum;
            reset = 0x1;
        } lvds_code_big_endian[9:9];

        enum LVDS_CTRL_MODE_lvds_pix_big_endian_enum {
            LSB_LEAST_SIGNIFICANT = 0 { name = "Lsb Least Significant"; desc = "LSB. Least significant bits are transmitted first. The serial data sequence of the valid pixels received is bit 0, bit 1, …, bit 11."; };
            MSB_MOST_SIGNIFICANT = 1 { name = "Msb Most Significant"; desc = "MSB. Most significant bits are transmitted first. The serial data sequence of the valid pixels received is bit 11, bit 10, …, bit 0."; };
        };

        field {
            name = "lvds_pix_big_endian";
            desc = "Serial bit transmission sequence for the valid pixels of raw data to be transmitted in LVDS or HiSPI mode";
            sw = rw;
            hw = r;
            encode = LVDS_CTRL_MODE_lvds_pix_big_endian_enum;
            reset = 0x1;
        } lvds_pix_big_endian[8:8];

        enum LVDS_CTRL_MODE_lvds_raw_type_enum {
            V_8_BIT_RAW = 1 { name = "V 8 Bit Raw"; desc = "8-bit RAW data"; };
            V_10_BIT_RAW = 2 { name = "V 10 Bit Raw"; desc = "10-bit RAW data"; };
            V_12_BIT_RAW = 3 { name = "V 12 Bit Raw"; desc = "12-bit RAW data"; };
            V_14_BIT_RAW = 4 { name = "V 14 Bit Raw"; desc = "14-bit RAW data Other values: reserved"; };
        };

        field {
            name = "lvds_raw_type";
            desc = "Type of the RAW data to be transmitted in LVDS or HiSPI mode";
            sw = rw;
            hw = r;
            encode = LVDS_CTRL_MODE_lvds_raw_type_enum;
            reset = 0x1;
        } lvds_raw_type[6:4];

        field {
            name = "li_en";
            desc = "Sony line information detection enable 1'b0: disabled 1'b1: enabled";
            sw = rw;
            hw = r;
            reset = 0x0;
        } li_en[1:1];

        enum LVDS_CTRL_MODE_lvds_sync_mode_enum {
            SOF_EOF_SOL = 0 { name = "Sof Eof Sol"; desc = "SOF, EOF, SOL, or EOL mode"; };
            SAV_EAV_MODE = 1 { name = "Sav Eav Mode"; desc = "SAV-EAV mode SAV-EAV mode is widely applied in SONY sensor. In this mode, set InValid SAV/EAV in LINKm_LANEn_SOF_xx or LINKm_LANEn_EOF_xx, and set Valid SAV/EAV in LINKm_LANEn_SOL_xx or LINKm_LANEn_SOL_xx. Here, m is 0 or 1, and n is 0, 1, 2, or 3. In HiSPI mode, this field must be set to 0."; };
        };

        field {
            name = "lvds_sync_mode";
            desc = "Frame or line synchronization mode in LVDS mode";
            sw = rw;
            hw = r;
            encode = LVDS_CTRL_MODE_lvds_sync_mode_enum;
            reset = 0x0;
        } lvds_sync_mode[0:0];
    } LVDS_CTRL_MODE @ 0x14;

    reg {
        name = "Pixel bit width configuration register for the user-defined data type in MIPI mode";
        desc = "MIPI_USERDEF_DT is a pixel bit width configuration register for the user-defined data type in MIPI mode.

Data sheet 9.3.6 MIPI_USERDEF_DT (offset 0x18, printed page 9-142, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 57597).";

        enum MIPI_USERDEF_DT_user_def3_dt_enum {
            V_8_BITS = 0 { name = "V 8 Bits"; desc = "8 bits"; };
            V_10_BITS = 1 { name = "V 10 Bits"; desc = "10 bits"; };
            V_12_BITS = 2 { name = "V 12 Bits"; desc = "12 bits"; };
            V_14_BITS_OTHER = 3 { name = "V 14 Bits Other"; desc = "14 bits Other values: reserved"; };
        };

        field {
            name = "user_def3_dt";
            desc = "Bit width of the transferred pixel when the data type is user_def3";
            sw = rw;
            hw = r;
            encode = MIPI_USERDEF_DT_user_def3_dt_enum;
            reset = 0x0;
        } user_def3_dt[14:12];

        enum MIPI_USERDEF_DT_user_def2_dt_enum {
            V_8_BITS = 0 { name = "V 8 Bits"; desc = "8 bits"; };
            V_10_BITS = 1 { name = "V 10 Bits"; desc = "10 bits"; };
            V_12_BITS = 2 { name = "V 12 Bits"; desc = "12 bits"; };
            V_14_BITS_OTHER = 3 { name = "V 14 Bits Other"; desc = "14 bits Other values: reserved"; };
        };

        field {
