            sw = rw;
            hw = r;
            reset = 0x0;
        } start_x[12:0];
    } CROPSTART @ 0x20;

    reg {
        name = "Operating mode enable register";
        desc = "CTRL_MODE is an operating mode enable register.

Data sheet 9.3.6 CTRL_MODE (offset 0x24, printed page 9-145, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 57743).";

        enum CTRL_MODE_crop_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
