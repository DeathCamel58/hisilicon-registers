            sw = rw;
            hw = r;
            encode = MIPI_USERDEF_DT_user_def0_dt_enum;
            reset = 0x0;
        } user_def0_dt[2:0];
    } MIPI_USERDEF_DT @ 0x18;

    reg {
        name = "User-defined data type enable register in MIPI mode";
        desc = "USER_DEF is a user-defined data type enable register in MIPI mode.

Data sheet 9.3.6 USER_DEF (offset 0x1C, printed page 9-143, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 57665).";

        field {
            name = "user_def3";
            desc = "User-defined data type 3";
            sw = rw;
            hw = r;
            reset = 0x10;
        } user_def3[29:24];

        field {
            name = "user_def2";
            desc = "User-defined data type 2";
            sw = rw;
            hw = r;
            reset = 0x36;
        } user_def2[21:16];

        field {
            name = "user_def1";
            desc = "User-defined data type 1";
            sw = rw;
            hw = r;
            reset = 0x35;
        } user_def1[13:8];

        field {
            name = "user_def0";
            desc = "User-defined data type 0";
            sw = rw;
            hw = r;
            reset = 0x34;
        } user_def0[5:0];
    } USER_DEF @ 0x1C;

    reg {
        name = "CROPSTART";
        desc = "CROPSTART is the crop start position register (printed 'CROP START' in the data sheet); the crop window is enabled by CTRL_MODE.crop_en and its size is LVDS_IMGSIZE.

Data sheet 9.3.6 CROPSTART (offset 0x20, printed page 9-144, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 57704).";

