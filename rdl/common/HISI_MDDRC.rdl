regfile eHISI_MDDRC_AXI {
    name = "MDDRC AXI registers";
    desc = "AXI-side registers of the MDDRC (data sheet 4.1.5, Table 4-8, base 0x1206_0000, 18 registers): configuration lock, clock gating, AXI operating mode, eight address regions (mapping / attributes / scrambling), per-port QoS mapping and priority tables, per-port and per-group outstanding-command (OSTD) restriction and statistics, status and interrupt status. Variables (Table 4-9): regions 0-7, ports 0-7, groups 0-3.";

    reg {
        name = "Lock control register";
        desc = "AXI_CFG_LOCK is a lock control register.

Data sheet 4.1.5 AXI_CFG_LOCK (offset 0x4, printed page 4-16, `hi3516av200--Hi3516AV200-Datasheet.txt` line 19357).";

        enum AXI_CFG_LOCK_apb_cfg_lock_enum {
            UNLOCKED = 0 { name = "Unlocked"; desc = "unlocked"; };
            LOCKED = 1 { name = "Locked"; desc = "locked (None of the AXI_IF configuration registers can be accessed except this register. Therefore, the power consumption is reduced.)"; };
        };

        field {
            name = "apb_cfg_lock";
            desc = "Lock control of all the register configuration modules (AXI_IF/SEC/DMC/PUB) in the MDDRC";
            sw = rw;
            hw = r;
            encode = AXI_CFG_LOCK_apb_cfg_lock_enum;
            reset = 0x0;
        } apb_cfg_lock[0:0];
    } AXI_CFG_LOCK @ 0x4;

    reg {
        name = "Module clock gating register";
        desc = "AXI_CKG is a module clock gating register. Hi3516A V200 Professional HD IP Camera SoC

Data sheet 4.1.5 AXI_CKG (offset 0x8, printed page 4-17, `hi3516av200--Hi3516AV200-Datasheet.txt` line 19399).";

        field {
            name = "sta_ckg_dmc";
            desc = "Static clock gating for each DMC When sta_ckg_dmc[n] is 0, the clocks for the DMCn and the corresponding PHY utility block (PUB) are disabled. When sta_ckg_dmc[n] is 1, the clocks for the DMCn and the corresponding PUB are enabled. n = 1, 2, or 3: reserved";
            sw = rw;
            hw = r;
            reset = 0xF;
        } sta_ckg_dmc[19:16];

        enum AXI_CKG_dyn_ckg_rdr_enum {
            CLOCK_ALWAYS_ENABLED = 0 { name = "Clock Always Enabled"; desc = "The clock is always enabled."; };
            CLOCK_AUTOMATICALLY_DISABLED = 1 { name = "Clock Automatically Disabled"; desc = "The clock is automatically disabled when the module is idle."; };
        };

        field {
            name = "dyn_ckg_rdr";
            desc = "Dynamic clock gating for the reorder module";
            sw = rw;
            hw = r;
            encode = AXI_CKG_dyn_ckg_rdr_enum;
            reset = 0x1;
        } dyn_ckg_rdr[12:12];

        field {
            name = "dyn_ckg_axi";
            desc = "Dynamic clock gating for each AXI port When dyn_ckg_axi[n] is 0, the clock for AXI port n is always enabled. When dyn_ckg_axi[n] is 1, the clock is automatically disabled when modules in AXI port n are idle.";
            sw = rw;
            hw = r;
            reset = 0xFFF;
        } dyn_ckg_axi[11:0];
    } AXI_CKG @ 0x8;

    reg {
        name = "AXI operating mode register";
        desc = "AXI_ACTION is an AXI operating mode register. Hi3516A V200 Professional HD IP Camera SoC

Data sheet 4.1.5 AXI_ACTION (offset 0x20, printed page 4-18, `hi3516av200--Hi3516AV200-Datasheet.txt` line 19451).";

        field {
            name = "wr_rcv_mode";
            desc = "Anti-deadlock mode enable When wr_rcv_mode[n] is 0, the anti-deadlock mode for port n is disabled. When wr_rcv_mode[n] is 1, the anti-deadlock mode for port n is enabled.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } wr_rcv_mode[19:8];

        enum AXI_ACTION_rd_wrap_split_en_enum {
            NO_SPLIT_ADDRESS = 0 { name = "No Split Address"; desc = "no split. The address is wrapped by the DMC."; };
            SPLIT = 1 { name = "Split"; desc = "split"; };
        };

