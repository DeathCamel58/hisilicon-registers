Data sheet 4.1.7 DDRC_CFG_TIMING0 (offset 0x100, printed page 4-96, `hi3516av200--Hi3516AV200-Datasheet.txt` line 24035).";

        field {
            name = "tmrd";
            desc = "Number of wait cycles for the load mode register (LMR) command. The value is tMRD for the DDR3 and DDR4. 0x0-0x1: 1 clock cycle 0x2-0xF: n clock cycles";
            sw = rw;
            hw = r;
            reset = 0xF;
        } tmrd[31:28];

        field {
            name = "trrd";
            desc = "Number of wait cycles from ACT bank A to ACT bank B 0x0-0x1: 1 clock cycle 0x2-0xF: n clock cycles";
            sw = rw;
            hw = r;
            reset = 0xF;
        } trrd[27:24];

        field {
            name = "trp";
            desc = "Number of wait cycles for the disable command (PRE period) 0x0-0x1: 1 clock cycle 0x2-0xF: n clock cycles";
            sw = rw;
            hw = r;
            reset = 0x1F;
        } trp[23:19];

        field {
            name = "trcd";
            desc = "Number of wait cycles from the ACT bank command to the read or write command 0x0-0x3: 3 clock cycles 0x4-0xF: n clock cycles";
            sw = rw;
            hw = r;
            reset = 0x1F;
        } trcd[18:14];

        field {
            name = "trc";
            desc = "Number of wait cycles from an ACT bank command to the next ACT bank command 0x00-0x01: 1 clock cycle 0x02-0x3F: n clock cycles";
            sw = rw;
            hw = r;
            reset = 0x3F;
        } trc[13:8];

        field {
            name = "tras";
            desc = "Number of wait cycles from the ACT bank command to the. Other values: reserved. disable command (PRE) 0x0-0x1: 1 clock cycle 0x2-0xF: n clock cycles";
