            hw = r;
            reset = 0x3F;
        } tras[5:0];
    } DDRC_CFG_TIMING0 @ 0x100;

    reg {
        name = "DDRC timing parameter register 1";
        desc = "DDRC_CFG_TIMING1 is DDRC timing parameter register 1.

Data sheet 4.1.7 DDRC_CFG_TIMING1 (offset 0x84, printed page 4-97, `hi3516av200--Hi3516AV200-Datasheet.txt` line 24090).";

        field {
            name = "tsre";
            desc = "Number of wait cycles from the self-refresh exit command to the read command 0x0: reserved 0x01-0xFF: (n x 4) clock cycles This field is set to the larger value between tXSDLL and tXS for the DDR3/DDR4 SDRAM.";
            sw = rw;
            hw = r;
            reset = 0xFF;
        } tsre[31:24];

        field {
            name = "trtw";
            desc = "Delay from the last read data command to the first write data command 0x0-0x1: 1 clock cycle 0x2-0xF: (n + 1) clock cycles";
            sw = rw;
            hw = r;
            reset = 0x2;
        } trtw[23:20];

        field {
            name = "twl";
            desc = "Number of wait cycles from the write command to the write data command 0x0-0x1: 1 clock cycle 0x2-0xF: n clock cycles For example, 0x3 indicates three clock cycles.";
            sw = rw;
            hw = r;
            reset = 0x4;
        } twl[19:15];

        field {
            name = "tcl";
            desc = "Column address strobe (CAS) latency from the read command to the read data operation 0x0-0x1: 1 clock cycle 0x2-0xF: n clock cycles";
            sw = rw;
            hw = r;
            reset = 0x5;
        } tcl[14:10];

        field {
            name = "trfc";
            desc = "Number of wait cycles for the AREF period or AREF to the ACT command. The field value is set to the maximum value of max{trfc, tzqcs}. 0x00: reserved 0x01-0x1FF: n clock cycles";
            sw = rw;
            hw = r;
            reset = 0x1FF;
        } trfc[8:0];
    } DDRC_CFG_TIMING1 @ 0x84;

    reg {
        name = "DDRC timing parameter register 2";
        desc = "DDRC_CFG_TIMING2 is DDRC timing parameter register 2. Hi3516A V200 Professional HD IP Camera SoC

Data sheet 4.1.7 DDRC_CFG_TIMING2 (offset 0x108, printed page 4-99, `hi3516av200--Hi3516AV200-Datasheet.txt` line 24172).";

        field {
            name = "tcke";
            desc = "Minimum cycle of retaining the self-refresh mode 0x0: reserved 0x1-0xF: n clock cycles The field value must be the maximum value among tCKESR, tCKSRE, tCKSRX, and tCKE.";
            sw = rw;
            hw = r;
            reset = 0xF;
        } tcke[31:28];

        field {
            name = "twtr";
            desc = "Number of wait cycles for the last write data to the write-to-read command 0x0-0x1: 1 clock cycle 0x2-0xF: n clock cycles For example, 0x3 indicates three clock cycles.";
            sw = rw;
            hw = r;
            reset = 0x3;
        } twtr[27:24];

        field {
            name = "tfaw";
            desc = "Number of clock cycles for four consecutive activation commands 0x00-0x3F: n clock cycles For example, 0x14 indicates 20 clock cycles.";
            sw = rw;
            hw = r;
            reset = 0x3F;
        } tfaw[17:12];

        field {
            name = "taref";
            desc = "Number of auto-refresh cycles 0x000: forbidden 0x001-0x7FF: The auto-refresh cycle of the SDRAM is (16 x n) clock cycles. For example, 0x008 indicates 128 (16 x 8) clock cycles. The interval tREFI is 7800/16/tclk. Tclk is twice the running cycle of the DDR.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } taref[10:0];
    } DDRC_CFG_TIMING2 @ 0x108;

    reg {
        name = "DDRC timing parameter register 3";
        desc = "DDRC_CFG_TIMING3 is DDRC timing parameter register 3. Hi3516A V200 Professional HD IP Camera SoC

Data sheet 4.1.7 DDRC_CFG_TIMING3 (offset 0x10C, printed page 4-100, `hi3516av200--Hi3516AV200-Datasheet.txt` line 24225).";

        field {
            name = "tzq_prd";
            desc = "Number of ZQCS command cycles 0x000: The ZQCS command is forbidden. 0x001-0x3FF: (n x 128) AREF cycles The number of ZQCS command cycles is equal to (n x 128) taref clock cycles.";
            sw = rw;
            hw = r;
            reset = 0x3FF;
        } tzq_prd[31:22];

        field {
            name = "tzqinit";
            desc = "Number of ZQ initialization delay cycles 0x0-0x1FF: (n x 4) clock cycles The value needs to be set to the larger value between tZQINIT and tDLLK.";
            sw = rw;
            hw = r;
            reset = 0x1FF;
        } tzqinit[21:13];

        field {
            name = "taond";
            desc = "Number of ODT enable/disable cycles In DDR3/DDR4 mode, this value is set to tWL - 2 (tWL is DDRC_CFG_TIMING1[twl]). In LPDDR3 mode, this value is set to tODTon (max)/tCK.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } taond[12:8];

        field {
            name = "txard";
            desc = "Number of wait cycles of exiting the DDR low-power mode 0x0-0xF: n clock cycles (in decimal) For example, 0x7 indicates seven clock cycles. The field value is the maximum value among tXP, tXARD, tXARDS, and tXS. In DDR3/DDR4 mode, the field value is the larger value between tXP and tCKE.";
            sw = rw;
            hw = r;
            reset = 0xF;
        } txard[7:4];

        field {
            name = "trtp";
            desc = "Wait delay from the read command to the disable command 0x0-0x2: 2 clock cycles 0x3-0xF: n clock cycles Trtp is calculated as follows: Trtp = AL + BL/2 + Max (trtp, 2) - 2";
            sw = rw;
            hw = r;
            reset = 0x2;
        } trtp[3:0];
    } DDRC_CFG_TIMING3 @ 0x10C;

    reg {
        name = "DDRC timing parameter register 4";
        desc = "DDRC_CFG_TIMING4 is DDRC timing parameter register 4. Hi3516A V200 Professional HD IP Camera SoC

