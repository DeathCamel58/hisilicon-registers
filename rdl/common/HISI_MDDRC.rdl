                V_1_GB_THIS = 6 { name = "V 1 Gb This"; desc = "1 GB. In this case, rgn_base_addr/ ch _offset[5:0] must be set to 0."; };
                V_2_GB_THIS = 7 { name = "V 2 Gb This"; desc = "2 GB. In this case, rgn_base_addr/ ch _offset[6:0] must be set to 0."; };
            };

            field {
                name = "rgn_size";
                desc = "Size of the current address area";
                sw = rw;
                hw = r;
