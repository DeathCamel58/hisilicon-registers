    reg {
        name = "QoSBuf accumulated write command count register";
        desc = "QOSB_WR_CMD_SUM is a QoSBuf accumulated write command count register. Hi3516A V200 Professional HD IP Camera SoC

Data sheet 4.1.6 QOSB_WR_CMD_SUM (offset 0x1E4, printed page 4-71, `hi3516av200--Hi3516AV200-Datasheet.txt` line 22588).";

        field {
