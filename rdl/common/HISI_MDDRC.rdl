        name = "DDRC timing parameter register 5";
        desc = "DDRC_CFG_TIMING5 is DDRC timing parameter register 5.

Data sheet 4.1.7 DDRC_CFG_TIMING5 (offset 0x114, printed page 4-101, `hi3516av200--Hi3516AV200-Datasheet.txt` line 24309).";

        field {
            name = "twodt_ext";
            desc = "This parameter is valid only for LPDDR3. The LPDDR3 is an asynchronous ODT, and therefore the ODT signal needs to be broadened. The broadened length is calculated as follows: [tODTon/off (max) - tODTon/off (min)]/tCK.";
            sw = rw;
            hw = r;
            reset = 0x1;
        } twodt_ext[30:28];

        field {
            name = "tdqsckmax";
            desc = "Maximum output access time of DQS relative to CK. This parameter is valid only for LPDDR3. This parameter is automatically attached to parameters for all other read commands in LPDDR3 mode.";
            sw = rw;
            hw = r;
            reset = 0x1;
        } tdqsckmax[26:24];

        field {
            name = "tdqsck";
            desc = "Output access time of DQS relative to CK. This parameter is valid only for LPDDR3. This value is used to calculate the read latency and is automatically attached to RL in LPDDR3 mode. This field can be ignored and retains the default value in DDR3/DDR4 mode.";
            sw = rw;
            hw = r;
            reset = 0x1;
        } tdqsck[22:20];

        field {
            name = "reserved_nz_19_16";
            desc = "Reserved in the bit table, but the data sheet total reset value of this register has these bits set (reset 0x3).";
            sw = r;
            hw = w;
            reset = 0x3;
        } reserved_nz_19_16[19:16];

        field {
            name = "tzqcs";
            desc = "ZQCS calibration delay cycle 0x0-0xFF: (n x 2) clock cycles The field value must be greater than or equal to 10 because of the DMC design.";
            sw = rw;
            hw = r;
            reset = 0xFF;
        } tzqcs[15:8];

        field {
            name = "twr";
            desc = "Number of wait cycles of write recovery 0x0-0x1: one clock cycle 0x2-0x1F: n clock cycles";
