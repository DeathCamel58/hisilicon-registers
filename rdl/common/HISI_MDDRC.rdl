        } qos_rd_cmd_sum[31:0];
    } QOSB_RD_CMD_SUM @ 0x1E8;

    reg {
        name = "QoSBuf timeout mode selection register";
        desc = "QOSB_TIMEOUT_MODE is a QoSBuf timeout mode selection register. Hi3516A V200 Professional HD IP Camera SoC

Data sheet 4.1.6 QOSB_TIMEOUT_MODE (offset 0x1F0, printed page 4-72, `hi3516av200--Hi3516AV200-Datasheet.txt` line 22638).";

        enum QOSB_TIMEOUT_MODE_timeout_mode_enum {
            TIMEOUT_MODE_MAPPED = 0 { name = "Timeout Mode Mapped"; desc = "The timeout mode is mapped by using the ID and there are 16 levels of timeout periods. For details about the definition of each level, see QOSB_WRTOUT0 to QOSB_WRTOUT3 or QOSB_RDTOUT0 to QOSB_RDTOUT3."; };
            TIMEOUT_MODE_MAPPED_2 = 1 { name = "Timeout Mode Mapped 2"; desc = "The timeout mode is mapped by using the priority and there are eight levels of timeout periods. The levels in the priority mapping table are the same as the lower eight levels in the ID mapping table."; };
        };

        field {
            name = "timeout_mode";
            desc = "Read/Write command timeout mapping mode select";
            sw = rw;
            hw = r;
            encode = QOSB_TIMEOUT_MODE_timeout_mode_enum;
            reset = 0x0;
        } timeout_mode[0:0];
    } QOSB_TIMEOUT_MODE @ 0x1F0;

    reg {
        name = "QoSBuf write buffer priority adjustment control register";
        desc = "QOSB_WBUF_PRI_CTRL is a QoSBuf write buffer priority adjustment control register.

Data sheet 4.1.6 QOSB_WBUF_PRI_CTRL (offset 0x1F4, printed page 4-72, `hi3516av200--Hi3516AV200-Datasheet.txt` line 22673).";

        field {
            name = "wbuf_hcnt";
            desc = "The value of this field is used by the internal counter only when the number of write commands reaches the value of QOSB_WBUF_CTRL[wbuf_lvl2] (write buffer threshold 2). When the number reaches wbuf_lvl2, the internal counter starts counting. The priorities of the write commands in the write buffer are increased to pri2 until the count value reaches wbuf_hcnt. Note: pri2 indicates the priority of the write buffer threshold 2. For details, see QOSB_WBUF_CTRL[wbuf_pri2].";
            sw = rw;
            hw = r;
            reset = 0x20;
        } wbuf_hcnt[31:16];

        field {
            name = "wbuf_lcnt";
            desc = "The value of this field is used by the internal counter only when the number of write commands reaches the value of QOSB_WBUF_CTRL[wbuf_lvl2] (write buffer threshold 2) and the count value has already reached wbuf_hcnt. When the count value reaches wbuf_hcnt, the internal counter starts counting again. The priorities of the write commands are increased to pril1 until the count value reaches wbuf_lcnt. If the count value is 0, the priorities of the write commands are always pri2. Note: pri1 indicates the priority of the write buffer threshold 1. For details, see QOSB_WBUF_CTRL[wbuf_pri1].";
            sw = rw;
            hw = r;
            reset = 0x0;
        } wbuf_lcnt[15:0];
    } QOSB_WBUF_PRI_CTRL @ 0x1F4;

    reg {
        name = "QoSBuf row-hit priority adjustment control register";
        desc = "QOSB_RHIT_CTRL is a QoSBuf row-hit priority adjustment control register.

Data sheet 4.1.6 QOSB_RHIT_CTRL (offset 0x1F8, printed page 4-73, `hi3516av200--Hi3516AV200-Datasheet.txt` line 22719).";

        field {
            name = "rhit_hcnt";
            desc = "Time allowed to maintain the row-hit command stream Note: The row-hit command stream is forcibly disconnected when the time for maintaining the row-hit command stream reaches rhit_hcnt. Then the internal counter starts counting again, and the row-hit command stream is allowed to raise the arbitration request until the count value reaches rhit_lcnt.";
            sw = rw;
            hw = r;
            reset = 0xFF;
        } rhit_hcnt[31:16];

        field {
            name = "rhit_lcnt";
            desc = "Duration that the row-hit command stream is disconnected Note: The row-hit command stream is forcibly disconnected when the time for maintaining the row-hit command stream reaches rhit_hcnt. Then the internal counter starts counting again, and the row-hit command stream is allowed to raise the arbitration request until the count value reaches rhit_lcnt.";
            sw = rw;
            hw = r;
            reset = 0xF;
        } rhit_lcnt[15:0];
    } QOSB_RHIT_CTRL @ 0x1F8;

};

regfile eHISI_MDDRC_DMC {
    name = "MDDRC DMC registers";
    desc = "DMC (DDR memory controller) registers of the MDDRC (data sheet 4.1.7, Table 4-12, DMC0 base 0x1206_8000, 73 registers): self-refresh / SFC / performance control, SDRAM configuration (self-refresh, initialisation, power-down, auto-refresh, work mode, DDR mode, scrambling, rank volume, ODT, EMRS01..67, TIMING0-7), bulk data, DMC level, DDR PHY interface, software-configuration (SFC) command interface, data / command statistics thresholds, interrupts, current status and history (flux / latency / command) counters, SFC read data. The rnks variable is 0 only (one rank). Compared with eHISI_DDRC_V2 the registers were renumbered (CFG_TIMING1 at 0x84 but TIMING0/2-7 at 0x100-0x11C, EMRS at 0xF0-0xFC, CFG_ODT at 0xA0) and CFG_INIT / CFG_WORKMODE2 / CFG_SCRAMB / STADAT-CMDMAX / STAT_RPT / HIS_DAT_SUM / CURR_FUNC2 added.";

    reg {
        name = "DDR self-refresh control register";
        desc = "DDRC_CTRL_SREF is a DDR self-refresh control register.

Data sheet 4.1.7 DDRC_CTRL_SREF (offset 0x0, printed page 4-78, `hi3516av200--Hi3516AV200-Datasheet.txt` line 22986).";

        enum DDRC_CTRL_SREF_sref_done_enum {
            NORMAL_OPERATING_MODE = 0 { name = "Normal Operating Mode"; desc = "normal operating mode"; };
            TRANSITION_FROM_0 = 1 { name = "Transition From 0"; desc = "The transition from 0 to 1 indicates that the DDR PHY completes all required operations after exiting the self-refresh status and the DMC can accept new requests."; };
        };

        field {
            name = "sref_done";
            desc = "DDR PHY self-refresh done";
            sw = rw;
            hw = r;
            encode = DDRC_CTRL_SREF_sref_done_enum;
            reset = 0x0;
        } sref_done[1:1];

        enum DDRC_CTRL_SREF_sref_req_enum {
            EXIT_SELF_REFRESH = 0 { name = "Exit Self Refresh"; desc = "exit the self-refresh status"; };
            ENTER_SELF_REFRESH = 1 { name = "Enter Self Refresh"; desc = "enter the self-refresh status"; };
        };

        field {
            name = "sref_req";
            desc = "SDRAM self-refresh request";
            sw = rw;
            hw = r;
            encode = DDRC_CTRL_SREF_sref_req_enum;
            reset = 0x1;
        } sref_req[0:0];
    } DDRC_CTRL_SREF @ 0x0;

    reg {
        name = "DDRC software configuration command start register";
        desc = "DDRC_CTRL_SFC is a DDRC software configuration command start register.

Data sheet 4.1.7 DDRC_CTRL_SFC (offset 0xC, printed page 4-79, `hi3516av200--Hi3516AV200-Datasheet.txt` line 23024).";

        enum DDRC_CTRL_SFC_cmd_req_enum {
            COMMAND_NOT_EXECUTED = 0 { name = "Command Not Executed"; desc = "The command is not executed or the parameter is automatically cleared after the command is executed."; };
            COMMAND_REQUESTED_EXECUTED = 1 { name = "Command Requested Executed"; desc = "The command is requested to be executed."; };
        };

        field {
            name = "cmd_req";
            desc = "Request of executing the configuration command of the DDRC";
            sw = rw;
            hw = r;
            encode = DDRC_CTRL_SFC_cmd_req_enum;
            reset = 0x0;
        } cmd_req[0:0];
    } DDRC_CTRL_SFC @ 0xC;

    reg {
        name = "DDRC performance statistics enable register";
        desc = "DDRC_CTRL_PERF is a DDRC performance statistics enable register.

Data sheet 4.1.7 DDRC_CTRL_PERF (offset 0x10, printed page 4-79, `hi3516av200--Hi3516AV200-Datasheet.txt` line 23053).";

        field {
            name = "reserved_nz_31_1";
            desc = "Reserved in the bit table, but the data sheet total reset value of this register has these bits set (reset 0xA7800).";
            sw = r;
            hw = w;
            reset = 0x000A7800;
        } reserved_nz_31_1[31:1];

        enum DDRC_CTRL_PERF_perf_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "perf_en";
            desc = "Performance statistics mode";
            sw = rw;
            hw = r;
            encode = DDRC_CTRL_PERF_perf_en_enum;
            reset = 0x0;
        } perf_en[0:0];
    } DDRC_CTRL_PERF @ 0x10;

    reg {
        name = "AXI operating mode register";
        desc = "DDRC_CFG_SREF is a DDRC self-refresh configuration register.

Data sheet 4.1.7 DDRC_CFG_SREF (offset 0x20, printed page 4-80, `hi3516av200--Hi3516AV200-Datasheet.txt` line 23089).";

        enum DDRC_CFG_SREF_asref_en_enum {
            DISABLED = 0x0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 0x1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "asref_en";
            desc = "SDRAM automatic self-refresh enable";
            sw = r;
            hw = w;
            encode = DDRC_CFG_SREF_asref_en_enum;
            reset = 0x0;
        } asref_en[31:16];

        field {
            name = "sref_arefnum";
            desc = "This function is not supported in this version. Number of self-refresh operations initiated after DDR3/DDR4/LPDDR3 SDRAM exits the self-refresh status during the DFS process 0x0: No self-refresh operation is initiated. 0x1-0xF: n";
            sw = rw;
            hw = r;
            reset = 0x0;
        } sref_arefnum[15:12];

        enum DDRC_CFG_SREF_clk_switch_enum {
            INTERFACE_COMMANDS_NOT = 0 { name = "Interface Commands Not"; desc = "The interface commands are not back pressed, and an error is returned directly."; };
            INTERFACE_COMMANDS_BACK = 1 { name = "Interface Commands Back"; desc = "The interface commands are back pressed, and the original command is executed after the clock is switched."; };
        };

        field {
            name = "clk_switch";
            desc = "DDRC low-power clock switch. Whether to back press AXI interface command when the DDRC enters the low-power status (DDR self-refresh)";
            sw = rw;
            hw = r;
            encode = DDRC_CFG_SREF_clk_switch_enum;
            reset = 0x0;
        } clk_switch[8:8];

        enum DDRC_CFG_SREF_sref_odis_enum {
            ENABLED = 0 { name = "Enabled"; desc = "enabled"; };
            DISABLED = 1 { name = "Disabled"; desc = "disabled"; };
        };

        field {
            name = "sref_odis";
            desc = "Output disable for the DDR command and data I/O in self-refresh mode";
            sw = rw;
            hw = r;
            encode = DDRC_CFG_SREF_sref_odis_enum;
            reset = 0x0;
        } sref_odis[4:4];

        enum DDRC_CFG_SREF_asref_fast_wakeup_enum {
            ENABLED = 0 { name = "Enabled"; desc = "enabled"; };
            DISABLED = 1 { name = "Disabled"; desc = "disabled"; };
        };

        field {
            name = "asref_fast_wakeup";
            desc = "Enable/disable of the AUTO SELFREFRESH fast wakeup";
            sw = rw;
            hw = r;
            encode = DDRC_CFG_SREF_asref_fast_wakeup_enum;
            reset = 0x0;
        } asref_fast_wakeup[1:1];

        enum DDRC_CFG_SREF_sref_cc_enum {
            SDRAM_CLOCK_ENABLED = 0 { name = "Sdram Clock Enabled"; desc = "The SDRAM clock is enabled."; };
            SDRAM_CLOCK_DISABLED = 1 { name = "Sdram Clock Disabled"; desc = "The SDRAM clock is disabled."; };
        };

        field {
            name = "sref_cc";
            desc = "SDRAM clock control in self-refresh mode";
            sw = rw;
            hw = r;
            encode = DDRC_CFG_SREF_sref_cc_enum;
            reset = 0x0;
        } sref_cc[0:0];
    } DDRC_CFG_SREF @ 0x20;

    reg {
        name = "DDR initialization configuration register";
        desc = "DDRC_CFG_INIT is a DDR initialization configuration register.

Data sheet 4.1.7 DDRC_CFG_INIT (offset 0x24, printed page 4-81, `hi3516av200--Hi3516AV200-Datasheet.txt` line 23164).";

        field {
            name = "init_arefnum";
            desc = "Number of auto-refresh operations when the DDR3/DDR4 SDRAM is being initialized 0x0-0x2: two 0x3-0xF: n";
            sw = rw;
            hw = r;
            reset = 0x0;
        } init_arefnum[7:0];
    } DDRC_CFG_INIT @ 0x24;

    reg {
        name = "DDR power-down status register";
        desc = "DDRC_CFG_PD is a DDR power-down status register. Hi3516A V200 Professional HD IP Camera SoC

Data sheet 4.1.7 DDRC_CFG_PD (offset 0x28, printed page 4-82, `hi3516av200--Hi3516AV200-Datasheet.txt` line 23202).";

        field {
            name = "asref_prd";
            desc = "SDRAM self-refresh cycle. When the DDRC does not receive any command in consecutive asref_prd cycles, it forces the SDRAM to enter the self-refresh status. When a command is received, the DDRC forces the SDRAM to exit the self-refresh status. 0x0-0xFFF: (n x 16) clock cycles";
            sw = r;
            hw = w;
            reset = 0x0;
        } asref_prd[31:20];

        field {
            name = "t_clk_cke";
            desc = "Relationship between CLK and CKE 0x0-0x7: Delay relative to CKE when the DDR PHY disables the DDR clock. The delay is related to the DDR PHY.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } t_clk_cke[19:16];

        field {
            name = "pd_prd";
            desc = "SDRAM power-down cycle. When the DDRC does not receive any command in consecutive pd_prd cycles, it forces the SDRAM to enter the power-down status. When a command is received, the DDRC forces the SDRAM to exit the power-down status. 0x00: not enter the power-down status 0x01-0xFFF: n clock cycles";
            sw = rw;
            hw = r;
            reset = 0x0;
        } pd_prd[15:4];

        enum DDRC_CFG_PD_pd_cc_enum {
            SDRAM_CLOCK_ENABLED = 0 { name = "Sdram Clock Enabled"; desc = "The SDRAM clock is enabled."; };
            SDRAM_CLOCK_DISABLED = 1 { name = "Sdram Clock Disabled"; desc = "The SDRAM clock is disabled."; };
        };

        field {
            name = "pd_cc";
            desc = "SDRAM clock control in power-down mode";
            sw = rw;
            hw = r;
            encode = DDRC_CFG_PD_pd_cc_enum;
            reset = 0x0;
        } pd_cc[2:2];

        enum DDRC_CFG_PD_pd_ac_enum {
            ENABLE_PIN_OUTPUT = 0 { name = "Enable Pin Output"; desc = "enable the pin output"; };
            DISABLE_PIN_OUTPUT = 1 { name = "Disable Pin Output"; desc = "disable the pin output"; };
        };

        field {
            name = "pd_ac";
            desc = "SDRAM address command dynamic disable in power-down mode";
            sw = rw;
            hw = r;
            encode = DDRC_CFG_PD_pd_ac_enum;
            reset = 0x0;
        } pd_ac[1:1];

        enum DDRC_CFG_PD_pd_en_enum {
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
        };

        field {
            name = "pd_en";
            desc = "Automatic power-down enable for the SDRAM";
            sw = rw;
            hw = r;
            encode = DDRC_CFG_PD_pd_en_enum;
            reset = 0x0;
        } pd_en[0:0];
    } DDRC_CFG_PD @ 0x28;

    reg {
        name = "DDRC auto-refresh mode register";
        desc = "DDRC_CFG_AREF is a DDRC auto-refresh mode register.

Data sheet 4.1.7 DDRC_CFG_AREF (offset 0x2C, printed page 4-83, `hi3516av200--Hi3516AV200-Datasheet.txt` line 23281).";

        field {
            name = "aref_alarm_num";
            desc = "The auto-refresh command is forced to be transmitted if a specific number of auto-refresh commands cannot be transmitted. 0x0-0xFF: lack of (n + 1) auto-refresh commands";
            sw = rw;
            hw = r;
            reset = 0x0;
        } aref_alarm_num[15:8];

        enum DDRC_CFG_AREF_pstpnd_level_enum {
            V_8 = 3 { name = "V 8"; desc = "8"; };
            V_4 = 2 { name = "V 4"; desc = "4"; };
            V_2 = 1 { name = "V 2"; desc = "2"; };
            V_1 = 0 { name = "V 1"; desc = "1"; };
        };

        field {
