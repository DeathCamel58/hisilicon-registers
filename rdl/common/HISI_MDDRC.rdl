            hw = r;
            reset = 0x0;
        } trodt_ext[30:28];

        field {
            name = "tmod";
            desc = "Delay from the MRS command to ODT and ZQCL validity 0x0-0x1: 1 clock cycle 0x2-0x1F: n clock cycles";
            sw = rw;
            hw = r;
            reset = 0x1F;
        } tmod[24:20];

        field {
            name = "twlo";
            desc = "DDR3 write-leveling output delay: 0x0 and 0x1: one clock cycle; 0x2-0xF: n clock cycles. The parameter equals twlo + twloe. (The bit table lists [19:0] as reserved, but the Name and Reset rows show twlo at [19:16] with reset 0xF, the same field as on the Hi3518E V20X; bit 13 is reserved and also resets to 1.)";
            sw = rw;
            hw = r;
            reset = 0xF;
        } twlo[19:16];

        field {
