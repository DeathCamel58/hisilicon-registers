Data sheet 4.1.5 AXI_REGION_ATTRIB (offset 0x104, printed page 4-20, `hi3516av200--Hi3516AV200-Datasheet.txt` line 19583).";

            field {
                name = "bnk_mod";
                desc = "Bank interleaving granularity in the channel of the current address area (the interleaving granularity varies according to the component) 8 bytes*2^n (8-bit components) 16 bytes*2^n (16-bit components) 32 bytes*2^n (32-bit components) 64 bytes*2^n (64-bit components) n=0-7";
                sw = rw;
                hw = r;
                reset = 0x0;
            } bnk_mod[30:28];

            enum AXI_REGION_ATTRIB_rnk_mod_enum {
                CONFIGURATION_DMC_USED = 0 { name = "Configuration Dmc Used"; desc = "The configuration in the DMC is used."; };
                SINGLE_INDEPENDENT_RANK = 1 { name = "Single Independent Rank"; desc = "a single independent rank address"; };
                TWO_RANK_ADDRESSES = 2 { name = "Two Rank Addresses"; desc = "Two rank addresses are interleaved."; };
                FOUR_RANK_ADDRESSES = 3 { name = "Four Rank Addresses"; desc = "Four rank addresses are interleaved. Only one channel is supported in this version and the channel supports only one rank."; };
            };

