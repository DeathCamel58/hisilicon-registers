        reg {
            name = "Priority adaptation cycle mapping table register";
            desc = "AXI_QOS_ADPTn is a priority adaptation cycle mapping table register. Hi3516A V200 Professional HD IP Camera SoC

Data sheet 4.1.5 AXI_QOS_ADPTn (offset 0x20C, printed page 4-29, `hi3516av200--Hi3516AV200-Datasheet.txt` line 20083).";

            field {
                name = "wr_adpt_high";
                desc = "Write command priority adaptation cycle (high-level) 0x0: The priority adaptation function is disabled. 0x1-0xF: (n x 16) clock cycles";
                sw = rw;
                hw = r;
                reset = 0x0;
            } wr_adpt_high[27:24];

            field {
                name = "wr_adpt_lvl";
                desc = "Write command priority adaptation cycle threshold 0x0-0x1: reserved 0x2-0x7: When the priority of a command is greater than or equal to the threshold, the command is mapped to the high-level cycle. Otherwise, the command is mapped to the low-level cycle. For example: 0x5: The priority adaptation cycle of write commands with priorities 2-5 is configured in wr_adpt_high, and that of write commands with priorities 6-7 is configured in wr_adpt_low.";
                sw = rw;
                hw = r;
                reset = 0x0;
            } wr_adpt_lvl[22:20];

            field {
                name = "wr_adpt_low";
                desc = "Write command priority adaptation cycle (low-level) 0x0: The priority adaptation function is disabled. 0x1-0xF: (n x 16) clock cycles";
                sw = rw;
                hw = r;
                reset = 0x0;
            } wr_adpt_low[19:16];

            field {
                name = "rd_adpt_high";
                desc = "Read command priority adaptation cycle (high-level) 0x0: The priority adaptation function is disabled. 0x1-0xF: (n x 16) clock cycles";
                sw = rw;
                hw = r;
                reset = 0x0;
            } rd_adpt_high[11:8];

            field {
                name = "rd_adpt_lvl";
                desc = "Read command priority adaptation cycle threshold 0x0-0x1: reserved 0x2-0x7: When the priority of a command is greater than or equal to the threshold, the command is mapped to the high-level cycle. Otherwise, the command is mapped to the low-level cycle. For example: 0x5: The priority adaptation cycle of read commands with priorities 2-5 is configured in rd_adpt_high, and that of read commands with priorities 6-7 is configured in rd_adpt_low.";
                sw = rw;
                hw = r;
                reset = 0x0;
            } rd_adpt_lvl[6:4];

            field {
                name = "rd_adpt_low";
                desc = "Read command priority adaptation cycle (low-level) 0x0: The priority adaptation function is disabled. 0x1-0xF: (n x 16) clock cycles";
                sw = rw;
                hw = r;
                reset = 0x0;
            } rd_adpt_low[3:0];
        } AXI_QOS_ADPT @ 0xC;

    } QOS_PORT[8] @ 0x200 += 0x10;

    regfile {
        name = "AXI OSTD_PORT[n]";
        desc = "Outstanding-command restriction and statistics of AXI port n (ports = 0..7) at 0x300 + 0x10 x n.";

        reg {
            name = "Port command OSTD restriction register";
            desc = "AXI_OSTD_PRTn is a port command OSTD restriction register.

Data sheet 4.1.5 AXI_OSTD_PRTn (offset 0x300, printed page 4-30, `hi3516av200--Hi3516AV200-Datasheet.txt` line 20178).";

            field {
                name = "prt_ostd_lvl";
                desc = "Command OSTD threshold of a port 0x00: The number of command OSTDs of a port is not limited. 0x01-0x7F: maximum number of command OSTDs allowed by the port";
                sw = rw;
                hw = r;
                reset = 0x0;
            } prt_ostd_lvl[6:0];
        } AXI_OSTD_PRT @ 0x0;

        reg {
            name = "Port command OSTD statistics register";
            desc = "AXI_OSTD_PRT_STn is a port command OSTD statistics register.

Data sheet 4.1.5 AXI_OSTD_PRT_STn (offset 0x304, printed page 4-31, `hi3516av200--Hi3516AV200-Datasheet.txt` line 20220).";

            field {
                name = "prt_ostd_st";
                desc = "Command OSTD statistics of a port";
                sw = r;
                hw = w;
                reset = 0x0;
            } prt_ostd_st[6:0];
        } AXI_OSTD_PRT_ST @ 0x4;

    } OSTD_PORT[8] @ 0x300 += 0x10;

    regfile {
        name = "AXI OSTD_GROUP[n]";
        desc = "Outstanding-command restriction and statistics of port group n (groups = 0..3) at 0x400 + 0x10 x n.";

        reg {
            name = "Command OSTD register for the port group";
            desc = "AXI_OSTD_GROUPn is a command OSTD register for the port group.

Data sheet 4.1.5 AXI_OSTD_GROUPn (offset 0x400, printed page 4-31, `hi3516av200--Hi3516AV200-Datasheet.txt` line 20242).";

            field {
                name = "group_ostd_sel";
                desc = "Port select of a group When group_ostd_sel[n] is 0, port n is not selected. When group_ostd_sel[n] is 1, port n is selected.";
                sw = rw;
                hw = r;
                reset = 0x0;
            } group_ostd_sel[27:16];

            field {
                name = "group_ostd_lvl";
                desc = "Command OSTD threshold of a port group 0x00: The number of command OSTDs of the port group is not limited. 0x01-0x7F: maximum number of accumulated command OSTDs allowed by the port group";
                sw = rw;
                hw = r;
                reset = 0x0;
            } group_ostd_lvl[6:0];
        } AXI_OSTD_GROUP @ 0x0;

        reg {
            name = "Priority-based port group command OSTD restriction register 0";
            desc = "AXI_OSTD_PRI0 is priority-based port group command OSTD restriction register 0.

Data sheet 4.1.5 AXI_OSTD_PRI0 (offset 0x404, printed page 4-32, `hi3516av200--Hi3516AV200-Datasheet.txt` line 20294).";

            field {
                name = "pri3_ostd_lvl";
                desc = "Priority 3 command OSTD threshold 0x00: The number of accumulated command OSTDs of the selected port group is not limited. 0x01-0x7F: When the number of accumulated command OSTDs of the selected port group reaches the threshold, only the commands whose priorities are higher than 1 are allowed.";
                sw = rw;
                hw = r;
                reset = 0x0;
            } pri3_ostd_lvl[30:24];

            field {
                name = "pri2_ostd_lvl";
                desc = "Priority 2 command OSTD threshold 0x00: The number of accumulated command OSTDs of the selected port group is not limited. 0x01-0x7F: When the number of accumulated command OSTDs of the selected port group reaches the threshold, only the commands whose priorities are higher than 1 are allowed.";
                sw = rw;
                hw = r;
                reset = 0x0;
            } pri2_ostd_lvl[22:16];

            field {
                name = "pri1_ostd_lvl";
                desc = "Priority 1 command OSTD threshold 0x00: The number of accumulated command OSTDs of the selected port group is not limited. 0x01-0x7F: When the number of accumulated command OSTDs of the selected port group reaches the threshold, only the commands whose priorities are higher than 1 are allowed.";
                sw = rw;
                hw = r;
                reset = 0x0;
            } pri1_ostd_lvl[14:8];
        } AXI_OSTD_PRI0 @ 0x4;

        reg {
            name = "Priority-based port group command OSTD restriction register 1";
            desc = "AXI_OSTD_PRI1 is priority-based port group command OSTD restriction register 1. Hi3516A V200 Professional HD IP Camera SoC

Data sheet 4.1.5 AXI_OSTD_PRI1 (offset 0x408, printed page 4-34, `hi3516av200--Hi3516AV200-Datasheet.txt` line 20382).";

            field {
                name = "pri7_ostd_lvl";
                desc = "Priority 7 command OSTD threshold 0x00: The number of accumulated command OSTDs of the selected port group is not limited. 0x01-0x7F: When the number of accumulated command OSTDs of the selected port group reaches the threshold, only the commands whose priorities are higher than 1 are allowed.";
                sw = rw;
                hw = r;
                reset = 0x0;
            } pri7_ostd_lvl[30:24];

            field {
                name = "pri6_ostd_lvl";
                desc = "Priority 6 command OSTD threshold 0x00: The number of accumulated command OSTDs of the selected port group is not limited. 0x01-0x7F: When the number of accumulated command OSTDs of the selected port group reaches the threshold, only the commands whose priorities are higher than 1 are allowed.";
                sw = rw;
                hw = r;
                reset = 0x0;
            } pri6_ostd_lvl[22:16];

            field {
                name = "pri5_ostd_lvl";
                desc = "Priority 5 command OSTD threshold 0x00: The number of accumulated command OSTDs of the selected port group is not limited. 0x01-0x7F: When the number of accumulated command OSTDs of the selected port group reaches the threshold, only the commands whose priorities are higher than 1 are allowed.";
                sw = rw;
                hw = r;
                reset = 0x0;
            } pri5_ostd_lvl[14:8];

            field {
                name = "pri4_ostd_lvl";
                desc = "Priority 4 command OSTD threshold 0x00: The number of accumulated command OSTDs of the selected port group is not limited. 0x01-0x7F: When the number of accumulated command OSTDs of the selected port group reaches the threshold, only the commands whose priorities are higher than 1 are allowed.";
                sw = rw;
                hw = r;
                reset = 0x0;
            } pri4_ostd_lvl[6:0];
        } AXI_OSTD_PRI1 @ 0x8;

        reg {
            name = "Command OSTD statistics register for the port group";
            desc = "AXI_OSTD_GROUP_STn is a command OSTD statistics register for the port group.

Data sheet 4.1.5 AXI_OSTD_GROUP_STn (offset 0x40C, printed page 4-35, `hi3516av200--Hi3516AV200-Datasheet.txt` line 20472).";

            field {
                name = "group_ostd_st";
                desc = "Command OSTD statistics of a port group";
                sw = r;
                hw = w;
                reset = 0x0;
            } group_ostd_st[6:0];
        } AXI_OSTD_GROUP_ST @ 0xC;

    } OSTD_GROUP[4] @ 0x400 += 0x10;

};

regfile eHISI_MDDRC_QOSB {
    name = "MDDRC QoSBuf registers";
    desc = "QoS buffer (QoSBuf) registers of the MDDRC (data sheet 4.1.6, Table 4-10, base 0x1206_4000, 56 registers): push / adaptation control, traffic statistics (matched IDs fids = 0..6, groups fgps = 0..7), bank rotation and green channel, write buffer, write/read timeout and ageing tables, row-hit priority, clock gating, DMC entry threshold, performance statistics, slot / buffer status, interrupts and command / rank / bank counters. The chans variable is 0 only (one channel), so the per-channel registers are single registers.";

    reg {
        name = "QosBuf push configuration register";
        desc = "QOSB_PUSH_CTRL is a QosBuf push configuration register.

Data sheet 4.1.6 QOSB_PUSH_CTRL (offset 0x0, printed page 4-40, `hi3516av200--Hi3516AV200-Datasheet.txt` line 20727).";

        enum QOSB_PUSH_CTRL_mid_push_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "mid_push_en";
            desc = "Push enable for commands with the same MID";
            sw = rw;
            hw = r;
            encode = QOSB_PUSH_CTRL_mid_push_en_enum;
            reset = 0x0;
        } mid_push_en[2:2];

        enum QOSB_PUSH_CTRL_addr_push_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "addr_push_en";
            desc = "Push enable for commands with the same address";
            sw = rw;
            hw = r;
            encode = QOSB_PUSH_CTRL_addr_push_en_enum;
            reset = 0x0;
        } addr_push_en[1:1];

        enum QOSB_PUSH_CTRL_id_push_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "id_push_en";
            desc = "Push enable for commands with the same ID";
            sw = rw;
            hw = r;
            encode = QOSB_PUSH_CTRL_id_push_en_enum;
            reset = 0x0;
        } id_push_en[0:0];
    } QOSB_PUSH_CTRL @ 0x0;

    reg {
        name = "Lock control register";
        desc = "QOSB_ADPT_CTRL is a QoSBuf adaptation configuration register. Hi3516A V200 Professional HD IP Camera SoC

Data sheet 4.1.6 QOSB_ADPT_CTRL (offset 0x4, printed page 4-41, `hi3516av200--Hi3516AV200-Datasheet.txt` line 20771).";

        field {
            name = "adpt_share_cnt";
            desc = "Adapt counter for lower bits. When the value of this counter decreases to 0, the counter for upper bits corresponding to each CMD decreases by 1.";
            sw = rw;
            hw = r;
            reset = 0xFF;
        } adpt_share_cnt[19:4];

        enum QOSB_ADPT_CTRL_adpt_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "adpt_en";
            desc = "Adapt enable";
            sw = rw;
            hw = r;
            encode = QOSB_ADPT_CTRL_adpt_en_enum;
            reset = 0x0;
        } adpt_en[0:0];
    } QOSB_ADPT_CTRL @ 0x4;

    reg {
        name = "Module clock gating register";
        desc = "QOSB_FLUX_ID is a QoSBuf matched ID register for traffic statistics.

Data sheet 4.1.6 QOSB_FLUX_ID (offset 0x8, printed page 4-41, `hi3516av200--Hi3516AV200-Datasheet.txt` line 20803).";

        field {
            name = "flux_id";
            desc = "Matched ID for traffic statistics. The ID ranges from 0 to 6, and each ID corresponds to a statistics group. If the traffic ID matches none of the seven IDs, the traffic is included in the default group.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } flux_id[31:0];
    } QOSB_FLUX_ID[7] @ 0x8 += 0x4;

    reg {
        name = "QoSBuf traffic statistics ID mask register";
        desc = "QOSB_FLUX_ID_MASK is a QoSBuf traffic statistics ID mask register. Hi3516A V200 Professional HD IP Camera SoC

Data sheet 4.1.6 QOSB_FLUX_ID_MASK (offset 0x24, printed page 4-42, `hi3516av200--Hi3516AV200-Datasheet.txt` line 20836).";

        enum QOSB_FLUX_ID_MASK_flux_id_mask_enum {
            BITS_CORRESPONDING_ID = 0x0 { name = "Bits Corresponding Id"; desc = "Bits of the corresponding ID are ignored."; };
            BITS_CORRESPONDING_ID_2 = 0x1 { name = "Bits Corresponding Id 2"; desc = "Bits of the corresponding ID are compared."; };
        };

        field {
            name = "flux_id_mask";
            desc = "QoSBuf traffic statistics ID mask, corresponding to QOSB_FLUX_ID";
            sw = rw;
            hw = r;
            encode = QOSB_FLUX_ID_MASK_flux_id_mask_enum;
            reset = 0x0;
        } flux_id_mask[31:0];
    } QOSB_FLUX_ID_MASK[7] @ 0x24 += 0x4;

    reg {
        name = "QoSBuf traffic statistical period register";
        desc = "QOSB_FLUX_PRD is a QoSBuf traffic statistical period register.

Data sheet 4.1.6 QOSB_FLUX_PRD (offset 0x40, printed page 4-42, `hi3516av200--Hi3516AV200-Datasheet.txt` line 20859).";

        field {
            name = "flux_prd";
            desc = "Traffic statistical period";
            sw = rw;
            hw = r;
            reset = 0x0;
        } flux_prd[15:0];
    } QOSB_FLUX_PRD @ 0x40;

    reg {
        name = "QoSBuf traffic statistical threshold register";
        desc = "QOSB_FLUX_LVL is a QoSBuf traffic statistical threshold register. Hi3516A V200 Professional HD IP Camera SoC

Data sheet 4.1.6 QOSB_FLUX_LVL (offset 0x44, printed page 4-43, `hi3516av200--Hi3516AV200-Datasheet.txt` line 20891).";

        field {
            name = "flux_lvl";
            desc = "Traffic statistical threshold. During the statistical period, the priority of the command is decreased to the lowest one when the traffic exceeds the threshold.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } flux_lvl[19:0];
    } QOSB_FLUX_LVL[8] @ 0x44 += 0x4;

    reg {
        name = "QoSBuf traffic statistics enable register";
        desc = "QOSB_FLUX_EN is a QoSBuf traffic statistics enable register.

Data sheet 4.1.6 QOSB_FLUX_EN (offset 0x64, printed page 4-43, `hi3516av200--Hi3516AV200-Datasheet.txt` line 20913).";

        enum QOSB_FLUX_EN_flux_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "flux_en";
            desc = "Traffic statistics enable";
            sw = rw;
            hw = r;
            encode = QOSB_FLUX_EN_flux_en_enum;
            reset = 0x0;
        } flux_en[0:0];
    } QOSB_FLUX_EN @ 0x64;

    reg {
        name = "QoSBuf bank rotating control register";
        desc = "QOSB_BANK_CTRL is a QoSBuf bank rotating control register. Hi3516A V200 Professional HD IP Camera SoC

Data sheet 4.1.6 QOSB_BANK_CTRL (offset 0x68, printed page 4-44, `hi3516av200--Hi3516AV200-Datasheet.txt` line 20949).";

        field {
            name = "ba_cnt_lvl";
            desc = "Bank conflict threshold. When the number of commands with the same bank address exceeds the threshold, bank conflict occurs. Otherwise, there is no bank conflict.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } ba_cnt_lvl[7:4];

        enum QOSB_BANK_CTRL_ba_intleav_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "ba_intleav_en";
            desc = "QoSBuf bank rotating enable";
            sw = rw;
            hw = r;
            encode = QOSB_BANK_CTRL_ba_intleav_en_enum;
            reset = 0x0;
        } ba_intleav_en[0:0];
    } QOSB_BANK_CTRL @ 0x68;

    reg {
        name = "QoSBuf green channel control register";
        desc = "QOSB_GREEN_CTRL is a QoSBuf green channel control register.

Data sheet 4.1.6 QOSB_GREEN_CTRL (offset 0x78, printed page 4-44, `hi3516av200--Hi3516AV200-Datasheet.txt` line 20984).";

        field {
            name = "green_lvl";
            desc = "Green channel threshold. That is, the empty locations above this threshold are reserved for green channels. For example, if there are 12 DMC queues (queues 0-11) and the threshold is 9, queues 10 and 11 are reserved for green channels.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } green_lvl[7:4];

        enum QOSB_GREEN_CTRL_green_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "green_en";
            desc = "Green channel enable (channels are not controlled separately, which needs to be optimized later)";
            sw = rw;
            hw = r;
            encode = QOSB_GREEN_CTRL_green_en_enum;
            reset = 0x0;
        } green_en[0:0];
    } QOSB_GREEN_CTRL @ 0x78;

    reg {
        name = "QoSBuf bypass control register";
        desc = "QOSB_BUF_BYP is a QoSBuf bypass control register.

Data sheet 4.1.6 QOSB_BUF_BYP (offset 0x88, printed page 4-45, `hi3516av200--Hi3516AV200-Datasheet.txt` line 21036).";

        enum QOSB_BUF_BYP_qos_buf_byp_enum {
            WHETHER_BYPASS_DEPENDS = 1 { name = "Whether Bypass Depends"; desc = "whether to bypass depends on the queue status in the DMC"; };
            FORCIBLE_BYPASS_MODE = 3 { name = "Forcible Bypass Mode"; desc = "forcible bypass mode. None of the commands enters the QoSBuf module."; };
        };

        field {
            name = "qos_buf_byp";
            desc = "QoSBuf bypass control x0: forcible non-bypass mode. That is, all the commands enter the QoSBuf module when the value is set to 00 or 10.";
            sw = rw;
            hw = r;
            encode = QOSB_BUF_BYP_qos_buf_byp_enum;
            reset = 0x0;
        } qos_buf_byp[1:0];
    } QOSB_BUF_BYP @ 0x88;

    reg {
        name = "QoSBuf write command priority adjustment control register";
        desc = "QOSB_WBUF_CTRL is a QoSBuf write command priority adjustment control register.

Data sheet 4.1.6 QOSB_WBUF_CTRL (offset 0x8C, printed page 4-46, `hi3516av200--Hi3516AV200-Datasheet.txt` line 21080).";

        enum QOSB_WBUF_CTRL_wbuf_ptun_en_enum {
