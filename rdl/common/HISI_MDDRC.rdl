            sw = rw;
            hw = r;
            reset = 0x0;
        } emrs3[31:16];

        field {
            name = "emrs2";
            desc = "DDR3/DDR4 SDRAM extended mode register 2 This field corresponds to valid bits 13-0 of mode register 2 (MR2) in the DDR3/DDR4 SDRAM manual. MR2[15:14] of most DDR SDRAMs are not used. DDRC_CFG_EMRS23 bit[15:14] are reserved and set to 2'b00. LPDDR3 SDRAM mode register 4. The lower eight bits are valid for this register. For details about MR2, see the DDR3/DDR4 SDRAM manual.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } emrs2[15:0];
    } DDRC_CFG_EMRS23 @ 0xF4;

