            enum AXI_QOS_RDPRI_rd_pri6_enum {
                HIGHEST_PRIORITY = 0 { name = "Highest Priority"; desc = "highest priority …"; };
                LOWEST_PRIORITY = 7 { name = "Lowest Priority"; desc = "lowest priority"; };
            };

            field {
                name = "rd_pri6";
                desc = "Priority of the read command when the mapping index is 6";
                sw = rw;
                hw = r;
                encode = AXI_QOS_RDPRI_rd_pri6_enum;
                reset = 0x0;
            } rd_pri6[26:24];

            enum AXI_QOS_RDPRI_rd_pri5_enum {
