        } stacmd_rpt[2:0];
    } DDRC_STAT_RPT @ 0x3B4;

    reg {
        name = "DDRC accumulated command count register";
        desc = "DDRC_HIS_CMD_SUM is a DDRC accumulated command count register.

Data sheet 4.1.7 DDRC_HIS_CMD_SUM (offset 0x3B8, printed page 4-130, `hi3516av200--Hi3516AV200-Datasheet.txt` line 26052).";

        field {
            name = "dmc_cmd_sum";
            desc = "Accumulated value of the commands that are temporarily stored in the DMC in the cycle. The value is wrapped if an overflow occurs.";
            sw = r;
            hw = w;
            reset = 0x0;
        } dmc_cmd_sum[31:0];
    } DDRC_HIS_CMD_SUM @ 0x3B8;

    reg {
        name = "DDRC accumulated data count register";
        desc = "DDRC_HIS_CMD_SUM is a DDRC accumulated data count register.

Data sheet 4.1.7 DDRC_HIS_DAT_SUM (offset 0x3BC, printed page 4-130, `hi3516av200--Hi3516AV200-Datasheet.txt` line 26073).";

        field {
            name = "dmc_dat_sum";
            desc = "Accumulated value of data that are temporarily stored in the DMC in the cycle. The value is wrapped if an overflow occurs.";
            sw = r;
            hw = w;
            reset = 0x0;
        } dmc_dat_sum[31:0];
    } DDRC_HIS_DAT_SUM @ 0x3BC;

    reg {
        name = "SFC read data register 0";
        desc = "DDRC_HIS_SFC_RDATA0 is SFC read data register 0.

Data sheet 4.1.7 DDRC_HIS_SFC_RDATA0 (offset 0x4A8, printed page 4-130, `hi3516av200--Hi3516AV200-Datasheet.txt` line 26093).";

        field {
            name = "rdata0";
            desc = "Bits 31-0 of the data read by the SFC";
            sw = r;
            hw = w;
            reset = 0x0;
        } rdata0[31:0];
    } DDRC_HIS_SFC_RDATA0 @ 0x4A8;

    reg {
        name = "SFC read data register";
        desc = "DDRC_HIS_SFC_RDATA1 is an SFC read data register.

Data sheet 4.1.7 DDRC_HIS_SFC_RDATA1 (offset 0x4AC, printed page 4-131, `hi3516av200--Hi3516AV200-Datasheet.txt` line 26118).";

        field {
            name = "rdata1";
            desc = "Bits 63-32 of the data read by the SFC";
            sw = r;
            hw = w;
            reset = 0x0;
        } rdata1[31:0];
    } DDRC_HIS_SFC_RDATA1 @ 0x4AC;

    reg {
        name = "SFC read data register";
        desc = "DDRC_HIS_SFC_RDATA2 is an SFC read data register.

Data sheet 4.1.7 DDRC_HIS_SFC_RDATA2 (offset 0x4B0, printed page 4-131, `hi3516av200--Hi3516AV200-Datasheet.txt` line 26137).";

        field {
            name = "rdata2";
            desc = "Bits 95-64 of the data read by the SFC";
            sw = r;
            hw = w;
            reset = 0x0;
        } rdata2[31:0];
    } DDRC_HIS_SFC_RDATA2 @ 0x4B0;

    reg {
        name = "Software configuration read data register 3";
        desc = "DDRC_HIS_SFC_RDATA3 is software configuration read data register 3.

Data sheet 4.1.7 DDRC_HIS_SFC_RDATA3 (offset 0x4B4, printed page 4-131, `hi3516av200--Hi3516AV200-Datasheet.txt` line 26156).";

        field {
            name = "rdata3";
            desc = "Bits 127-96 of the data read by the SFC";
            sw = rw;
            hw = r;
            reset = 0x0;
        } rdata3[31:0];
    } DDRC_HIS_SFC_RDATA3 @ 0x4B4;

};

regfile eHISI_MDDRC {
    name = "HiSilicon MDDRC (DDR3/DDR4/LPDDR3 controller, Hi3516A V200 / Hi3519 V101)";
    desc = "
    Multi-port DDR controller of the Hi3516A V200 and Hi3519 V101 (data sheet chapter 4.1): AXI front end at +0x0000 (0x1206_0000), QoS buffer at +0x4000 (0x1206_4000) and DMC0 at +0x8000 (0x1206_8000), as printed in the data sheet summary tables (Tables 4-8, 4-10, 4-12). The address map calls the 64 KB window 'MDDRC/DDR PHY register'; the data sheets have no DDR PHY chapter. The vendor U-Boot (`arch/arm/cpu/hi3516av200/ddr_training_custom.h`, `hi3519v101/...`) selects the DDRC V510 DMC driver (`drivers/ddr/ddr_ddrc_v510.h`) with the 28 nm T28 DDR PHY (`ddr_phy_t28.h`, base DDRC + 0xC000 on the Hi3516A V300 which documents it at 0x1206_C000) and the T28 DDRT.

    Not the eHISI_DDRC_V2 layout (Hi3518E V20X / Hi3516A V100 / Hi3516C V300: AXI_CONFIG at 0x0, DMC CFG_TIMING0.. at 0x80): this generation adds a lock register, address regions with scrambling, per-port QoS priority tables, a separate QoSBuf block and DDR4 / LPDDR3 mode fields. The Hi3516A V300 (original Chinese data sheet) is a further variant with a TZASC at +0x1000 and a different QoSBuf timeout / DMC timing layout (not modelled here).

    Both data sheets are English-only HiSilicon editions; no hardware verification.
    ";

    eHISI_MDDRC_AXI   AXI  @ 0x0000;
    eHISI_MDDRC_QOSB  QOSB @ 0x4000;
    eHISI_MDDRC_DMC   DMC  @ 0x8000;
};

`endif
