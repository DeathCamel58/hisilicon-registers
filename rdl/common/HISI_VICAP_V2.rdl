            LOW_PRIORITY = 0x0 { name = "Low Priority"; desc = "low priority"; };
            HIGH_PRIORITY_BIT = 0x1 { name = "High Priority Bit"; desc = "high priority bit[8]: reserved bit[9]: SRC1 read request priority bit[10]: reserved bit[11]: reserved bit[12]: reserved bit[13]: reserved bit[14]: reserved bit[15]: reserved"; };
        };

        field {
            name = "r_req_prio";
            desc = "Read request arbitration priority";
            sw = rw;
            hw = r;
            encode = MAC_CFG_r_req_prio_enum;
            reset = 0x0;
        } r_req_prio[15:8];

