        enum ISP_SEL_isp_sel_enum {
            ISP_CONNECTS_LINE = 0 { name = "Isp Connects Line"; desc = "The ISP connects to LINE_BUF."; };
            ISP_CONNECTS_SRC0 = 1 { name = "Isp Connects Src0"; desc = "The ISP connects to SRC0."; };
            ISP_CONNECTS_SRC1 = 2 { name = "Isp Connects Src1"; desc = "The ISP connects to SRC1."; };
