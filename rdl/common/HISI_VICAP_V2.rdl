`ifndef HISI_VICAP_V2_RDL
`define HISI_VICAP_V2_RDL

// VICAP (single port / single channel generation with built-in ISP) of the Hi3518EV200 / Hi3516CV200 (data sheet 9.1).
regfile eHISI_VICAP_V2 {
    name = "VICAP (video capture, single channel)";
    desc = "
    Video capture (VICAP) of the Hi3518E V20X / Hi3516C V200 at 0x20580000 (data sheet 9.1), VIC interrupt 22 (shared with the built-in ISP): one external sensor/video input port (PT: BT.656,
    BT.601, BT.1120, DC parallel up to 16 bit / 14-bit RAW, or the MIPI RX output), one capture channel (CH) with crop, the ISP, chrominance resampling and a write channel to DDR
    (SPYCbCr 4:2:2 / 4:2:0, offline) or online output to the VPSS; flash and shutter trigger outputs; maximum 1920 x 1080 input.

    Register groups (data sheet 9.1.5): 0x000-0x0F8 global (WK_MODE, AXI_CFG, MAC_CFG, DES_SEL, ISP_SEL, CHN_MODE, BUF_MODE, APB_TIMEOUT, VICAP_INT / VICAP_INT_MASK), 0x100-0x1F8
    input port PT (interface mode, data offsets, BT.656, timing, flash/shutter, status, interrupts), 0x200-0x2F8 DES (descriptor / crop / frame address / stride of the data path),
    0x500-0x5F8 LINE_BUF, 0x700-0x7F8 SRC, 0x1004-0x10F8 capture channel CH (adapter, Y/C write channels, interrupts). The ISP registers (data sheet chapter 10, offsets 0x20080-0x32324
    of the same window) are the separate `eHISI_ISP` block instantiated at 0x205A0000.

    This is the VICAP generation of the Hi3516CV300 / Hi3519 (PT / DES / CH register names); it is NOT the multi-channel VICAP of the Hi3520D (`eHISI_VICAP`). Register table: data sheet
    9.1.5 / 9.1.6 (`hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` lines 50449-53659), 87 registers transcribed with fields, access types and reset values; vendor driver binary only; no hardware verification.
    ";

    reg {
        name = "Global operating mode configuration register";
        desc = "WK_MODE is a global operating mode configuration register.

Data sheet 9.1.6 WK_MODE (offset 0x0, printed page 9-18, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 50655).";

        field {
            name = "ros_mem_ema";
            desc = "Speed adjustment configuration for the Q end of the read-only memory";
            sw = rw;
            hw = r;
            reset = 0x2;
        } ros_mem_ema[16:14];

        field {
            name = "rft_mem_emab";
            desc = "Speed adjustment configuration for the D end of the dual-port memory";
            sw = rw;
            hw = r;
            reset = 0x2;
        } rft_mem_emab[13:11];

        field {
            name = "rft_mem_emaa";
            desc = "Speed adjustment configuration for the Q end of the dual-port memory";
            sw = rw;
            hw = r;
            reset = 0x2;
        } rft_mem_emaa[10:8];

        field {
            name = "rfs_mem_emaw";
            desc = "Speed adjustment configuration for the D end of the single-port memory";
            sw = rw;
            hw = r;
            reset = 0x0;
        } rfs_mem_emaw[7:6];

        field {
            name = "rfs_mem_ema";
            desc = "Speed adjustment configuration for the Q end of the single-port memory";
            sw = rw;
            hw = r;
            reset = 0x2;
        } rfs_mem_ema[5:3];

        enum WK_MODE_power_mode_enum {
            LOW_POWER_MODE = 0 { name = "Low Power Mode"; desc = "The low-power mode is disabled."; };
            LOW_POWER_MODE_2 = 1 { name = "Low Power Mode 2"; desc = "The low-power mode is enabled."; };
        };

        field {
            name = "power_mode";
            desc = "Clock mode";
            sw = rw;
            hw = r;
            encode = WK_MODE_power_mode_enum;
            reset = 0x0;
        } power_mode[0:0];
    } WK_MODE @ 0x0;

    reg {
        name = "Bus configuration register";
        desc = "AXI_CFG is a bus configuration register.

Data sheet 9.1.6 AXI_CFG (offset 0x10, printed page 9-19, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 50711).";

        field {
            name = "reserved_b31_16";
            desc = "Reserved in the data sheet; modelled so that the total reset value 0x10100000 of the data sheet header is reproduced (reads 0x1010).";
            sw = r;
            hw = w;
            reset = 0x1010;
        } reserved_b31_16[31:16];

        field {
            name = "r_outstanding";
            desc = "Number of read request outstandings Value range: [1, 8]";
            sw = rw;
            hw = r;
            reset = 0x0;
        } r_outstanding[15:12];

        field {
            name = "w_outstanding";
            desc = "Number of write request outstandings Value range: [1, 8]";
            sw = rw;
            hw = r;
            reset = 0x0;
        } w_outstanding[7:4];
    } AXI_CFG @ 0x10;

    reg {
        name = "MAC configuration register";
        desc = "MAC_CFG is an MAC configuration register.

Data sheet 9.1.6 MAC_CFG (offset 0x14, printed page 9-19, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 50737).";

