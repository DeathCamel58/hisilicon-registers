            HIGH_PRIORITY_BIT = 0x1 { name = "High Priority Bit"; desc = "high priority bit[0]: DES0 write request priority bit[1]: reserved bit[2]: reserved bit[3]: reserved bit[4]: reserved bit[5]: reserved bit[6]: reserved bit[7]: reserved"; };
        };

        field {
