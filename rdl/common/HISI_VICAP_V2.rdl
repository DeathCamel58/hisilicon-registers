    reg {
        name = "SRC0/DES0 bus read/write rate control mode register";
        desc = "CHN_MODE is an SRC0/DES0 bus read/write rate control mode register.

Data sheet 9.1.6 CHN_MODE (offset 0x60, printed page 9-21, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 50850).";

        enum CHN_MODE_chn_mode_enum {
            NO_RATE_CONTROL = 0 { name = "No Rate Control"; desc = "no rate control"; };
            RATE_SRC0_CONTROLLED = 1 { name = "Rate Src0 Controlled"; desc = "The rate of SRC0 is controlled to ensure that it is lower than the DES0 write rate (read after write)"; };
            RATE_DES0_CONTROLLED = 2 { name = "Rate Des0 Controlled"; desc = "The rate of DES0 is controlled to ensure that it is lower than the SRC0 read rate (write after read)"; };
            RESERVED = 3 { name = "Reserved"; desc = "reserved"; };
        };

        field {
            name = "chn_mode";
            desc = "SRC0/DES0 bus read/write rate control mode (used when SRC0 shares the buffer with DES0)";
            sw = rw;
            hw = r;
            encode = CHN_MODE_chn_mode_enum;
            reset = 0x0;
        } chn_mode[1:0];
    } CHN_MODE @ 0x60;

