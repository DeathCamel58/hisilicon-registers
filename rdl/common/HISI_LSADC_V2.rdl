    } LSADC_CTRL6 @ 0x18;

    reg {
        name = "Start configuration register";
        desc = "LSADC_CTRL7 is a start configuration register.

Data sheet 12.11 LSADC_CTRL7 (offset 0x1C, printed page 12-375, `hi3516av200--Hi3516AV200-Datasheet.txt` line 110197); the other editions (12.9 in the Hi3516C V300 and Hi3516A V300 data sheets) print the same register.";

        field {
            name = "start";
            desc = "LSADC start signal. Writing any value to this register starts the LSADC.";
            sw = w;
            hw = r;
            reset = 0x0;
        } start[31:0];

    } LSADC_CTRL7 @ 0x1C;

    reg {
        name = "Stop configuration register";
        desc = "LSADC_CTRL8 is a stop configuration register.

Data sheet 12.11 LSADC_CTRL8 (offset 0x20, printed page 12-375, `hi3516av200--Hi3516AV200-Datasheet.txt` line 110218); the other editions (12.9 in the Hi3516C V300 and Hi3516A V300 data sheets) print the same register.";

        field {
            name = "stop";
            desc = "Automatic scanning stop. In automatic scanning mode, writing any value to this register stops automatic scanning of the LSADC. Automatic scanning is restarted only after the start bit is enabled.";
            sw = w;
            hw = r;
            reset = 0x0;
        } stop[31:0];

    } LSADC_CTRL8 @ 0x20;

    reg {
        name = "Conversion result precision register";
        desc = "LSADC_CTRL9 is a conversion result precision register.

Total reset 0x3FF (10-bit precision). When the precision is below 10 bits the corresponding upper bits of the sampling result are valid (for 8 bits the upper 8 bits).

Data sheet 12.11 LSADC_CTRL9 (offset 0x24, printed page 12-375, `hi3516av200--Hi3516AV200-Datasheet.txt` line 110238); the other editions (12.9 in the Hi3516C V300 and Hi3516A V300 data sheets) print the same register.";

        field {
            name = "lsadc_active_bit";
            desc = "LSADC conversion result precision. 10'b1111111111: 10-bit precision; 10'b1111111110: 9-bit precision; ...; 10'b1000000000: 1-bit precision.";
            sw = rw;
            hw = r;
            reset = 0x3FF;
        } lsadc_active_bit[9:0];

    } LSADC_CTRL9 @ 0x24;

    reg {
        name = "lsadc_zero register";
        desc = "LSADC_CTRL10 is an lsadc_zero register.

Data sheet 12.11 LSADC_CTRL10 (offset 0x28, printed page 12-376, `hi3516av200--Hi3516AV200-Datasheet.txt` line 110271); the other editions (12.9 in the Hi3516C V300 and Hi3516A V300 data sheets) print the same register.";

        field {
            name = "lsadc_zero";
            desc = "LSADC value when no key is pressed.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } lsadc_zero[9:0];

    } LSADC_CTRL10 @ 0x28;

