        enum LSADC_CTRL6_clr_int_flag_in2_enum {
            NOT_CLEARED = 0 { name = "Not Cleared"; desc = "not cleared"; };
            CLEARED = 1 { name = "Cleared"; desc = "cleared"; };
        };

        field {
            name = "clr_int_flag_in2";
            desc = "Channel 2 interrupt clear";
