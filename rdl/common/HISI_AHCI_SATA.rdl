                desc = "Command list processing indication.";
                sw = r;
                hw = w;
                encode = SATA_PORT_CMD_cmd_cr_enum;
                reset = 0x0;
            } cmd_cr[15:15];

            enum SATA_PORT_CMD_cmd_fr_enum {
                NO_FIS_BEING = 0 { name = "No Fis Being"; desc = "No FIS is being received."; };
                FIS_BEING_RECEIVED = 1 { name = "Fis Being Received"; desc = "An FIS is being received."; };
            };

            field {
                name = "cmd_fr";
                desc = "FIS receive processing indication.";
                sw = r;
                hw = w;
                encode = SATA_PORT_CMD_cmd_fr_enum;
                reset = 0x0;
            } cmd_fr[14:14];

            field {
                name = "cmd_ccs";
                desc = "Slot number of the current command. This field is valid when cmd_st is 1 and is cleared when cmd_st is 0.";
                sw = r;
                hw = w;
                reset = 0x0;
            } cmd_ccs[12:8];

            enum SATA_PORT_CMD_cmd_fre_enum {
                FORBID_WRITE_RECEIVED = 0 { name = "Forbid Write Received"; desc = "forbid to write the received FISs to the system memory"; };
                ENABLE_RECEIVED_FISS = 1 { name = "Enable Received Fiss"; desc = "enable the received FISs and write them to the system memory The software needs to set the receive FIS base address register SATA_PORT_FB before enabling this bit to receive FISs. When cmd_st is 1, this bit must be set to 1."; };
            };

            field {
