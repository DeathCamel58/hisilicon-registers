                sw = rw;
                hw = r;
                encode = SATA_PORT_CMD_cmd_fre_enum;
                reset = 0x0;
            } cmd_fre[4:4];

            enum SATA_PORT_CMD_cmd_clo_enum {
                NO_EFFECT = 0 { name = "No Effect"; desc = "no effect"; };
                CLEAR_BSY_DRQ = 1 { name = "Clear Bsy Drq"; desc = "Clear the BSY and DRQ bits of SATA_PORT_TFD[tfd_sts]. After the BSY and DRQ bits are 0, the cmd_clo bit is cleared automatically. The cmd_clo bit can be written as 1 only before the value of cmd_st is changed from 0 to 1. In addition, the software must write 1 to cmd_st after the cmd_clo bit is cleared."; };
            };

            field {
                name = "cmd_clo";
                desc = "BSY/DQR clear control. The software can forcibly clear the BSY and DRQ bits through this bit and transmit commands to the device.";
                sw = rw;
                hw = r;
                encode = SATA_PORT_CMD_cmd_clo_enum;
                reset = 0x0;
            } cmd_clo[3:3];

            enum SATA_PORT_CMD_cmd_sud_enum {
                WHEN_SATA_PORT = 0 { name = "When Sata Port"; desc = "When SATA_PORT_SCTL[det] is 0, the controller enters the listen mode."; };
                AFTER_SYSTEM_POWERED = 1 { name = "After System Powered"; desc = "After the system is powered on or the HBA is reset, the controller is enabled to transmit a COMRESET sequence to initialize the hardware device."; };
            };

            field {
                name = "cmd_sud";
                desc = "Spin-up device control.";
                sw = rw;
                hw = r;
                encode = SATA_PORT_CMD_cmd_sud_enum;
                reset = 0x0;
            } cmd_sud[1:1];

            enum SATA_PORT_CMD_cmd_st_enum {
                CONTROLLER_ENTERS_IDLE = 0 { name = "Controller Enters Idle"; desc = "The controller enters the idle status."; };
                CONTROLLER_PROCESSES_COMMANDS = 1 { name = "Controller Processes Commands"; desc = "The controller processes the commands from slot 0 that are identified as valid slots by SATA_PORT_CI. Note: The cmd_st bit can be set to 1 only after cmd_fre is 1."; };
            };

            field {
                name = "cmd_st";
                desc = "Command list processing enable.";
                sw = rw;
                hw = r;
                encode = SATA_PORT_CMD_cmd_st_enum;
                reset = 0x0;
            } cmd_st[0:0];

        field {
            name = "reserved_nz";
            desc = "Reserved (RO); reads 1: the data sheet total reset value is 0x0020_0004 (not read on hardware).";
            sw = r;
            hw = w;
            reset = 0x1;
        } reserved_nz[2:2];
    } SATA_PORT_CMD @ 0x18;

        reg {
            name = "Port task file register";
            desc = "SATA_PORT_TFD is a port task file register.

Corresponds to the AHCI PxTFD register of the Advanced Host Controller Interface 1.2 (the data sheet uses its own names).

Data sheet 14.7.7 SATA_PORT_TFD (offset 0x20 + n x 0x80, printed page 14-118, `datasheet.txt` line 58346).";

            field {
                name = "tfd_err";
                desc = "Task file error. The controller updates this field after receiving a D2H register FIS, a PIO setup FIS, or an SDB FIS.";
                sw = r;
                hw = w;
                reset = 0x0;
            } tfd_err[15:8];

            field {
                name = "tfd_sts";
                desc = "Task file status. bit[7]: BSY bit, the device is busy. bit[6:4]: meaning varies according to commands. bit[3]: DRQ bit, there is data to be transferred in the device. bit[2:1]: meaning varies according to commands. bit[0]: ERR bit, an error occurred during the data transfer. The controller updates this field after receiving a D2H register FIS, a PIO setup FIS or an SDB FIS.";
                sw = r;
                hw = w;
                reset = 0x7F;
            } tfd_sts[7:0];
        } SATA_PORT_TFD @ 0x20;

        reg {
            name = "Port signature register";
            desc = "SATA_PORT_SIG is a port signature register.

Corresponds to the AHCI PxSIG register of the Advanced Host Controller Interface 1.2 (the data sheet uses its own names).

Data sheet 14.7.7 SATA_PORT_SIG (offset 0x24 + n x 0x80, printed page 14-119, `datasheet.txt` line 58400).";

            field {
                name = "signature";
                desc = "LBA address and sector addressing. The allocated addresses are as follows: bit[31:24]: LBA upper-bit address bit[23:16]: LBA middle-bit address bit[15:8]: LBA lower-bit address bit[7:0]: number of sectors The controller updates this register when receiving the first D2H register FIS after the hardware device is reset.";
                sw = r;
                hw = w;
                reset = 0xFFFFFFFF;
            } signature[31:0];
        } SATA_PORT_SIG @ 0x24;

        reg {
            name = "Port status register";
            desc = "SATA_PORT_SSTS is a port status register.

Corresponds to the AHCI PxSSTS register of the Advanced Host Controller Interface 1.2 (the data sheet uses its own names).

