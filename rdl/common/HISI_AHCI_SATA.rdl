                sw = rw;
                hw = r;
                encode = SATA_PORT_CMD_cmd_atapi_enum;
                reset = 0x0;
            } cmd_atapi[24:24];

            field {
                name = "cmd_esp";
                desc = "Fixed at 1, indicating that the external SATA device is supported.";
                sw = r;
                hw = na;
                reset = 0x1;
            } cmd_esp[21:21];

            enum SATA_PORT_CMD_cmd_pma_enum {
                NO_PORT_MULTIPLIER = 0 { name = "No Port Multiplier"; desc = "No port multiplier is connected to the port."; };
                PORT_MULTIPLIER_CONNECTED = 1 { name = "Port Multiplier Connected"; desc = "A port multiplier is connected to the port."; };
            };

            field {
                name = "cmd_pma";
