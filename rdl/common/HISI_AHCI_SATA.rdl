            };

            field {
                name = "pxsntf_pmn";
                desc = "Async notification event status. If the controller receives an SDB FIS from the device on the PM port and the N bit of this FIS is 1, the controller sets the bit of this register corresponding to this port number to 1. The following describes the meaning of each bit by taking bit[3] as an example:";
                sw = rw;
