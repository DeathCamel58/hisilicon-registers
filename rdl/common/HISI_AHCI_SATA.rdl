    regfile {
        name = "SATA port registers";
        desc = "Per-port AHCI port registers and HiSilicon port test/PHY registers. Port n is at 0x100 + n x 0x80.";


        reg {
            name = "Command list base address register";
            desc = "SATA_PORT_CLB is a command list base address register.

Corresponds to the AHCI PxCLB register of the Advanced Host Controller Interface 1.2 (the data sheet uses its own names).

Data sheet 14.7.7 SATA_PORT_CLB (offset 0x0 + n x 0x80, printed page 14-112, `datasheet.txt` line 57990).";

            field {
                name = "port_clb";
                desc = "Base address for storing the port command list in the memory. Resetting the SATA controller through SATA_GHC_GHC[hab_rst] has no effect on this field.";
                sw = rw;
                hw = r;
                reset = 0x0;
            } port_clb[31:10];
        } SATA_PORT_CLB @ 0x0;

        reg {
            name = "Receive FIS base address register";
            desc = "SATA_PORT_FB is a receive FIS base address register.

Corresponds to the AHCI PxFB register of the Advanced Host Controller Interface 1.2 (the data sheet uses its own names).

Data sheet 14.7.7 SATA_PORT_FB (offset 0x8 + n x 0x80, printed page 14-112, `datasheet.txt` line 58011).";

            field {
                name = "port_fb";
                desc = "Base address in the memory for storing the frames received through the port. Resetting the SATA controller through SATA_GHC_GHC[hab_rst] has no effect on this field.";
                sw = rw;
                hw = r;
                reset = 0x0;
            } port_fb[31:8];
        } SATA_PORT_FB @ 0x8;

        reg {
            name = "Port interrupt status register";
            desc = "SATA_PORT_IS is a port interrupt status register.

Corresponds to the AHCI PxIS register of the Advanced Host Controller Interface 1.2 (the data sheet uses its own names).

Data sheet 14.7.7 SATA_PORT_IS (offset 0x10 + n x 0x80, printed page 14-113, `datasheet.txt` line 58044).";

            enum SATA_PORT_IS_pxis_tfes_enum {
                VALUE_SATA_PORT = 0 { name = "Value Sata Port"; desc = "The value of SATA_PORT_TFD bit[0] is not 1."; };
                VALUE_SATA_PORT_2 = 1 { name = "Value Sata Port 2"; desc = "The value of SATA_PORT_TFD bit[0] is 1."; };
            };

            field {
                name = "pxis_tfes";
                desc = "Task file data (TFD) error interrupt status.";
                sw = rw;
                hw = w;
                onwrite = woclr;
                encode = SATA_PORT_IS_pxis_tfes_enum;
                reset = 0x0;
            } pxis_tfes[30:30];

            enum SATA_PORT_IS_pxis_hbds_enum {
                DMAC_ACCESSES_MEMORY = 0 { name = "Dmac Accesses Memory"; desc = "The DMAC accesses the memory properly."; };
                ERROR_OCCURS_WHEN = 1 { name = "Error Occurs When"; desc = "An error occurs when the DMAC accesses the memory."; };
            };

            field {
                name = "pxis_hbds";
                desc = "Internal bus error interrupt.";
                sw = rw;
                hw = w;
                onwrite = woclr;
                encode = SATA_PORT_IS_pxis_hbds_enum;
                reset = 0x0;
            } pxis_hbds[28:28];

            enum SATA_PORT_IS_pxis_ifs_enum {
                NO_ERROR_OCCURS = 0 { name = "No Error Occurs"; desc = "No error occurs during the data frame transfer."; };
                ERROR_OCCURS_DURING = 1 { name = "Error Occurs During"; desc = "An error occurs during the data frame transfer."; };
            };

            field {
                name = "pxis_ifs";
                desc = "Fatal error interrupt status.";
                sw = rw;
                hw = w;
                onwrite = woclr;
                encode = SATA_PORT_IS_pxis_ifs_enum;
                reset = 0x0;
            } pxis_ifs[27:27];

            enum SATA_PORT_IS_pxis_infs_enum {
