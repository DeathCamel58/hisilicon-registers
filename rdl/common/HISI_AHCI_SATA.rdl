        reg {
            name = "Port command and status register";
            desc = "SATA_PORT_CMD is a port command and status register.

Corresponds to the AHCI PxCMD register of the Advanced Host Controller Interface 1.2 (the data sheet uses its own names).

The data sheet total reset value is 0x0020_0004: the reset bit table has bit 2 set in a position the data sheet lists as reserved (read-only), modelled as the read-only field reserved_nz (reset 1) so that the register reset equals the data sheet total.

Data sheet 14.7.7 SATA_PORT_CMD (offset 0x18 + n x 0x80, printed page 14-116, `datasheet.txt` line 58222).";

            enum SATA_PORT_CMD_cmd_icc_enum {
                NO_OPERATION_IT = 0 { name = "No Operation It"; desc = "No operation. It indicates that the next port status request is allowed."; };
                REQUEST_ENABLE_PORT = 1 { name = "Request Enable Port"; desc = "Request to enable the port to be in the active status."; };
                REQUEST_ENABLE_PORT_2 = 2 { name = "Request Enable Port 2"; desc = "Request to enable the port to be in the partial status."; };
                REQUEST_ENABLE_PORT_3 = 6 { name = "Request Enable Port 3"; desc = "Request to enable the port to be in the slumber status. Other values: reserved When the software writes any of the preceding values rather than the reserved value, the controller clears the cmd_icc bit after performing related operations. When the software requests the current status of the port, the controller clears the cmd_icc bit directly. If the software requests the port status change from a low-power status to another low-power status, such as from the partial status to the slumber status, it needs to request the status change from the partial status to the active status, and then to the slumber status."; };
            };

            field {
                name = "cmd_icc";
                desc = "Port communication control signal.";
                sw = rw;
                hw = r;
                encode = SATA_PORT_CMD_cmd_icc_enum;
                reset = 0x0;
            } cmd_icc[31:28];

            enum SATA_PORT_CMD_cmd_asp_enum {
                PROACTIVELY_ENTER_PARTIAL = 0 { name = "Proactively Enter Partial"; desc = "proactively enter the partial status."; };
                PROACTIVELY_ENTER_SLUMBER = 1 { name = "Proactively Enter Slumber"; desc = "proactively enter the slumber status."; };
            };

            field {
                name = "cmd_asp";
                desc = "Slumber or partial status select for power management.";
                sw = rw;
                hw = r;
                encode = SATA_PORT_CMD_cmd_asp_enum;
                reset = 0x0;
            } cmd_asp[27:27];

            enum SATA_PORT_CMD_cmd_alpe_enum {
                DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
                ENABLED_IF_SATA = 1 { name = "Enabled If Sata"; desc = "enabled If SATA_PORT_CI and SATA_PORT_SACT are cleared, the controller enters the power-management status automatically. To be specific, if cmd_asp is 1, the controller enters the partial status; if cmd_asp is 0, the controller enters the slumber status."; };
            };

            field {
                name = "cmd_alpe";
                desc = "Automatic power management enable.";
                sw = rw;
                hw = r;
                encode = SATA_PORT_CMD_cmd_alpe_enum;
                reset = 0x0;
            } cmd_alpe[26:26];

            enum SATA_PORT_CMD_cmd_dlae_enum {
                LED_PIN_CAN = 0 { name = "Led Pin Can"; desc = "The LED pin can be driven when cmd_atapi is 0 and commands are being executed."; };
                LED_PIN_CAN_2 = 1 { name = "Led Pin Can 2"; desc = "The LED pin can be driven when commands are being executed."; };
            };

            field {
                name = "cmd_dlae";
                desc = "LED drive enable in ATAPI mode.";
                sw = rw;
                hw = r;
                encode = SATA_PORT_CMD_cmd_dlae_enum;
                reset = 0x0;
            } cmd_dlae[25:25];

            enum SATA_PORT_CMD_cmd_atapi_enum {
                CURRENT_DEVICE_NOT = 0 { name = "Current Device Not"; desc = "The current device is not an ATAPI device."; };
                CURRENT_DEVICE_ATAPI = 1 { name = "Current Device Atapi"; desc = "The current device is an ATAPI device."; };
            };

            field {
                name = "cmd_atapi";
