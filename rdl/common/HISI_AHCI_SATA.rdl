`ifndef HISI_AHCI_SATA_RDL
`define HISI_AHCI_SATA_RDL

// Number of SATA ports (PORT array size): 2 on Hi3520D/Hi3515A, 1 on Hi3515C (defines.rdl: HISI_SATA_NPORTS).
`ifndef HISI_SATA_NPORTS
`define HISI_SATA_NPORTS 2
`endif
// HISI_SATA_G1 (defines.rdl of the Hi3515 V100): first-generation variant of the same controller (Hi3515 data sheet chapter 9): no PHY1 registers (0x60-0x68 reserved),
// different reset values of CAP1.np, PHY0_CTLH, PORT_SSTS, PORT_FIFOTH (no vendor bypass bits) and PORT_LINK. Not defined = Hi3520D / Hi3515A / Hi3515C layout.

regfile eHISI_AHCI_SATA {
    name = "HiSilicon AHCI 1.2 SATA host controller";
    desc = "
    SATA 2.5 host controller (1.5 / 3.0 Gbit/s, NCQ, port multiplier, eSATA, command completion coalescing) with an AHB slave (registers) and an AHB master (command list
    and data DMA) interface. It implements the Advanced Host Controller Interface 1.2 register set: the generic host control registers (`SATA_GHC_*`) at 0x00-0x28 and one 0x80-byte
    port register block per port at 0x100 + n x 0x80 (`PORT[n]`, 2 ports on Hi3520D/Hi3515A, 1 port on Hi3515C). HiSilicon adds PHY control registers between the generic
    registers (0x50-0x6C: test status `SATA_GHC_TM`, PHY0/PHY1 control, PHY0 status, OOB control) and in every port block (0x44 FIFO threshold, 0x50-0x78 link/DMA test status and
    `SATA_PORT_PHYCTL` / `SATA_PORT_PHYSTS`). Linux drives it with the standard `ahci` platform driver plus the HiSilicon glue in `drivers/ata/ahci_sys.c`
    (`ahci_sys_hi3520d_defconfig.c`).

    **Hi3515 V100** (`HISI_SATA_G1`): the same controller and register map (Hi3515 data sheet issue 02 chapter 9, `hi3515v100--Hi3515-Datasheet.txt` lines 42355-44456, two ports at 0x100 / 0x180,
    base 0x10110000 from the memory map (Table 1-x line 8029; the chapter's own tables print 'base address 0x5202_0000' / '0x5202_0100', a copy-paste from another product), VIC interrupt 9),
    checked register by register against this file: the generic, PHY0, OOB and port registers agree in offsets, fields, accesses and resets except: `SATA_GHC_CAP1.np` resets 0x03 (text: 'up to two ports'),
    `SATA_GHC_PI` total reset is printed 0x0000_000F with the same two `port_imp` bits (the extra bits 3:2 are not explained: DS inconsistency), `SATA_PHY0_CTLL` bit 1 is 'reserved' (reset 1, as `fast_tech` here),
    `SATA_PHY0_CTLH` resets 0x2125 (bit 2 of the reserved field 3:2 is 1), `SATA_PHY1_CTLL` / `SATA_PHY1_CTLH` do not exist (0x60-0x68 reserved; one PHY control set for both lanes), `SATA_PORT_SSTS` resets 0x100
    (`pxssts_ipm` = 1), `SATA_PORT_FIFOTH` resets 0x10C (bits 31:9 reserved, no vendor bypass bits; `dmac_rxfifo_th` 0x10, `rxfifo_th_sel` 1) and `SATA_PORT_LINK` resets 0x0320_2020 (`link_curr_st` = 3).
    Its resets and clock gates are SYS_CTRL SC_PERCTRL10 (`sata_phyrst`, `sata_tx0/1_rst`, `sata_rx0/1_rst`, `sata_alive_rst`, bits 19-24) and SC_PEREN/SC_PERDIS. English data sheet only; not hardware verified.

    Interrupt: GIC interrupt ID 52 (SPI 20, DS Table 3-16). Clock gate, resets and reference clock select: PERI_CRG45 (sata_cken, sata0_cken, sata1_cken, sata_clk_sel, cko_alive_cksel and the
    seven reset bits); the SATA PHY analog options are in SYS_CTRL PERIPHCTRL3 (`sata_phy0_mpll_ss_sel`, `sata_phy0_ref_clk_sel`) and PERIPHCTRL25 (`sata_test_*`).

    **Bring-up sequence of the vendor driver** (`hi_sata_init`, `ahci_sys.c`, equal to data sheet 14.7.5.4): enable the clocks (PERI_CRG45 bits 10:8), clear `sata_clk_sel` and
    `cko_alive_cksel` (150 MHz CRG reference clock) and write 0x3F24 to `PORT[i].SATA_PORT_FIFOTH`, deassert `hrst_sata_s`, then `rst_sataphy_s`; set `mpll_ck_off` (bit 12) in
    SATA_PHY0_CTLH/PHY1_CTLH; write SATA_PHY0_CTLL/PHY1_CTLL (0x880EC788 for 1.5G or 0x880EC888 for 3G), SATA_PHY0_CTLH/PHY1_CTLH = 0x2521, SATA_OOB_CTL = 0x84060C15 and
    `SATA_PORT_PHYCTL` of every port; pulse `rst_sataphy_s`, then deassert the controller, tx, rx and alive resets.

    Source: Hi3520D/Hi3515A/Hi3515C data sheet issue 07, section 14.7 (printed pages 14-93 .. 14-135, `datasheet.txt` lines 56960-59404); 14.7.6 register summary Tables 14-13 / 14-14.
    Registers, fields, accesses and resets were extracted programmatically from the data sheet text, enum members from the description column. Extra items from the vendor driver
    sources (`sources/linux-vendor-3.0/drivers/ata/ahci_sys*.c`, `arch/arm/configs/hi3520d_*_defconfig`) are marked 'vendor-only' in their descriptions. Not hardware verified.

    !!! NOTE
        The AHCI standard registers `CLBU` (0x04) / `FBU` (0x0C), `EM_LOC` / `EM_CTL` (0x1C / 0x20) are not described in the data sheet (64-bit addressing and enclosure management are
        reported as not supported in `SATA_GHC_CAP1`); the data sheet summary table (Table 14-13) only lists the registers modelled here. The data sheet text of `SATA_GHC_PI` says
        'four ports' (copy-paste); `port_imp` has two valid bits.
    ";

    reg {
        name = "Feature support register 1";
        desc = "SATA_GHC_CAP1 is feature support register 1.

Corresponds to the AHCI HBA CAP register of the Advanced Host Controller Interface 1.2 (the data sheet uses its own names).

Data sheet 14.7.7 SATA_GHC_CAP1 (offset 0x0, printed page 14-101, `datasheet.txt` line 57364).";

        field {
            name = "s64a";
            desc = "Fixed at 0, indicating that the 64-bit data structure cannot be accessed.";
            sw = r;
            hw = na;
            reset = 0x0;
        } s64a[31:31];

        field {
            name = "sncq";
            desc = "Fixed at 1, indicating that NCQ is supported.";
            sw = r;
            hw = na;
            reset = 0x1;
        } sncq[30:30];

        field {
            name = "ssntf";
            desc = "Fixed at 1, indicating that the port SNTF register is supported.";
            sw = r;
            hw = na;
            reset = 0x1;
        } ssntf[29:29];

        field {
            name = "smps";
            desc = "Fixed at 0, indicating that mechanical hot-plugging is not supported.";
            sw = r;
            hw = na;
            reset = 0x0;
        } smps[28:28];

        field {
            name = "sss";
            desc = "Fixed at 1, indicating that staggered spin-up is supported.";
            sw = r;
            hw = na;
            reset = 0x1;
        } sss[27:27];

        field {
            name = "salp";
            desc = "Fixed at 1, indicating that power supply management is supported.";
            sw = r;
            hw = na;
            reset = 0x1;
        } salp[26:26];

        field {
            name = "sal";
            desc = "Fixed at 1, indicating that the LED pin is supported.";
            sw = r;
            hw = na;
            reset = 0x1;
        } sal[25:25];

        field {
            name = "sclo";
            desc = "Fixed at 1, indicating that command linked list override is supported.";
            sw = r;
            hw = na;
            reset = 0x1;
        } sclo[24:24];

        field {
            name = "iss";
            desc = "Fixed at 0x2, indicating that the maximum rate of 3 Gbit/s is supported.";
            sw = r;
            hw = na;
            reset = 0x2;
        } iss[23:20];

        field {
            name = "sam";
            desc = "Fixed at 1, indicating that only the AHCI mode is supported.";
            sw = r;
            hw = na;
            reset = 0x1;
        } sam[18:18];

        field {
            name = "spm";
            desc = "Fixed at 1, indicating that the port multiplier is supported.";
            sw = r;
            hw = na;
            reset = 0x1;
        } spm[17:17];

        field {
            name = "fbss";
            desc = "Fixed at 0, indicating that FIS-based switching is not supported.";
            sw = r;
            hw = na;
            reset = 0x0;
        } fbss[16:16];

        field {
            name = "pmd";
            desc = "Fixed at 1, indicating that multiple DRQ blocks cannot be transferred in PIO mode.";
            sw = r;
            hw = na;
            reset = 0x1;
        } pmd[15:15];

        field {
            name = "ssc";
            desc = "Fixed at 1, indicating that the transition to the slumber status is supported.";
            sw = r;
            hw = na;
            reset = 0x1;
        } ssc[14:14];

        field {
            name = "psc";
            desc = "Fixed at 1, indicating that the transition to the partial status is supported.";
            sw = r;
            hw = na;
            reset = 0x1;
        } psc[13:13];

        field {
            name = "ncs";
            desc = "Fixed at 0x1F, indicating that 32 command slots are supported.";
            sw = r;
            hw = na;
            reset = 0x1F;
        } ncs[12:8];

        field {
            name = "cccs";
            desc = "Fixed at 1, indicating that the CCC function is supported.";
            sw = r;
            hw = na;
            reset = 0x1;
        } cccs[7:7];

        field {
            name = "ems";
            desc = "Fixed at 0, indicating that enclose management is not supported.";
            sw = r;
            hw = na;
            reset = 0x0;
        } ems[6:6];

        field {
            name = "sxs";
            desc = "Fixed at 1, indicating that the external SATA interface is supported.";
            sw = r;
            hw = na;
            reset = 0x1;
        } sxs[5:5];

        field {
            name = "np";
            desc = "Fixed at 0x01, indicating that a maximum of two ports are supported. (Hi3515 V100, HISI_SATA_G1: 'Fixed at 0x03, it indicates that up to two ports are supported', data sheet line 42544: the AHCI meaning of 0x03 is four ports; DS inconsistency, value kept as printed.)";
            sw = r;
            hw = na;
`ifdef HISI_SATA_G1
            reset = 0x3;
`else
            reset = 0x1;
`endif
        } np[4:0];
    } SATA_GHC_CAP1 @ 0x0;

    reg {
        name = "Global control register";
        desc = "SATA_GHC_GHC is a global control register.

Corresponds to the AHCI GHC register of the Advanced Host Controller Interface 1.2 (the data sheet uses its own names).

Data sheet 14.7.7 SATA_GHC_GHC (offset 0x4, printed page 14-102, `datasheet.txt` line 57434).";

        field {
            name = "ahci_en";
            desc = "Fixed at 1, indicating that the software can interact with the controller only through the AHCI mechanism.";
            sw = r;
            hw = na;
            reset = 0x1;
        } ahci_en[31:31];

        enum SATA_GHC_GHC_int_enable_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "int_enable";
            desc = "Controller interrupt enable.";
            sw = rw;
            hw = r;
            encode = SATA_GHC_GHC_int_enable_enum;
            reset = 0x0;
        } int_enable[1:1];

        enum SATA_GHC_GHC_hba_rst_enum {
            NOT_RESET = 0 { name = "Not Reset"; desc = "not reset"; };
            RESET_WRITING_1 = 1 { name = "Reset Writing 1"; desc = "reset Writing 1 resets the controller and this bit is automatically cleared after reset; writing 0 has no effect. In addition, reset has no effect on the registers SATA_GHC_BOHC, SATA_PORT_FB, and SATA_PORT_CLB."; };
        };

        field {
            name = "hba_rst";
            desc = "Soft reset control for the controller.";
            sw = rw;
            hw = r;
            encode = SATA_GHC_GHC_hba_rst_enum;
            reset = 0x0;
        } hba_rst[0:0];
    } SATA_GHC_GHC @ 0x4;

    reg {
        name = "Interrupt status register";
        desc = "SATA_GHC_IS is an interrupt status register.

Corresponds to the AHCI IS register of the Advanced Host Controller Interface 1.2 (the data sheet uses its own names).

Data sheet 14.7.7 SATA_GHC_IS (offset 0x8, printed page 14-103, `datasheet.txt` line 57479).";

        enum SATA_GHC_IS_ips_ccc_enum {
            NO_CCC_INTERRUPT = 0 { name = "No Ccc Interrupt"; desc = "No CCC interrupt is generated."; };
            CCC_INTERRUPT_GENERATED = 1 { name = "Ccc Interrupt Generated"; desc = "A CCC interrupt is generated."; };
        };

        field {
            name = "ips_ccc";
            desc = "CCC interrupt status.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            encode = SATA_GHC_IS_ips_ccc_enum;
            reset = 0x0;
        } ips_ccc[31:31];

        enum SATA_GHC_IS_ips_port1_enum {
            NO_INTERRUPT_REPORTED = 0 { name = "No Interrupt Reported"; desc = "No interrupt is reported."; };
            INTERRUPT_REPORTED = 1 { name = "Interrupt Reported"; desc = "An interrupt is reported."; };
        };

        field {
            name = "ips_port1";
            desc = "Interrupt status of port 1.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            encode = SATA_GHC_IS_ips_port1_enum;
            reset = 0x0;
        } ips_port1[1:1];

        enum SATA_GHC_IS_ips_port0_enum {
            NO_INTERRUPT_REPORTED = 0 { name = "No Interrupt Reported"; desc = "No interrupt is reported."; };
            INTERRUPT_REPORTED = 1 { name = "Interrupt Reported"; desc = "An interrupt is reported."; };
        };

        field {
            name = "ips_port0";
            desc = "Interrupt status of port 0.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            encode = SATA_GHC_IS_ips_port0_enum;
            reset = 0x0;
        } ips_port0[0:0];
    } SATA_GHC_IS @ 0x8;

    reg {
        name = "Port implementation register";
        desc = "SATA_GHC_PI is a port implementation register.

Corresponds to the AHCI PI register of the Advanced Host Controller Interface 1.2 (the data sheet uses its own names). On the Hi3515C (one SATA port, `Differences Between the Hi3515C and the Hi3520D`, Table 1-1) the data sheet gives no separate reset value; the 0x3 shown is the Hi3520D/Hi3515A value (two ports) and the port array below has one element on the Hi3515C.

Hi3515 V100 (HISI_SATA_G1, data sheet 9.7.1 line 42644): the total reset value is printed 0x0000_000F while the field table has the same two `port_imp` bits (reset 0x3) and bits 31:2 reserved; modelled as on the Hi3520D.

Data sheet 14.7.7 SATA_GHC_PI (offset 0xC, printed page 14-104, `datasheet.txt` line 57518).";

        enum SATA_GHC_PI_port_imp_enum {
            PORTS_INVALID = 0 { name = "Ports Invalid"; desc = "The ports are invalid."; };
            PORTS_VALID = 1 { name = "Ports Valid"; desc = "The ports are valid."; };
        };

        field {
            name = "port_imp";
            desc = "Port validity indication. If the value is 0x3, the four ports, port 0 to port 1, are valid. The bits, bit[1] to bit[0], map to port 1 to port 0 respectively.";
            sw = r;
            hw = w;
            encode = SATA_GHC_PI_port_imp_enum;
            reset = 0x3;
        } port_imp[1:0];
    } SATA_GHC_PI @ 0xC;

    reg {
        name = "AHCI version identifier register";
        desc = "SATA_GHC_VS is an AHCI version identifier register.

Corresponds to the AHCI VS register of the Advanced Host Controller Interface 1.2 (the data sheet uses its own names).

Data sheet 14.7.7 SATA_GHC_VS (offset 0x10, printed page 14-104, `datasheet.txt` line 57545).";

        field {
            name = "achi_vs";  // sic: the Hi3520D data sheet spells the field 'achi_vs' (the Hi3515 data sheet: ahci_vs)
            desc = "The supported AHCI version is V1.2.";
            sw = r;
            hw = w;
            reset = 0x00010200;
        } achi_vs[31:0];
    } SATA_GHC_VS @ 0x10;

    reg {
        name = "CCC control register";
        desc = "SATA_GHC_CCC_CTL is a CCC control register.

Corresponds to the AHCI CCC_CTL register of the Advanced Host Controller Interface 1.2 (the data sheet uses its own names).

Data sheet 14.7.7 SATA_GHC_CCC_CTL (offset 0x14, printed page 14-105, `datasheet.txt` line 57574).";

        field {
            name = "ccc_tv";
            desc = "CCC timeout parameter, in the unit of ms. When the CCC function is enabled, the timeout counter loads this parameter value. If a command is executed on a port involved in CCC counting, the counter decreases by 1 every 1 ms until a CCC interrupt is generated when the counter reaches 0. Then the counter reloads the parameter value for the next counting. Note that these bits cannot be set to 0s.";
            sw = rw;
            hw = r;
            reset = 0x1;
        } ccc_tv[31:16];

        field {
            name = "ccc_cc";
            desc = "CCC command completion upper limit. When the CCC function is enabled, the counter is cleared after commands are executed. Then the counter starts to count the number of completed commands on the ports involved in CCC counting. If the count value is greater than or equal to the parameter value, a CCC interrupt is generated. In this case, the counter is cleared again for the next counting. If the value 0 is written, the command completion interrupt is disabled and the CCC interrupt is generated only after timeout.";
            sw = rw;
            hw = r;
            reset = 0x1;
        } ccc_cc[15:8];

        field {
            name = "ccc_int";
            desc = "CCC interrupt vector ID. If the value is 0x1F (31), SATA_GHC_IS bit[31] indicates the CCC interrupt status.";
            sw = r;
            hw = w;
            reset = 0x1F;
        } ccc_int[7:3];

        enum SATA_GHC_CCC_CTL_ccc_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED_WHEN_CCC = 1 { name = "Enabled When Ccc"; desc = "enabled When the CCC function is enabled, the values of ccc_tv and ccc_cc cannot be changed."; };
        };

        field {
            name = "ccc_en";
            desc = "CCC function enable.";
            sw = rw;
            hw = r;
            encode = SATA_GHC_CCC_CTL_ccc_en_enum;
            reset = 0x0;
        } ccc_en[0:0];
    } SATA_GHC_CCC_CTL @ 0x14;

    reg {
        name = "CCC port enable register";
        desc = "SATA_GHC_CCC_PORTS is a CCC port enable register.

Corresponds to the AHCI CCC_PORTS register of the Advanced Host Controller Interface 1.2 (the data sheet uses its own names).

Data sheet 14.7.7 SATA_GHC_CCC_PORTS (offset 0x18, printed page 14-106, `datasheet.txt` line 57630).";

        field {
            name = "ccc_prt";
            desc = "Specifies the port that is involved in CCC counting. Bit[1] to bit[0] map to port 1 to port 0 respectively. If the related bit is 1, the port is involved in CCC counting. If the related bit is 0. The port is not involved in CCC counting. The value of this register can be changed at any time and the changed value takes effect immediately.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } ccc_prt[1:0];
    } SATA_GHC_CCC_PORTS @ 0x18;

    reg {
        name = "Feature support register 2";
        desc = "SATA_GHC_CAP2 is feature support register 2.

Corresponds to the AHCI CAP2 register of the Advanced Host Controller Interface 1.2 (the data sheet uses its own names).

Data sheet 14.7.7 SATA_GHC_CAP2 (offset 0x24, printed page 14-106, `datasheet.txt` line 57655).";

        field {
            name = "cap_boh";
            desc = "Fixed at 1, indicating that BIOS/OS handoff control is supported.";
            sw = r;
            hw = na;
            reset = 0x1;
        } cap_boh[0:0];
    } SATA_GHC_CAP2 @ 0x24;

    reg {
        name = "BIOS/OS handoff control register";
        desc = "SATA_GHC_BOHC is a BIOS/OS handoff control register.

Corresponds to the AHCI BOHC register of the Advanced Host Controller Interface 1.2 (the data sheet uses its own names).

Data sheet 14.7.7 SATA_GHC_BOHC (offset 0x28, printed page 14-107, `datasheet.txt` line 57689).";

        enum SATA_GHC_BOHC_bohc_bb_enum {
            BIOS_NOT_BUSY = 0 { name = "Bios Not Busy"; desc = "The BIOS is not busy."; };
            BIOS_BUSY_PERFORMING = 1 { name = "Bios Busy Performing"; desc = "The BIOS is busy in performing certain operations and is ready to hand the control permission off to the OS."; };
        };

        field {
            name = "bohc_bb";
            desc = "BIOS status indication.";
            sw = rw;
            hw = r;
            encode = SATA_GHC_BOHC_bohc_bb_enum;
            reset = 0x0;
        } bohc_bb[4:4];

        field {
            name = "bohc_ooc";
            desc = "When the value of bohc_oos is changed from 0 to 1, this bit is fixed at 1. Writing 1 clears this bit and writing 0 has no effect.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            reset = 0x0;
        } bohc_ooc[3:3];

        enum SATA_GHC_BOHC_bohc_sooe_enum {
            NO_MESSAGE_INTERRUPT = 0 { name = "No Message Interrupt"; desc = "No message interrupt is generated."; };
            WHEN_BOHC_OOC = 1 { name = "When Bohc Ooc"; desc = "When bohc_ooc is set to 1, a message interrupt is generated."; };
        };

        field {
            name = "bohc_sooe";
            desc = "Message interrupt enable.";
            sw = rw;
            hw = r;
            encode = SATA_GHC_BOHC_bohc_sooe_enum;
            reset = 0x0;
        } bohc_sooe[2:2];

        enum SATA_GHC_BOHC_bohc_oos_enum {
            OS_DOES_NOT = 0 { name = "Os Does Not"; desc = "The OS does not apply for the control permission on the controller."; };
            OS_APPLIES_CONTROL = 1 { name = "Os Applies Control"; desc = "The OS applies for the control permission on the controller. If bohc_oos is 1 and bios_bos is 0, it indicates that the OS has obtained the control permission on the SATA controller. Resetting the SATA controller through SATA_GHC_GHC[hab_rst] has no effect on this bit."; };
        };

        field {
            name = "bohc_oos";
            desc = "Request applied by the OS for controlling the controller.";
            sw = rw;
            hw = r;
            encode = SATA_GHC_BOHC_bohc_oos_enum;
            reset = 0x0;
        } bohc_oos[1:1];

        enum SATA_GHC_BOHC_bohc_bos_enum {
            BIOS_DOES_NOT = 0 { name = "Bios Does Not"; desc = "The BIOS does not have the control permission on the controller."; };
            BIOS_HAS_CONTROL = 1 { name = "Bios Has Control"; desc = "The BIOS has the control permission on the controller. If the OS applies for the control permission on the controller, the BIOS clears this bit. Resetting the SATA controller through SATA_GHC_GHC[hab_rst] has no effect on this bit."; };
        };

        field {
            name = "bohc_bos";
            desc = "Flag that indicates that the BIOS has the control permission on the controller.";
            sw = rw;
            hw = r;
            encode = SATA_GHC_BOHC_bohc_bos_enum;
            reset = 0x0;
        } bohc_bos[0:0];
    } SATA_GHC_BOHC @ 0x28;

    reg {
        name = "TM test status register";
        desc = "SATA_GHC_TM is a TM test status register.

Data sheet 14.7.7 SATA_GHC_TM (offset 0x50, printed page 14-108, `datasheet.txt` line 57750).";

        enum SATA_GHC_TM_req_sel_enum {
            TRANSMIT_DMAC_PORT = 0 { name = "Transmit Dmac Port"; desc = "transmit DMAC of port 0"; };
            RECEIVE_DMAC_PORT = 1 { name = "Receive Dmac Port"; desc = "receive DMAC of port 0"; };
            TRANSMIT_DMAC_PORT_2 = 2 { name = "Transmit Dmac Port 2"; desc = "transmit DMAC of port 1"; };
            RECEIVE_DMAC_PORT_2 = 3 { name = "Receive Dmac Port 2"; desc = "receive DMAC of port 1 Other values: reserved"; };
        };

        field {
            name = "req_sel";
            desc = "Current DMAC that has the right to use the AHB master.";
            sw = r;
            hw = w;
            encode = SATA_GHC_TM_req_sel_enum;
            reset = 0x0;
        } req_sel[2:0];
    } SATA_GHC_TM @ 0x50;

    reg {
        name = "PHY0 global status register for lower bits";
        desc = "SATA_PHY0_CTLL is a PHY0 global status register for lower bits.

Initialization values (DS 14.7.5.4 step 5, vendor `ahci_sys.c` / `CONFIG_HI_SATA_PHY0_CTLL_*_VAL`): 1.5 Gbit/s = 0x880EC788, 3 Gbit/s = 0x880EC888. Compared with the reset value 0x8D0EC88A the 3G value changes: mpll_ncy 0x6 -> 0x4, mpll_ncy5 0x2 -> 0x0, fast_tech 0x1 -> 0x0; the 1.5G value additionally differs from the 3G value in: los_lvl 0x11 -> 0xf. The vendor driver writes the same value to SATA_PHY1_CTLL.

Data sheet 14.7.7 SATA_PHY0_CTLL (offset 0x54, printed page 14-108, `datasheet.txt` line 57777).";

        enum SATA_PHY0_CTLL_mpll_prescale_enum {
            REF_CLK_USED = 0 { name = "Ref Clk Used"; desc = "ref_clk is used as it is."; };
            REF_CLK_MULTIPLIED = 1 { name = "Ref Clk Multiplied"; desc = "ref_clk is multiplied by 2."; };
            REF_CLK_DIVIDED = 2 { name = "Ref Clk Divided"; desc = "ref_clk is divided by 2."; };
            RESERVED = 3 { name = "Reserved"; desc = "reserved"; };
        };

        field {
            name = "mpll_prescale";
            desc = "When the reference clock is changed, this value also needs to be changed.";
            sw = rw;
            hw = r;
            encode = SATA_PHY0_CTLL_mpll_prescale_enum;
            reset = 0x2;
        } mpll_prescale[31:30];

        field {
            name = "mpll_ncy";
            desc = "Operating parameter of the internal MPLL of the PHY. This field needs to be used with mpll_ncy5 and indicates the used multiplier.";
            sw = rw;
            hw = r;
            reset = 0x6;
        } mpll_ncy[29:25];

        field {
            name = "mpll_ncy5";
            desc = "Operating parameter of the internal MPLL of the PHY. This field needs to be used with mpll_ncy and indicates the used multiplier.";
            sw = rw;
            hw = r;
            reset = 0x2;
        } mpll_ncy5[24:23];

        field {
            name = "mpll_int_ctl";
            desc = "Internal bandwidth control and select signal of the MPLL. This field must be set to 0b000.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } mpll_int_ctl[22:20];

        field {
            name = "mpll_prop_ctl";
            desc = "Internal proportional bandwidth control signal of the MPLL. This field must be set to 0b111 and can be written only when the register is reset or the MPLL is invalid.";
            sw = rw;
            hw = r;
            reset = 0x7;
        } mpll_prop_ctl[19:17];

        field {
            name = "tx_lvl";
            desc = "Transmit level parameter that is related to the selected SATA protocol. This field must be set to 0b01100.";
            sw = rw;
            hw = r;
            reset = 0xC;
        } tx_lvl[16:12];

        field {
            name = "los_lvl";
            desc = "LOS detection level control signal. This field must be set to 0b10001.";
            sw = rw;
            hw = r;
            reset = 0x11;
        } los_lvl[11:7];

        field {
            name = "acjt_lvl";
            desc = "ACJTAG receiver comparator level control signal. This field must be set to 0b00010.";
            sw = rw;
            hw = r;
            reset = 0x2;
        } acjt_lvl[6:2];

        field {
            name = "fast_tech";
            desc = "Signal that indicates that the IP is processed in a fast technology variant. This bit must be set to 0. (Hi3515 V100 data sheet: bit 1 'reserved', RO, same reset 1.)";
            sw = rw;
            hw = r;
            reset = 0x1;
        } fast_tech[1:1];

        field {
            name = "pddq_h";
            desc = "IDDQ test signal. To perform an IDDQ test, all the lanes and support blocks must be powered off before pddq_h is valid. In normal mode, this bit must be set to 0.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } pddq_h[0:0];
    } SATA_PHY0_CTLL @ 0x54;

    reg {
        name = "PHY0 global register for upper bits";
        desc = "SATA_PHY0_CTLH is a PHY0 global register for upper bits.

The data sheet initialization (DS 14.7.5.4 step 6) writes 0x2121 (= the reset value) after setting bit 12 (`mpll_ck_off`, `HI_SATA_DIS_CLK` in the vendor driver) to disable the provided PHY reference clock (step 4). The vendor driver (`CONFIG_HI_SATA_PHYX_CTLH_VAL`) writes 0x2521 to PHY0_CTLH and PHY1_CTLH, which differs from the reset value in: mpll_ss_en 0x0 -> 0x1. Bit 13 (`use_refclk_alt`) selects whether SREFCKM/SREFCKP come from inside the chip (1) or from an external clock source (0) (DS 14.7.5.2).

Data sheet 14.7.7 SATA_PHY0_CTLH (offset 0x58, printed page 14-109, `datasheet.txt` line 57846).";

        enum SATA_PHY0_CTLH_use_refclk_alt_enum {
            REFCLK_DIFFERENTIAL_SIGNALS = 0 { name = "Refclk Differential Signals"; desc = "refclk differential signals"; };
            REFCLK_ALT_DIFFERENTIAL = 1 { name = "Refclk Alt Differential"; desc = "refclk_alt differential signals"; };
        };

        field {
            name = "use_refclk_alt";
            desc = "PHY reference clock select.";
            sw = rw;
            hw = r;
            encode = SATA_PHY0_CTLH_use_refclk_alt_enum;
            reset = 0x1;
        } use_refclk_alt[13:13];

        field {
            name = "mpll_ck_off";
            desc = "Power-on control signal of the MPLL. Control this signal by conforming to the following rules: 1. Before providing refclk to the MPLL, set mpll_ck_off to 0. 2 Before setting mpll_ck_off to 0, set mpll_ncy, mpll_ncy5, and, pll_prescale to proper values. 3 If refclk is paused or switched or the values of mpll_ncy, mpll_ncy5, and mpll_prescale need to be changed, set mpll_ck_off to 1 first.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } mpll_ck_off[12:12];

        enum SATA_PHY0_CTLH_mpll_pwron_enum {
            CKO_WORD_CLOCK = 0 { name = "Cko Word Clock"; desc = "The cko_word clock is invalid."; };
            INTERNAL_MPLL_RESET = 1 { name = "Internal Mpll Reset"; desc = "The internal MPLL is reset and the cko_word clock signal is generated based on the frequency of refclk. Before the MPLL is disabled, tx_en must be OFF or in the CM status and rx_en and rx_pll_pwron must be set to 0."; };
        };

        field {
            name = "mpll_pwron";
            desc = "MPLL power-on.";
            sw = rw;
            hw = r;
            encode = SATA_PHY0_CTLH_mpll_pwron_enum;
            reset = 0x0;
        } mpll_pwron[11:11];

        enum SATA_PHY0_CTLH_mpll_ss_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED_IF_REFCLK = 1 { name = "Enabled If Refclk"; desc = "enabled If the refclk spectrum has been spread, this bit must be set to 0."; };
        };

        field {
            name = "mpll_ss_en";
            desc = "Spread spectrum enable signal.";
            sw = rw;
            hw = r;
            encode = SATA_PHY0_CTLH_mpll_ss_en_enum;
            reset = 0x0;
        } mpll_ss_en[10:10];

        field {
            name = "cko_word_con";
            desc = "cko_word output select signal.";
            sw = rw;
            hw = r;
            reset = 0x2;
        } cko_word_con[9:7];

        enum SATA_PHY0_CTLH_cko_alive_con_enum {
            INVALID = 0 { name = "Invalid"; desc = "invalid."; };
            RETAIN_OUTPUT_FREQUENCY = 1 { name = "Retain Output Frequency"; desc = "retain the output frequency of the prescaler."; };
            LOW_FREQUENCY_OUTPUT = 2 { name = "Low Frequency Output"; desc = "low-frequency output, that is, 1/16 of the prescaler."; };
            RESERVED = 3 { name = "Reserved"; desc = "reserved"; };
        };

        field {
            name = "cko_alive_con";
            desc = "cko_alive output signal select.";
            sw = rw;
            hw = r;
            encode = SATA_PHY0_CTLH_cko_alive_con_enum;
            reset = 0x1;
        } cko_alive_con[6:5];

        enum SATA_PHY0_CTLH_rtune_do_tune_enum {
            DO_NOT_TUNE = 0 { name = "Do Not Tune"; desc = "do not tune"; };
            RETUNE_RESISTOR = 1 { name = "Retune Resistor"; desc = "retune the resistor"; };
        };

        field {
            name = "rtune_do_tune";
            desc = "Resistor tune enable signal.";
            sw = rw;
            hw = r;
            encode = SATA_PHY0_CTLH_rtune_do_tune_enum;
            reset = 0x0;
        } rtune_do_tune[4:4];

`ifdef HISI_SATA_G1
        field {
            name = "reserved_nz";
            desc = "Reserved (RW in the Hi3515 data sheet, bits 3:2); bit 2 resets 1: the Hi3515 total reset value is 0x0000_2125 (Hi3520D: 0x2121). Hi3515 V100 only (HISI_SATA_G1).";
            sw = rw;
            hw = r;
            reset = 0x1;
        } reserved_nz[2:2];

`endif
        field {
            name = "reset_n";
            desc = "Reset signal. This signal must be retained for 5 ns at least.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } reset_n[1:1];

        enum SATA_PHY0_CTLH_wide_xface_enum {
            V_10_BITS = 0 { name = "V 10 Bits"; desc = "10 bits"; };
            V_20_BITS = 1 { name = "V 20 Bits"; desc = "20 bits"; };
        };

        field {
            name = "wide_xface";
            desc = "Interface bit width control signal.";
            sw = rw;
            hw = r;
            encode = SATA_PHY0_CTLH_wide_xface_enum;
            reset = 0x1;
        } wide_xface[0:0];
    } SATA_PHY0_CTLH @ 0x58;

    reg {
        name = "PHY0 global status register";
        desc = "SATA_PHY0_STS is a PHY0 global status register.

Data sheet 14.7.7 SATA_PHY0_STS (offset 0x5C, printed page 14-111, `datasheet.txt` line 57930).";

        field {
