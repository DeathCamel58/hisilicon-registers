                reset = 0x0;
            } pxsntf_pmn[15:0];
        } SATA_PORT_SNTF @ 0x3C;

        reg {
            name = "Receive FIFO threshold register";
            desc = "SATA_PORT_FIFOTH is a receive FIFO threshold register.

Bits 13:9 are 'reserved' in the data sheet (the DS still prints reset 0xF24, with bits 11:9 set) but the vendor driver `ahci_sys_hi3520d_defconfig.c` (`hi_sata_phy_clk_sel`) writes 0x3F24 to this register of every port with the comment that, due to bugs of the sata controller, specific values are set for both ports to bypass it: [13] data transmit control bypass, [12] record bypass, [11] port-multiplier reset bypass, [10] fetch bypass, [9] 'avoid Seagate rerror bug'. These five bits are added from the vendor driver (not in the data sheet); reset 0, 0, 1, 1, 1 follows the DS total reset 0xF24.

Hi3515 V100 (HISI_SATA_G1, data sheet 9.7.2 line 43875): bits 31:9 are plain reserved (reset 0, no vendor bypass bits: the Hi3515 vendor driver is not in the trees), total reset 0x0000_010C: `dmac_rxfifo_th` 0x10, `rxfifo_th_sel` 1, `link_rxfifo_th` 4.

Data sheet 14.7.7 SATA_PORT_FIFOTH (offset 0x44 + n x 0x80, printed page 14-125, `datasheet.txt` line 58718).";

`ifndef HISI_SATA_G1
            field {
                name = "bypass_dmac_tx_ctrl";
                desc = "Vendor-only (not in the data sheet): data transmit control bypass (written 1 by the vendor driver).";
                sw = rw;
                hw = r;
                reset = 0x0;
            } bypass_dmac_tx_ctrl[13:13];

            field {
                name = "bypass_record";
                desc = "Vendor-only (not in the data sheet): record bypass (written 1 by the vendor driver).";
                sw = rw;
                hw = r;
                reset = 0x0;
            } bypass_record[12:12];

            field {
                name = "bypass_pm_reset";
                desc = "Vendor-only (not in the data sheet): port multiplier reset bypass (written 1 by the vendor driver).";
                sw = rw;
                hw = r;
                reset = 0x1;
            } bypass_pm_reset[11:11];

            field {
                name = "bypass_fetch";
                desc = "Vendor-only (not in the data sheet): command fetch bypass (written 1 by the vendor driver).";
                sw = rw;
                hw = r;
                reset = 0x1;
            } bypass_fetch[10:10];

            field {
                name = "seagate_rerror_fix";
                desc = "Vendor-only (not in the data sheet): workaround for the 'Seagate rerror bug' (written 1 by the vendor driver).";
                sw = rw;
                hw = r;
                reset = 0x1;
            } seagate_rerror_fix[9:9];
`endif

            field {
                name = "dmac_rxfifo_th";
                desc = "Flow control threshold of the DMAC receive FIFO. During data reception, if the data amount in the DMAC FIFO is above the threshold, the controller starts to control the data flow.";
                sw = rw;
                hw = r;
`ifdef HISI_SATA_G1
                reset = 0x10;
`else
                reset = 0x12;
`endif
            } dmac_rxfifo_th[8:4];

            enum SATA_PORT_FIFOTH_rxfifo_th_sel_enum {
                FLOW_CONTROL_LINK = 0 { name = "Flow Control Link"; desc = "The flow control for the link receive FIFO is valid."; };
                FLOW_CONTROL_DMAC = 1 { name = "Flow Control Dmac"; desc = "The flow control for the DMAC receive FIFO is valid."; };
            };

            field {
                name = "rxfifo_th_sel";
                desc = "Flow control FIFO select.";
                sw = rw;
                hw = r;
                encode = SATA_PORT_FIFOTH_rxfifo_th_sel_enum;
`ifdef HISI_SATA_G1
                reset = 0x1;
`else
                reset = 0x0;
`endif
            } rxfifo_th_sel[3:3];

            field {
                name = "link_rxfifo_th";
                desc = "Flow control threshold of the link receive FIFO. During data reception, if the data amount in the DMAC FIFO is above the threshold, the controller starts to control the data flow.";
                sw = rw;
                hw = r;
                reset = 0x4;
            } link_rxfifo_th[2:0];
        } SATA_PORT_FIFOTH @ 0x44;

