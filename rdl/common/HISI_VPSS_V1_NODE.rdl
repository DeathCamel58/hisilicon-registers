            sw = rw;
            hw = r;
        } word[31:0];
    } COVER_W_28 @ 0x28;
};

regfile eHISI_VPSS_V1_NODE {
    name = "VPSS job node image (NOT A REGISTER FILE), Hi3518E V200 / Hi3516C V200";
    desc = "NOT A REGISTER FILE and NOT INSTANTIATED: layout of one VPSS job node (register image in DDR, linked list through NEXT) as written by the VPSS_HAL_Set* functions of hi3518e_vpss.ko (OpenIPC package, Hi3518EV200_MPP_V1.0.5.0; the Dahua Hi3518EV200 build V1.0.0.0 B010 Debug gives the same word set), described as a regfile only to document offsets. Link words: NODE_ID 0x1F4, MASK 0x1FC, NEXT 0x2FC, timeout 0x31C (same convention as eHISI_VPSS_V2_NODE of the Hi3516C V300). REVISION 2026-11-12 (round 6: the cover block 0x2604-0x262C is now an indexed record array COVER[8], stride 0x2C, after the arm-re engine showed its 44*idx index):  regenerated with the CFG-aware emulator scripts/tools/arm-emu (jump tables followed); the first version (linear pass) had wrong per-channel scaler block offsets (0x4040/0x6000/0x80C0) which are corrected here: scaler blocks are at 0x2000 + n*0x40 (n = channel 0..3, 7 words each). PROVENANCE for every word: offset and the clear-mask / shift constants are PROVEN (read from the load/store/bic/orr sequences of the named functions); extents are LOWER BOUNDS (computed shifts and widths are not followed); the function name suggests the role (INFERRED); words written from unfollowed values show no extent. Not hardware verified.";

    reg {
        name = "Node word at offset 0x0";
        desc = "Word 0x0 of the node image. Accessed by: OnLineVideoEn (read); OnLineVideoEn (write, clears 0x80000000, value ORed at bit shift 31); ScaleEn (read); ScaleEn (write, clears 0x43c, value ORed at bit shift 2/3/4/5); SetCoverCtrl (read); SetCoverCtrl (write). Provenance: offset PROVEN, listed masks/shifts PROVEN (lower bounds), role INFERRED from the function name, anything else UNKNOWN/GUESS.";
        field {
            name = "word";
            desc = "32-bit word (extents see the register description).";
            sw = rw;
            hw = r;
        } word[31:0];
    } NODE_W_0000 @ 0x0;

    reg {
        name = "Node word at offset 0x4";
        desc = "Word 0x4 of the node image. Accessed by: SetChnCrop (read); SetChnCrop (write, clears 0x1c, value ORed at bit shift 2/3/4); SetGrpCropAttr (read); SetGrpCropAttr (write, clears 0x3, value ORed at bit shift 0). Provenance: offset PROVEN, listed masks/shifts PROVEN (lower bounds), role INFERRED from the function name, anything else UNKNOWN/GUESS.";
        field {
            name = "word";
            desc = "32-bit word (extents see the register description).";
            sw = rw;
            hw = r;
        } word[31:0];
    } NODE_W_0004 @ 0x4;

    reg {
        name = "Node word at offset 0x8";
        desc = "Word 0x8 of the node image. Accessed by: NrRfrEn (read); NrRfrEn (write, clears 0x10, value ORed at bit shift 4); SetChnCtrl (read); SetChnCtrl (write, clears 0xf0000, value ORed at bit shift 16/17/18/19); SetChnEn (read); SetChnEn (write, clears 0xe, value ORed at bit shift 0/1/2/3); SetChnEn (write, clears 0xf, value ORed at bit shift 0/1/2/3); SetSrcImgType (read); SetSrcImgType (write, clears 0x100000, value ORed at bit shift 20). Provenance: offset PROVEN, listed masks/shifts PROVEN (lower bounds), role INFERRED from the function name, anything else UNKNOWN/GUESS.";
        field {
            name = "word";
            desc = "32-bit word (extents see the register description).";
            sw = rw;
            hw = r;
        } word[31:0];
    } NODE_W_0008 @ 0x8;

    reg {
        name = "Node word at offset 0xC";
        desc = "Word 0xC of the node image. Accessed by: NrRfrEn (read); NrRfrEn (write, clears 0x10, value ORed at bit shift 4); SetImgWorkType (read); SetImgWorkType (write, clears 0x6, value ORed at bit shift 1); SetVadSel (read); SetVadSel (write, clears 0x8, value ORed at bit shift 3). Provenance: offset PROVEN, listed masks/shifts PROVEN (lower bounds), role INFERRED from the function name, anything else UNKNOWN/GUESS.";
        field {
            name = "word";
            desc = "32-bit word (extents see the register description).";
            sw = rw;
            hw = r;
        } word[31:0];
    } NODE_W_000C @ 0xC;

    reg {
        name = "Node word at offset 0x10";
        desc = "Word 0x10 of the node image. Accessed by: ScaleRegup (read); ScaleRegup (write, clears 0x1e, value ORed at bit shift 1/2/3); ScaleRegup (write, clears 0x1e, value ORed at bit shift 1/2/4); ScaleRegup (write, clears 0x1e, value ORed at bit shift 1/3/4); ScaleRegup (write, clears 0x1e, value ORed at bit shift 2/3/4); SetRegup (read); SetRegup (write, clears 0x1, value ORed at bit shift 0). Provenance: offset PROVEN, listed masks/shifts PROVEN (lower bounds), role INFERRED from the function name, anything else UNKNOWN/GUESS.";
