regfile eHISI_VPSS_V1_COVER {
    name = "VPSS node cover-region record (11 words)";
    desc = "One cover/mask region record inside the VPSS node image of the Hi3518E V200, at node offset 0x2604 + idx * 44 (stride 44 bytes). Provenance: hi3518e_vpss.ko VPSS_HAL_SetCover (words 0..4) and VPSS_HAL_SetCover1 (words 5..10); the offsets and the index scaling 44*idx are PROVEN (arm-re path-sensitive static analysis of the index expression, re-run 2026-11-12; the older linear pass listed the 11 words of idx 0 only); the number of records is INFERRED as 8 from VPSS_HAL_SetCoverCtrl (node word 0x2600, bits 0..7 = per-region enable); word meanings INFERRED from the function names; not hardware verified.";

    reg {
        name = "Cover record word 0x0";
        desc = "Word at record offset 0x0 (node 0x2604 + idx*44). SetCover: R/W, clears 0xFFFFFF, three 8-bit values ORed at bit shifts 0/8/16 (cover colour R/G/B, INFERRED). Provenance: offset/stride PROVEN, masks/shifts PROVEN (lower bounds), meaning INFERRED.";
        field {
            name = "word";
            desc = "32-bit word (see the register description).";
            sw = rw;
            hw = r;
        } word[31:0];
    } COVER_W_00 @ 0x0;

    reg {
        name = "Cover record word 0x4";
        desc = "Word at record offset 0x4 (node 0x2608 + idx*44). SetCover: read-modify-write, two 16-bit halves at shifts 0 and 16 (region coordinate pair, INFERRED). Provenance: offset/stride PROVEN, masks/shifts PROVEN (lower bounds), meaning INFERRED.";
        field {
            name = "word";
            desc = "32-bit word (see the register description).";
            sw = rw;
            hw = r;
        } word[31:0];
    } COVER_W_04 @ 0x4;

    reg {
        name = "Cover record word 0x8";
        desc = "Word at record offset 0x8 (node 0x260C + idx*44). SetCover: two 16-bit halves at shifts 0 and 16 (INFERRED coordinates). Provenance: offset/stride PROVEN, masks/shifts PROVEN (lower bounds), meaning INFERRED.";
        field {
            name = "word";
            desc = "32-bit word (see the register description).";
            sw = rw;
            hw = r;
        } word[31:0];
    } COVER_W_08 @ 0x8;

    reg {
        name = "Cover record word 0xC";
        desc = "Word at record offset 0xC (node 0x2610 + idx*44). SetCover: two 16-bit halves at shifts 0 and 16 (INFERRED coordinates). Provenance: offset/stride PROVEN, masks/shifts PROVEN (lower bounds), meaning INFERRED.";
        field {
            name = "word";
            desc = "32-bit word (see the register description).";
            sw = rw;
            hw = r;
        } word[31:0];
    } COVER_W_0C @ 0xC;

    reg {
        name = "Cover record word 0x10";
        desc = "Word at record offset 0x10 (node 0x2614 + idx*44). SetCover: two 16-bit halves at shifts 0 and 16 (INFERRED coordinates). Provenance: offset/stride PROVEN, masks/shifts PROVEN (lower bounds), meaning INFERRED.";
        field {
            name = "word";
            desc = "32-bit word (see the register description).";
            sw = rw;
            hw = r;
        } word[31:0];
    } COVER_W_10 @ 0x10;

    reg {
        name = "Cover record word 0x14";
        desc = "Word at record offset 0x14 (node 0x2618 + idx*44). SetCover1: R/W, clears 0x1FFFFFFF or written whole (0xFFFFFFFF constant path); 29-bit value (INFERRED: quadrilateral cover parameter). Provenance: offset/stride PROVEN, masks/shifts PROVEN (lower bounds), meaning INFERRED.";
        field {
            name = "word";
            desc = "32-bit word (see the register description).";
            sw = rw;
            hw = r;
        } word[31:0];
    } COVER_W_14 @ 0x14;

    reg {
        name = "Cover record word 0x18";
        desc = "Word at record offset 0x18 (node 0x261C + idx*44). SetCover1: R/W, clears 0x1FFFFFFF or written whole (0xFFFFFFFF constant path); 29-bit value (INFERRED: quadrilateral cover parameter). Provenance: offset/stride PROVEN, masks/shifts PROVEN (lower bounds), meaning INFERRED.";
        field {
            name = "word";
            desc = "32-bit word (see the register description).";
            sw = rw;
            hw = r;
        } word[31:0];
    } COVER_W_18 @ 0x18;

    reg {
        name = "Cover record word 0x1C";
        desc = "Word at record offset 0x1C (node 0x2620 + idx*44). SetCover1: R/W, clears 0x1FFFFFFF or written whole (0xFFFFFFFF constant path); 29-bit value (INFERRED: quadrilateral cover parameter). Provenance: offset/stride PROVEN, masks/shifts PROVEN (lower bounds), meaning INFERRED.";
        field {
