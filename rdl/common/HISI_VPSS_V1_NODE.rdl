            desc = "32-bit word (see the register description).";
            sw = rw;
            hw = r;
        } word[31:0];
    } COVER_W_1C @ 0x1C;

    reg {
        name = "Cover record word 0x20";
        desc = "Word at record offset 0x20 (node 0x2624 + idx*44). SetCover1: R/W, clears 0x1FFFFFFF or written whole (0xFFFFFFFF constant path); 29-bit value (INFERRED: quadrilateral cover parameter). Provenance: offset/stride PROVEN, masks/shifts PROVEN (lower bounds), meaning INFERRED.";
        field {
            name = "word";
            desc = "32-bit word (see the register description).";
            sw = rw;
            hw = r;
        } word[31:0];
    } COVER_W_20 @ 0x20;

    reg {
        name = "Cover record word 0x24";
        desc = "Word at record offset 0x24 (node 0x2628 + idx*44). SetCover1: R/W, clears 0x1FFFFFFF or written whole (0xFFFFFFFF constant path); 29-bit value (INFERRED: quadrilateral cover parameter). Provenance: offset/stride PROVEN, masks/shifts PROVEN (lower bounds), meaning INFERRED.";
