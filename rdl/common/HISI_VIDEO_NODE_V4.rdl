`ifndef HISI_VPSS_NODE_V4_RDL
`define HISI_VPSS_NODE_V4_RDL

regfile eVPSS_NODE_V4_EV300 {
    name = "VPSS job node";
    desc = "Hi3516E V200 / V300 (shared SDK object hi3516ev200_vpss.ko). Re-run 2026-11-12 with the unified path-sensitive engine scripts/tools/arm-re (VPSS_HAL_Set*, node pointer a0, 291 words; it supersedes the 230-word arm-trace v1 set and the 281-word union of round 6: all 230 old words reproduced, 61 new). Most words are a DDR job-node image; only 0x010, 0xF0, 0xFC, 0x200-0x2F0, 0x2F8, 0x300, 0x304, 0x308, 0x310, 0x314 are MMIO (eVPSS_V4). Per-channel blocks are replicated at strides (indexed records). Dynamic confirmation (ko-harness, this A7 module, 48 VPSS_HAL_Set* setters called with a node buffer and three argument patterns, 2026-11-12): 440 distinct node words written, 120 of them in the static set (111 of the old 230 and 9 of the 61 new ones); the other 320 words are one contiguous table 0x1804-0x1D00 built by a loop from an argument table (a scaler coefficient table, INFERRED), added below as COEF_TABLE. VPSS_HAL_SetOutstanding faults in the harness (MMIO global not initialized). Word meanings UNKNOWN unless stated. NOT A REGISTER FILE unless stated: register image / table written by the traced functions. PROVENANCE LABELS: PROVEN = read from the instruction stream (offset, stored byte lanes, cleared bit extents, ORed constants); INFERRED = role deduced from names or sibling chips; UNKNOWN = everything else. Source: symbolic trace of the module disassembly (arm-re). Paths are analyzed separately, extents are lower bounds. Not hardware verified.";

    reg {
        name = "Word 0x0";
        desc = "Word 0x0. PROVEN: stored byte lanes 0123, cleared bit extents [0:0] [1:1] [2:2] [6:4] [8:8] [10:10] [13:13] [14:14] [17:16] [19:19], ORed constants 0x100, written by VPSS_HAL_Set3dnrEnable, VPSS_HAL_SetChnCrop, VPSS_HAL_SetChnScaleEn, VPSS_HAL_SetCoverCtrl, VPSS_HAL_SetGrpCropAttr, VPSS_HAL_SetImgWorkType, VPSS_HAL_SetMosaicCtrl (14 stores). Meaning UNKNOWN.";
        field {
            name = "word";
            desc = "32-bit word.";
            sw = rw;
            hw = r;
        } word[31:0];
    } W_000 @ 0x0;

