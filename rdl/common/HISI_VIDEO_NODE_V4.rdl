regfile eVGS_NODE_V4_EV300 {
    name = "VGS node";
    desc = "Hi3516E V200 / V300 (hi3516ev200_vgs.ko, VGS_DRV_Set*Reg*, a0, 96 words, unchanged by the unified engine). DDR node image, no offset shared with eVGS_V4. LOWCONF (the constant came from a movw without a movt on that path, check the code): words 0x5D8 0x5DC 0x5E0 0x5E4 0x5E8 0x610 (VGS_DRV_SetReg_CSC coefficients). Meaning UNKNOWN unless stated. NOT A REGISTER FILE unless stated: register image / table written by the traced functions. PROVENANCE LABELS: PROVEN = read from the instruction stream (offset, stored byte lanes, cleared bit extents, ORed constants); INFERRED = role deduced from names or sibling chips; UNKNOWN = everything else. Source: symbolic trace of the module disassembly (arm-re). Paths are analyzed separately, extents are lower bounds. Not hardware verified.";

    reg {
