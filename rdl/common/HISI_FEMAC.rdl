`ifndef HISI_FEMAC_RDL
`define HISI_FEMAC_RDL


regfile eHISI_FEMAC {
    name = "HiSilicon femac v2 Fast Ethernet MAC with MDIO";
    desc = "
    HiSilicon \"femac\" Fast Ethernet MAC, version 2 (Linux compatible `hisilicon,hisi-femac-v2` / `hisilicon,hi3518ev20x-femac`, driver `hisi_femac.c`; vendor U-Boot driver `hisfv300`, the same family as the \"hieth\" switch-fabric MAC of the Hi3520D, `eHISI_HIETH_SF`): one port with RMII (10/100 Mbit/s, full or half duplex), an MDIO master, eight DMAC address filter entries, 64-entry RX and TX frame queues managed through the registers below (the frame descriptors are written to / read from UD_GLB_* registers, no DMA descriptor rings in memory), traffic limiting and EEE. New compared to the Hi3520D variant: TSO/UFO/SG and TX/RX checksum offload (RX_COE_EN register, TX controlled through bits of the frame descriptor), a single port (no down port) and the 12-bit RX frame length. The register layout (port registers +0x0000..0x0FFF, MDIO +0x1100, global +0x1300) matches `HISI_HIETH_SF.rdl` (that file's up port) except for the additions above and the missing down port, so this is a separate regfile `eHISI_FEMAC` (names without the data sheet's `UD_` prefix).
    The block sits at 0x10090000 (64 KB window; the Linux device tree maps the port registers at 0x10090000 and the MDIO and global registers as two separate windows at 0x10091100 and 0x10091300). Interrupt: VIC interrupt 12. Clock and reset: PERI_CRG59 (0x20030000 + 0xEC): the vendor U-Boot (`drivers/net/hisfv300/sys.c`) uses soft-reset bit 0 (`ETH_SOFT_RESET`, hrst_eth_s), clock enable bit 1 (`ETH_CLK_ENABLE`), external-PHY reset bit 3 (`ETH_EXTERNAL_PHY_RESET`), core clock select bit 7 (`ETH_CORE_CLK_SELECT_54M`, ethcore_cksel), the DS also lists ethphy_cksel bits 5:4 and eth_rmiick_sel bit 2; the Linux device tree runs the ETH clock at 54 MHz and resets the MAC through CRG 0xEC bit 0 and the PHY through bit 3. The default \"main clock\" for the traffic-limit timer is 100 MHz (DS 5.4.4); at 54 MHz flux_timer_inter must be 54000 for a 1 ms granularity.
    Registers, resets and descriptions are from the Hi3518E V20X/Hi3516C V200 data sheet issue 02 (2017-06-12), chapter 5 (`datasheet` text lines 44289-48515). The data sheet repeats the register block under the name prefix `UD_` (\"up/down port\"; only the up port exists here). Link/speed/duplex are taken from the PHY via MDIO scanning (UD_MDIO_*) or from the CPU through UD_MAC_PORTSET when UD_MAC_PORTSEL[stat_ctrl] = 1. Cross-checked against the Linux `hisi_femac.c` offsets and bit masks (all agree except the RMII bit, see UD_MAC_PORTSEL) and the vendor U-Boot hisfv300 headers. Not hardware verified.
";

    reg {
        name = "MDIO command word register";
        desc = "MDIO_RWCTRL is an MDIO command word register. The register does not support soft reset.

Linux/U-Boot MDIO access: write cpu_data_in, phy_exaddr, phy_inaddr, rw and frq_dv with finish cleared; poll finish (bit 15) until 1; read data from MDIO_RO_DATA.cpu_data_out. The vendor drivers wait for finish before every access.

Data sheet 5.6 MDIO_RWCTRL (offset 0x1100, printed page 5-18, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 45224).";

        field {
            name = "cpu_data_in";
            desc = "Data used by the MDIO module to perform write operation on the PHY chip During write operation, the CPU first writes the 16-bit data to be written to the MDIO to this register.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } cpu_data_in[31:16];

        enum MDIO_RWCTRL_finish_enum {
            NOT_COMPLETE = 0 { name = "Not Complete"; desc = "not complete"; };
            COMPLETE_WHEN_READ = 1 { name = "Complete When Read"; desc = "complete When the read/write operation is required for the second time, the CPU must clear this bit first."; };
        };

        field {
            name = "finish";
            desc = "PHY read/write operation complete";
            sw = rw;
            hw = r;
            encode = MDIO_RWCTRL_finish_enum;
            reset = 0x1;
        } finish[15:15];

        enum MDIO_RWCTRL_rw_f_enum {
            READ_OPERATION = 0 { name = "Read Operation"; desc = "read operation"; };
            WRITE_OPERATION = 1 { name = "Write Operation"; desc = "write operation"; };
        };

        field {
            name = "rw";
            desc = "PHY read or write access control";
            sw = rw;
            hw = r;
            encode = MDIO_RWCTRL_rw_f_enum;
            reset = 0x0;
        } rw_f[13:13];

        field {
            name = "phy_exaddr";
            desc = "Physical address of the external PHY chip One MDIO can perform read/write operation on multiple external PHY chips. Each PHY chip has one corresponding address. When the MDIO connects to only one external PHY chip, this bit is equivalent to UD_MDIO_PHYADDR[phy0_addr] or UD_MDIO_PHYADDR[phy1_addr].";
            sw = rw;
            hw = r;
            reset = 0x0;
        } phy_exaddr[12:8];

        enum MDIO_RWCTRL_frq_dv_enum {
            FREQUENCY_WORKING_MAIN = 0 { name = "Frequency Working Main"; desc = "The frequency of the working main clock is divided by 50 and the obtained frequency is 2 MHz."; };
            FREQUENCY_WORKING_MAIN_2 = 1 { name = "Frequency Working Main 2"; desc = "The frequency of the working main clock is divided by 100 and the obtained frequency is 1 MHz."; };
            FREQUENCY_WORKING_MAIN_3 = 2 { name = "Frequency Working Main 3"; desc = "The frequency of the working main clock is divided by 200 and the obtained frequency is 500 kHz."; };
            FREQUENCY_WORKING_MAIN_4 = 3 { name = "Frequency Working Main 4"; desc = "The frequency of the working main clock is divided by 400 and the obtained frequency is 250 kHz."; };
            FREQUENCY_WORKING_MAIN_5 = 4 { name = "Frequency Working Main 5"; desc = "The frequency of the working main clock is divided by 800 and the obtained frequency is 125 kHz."; };
            FREQUENCY_WORKING_MAIN_6 = 5 { name = "Frequency Working Main 6"; desc = "The frequency of the working main clock is divided by 1600 and the obtained frequency is 62.5 kHz."; };
            FREQUENCY_WORKING_MAIN_7 = 6 { name = "Frequency Working Main 7"; desc = "The frequency of the working main clock is divided by 3200 and the obtained frequency is 31.25 kHz."; };
            FREQUENCY_WORKING_MAIN_8 = 7 { name = "Frequency Working Main 8"; desc = "The frequency of the working main clock is divided by 6400 and the obtained frequency is 15.625 kHz."; };
        };

        field {
            name = "frq_dv";
            desc = "Frequency division factor for the MDC (the MDIO interface clock) when the MDIO performs the read/write operation on external PHY chips Take the frequency 100 MHz of the main clock as an example to describe the matching relations between frq_dv and MDC frequency.";
            sw = rw;
            hw = r;
            encode = MDIO_RWCTRL_frq_dv_enum;
            reset = 0x0;
        } frq_dv[7:5];

        field {
            name = "phy_inaddr";
            desc = "Internal register address of the external PHY chip. This address is presented by a 5-bit binary number.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } phy_inaddr[4:0];
    } MDIO_RWCTRL @ 0x1100;

    reg {
        name = "MDIO read data register";
        desc = "MDIO_RO_DATAMDIO is a read data register. The register does not support soft reset.

Data sheet 5.6 MDIO_RO_DATA (offset 0x1104, printed page 5-20, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 45308).";

        field {
            name = "cpu_data_out";
            desc = "Data register used by the MDIO module to perform read operation on the PHY chip. The MDIO module first writes the 16-bit data read from the PHY chip to this register.";
            sw = r;
            hw = w;
            reset = 0x0;
        } cpu_data_out[15:0];
    } MDIO_RO_DATA @ 0x1104;

    reg {
        name = "PHY physical address register";
        desc = "UD_MDIO_PHYADDR is a PHY physical address register. The register does not support soft reset.

Data sheet 5.6 UD_MDIO_PHYADDR (offset 0x108, printed page 5-20, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 45330).";

        field {
            name = "phy_addr";
            desc = "Physical address of the external PHY chip";
            sw = rw;
            hw = r;
            reset = 0x1;
        } phy_addr[4:0];
    } MDIO_PHYADDR @ 0x108;

    reg {
        name = "PHY status register";
        desc = "UD_MDIO_RO_STAT is a PHY status register. The register does not support soft reset.

Data sheet 5.6 UD_MDIO_RO_STAT (offset 0x10C, printed page 5-20, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 45350).";

        enum MDIO_RO_STAT_speed_mdio2mac_enum {
            V_10_MBIT_S = 0 { name = "V 10 Mbit S"; desc = "10 Mbit/s mode"; };
            V_100_MBIT_S = 1 { name = "V 100 Mbit S"; desc = "100 Mbit/s mode"; };
        };

        field {
            name = "speed_mdio2mac";
            desc = "Port speed working status obtained from the MDIO interface, which is in either 10 Mbit/s or 100 Mbit/s working mode";
            sw = r;
            hw = w;
            encode = MDIO_RO_STAT_speed_mdio2mac_enum;
            reset = 0x0;
        } speed_mdio2mac[2:2];

        enum MDIO_RO_STAT_link_mdio2mac_enum {
            NO_LINK_EXISTS = 0 { name = "No Link Exists"; desc = "No link exists."; };
            LINK_EXISTS = 1 { name = "Link Exists"; desc = "A link exists."; };
        };

        field {
            name = "link_mdio2mac";
            desc = "Port link status obtained from the MDIO interface";
            sw = r;
            hw = w;
            encode = MDIO_RO_STAT_link_mdio2mac_enum;
            reset = 0x0;
        } link_mdio2mac[1:1];

        enum MDIO_RO_STAT_duplex_mdio2mac_enum {
            HALF_DUPLEX = 0 { name = "Half Duplex"; desc = "half-duplex"; };
            FULL_DUPLEX = 1 { name = "Full Duplex"; desc = "full-duplex"; };
        };

        field {
            name = "duplex_mdio2mac";
            desc = "Port duplex working status obtained from the MDIO interface";
            sw = r;
            hw = w;
            encode = MDIO_RO_STAT_duplex_mdio2mac_enum;
            reset = 0x0;
        } duplex_mdio2mac[0:0];
    } MDIO_RO_STAT @ 0x10C;

    reg {
        name = "Offset address configuration register for the PHY status";
        desc = "UD_MDIO_ANEG_CTRLPHY is an offset address configuration register for the PHY status. The register does not support soft reset. The PHY speed status is indicated by bit[14] of the register with the address of 17, internal_addr_speed is set to 0x11 and speed_index is set to 0xE. In this case, the ETH module reads the bit value as the current working speed mode of the PHY through the MDIO interface.

Data sheet 5.6 UD_MDIO_ANEG_CTRL (offset 0x110, printed page 5-21, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 45399).";

        field {
            name = "internal_addr_speed";
            desc = "Address of the register in the PHY chip that stores the status information (speed). The default value is set according to Intel 9785.";
            sw = rw;
            hw = r;
            reset = 0x11;
        } internal_addr_speed[26:22];

        field {
            name = "internal_addr_link";
            desc = "Address of the register in the PHY chip that stores the status information (link). The default value is set according to Intel 9785.";
            sw = rw;
            hw = r;
            reset = 0x11;
        } internal_addr_link[21:17];

        field {
            name = "internal_addr_duplex";
            desc = "Address of the register in the PHY chip that stores the status information (duplex). The default value is set according to Intel 9785.";
            sw = rw;
            hw = r;
            reset = 0x11;
        } internal_addr_duplex[16:12];

        field {
            name = "speed_index";
            desc = "Offset address in the PHY status register that is used to store the speed information. The default value is set according to Intel 9785.";
            sw = rw;
            hw = r;
            reset = 0xE;
        } speed_index[11:8];

        field {
            name = "link_index";
            desc = "Offset address in the PHY status register that is used to store the link information. The default value is set according to Intel 9785.";
            sw = rw;
            hw = r;
            reset = 0xA;
        } link_index[7:4];

        field {
            name = "duplex_index";
            desc = "Offset address in the PHY status register that is used to store the duplex information. The default value is set according to Intel 9785.";
            sw = rw;
            hw = r;
            reset = 0x9;
        } duplex_index[3:0];
    } MDIO_ANEG_CTRL @ 0x110;

    reg {
        name = "Scan mask register for MDIO status changes";
        desc = "UD_MDIO_IRQENA is a scan mask register for MDIO status changes. The register does not support soft reset.     If the status information about the PHY chip connecting to the port cannot be scanned and obtained by configuring     UD_MDIO_ANEG_CTRL, you can scan the PHY status register by using MDIO_RWCTRL to check whether the port status changes and generate an interrupt to notify software of processing the interrupt.     link_partner status change refers to the change of any bit of link, speed, and duplex for the PHY status.

Data sheet 5.6 UD_MDIO_IRQENA (offset 0x114, printed page 5-22, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 45467).";

        enum MDIO_IRQENA_link_partner_ch_mask_enum {
            MASK_F = 0 { name = "Mask F"; desc = "mask"; };
            UNMASK = 1 { name = "Unmask"; desc = "unmask"; };
        };

        field {
            name = "link_partner_ch_mask";
            desc = "Port link partner status scan change interrupt mask";
            sw = rw;
            hw = r;
            encode = MDIO_IRQENA_link_partner_ch_mask_enum;
            reset = 0x0;
        } link_partner_ch_mask[3:3];

        enum MDIO_IRQENA_speed_ch_mask_enum {
            MASK_F = 0 { name = "Mask F"; desc = "mask"; };
            UNMASK = 1 { name = "Unmask"; desc = "unmask"; };
        };

        field {
            name = "speed_ch_mask";
            desc = "Port speed mode scan change interrupt mask";
            sw = rw;
            hw = r;
            encode = MDIO_IRQENA_speed_ch_mask_enum;
            reset = 0x0;
        } speed_ch_mask[2:2];

        enum MDIO_IRQENA_link_ch_mask_enum {
            MASK_F = 0 { name = "Mask F"; desc = "mask"; };
            UNMASK = 1 { name = "Unmask"; desc = "unmask"; };
        };

        field {
            name = "link_ch_mask";
            desc = "Port link mode scan change interrupt mask";
            sw = rw;
            hw = r;
            encode = MDIO_IRQENA_link_ch_mask_enum;
            reset = 0x0;
        } link_ch_mask[1:1];

        enum MDIO_IRQENA_duplex_ch_mask_enum {
            MASK_F = 0 { name = "Mask F"; desc = "mask"; };
            UNMASK = 1 { name = "Unmask"; desc = "unmask"; };
        };

        field {
            name = "duplex_ch_mask";
            desc = "Port duplex mode scan change interrupt mask";
            sw = rw;
            hw = r;
            encode = MDIO_IRQENA_duplex_ch_mask_enum;
            reset = 0x0;
        } duplex_ch_mask[0:0];
    } MDIO_IRQENA @ 0x114;

    reg {
        name = "Port working status control register";
        desc = "UD_MAC_PORTSEL is a port working status control register. The register does not support soft reset.

Linux `hisi_femac.c` sets stat_ctrl (`MAC_PORTSEL_STAT_CPU`, bit 0 = 1: link status/speed/duplex are programmed by the CPU from the PHY state through UD_MAC_PORTSET) and the RMII bit (bit 1).

Data sheet 5.6 UD_MAC_PORTSEL (offset 0x200, printed page 5-23, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 45522).";

        field {
            name = "mii_rmii";
            desc = "Port interface mode selection (0 = MII, 1 = RMII). NOT IN THIS DATA SHEET (bit [31:1] reserved here); the Hi3520D data sheet and the Linux driver `hisi_femac.c` (`MAC_PORTSEL_RMII` = BIT(1)) define it, and the RMII-only pins of this SoC require RMII mode to be selected.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } mii_rmii[1:1];

        enum MAC_PORTSEL_stat_ctrl_enum {
            USE_STATUS_INFORMATION = 0 { name = "Use Status Information"; desc = "Use the status information obtained from the MDIO interface."; };
            USE_STATUS_INFORMATION_2 = 1 { name = "Use Status Information 2"; desc = "Use the status information set by the CPU."; };
        };

        field {
            name = "stat_ctrl";
            desc = "Port working status information select control register";
            sw = rw;
            hw = r;
            encode = MAC_PORTSEL_stat_ctrl_enum;
            reset = 0x1;
        } stat_ctrl[0:0];
    } MAC_PORTSEL @ 0x200;

    reg {
        name = "Port status register";
        desc = "UD_MAC_RO_STAT is a port status register. The register does not support soft reset.

Data sheet 5.6 UD_MAC_RO_STAT (offset 0x204, printed page 5-23, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 45546).";

        enum MAC_RO_STAT_speed_stat_enum {
            V_10_MBIT_S = 0 { name = "V 10 Mbit S"; desc = "10 Mbit/s mode"; };
            V_100_MBIT_S = 1 { name = "V 100 Mbit S"; desc = "100 Mbit/s mode"; };
        };

        field {
            name = "speed_stat";
            desc = "Port current speed mode";
            sw = r;
            hw = w;
            encode = MAC_RO_STAT_speed_stat_enum;
            reset = 0x0;
        } speed_stat[2:2];

        enum MAC_RO_STAT_link_stat_enum {
            NO_LINK_EXISTS = 0 { name = "No Link Exists"; desc = "No link exists."; };
            LINK_EXISTS = 1 { name = "Link Exists"; desc = "A link exists."; };
        };

        field {
            name = "link_stat";
            desc = "Port current link status";
            sw = r;
            hw = w;
            encode = MAC_RO_STAT_link_stat_enum;
            reset = 0x0;
        } link_stat[1:1];

        enum MAC_RO_STAT_duplex_stat_enum {
            HALF_DUPLEX = 0 { name = "Half Duplex"; desc = "half-duplex"; };
            FULL_DUPLEX = 1 { name = "Full Duplex"; desc = "full-duplex"; };
        };

        field {
            name = "duplex_stat";
            desc = "Port current duplex status";
            sw = r;
            hw = w;
            encode = MAC_RO_STAT_duplex_stat_enum;
            reset = 0x0;
        } duplex_stat[0:0];
    } MAC_RO_STAT @ 0x204;

    reg {
        name = "Port working status configuration register";
        desc = "UD_MAC_PORTSET is a port working status configuration register. The register does not support soft reset.

Linux `hisi_femac.c`: `MAC_PORTSET_DUPLEX_FULL` bit 0, `MAC_PORTSET_LINKED` bit 1, `MAC_PORTSET_SPEED_100M` bit 2.

Data sheet 5.6 UD_MAC_PORTSET (offset 0x208, printed page 5-24, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 45590).";

        enum MAC_PORTSET_speed_stat_dio_enum {
            V_10_MBIT_S = 0 { name = "V 10 Mbit S"; desc = "10 Mbit/s mode"; };
            V_100_MBIT_S = 1 { name = "V 100 Mbit S"; desc = "100 Mbit/s mode"; };
        };

        field {
            name = "speed_stat_dio";
            desc = "Port speed mode set by the CPU";
            sw = rw;
            hw = r;
            encode = MAC_PORTSET_speed_stat_dio_enum;
            reset = 0x0;
        } speed_stat_dio[2:2];

        enum MAC_PORTSET_link_stat_dio_enum {
            NO_LINK_EXISTS = 0 { name = "No Link Exists"; desc = "No link exists."; };
            LINK_EXISTS = 1 { name = "Link Exists"; desc = "A link exists."; };
        };

        field {
            name = "link_stat_dio";
            desc = "Port link status set by the CPU";
            sw = rw;
            hw = r;
            encode = MAC_PORTSET_link_stat_dio_enum;
            reset = 0x0;
        } link_stat_dio[1:1];

        enum MAC_PORTSET_duplex_stat_dio_enum {
            HALF_DUPLEX = 0 { name = "Half Duplex"; desc = "half-duplex"; };
            FULL_DUPLEX = 1 { name = "Full Duplex"; desc = "full-duplex"; };
        };

        field {
            name = "duplex_stat_dio";
            desc = "Port duplex mode set by the CPU";
            sw = rw;
            hw = r;
            encode = MAC_PORTSET_duplex_stat_dio_enum;
            reset = 0x0;
        } duplex_stat_dio[0:0];
    } MAC_PORTSET @ 0x208;

    reg {
        name = "Port status change indicator register for the MAC";
        desc = "UD_MAC_STAT_CHANGE is a port status change indicator register. The register does not support soft reset.

Data sheet 5.6 UD_MAC_STAT_CHANGE (offset 0x20C, printed page 5-25, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 45636).";

        enum MAC_STAT_CHANGE_speed_stat_ch_enum {
            NO_CHANGE_OCCURS = 0 { name = "No Change Occurs"; desc = "No change occurs."; };
            CHANGE_OCCURS_WRITING = 1 { name = "Change Occurs Writing"; desc = "A change occurs. Writing 1 clears this register."; };
        };

        field {
            name = "speed_stat_ch";
            desc = "Port speed mode change indicator";
            sw = rw;
            hw = w;
            onwrite = woclr;
            encode = MAC_STAT_CHANGE_speed_stat_ch_enum;
            reset = 0x0;
        } speed_stat_ch[2:2];

        enum MAC_STAT_CHANGE_link_stat_ch_enum {
            NO_CHANGE_OCCURS = 0 { name = "No Change Occurs"; desc = "No change occurs."; };
            CHANGE_OCCURS_WRITING = 1 { name = "Change Occurs Writing"; desc = "A change occurs. Writing 1 clears this register."; };
        };

        field {
            name = "link_stat_ch";
            desc = "Port link status change indicator";
            sw = rw;
            hw = w;
            onwrite = woclr;
            encode = MAC_STAT_CHANGE_link_stat_ch_enum;
            reset = 0x0;
        } link_stat_ch[1:1];

        enum MAC_STAT_CHANGE_duplex_stat_ch_enum {
            NO_CHANGE_OCCURS = 0 { name = "No Change Occurs"; desc = "No change occurs."; };
            CHANGE_OCCURS_WRITING = 1 { name = "Change Occurs Writing"; desc = "A change occurs. Writing 1 clears this register."; };
        };

        field {
            name = "duplex_stat_ch";
            desc = "Port duplex mode change indicator";
            sw = rw;
            hw = w;
            onwrite = woclr;
            encode = MAC_STAT_CHANGE_duplex_stat_ch_enum;
            reset = 0x0;
        } duplex_stat_ch[0:0];
    } MAC_STAT_CHANGE @ 0x20C;

    reg {
        name = "MAC function configuration register";
        desc = "UD_MAC_SET is a MAC function configuration register. The register does not support soft reset.

Linux `hisi_femac.c` uses `MAX_FRAME_SIZE_MASK` = bits 10:0 (len_max, driver programs 1600) and `BIT_PAUSE_EN` = bit 18. The DS Total Reset Value 0x202755EE = add_pad_en, colthreshold 1, pause_en, rx_shframe_en, rx_min_thr 42, len_max 1518.

Data sheet 5.6 UD_MAC_SET (offset 0x210, printed page 5-26, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 45683).";

        enum MAC_SET_add_pad_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "add_pad_en";
            desc = "Port auto add PAD enable during transmission";
            sw = rw;
            hw = r;
            encode = MAC_SET_add_pad_en_enum;
            reset = 0x1;
        } add_pad_en[29:29];

        enum MAC_SET_crcgen_dis_enum {
            CRC_RECALCULATED_OUTPUT = 0 { name = "Crc Recalculated Output"; desc = "CRC is recalculated for the output frame."; };
            CRC_NOT_RECALCULATED = 1 { name = "Crc Not Recalculated"; desc = "CRC is not recalculated for the output frame."; };
        };

        field {
            name = "crcgen_dis";
            desc = "Port CRC generation disable control";
            sw = rw;
            hw = r;
            encode = MAC_SET_crcgen_dis_enum;
            reset = 0x0;
        } crcgen_dis[28:28];

        enum MAC_SET_cntr_rdclr_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "cntr_rdclr_en";
            desc = "Port statistics counter read clear enable";
            sw = rw;
            hw = r;
            encode = MAC_SET_cntr_rdclr_en_enum;
            reset = 0x0;
        } cntr_rdclr_en[27:27];

        enum MAC_SET_cntr_clr_all_enum {
            NOT_CLEAR = 0 { name = "Not Clear"; desc = "not clear"; };
            CLEAR = 1 { name = "Clear"; desc = "clear"; };
        };

        field {
            name = "cntr_clr_all";
            desc = "Port statistics counter clear control";
            sw = rw;
            hw = r;
            encode = MAC_SET_cntr_clr_all_enum;
            reset = 0x0;
        } cntr_clr_all[26:26];

