        } ipgctrl[31:0];
    } MAC_RX_IPGCTRL @ 0x214;

    reg {
        name = "TX inter-packet-gap control register (vendor only)";
        desc = "Vendor name U_MAC_TX_IPGCTRL at 0x0218.

NOT IN THE DATA SHEET: taken from the vendor U-Boot driver (drivers/net/hisfv300/mac.h, mac.c); the data sheet does not list this register and gives no reset value.";

        field {
            name = "pre_cnt_limit";
            desc = "Lead-code (preamble) count limit (vendor `BITS_PRE_CNT_LIMIT`, bits 25:23; the vendor driver clears it during init).";
            sw = rw;
            hw = r;
        } pre_cnt_limit[25:23];

        field {
            name = "ipg";
            desc = "Transmit inter-packet gap in bits (vendor `BITS_IPG`, bits 22:16).";
            sw = rw;
            hw = r;
        } ipg[22:16];

        field {
            name = "fc_inter";
            desc = "Flow-control (pause frame) interval (vendor `BITS_FC_INTER`, bits 15:0).";
            sw = rw;
            hw = r;
        } fc_inter[15:0];
    } MAC_TX_IPGCTRL @ 0x218;

};

`endif
