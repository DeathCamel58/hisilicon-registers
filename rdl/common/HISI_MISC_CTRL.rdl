        desc = "MISC_CTRL8 is MISC register 8.

Data sheet 3.5.5.2 MISC_CTRL8 (offset 0x20, printed page 3-66, `hi3518ev200-datasheet.txt` line 25821).";

        field {
            name = "sysaxi_port3_pri";
            desc = "Priority of the SYS AXI bus M3 port (AHB1) The value 3 indicates the highest priority.";
            sw = rw;
            hw = r;
            reset = 0x0;
