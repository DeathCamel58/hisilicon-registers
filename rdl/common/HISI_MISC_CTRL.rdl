    reg {
        name = "USB 2.0 PHY control (vendor, not in the data sheet)";
        desc = "Not in the data sheet (it lists MISC_CTRL30 at 0x78 and the next register at 0xC4); layout reconstructed from the vendor code. The vendor U-Boot (drivers/usb/host/hiusb/hiusb-3518ev200.c, MISC_USB = MISC_CTRL + 0x80) and the vendor/OpenIPC kernel (drivers/phy/hibvt/phy-hi3518ev20x-usb.c) drive the USB 2.0 PHY through it with fixed write pairs that differ only in bit 5: 0x0C06 then 0x0C26 (5 ms), 0x1C00 then 0x1C20, 0x0C09 then 0x0C29, 0x1A0A then 0x1A2A, and (kernel, threshold 650 to 550) 0x000A then 0x092A; the vendor U-Boot uses only 0x0C06/0x0C26 and 0x0000/0x1C20. [inferred] This is an indirect PHY register port: [3:0] register address, [5] write strobe (low value then high value), [15:8] write data. Live evidence (Hi3518E V200 board, 2026-11-10): after the U-Boot sequence the register reads 0x001C1C20 and after the kernel sequence 0x0009092A, i.e. bits [23:16] read back as a copy of the last written [15:8]. Bit meanings of the PHY registers themselves are not documented.";
        field { name = "phy_addr"; desc = "[inferred] USB 2.0 PHY register address (values seen: 0x0, 0x6, 0x9, 0xA)"; sw = rw; hw = na; } phy_addr[3:0];
        field { name = "phy_wr_strobe"; desc = "[inferred] Write strobe: the vendor code writes the word with this bit 0, waits 10 us, then writes it again with this bit 1 (0x26 vs 0x06 in the low byte)"; sw = rw; hw = na; } phy_wr_strobe[5:5];
        field { name = "phy_wdata"; desc = "[inferred] Data written to the addressed USB 2.0 PHY register (values seen: 0x0C, 0x1C, 0x1A, 0x09)"; sw = rw; hw = na; } phy_wdata[15:8];
        field { name = "phy_rdata"; desc = "[inferred] Read-back of the PHY register data: reads as a copy of the last written phy_wdata on the board (0x1C and 0x09 seen)"; sw = r; hw = na; } phy_rdata[23:16];
    } MISC_CTRL32 @ 0x80;

    reg {
        name = "MISC register 31 (vendor, not in the data sheet)";
        desc = "Not in the data sheet and not touched by any vendor code found (U-Boot hiusb-3518ev200.c, kernel phy-hi3518ev20x-usb.c, DDR training). A live dump of a Hi3518E V200 board reads 0x029991C5 both in U-Boot and in Linux, so it is not a status that changes with the SDK sequence (U-Boot after a warm reset equals Linux). [inferred] Sits between MISC_CTRL30 (USB controller strap/config, 0x78) and the USB PHY port (0x80), so probably another USB PHY/controller parameter word. Bit meanings unknown.";
        field { name = "value"; desc = "Undocumented word (observed 0x029991C5)"; sw = rw; hw = na; } value[31:0];
    } MISC_CTRL31 @ 0x7C;

    reg {
        name = "MISC register 55 (vendor, not in the data sheet)";
        desc = "Not in the data sheet (it lists MISC_CTRL54 at 0xD8, ACODEC control register 4, then MISC_CTRL56 at 0xE0). A live dump of a Hi3518E V200 board reads 0x24242424 both in U-Boot and in Linux. [inferred] Probably the next ACODEC control word (the ACODEC registers 0xC8..0xD8 carry analog defaults of the 0x24 / 0x1E / 0x06 kind). Bit meanings unknown.";
        field { name = "value"; desc = "Undocumented word (observed 0x24242424)"; sw = rw; hw = na; } value[31:0];
    } MISC_CTRL55 @ 0xDC;

