            sw = rw;
            hw = r;
            reset = 0x0;
        } media0axi_port2_pri[6:4];

        field {
            name = "media0axi_port1_pri";
            desc = "Priority of the media 0 AXI bus M1 port (AVC) The value 1 indicates the highest priority.";
            sw = rw;
            hw = r;
            reset = 0x1;
        } media0axi_port1_pri[2:0];
    } MISC_CTRL14 @ 0x38;

