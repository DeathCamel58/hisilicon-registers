`ifndef HISI_MISC_CTRL_RDL
`define HISI_MISC_CTRL_RDL

regfile eHISI_MISC_CTRL {
    name = "MISC control registers, Hi3518E V20X / Hi3516C V200";
    desc = "
    Peripheral control (`MISC_CTRLn`, data sheet 3.5.5) at 0x20120000: SPI/UART/SDIO glue, bus priorities and QoS for the media AXI buses, USB controller/PHY glue
    (MISC_CTRL30), ACODEC control (MISC_CTRL49..54), memory timing adjustment and the eMMC DLL. Registers not listed are not implemented/not documented. Several registers
    cannot be soft reset (stated in their description). MISC_CTRL32 (0x80) is not in the data sheet and is modelled from the vendor USB driver.
    ";

    reg {
        name = "MISC register 1";
        desc = "MISC_CTRL1 is MISC register 1. This register cannot be soft reset.

This register cannot be soft reset. bootrom_pgen powers the BOOTROM off after boot.

Vendor use: the vendor DDR training (ddr_ddrt_prepare_custom, arch/arm/cpu/hi3518ev200/ddr_training_custom.c) sets tde_ddrt_mst_sel (bit 2) so the DDRT test module reaches the DDR, and the vendor register table clears ive_gzip_mst_sel (bit 12) before DDR init. Live: 0x00200004 at U-Boot (bit 2 left set after training, mipi_phy_mode 2), 0x00201000 under the SDK kernel (bit 2 cleared, ive_gzip_mst_sel set).

Data sheet 3.5.5.2 MISC_CTRL1 (offset 0x4, printed page 3-61, `hi3518ev200-datasheet.txt` line 25509).";

        enum MISC_CTRL1_vicap_vpss_online_enum {
            OFFLINE_MODE = 0 { name = "Offline Mode"; desc = "offline mode"; };
            ONLINE_MODE = 1 { name = "Online Mode"; desc = "online mode"; };
        };

        field {
            name = "vicap_vpss_online";
            desc = "VICAP and VPSS mode";
            sw = rw;
            hw = r;
            encode = MISC_CTRL1_vicap_vpss_online_enum;
            reset = 0x0;
        } vicap_vpss_online[30:30];

        enum MISC_CTRL1_ssp1_cs_sel_enum {
            CS0 = 0 { name = "Cs0"; desc = "CS0"; };
            CS1_1X_RESERVED = 1 { name = "Cs1 1X Reserved"; desc = "CS1 1x: reserved"; };
        };

        field {
            name = "ssp1_cs_sel";
            desc = "SSP1 CS select";
            sw = rw;
            hw = r;
            encode = MISC_CTRL1_ssp1_cs_sel_enum;
            reset = 0x0;
        } ssp1_cs_sel[27:26];

        enum MISC_CTRL1_mipi_phy_mode_enum {
            MIPI_MODE = 0 { name = "Mipi Mode"; desc = "MIPI mode"; };
            LVDS_MODE = 1 { name = "Lvds Mode"; desc = "LVDS mode"; };
            CMOS_MODE = 2 { name = "Cmos Mode"; desc = "CMOS mode"; };
            BYPASS_MODE = 3 { name = "Bypass Mode"; desc = "bypass mode"; };
        };

        field {
            name = "mipi_phy_mode";
            desc = "MIPI PHY mode";
            sw = rw;
            hw = r;
            encode = MISC_CTRL1_mipi_phy_mode_enum;
            reset = 0x1;
        } mipi_phy_mode[21:20];

        enum MISC_CTRL1_ive_gzip_mst_sel_enum {
            GZIP = 0 { name = "Gzip"; desc = "GZIP"; };
            IVE = 1 { name = "Ive"; desc = "IVE"; };
        };

        field {
            name = "ive_gzip_mst_sel";
            desc = "IVE/GZIP access select through media1 AXI";
            sw = rw;
            hw = r;
            encode = MISC_CTRL1_ive_gzip_mst_sel_enum;
            reset = 0x0;
        } ive_gzip_mst_sel[12:12];

        enum MISC_CTRL1_spi1_cs1_ctrl_enum {
            NOT_INVERTED = 0 { name = "Not Inverted"; desc = "not inverted"; };
            INVERTED = 1 { name = "Inverted"; desc = "inverted"; };
        };

        field {
            name = "spi1_cs1_ctrl";
            desc = "Reverse control for the spi1_cs1 signal";
            sw = rw;
            hw = r;
            encode = MISC_CTRL1_spi1_cs1_ctrl_enum;
            reset = 0x0;
        } spi1_cs1_ctrl[10:10];

        enum MISC_CTRL1_spi1_cs0_ctrl_enum {
            NOT_INVERTED = 0 { name = "Not Inverted"; desc = "not inverted"; };
            INVERTED = 1 { name = "Inverted"; desc = "inverted"; };
        };

        field {
            name = "spi1_cs0_ctrl";
            desc = "Reverse control for the spi1_cs0 signal";
            sw = rw;
            hw = r;
            encode = MISC_CTRL1_spi1_cs0_ctrl_enum;
            reset = 0x0;
        } spi1_cs0_ctrl[9:9];

        enum MISC_CTRL1_spi0_cs0_ctrl_enum {
            NOT_INVERTED = 0 { name = "Not Inverted"; desc = "not inverted"; };
            INVERTED = 1 { name = "Inverted"; desc = "inverted"; };
        };

        field {
            name = "spi0_cs0_ctrl";
            desc = "Reverse control for the spi0_cs0 signal";
            sw = rw;
            hw = r;
            encode = MISC_CTRL1_spi0_cs0_ctrl_enum;
            reset = 0x0;
        } spi0_cs0_ctrl[8:8];

        enum MISC_CTRL1_uart1_rts_ctrl_enum {
            NOT_INVERTED = 0 { name = "Not Inverted"; desc = "not inverted"; };
            INVERTED = 1 { name = "Inverted"; desc = "inverted"; };
        };

        field {
            name = "uart1_rts_ctrl";
            desc = "Reverse control for the uart1_rts signal";
            sw = rw;
            hw = r;
            encode = MISC_CTRL1_uart1_rts_ctrl_enum;
            reset = 0x0;
        } uart1_rts_ctrl[7:7];

        enum MISC_CTRL1_bootrom_pgen_enum {
            POWERED = 0 { name = "Powered"; desc = "powered on"; };
            POWERED_OFF = 1 { name = "Powered Off"; desc = "powered off"; };
        };

        field {
            name = "bootrom_pgen";
            desc = "BOOTROM power supply control";
            sw = rw;
            hw = r;
            encode = MISC_CTRL1_bootrom_pgen_enum;
            reset = 0x0;
        } bootrom_pgen[6:6];

        enum MISC_CTRL1_bootram1_ck_gt_en_enum {
            ENABLED = 0 { name = "Enabled"; desc = "enabled"; };
            DISABLED = 1 { name = "Disabled"; desc = "disabled"; };
        };

        field {
            name = "bootram1_ck_gt_en";
            desc = "BOOTRAM1 clock enable";
            sw = rw;
            hw = r;
            encode = MISC_CTRL1_bootram1_ck_gt_en_enum;
            reset = 0x0;
        } bootram1_ck_gt_en[4:4];

        enum MISC_CTRL1_bootram0_ck_gt_en_enum {
            ENABLED = 0 { name = "Enabled"; desc = "enabled"; };
            DISABLED = 1 { name = "Disabled"; desc = "disabled"; };
        };

        field {
            name = "bootram0_ck_gt_en";
            desc = "BOOTRAM0 clock enable";
            sw = rw;
            hw = r;
            encode = MISC_CTRL1_bootram0_ck_gt_en_enum;
            reset = 0x0;
        } bootram0_ck_gt_en[3:3];

        enum MISC_CTRL1_tde_ddrt_mst_sel_enum {
            TDE = 0 { name = "Tde"; desc = "TDE"; };
            DDRT = 1 { name = "Ddrt"; desc = "DDRT"; };
        };

        field {
            name = "tde_ddrt_mst_sel";
            desc = "MDU/DDRT access select through media1 AXI";
            sw = rw;
            hw = r;
            encode = MISC_CTRL1_tde_ddrt_mst_sel_enum;
            reset = 0x0;
        } tde_ddrt_mst_sel[2:2];

        enum MISC_CTRL1_sdio1_card_det_mode_enum {
            NOT_INVERTED = 0 { name = "Not Inverted"; desc = "not inverted"; };
            INVERTED = 1 { name = "Inverted"; desc = "inverted"; };
        };

        field {
            name = "sdio1_card_det_mode";
            desc = "Reverse control for the SDIO1 card detection signal";
            sw = rw;
            hw = r;
            encode = MISC_CTRL1_sdio1_card_det_mode_enum;
            reset = 0x0;
        } sdio1_card_det_mode[1:1];

        enum MISC_CTRL1_sdio0_card_det_mode_enum {
            NOT_INVERTED = 0 { name = "Not Inverted"; desc = "not inverted"; };
            INVERTED = 1 { name = "Inverted"; desc = "inverted"; };
        };

        field {
            name = "sdio0_card_det_mode";
            desc = "Reverse control for the SDIO0 card detection signal";
            sw = rw;
            hw = r;
            encode = MISC_CTRL1_sdio0_card_det_mode_enum;
            reset = 0x0;
        } sdio0_card_det_mode[0:0];
    } MISC_CTRL1 @ 0x4;

    reg {
        name = "MISC register 2";
        desc = "MISC_CTRL2 is MISC register 2. This register cannot be soft reset.

Data sheet 3.5.5.2 MISC_CTRL2 (offset 0x8, printed page 3-63, `hi3518ev200-datasheet.txt` line 25610).";

        field {
            name = "arm9_mem_dly";
            desc = "ARM9 mem speed adjustment control";
            sw = rw;
            hw = r;
            reset = 0x1;
        } arm9_mem_dly[2:0];
    } MISC_CTRL2 @ 0x8;

    reg {
        name = "MISC register 3";
        desc = "MISC_CTRL3 is MISC register 3. This register cannot be soft reset.

Data sheet 3.5.5.2 MISC_CTRL3 (offset 0xC, printed page 3-63, `hi3518ev200-datasheet.txt` line 25636).";

        enum MISC_CTRL3_powerswitch_sel_mux_enum {
            SDIO0_CONTROLLER = 0 { name = "Sdio0 Controller"; desc = "SDIO0 controller"; };
            POWERSWITCH_SEL_REGISTER = 1 { name = "Powerswitch Sel Register"; desc = "powerswitch_sel register"; };
        };

        field {
            name = "powerswitch_sel_mux";
            desc = "Power switch source select";
            sw = rw;
            hw = r;
            encode = MISC_CTRL3_powerswitch_sel_mux_enum;
            reset = 0x0;
        } powerswitch_sel_mux[1:1];

        enum MISC_CTRL3_powerswitch_sel_enum {
            V_3_3_V = 0 { name = "V 3 3 V"; desc = "3.3 V"; };
            V_1_8_V = 1 { name = "V 1 8 V"; desc = "1.8 V"; };
        };

        field {
            name = "powerswitch_sel";
            desc = "Power switch select (valid only when powerswitch_sel_mux is 1)";
            sw = rw;
            hw = r;
            encode = MISC_CTRL3_powerswitch_sel_enum;
            reset = 0x0;
        } powerswitch_sel[0:0];
    } MISC_CTRL3 @ 0xC;

    reg {
        name = "MISC register 4";
        desc = "MISC_CTRL4 is MISC register 4. This register cannot be soft reset.

Hardware: a live dump reads 0x8000007B (bits 0, 1, 3, 4, 5, 6 and 31 set); the reserved bits [30:7] and bit 2 read 0 although the data sheet total reset value is 0xFFFFFFFF.

Data sheet 3.5.5.2 MISC_CTRL4 (offset 0x10, printed page 3-64, `hi3518ev200-datasheet.txt` line 25682).";

        enum MISC_CTRL4_avc_ret1n_bypass_enum {
            ENABLED = 0 { name = "Enabled"; desc = "enabled"; };
            BYPASSED = 1 { name = "Bypassed"; desc = "bypassed"; };
        };

        field {
            name = "avc_ret1n_bypass";
            desc = "AVC automatic mem ret1n function bypass";
            sw = rw;
            hw = r;
            encode = MISC_CTRL4_avc_ret1n_bypass_enum;
            reset = 0x1;
        } avc_ret1n_bypass[31:31];

        field {
            name = "reserved_nz_30_7";
            desc = "Reserved read-only bits. The data sheet total reset value of this register has these bits set (reset 0xFFFFFF), but a live dump from a Hi3518E V200 board (OpenIPC U-Boot and SDK Linux, 2026-11-10) reads 0 in them, so hardware reads 0 here and the reset is modelled as 0.";
            sw = r;
            hw = w;
            reset = 0x0;
        } reserved_nz_30_7[30:7];

        field {
            name = "sdio1_ret1n";
            desc = "mem ret1n signal in the SDIO1 CTRL. Set this signal to 1 when the SDIO1 CTRL is enabled or set this signal to 0 when the SDIO1 CTRL is disabled to reduce mem power consumption.";
            sw = rw;
            hw = r;
            reset = 0x1;
        } sdio1_ret1n[6:6];

        field {
            name = "sdio0_ret1n";
            desc = "mem ret1n signal in the SDIO0 CTRL. Set this signal to 1 when the SDIO0 CTRL is enabled or set this signal to 0 when the SDIO0 CTRL is disabled to reduce mem power consumption.";
            sw = rw;
            hw = r;
            reset = 0x1;
        } sdio0_ret1n[5:5];

        field {
            name = "reserved_nz_4_4";
            desc = "Reserved in the bit table, but the data sheet total reset value of this register has these bits set (reset 0x1).";
            sw = r;
            hw = w;
            reset = 0x1;
        } reserved_nz_4_4[4:4];

        field {
            name = "usb_ret1n";
            desc = "mem ret1n signal in the USB CTRL. Set this signal to 1 when the USB CTRL is enabled or set this signal to 0 when the USB CTRL is disabled to reduce mem power consumption.";
            sw = rw;
            hw = r;
            reset = 0x1;
        } usb_ret1n[3:3];

        field {
            name = "reserved_nz_2_2";
            desc = "Reserved read-only bits. The data sheet total reset value of this register has these bits set (reset 0x1), but a live dump from a Hi3518E V200 board (OpenIPC U-Boot and SDK Linux, 2026-11-10) reads 0 in them, so hardware reads 0 here and the reset is modelled as 0.";
            sw = r;
            hw = w;
            reset = 0x0;
        } reserved_nz_2_2[2:2];

        field {
            name = "cipher_ret1n";
            desc = "mem ret1n signal in the cipher. Set this signal to 1 when the cipher is enabled or set this signal to 0 when the cipher is disabled to reduce mem power consumption.";
            sw = rw;
            hw = r;
            reset = 0x1;
        } cipher_ret1n[1:1];

        field {
            name = "bootram_ret1n";
            desc = "mem ret1n signal in the BOOTROM. Set this signal to 1 when the BOOTROM is enabled or set this signal to 0 when the BOOTROM is disabled to reduce mem power consumption.";
            sw = rw;
            hw = r;
            reset = 0x1;
        } bootram_ret1n[0:0];
    } MISC_CTRL4 @ 0x10;

    reg {
        name = "MISC register 6";
        desc = "MISC_CTRL6 is MISC register 6.

Data sheet 3.5.5.2 MISC_CTRL6 (offset 0x18, printed page 3-65, `hi3518ev200-datasheet.txt` line 25737).";

        enum MISC_CTRL6_sysaxi_timeout_en_m2_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
