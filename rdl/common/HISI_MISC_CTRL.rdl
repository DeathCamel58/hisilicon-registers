        field {
            name = "sysaxi_timeout_value_m1";
            desc = "Timeout count value of the SYS AXI bus M1 port (CPU) Count value = sysaxi_timeout_value_m1 x 2";
            sw = rw;
            hw = r;
            reset = 0x0;
        } sysaxi_timeout_value_m1[14:0];
    } MISC_CTRL6 @ 0x18;

    reg {
        name = "MISC register 7";
        desc = "MISC_CTRL7 is MISC register 7.

Data sheet 3.5.5.2 MISC_CTRL7 (offset 0x1C, printed page 3-66, `hi3518ev200-datasheet.txt` line 25786).";

