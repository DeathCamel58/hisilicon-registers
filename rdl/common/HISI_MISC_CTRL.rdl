    reg {
        name = "MISC register 30";
        desc = "MISC_CTRL30 is MISC register 30.

USB controller/PHY glue (DS 12.7.3): host mode = usb_chipid 0 with both pull-downs (usb2_phy_dmpulldown/dppulldown) set to 1; device mode = usb_chipid 1 with both pull-downs 0. usbpwr_pctrl / usbovr_p_ctrl set the polarity of USB_PWREN and USB0/1_OVRCUR. Vendor U-Boot (hiusb-3518ev200.c) clears ss_word_if_i (8-bit UTMI), clears ss_ena_incr16_i, sets usbovr_p_ctrl, then writes the PHY tuning register at MISC + 0x80 (MISC_CTRL32, not in the data sheet).

Hardware (Hi3518E V200 board, OpenIPC U-Boot and SDK Linux 4.9.37, live dump 2026-11-10): reads 0x0C0311A0 in both, i.e. the reset value 0x0C0313A0 with only ss_ena_incr16_i cleared, as the vendor sequence does (ss_word_if_i 0 = 8-bit UTMI, usbovr_p_ctrl 1, port_pwr_en 1, both pull-downs 1 = host mode). The SDK leaves usb_chipid 0.

Data sheet 3.5.5.2 MISC_CTRL30 (offset 0x78, printed page 3-76, `hi3518ev200-datasheet.txt` line 26348).";

        enum MISC_CTRL30_usb_chipid_enum {
            HOST = 0 { name = "Host"; desc = "host"; };
            DEVICE = 1 { name = "Device"; desc = "device"; };
        };

        field {
            name = "usb_chipid";
            desc = "Host and device switching control";
            sw = rw;
            hw = r;
            encode = MISC_CTRL30_usb_chipid_enum;
            reset = 0x0;
        } usb_chipid[31:31];

        enum MISC_CTRL30_usb2_phy_dmpulldown_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "usb2_phy_dmpulldown";
            desc = "D- pull-down resistor enable";
            sw = rw;
            hw = r;
            encode = MISC_CTRL30_usb2_phy_dmpulldown_enum;
            reset = 0x1;
        } usb2_phy_dmpulldown[27:27];

        enum MISC_CTRL30_usb2_phy_dppulldown_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "usb2_phy_dppulldown";
            desc = "D+ pull-down resistor enable";
            sw = rw;
            hw = r;
            encode = MISC_CTRL30_usb2_phy_dppulldown_enum;
            reset = 0x1;
        } usb2_phy_dppulldown[26:26];

        enum MISC_CTRL30_ss_scaledown_mode_enum {
            SCALE_DOWN_DISABLED = 0 { name = "Scale Down Disabled"; desc = "Scale-down is disabled for all timings, and the actual timings are used."; };
            SCALE_DOWN_ENABLED = 1 { name = "Scale Down Enabled"; desc = "Scale-down is enabled for all timings except the suspended and resumed timings in device mode."; };
            SCALE_DOWN_ENABLED_2 = 2 { name = "Scale Down Enabled 2"; desc = "Scale-down is enabled only for the suspended and resumed timings in device mode."; };
            SCALE_DOWN_TIMINGS = 3 { name = "Scale Down Timings"; desc = "Scale-down timings of bit 0 and bit 1 are enabled."; };
