`ifndef HISI_VDP_RDL
`define HISI_VDP_RDL

regfile eHISI_VDP_VHDP {
    name = "VHD video layer region m registers";
    desc = "The six per-region registers of the VHD layer; region m (m = 0..15) is at 0x400 + m x 0x20 (data sheet: VHDPmRESO 0x0400+m x 0x20, VHDPmLADDR 0x0404+..., VHDPmCADDR 0x0408+..., VHDPmSTRIDE 0x040C+..., VHDPmVFPOS 0x0410+..., VHDPmVLPOS 0x0414+...). Offsets here are relative to the region.";

    reg {
        name = "VHD region 0 resolution register (non-instant register)";
        desc = "VHDPmRESO is a VHD region 0 resolution register (non-instant register).

Data sheet 11.2.4 VHDPmRESO (offset 0x400, printed page 11-100, `datasheet.txt` line 38238).";

        field {
            name = "w";
            desc = "Width (in pixel). The value is the actual width minus 1. Note: The actual width must be an even number.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } w_f[11:0];
    } VHDPRESO @ 0x0;

    reg {
        name = "VHD region m address register";
        desc = "VHDPmLADDR is a VHD region m address register.

Data sheet 11.2.4 VHDPmLADDR (offset 0x404, printed page 11-101, `datasheet.txt` line 38273).";

        field {
            name = "surface_addr";
            desc = "Start address of VHD region m.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } surface_addr[31:0];
    } VHDPLADDR @ 0x4;

    reg {
        name = "VHD region m chrominance address register";
        desc = "VHDPmCADDR is a VHD region m chrominance address register.

Data sheet 11.2.4 VHDPmCADDR (offset 0x408, printed page 11-101, `datasheet.txt` line 38295).";

        field {
            name = "surface_addr";
            desc = "Chrominance start address of VHD region m.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } surface_addr[31:0];
    } VHDPCADDR @ 0x8;

    reg {
        name = "VHD region m stride register";
        desc = "VHDPmSTRIDE is a VHD region m stride register.

Data sheet 11.2.4 VHDPmSTRIDE (offset 0x40C, printed page 11-101, `datasheet.txt` line 38317).";

        field {
            name = "surface_cstride";
            desc = "Stride of the chrominance buffer of VHD region m (valid in semi- planar format), 128-bit alignment.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } surface_cstride[31:16];

        field {
            name = "surface_stride";
            desc = "Stride of the buffer of VHD region m (valid in semi-planar format, luminance stride), 128-bit alignment.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } surface_stride[15:0];
    } VHDPSTRIDE @ 0xC;

    reg {
        name = "VHD region m video start position register (non-instant register)";
        desc = "VHDPmVFPOS is a VHD region m video start position register (non-instant register). The start position is in the unit of pixel.

Data sheet 11.2.4 VHDPmVFPOS (offset 0x410, printed page 11-102, `datasheet.txt` line 38356).";

        field {
            name = "video_yfpos";
            desc = "Start coordinates of the video column. The frame height is referenced and the unit is line.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } video_yfpos[23:12];

        field {
            name = "video_xfpos";
            desc = "Start coordinates of the video row.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } video_xfpos[11:0];
    } VHDPVFPOS @ 0x10;

    reg {
        name = "VHD region m video end position register (non-instant register)";
        desc = "VHDPmVLPOS is the VHD region m video end position register (non-instant register). The end position is in the unit of pixel.

Data sheet 11.2.4 VHDPmVLPOS (offset 0x414, printed page 11-102, `datasheet.txt` line 38383).";

        field {
            name = "video_ylpos";
            desc = "Start coordinates of the video column. The frame height is referenced and the unit is line.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } video_ylpos[23:12];

        field {
            name = "video_xlpos";
            desc = "Start coordinates of the video row.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } video_xlpos[11:0];
    } VHDPVLPOS @ 0x14;

};

regfile eHISI_VDP_VSD {
    name = "VSD video layer registers";
    desc = "Registers of one standard-definition video layer; VSDi (i = 0..1) is at 0x3000 + i x 0x1000 (data sheet VSDiXXX registers, offsets 0x3000+i x 0x1000 ...). Offsets here are relative to the layer start (0x000 = VSDiCTRL ... 0xC04 = VSDi16REGIONEN).";

    reg {
        name = "VSD control register (non-instant register)";
        desc = "VSDiCTRL is a VSD control register (non-instant register). It is used to configure the layer information

Data sheet 11.2.4 VSDiCTRL (offset 0x3000, printed page 11-105, `datasheet.txt` line 38507).";

        enum VSDCTRL_surface_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "surface_en";
            desc = "Surface enable (non-instant register).";
            sw = rw;
            hw = r;
            encode = VSDCTRL_surface_en_enum;
            reset = 0x0;
        } surface_en[31:31];

        enum VSDCTRL_ifir_mode_enum {
            RESERVED = 0 { name = "Reserved"; desc = "reserved"; };
            CHROMINANCE_IFIR_COPY = 1 { name = "Chrominance Ifir Copy"; desc = "chrominance IFIR copy mode"; };
            BILINEAR_INTERPOLATION = 2 { name = "Bilinear Interpolation"; desc = "bilinear interpolation"; };
            V_6_TAP_FIR = 3 { name = "V 6 Tap Fir"; desc = "6-tap FIR"; };
        };

        field {
            name = "ifir_mode";
            desc = "Horizontal chrominance IFIR mode.";
            sw = rw;
            hw = r;
            encode = VSDCTRL_ifir_mode_enum;
            reset = 0x0;
        } ifir_mode[19:18];

        enum VSDCTRL_vup_mode_enum {
            UPDATE_FIELD = 0 { name = "Update Field"; desc = "update by field"; };
            UPDATE_FRAME = 1 { name = "Update Frame"; desc = "update by frame"; };
        };

        field {
            name = "vup_mode";
            desc = "Register update mode.";
            sw = rw;
            hw = r;
            encode = VSDCTRL_vup_mode_enum;
            reset = 0x0;
        } vup_mode[17:17];

        enum VSDCTRL_ifmt_enum {
            SPYCBCR420 = 3 { name = "Spycbcr420"; desc = "SPYCbCr420"; };
            SPYCBCR422_OTHER_VALUES = 4 { name = "Spycbcr422 Other Values"; desc = "SPYCbCr422 Other values: reserved"; };
        };

        field {
            name = "ifmt";
            desc = "Input data format.";
            sw = rw;
            hw = r;
            encode = VSDCTRL_ifmt_enum;
            reset = 0x0;
        } ifmt[3:0];
    } VSDCTRL @ 0x0;

    reg {
        name = "VSD channel update enable register";
        desc = "VSDiUPD is a VSD channel update enable register.

Data sheet 11.2.4 VSDiUPD (offset 0x3004, printed page 11-106, `datasheet.txt` line 38563).";

        field {
            name = "regup";
            desc = "Surface register update. After the registers at this layer are configured, the registers are updated when the value 1 is written to this bit. After updates, this bit is cleared automatically by the hardware.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } regup[0:0];
    } VSDUPD @ 0x4;

    reg {
        name = "VSD current frame address register";
        desc = "VSDiCADDR is a VSD current frame address register. In package pixel format, the address is the address of the frame buffer; in semi-planar pixel format, the address is the address of the luminance frame buffer.

Data sheet 11.2.4 VSDiCADDR (offset 0x3010, printed page 11-106, `datasheet.txt` line 38594).";

        field {
            name = "surface_caddr";
            desc = "Address of the current frame.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } surface_caddr[31:0];
    } VSDCADDR @ 0x10;

    reg {
        name = "VSDCCADDR";
        desc = "Data sheet 11.2.4 VSDiCCADDR (offset 0x3014, printed page 11-107, `datasheet.txt` line 38628).";

        field {
            name = "surface_ccaddr";
            desc = "Chrominance address of the current frame.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } surface_ccaddr[31:0];
    } VSDCCADDR @ 0x14;

    reg {
        name = "VSD surface stride register";
        desc = "VSDiSTRIDE is a VSD surface stride register.

Data sheet 11.2.4 VSDiSTRIDE (offset 0x3024, printed page 11-107, `datasheet.txt` line 38650).";

        field {
            name = "surface_cstride";
            desc = "Stride of the chrominance frame buffer (valid in semi-planar format), 128-bit alignment.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } surface_cstride[31:16];

        field {
            name = "surface_stride";
            desc = "Stride of the frame buffer (valid in semi-planar format, luminance stride), 128-bit alignment.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } surface_stride[15:0];
    } VSDSTRIDE @ 0x24;

    reg {
        name = "VSD input resolution register (non-instant register)";
        desc = "VSDiIRESO is a VSD input resolution register (non-instant register).

Data sheet 11.2.4 VSDiIRESO (offset 0x3028, printed page 11-108, `datasheet.txt` line 38687).";

        field {
            name = "ih";
            desc = "Height (in line). The value is the actual height minus 1. The frame height is referenced.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } ih[23:12];

        field {
            name = "iw";
            desc = "Width (in pixel). The value is the actual width minus 1.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } iw[11:0];
    } VSDIRESO @ 0x28;

    reg {
