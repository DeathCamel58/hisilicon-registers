        enum DATE1_COEFF0_fm_sel_enum {
            SIN_USED_SECAM = 0 { name = "Sin Used Secam"; desc = "sin used for SECAM frequency modulation"; };
            COS_USED_SECAM = 1 { name = "Cos Used Secam"; desc = "cos used for SECAM frequency modulation"; };
        };

        field {
            name = "fm_sel";
            desc = "FMSECAM frequency modulation select.";
            sw = rw;
            hw = r;
            encode = DATE1_COEFF0_fm_sel_enum;
            reset = 0x0;
        } fm_sel[22:22];

        field {
            name = "style_sel";
            desc = "CVBS/S-Video output signal norm when this bit works with the scanline bit. When the scanline bit is 0 (525 scanned lines in a frame), the definition of the style_sel bit is as follows: 0x1: (M) NTSC 0x2: NTSC-J 0x4: (M) PAL Other values: reserved When the scanline bit is 1 (625 scanned lines in a frame), the definition of the style_sel bit is as follows: 0x1: (B, D, G, H, I) PAL 0x2: (N) PAL 0x4: (Nc) PAL 0x8: SECAM Other values: reserved";
            sw = rw;
            hw = r;
            reset = 0x1;
        } style_sel[21:18];

        field {
            name = "sync_mode_sel";
            desc = "bit[17]: specifies whether there are sync signals in three channels during component output. This bit takes effect only when the sync_mode_scart bit is set to 0. bit[17] is valid only when the intf_sel is set to 100 (component output enabled). The definition of bit[17] is as follows: 0: Only one channel contains sync signals using component output. 1: Three channels contain sync signals during component output. When bit[17] is set to 0, the sync channel must be the Y channel for YPbPr output and G channel for RGB output. bit[16]: specifies whether there are blanking radixes during RGB output. bit[16] is valid only when the intf_sel is set to 100 and the rgb_en bit is set to 1. The definition of bit[16] is as follows: 0: There are no blanking radixes during RGB output. 1: There are blanking radixes during RGB output.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } sync_mode_sel[17:16];

        enum DATE1_COEFF0_sync_mode_scart_enum {
            COMPONENT_SYNC_OUTPUT = 0 { name = "Component Sync Output"; desc = "Component sync output is configured based on sync_mode_sel[1]."; };
            COMPONENTS_THREE_CHANNELS = 1 { name = "Components Three Channels"; desc = "The components of the three channels are not overlaid and synchronized. In this case, sync_mode_sel bit[1] must be set to 0."; };
        };

        field {
            name = "sync_mode_scart";
            desc = "Overlay sync control of the components of three channels.";
            sw = rw;
            hw = r;
            encode = DATE1_COEFF0_sync_mode_scart_enum;
            reset = 0x0;
        } sync_mode_scart[15:15];

        enum DATE1_COEFF0_length_sel_enum {
            OUTPUT_ACCORDING_ACTIVE = 0 { name = "Output According Active"; desc = "output according to the active line width in BT.601 mode"; };
            OUTPUT_ACCORDING_ACTIVE_2 = 1 { name = "Output According Active 2"; desc = "output according to the active line width in BT.470 mode. When this bit is set to 0, the active width of the line is 720 pixels. When this bit is set to 1, the active width of the line is 704 pixels for the 625-line norm or 712 pixels for the 525-line norm. Currently, the BT.601 mode and BT.470 mode cannot be changed dynamically. You can change the mode only after reset. The BT.601 mode is recommended and this mode is the default value after power-on reset."; };
        };

        field {
            name = "length_sel";
