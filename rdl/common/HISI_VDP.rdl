regfile eHISI_VDP {
    name = "HiSilicon video display processor";
    desc = "
    HiSilicon video display processor (VDP) at 0x205C0000, GIC interrupt ID 67. Reads video and graphics layers from DDR over AXI, overlays them (crossbar/mixer CBM) and drives the display channels: video layers VHD0 (HD, scaler ZME, 16 \"regions\" per layer: VHDPmxxx), VSD0/VSD1 (SD), graphics layers G0, G2, G3 (G0 with decompression DCMP registers), cursor layer HC0, write-back channel WBC2, display channels DHD0 (HD: HDMI/VGA), DSD0 and DSD1 (SD/CVBS with the DATE and DATE1 TV encoders), plus a PARA block that loads the ZME coefficient tables (VHD H/V luma/chroma coefficients at 0xD000.., WBC coefficients at 0xE000..). Registers and reset values are from Hi3520D/Hi3515A/Hi3515C data sheet issue 07, chapter 11.2 (`datasheet.txt` lines 35754-48186; the data sheet notes the Hi3520D VDP base 0x205C0000 and the register addressing at line 35930). The VDP is almost entirely \"non-instant\" registers: write the register, then pulse the layer or channel `*UPD` (update) bit; the register groups are updated on the vertical blanking of the display channel. Arrays: VHDPm* m = 0..15 stride 0x20 (`VHDP*` below), VSDi* i = 0..1 stride 0x1000 (`VSD*`). The vendor U-Boot VO code (`product/hiosd/vo/hi3520d/vou_reg.h`, \"Created file for 3520D\") has the same register set as C unions; offsets and names were not cross-checked field by field (that header is generated from the same RTL tables) but the layer/channel structure agrees. Not hardware verified.
    ";

    reg {
        name = "VHD control register";
        desc = "VHDCTRL is a VHD control register (non-instant register). It is used to configure the layer information

Data sheet 11.2.4 VHDCTRL (offset 0x0, printed page 11-84, `datasheet.txt` line 37272).";

        enum VHDCTRL_surface_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "surface_en";
            desc = "Surface enable (non-instant field).";
            sw = rw;
            hw = r;
            encode = VHDCTRL_surface_en_enum;
            reset = 0x0;
        } surface_en[31:31];

        enum VHDCTRL_ifir_mode_enum {
            RESERVED = 0 { name = "Reserved"; desc = "reserved"; };
            CHROMINANCE_IFIR_COPY = 1 { name = "Chrominance Ifir Copy"; desc = "chrominance IFIR copy mode"; };
            BILINEAR_INTERPOLATION = 2 { name = "Bilinear Interpolation"; desc = "bilinear interpolation"; };
            V_6_TAP_FIR = 3 { name = "V 6 Tap Fir"; desc = "6-tap FIR"; };
        };

        field {
            name = "ifir_mode";
            desc = "Horizontal chrominance IFIR mode.";
            sw = rw;
            hw = r;
            encode = VHDCTRL_ifir_mode_enum;
            reset = 0x0;
        } ifir_mode[19:18];

        enum VHDCTRL_vup_mode_enum {
