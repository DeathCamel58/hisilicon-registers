            UPDATE_FRAME = 1 { name = "Update Frame"; desc = "update by frame"; };
        };

        field {
            name = "vup_mode";
            desc = "Register update mode.";
            sw = rw;
            hw = r;
            encode = VHDCTRL_vup_mode_enum;
            reset = 0x0;
        } vup_mode[17:17];

        enum VHDCTRL_ifmt_enum {
            SPYCBCR420 = 3 { name = "Spycbcr420"; desc = "SPYCbCr420"; };
            SPYCBCR422_OTHER_VALUES = 4 { name = "Spycbcr422 Other Values"; desc = "SPYCbCr422 Other values: reserved"; };
        };

        field {
            name = "ifmt";
            desc = "Input data format.";
            sw = rw;
            hw = r;
            encode = VHDCTRL_ifmt_enum;
            reset = 0x0;
        } ifmt[3:0];
    } VHDCTRL @ 0x0;

    reg {
        name = "VHD channel update enable register";
        desc = "VHDUPD is a VHD channel update enable register.

Data sheet 11.2.4 VHDUPD (offset 0x4, printed page 11-85, `datasheet.txt` line 37325).";

