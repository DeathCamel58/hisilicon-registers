            desc = "Horizontal luminance scaling/filtering coefficient. Indicates the tap-2 coefficients when bits[3:0] of the register address are 0x0. Indicates the tap-4 coefficients when bits[3:0] of the register address are 0x4. Indicates the tap-6 coefficients when bits[3:0] of the register address are 0x8. Indicates the tap-8 coefficients when bits[3:0] of the register address are 0xC.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } hlcoefn2[25:16];

