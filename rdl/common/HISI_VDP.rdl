    reg {
        name = "VSD input DC component register for CSC (instant register)";
        desc = "VSDiCSCIDC is a VSD input DC component register for CSC (instant register).

Data sheet 11.2.4 VSDiCSCIDC (offset 0x3080, printed page 11-110, `datasheet.txt` line 38836).";

        enum VSDCSCIDC_csc_en_enum {
