            ENABLED_WHEN_THIS = 1 { name = "Enabled When This"; desc = "enabled When this bit is 1, the value of the FMC read component status register is written in the FMC_STATUS[fm_status] instead of the internal butter."; };
        };

        field {
            name = "read_status_en";
            desc = "Read component status register enable";
            sw = rw;
            hw = r;
            encode = FMC_OP_read_status_en_enum;
            reset = 0x0;
        } read_status_en[1:1];

        enum FMC_OP_reg_op_start_enum {
