            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "addr_en";
            desc = "Enable for writing the operation address to the flash";
            sw = rw;
            hw = r;
            encode = FMC_OP_addr_en_enum;
            reset = 0x0;
        } addr_en[6:6];

        enum FMC_OP_write_data_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED_NOTE_READ = 1 { name = "Enabled Note Read"; desc = "enabled Note: read_data_en and write_data_en cannot be 1 at the same time."; };
        };

        field {
            name = "write_data_en";
            desc = "Enable for writing data to the flash";
            sw = rw;
            hw = r;
