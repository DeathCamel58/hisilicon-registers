    reg {
        name = "Operation register";
        desc = "FMC_OP is an operation register.

Register-mode operation trigger. Software sets the enable bits that describe the sequence (cmd1_en, addr_en, dummy_en, write_data_en / read_data_en, read_status_en) and sets reg_op_start (bit 0); the controller clears reg_op_start when the operation has finished. Data transfers go through the 4 KB+256 B internal buffer at the FMC memory window. Values used by the DS examples: 0x81 (cmd1 + start), 0x3 (read status + start), 0xC1 (cmd1 + addr + start).

Data sheet 4.2.7.2 FMC_OP (offset 0x3C, printed page 4-213, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 43641).";

        enum FMC_OP_dummy_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "dummy_en";
            desc = "Dummy byte transfer enable after the address operation is enabled";
            sw = rw;
            hw = r;
            encode = FMC_OP_dummy_en_enum;
            reset = 0x0;
        } dummy_en[8:8];

        enum FMC_OP_cmd1_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
