`ifndef HISI_FMC_RDL
`define HISI_FMC_RDL


regfile eHISI_FMC {
    name = "HiSilicon flash memory controller v100 (SPI NOR / SPI NAND)";
    desc = "
    HiSilicon flash memory controller (FMC) v100 at 0x10010000 (\"hifmc100\"; VERSION register 0x100): one controller for SPI NOR flash and SPI NAND flash on the two chip selects SFC_CS0N / SFC_CS1N (standard, dual, dual I/O, quad and quad I/O SPI, 3- or 4-byte NOR addresses, 2 KB / 4 KB NAND pages, 8-bit and 24-bit BCH ECC per 1 KB). It replaces the older HISFC350 (`eHISI_SFC_350`) of the Hi3520D/Hi3518 V100 generation: the register layout is different (FMC_CFG / FMC_OP / FMC_OP_CTRL), see `HISI_SFC_350.rdl` for that IP.
    The controller powers up in boot mode (FMC_CFG.op_mode = 0): the first 1 MB of the flash is readable at the boot window (0x00000000 after reset, remapped; DS 4.2.3.3), the flash storage space is the 64 MB window at 0x58000000 (DS Table 1-4) used in normal mode. Register mode (FMC_CMD/ADDR/OP_CFG/OP + the 4 KB+256 B on-chip buffer) is used for IDs, status, erase and feature accesses; DMA mode (FMC_DMA_*, FMC_OP_CTRL) moves data directly to/from DDR. Interrupt: FMC_INT (VIC interrupt, see the interrupt table of the SoC file). Clock and reset: PERI_CRG48 (0x20030000 + 0xC0): srst bit 0, clock enable bit 1, clock select bits 3:2 (0 = 24 MHz, 1 = 148.5 MHz, 2 = 125 MHz, 3 = 198 MHz); PERI_CRG65 (0x104) holds the FMC mux-IO clock select. The vendor U-Boot (hifmc_hi3518ev200.c) boots the controller at 24 MHz and raises the clock once the flash is identified.
    Registers, resets and bit descriptions are from the Hi3518E V20X/Hi3516C V200 data sheet issue 02 (2017-06-12), section 4.2.7 (`datasheet` text lines 43099-44288), cross-checked against the vendor U-Boot hifmc100 driver and 'include/hifmc_common.h` and the Linux `hisi-sfc.c` / `hifmc100` drivers (all offsets used by those drivers agree with the data sheet). Where the vendor header uses bits the data sheet calls reserved, they are modelled as fields and flagged \"not in the data sheet\". Boot-mode pin straps (DS 1.3): BOOTROM_SEL (MDCK pin) 0 and BOOT_SEL (EPHY_RST pin) 0 = boot from SPI flash; SFC_DEVICE_MODE (SHUTTER_TRIG pin) 0 = SPI NOR, 1 = SPI NAND; SFC_EMMC_BOOT_MODE (FLASH_TRIG pin) 0/1 = NOR 3-/4-byte address mode or NAND 1-/4-wire boot.
";

    reg {
        name = "Component configuration register";
        desc = "FMC_CFG is a component configuration register.

Vendor driver values (hifmc_common.h): flash_sel 0 = SPI NOR, 1 = SPI NAND, 2 = parallel NAND (not wired on this SoC), 3 = default; ecc_type 0..6 (0/8/16/24/28/40/64 bit) exist in the shared vendor header, the data sheet only documents 000, 001 and 011 for this chip; block_size 1..3 (128/256/512 pages) likewise. The reset value of flash_sel follows the boot pins (SFC_DEVICE_MODE, DS 1.3.3); the data sheet's Total Reset Value 0x1820 assumes SPI NOR with ecc_type 1.

Data sheet 4.2.7.2 FMC_CFG (offset 0x0, printed page 4-205, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 43179).";

        field {
            name = "spi_nand_sel";
            desc = "Not in the data sheet (reserved there); taken from the vendor driver header 'include/hifmc_common.h` (sources/u-boot-vendor-2010.06) (`FMC_CFG_SPI_NAND_SEL`, `SPI_NAND_SEL_MASK` = 0x3 << 11; manufacturer class of the SPI NAND: 0 other, 1 Winbond, 2 ESMT, 3 Micron). The data sheet marks bits [31:11] reserved but its bit diagram and Total Reset Value (0x1820) have bits 12:11 set, so they are modelled here with reset 3.";
            sw = rw;
            hw = r;
            reset = 0x3;
        } spi_nand_sel[12:11];

        field {
            name = "spi_nor_addr_mode";
            desc = "SPI address mode (valid only for the SPI NOR flash) 0 (default): 3-byte address mode 1: 4-byte address mode";
            sw = rw;
            hw = r;
            reset = 0x0;
        } spi_nor_addr_mode[10:10];

        field {
            name = "block_size";
            desc = "Block size of the SPI NAND flash 00: 64 pages Other values: reserved";
            sw = rw;
            hw = r;
            reset = 0x0;
        } block_size[9:8];

        enum FMC_CFG_ecc_type_enum {
            NO_ECC = 0 { name = "No Ecc"; desc = "no ECC"; };
            V_8_BIT_ECC = 1 { name = "V 8 Bit Ecc"; desc = "8-bit ECC"; };
            V_24_BIT_ECC = 3 { name = "V 24 Bit Ecc"; desc = "24-bit ECC Other values: reserved"; };
        };

        field {
            name = "ecc_type";
            desc = "ECC type of the controller";
            sw = rw;
            hw = r;
            encode = FMC_CFG_ecc_type_enum;
            reset = 0x1;
        } ecc_type[7:5];

        enum FMC_CFG_page_size_enum {
            V_2_KB_PAGE = 0 { name = "V 2 Kb Page"; desc = "2 KB page size"; };
            V_4_KB_PAGE = 1 { name = "V 4 Kb Page"; desc = "4 KB page size Other values: reserved"; };
        };

        field {
            name = "page_size";
            desc = "Page size of the SPI NAND flash";
            sw = rw;
            hw = r;
            encode = FMC_CFG_page_size_enum;
            reset = 0x0;
        } page_size[4:3];

        enum FMC_CFG_flash_sel_enum {
            SPI_NOR_FLASH = 0 { name = "Spi Nor Flash"; desc = "SPI NOR flash"; };
            SPI_NAND_FLASH = 1 { name = "Spi Nand Flash"; desc = "SPI NAND flash Other values: reserved The reset value is determined by the pin."; };
        };

        field {
            name = "flash_sel";
            desc = "Flash type select";
            sw = rw;
            hw = r;
            encode = FMC_CFG_flash_sel_enum;
            reset = 0x0;
        } flash_sel[2:1];

        enum FMC_CFG_op_mode_enum {
            BOOT_MODE = 0 { name = "Boot Mode"; desc = "boot mode"; };
            NORMAL_MODE = 1 { name = "Normal Mode"; desc = "normal mode"; };
        };

        field {
            name = "op_mode";
            desc = "FMC operation mode";
            sw = rw;
            hw = r;
            encode = FMC_CFG_op_mode_enum;
            reset = 0x0;
        } op_mode[0:0];
    } FMC_CFG @ 0x0;

    reg {
        name = "Global configuration register";
        desc = "GLOBAL_CFG is a global configuration register.

wp_en drives the WP pin low while 1 (reset 1). The Linux `hisi-sfc` driver and the U-Boot hifmc100 driver both define `FMC_GLOBAL_CFG_WP_ENABLE` = bit 6.

Data sheet 4.2.7.2 GLOBAL_CFG (offset 0x4, printed page 4-206, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 43241).";

        enum GLOBAL_CFG_wp_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "wp_en";
            desc = "Write protection enable for the WP pin. When this bit is enabled, the chip outputs 0 to the WP pin.";
            sw = rw;
            hw = r;
            encode = GLOBAL_CFG_wp_en_enum;
            reset = 0x1;
        } wp_en[6:6];

        field {
            name = "randomizer_en";
            desc = "Not in the data sheet (reserved there); taken from the vendor driver header 'include/hifmc_common.h` (sources/u-boot-vendor-2010.06) (`FMC_GLOBAL_CFG_RANDOMIZER_EN`, bit 2; used by the parallel-NAND flow of the shared hifmc code; the data sheet marks it reserved).";
            sw = rw;
            hw = r;
            reset = 0x0;
        } randomizer_en[2:2];
    } GLOBAL_CFG @ 0x4;

    reg {
        name = "SPI timing configuration register";
        desc = "TIMING_SPI_CFG is an SPI timing configuration register.

The vendor drivers program tcsh = 6, tcss = 6, tshsl = 0xF (`CS_HOLD_TIME`, `CS_SETUP_TIME`, `CS_DESELECT_TIME`), which equal the reset value 0x66F.

Data sheet 4.2.7.2 TIMING_SPI_CFG (offset 0x8, printed page 4-206, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 43268).";

        field {
            name = "tcsh";
            desc = "CS hold time 0x0-0x7: (n + 1) interface clock cycles (n = 0, 1, 2, …, 7)";
            sw = rw;
            hw = r;
            reset = 0x6;
        } tcsh[11:8];

        field {
            name = "tcss";
            desc = "CS setup time 0x0-0x7: (n + 1) interface clock cycles (n = 0, 1, 2, …, 7)";
            sw = rw;
            hw = r;
            reset = 0x6;
        } tcss[7:4];

        field {
            name = "tshsl";
            desc = "CS deselect time. It is equal to the interval between two flash operations. 0x0-0xF: (n + 1) interface clock cycles (n = 0, 1, 2, …, 15)";
            sw = rw;
            hw = r;
            reset = 0xF;
        } tshsl[3:0];
    } TIMING_SPI_CFG @ 0x8;

    reg {
        name = "Interrupt status register";
        desc = "FMC_INT is an interrupt status register.

The status bits are read-only; clear them through FMC_INT_CLR. After a register-mode operation software polls FMC_OP[0] (reg_op_start) or waits for op_done_int.

Data sheet 4.2.7.2 FMC_INT (offset 0x18, printed page 4-207, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 43306).";

        enum FMC_INT_ahb_op_int_enum {
            NO_INTERRUPT_GENERATED = 0 { name = "No Interrupt Generated"; desc = "No interrupt is generated."; };
            INTERRUPT_GENERATED = 1 { name = "Interrupt Generated"; desc = "An interrupt is generated."; };
        };

        field {
            name = "ahb_op_int";
            desc = "CPU read/write internal buffer interrupt enable when the FMC is reading/writing data from/to the flash memory";
            sw = r;
            hw = w;
            encode = FMC_INT_ahb_op_int_enum;
            reset = 0x0;
        } ahb_op_int[7:7];

        field {
            name = "wr_lock_int";
            desc = "Not in the data sheet (reserved there); taken from the vendor driver header 'include/hifmc_common.h` (sources/u-boot-vendor-2010.06) (`FMC_INT_WR_LOCK`, bit 6; the data sheet marks it reserved). Write-lock violation interrupt.";
            sw = r;
            hw = w;
            reset = 0x0;
        } wr_lock_int[6:6];

        enum FMC_INT_dma_err_int_enum {
            NO_INTERRUPT_GENERATED = 0 { name = "No Interrupt Generated"; desc = "No interrupt is generated."; };
            INTERRUPT_GENERATED = 1 { name = "Interrupt Generated"; desc = "An interrupt is generated."; };
        };

        field {
            name = "dma_err_int";
            desc = "DMA transfer bus error interrupt";
            sw = r;
            hw = w;
            encode = FMC_INT_dma_err_int_enum;
            reset = 0x0;
        } dma_err_int[5:5];

        enum FMC_INT_err_alarm_int_enum {
            NO_INTERRUPT_GENERATED = 0 { name = "No Interrupt Generated"; desc = "No interrupt is generated."; };
            INTERRUPT_GENERATED = 1 { name = "Interrupt Generated"; desc = "An interrupt is generated."; };
        };

        field {
            name = "err_alarm_int";
            desc = "ECC alarm interrupt. An interrupt is generated when the number of error bits reaches the preset threshold.";
            sw = r;
            hw = w;
            encode = FMC_INT_err_alarm_int_enum;
            reset = 0x0;
        } err_alarm_int[4:4];

        enum FMC_INT_err_inval_int_enum {
            NO_INTERRUPT_GENERATED = 0 { name = "No Interrupt Generated"; desc = "No interrupt is generated."; };
            INTERRUPT_GENERATED = 1 { name = "Interrupt Generated"; desc = "An interrupt is generated."; };
        };

        field {
            name = "err_inval_int";
            desc = "Uncorrectable ECC error interrupt In 8-bit ECC mode, if errors occur in eight or more bits of the checked 1024-byte data, an interrupt is generated. In 24-bit ECC mode, if errors occur in 24 or more bits of the checked 1024-byte data, an interrupt is generated.";
            sw = r;
            hw = w;
            encode = FMC_INT_err_inval_int_enum;
            reset = 0x0;
        } err_inval_int[3:3];

        enum FMC_INT_err_val_int_enum {
            NO_INTERRUPT_GENERATED = 0 { name = "No Interrupt Generated"; desc = "No interrupt is generated."; };
            INTERRUPT_GENERATED = 1 { name = "Interrupt Generated"; desc = "An interrupt is generated."; };
        };

        field {
            name = "err_val_int";
            desc = "Correctable ECC error interrupt In 8-bit ECC mode, if errors occur in one to eight bits of the checked 1024-byte data, an interrupt is generated. In 24-bit ECC mode, if errors occur in one to 24 bits of the checked 1024-byte data, an interrupt is generated.";
            sw = r;
            hw = w;
            encode = FMC_INT_err_val_int_enum;
            reset = 0x0;
        } err_val_int[2:2];

        enum FMC_INT_op_fail_int_enum {
            NO_INTERRUPT_GENERATED = 0 { name = "No Interrupt Generated"; desc = "No interrupt is generated."; };
            INTERRUPT_GENERATED = 1 { name = "Interrupt Generated"; desc = "An interrupt is generated."; };
        };

        field {
            name = "op_fail_int";
            desc = "Programming (timeout) failure interrupt in DMA mode";
            sw = r;
            hw = w;
            encode = FMC_INT_op_fail_int_enum;
            reset = 0x0;
        } op_fail_int[1:1];

        enum FMC_INT_op_done_int_enum {
            NO_INTERRUPT_GENERATED = 0 { name = "No Interrupt Generated"; desc = "No interrupt is generated."; };
            INTERRUPT_GENERATED = 1 { name = "Interrupt Generated"; desc = "An interrupt is generated."; };
        };

        field {
            name = "op_done_int";
            desc = "Current controller operation completion interrupt. This bit is automatically cleared when the operation register is written.";
            sw = r;
            hw = w;
            encode = FMC_INT_op_done_int_enum;
            reset = 0x0;
        } op_done_int[0:0];
    } FMC_INT @ 0x18;

    reg {
        name = "Interrupt enable register";
        desc = "FMC_INT_EN is an interrupt enable register.

Data sheet 4.2.7.2 FMC_INT_EN (offset 0x1C, printed page 4-208, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 43379).";

        enum FMC_INT_EN_ahb_op_int_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "ahb_op_int_en";
            desc = "CPU read/write internal buffer error interrupt enable when the FMC is reading/writing data from/to the flash memory";
            sw = rw;
            hw = r;
            encode = FMC_INT_EN_ahb_op_int_en_enum;
            reset = 0x0;
        } ahb_op_int_en[7:7];

        field {
            name = "wr_lock_int_en";
            desc = "Not in the data sheet (reserved there); taken from the vendor driver header 'include/hifmc_common.h` (sources/u-boot-vendor-2010.06) (`FMC_INT_EN_WR_LOCK`, bit 6; reserved RW in the data sheet).";
            sw = rw;
            hw = r;
            reset = 0x0;
        } wr_lock_int_en[6:6];

        enum FMC_INT_EN_dma_err_int_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "dma_err_int_en";
            desc = "DMA transfer bus error interrupt enable";
            sw = rw;
            hw = r;
            encode = FMC_INT_EN_dma_err_int_en_enum;
            reset = 0x0;
        } dma_err_int_en[5:5];

        enum FMC_INT_EN_err_alarm_int_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "err_alarm_int_en";
            desc = "ECC alarm interrupt enable. An interrupt is generated when the number of error bits reaches the threshold";
            sw = rw;
            hw = r;
            encode = FMC_INT_EN_err_alarm_int_en_enum;
            reset = 0x0;
        } err_alarm_int_en[4:4];

        enum FMC_INT_EN_err_inval_int_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "err_inval_int_en";
            desc = "ECC uncorrectable error interrupt enable";
            sw = rw;
            hw = r;
            encode = FMC_INT_EN_err_inval_int_en_enum;
            reset = 0x0;
        } err_inval_int_en[3:3];

        enum FMC_INT_EN_err_val_int_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "err_val_int_en";
            desc = "ECC correctable error interrupt enable";
            sw = rw;
            hw = r;
            encode = FMC_INT_EN_err_val_int_en_enum;
            reset = 0x0;
        } err_val_int_en[2:2];

        enum FMC_INT_EN_op_fail_int_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "op_fail_int_en";
            desc = "Programming operation failure interrupt enable in DMA mode";
            sw = rw;
            hw = r;
            encode = FMC_INT_EN_op_fail_int_en_enum;
            reset = 0x0;
        } op_fail_int_en[1:1];

        enum FMC_INT_EN_op_done_int_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "op_done_int_en";
            desc = "Current operation completion interrupt enable of the FMC";
            sw = rw;
            hw = r;
            encode = FMC_INT_EN_op_done_int_en_enum;
            reset = 0x0;
        } op_done_int_en[0:0];
    } FMC_INT_EN @ 0x1C;

    reg {
        name = "Interrupt clear register";
        desc = "FMC_INT_CLR is an interrupt clear register.

Data sheet 4.2.7.2 FMC_INT_CLR (offset 0x20, printed page 4-210, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 43452).";

        field {
            name = "ahb_op_int_clr";
            desc = "ahb_op_err interrupt clear. Writing 1 clears the interrupt.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            reset = 0x0;
        } ahb_op_int_clr[7:7];

        field {
            name = "wr_lock_int_clr";
            desc = "Not in the data sheet (reserved there); taken from the vendor driver header 'include/hifmc_common.h` (sources/u-boot-vendor-2010.06) (`FMC_INT_CLR_WR_LOCK`, bit 6; reserved in the data sheet). Writing 1 clears the interrupt.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            reset = 0x0;
        } wr_lock_int_clr[6:6];

        field {
            name = "dma_err_int_clr";
            desc = "DMA transfer bus error interrupt clear. Writing 1 clears the interrupt.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            reset = 0x0;
        } dma_err_int_clr[5:5];

        field {
            name = "err_alarm_int_clr";
            desc = "err_alarm interrupt clear. Writing 1 clears the interrupt.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            reset = 0x0;
        } err_alarm_int_clr[4:4];

        field {
            name = "err_inval_int_clr";
            desc = "err_invalid interrupt clear. Writing 1 clears the interrupt.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            reset = 0x0;
        } err_inval_int_clr[3:3];

        field {
            name = "err_val_int_clr";
            desc = "err_valid interrupt clear. Writing 1 clears the interrupt.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            reset = 0x0;
        } err_val_int_clr[2:2];

        field {
            name = "op_fail_int_clr";
            desc = "op_fail interrupt clear. Writing 1 clears the interrupt.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            reset = 0x0;
        } op_fail_int_clr[1:1];

        field {
            name = "op_done_int_clr";
            desc = "op_done interrupt clear. Writing 1 clears the interrupt.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            reset = 0x0;
        } op_done_int_clr[0:0];
    } FMC_INT_CLR @ 0x20;

    reg {
        name = "Command word configuration register";
        desc = "FMC_CMD is a command word configuration register.

Data sheet 4.2.7.2 FMC_CMD (offset 0x24, printed page 4-210, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 43487).";

        field {
            name = "cmd2";
            desc = "Not in the data sheet (reserved there); taken from the vendor driver header 'include/hifmc_common.h` (sources/u-boot-vendor-2010.06) (`FMC_CMD_CMD2`, bits 15:8, second command byte sent when FMC_OP.cmd2_en is 1, used by the SPI NAND/parallel NAND flow; reserved in the data sheet).";
            sw = rw;
            hw = r;
            reset = 0x0;
        } cmd2[15:8];

        field {
            name = "cmd1";
            desc = "Command sent to the SPI NOR/SPI NAND flash by the controller";
            sw = rw;
            hw = r;
            reset = 0x0;
        } cmd1[7:0];
    } FMC_CMD @ 0x24;

    reg {
        name = "Upper-byte component address configuration register";
        desc = "FMC_ADDRH is an upper-byte component address configuration register.

Data sheet 4.2.7.2 FMC_ADDRH (offset 0x28, printed page 4-211, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 43512).";

        field {
            name = "addrh";
            desc = "Upper-byte of the operation address for the SPI NAND flash";
            sw = rw;
            hw = r;
            reset = 0x0;
        } addrh[7:0];
    } FMC_ADDRH @ 0x28;

    reg {
        name = "Lower-byte component address configuration register";
        desc = "FMC_ADDRL is a lower-byte component address configuration register.

Data sheet 4.2.7.2 FMC_ADDRL (offset 0x2C, printed page 4-211, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 43532).";

        field {
            name = "addrl";
            desc = "Lower-byte of the operation address for the flash memory, and component address for the SPI NOR flash";
            sw = rw;
            hw = r;
            reset = 0x0;
        } addrl[31:0];
    } FMC_ADDRL @ 0x2C;

    reg {
        name = "Operation configuration register";
        desc = "FMC_OP_CFG is an operation configuration register.

Vendor driver values (OP_CFG_*): mem_if_type 0 standard, 1 dual output, 2 dual I/O, 3 quad output, 4 quad I/O (the 0..4 values agree with the data sheet; `IF_TYPE_DTR` = 4 in the vendor header is a DTR alias, not a separate encoding). Typical addr_num: 1 for read-ID / features, 3 for standard NOR operations, 4 in 4-byte address mode.

Data sheet 4.2.7.2 FMC_OP_CFG (offset 0x30, printed page 4-212, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 43563).";

        enum FMC_OP_CFG_fm_cs_enum {
            CS0 = 0 { name = "Cs0"; desc = "CS0"; };
            CS1 = 1 { name = "Cs1"; desc = "CS1"; };
        };

        field {
            name = "fm_cs";
            desc = "CS corresponding to the flash to be operated used for register operation and invalid for DMA operations";
            sw = rw;
            hw = r;
            encode = FMC_OP_CFG_fm_cs_enum;
            reset = 0x0;
        } fm_cs[11:11];

        enum FMC_OP_CFG_force_cs_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "force_cs_en";
            desc = "CS forcible pull-down enable";
            sw = rw;
            hw = r;
            encode = FMC_OP_CFG_force_cs_en_enum;
            reset = 0x0;
        } force_cs_en[10:10];

        enum FMC_OP_CFG_mem_if_type_enum {
            STANDARD_SPI = 0 { name = "Standard Spi"; desc = "standard SPI"; };
            DUAL_OUTPUT_DUAL = 1 { name = "Dual Output Dual"; desc = "dual-output/dual-input SPI"; };
            DUAL_I_O = 2 { name = "Dual I O"; desc = "dual I/O SPI"; };
            QUAD_OUTPUT_QUAD = 3 { name = "Quad Output Quad"; desc = "quad-output/quad-input SPI"; };
