                Data sheet (Hi3520D/Hi3515A/Hi3515C data sheet issue 07 (2015-02-09)): section 5.1.6.3, Table 5-7, page 5-51, register description at text dump line 27034 (build/sdk-survey/datasheet.txt).
            ";

            enum mact_cause_enum {
                FORCED_FORWARDING = 0x0 { desc = "Forced forwarding."; };
                PACKET_WHOSE_DESTINATION = 0x1 { desc = "Packet whose destination MAC address is the local MAC address."; };
                BROADCAST_PACKET = 0x2 { desc = "Broadcast packet."; };
                PACKET_MATCHING_MAC = 0x3 { desc = "Packet matching the MAC table."; };
                MULTICAST_PACKET_NOT = 0x4 { desc = "Multicast packet not matching the MAC table."; };
                UNICAST_PACKET_NOT = 0x5 { desc = "Unicast packet not matching the MAC table."; };
            };

            field {
