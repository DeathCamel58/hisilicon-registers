`ifndef HISI_HIETH_SF_RDL
`define HISI_HIETH_SF_RDL

// Hi3520D/Hi3515A/Hi3515C "hieth" switch-fabric Fast Ethernet MAC (vendor name HISFV300).
// Generated from the data sheet by build/rdl-audit/author/gen_eth.py (kept in scratch), checked against the hardware-verified U-Boot driver; see docs/rdl-sweep/PORT-BLOCKS.md.

regfile eHISI_HIETH_SF_PORT {
    name = "ETH port registers";
    desc = "
    Per-port registers of the ETH switch fabric. The block has two identical ports: the up port (vendor prefix U_, offsets +0x0000..+0x0FFF) and the down port (vendor prefix D_, the same layout at +0x2000..+0x2FFF). The data sheet documents the layout once with the prefix UD_ (`UD_MAC_PORTSEL` is U_MAC_PORTSEL at +0x0200 and D_MAC_PORTSEL at +0x2200); this regfile is instantiated twice by `eHISI_HIETH_SF` as `UP` and `DOWN`, and the `UD_` prefix of the data sheet names is dropped.

    On the Hi3520D/Hi3515A/Hi3515C the MII/RMII pins are wired to the up port only (the embedded FE PHY or an external RMII PHY); the down port is present in the logic and registers but nothing is documented about it beyond the shared `UD_` descriptions.
    ";

        reg {
            name = "PHY physical address register";
            desc = "
                UD_MDIO_PHYADDR is a PHY physical address register. The register does not support soft reset.

                DS name UD_MDIO_PHYADDR; the same register exists in the up port (vendor U_MDIO_PHYADDR) and in the down port at +0x2000 (vendor D_MDIO_PHYADDR).

                Data sheet (Hi3520D/Hi3515A/Hi3515C data sheet issue 07 (2015-02-09)): section 5.1.6.1, Table 5-5, page 5-20, register description at text dump line 25150 (build/sdk-survey/datasheet.txt).
            ";

            field {
                name = "phy_addr";
                desc = "Physical address of the external PHY chip.";
                reset = 0x01;
            } phy_addr[4:0];

        } MDIO_PHYADDR @ 0x108;

        reg {
            name = "PHY status register";
            desc = "
                UD_MDIO_RO_STAT is a PHY status register. The register does not support soft reset.

                DS name UD_MDIO_RO_STAT; the same register exists in the up port (vendor U_MDIO_RO_STAT) and in the down port at +0x2000 (vendor D_MDIO_RO_STAT).

                Data sheet (Hi3520D/Hi3515A/Hi3515C data sheet issue 07 (2015-02-09)): section 5.1.6.1, Table 5-5, page 5-20, register description at text dump line 25169 (build/sdk-survey/datasheet.txt).
            ";

            enum speed_mdio2mac_enum {
                VAL_10_MBIT_S = 0x0 { desc = "10 Mbit/s mode"; };
                VAL_100_MBIT_S = 0x1 { desc = "100 Mbit/s mode"; };
            };

            field {
                name = "speed_mdio2mac";
                desc = "Port speed working status obtained from the MDIO interface, which is in either 10 Mbit/s or 100 Mbit/s working mode.";
                encode = speed_mdio2mac_enum;
                sw = r;
                hw = w;
                reset = 0x0;
            } speed_mdio2mac[2:2];

            enum link_mdio2mac_enum {
                NO_LINK_EXISTS = 0x0 { desc = "No link exists."; };
                LINK_EXISTS = 0x1 { desc = "A link exists."; };
            };

            field {
                name = "link_mdio2mac";
                desc = "Port link status obtained from the MDIO interface.";
                encode = link_mdio2mac_enum;
                sw = r;
                hw = w;
                reset = 0x0;
            } link_mdio2mac[1:1];

            field {
                name = "duplex_mdio2mac";
                desc = "Port duplex working status obtained from the MDIO interface. 1: full-duplex";
                sw = r;
                hw = w;
                reset = 0x0;
            } duplex_mdio2mac[0:0];

        } MDIO_RO_STAT @ 0x10C;

        reg {
            name = "Offset address configuration register for the PHY status";
            desc = "
                UD_MDIO_ANEG_CTRLPHY is an offset address configuration register for the PHY status. The register does not support soft reset. The PHY speed status is indicated by bit[14] of the register with the address of 17, internal_addr_speed is set to 0x11 and speed_index is set to 0xE. In this case, the ETH module reads the bit value as the current working speed mode of the PHY through the MDIO interface.

                DS name UD_MDIO_ANEG_CTRL; the same register exists in the up port (vendor U_MDIO_ANEG_CTRL) and in the down port at +0x2000 (vendor D_MDIO_ANEG_CTRL).

                Data sheet (Hi3520D/Hi3515A/Hi3515C data sheet issue 07 (2015-02-09)): section 5.1.6.1, Table 5-5, page 5-21, register description at text dump line 25223 (build/sdk-survey/datasheet.txt).
            ";

            field {
                name = "internal_addr_speed";
                desc = "Address of the register in the PHY chip that stores the status information (speed). The default value is set according to Intel 9785.";
                reset = 0x11;
            } internal_addr_speed[26:22];

            field {
                name = "internal_addr_link";
                desc = "Address of the register in the PHY chip to store the status";
                reset = 0x11;
            } internal_addr_link[21:17];

            field {
                name = "internal_addr_duplex";
                desc = "Address of the register in the PHY chip that stores the status information (duplex). The default value is set according to Intel 9785.";
                reset = 0x11;
            } internal_addr_duplex[16:12];

            field {
                name = "speed_index";
                desc = "Offset address in the PHY status register that is used to store the speed information. The default value is set according to Intel 9785.";
                reset = 0xE;
            } speed_index[11:8];

            field {
                name = "link_index";
                desc = "Offset address in the PHY status register that is used to store the link information. The default value is set according to Intel 9785.";
                reset = 0xA;
            } link_index[7:4];

            field {
                name = "duplex_index";
                desc = "Offset address in the PHY status register that is used to store the duplex information. The default value is set according to Intel 9785.";
                reset = 0x9;
            } duplex_index[3:0];

        } MDIO_ANEG_CTRL @ 0x110;

        reg {
            name = "Scan mask register for MDIO status changes";
            desc = "
                UD_MDIO_IRQENA is a scan mask register for MDIO status changes. The register does not support soft reset. z If the status information about the PHY chip connecting to the port cannot be scanned and obtained by configuring UD_MDIO_ANEG_CTRL, you can scan the PHY status register by using MDIO_RWCTRL to check whether the port status changes and generate an interrupt to notify software of processing the interrupt. z link_partner status change refers to the change of any bit of link, speed, and duplex for the PHY status.

                DS name UD_MDIO_IRQENA; the same register exists in the up port (vendor U_MDIO_IRQENA) and in the down port at +0x2000 (vendor D_MDIO_IRQENA).

                Data sheet (Hi3520D/Hi3515A/Hi3515C data sheet issue 07 (2015-02-09)): section 5.1.6.1, Table 5-5, page 5-22, register description at text dump line 25291 (build/sdk-survey/datasheet.txt).
            ";

            enum link_partner_ch_mask_enum {
                MASKED = 0x0 { desc = "Mask"; };
                UNMASKED = 0x1 { desc = "Unmask"; };
            };

            field {
                name = "link_partner_ch_mask";
                desc = "Port link partner status scan change interrupt mask.";
                encode = link_partner_ch_mask_enum;
                reset = 0x0;
            } link_partner_ch_mask[3:3];

            enum speed_ch_mask_enum {
                MASKED = 0x0 { desc = "Mask"; };
                UNMASKED = 0x1 { desc = "Unmask"; };
            };

            field {
                name = "speed_ch_mask";
                desc = "Port speed mode scan change interrupt mask.";
                encode = speed_ch_mask_enum;
                reset = 0x0;
            } speed_ch_mask[2:2];

            enum link_ch_mask_enum {
                MASKED = 0x0 { desc = "Mask"; };
                UNMASKED = 0x1 { desc = "Unmask"; };
            };

            field {
                name = "link_ch_mask";
                desc = "Port link mode scan change interrupt mask.";
                encode = link_ch_mask_enum;
                reset = 0x0;
            } link_ch_mask[1:1];

            enum duplex_ch_mask_enum {
                MASKED = 0x0 { desc = "Mask"; };
                UNMASKED = 0x1 { desc = "Unmask"; };
            };

            field {
                name = "duplex_ch_mask";
                desc = "Port duplex mode scan change interrupt mask.";
                encode = duplex_ch_mask_enum;
                reset = 0x0;
            } duplex_ch_mask[0:0];

        } MDIO_IRQENA @ 0x114;

        reg {
            name = "Port working status control register";
            desc = "
                UD_MAC_PORTSEL is a port working status control register. The register does not support soft reset.

                DS name UD_MAC_PORTSEL; the same register exists in the up port (vendor U_MAC_PORTSEL) and in the down port at +0x2000 (vendor D_MAC_PORTSEL).

                Data sheet (Hi3520D/Hi3515A/Hi3515C data sheet issue 07 (2015-02-09)): section 5.1.6.2, Table 5-6, page 5-23, register description at text dump line 25343 (build/sdk-survey/datasheet.txt).
            ";

            enum mii_rmii_enum {
                MII = 0x0 { desc = "MII interface"; };
                RMII = 0x1 { desc = "RMII interface"; };
            };

            field {
                name = "mii_rmii";
                desc = "Port interface mode selection.";
                encode = mii_rmii_enum;
                reset = 0x0;
            } mii_rmii[1:1];

            enum stat_ctrl_enum {
                MDIO = 0x0 { desc = "Use the status information obtained from the MDIO interface."; };
                CPU = 0x1 { desc = "Use the status information set by the CPU."; };
            };

            field {
                name = "stat_ctrl";
                desc = "Port working status information select control register. Hardware-verified: U-Boot hieth_sf.c sets this bit (CPU-set status) and then drives UD_MAC_PORTSET from the PHY state.";
                encode = stat_ctrl_enum;
                reset = 0x1;
            } stat_ctrl[0:0];

        } MAC_PORTSEL @ 0x200;

        reg {
            name = "Port status register";
            desc = "
                UD_MAC_RO_STAT is a port status register. The register does not support soft reset.

                DS name UD_MAC_RO_STAT; the same register exists in the up port (vendor U_MAC_RO_STAT) and in the down port at +0x2000 (vendor D_MAC_RO_STAT).

                Data sheet (Hi3520D/Hi3515A/Hi3515C data sheet issue 07 (2015-02-09)): section 5.1.6.2, Table 5-6, page 5-23, register description at text dump line 25373 (build/sdk-survey/datasheet.txt).
            ";

            enum speed_stat_enum {
                VAL_10_MBIT_S = 0x0 { desc = "10 Mbit/s mode"; };
                VAL_100_MBIT_S = 0x1 { desc = "100 Mbit/s mode"; };
            };

            field {
                name = "speed_stat";
                desc = "Port current speed mode.";
                encode = speed_stat_enum;
                sw = r;
                hw = w;
                reset = 0x0;
            } speed_stat[2:2];

            enum link_stat_enum {
                NO_LINK_EXISTS = 0x0 { desc = "No link exists."; };
                LINK_EXISTS = 0x1 { desc = "A link exists."; };
            };

            field {
                name = "link_stat";
                desc = "Port current link status.";
                encode = link_stat_enum;
                sw = r;
                hw = w;
                reset = 0x0;
            } link_stat[1:1];

            enum duplex_stat_enum {
                HALF_DUPLEX = 0x0 { desc = "half-duplex"; };
                FULL_DUPLEX = 0x1 { desc = "full-duplex"; };
            };

            field {
                name = "duplex_stat";
                desc = "Port current duplex status.";
                encode = duplex_stat_enum;
                sw = r;
                hw = w;
                reset = 0x0;
            } duplex_stat[0:0];

        } MAC_RO_STAT @ 0x204;

        reg {
            name = "Port working status configuration register";
            desc = "
                UD_MAC_PORTSET is a port working status configuration register. The register does not support soft reset.

                DS name UD_MAC_PORTSET; the same register exists in the up port (vendor U_MAC_PORTSET) and in the down port at +0x2000 (vendor D_MAC_PORTSET).

                Data sheet (Hi3520D/Hi3515A/Hi3515C data sheet issue 07 (2015-02-09)): section 5.1.6.2, Table 5-6, page 5-24, register description at text dump line 25418 (build/sdk-survey/datasheet.txt).
            ";

            enum speed_stat_dio_enum {
                VAL_10_MBIT_S = 0x0 { desc = "10 Mbit/s mode"; };
                VAL_100_MBIT_S = 0x1 { desc = "100 Mbit/s mode"; };
            };

            field {
                name = "speed_stat_dio";
                desc = "Port speed mode set by the CPU.";
                encode = speed_stat_dio_enum;
                reset = 0x0;
            } speed_stat_dio[2:2];

            enum link_stat_dio_enum {
                NO_LINK_EXISTS = 0x0 { desc = "No link exists."; };
                LINK_EXISTS = 0x1 { desc = "A link exists."; };
            };

            field {
                name = "link_stat_dio";
                desc = "Port link status set by the CPU.";
                encode = link_stat_dio_enum;
                reset = 0x0;
            } link_stat_dio[1:1];

            enum duplex_stat_dio_enum {
                HALF_DUPLEX = 0x0 { desc = "half-duplex"; };
                FULL_DUPLEX = 0x1 { desc = "full-duplex"; };
            };

            field {
                name = "duplex_stat_dio";
                desc = "Port duplex mode set by the CPU.";
                encode = duplex_stat_dio_enum;
                reset = 0x0;
            } duplex_stat_dio[0:0];

        } MAC_PORTSET @ 0x208;

        reg {
            name = "Port status change indicator register";
            desc = "
                UD_MAC_STAT_CHANGE is a port status change indicator register. The register does not support soft reset.

                DS name UD_MAC_STAT_CHANGE; the same register exists in the up port (vendor U_MAC_STAT_CHANGE) and in the down port at +0x2000 (vendor D_MAC_STAT_CHANGE).

                Data sheet (Hi3520D/Hi3515A/Hi3515C data sheet issue 07 (2015-02-09)): section 5.1.6.2, Table 5-6, page 5-25, register description at text dump line 25460 (build/sdk-survey/datasheet.txt).
            ";

            enum speed_stat_ch_enum {
                NO_CHANGE_OCCURS = 0x0 { desc = "No change occurs."; };
                CHANGE_OCCURS = 0x1 { desc = "A change occurs."; };
            };

            field {
                name = "speed_stat_ch";
                desc = "Port speed mode change indicator. Writing 1 clears this register.";
                encode = speed_stat_ch_enum;
                sw = rw;
                onwrite = woclr;
                hw = w;
                reset = 0x0;
            } speed_stat_ch[2:2];

            enum link_stat_ch_enum {
                NO_CHANGE_OCCURS = 0x0 { desc = "No change occurs."; };
                CHANGE_OCCURS = 0x1 { desc = "A change occurs."; };
            };

            field {
                name = "link_stat_ch";
                desc = "Port link status change indicator. Writing 1 clears this register.";
                encode = link_stat_ch_enum;
                sw = rw;
                onwrite = woclr;
                hw = w;
                reset = 0x0;
            } link_stat_ch[1:1];

            enum duplex_stat_ch_enum {
                NO_CHANGE_OCCURS = 0x0 { desc = "No change occurs."; };
                CHANGE_OCCURS = 0x1 { desc = "A change occurs."; };
            };

            field {
                name = "duplex_stat_ch";
                desc = "Port duplex mode change indicator. Writing 1 clears this register.";
                encode = duplex_stat_ch_enum;
                sw = rw;
                onwrite = woclr;
                hw = w;
                reset = 0x0;
            } duplex_stat_ch[0:0];

        } MAC_STAT_CHANGE @ 0x20C;

        reg {
            name = "MAC function configuration register";
            desc = "
                UD_MAC_SET is a MAC function configuration register. The register does not support soft reset.

                DS name UD_MAC_SET; the same register exists in the up port (vendor U_MAC_SET) and in the down port at +0x2000 (vendor D_MAC_SET).

                Data sheet (Hi3520D/Hi3515A/Hi3515C data sheet issue 07 (2015-02-09)): section 5.1.6.2, Table 5-6, page 5-25, register description at text dump line 25501 (build/sdk-survey/datasheet.txt).
            ";

            enum add_pad_en_enum {
                DISABLED = 0x0 { desc = "Disabled"; };
                ENABLED = 0x1 { desc = "Enabled"; };
            };

            field {
                name = "add_pad_en";
                desc = "Port auto add PAD enable during transmission.";
                encode = add_pad_en_enum;
                reset = 0x1;
            } add_pad_en[29:29];

            enum crcgen_dis_enum {
                TX_FRAME_RECALCULATE = 0x0 { desc = "TX frame recalculate CRC."; };
                TX_FRAME_NOT = 0x1 { desc = "TX frame not recalculate CRC."; };
            };

            field {
                name = "crcgen_dis";
                desc = "Port CRC generation disable control.";
                encode = crcgen_dis_enum;
                reset = 0x0;
            } crcgen_dis[28:28];

            enum cntr_rdclr_en_enum {
                DISABLED = 0x0 { desc = "Disabled"; };
                ENABLED = 0x1 { desc = "Enabled"; };
            };

            field {
                name = "cntr_rdclr_en";
                desc = "Port statistics counter read clear enable.";
                encode = cntr_rdclr_en_enum;
                reset = 0x0;
            } cntr_rdclr_en[27:27];

            enum cntr_clr_all_enum {
                NOT_CLEAR = 0x0 { desc = "not clear"; };
                CLEAR = 0x1 { desc = "clear"; };
            };

            field {
                name = "cntr_clr_all";
                desc = "Port statistics counter clear control. Note: If cntr_clr_all is set to 1, the next clear all operation can be performed only after this bit is set to 0 and then to 1. Note: If cntr_clr_all is set to 1, the next clear all operation can be performed only after this bit is set to 0 and then to 1.";
                encode = cntr_clr_all_enum;
                reset = 0x0;
            } cntr_clr_all[26:26];

            enum cntr_roll_dis_enum {
                DISABLED = 0x0 { desc = "Disabled"; };
                ENABLED = 0x1 { desc = "Enabled"; };
            };

            field {
                name = "cntr_roll_dis";
                desc = "Port statistics acyclic counter enable.";
                encode = cntr_roll_dis_enum;
                reset = 0x0;
            } cntr_roll_dis[25:25];

            field {
                name = "colthreshold";
                desc = "Port collision count statistics threshold. The default value is 0x1, which indicates the count of frames with one collision.";
                reset = 0x1;
            } colthreshold[24:21];

            enum in_loop_en_enum {
                DISABLED = 0x0 { desc = "Disabled"; };
                ENABLED = 0x1 { desc = "Enabled"; };
            };

            field {
                name = "in_loop_en";
                desc = "Port loopback to internal enable. Note: Loopback to internal enable and loopback to external enable cannot be configured at the same time. When the network interface is in normal state, you need to perform soft reset on the module after loopback to internal enable is configured instead of loopback to external enable and vice versa.";
                encode = in_loop_en_enum;
                reset = 0x0;
            } in_loop_en[20:20];

            enum ex_loop_en_enum {
                DISABLED = 0x0 { desc = "Disabled"; };
                ENABLED = 0x1 { desc = "Enabled"; };
            };

            field {
                name = "ex_loop_en";
                desc = "Port loopback to external enable. Note: Loopback to internal enable and loopback to external enable cannot be configured at the same time. When the network interface is in normal state, you need to perform soft reset on the module after loopback to internal enable is configured instead of loopback to external enable and vice versa.";
                encode = ex_loop_en_enum;
                reset = 0x0;
            } ex_loop_en[19:19];

            enum pause_en_enum {
                DISABLED = 0x0 { desc = "Disabled"; };
                ENABLED = 0x1 { desc = "Enabled"; };
            };

            field {
                name = "pause_en";
                desc = "Port pause frame TX enable.";
                encode = pause_en_enum;
                reset = 0x1;
            } pause_en[18:18];

            enum rx_shframe_en_enum {
                DISABLED = 0x0 { desc = "Disabled"; };
                ENABLED = 0x1 { desc = "Enabled"; };
            };

            field {
                name = "rx_shframe_en";
                desc = "Port short frame RX enable. Note: If rx_shframe_en is set to 1, the minimum RX frame length allowed by the port is that set by rx_min_thr. If rx_shframe_en is set to 0, the minimum RX frame length allowed by the port is 64 bytes (including CRC) by default.";
                encode = rx_shframe_en_enum;
                reset = 0x1;
            } rx_shframe_en[17:17];

            field {
                name = "rx_min_thr";
                desc = "Minimum RX frame length allowed by the port. The value range is from 42 bytes to 63 bytes. The default value is 42 bytes. Note: If rx_min_thr is set to a value smaller than 42, 42 is used instead of the value.";
                reset = 0x2A;
            } rx_min_thr[16:11];

            field {
                name = "len_max";
                desc = "Maximum RX frame length allowed by the port. The default value is 1518 bytes. The value is in a range of 1518 bytes to 1535 bytes. Note: If len_max is set to a value greater than 2000, 2000 is used instead of the value. If len_max is set to a value smaller than 256, 256 is used instead of the value.";
                reset = 0x5EE;
            } len_max[10:0];

        } MAC_SET @ 0x210;

        reg {
            name = "Multi-packet interrupt configuration register";
            desc = "
                UD_GLB_IRQN_SET is a multi-packet interrupt configuration register. The register does not support soft reset.

                DS name UD_GLB_IRQN_SET; the same register exists in the up port (vendor U_GLB_IRQN_SET) and in the down port at +0x2000 (vendor D_GLB_IRQN_SET).

                Data sheet (Hi3520D/Hi3515A/Hi3515C data sheet issue 07 (2015-02-09)): section 5.1.6.3, Table 5-7, page 5-48, register description at text dump line 26896 (build/sdk-survey/datasheet.txt).
            ";

            field {
                name = "int_frm_cnt";
                desc = "These bits are used to set the multi-packet interrupt function. That is, how many packets must be received before a multi-packet interrupt can be reported. Note: The minimum value of int_frm_cnt can be set to 1. In this case, multi-packet interrupt is equivalent to single-packet interrupt.";
                reset = 0x08;
            } int_frm_cnt[28:24];

            field {
                name = "age_timer";
                desc = "After the multi-packet interrupt function is enabled, if the number of received packets cannot reach the specified number of packets required for reporting the multi-packet interrupt after a period, this period is defined as the aging time for generating the multi-packet interrupt. Note: age_timer is counted in the unit of the main clock cycle divided by 256.";
                reset = 0x003A;
            } age_timer[15:0];

        } GLB_IRQN_SET @ 0x340;

        reg {
            name = "Queue length configuration register";
            desc = "
                UD_GLB_QLEN_SET is a queue length configuration register. The register does not support soft reset.

                DS name UD_GLB_QLEN_SET; the same register exists in the up port (vendor U_GLB_QLEN_SET) and in the down port at +0x2000 (vendor D_GLB_QLEN_SET).

                Data sheet (Hi3520D/Hi3515A/Hi3515C data sheet issue 07 (2015-02-09)): section 5.1.6.3, Table 5-7, page 5-49, register description at text dump line 26938 (build/sdk-survey/datasheet.txt).
            ";

            field {
                name = "iq_len";
                desc = "RX (packet RX) queue length configuration. Note: iq_len cannot be set to 0. Otherwise, it is forcibly set to 1. The sum of the set values of iq_len and eq_len cannot be greater than 64 (DS text cut off at this point in the dump; 64 frame management queues are shared by RX and TX).";
                reset = 0x20;
            } iq_len[13:8];

            field {
                name = "eq_len";
                desc = "TX (packet TX) queue length configuration. Note: eq_len cannot be set to 0. Otherwise, it is forcibly set to 1.";
                reset = 0x20;
            } eq_len[5:0];

        } GLB_QLEN_SET @ 0x344;

        reg {
            name = "Traffic control register";
            desc = "
                UD_GLB_FC_LEVEL is a traffic control register. The register does not support soft reset. The Hi3520D data sheet (version 02) gives the total reset value 0x3018_0508: its reset bit table also sets bits 29, 28, 20 and 19, which lie in the range the data sheet lists as reserved (bits 31:15); modelled as the read-only field reserved_nz (reset 0x6030) so that the register reset equals the data sheet total.

                DS name UD_GLB_FC_LEVEL; the same register exists in the up port (vendor U_GLB_FC_LEVEL) and in the down port at +0x2000 (vendor D_GLB_FC_LEVEL).

                Data sheet (Hi3520D/Hi3515A/Hi3515C data sheet issue 07 (2015-02-09)): section 5.1.6.3, Table 5-7, page 5-50, register description at text dump line 26978 (build/sdk-survey/datasheet.txt).
            ";

            enum qlimit_ena_enum {
                DISABLED = 0x0 { desc = "Disabled (do not transmit the traffic control message according to the status of RX queue)."; };
                ENABLED = 0x1 { desc = "Enabled (transmit the traffic control message according to the status of RX queue)."; };
            };

            field {
                name = "reserved_nz";
                desc = "Reserved (RO); bits 29, 28, 20 and 19 read 1: the data sheet total reset value is 0x3018_0508 (not read on hardware).";
                sw = r;
                hw = w;
                reset = 0x6030;
            } reserved_nz[31:15];

            field {
                name = "qlimit_ena";
                desc = "Traffic control enable for RX queue.";
                encode = qlimit_ena_enum;
                reset = 0x0;
            } qlimit_ena[14:14];

            field {
                name = "qlimit_up";
                desc = "Upper limit of traffic control for RX queue. When the free space of the RX queue is less than the upper limit, if traffic control for RX queue is enabled, the traffic control message is transmitted to the peer end. Note: If the upper limit qlimit_up is set to 0, the RX queue fails to enter the traffic control status. The upper limit qlimit_up must be greater than the lower limit qlimit_down.";
                reset = 0x05;
            } qlimit_up[13:8];

            field {
                name = "qlimit_down";
                desc = "Lower limit of traffic control for RX queue. When the free space of the RX queue is equal to or greater than the upper limit, if the RX queue is in traffic control state, the current traffic control is stopped.";
                reset = 0x08;
            } qlimit_down[5:0];

