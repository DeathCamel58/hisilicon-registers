                NO_INTERRUPT = 0x0 { desc = "No interrupt is generated."; };
                INTERRUPT = 0x1 { desc = "An interrupt is generated."; };
            };

            field {
                name = "iraw_stat_up";
                desc = "Raw interrupt status for uplink port status changes, indicating that an interrupt is generated when the MDIO obtains the speed change, duplex mode change, and link status change of the PHY chip in auto-adaption mode.";
                encode = iraw_stat_up_enum;
                sw = rw;
                onwrite = woclr;
                hw = w;
                reset = 0x0;
            } iraw_stat_up[5:5];

