                sw = r;
                hw = w;
                reset = 0x1;
            } cpuaddr_in_rdy[25:25];

            field {
                name = "eq_in_rdy";
                desc = "Note: The values of cpuaddr_in_rdy and eq_in_rdy are set to 0 during reset. The values, however, are set to 1 by the circuit immediately after reset. In other words, after reset, the iq address queue and eq descriptor queue are configurable. can configure the frame descriptor of the TX queue. the frame descriptor (header address";
                sw = r;
                hw = w;
                reset = 0x1;
            } eq_in_rdy[24:24];

            field {
                name = "cpu_cnt";
                desc = "Header address count for available frames assigned by the CPU to the RX queue.";
                sw = r;
                hw = w;
                reset = 0x00;
            } cpu_cnt[21:16];

            field {
                name = "iq_cnt";
                desc = "(0 to iq_len).";
                sw = r;
                hw = w;
                reset = 0x00;
