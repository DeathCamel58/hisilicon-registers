        reg {
            name = "RX frame descriptor register";
            desc = "
                UD_GLB_IQFRM_DES is an RX frame descriptor register. The register does not support soft reset.

                DS name UD_GLB_IQFRM_DES; the same register exists in the up port (vendor U_GLB_IQFRM_DES) and in the down port at +0x2000 (vendor D_GLB_IQFRM_DES).

                Data sheet (Hi3520D/Hi3515A/Hi3515C data sheet issue 07 (2015-02-09)): section 5.1.6.3, Table 5-7, page 5-52, register description at text dump line 27097 (build/sdk-survey/datasheet.txt).
            ";

            field {
                name = "fd_in_addr";
