            name = "Register for the number of packets not forwarded to the CPU port due to MAC limit";
            desc = "
                UD_MN2CPU_PKTS is a register for the number of packets not forwarded to the CPU port due to MAC limit. The register does not support soft reset.

                DS name UD_MN2CPU_PKTS; the same register exists in the up port (vendor U_MN2CPU_PKTS) and in the down port at +0x2000 (vendor D_MN2CPU_PKTS).

                Data sheet (Hi3520D/Hi3515A/Hi3515C data sheet issue 07 (2015-02-09)): section 5.1.6.5, Table 5-9, page 5-66, register description at text dump line 28023 (build/sdk-survey/datasheet.txt).
            ";

            field {
                name = "mac_not2cpu_pkts";
                desc = "Number of packets not forwarded to the CPU port due to MAC limit.";
                sw = r;
                hw = w;
                reset = 0x00000000;
            } mac_not2cpu_pkts[31:0];

        } MN2CPU_PKTS @ 0x64C;

        reg {
            name = "Register for the total number of packets transmitted successfully";
            desc = "
                UD_TX_PKTS is a register for the total number of packets transmitted successfully. The register does not support soft reset.

                DS name UD_TX_PKTS; the same register exists in the up port (vendor U_TX_PKTS) and in the down port at +0x2000 (vendor D_TX_PKTS).

                Data sheet (Hi3520D/Hi3515A/Hi3515C data sheet issue 07 (2015-02-09)): section 5.1.6.5, Table 5-9, page 5-67, register description at text dump line 28055 (build/sdk-survey/datasheet.txt).
            ";

            field {
                name = "pkts_tx";
                desc = "Count of all configured TX frames, excluding the frames discarded due to timeout and the TX frames whose length of UD_GLB_EQFRM_LEN is not within valid range.";
                sw = r;
                hw = w;
                reset = 0x00000000;
            } pkts_tx[31:0];

        } TX_PKTS @ 0x780;

        reg {
            name = "Register for the number of broadcast packets transmitted successfully";
            desc = "
                UD_TX_BROADPKTS is a register for the number of broadcast packets transmitted successfully. The register does not support soft reset.

                DS name UD_TX_BROADPKTS; the same register exists in the up port (vendor U_TX_BROADPKTS) and in the down port at +0x2000 (vendor D_TX_BROADPKTS).

                Data sheet (Hi3520D/Hi3515A/Hi3515C data sheet issue 07 (2015-02-09)): section 5.1.6.5, Table 5-9, page 5-67, register description at text dump line 28076 (build/sdk-survey/datasheet.txt).
            ";

            field {
                name = "broadcastpkts_tx";
                desc = "Count of broadcast frames transmitted successfully (excluding retransmission).";
                sw = r;
                hw = w;
                reset = 0x00000000;
            } broadcastpkts_tx[31:0];

        } TX_BROADPKTS @ 0x784;

        reg {
            name = "Register for the number of multicast packets transmitted successfully";
            desc = "
                UD_TX_MULTPKTS is a register for the number of multicast packets transmitted successfully. The register does not support soft reset.

                DS name UD_TX_MULTPKTS; the same register exists in the up port (vendor U_TX_MULTPKTS) and in the down port at +0x2000 (vendor D_TX_MULTPKTS).

                Data sheet (Hi3520D/Hi3515A/Hi3515C data sheet issue 07 (2015-02-09)): section 5.1.6.5, Table 5-9, page 5-68, register description at text dump line 28107 (build/sdk-survey/datasheet.txt).
            ";

            field {
                name = "multicastpkts_tx";
                desc = "Count of multicast frames transmitted successfully (excluding retransmission).";
                sw = r;
                hw = w;
                reset = 0x00000000;
            } multicastpkts_tx[31:0];

        } TX_MULTPKTS @ 0x788;

        reg {
            name = "Register for the number of unicast packets transmitted successfully";
            desc = "
                UD_TX_UNIPKTS is a register for the number of unicast packets transmitted successfully. The register does not support soft reset.

                DS name UD_TX_UNIPKTS; the same register exists in the up port (vendor U_TX_UNIPKTS) and in the down port at +0x2000 (vendor D_TX_UNIPKTS).

                Data sheet (Hi3520D/Hi3515A/Hi3515C data sheet issue 07 (2015-02-09)): section 5.1.6.5, Table 5-9, page 5-68, register description at text dump line 28128 (build/sdk-survey/datasheet.txt).
            ";

            field {
                name = "ifoutucastpkts_tx";
                desc = "Count of unicast frames transmitted successfully (excluding retransmission).";
                sw = r;
                hw = w;
                reset = 0x00000000;
            } ifoutucastpkts_tx[31:0];

        } TX_UNIPKTS @ 0x78C;

        reg {
            name = "Register for the total number of transmitted bytes";
            desc = "
                UD_TX_OCTS is a register for the total number of transmitted bytes. The register does not support soft reset.

                DS name UD_TX_OCTS; the same register exists in the up port (vendor U_TX_OCTS) and in the down port at +0x2000 (vendor D_TX_OCTS).

                Data sheet (Hi3520D/Hi3515A/Hi3515C data sheet issue 07 (2015-02-09)): section 5.1.6.5, Table 5-9, page 5-68, register description at text dump line 28149 (build/sdk-survey/datasheet.txt).
            ";

            field {
                name = "octets_tx";
                desc = "Total count of transmitted bytes, including the bytes of retransmit frames, correct frames, and error frames, but excluding the preamble bytes.";
                sw = r;
                hw = w;
                reset = 0x00000000;
            } octets_tx[31:0];

        } TX_OCTS @ 0x790;

        reg {
            name = "Register for the number of transmitted pause frames";
            desc = "
                UD_TX_PAUSE_PKTS is a register for the number of transmitted pause frames. The register does not support soft reset.

                DS name UD_TX_PAUSE_PKTS; the same register exists in the up port (vendor U_TX_PAUSE_PKTS) and in the down port at +0x2000 (vendor D_TX_PAUSE_PKTS).

                Data sheet (Hi3520D/Hi3515A/Hi3515C data sheet issue 07 (2015-02-09)): section 5.1.6.5, Table 5-9, page 5-69, register description at text dump line 28177 (build/sdk-survey/datasheet.txt).
            ";

            field {
                name = "dot3outpause";
                desc = "Count of transmitted pause frames.";
                sw = r;
                hw = w;
                reset = 0x00000000;
            } dot3outpause[31:0];

        } TX_PAUSE_PKTS @ 0x794;

        reg {
            name = "Register for the total count of retransmission";
            desc = "
                UD_TX_RETRYCNT is a register for the total count of retransmission. The register does not support soft reset.

                DS name UD_TX_RETRYCNT; the same register exists in the up port (vendor U_TX_RETRYCNT) and in the down port at +0x2000 (vendor D_TX_RETRYCNT).

                Data sheet (Hi3520D/Hi3515A/Hi3515C data sheet issue 07 (2015-02-09)): section 5.1.6.5, Table 5-9, page 5-69, register description at text dump line 28197 (build/sdk-survey/datasheet.txt).
            ";

            field {
                name = "retry_times_tx";
                desc = "Total count of retransmissions of TX frames.";
                sw = r;
                hw = w;
                reset = 0x00000000;
            } retry_times_tx[31:0];

        } TX_RETRYCNT @ 0x798;

        reg {
            name = "Register for the total count of collisions";
            desc = "
                UD_TX_COLCNT is a register for the total count of collisions. The register does not support soft reset.

                DS name UD_TX_COLCNT; the same register exists in the up port (vendor U_TX_COLCNT) and in the down port at +0x2000 (vendor D_TX_COLCNT).

                Data sheet (Hi3520D/Hi3515A/Hi3515C data sheet issue 07 (2015-02-09)): section 5.1.6.5, Table 5-9, page 5-69, register description at text dump line 28217 (build/sdk-survey/datasheet.txt).
            ";

            field {
                name = "collisions";
                desc = "Count of collisions.";
                sw = r;
                hw = w;
                reset = 0x00000000;
            } collisions[31:0];

        } TX_COLCNT @ 0x79C;

        reg {
            name = "Register for the number of packets with late collision";
            desc = "
                UD_TX_LC_PKTS is a register for the number of packets with late collision. The register does not support soft reset.

                DS name UD_TX_LC_PKTS; the same register exists in the up port (vendor U_TX_LC_PKTS) and in the down port at +0x2000 (vendor D_TX_LC_PKTS).

                Data sheet (Hi3520D/Hi3515A/Hi3515C data sheet issue 07 (2015-02-09)): section 5.1.6.5, Table 5-9, page 5-70, register description at text dump line 28245 (build/sdk-survey/datasheet.txt).
            ";

            field {
                name = "dot3latecol";
                desc = "Count of packets with late collision.";
                sw = r;
                hw = w;
                reset = 0x00000000;
            } dot3latecol[31:0];

        } TX_LC_PKTS @ 0x7A0;

        reg {
            name = "Register for the number of packets transmitted successfully with collisions";
            desc = "
                UD_TX_COLOK_PKTS is a register for the number of packets transmitted successfully with collisions. The register does not support soft reset.

                DS name UD_TX_COLOK_PKTS; the same register exists in the up port (vendor U_TX_COLOK_PKTS) and in the down port at +0x2000 (vendor D_TX_COLOK_PKTS).

                Data sheet (Hi3520D/Hi3515A/Hi3515C data sheet issue 07 (2015-02-09)): section 5.1.6.5, Table 5-9, page 5-70, register description at text dump line 28265 (build/sdk-survey/datasheet.txt).
            ";

            field {
                name = "dot3col_ok";
                desc = "Count of packets transmitted successfully with collisions.";
                sw = r;
                hw = w;
                reset = 0x00000000;
            } dot3col_ok[31:0];

        } TX_COLOK_PKTS @ 0x7A4;

        reg {
            name = "Register for the number of packets discarded due to more than 15 times of retransmission";
            desc = "
                UD_TX_RETRY15_PKTS is a register for the number of packets discarded due to more than 15 times of retransmission. The register does not support soft reset.

                DS name UD_TX_RETRY15_PKTS; the same register exists in the up port (vendor U_TX_RETRY15_PKTS) and in the down port at +0x2000 (vendor D_TX_RETRY15_PKTS).

                Data sheet (Hi3520D/Hi3515A/Hi3515C data sheet issue 07 (2015-02-09)): section 5.1.6.5, Table 5-9, page 5-70, register description at text dump line 28285 (build/sdk-survey/datasheet.txt).
            ";

            field {
                name = "dot3excessivecol";
                desc = "Count of the packets discarded due to more than 15 times of retransmission.";
                sw = r;
                hw = w;
                reset = 0x00000000;
            } dot3excessivecol[31:0];

        } TX_RETRY15_PKTS @ 0x7A8;

        reg {
            name = "Register for the number of packets with the count of collisions being equal to the threshold";
            desc = "
                UD_TX_RETRYN_PKTS is a register for the number of packets with the count of collisions being equal to the threshold. The register does not support soft reset.

                DS name UD_TX_RETRYN_PKTS; the same register exists in the up port (vendor U_TX_RETRYN_PKTS) and in the down port at +0x2000 (vendor D_TX_RETRYN_PKTS).

                Data sheet (Hi3520D/Hi3515A/Hi3515C data sheet issue 07 (2015-02-09)): section 5.1.6.5, Table 5-9, page 5-71, register description at text dump line 28317 (build/sdk-survey/datasheet.txt).
            ";

            field {
                name = "dot3colcnt";
                desc = "Count of packets with the count of collisions being equal to the threshold. This register is set by UD_MAC_SET[colthreshold].";
                sw = r;
                hw = w;
                reset = 0x00000000;
            } dot3colcnt[31:0];

        } TX_RETRYN_PKTS @ 0x7AC;

        reg {
            name = "RX inter-packet-gap control register (vendor only)";
            desc = "
                NOT IN THE DATA SHEET. Taken from the vendor driver (u-boot-2010.06 drivers/net/hisfv300/mac.h and mac.c); the data sheet does not list this register and gives no reset value. Vendor name U_MAC_RX_IPGCTRL / D_MAC_RX_IPGCTRL at 0x0214 / 0x2214; no field layout is defined in the vendor sources (only the offset).
            ";

            field {
                name = "ipgctrl";
                desc = "RX IPG control. Bit layout unknown: the vendor sources only define the offset.";
                sw = rw;
            } ipgctrl[31:0];

        } MAC_RX_IPGCTRL @ 0x214;

        reg {
            name = "TX inter-packet-gap control register (vendor only)";
            desc = "
                NOT IN THE DATA SHEET. Taken from the vendor driver (u-boot-2010.06 drivers/net/hisfv300/mac.h and mac.c); the data sheet does not list this register and gives no reset value. Vendor name U_MAC_TX_IPGCTRL / D_MAC_TX_IPGCTRL at 0x0218 / 0x2218. Field layout from mac.h (BITS_PRE_CNT_LIMIT, BITS_IPG, BITS_FC_INTER). The hardware-verified U-Boot driver clears pre_cnt_limit (bits 25:23) during init.
            ";

            field {
                name = "pre_cnt_limit";
                desc = "Lead-code (preamble) count limit (vendor hieth_set_mac_leadcode_cnt_limit). Vendor mac.h BITS_PRE_CNT_LIMIT = bits [25:23].";
                sw = rw;
            } pre_cnt_limit[25:23];

            field {
                name = "ipg";
                desc = "Transmit inter-packet gap in bits (vendor hieth_set_mac_trans_interval_bits). Vendor mac.h BITS_IPG = bits [22:16].";
                sw = rw;
            } ipg[22:16];

            field {
                name = "fc_inter";
                desc = "Flow control (pause frame) interval (vendor hieth_set_mac_fc_interval). Vendor mac.h BITS_FC_INTER = bits [15:0].";
                sw = rw;
            } fc_inter[15:0];

        } MAC_TX_IPGCTRL @ 0x218;
};

regfile eHISI_HIETH_SF_MDIO {
    name = "ETH MDIO command registers";
    desc = "
    Shared MDIO master command and read-data registers (block base +0x1100; the register offsets below are relative to it, e.g. MDIO_RWCTRL is at ETH+0x1100). The per-port PHY address, status-scan and mask registers (`MDIO_PHYADDR`, `MDIO_RO_STAT`, `MDIO_ANEG_CTRL`, `MDIO_IRQENA`) live in the port register files. These registers do not support soft reset (GLB_SOFT_RESET).
    ";

        reg {
            name = "MDIO command word register";
            desc = "
                MDIO_RWCTRL is an MDIO command word register. The register does not support soft reset.

                Data sheet (Hi3520D/Hi3515A/Hi3515C data sheet issue 07 (2015-02-09)): section 5.1.6.1, Table 5-5, page 5-18, register description at text dump line 25039 (build/sdk-survey/datasheet.txt).
            ";

            field {
                name = "cpu_data_in";
                desc = "Data used by the MDIO module to perform write operation on the PHY chip. During write operation, the CPU first writes the 16-bit data to be written to the MDIO to this register.";
                reset = 0x0000;
            } cpu_data_in[31:16];

            enum finish_enum {
                NOT_COMPLETE = 0x0 { desc = "Not complete."; };
                COMPLETE = 0x1 { desc = "Complete."; };
            };

            field {
                name = "finish";
                desc = "PHY read/write operation complete. When the read/write operation is required for the second time, the CPU must clear this bit first. Hardware sets this bit when the command completes. Hardware-verified (U-Boot hieth_sf.c): finish keeps reading back as still set for a short while after a new command is written, so a poll issued straight after the write sees the previous operation state (and stale read data); wait ~10 us before polling. The reset value 0x8000 (finish = 1) is also what the vendor driver writes to re-initialise the register.";
                encode = finish_enum;
                hw = rw;
                reset = 0x1;
            } finish[15:15];

            enum rw_op_enum {
                READ_OPERATION = 0x0 { desc = "Read operation."; };
                WRITE_OPERATION = 0x1 { desc = "Write operation."; };
            };

            field {
                name = "rw";
                desc = "PHY read or write access control.";
                encode = rw_op_enum;
                reset = 0x0;
            } rw_op[13:13];

            field {
                name = "phy_exaddr";
                desc = "Physical address of the external PHY chip. One MDIO can perform read/write operation on multiple external PHY chips. Each PHY chip has one corresponding address. When the MDIO connects to only one external PHY chip, this bit is equivalent to UD_MDIO_PHYADDR[phy0_addr] or UD_MDIO_PHYADDR[phy1_addr].";
                reset = 0x00;
            } phy_exaddr[12:8];

            enum frq_dv_enum {
                FREQUENCY_WORKING_MAIN = 0x0 { desc = "The frequency of the working main clock is divided by 50 and the obtained frequency is 1.1 MHz."; };
                FREQUENCY_WORKING_MAIN_1 = 0x1 { desc = "The frequency of the working main clock is divided by 100 and the obtained frequency is 552 KHz."; };
                FREQUENCY_WORKING_MAIN_2 = 0x2 { desc = "The frequency of the working main clock is divided by 150 and the obtained frequency is 368 KHz."; };
                FREQUENCY_WORKING_MAIN_3 = 0x3 { desc = "The frequency of the working main clock is divided by 200 and the obtained frequency is 276 KHz."; };
                FREQUENCY_WORKING_MAIN_4 = 0x4 { desc = "The frequency of the working main clock is divided by 250 and the obtained frequency is 221 KHz."; };
                FREQUENCY_WORKING_MAIN_5 = 0x5 { desc = "The frequency of the working main clock is divided by 300 and the obtained frequency is 184 KHz."; };
                FREQUENCY_WORKING_MAIN_6 = 0x6 { desc = "The frequency of the working main clock is divided by 350 and the obtained frequency is 158 KHz."; };
                FREQUENCY_WORKING_MAIN_7 = 0x7 { desc = "The frequency of the working main clock is divided by 400 and the obtained frequency is 138 KHz."; };
            };

            field {
                name = "frq_dv";
                desc = "Frequency division factor for the MDCK (the MDIO interface clock) when the MDIO performs the read/write operation on external PHY chips. Take the frequency 54 MHz of the main clock as an example to describe the matching relationship between frq_dv and MDC frequency.";
                encode = frq_dv_enum;
                reset = 0x0;
            } frq_dv[7:5];

            field {
                name = "phy_inaddr";
                desc = "Internal register address of the external PHY chip. This address is presented by a 5-bit binary number.";
                reset = 0x00;
            } phy_inaddr[4:0];

        } MDIO_RWCTRL @ 0x0000;

        reg {
            name = "Read data register";
            desc = "
                MDIO_RO_DATAMDIO is a read data register. The register does not support soft reset.

                Data sheet (Hi3520D/Hi3515A/Hi3515C data sheet issue 07 (2015-02-09)): section 5.1.6.1, Table 5-5, page 5-19, register description at text dump line 25116 (build/sdk-survey/datasheet.txt).
            ";

            field {
                name = "cpu_data_out";
                desc = "Read data register of the MDIO module: the 16-bit data read from the PHY chip by the last read operation (valid when MDIO_RWCTRL[finish] is 1).";
                sw = r;
                hw = w;
                reset = 0x0000;
            } cpu_data_out[15:0];

        } MDIO_RO_DATA @ 0x0004;
};

regfile eHISI_HIETH_SF_GLB {
    name = "ETH global control registers";
    desc = "
    Global registers of the ETH switch fabric (block base +0x1300; the register offsets below are relative to it, e.g. GLB_SOFT_RESET is at ETH+0x1308): local MAC address, soft reset, forwarding and MAC filter control, endianness, interrupt registers and the eight-entry destination MAC address filter table (GLB_MAC0_L32 .. GLB_MAC7_H16 at +0x1400). The data sheet documents only the up-port bits of the forwarding and interrupt registers; the down-port bits listed here come from the vendor driver headers (marked 'NOT IN THE DATA SHEET' in their descriptions).

    The registers do not support soft reset.
    ";

        reg {
            name = "Lower 32-bit register for the local MAC address";
            desc = "
                GLB_HOSTMAC_L32 is a lower 32-bit register for the local MAC address. The register does not support soft reset.

                Data sheet (Hi3520D/Hi3515A/Hi3515C data sheet issue 07 (2015-02-09)): section 5.1.6.3, Table 5-7, page 5-32, register description at text dump line 25874 (build/sdk-survey/datasheet.txt).
            ";

            field {
                name = "local_mac";
                desc = "Lower 32 bits of the local MAC address.";
                reset = 0x00000000;
            } local_mac[31:0];

        } GLB_HOSTMAC_L32 @ 0x0000;

        reg {
            name = "Upper 16-bit register for the local MAC address";
            desc = "
                GLB_HOSTMAC_H16 is an upper 16-bit register for the local MAC address. The register does not support soft reset.

                Data sheet (Hi3520D/Hi3515A/Hi3515C data sheet issue 07 (2015-02-09)): section 5.1.6.3, Table 5-7, page 5-32, register description at text dump line 25894 (build/sdk-survey/datasheet.txt).
            ";

            field {
                name = "local_mac";
                desc = "Upper 16 bits of the local MAC address.";
                reset = 0x0000;
            } local_mac[15:0];

        } GLB_HOSTMAC_H16 @ 0x0004;

        reg {
            name = "Internal soft reset register";
            desc = "
                GLB_SOFT_RESET is an internal soft reset register. The register does not support soft reset. The time for each soft reset must remain for more than 2 ms.

                Data sheet (Hi3520D/Hi3515A/Hi3515C data sheet issue 07 (2015-02-09)): section 5.1.6.3, Table 5-7, page 5-32, register description at text dump line 25917 (build/sdk-survey/datasheet.txt).
            ";

            enum soft_reset_enum {
                NOT_RESET = 0x0 { desc = "Not reset."; };
                RESET = 0x1 { desc = "Reset."; };
            };

            field {
                name = "soft_reset";
                desc = "Internal soft reset. In soft reset state, this bit must be set to 0to clear soft reset.";
                encode = soft_reset_enum;
                reset = 0x0;
            } soft_reset[0:0];

        } GLB_SOFT_RESET @ 0x0008;

        reg {
            name = "Forward control register";
            desc = "
                GLB_FWCTRL is a forward control register. The register does not support soft reset.

                Data sheet (Hi3520D/Hi3515A/Hi3515C data sheet issue 07 (2015-02-09)): section 5.1.6.3, Table 5-7, page 5-33, register description at text dump line 25956 (build/sdk-survey/datasheet.txt).
            ";

            field {
                name = "fwall2cpu_down";
                desc = "Forcibly forward all valid input frames of the down port to the CPU port (down-port counterpart of fwall2cpu_up). NOT IN THE DATA SHEET (vendor driver hisfv300 glb.h BITS_FWALL2CPU_DOWN).";
                reset = 0x0;
            } fwall2cpu_down[11:11];

            field {
                name = "fw2cpu_ena_down";
                desc = "Function enable of forwarding the input frames of the down port to the CPU port (down-port counterpart of fw2cpu_ena_up). NOT IN THE DATA SHEET (vendor driver hisfv300 glb.h BITS_FW2CPU_ENA_DOWN).";
                reset = 0x0;
            } fw2cpu_ena_down[9:9];

            enum fwall2cpu_up_enum {
                NO = 0x0 { desc = "no"; };
                YES = 0x1 { desc = "yes"; };
            };

            field {
                name = "fwall2cpu_up";
                desc = "Indicates whether to forcibly forward all valid input frames to the CPU port.";
                encode = fwall2cpu_up_enum;
                reset = 0x0;
            } fwall2cpu_up[7:7];

            enum fw2cpu_ena_up_enum {
                DISABLED = 0x0 { desc = "Disabled"; };
                ENABLED = 0x1 { desc = "Enabled"; };
            };

            field {
                name = "fw2cpu_ena_up";
                desc = "Function enable of forwarding the input frames to the CPU port.";
                encode = fw2cpu_ena_up_enum;
                reset = 0x1;
            } fw2cpu_ena_up[5:5];

            field {
                name = "vlan_enable";
                desc = "VLAN enable. NOT IN THE DATA SHEET (vendor driver hisfv300 glb.h BITS_VLAN_ENABLE).";
                reset = 0x0;
            } vlan_enable[0:0];

        } GLB_FWCTRL @ 0x0010;

        reg {
            name = "MAC filter table control register";
            desc = "
                GLB_MACTCTRL is a MAC filter table control register. The register does not support soft reset. z If the highest byte of the destination MAC address is even, the frame is a unicast frame. z If the highest byte of the destination MAC address is odd, the frame is a multicast frame. z If all bytes of the destination MAC address are 0xFF, the frame is a broadcast frame.

                Data sheet (Hi3520D/Hi3515A/Hi3515C data sheet issue 07 (2015-02-09)): section 5.1.6.3, Table 5-7, page 5-34, register description at text dump line 26008 (build/sdk-survey/datasheet.txt).
            ";

            field {
                name = "mact_ena_down";
                desc = "Enable bit of all MAC filters of the down port (down-port counterpart of mact_ena_up). NOT IN THE DATA SHEET (vendor driver hisfv300 glb.h BITS_MACT_ENA_DOWN).";
                reset = 0x0;
            } mact_ena_down[15:15];

            field {
                name = "broad2cpu_down";
                desc = "Forward the input broadcast frames of the down port to the CPU port (down-port counterpart of broad2cpu_up). NOT IN THE DATA SHEET (vendor driver hisfv300 glb.h BITS_BROAD2CPU_DOWN).";
                reset = 0x0;
            } broad2cpu_down[13:13];

            enum mact_ena_up_enum {
                DISABLED = 0x0 { desc = "disabled (no MAC filter is used)"; };
                ENABLED = 0x1 { desc = "enabled"; };
            };

            field {
                name = "mact_ena_up";
                desc = "Enable bit of all MAC filters of the port.";
                encode = mact_ena_up_enum;
                reset = 0x0;
            } mact_ena_up[7:7];

            enum broad2cpu_up_enum {
                NO = 0x0 { desc = "no"; };
                YES = 0x1 { desc = "yes"; };
            };

            field {
                name = "broad2cpu_up";
                desc = "Indicates whether to forward the input broadcast frames to the CPU port.";
                encode = broad2cpu_up_enum;
                reset = 0x1;
            } broad2cpu_up[5:5];

            enum multi2cpu_up_enum {
                NO = 0x0 { desc = "no"; };
                YES = 0x1 { desc = "yes"; };
