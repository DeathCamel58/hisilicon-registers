`ifndef HISI_AIAO_RDL
`define HISI_AIAO_RDL

// AIAO (audio input/output, I2S/PCM, one RX + one TX port) of the Hi3518EV200 / Hi3516CV200 (data sheet 11.1) and of the other chips of the same generation.
// Cross-chip audit (register tables compared offset by offset and bit by bit with the extracted data sheet tables):
//   Hi3516AV200 (issue 06? chapter 11, base 0x1108_0000, GIC 68), Hi3519V101 (chapter 11, 0x1108_0000, GIC 68) and Hi3516CV300/Hi3516EV100 (chapter 11, 0x1131_0000, VIC 9):
//     identical to the Hi3518EV200 tables (same 31 registers, same bits, access and resets, same three data sheet typos); the shared definition needs no macro.
//   Hi3516AV300 (Chinese issue 01, chapter 11, base 0x113B_0000, GIC 87): same tables plus a second TX channel (tx_ch1 bits 17 of the three AIAO_INT_* registers) and its
//     clock generator I2S_CRG_CFG0_09/CFG1_09 at 0x148/0x14C: define `AIAO_TX1` in the chip's defines.rdl.
//   Hi3516A/Hi3516D (issue 08, chapter 12 'AIO', base 0x2065_0000, GIC 71): older edition of the same IP with 41 registers: adds AIAO_SWITCH_RX_BCLK/AIAO_SWITCH_TX_BCLK/AIAO_STATUS,
//     RX_WPTR_TMP, TX_DSP_STATUS/TX_IF_STATUS/TX_DMAR_STATUS/TX_WS_CNT/TX_BCLK_CNT, TX_RPTR_TMP; I2S_CRG_CFG1_xx has six more control bits ([15:10]) and resets to 0 instead of
//     0x131; RX_IF_ATTRI/TX_IF_ATTRI name the serial data line selects (sd0..sd3_sel, [31:24], reset 0xE4 = the bits this file models as reserved_b31_24 for the Hi3518EV200),
//     rx_multislot_en [7], tx_underflow_ctrl [6], and rx_ch_num is 2 bits ([5:4]): define `AIAO_HI3516A`. Its RX_DSP_CTRL table claims reset 0 and RW for disable_done
//     (the TX_DSP_CTRL table of the same edition and all later editions say 0x2000_0000 / RO), kept as the later editions say.
regfile eHISI_AIAO {
    name = "AIAO (audio input/output)";
    desc = "
    Audio input/output (AIAO) of the Hi3518E V20X / Hi3516C V200 at 0x20650000 (data sheet 11.1), VIC interrupt 9: one audio input port (RX 0 / AIP, pins I2S_SD_RX) and one audio output port
    (TX 0 / AOP, I2S_SD_TX), I2S (16/24-bit stereo, 8-192 kHz) or PCM (16-bit, short frame sync) in master mode, each with its own clock generator (I2S_CRG_CFG0/1_00 for RX, _08 for TX: MCLK,
    BCLK and WS dividers; the I2S_MCLK / I2S_RX_WS / I2S_RX_BCLK pins come from the RX generator in the block diagram). Data moves by DMA between a cyclic DDR buffer (SADDR / SIZE / WPTR /
    RPTR / threshold / TRANS_SIZE per direction) and the port; interrupts per direction (transfer done, buffer full/empty, almost full/empty, bus FIFO over/underflow, stop, TX mute fade done) are
    enabled in RX_INT_ENA / TX_INT_ENA and gated by AIAO_INT_ENA. The on-chip audio CODEC is controlled through the MISC_CTRL registers at 0x20120000 + 0xC4..0xD8 (data sheet 11.2, `eHISI_MISC_CTRL`),
    not through this block.

    This is the AIAO generation of the Hi3516CV300 / Hi3519V101 / Hi3516AV200 (register names RX_IF_ATTRI, RX_DSP_CTRL, TX_DSP_CTRL with volume/fade, I2S_CRG_CFG), whose data sheets
    give exactly the same register tables; the Hi3516AV300 (second TX channel, `AIAO_TX1`) and the older Hi3516A/Hi3516D (`AIAO_HI3516A`, extra status registers and control bits) variants are
    macro-guarded in this file (see the file header). It is NOT the AIP/AOP layout of the Hi3520D (`eHISI_AIO`) nor the FIFO-based SIO of the Hi3511/Hi3515/Hi3520 (`eHISI_SIO`). Vendor drivers for it are binary (`mpp` libraries); nothing in the local trees; no hardware verification. Register table: data sheet 11.1.5 / 11.1.6 (`hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt`
    lines 75750-77294), 31 registers; the three data sheet typos corrected are listed in the register descriptions.
    ";

    reg {
        name = "AIAO interrupt enable register";
        desc = "AIAO_INT_ENA is an AIAO interrupt enable register.

Top-level interrupt enable (VIC interrupt 9 'AIAO'); the per-channel causes are enabled in RX_INT_ENA / TX_INT_ENA.

Data sheet 11.1.6 AIAO_INT_ENA (offset 0x0, printed page 11-9, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 75833).";

        enum AIAO_INT_ENA_tx_ch0_int_ena_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

`ifdef AIAO_TX1
        field {
            name = "tx_ch1_int_ena";
            desc = "TX channel 1 interrupt enable (Hi3516AV300 only: second TX channel; data sheet 11.1 AIAO_INT_ENA bit 17).";
            sw = rw;
            hw = r;
            encode = AIAO_INT_ENA_tx_ch0_int_ena_enum;
            reset = 0x0;
        } tx_ch1_int_ena[17:17];
`endif
        field {
            name = "tx_ch0_int_ena";
            desc = "TX channel 0 interrupt enable";
            sw = rw;
            hw = r;
            encode = AIAO_INT_ENA_tx_ch0_int_ena_enum;
            reset = 0x0;
        } tx_ch0_int_ena[16:16];

        enum AIAO_INT_ENA_rx_ch0_int_ena_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "rx_ch0_int_ena";
            desc = "RX channel 0 interrupt enable";
            sw = rw;
            hw = r;
            encode = AIAO_INT_ENA_rx_ch0_int_ena_enum;
            reset = 0x0;
        } rx_ch0_int_ena[0:0];
    } AIAO_INT_ENA @ 0x0;

    reg {
        name = "AIAO interrupt status register";
        desc = "AIAO_INT_STATUS is an AIAO interrupt status register.

Data sheet 11.1.6 AIAO_INT_STATUS (offset 0x4, printed page 11-9, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 75865).";

        enum AIAO_INT_STATUS_tx_ch0_int_status_enum {
            NO_INTERRUPT_GENERATED = 0 { name = "No Interrupt Generated"; desc = "No interrupt is generated."; };
            INTERRUPT_GENERATED = 1 { name = "Interrupt Generated"; desc = "An interrupt is generated."; };
        };

`ifdef AIAO_TX1
        field {
            name = "tx_ch1_int_status";
            desc = "Interrupt status of TX channel 1 (Hi3516AV300 only: second TX channel; data sheet 11.1 AIAO_INT_STATUS bit 17).";
            sw = r;
            hw = w;
            encode = AIAO_INT_STATUS_tx_ch0_int_status_enum;
            reset = 0x0;
        } tx_ch1_int_status[17:17];
`endif
        field {
            name = "tx_ch0_int_status";
            desc = "Interrupt status of TX channel 0";
            sw = r;
            hw = w;
            encode = AIAO_INT_STATUS_tx_ch0_int_status_enum;
            reset = 0x0;
        } tx_ch0_int_status[16:16];

        enum AIAO_INT_STATUS_rx_ch0_int_status_enum {
            NO_INTERRUPT_GENERATED = 0 { name = "No Interrupt Generated"; desc = "No interrupt is generated."; };
            INTERRUPT_GENERATED = 1 { name = "Interrupt Generated"; desc = "An interrupt is generated."; };
        };

        field {
            name = "rx_ch0_int_status";
            desc = "Interrupt status of RX channel 0";
            sw = r;
            hw = w;
            encode = AIAO_INT_STATUS_rx_ch0_int_status_enum;
            reset = 0x0;
        } rx_ch0_int_status[0:0];
    } AIAO_INT_STATUS @ 0x4;

    reg {
        name = "AIAO raw interrupt register";
        desc = "AIAO_INT_RAW is an AIAO raw interrupt register.

Data sheet 11.1.6 AIAO_INT_RAW (offset 0x8, printed page 11-10, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 75906).";

        enum AIAO_INT_RAW_tx_ch0_int_raw_enum {
            NO_RAW_INTERRUPT = 0 { name = "No Raw Interrupt"; desc = "No raw interrupt is generated."; };
            RAW_INTERRUPT_GENERATED = 1 { name = "Raw Interrupt Generated"; desc = "A raw interrupt is generated."; };
        };

`ifdef AIAO_TX1
        field {
            name = "tx_ch1_int_raw";
            desc = "Raw interrupt of TX channel 1 (Hi3516AV300 only: second TX channel; data sheet 11.1 AIAO_INT_RAW bit 17).";
            sw = r;
            hw = w;
            encode = AIAO_INT_RAW_tx_ch0_int_raw_enum;
            reset = 0x0;
        } tx_ch1_int_raw[17:17];
`endif
        field {
            name = "tx_ch0_int_raw";
            desc = "Raw interrupt of TX channel 0";
            sw = r;
            hw = w;
            encode = AIAO_INT_RAW_tx_ch0_int_raw_enum;
            reset = 0x0;
        } tx_ch0_int_raw[16:16];

        enum AIAO_INT_RAW_rx_ch0_int_raw_enum {
            NO_RAW_INTERRUPT = 0 { name = "No Raw Interrupt"; desc = "No raw interrupt is generated."; };
            RAW_INTERRUPT_GENERATED = 1 { name = "Raw Interrupt Generated"; desc = "A raw interrupt is generated."; };
        };

        field {
            name = "rx_ch0_int_raw";
            desc = "Raw interrupt of RX channel 0";
            sw = r;
            hw = w;
            encode = AIAO_INT_RAW_rx_ch0_int_raw_enum;
            reset = 0x0;
        } rx_ch0_int_raw[0:0];
    } AIAO_INT_RAW @ 0x8;

`ifdef AIAO_HI3516A
    reg {
        name = "AIAO I2S RX BCLK switch configuration register";
        desc = "AIAO_SWITCH_RX_BCLK is an AIAO I2S RX BCLK switch configuration register (Hi3516A/Hi3516D only). Total reset value 0x7654_3210: the data sheet marks bits 31:4 'reserved' but gives them the reset 0x7654321, i.e. the register is a bank of eight 4-bit selects of which only the first (RX 00) is documented.
Data sheet 12.3 AIAO_SWITCH_RX_BCLK (offset 0x28, printed page 12-11, `hi3516av100--Hi3516A-Hi3516D-Datasheet.txt` line 84598).";

        field {
            name = "reserved_b31_4";
            desc = "Reserved in the data sheet (RW, reset 0x7654321; by the pattern these are the BCLK selects of RX channels 01..07 of the full 8-channel IP).";
            sw = rw;
            hw = r;
            reset = 0x7654321;
        } reserved_b31_4[31:4];

        enum AIAO_SWITCH_RX_BCLK_inner_bclk_ws_sel_rx_00_enum {
            BCLK0 = 0 { name = "BCLK0"; desc = "BCLK0 (the RX clock generator I2S_CRG_CFGx_00)"; };
            BCLK8 = 8 { name = "BCLK8"; desc = "BCLK8 (the TX clock generator I2S_CRG_CFGx_08). Other values: reserved"; };
        };

        field {
            name = "inner_bclk_ws_sel_rx_00";
            desc = "Internal BCLK select for the RX channel.";
            sw = rw;
            hw = r;
            encode = AIAO_SWITCH_RX_BCLK_inner_bclk_ws_sel_rx_00_enum;
            reset = 0x0;
        } inner_bclk_ws_sel_rx_00[3:0];
    } AIAO_SWITCH_RX_BCLK @ 0x28;

    reg {
        name = "AIAO I2S TX BCLK switch configuration register";
        desc = "AIAO_SWITCH_TX_BCLK is an AIAO I2S TX BCLK switch configuration register (Hi3516A/Hi3516D only). Total reset value 0x7654_3210 (see AIAO_SWITCH_RX_BCLK).
Data sheet 12.3 AIAO_SWITCH_TX_BCLK (offset 0x2C, printed page 12-11, `hi3516av100--Hi3516A-Hi3516D-Datasheet.txt` line 84633).";

        field {
            name = "reserved_b31_4";
            desc = "Reserved in the data sheet (RW, reset 0x7654321; by the pattern the BCLK selects of TX channels 01..07 of the full 8-channel IP).";
            sw = rw;
            hw = r;
            reset = 0x7654321;
        } reserved_b31_4[31:4];

        enum AIAO_SWITCH_TX_BCLK_inner_bclk_ws_sel_tx_00_enum {
            BCLK0 = 0 { name = "BCLK0"; desc = "BCLK0 (the RX clock generator I2S_CRG_CFGx_00)"; };
            BCLK8 = 8 { name = "BCLK8"; desc = "BCLK8 (the TX clock generator I2S_CRG_CFGx_08). Other values: reserved"; };
        };

        field {
            name = "inner_bclk_ws_sel_tx_00";
            desc = "Internal BCLK select for the TX channel.";
            sw = rw;
            hw = r;
            encode = AIAO_SWITCH_TX_BCLK_inner_bclk_ws_sel_tx_00_enum;
            reset = 0x0;
        } inner_bclk_ws_sel_tx_00[3:0];
    } AIAO_SWITCH_TX_BCLK @ 0x2C;

    reg {
        name = "AIAO status register";
        desc = "AIAO_STATUS is an AIAO status register (Hi3516A/Hi3516D only).
Data sheet 12.3 AIAO_STATUS (offset 0x30, printed page 12-12, `hi3516av100--Hi3516A-Hi3516D-Datasheet.txt` line 84658).";

        enum AIAO_STATUS_srst_rdy_enum {
            RESETTING = 0 { name = "Resetting"; desc = "resetting"; };
            RESET_COMPLETED = 1 { name = "Reset Completed"; desc = "reset completed"; };
        };

        field {
            name = "srst_rdy";
            desc = "Soft reset status.";
            sw = r;
            hw = w;
            encode = AIAO_STATUS_srst_rdy_enum;
            reset = 0x0;
        } srst_rdy[0:0];
    } AIAO_STATUS @ 0x30;
`endif

    reg {
        name = "I2S00 CRG configuration register 0";
        desc = "I2S_CRG_CFG0_00 is I2S00 CRG configuration register 0.

Data sheet 11.1.6 I2S_CRG_CFG0_00 (offset 0x100, printed page 11-10, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 75938).";

        field {
            name = "aiao_mclk_div";
            desc = "Configured value of the frequency division clock of the MCLK: (target MCLK frequency / frequency of the MCLK clock source) x 2^27. The MCLK clock source is the AIAO PLL output selected in PERI_CRG (data sheet 3.2); reset 0x00AA_AAAA = 1/3 of the source.";
            sw = rw;
            hw = r;
            reset = 0x00AAAAAA;
        } aiao_mclk_div[26:0];
    } I2S_CRG_CFG0_00 @ 0x100;

    reg {
        name = "I2S00 CRG configuration register 1";
        desc = "I2S_CRG_CFG1_00 is I2S00 CRG configuration register 1.

Clock generator of the RX (AIP, 'CRG00') port: MCLK (I2S_CRG_CFG0_00) -> BCLK (aiao_bclk_div) -> WS / sampling clock (aiao_fsclk_div). Total reset value 0x131: cken 1, fsclk_div 3 (BCLK/64), bclk_div 1 (MCLK/3). Hi3516A/Hi3516D (`AIAO_HI3516A`): total reset value 0x0 and six more control bits [15:10] (WS/BCLK gating, BCLK polarity, master/slave select); data sheet 12.3 (`hi3516av100--Hi3516A-Hi3516D-Datasheet.txt` line 84720).

Data sheet 11.1.6 I2S_CRG_CFG1_00 (offset 0x104, printed page 11-11, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 75972).";

`ifdef AIAO_HI3516A
        field {
            name = "aiao_rx_ws_en";
            desc = "RX WS gating select (Hi3516A/Hi3516D only; the data sheet text says 'rx bclk gating select' for both bits 15 and 14). 0: disabled, 1: enabled.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } aiao_rx_ws_en[15:15];

        field {
            name = "aiao_rx_bclk_en";
            desc = "RX BCLK gating select (Hi3516A/Hi3516D only). 0: disabled, 1: enabled.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } aiao_rx_bclk_en[14:14];

        field {
            name = "aiao_bclkout_pctrl";
            desc = "BCLKOUT polarity (Hi3516A/Hi3516D only). 0: positive, 1: negative.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } aiao_bclkout_pctrl[13:13];

        field {
            name = "aiao_bclkin_pctrl";
            desc = "BCLKIN polarity (Hi3516A/Hi3516D only). 0: positive, 1: negative.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } aiao_bclkin_pctrl[12:12];

        field {
            name = "aiao_bclk_sel";
            desc = "BCLK/FCLK select (Hi3516A/Hi3516D only). 0: the clocks are generated internally; 1: the clocks are input from the external ADAC.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } aiao_bclk_sel[11:11];

        field {
            name = "aiao_bclk_oen";
            desc = "BCLK/FCLK I/O output enable control (Hi3516A/Hi3516D only). 0: the BCLK/FCLK I/O is an output; 1: it is an input. Works with aiao_bclk_sel to select the master/slave mode of the I2S interface.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } aiao_bclk_oen[10:10];
`endif

        enum I2S_CRG_CFG1_00_aiao_srst_req_enum {
            DEASSERT_RESET = 0 { name = "Deassert Reset"; desc = "deassert reset"; };
            RESET_F = 1 { name = "Reset F"; desc = "reset"; };
        };

        field {
            name = "aiao_srst_req";
            desc = "Independent soft reset request of the RX 0 channel";
            sw = rw;
            hw = r;
            encode = I2S_CRG_CFG1_00_aiao_srst_req_enum;
            reset = 0x0;
        } aiao_srst_req[9:9];

        enum I2S_CRG_CFG1_00_aiao_cken_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "aiao_cken";
            desc = "MCLK/BCLK/WS clock gating for CRG00";
            sw = rw;
            hw = r;
            encode = I2S_CRG_CFG1_00_aiao_cken_enum;
`ifdef AIAO_HI3516A
            reset = 0x0;
`else
            reset = 0x1;
`endif
        } aiao_cken[8:8];

        enum I2S_CRG_CFG1_00_aiao_fsclk_div_enum {
            FS_OBTAINED_DIVIDING = 0 { name = "Fs Obtained Dividing"; desc = "The FS is obtained by dividing the BCLK by 16."; };
            FS_OBTAINED_DIVIDING_2 = 1 { name = "Fs Obtained Dividing 2"; desc = "The FS is obtained by dividing the BCLK by 32."; };
            FS_OBTAINED_DIVIDING_3 = 2 { name = "Fs Obtained Dividing 3"; desc = "The FS is obtained by dividing the BCLK by 48."; };
            FS_OBTAINED_DIVIDING_4 = 3 { name = "Fs Obtained Dividing 4"; desc = "The FS is obtained by dividing the BCLK by 64."; };
            FS_OBTAINED_DIVIDING_5 = 4 { name = "Fs Obtained Dividing 5"; desc = "The FS is obtained by dividing the BCLK by 128."; };
            FS_OBTAINED_DIVIDING_6 = 5 { name = "Fs Obtained Dividing 6"; desc = "The FS is obtained by dividing the BCLK by 256. Other values: The FS is obtained by dividing the BCLK by 8."; };
        };

        field {
            name = "aiao_fsclk_div";
            desc = "Frequency division relationship between the bit clock BCLK and the sampling clock FS";
            sw = rw;
            hw = r;
            encode = I2S_CRG_CFG1_00_aiao_fsclk_div_enum;
`ifdef AIAO_HI3516A
            reset = 0x0;
`else
            reset = 0x3;
`endif
        } aiao_fsclk_div[6:4];

        enum I2S_CRG_CFG1_00_aiao_bclk_div_enum {
            BCLK_OBTAINED_DIVIDING = 0 { name = "Bclk Obtained Dividing"; desc = "The BCLK is obtained by dividing the MCLK by 1."; };
            BCLK_OBTAINED_DIVIDING_2 = 1 { name = "Bclk Obtained Dividing 2"; desc = "The BCLK is obtained by dividing the MCLK by 3."; };
            BCLK_OBTAINED_DIVIDING_3 = 2 { name = "Bclk Obtained Dividing 3"; desc = "The BCLK is obtained by dividing the MCLK by 2."; };
            BCLK_OBTAINED_DIVIDING_4 = 3 { name = "Bclk Obtained Dividing 4"; desc = "The BCLK is obtained by dividing the MCLK by 4."; };
            BCLK_OBTAINED_DIVIDING_5 = 4 { name = "Bclk Obtained Dividing 5"; desc = "The BCLK is obtained by dividing the MCLK by 6."; };
            BCLK_OBTAINED_DIVIDING_6 = 5 { name = "Bclk Obtained Dividing 6"; desc = "The BCLK is obtained by dividing the MCLK by 8."; };
            BCLK_OBTAINED_DIVIDING_7 = 6 { name = "Bclk Obtained Dividing 7"; desc = "The BCLK is obtained by dividing the MCLK by 12."; };
            BCLK_OBTAINED_DIVIDING_8 = 7 { name = "Bclk Obtained Dividing 8"; desc = "The BCLK is obtained by dividing the MCLK by 16."; };
            BCLK_OBTAINED_DIVIDING_9 = 8 { name = "Bclk Obtained Dividing 9"; desc = "The BCLK is obtained by dividing the MCLK by 24."; };
            BCLK_OBTAINED_DIVIDING_10 = 9 { name = "Bclk Obtained Dividing 10"; desc = "The BCLK is obtained by dividing the MCLK by 32."; };
            BCLK_OBTAINED_DIVIDING_11 = 10 { name = "Bclk Obtained Dividing 11"; desc = "The BCLK is obtained by dividing the MCLK by 48."; };
            BCLK_OBTAINED_DIVIDING_12 = 11 { name = "Bclk Obtained Dividing 12"; desc = "The BCLK is obtained by dividing the MCLK by 64. Other values: The BCLK is obtained by dividing the MCLK by 8."; };
        };

        field {
            name = "aiao_bclk_div";
            desc = "Frequency division relationship between the main clock MCLK and the bit clock BCLK";
            sw = rw;
            hw = r;
            encode = I2S_CRG_CFG1_00_aiao_bclk_div_enum;
`ifdef AIAO_HI3516A
            reset = 0x0;
`else
            reset = 0x1;
`endif
        } aiao_bclk_div[3:0];
    } I2S_CRG_CFG1_00 @ 0x104;

    reg {
        name = "I2S08 CRG configuration register 0";
        desc = "I2S_CRG_CFG0_08 is I2S08 CRG configuration register 0.

Data sheet 11.1.6 I2S_CRG_CFG0_08 (offset 0x140, printed page 11-12, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 76038).";

        field {
            name = "aiao_mclk_div";
            desc = "Configured value of the frequency division clock of the MCLK: (target MCLK frequency / frequency of the MCLK clock source) x 2^27. The MCLK clock source is the AIAO PLL output selected in PERI_CRG (data sheet 3.2); reset 0x00AA_AAAA = 1/3 of the source.";
            sw = rw;
            hw = r;
            reset = 0x00AAAAAA;
        } aiao_mclk_div[26:0];
    } I2S_CRG_CFG0_08 @ 0x140;

    reg {
        name = "I2S08 CRG configuration register 1";
        desc = "I2S_CRG_CFG1_08 is I2S08 CRG configuration register 1.

Clock generator of the TX (AOP, 'CRG08') port, same layout as I2S_CRG_CFG1_00.

Data sheet 11.1.6 I2S_CRG_CFG1_08 (offset 0x144, printed page 11-13, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 76074).";

`ifdef AIAO_HI3516A
        field {
            name = "aiao_tx_ws_en";
            desc = "TX WS gating select (Hi3516A/Hi3516D only; the data sheet text says 'tx bclk gating select' for both bits 15 and 14). 0: disabled, 1: enabled.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } aiao_tx_ws_en[15:15];

        field {
            name = "aiao_tx_bclk_en";
            desc = "TX BCLK gating select (Hi3516A/Hi3516D only). 0: disabled, 1: enabled.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } aiao_tx_bclk_en[14:14];

        field {
            name = "aiao_bclkout_pctrl";
            desc = "BCLKOUT polarity (Hi3516A/Hi3516D only). 0: positive, 1: negative.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } aiao_bclkout_pctrl[13:13];

        field {
            name = "aiao_bclkin_pctrl";
            desc = "BCLKIN polarity (Hi3516A/Hi3516D only). 0: positive, 1: negative.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } aiao_bclkin_pctrl[12:12];

        field {
            name = "aiao_bclk_sel";
