            hw = r;
            encode = RX_IF_ATTRI_rx_multislot_en_enum;
            reset = 0x0;
        } rx_multislot_en[7:7];

        enum RX_IF_ATTRI_rx_ch_num_hi3516a_enum {
            CH_1 = 0 { name = "1 Channel"; desc = "rx_multislot_en = 0: 1-channel RX (SD0 data line); = 1: 2-channel RX (SD0)"; };
            CH_2 = 1 { name = "2 Channels"; desc = "rx_multislot_en = 0: 2-channel RX (SD0 data line); = 1: 4-channel RX (SD0)"; };
            CH_RESERVED = 2 { name = "Reserved"; desc = "rx_multislot_en = 0: reserved; = 1: 8-channel RX (SD0)"; };
            CH_8 = 3 { name = "8 Channels"; desc = "rx_multislot_en = 0: 8-channel RX (data lines SD0, SD1, SD2 and SD3); = 1: 16-channel RX (SD0)"; };
        };

        field {
            name = "rx_ch_num";
            desc = "Number of RX channels (Hi3516A/Hi3516D: 2 bits; the data line must be SD0 for multi-channel RX).";
            sw = rw;
            hw = r;
            encode = RX_IF_ATTRI_rx_ch_num_hi3516a_enum;
            reset = 0x0;
        } rx_ch_num[5:4];
