        enum RX_IF_ATTRI_rx_multislot_en_enum {
            NORMAL = 0 { name = "Normal"; desc = "invalid (normal mode)"; };
            TDM = 1 { name = "TDM"; desc = "valid (time-division multiplexing mode)"; };
        };

        field {
            name = "rx_multislot_en";
            desc = "Time-division multiplexing validity indicator (Hi3516A/Hi3516D only). Changes the meaning of rx_ch_num and rx_i2s_precision.";
