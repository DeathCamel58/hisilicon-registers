            desc = "RX channel disable completion identifier. (The Hi3516A/Hi3516D data sheet table gives this bit as RW with total reset 0x0000_0000, but its own TX_DSP_CTRL table and every later edition say RO / 0x2000_0000; kept as RO, reset 1.)";
            sw = r;
            hw = w;
            encode = RX_DSP_CTRL_rx_disable_done_enum;
            reset = 0x1;
        } rx_disable_done[29:29];

