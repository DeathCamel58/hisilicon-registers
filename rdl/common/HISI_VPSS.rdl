`ifndef HISI_VPSS_RDL
`define HISI_VPSS_RDL

addrmap aHISI_VPSS {
    name = "HiSilicon VPSS (registers not described)";
    desc = "Not described: no register of this block is described; the registers exist only in closed vendor libraries (the MPP binary modules), not in the data sheet or any vendor source in the tree. The 64 KB window is kept only so that the block base address and size exist in the address map (STUB). Video process subsystem (data sheet 8.2, `datasheet.txt` lines ~30232-30290, overview/features only, no register description): 3D Gaussian noise reduction (NR), image enhancement (IE), de-interlace (DEI), sharpening (HSP), border addition, block processing of widths over 960 (up to 1920), scaling (8x zoom out, 16x zoom in), register linked-list configuration, YUV420/YUV422. The vendor MPP VPSS is a closed-source binary module; the vendor Hi3531-family `platform.h` gives only VPSS0_REG_BASE 0x20600000 (and a VPSS1 at 0x20680000, which is Reserved in the Hi3520D table). Base address 0x20600000, GIC interrupt ID 69. Listed as an open item in docs/rdl-sweep/PORT-BLOCKS.md.";

    external mem {
        name = "Undocumented register window";
        desc = "The whole 64 KB window of the block. Register layout unknown; placeholder so the block base address and size exist in the map. No registers are described.";
        mementries = 16384;
        memwidth = 32;
        sw = rw;
    } REGS;
};

`endif
