`ifndef HISI_VPSS_RDL
`define HISI_VPSS_RDL

addrmap aHISI_VPSS {
    name = "HiSilicon VPSS (registers not described)";
    desc = "Not described: no register of this block is described in any data sheet [BOARD-READ Hi3518E V200 2026-11-11: with PERI_CRG18 reset pulsed and clock on, +0x000..+0x7FC, +0x3F0, +0x404, +0x410 and +0x4004 read 0 except +0x144, +0x15C and +0x18C = 2; there is no ID word and none of the Hi3520D non-zero defaults (+0x200..+0x270, +0x410, +0x4004) appears: the EV200 VPSS is a different layout.]  (every data sheet that has the block lists only the 64 KB memory-map window, the interrupt number and the clock/reset/QoS bits of the integration registers; the registers exist only in closed vendor libraries and modules). The 64 KB window is kept so that the block base address and size exist in the address map (STUB). Instances (data-sheet memory maps and interrupt tables, cross-chip audit 2026-11-11, docs/rdl-campaign/vpss.md): 0x20600000 on Hi3520D/Hi3515A/Hi3515C (GIC 69), Hi3516C V100 and Hi3518 A/C V100 (interrupt 17), Hi3516A/Hi3516D (GIC 68), Hi3518E V200/Hi3516C V200 (interrupt 17); 0x11180000 on Hi3516A V200 and Hi3519 V101 (GIC 64); 0x11040000 on Hi3516A V300 (GIC 75); 0x11250000 on Hi3516C V300 and Hi3516E V100 (interrupt 17). Hi3511/Hi3515 V100/Hi3516 V100/Hi3520 V100 have no VPSS. The data-sheet feature texts show at least three generations: (1) Hi3520D, Hi3516C V100, Hi3518 V100, Hi3518E V100: 3D Gaussian noise reduction, image enhancement (Hi3520D only), de-interlace, sharpening, border (Hi3520D only), block processing of wide pictures, scaling, register linked list, YUV420/YUV422; (2) Hi3516A/D, Hi3518E V200/Hi3516C V200: NR, up to 3 encoding channels plus 1 display channel, 8 cover regions per channel, cropping, linked-list configuration (offline) or APB (online mode with VICAP); (3) Hi3516A V200/V300, Hi3519, Hi3516C V300: one input, up to three outputs, online or offline with VI. Register layouts across generations are unknown and must not be assumed equal; the Hi3520D edition with the vendor-derived registers is aHISI_VPSS_V100 below. Video process subsystem data sheet text for the Hi3520D: chapter 8.2 (original Chinese issue 02), overview and features only. The vendor Hi3531-family `platform.h` gives only VPSS0_REG_BASE 0x20600000 (and a VPSS1 at 0x20680000, which is Reserved in the Hi3520D table). Listed as an open item in docs/rdl-sweep/PORT-BLOCKS.md.";

    reg {
        name = "VPSS mask";
        desc = "Provenance: offset, access direction and written value are PROVEN from hi3518e_vpss.ko (OpenIPC package, Hi3518EV200_MPP_V1.0.5.0) function VPSS_HAL_SetMask (store only) (static analysis, not run on hardware); seen in the Hi3518E V200 module only (same set as the VGS of that chip and the Hi3516C V300 VPSS_V2 job-control file, eHISI_VPSS_V2); the role is INFERRED from the function name.";
        field {
            name = "mask";
            desc = "VPSS mask. Bit layout not known, treated as one value (GUESS for any finer meaning).";
            sw = rw;
            hw = r;
        } mask[31:0];
    } VPSS_MASK @ 0x1FC;

    reg {
        name = "VPSS next node address";
        desc = "Provenance: offset, access direction and written value are PROVEN from hi3518e_vpss.ko (OpenIPC package, Hi3518EV200_MPP_V1.0.5.0) function VPSS_HAL_Start (value written, read back and compared with a cache barrier, a printk and retry counter on mismatch, then 0x300 is written); physical address of the first register-image node of the job list (INFERRED from the VGS/CV300 analogy and the HAL name) (static analysis, not run on hardware); seen in the Hi3518E V200 module only (same set as the VGS of that chip and the Hi3516C V300 VPSS_V2 job-control file, eHISI_VPSS_V2); the role is INFERRED from the function name.";
        field {
            name = "next_node";
            desc = "VPSS next node address. Bit layout not known, treated as one value (GUESS for any finer meaning).";
            sw = rw;
            hw = r;
        } next_node[31:0];
    } VPSS_NEXT_NODE @ 0x2FC;

    reg {
        name = "VPSS start";
        desc = "Provenance: offset, access direction and written value are PROVEN from hi3518e_vpss.ko (OpenIPC package, Hi3518EV200_MPP_V1.0.5.0) function VPSS_HAL_Start: writes 1, or 3 when its third argument is non-zero; bit 0 = start (INFERRED), bit 1 = unknown mode (GUESS) (static analysis, not run on hardware); seen in the Hi3518E V200 module only (same set as the VGS of that chip and the Hi3516C V300 VPSS_V2 job-control file, eHISI_VPSS_V2); the role is INFERRED from the function name.";
        field {
            name = "start";
            desc = "VPSS start. Bit layout not known, treated as one value (GUESS for any finer meaning).";
            sw = rw;
            hw = r;
        } start[1:0];
    } VPSS_START @ 0x300;

    reg {
        name = "VPSS interrupt status";
        desc = "Provenance: offset, access direction and written value are PROVEN from hi3518e_vpss.ko (OpenIPC package, Hi3518EV200_MPP_V1.0.5.0) function VPSS_HAL_GetIntStatus (load only); bit meaning unknown (static analysis, not run on hardware); seen in the Hi3518E V200 module only (same set as the VGS of that chip and the Hi3516C V300 VPSS_V2 job-control file, eHISI_VPSS_V2); the role is INFERRED from the function name.";
        field {
            name = "int_status";
            desc = "VPSS interrupt status. Bit layout not known, treated as one value (GUESS for any finer meaning).";
            sw = r;
            hw = r;
        } int_status[31:0];
    } VPSS_INT_STATUS @ 0x304;

    reg {
        name = "VPSS interrupt clear";
        desc = "Provenance: offset, access direction and written value are PROVEN from hi3518e_vpss.ko (OpenIPC package, Hi3518EV200_MPP_V1.0.5.0) function VPSS_HAL_ClrInt (writes 0xFFFFFFFF); write-1-to-clear INFERRED (static analysis, not run on hardware); seen in the Hi3518E V200 module only (same set as the VGS of that chip and the Hi3516C V300 VPSS_V2 job-control file, eHISI_VPSS_V2); the role is INFERRED from the function name.";
        field {
            name = "int_clear";
            desc = "VPSS interrupt clear. Bit layout not known, treated as one value (GUESS for any finer meaning).";
            sw = rw;
            hw = r;
        } int_clear[31:0];
    } VPSS_INT_CLEAR @ 0x308;

    reg {
        name = "VPSS raw interrupt status";
        desc = "Provenance: offset, access direction and written value are PROVEN from hi3518e_vpss.ko (OpenIPC package, Hi3518EV200_MPP_V1.0.5.0) function VPSS_HAL_GetRawIntStatus (load only); bit meaning unknown (static analysis, not run on hardware); seen in the Hi3518E V200 module only (same set as the VGS of that chip and the Hi3516C V300 VPSS_V2 job-control file, eHISI_VPSS_V2); the role is INFERRED from the function name.";
        field {
            name = "raw_int_status";
            desc = "VPSS raw interrupt status. Bit layout not known, treated as one value (GUESS for any finer meaning).";
            sw = r;
            hw = r;
        } raw_int_status[31:0];
    } VPSS_RAW_INT_STATUS @ 0x30C;

    reg {
        name = "VPSS AXI outstanding";
        desc = "Provenance: offset, access direction and written value are PROVEN from hi3518e_vpss.ko (OpenIPC package, Hi3518EV200_MPP_V1.0.5.0) function VPSS_HAL_SetOutstanding (store only); AXI outstanding-request count INFERRED from the name (static analysis, not run on hardware); seen in the Hi3518E V200 module only (same set as the VGS of that chip and the Hi3516C V300 VPSS_V2 job-control file, eHISI_VPSS_V2); the role is INFERRED from the function name.";
        field {
            name = "outstanding";
            desc = "VPSS AXI outstanding. Bit layout not known, treated as one value (GUESS for any finer meaning).";
            sw = rw;
            hw = r;
        } outstanding[31:0];
    } VPSS_OUTSTANDING @ 0x314;

    external mem {
        name = "Undocumented register window";
        desc = "The rest of the 64 KB window (0x400-0xFFFF). Register layout unknown; placeholder so the block base address and size exist in the map. Only the job-control registers at 0x1FC-0x314 are known (Hi3518E V200 vendor-module code, see their descriptions).";
        mementries = 16128;
        memwidth = 32;
        sw = rw;
    } REGS @ 0x400;
};

addrmap aHISI_VPSS_V100 {
    name = "HiSilicon VPSS (Hi3520D V100 edition, vendor-derived registers)";
    desc = "VPSS, Hi3520D V100 edition, vendor-derived, NOT VERIFIED ON HARDWARE. The data sheet has no VPSS register table. Derived by static disassembly of hi3520D_vpss.ko (Hi3520D_MPP_V2.0.5.1, OpenIPC copy with local symbols; the Xiongmai NBD7804T-F copy has the same code), docs/rdl-campaign/vpss.md. CONFIRMED FACTS (vendor code, HIGH): VPSS_HAL_Init ioremaps 0x20600000 for 0x4060 bytes (the vendor code touches nothing above 0x405F); VPSS_DRV_GetIrqId returns 69; the module is one 'group' per VPSS node: software builds a register-image node in DDR (the HAL functions VPSS_HAL_SetCtrl/SetSrcImgSize/SetCurPicAddr/SetDieCfg/SetChn* write bit fields into such a node image, which mirrors the register layout and is 0x420 bytes or more), links nodes through the word at node offset 0x3F0, and starts the hardware with the node address (linked-list register configuration as the data sheet describes). Only seven locations are accessed through the ioremapped window and are listed here as UNK_ registers: 0x0E0 (node ID read back), 0x3F0 (next node address), 0x400 (start), 0x404 (interrupt status), 0x408 (interrupt clear), 0x414 (outstanding configuration), 0x4000 (debug word). Everything else in the window is not described (SECOND PASS 2026-11-11: the DDR node image is now documented in eHISI_VPSS_V100_NODE; the VPSS bring-up order from the vendor SYS calls is PERI_CRG18 (0x20030048) bit 0 = 1 then 0 (reset pulse) THEN bit 1 = 1 (clock on): reset is released BEFORE the clock is enabled, unlike TDE/VEDU; HIGH, VPSS_DRV_AbolishReset). The names VPSS_* are GUESSES (the per-node configuration registers live in the node images; whether they are also memory-mapped is unknown). The names are placeholders (UNK_<offset>), the purposes come from the function names of the vendor HAL. The Hi3516C V100/Hi3518 V100/Hi3518E V100 VPSS sits at the same base and has the same feature list, but no register-level comparison is possible, so only the Hi3520D family files (Hi3520D, Hi3515A, Hi3515C; the Hi3515A/C instantiation is inferred) use this edition.";

    reg {
        name = "VPSS_NODE_ID";
        desc = "VPSS_NODE_ID (GUESS: the name is inferred from the vendor HAL function name; it is not a vendor register name). NOT IN THE DATA SHEET. Source: hi3520D_vpss.ko VPSS_HAL_GetNodeID (0x185d4): one word read from the ioremapped window, called from the interrupt path after VPSS_HAL_GetIntStatus/ClrInt (VPSS_COMM_IrqProc 0x1d430); the same offset in the node image is written by VPSS_HAL_SetNodeID (0x17698). Vendor meaning: ID of the node the hardware just finished. Confidence MEDIUM (offset and read HIGH, meaning inferred from the function name), not verified on hardware. SECOND PASS (2026-11-11, docs/rdl-campaign/vpss-vendor.md): read once per interrupt after the status read and the clear; the interrupt handler compares it with the ID of the node it expects (VPSS_COMM_IrqProc logs a mismatch and still runs the list completion, HIGH for the access pattern). GUESS: node ID of the last completed node (MEDIUM).";

        field {
            name = "unk";
            desc = "Unknown 32-bit value (vendor: node ID of the completed node).";
            sw = r;
            hw = w;
        } unk[31:0];

    } VPSS_NODE_ID @ 0x0E0;

    reg {
        name = "VPSS_NEXT_NODE";
        desc = "VPSS_NEXT_NODE (GUESS: the name is inferred from the vendor HAL function name; it is not a vendor register name). NOT IN THE DATA SHEET. Source: hi3520D_vpss.ko VPSS_HAL_Start (0x186f0): writes the node address (physical address of the DDR node image) to this word and reads it back in a loop until it equals the written value (retry with printk on mismatch), then writes 1 to 0x400. VPSS_HAL_GetNextInfo (0x184b0) reads it. In the node image the same offset is the pointer to the next node (VPSS_HAL_SetNext 0x17684). Vendor meaning: address of the first or next node of the linked list. Confidence MEDIUM (offsets and access pattern HIGH, meaning from the function names), not verified on hardware. SECOND PASS: the start sequence writes the first node address here and reads it back until it matches (a retry loop with a printk), so the register is a latch that may take time to accept the write (HIGH for the pattern; the reason is unknown). GUESS: next/first node address (MEDIUM).";

        field {
            name = "unk";
            desc = "Node address (vendor-derived, MEDIUM).";
            sw = rw;
            hw = r;
        } unk[31:0];

    } VPSS_NEXT_NODE @ 0x3F0;

    reg {
        name = "VPSS_START";
        desc = "VPSS_START (GUESS: the name is inferred from the vendor HAL function name; it is not a vendor register name). NOT IN THE DATA SHEET. Source: hi3520D_vpss.ko VPSS_HAL_Start (0x186f0): after the node address was written to 0x3F0 and verified, the value 1 is written here (the only value ever written). Vendor meaning: start. Confidence MEDIUM, not verified on hardware. SECOND PASS: GUESS: start trigger (MEDIUM). Written once per list, always after the node address was verified.";

        field {
            name = "unk";
            desc = "Written with 1 to start processing the linked list (vendor-derived, MEDIUM). Read behavior unknown.";
            sw = rw;
            hw = r;
        } unk[31:0];

    } VPSS_START @ 0x400;

    reg {
        name = "VPSS_INT_STATUS";
        desc = "VPSS_INT_STATUS (GUESS: the name is inferred from the vendor HAL function name; it is not a vendor register name). NOT IN THE DATA SHEET. Source: hi3520D_vpss.ko VPSS_HAL_GetIntStatus (0x18574): reads the whole word; called by VPSS_COMM_IrqProc (0x1d430, the interrupt handler path, IRQ 69) before the node ID is read and the interrupt cleared. Vendor meaning: interrupt status; bit meanings not seen in the HAL (the whole word is passed up). Confidence MEDIUM, not verified on hardware. SECOND PASS: the vendor classifier VPSS_DRV_IsWrongInt looks only at bits [3:0]: the value 4 is treated as an abnormal interrupt (logged, counted, not processed as a completion), 2 is an assertion failure (panic: never expected), 0 is logged but processed, everything else (for example bit 0 or bit 3) is a normal completion. So bit 2 is probably an error (timeout or bus error) and bit 0 or 3 the completion (INFERRED, LOW-MEDIUM).";

        field {
            name = "unk";
            desc = "Interrupt status word (vendor-derived, MEDIUM; bits not decoded).";
            sw = r;
            hw = w;
        } unk[31:0];

    } VPSS_INT_STATUS @ 0x404;

    reg {
        name = "VPSS_INT_CLEAR";
        desc = "VPSS_INT_CLEAR (GUESS: the name is inferred from the vendor HAL function name; it is not a vendor register name). NOT IN THE DATA SHEET. Source: hi3520D_vpss.ko VPSS_HAL_ClrInt (0x18690): writes 0xFFFFFFFF (all ones) to this word, called from the interrupt path. Vendor meaning: interrupt clear (write 1 to clear is assumed, the vendor writes all ones). Confidence MEDIUM, not verified on hardware. SECOND PASS: GUESS: interrupt clear, written before the node ID is read (MEDIUM).";

        field {
            name = "unk";
            desc = "Interrupt clear (vendor writes 0xFFFFFFFF; vendor-derived, MEDIUM).";
            sw = w;
            hw = r;
        } unk[31:0];

    } VPSS_INT_CLEAR @ 0x408;

    reg {
        name = "VPSS_OUTSTANDING";
        desc = "VPSS_OUTSTANDING (GUESS: the name is inferred from the vendor HAL function name; it is not a vendor register name). NOT IN THE DATA SHEET. Source: hi3520D_vpss.ko VPSS_HAL_SetOutstanding (0x18634): writes one whole word (argument r1) to this location of the ioremapped window. The node image has a word at the same offset (VPSS_HAL_SetMiscellaneous 0x17664 sets bits [23:16] in it, 'miscellaneous', values 3 and 100 seen in VPSS_DRV_SetModelParam 0x1610c). The data sheet says only that the block supports 'outstanding configuration'. Vendor meaning: outstanding (AXI) configuration. Confidence MEDIUM, not verified on hardware. SECOND PASS: the same offset in the node image is a word whose bits [23:16] hold a vendor 'miscellaneous' value (see eHISI_VPSS_V100_NODE N_MISC). GUESS (MEDIUM).";

        field {
            name = "unk";
            desc = "Outstanding configuration word (vendor-derived, MEDIUM).";
            sw = rw;
            hw = r;
        } unk[31:0];

    } VPSS_OUTSTANDING @ 0x414;

    reg {
        name = "VPSS_DEBUG";
        desc = "VPSS_DEBUG (GUESS: the name is inferred from the vendor HAL function name; it is not a vendor register name). NOT IN THE DATA SHEET. Source: hi3520D_vpss.ko VPSS_HAL_GetDbgInfo (0x18510): one word read (offset 0x4000 formed as a 16384 register-offset operand), exposed through the module's debug/proc output. The vendor ioremap is 0x4060 bytes, so 0x4000..0x405F exist. Vendor meaning: debug/status word. Confidence LOW, not verified on hardware. SECOND PASS: still LOW.";

        field {
            name = "unk";
            desc = "Debug word (vendor-derived, LOW).";
            sw = r;
            hw = w;
        } unk[31:0];

    } VPSS_DEBUG @ 0x4000;

    external mem {
        name = "Rest of the window (not described)";
        desc = "The rest of the 64 KB window above 0x4004 and the gaps between the registers listed above (no vendor access seen through the window). Kept so that the block size exists in the map. No registers are described.";
        mementries = 12287;
        memwidth = 32;
        sw = rw;
    } REST @ 0x4004;
};

regfile eHISI_VPSS_V100_NODE {
    name = "HiSilicon VPSS, Hi3520D job node image (in DDR, NOT MMIO registers)";
    desc = "NOT A REGISTER FILE: layout of one hardware node (register image) in DDR as built by the vendor HAL (VPSS_HAL_Set* functions of hi3520D_vpss.ko, docs/rdl-campaign/vpss-vendor.md), described as a regfile only to document offsets and bit fields. NOT INSTANTIATED. NOT VERIFIED ON HARDWARE. Confidence: every offset and bit position is read from the instruction stream of the HAL setters (HIGH); every NAME and MEANING is inferred from the vendor function name, the data-sheet feature list or the HiSTB-style conventions, and marked GUESS or INFERRED (LOW unless stated). The image is 0x420 bytes or more (highest word 0x41C): the vendor allocates a model buffer per node (VPSS_DRV_MallocModelBuf); the VPSS_HAL_NodeQueue* functions keep free/wait/busy lists of them. VPSS_COMM_HalListInt links the nodes through NEXT (offset 0x3F0), stamps NODE_ID (0xE0), sets MASK (0xEC) to 0 for all nodes but the last (7) and writes the first node's physical address into the MMIO register VPSS_NEXT_NODE followed by 1 into VPSS_START. Which words are fetched by the hardware (all 0x420 bytes or only the words selected by MASK) is NOT known. Words the vendor HAL never writes are not described. The Hi3520D HAL setters VPSS_HAL_SetIeCfg, SetDieCfg and SetChnSpCfg are EMPTY functions (no node fields), so image enhancement, de-interlace and sharpening parameters are not set through this HAL on this chip (INFERRED: the vendor build either keeps them at their reset values or controls them through CTRL bits only; the 3D noise reduction fields are likewise not identified). Hardware-side coefficient tables are DDR buffers referenced by address (16-byte aligned).";
    reg {
        name = "Control flags (node word 0)";
        desc = "Node image offset 0x000. 22 one-bit flags at bits 0..21 and three 2-bit fields at [25:24], [27:26], [29:28], written by VPSS_HAL_SetCtrl from a 25-word argument structure (argument index to bit: 0->5, 1->6, 2->7, 3->9, 4->10, 5->11, 6->12, 7->0, 8->1, 9->2, 10->3, 11->13, 12->14, 13->15, 14->16, 15->17, 16->18, 17->19, 18->20, 19->21, 20->4, 21->8, 22 -> [25:24] with 23 -> [27:26], 24 -> [29:28]). The vendor argument names are not in the module, so the bits are not named; by the data-sheet feature list they are probably enables of the processing stages (3D NR, de-interlace, image enhancement, sharpening, border, the channels) but no bit can be assigned to a stage (GUESS, LOW).  Source: hi3520D_vpss.ko. Not verified on hardware. CTRL bit sources (round 7, PROVEN by EXECUTING VPSS_DRV_SetModelCfg of hi3520D_vpss.ko under qemu-arm with the ko-harness and sweeping every input field one at a time; this CORRECTS the earlier static reading of the bit order): group attribute fields (VpssCheckGrpAttr layout, +0x14 bIeEn, +0x18 bNrEn, +0x1C bHistEn, +0x20 DieMode): bit 5 = IeEn; bit 6 and bit 8 = any of NrEn, HistEn, DieMode non-zero (both always together: reference/state buffers needed); bit 7 = HistEn == 1; bit 13 = DieMode == 1; bit 21 = the model word at attribute +0x24 non-zero (name unknown); bit 4 = attribute word +0x310 == 2; bit 15 = node-list mode word (+0x270 of the per-job structure) == 1; bits 16, 17, 18, 19, 20 = 'filter mode == 18' of the words at attribute +0x290, +0x2B8, +0x240, +0x268, +0x1C8 (five scaler filter selections; 18 is the vendor ZoomType constant); channel records (stride 0x4C, first at attribute +0x2C): record 0 -> enable bit 2 and, when its second word is also non-zero, bit 11; record 1 -> bits 3 and 12; record 2 -> bits 0 and 9; record 3 -> bits 1 and 10; bit 14 is always 1; [25:24] = 2 and [27:26] = 3 constant in this driver; bits 22, 23 and [29:28], 30, 31 were never set by any single-field change (unresolved, probably combinations). Meanings of the groups are INFERRED from the field names only. Executed values are what the vendor DRIVER computes, not proof of what the hardware does with them. Vendor check strings show NrEn, DieMode, DrEn, DbEn, IeEn, HistEn, SpEn, FrmWkEn, CropEn exist as separate settings and that 'HistEn/NrEn/Die and Dr/Db cannot be enabled at the same time'.";
        field {
            name = "flag0";
            desc = "Control flag, purpose unknown. POSITION seen in hi3520D_vpss.ko (HIGH); MEANING INFERRED from the HAL function name only (LOW) Not verified on hardware.";
            sw = rw;
            hw = r;
        } flag0[0:0];
        field {
            name = "flag1";
            desc = "Control flag, purpose unknown. POSITION seen in hi3520D_vpss.ko (HIGH); MEANING INFERRED from the HAL function name only (LOW) Not verified on hardware.";
            sw = rw;
            hw = r;
        } flag1[1:1];
        field {
            name = "flag2";
            desc = "Control flag, purpose unknown. POSITION seen in hi3520D_vpss.ko (HIGH); MEANING INFERRED from the HAL function name only (LOW) Not verified on hardware.";
            sw = rw;
            hw = r;
        } flag2[2:2];
        field {
            name = "flag3";
            desc = "Control flag, purpose unknown. POSITION seen in hi3520D_vpss.ko (HIGH); MEANING INFERRED from the HAL function name only (LOW) Not verified on hardware.";
            sw = rw;
            hw = r;
        } flag3[3:3];
        field {
            name = "flag4";
            desc = "Control flag, purpose unknown. POSITION seen in hi3520D_vpss.ko (HIGH); MEANING INFERRED from the HAL function name only (LOW) Not verified on hardware.";
            sw = rw;
            hw = r;
        } flag4[4:4];
        field {
            name = "flag5";
            desc = "Control flag, purpose unknown. POSITION seen in hi3520D_vpss.ko (HIGH); MEANING INFERRED from the HAL function name only (LOW) Not verified on hardware.";
            sw = rw;
            hw = r;
        } flag5[5:5];
        field {
            name = "flag6";
            desc = "Control flag, purpose unknown. POSITION seen in hi3520D_vpss.ko (HIGH); MEANING INFERRED from the HAL function name only (LOW) Not verified on hardware.";
            sw = rw;
            hw = r;
        } flag6[6:6];
        field {
            name = "flag7";
            desc = "Control flag, purpose unknown. POSITION seen in hi3520D_vpss.ko (HIGH); MEANING INFERRED from the HAL function name only (LOW) Not verified on hardware.";
            sw = rw;
            hw = r;
        } flag7[7:7];
        field {
            name = "flag8";
            desc = "Control flag, purpose unknown. POSITION seen in hi3520D_vpss.ko (HIGH); MEANING INFERRED from the HAL function name only (LOW) Not verified on hardware.";
            sw = rw;
            hw = r;
        } flag8[8:8];
        field {
            name = "flag9";
            desc = "Control flag, purpose unknown. POSITION seen in hi3520D_vpss.ko (HIGH); MEANING INFERRED from the HAL function name only (LOW) Not verified on hardware.";
            sw = rw;
            hw = r;
        } flag9[9:9];
        field {
            name = "flag10";
            desc = "Control flag, purpose unknown. POSITION seen in hi3520D_vpss.ko (HIGH); MEANING INFERRED from the HAL function name only (LOW) Not verified on hardware.";
            sw = rw;
            hw = r;
        } flag10[10:10];
        field {
            name = "flag11";
            desc = "Control flag, purpose unknown. POSITION seen in hi3520D_vpss.ko (HIGH); MEANING INFERRED from the HAL function name only (LOW) Not verified on hardware.";
            sw = rw;
            hw = r;
        } flag11[11:11];
        field {
            name = "flag12";
            desc = "Control flag, purpose unknown. POSITION seen in hi3520D_vpss.ko (HIGH); MEANING INFERRED from the HAL function name only (LOW) Not verified on hardware.";
            sw = rw;
            hw = r;
        } flag12[12:12];
        field {
            name = "flag13";
            desc = "Control flag, purpose unknown. POSITION seen in hi3520D_vpss.ko (HIGH); MEANING INFERRED from the HAL function name only (LOW) Not verified on hardware.";
