    reg {
        name = "Identification register PCELLID1";
        desc = "PrimeCell ID 1. Read-only.

ARM PrimeCell Vectored Interrupt Controller (PL190) TRM; not in any HiSilicon data sheet, not hardware verified.";

        field {
