    reg {
        name = "Identification register PERIPHID2";
        desc = "Revision [7:4] (implementation dependent) and designer [7:4] = 0x4 (ARM). Read-only.

ARM PrimeCell Vectored Interrupt Controller (PL190) TRM; not in any HiSilicon data sheet, not hardware verified. Revision-dependent byte: no reset value given.";

        field {
            name = "id";
            desc = "Identification byte.";
            sw = r;
            hw = w;
        } id[7:0];
    } INT_PERIPHID2 @ 0xFE8;

    reg {
        name = "Identification register PERIPHID3";
        desc = "Configuration. Read-only.

ARM PrimeCell Vectored Interrupt Controller (PL190) TRM; not in any HiSilicon data sheet, not hardware verified.";

        field {
