    reg {
        name = "V1 channel update enable register";
        desc = "V1_UPD is a V1 channel update enable register.

Data sheet 9.2.6 V1_UPD (offset 0x1004, printed page 9-87, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 54556).";

