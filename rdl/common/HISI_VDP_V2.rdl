`ifndef HISI_VDP_V2_RDL
`define HISI_VDP_V2_RDL

// VDP (one video layer, one graphics layer, one BT.656/LCD display channel) of the Hi3518EV200 / Hi3516CV200 (data sheet 9.2).
regfile eHISI_VDP_V2 {
    name = "VDP (video display processor, V1 + G2 + DHD1)";
    desc = "
    Video display processor (VDP) of the Hi3518E V20X / Hi3516C V200 at 0x205C0000 (data sheet 9.2), VIC interrupt 23: one video layer V1 and one graphics layer G2 (surfaces read from DDR
    over the MAC), the crossbar mixer CBM2 overlaying them, and one display channel DHD1 with the ITU-R BT.656 / LCD 565 serial digital output interfaces (BT and LCD registers); vertical
    timing interrupt per channel.

    Register groups (data sheet 9.2.5): 0x0000-0x0034 global (VOCTRL, interrupts, version, VOAXICTRL), 0x0100 VO_MUX, 0x1000-0x120C video layer V1 (control, update, resolution, CBM
    parameters, positions, background, alpha, CSC, horizontal FIR coefficients, picture addresses/stride), 0x7000-0x70DC graphics layer G2 (control, address/stride, resolution, colour
    key, mask, palette, positions, CSC), 0xB420-0xB428 CBM background / mixer, 0xC400-0xC4F0 display channel DHD1 (control, sync timing, power, thresholds, start position, state),
    0xD210-0xD288 BT output clip / dither, 0xD400-0xD408 LCD output.

    **Other chips (data sheet cross-check 2026-11-09, register summaries compared by offset, name, fields and reset value):** this is the V1 / G2 / DHD1 VDP generation that the Hi3516A V100
    (153 registers, 79 of these 81 identical: no LCD_CTRL/LCD_SYNC_INV; adds VO_MUX_DAC/TESTSYNC/TESTDATA, VO_DAC_*, COEF_DATA, BT_CTRL and the DATE CVBS encoder at 0xF200-0xF350), the
    Hi3516C V300 / Hi3516E V100 (59 registers, 39 identical: no G2 layer, no V1 positions/alpha/IFIR coefficients, no CBM_BKG2/CBM_MIX2, no DHD1_VTTHD3/PARATHD/START_POS; adds VO_DAC_CTRL/
    VO_DAC_0_CTRL/VO_DAC_STAT0 and a 20-register DATE at 0xF200) and the Hi3516A V200 / Hi3519 V101 (116 registers, 67 identical: no V1_VFPOS/VLPOS/BK/ALPHA/IFIRCOEF, no G2_PARAADDR/PARAUP/
    VFPOS/VLPOS/BK/ALPHA; adds VOMEM_CTRL, VOMIDORDER, VO_MUX_TEST*, VO_DAC_*, V1 decompression registers, BT_CTRL and the DATE at 0xF200) share. The common registers agree field by field with
    this file in all four data sheets, except: VO_MUX reset 0x0001_6540 (Hi3516C V300 and Hi3516A V200 data sheets) versus 0 here (Hi3518E V20X data sheet, which also prints bits [27:0] as
    reserved); G2_CSC_IDC/ODC/IODC/P0-P4 coefficients are RW on the Hi3516A V100 but RO here (fixed G2 CSC coefficients, as the Hi3518E V20X data sheet says); G2_UPD.regup is WO on the
    Hi3516A V200; the other chips add interrupt bits (vdac0_unload_int, v1_dl/dc_err_int are modelled here because the Hi3518E V20X data sheet lists them) and V1_CTRL / DHD1_VTTHD / LCD_CTRL
    bits. Those chips are not instantiated with this regfile (chip-specific variants are needed). It is NOT the Hi3520D VDP (`eHISI_VDP`, multiple VHD/VSD layers and DATE encoders).
    Register table: data sheet 9.2.5 / 9.2.6 (`hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` lines 53919-56882), 81 registers transcribed with fields, access types and reset values; vendor driver binary only; no hardware verification.
    ";

    reg {
        name = "VO control register";
        desc = "VOCTRL is a VO control register. It is used to configure the arbitration mode of surface bus requests.

Data sheet 9.2.6 VOCTRL (offset 0x0, printed page 9-79, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 54130).";

        enum VOCTRL_vo_ck_gt_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "vo_ck_gt_en";
            desc = "VDP clock gating enable";
            sw = rw;
            hw = r;
            encode = VOCTRL_vo_ck_gt_en_enum;
            reset = 0x0;
        } vo_ck_gt_en[31:31];

        enum VOCTRL_m0_arb_mode_enum {
            POLLING = 0 { name = "Polling"; desc = "polling"; };
            GRAPHICS_LAYER_FIRST = 1 { name = "Graphics Layer First"; desc = "graphics layer first Other values: reserved"; };
        };

        field {
            name = "m0_arb_mode";
            desc = "Arbitration mode of data requests of internal surface buses of VO MAC0";
            sw = rw;
            hw = r;
            encode = VOCTRL_m0_arb_mode_enum;
            reset = 0x0;
        } m0_arb_mode[3:0];
    } VOCTRL @ 0x0;

    reg {
        name = "VO interrupt status register (read-only)";
        desc = "VOINTSTA is a VO interrupt status register (read-only).

Data sheet 9.2.6 VOINTSTA (offset 0x4, printed page 9-80, `hi3518ev200--Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 54175).";

