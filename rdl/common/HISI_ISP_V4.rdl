regfile eISP_VICAP_CH_V4 {
    name = "ISP VICAP channel registers (Hi3516E V200 generation)";
    desc = "PROVEN (layout): register offsets, names and bit positions are the vendor register header isp_reg_define.h shipped with the Hi3516E V200 ISP library (sources/openhisilicon/libraries/isp/arch/hi3516ev200/include, channel 0 at VI window 0x11000000 + 0x10000 (ISP_VICAP_CH_REG_BASE = 0x11010000, stride 0x1000 per pipe); struct S_ISP_VICAP_CH_REGS_TYPE). The same header is used by the SDK kernel ISP driver (kernel/isp/arch/hi3516ev200/hal/isp_drv.c, which maps this window with osal_ioremap) and by libisp. GUESS: access types (all left read/write) and reset values (the header has none). Field names are the vendor names; reserved fields omitted. Hardware not read.";
    reg {
        name = "VI_CH_REG_NEWER";
        field { } ch_reg_newer[0:0];
    } VI_CH_REG_NEWER @ 0x4;
    reg {
        name = "CH_WCH_STT_CFG";
        field { } ch_wch_stt_finish_mode[17:17];
        field { } ch_wch_stt_32b_align[30:30];
    } CH_WCH_STT_CFG @ 0x200;
    reg {
        name = "CH_WCH_STT_AE_HIST_ADDR_L";
        field { } ch_wch_stt_aest_addr_l[31:0];
    } CH_WCH_STT_AE_HIST_ADDR_L @ 0x208;
    reg {
        name = "CH_WCH_STT_AE_AVER_R_GR_ADDR_L";
        field { } ch_wch_stt_ae_aver_r_gr_addr_l[31:0];
    } CH_WCH_STT_AE_AVER_R_GR_ADDR_L @ 0x210;
    reg {
        name = "CH_WCH_STT_AE_AVER_GB_B_ADDR_L";
        field { } ch_wch_stt_ae_aver_gb_b_addr_l[31:0];
    } CH_WCH_STT_AE_AVER_GB_B_ADDR_L @ 0x218;
};

