regfile eISP_BE_V4 {
    name = "ISP back end registers (Hi3516E V200 generation)";
    desc = "PROVEN (layout): register offsets, names and bit positions are the vendor register header isp_reg_define.h shipped with the Hi3516E V200 ISP library (sources/openhisilicon/libraries/isp/arch/hi3516ev200/include, back end pipe 0 at 0x11220000 (ISP_BE_REG_BASE, stride 0x40000); struct S_ISPBE_REGS_TYPE (the VIPROC copy and the LUT image at struct offset 0x7E80.. are in-memory images, not listed)). The same header is used by the SDK kernel ISP driver (kernel/isp/arch/hi3516ev200/hal/isp_drv.c, which maps this window with osal_ioremap) and by libisp. GUESS: access types (all left read/write) and reset values (the header has none). Field names are the vendor names; reserved fields omitted. Hardware not read.";
