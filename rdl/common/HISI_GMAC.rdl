    reg {
        name = "MDIO read data status register";
        desc = "MDIO_RDATA_STATUS is an MDIO read data status register.

Linux (MDIO_R_VALID, bit 0 set = \"SMI bus read not valid\", an error) and the vendor U-Boot (test_mdio_read_data_done: status == 0) agree with the data sheet that 0 means valid read data.

Data sheet 5.7 MDIO_RDATA_STATUS (offset 0x3D0, printed page 5-66, `Hi3516AV200-Datasheet.txt` line 33493).
Hi3516 V100 data sheet (Chinese original) 5.6 MDIO_RDATA_STATUS (offset 0x3D0, printed page 5-80, `Hi3516-Datasheet.txt` line 32646).";

        enum MDIO_RDATA_STATUS_mdio_rdata_status_enum {
            VALID = 0 { name = "Valid"; desc = "valid"; };
            INVALID = 1 { name = "Invalid"; desc = "invalid"; };
        };

        field {
            name = "mdio_rdata_status";
            desc = "Whether the data read by the MDIO is valid";
            sw = r;
            hw = w;
            onread = rclr;
            encode = MDIO_RDATA_STATUS_mdio_rdata_status_enum;
            reset = 0x0;
        } mdio_rdata_status[0:0];
    } MDIO_RDATA_STATUS @ 0x3D0;

    reg {
        name = "Start address register for the idle descriptor queue";
        desc = "RX_FQ_START_ADDR is a start address register for the idle descriptor queue.

Queue registers RX_FQ (idle descriptor queue: software writes empty buffers, the MAC reads), RX_BQ (RX buffer queue: the MAC writes received-frame descriptors, software reads), TX_BQ (TX buffer queue: software writes, the MAC reads) and TX_RQ (TX recycle queue: the MAC writes completed descriptors, software reads) form four rings of 32-byte descriptors in DDR; Linux hix5hd2_gmac.c programs all of them with the same offsets (0x500..0x5BC).

Data sheet 5.7 RX_FQ_START_ADDR (offset 0x500, printed page 5-66, `Hi3516AV200-Datasheet.txt` line 33522).
Hi3516 V100 data sheet (Chinese original) 5.6 RX_FQ_START_ADDR (offset 0x500, printed page 5-80, `Hi3516-Datasheet.txt` line 32676).";

        field {
            name = "fq_start_addr";
            desc = "Start address of the idle descriptor queue. When rx_fq_start_addr_en of the RX_FQ_REG_EN register is set to 1, the register can be read and written. When rx_fq_start_addr_en is set to 0, the register is read-only. Only word addresses are supported.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } fq_start_addr[31:0];
    } RX_FQ_START_ADDR @ 0x500;

    reg {
        name = "Depth register for the idle descriptor queue";
        desc = "RX_FQ_DEPTH is a depth register for the idle descriptor queue.

Data sheet 5.7 RX_FQ_DEPTH (offset 0x504, printed page 5-67, `Hi3516AV200-Datasheet.txt` line 33553).
Hi3516 V100 data sheet (Chinese original) 5.6 RX_FQ_DEPTH (offset 0x504, printed page 5-81, `Hi3516-Datasheet.txt` line 32709).";

        field {
            name = "fq_depth";
            desc = "Depth of the idle descriptor queue in the RX direction. It indicates the number of words, not the number of descriptors. When rx_fq_depth_en of the RX_FQ_REG_EN register is set to 1, the register can be read and written. When rx_fq_depth_en is set to 0, the register is read-only. The depth must be set to an integral multiple of 8. It is recommended that this field be set to at least 0x400.";
            sw = rw;
            hw = r;
            reset = 0x400;
        } fq_depth[18:0];
    } RX_FQ_DEPTH @ 0x504;

