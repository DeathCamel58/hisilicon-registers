    reg {
        name = "Rx_bq or tx_rq enqueue interrupt threshold register";
        desc = "IN_QUEUE_TH is an rx_bq or tx_rq enqueue interrupt threshold register.

Linux writes 1 for both thresholds (RX_BQ_INT_THRESHOLD, TX_RQ_INT_THRESHOLD).

Data sheet 5.7 IN_QUEUE_TH (offset 0x5D8, printed page 5-94, `Hi3516AV200-Datasheet.txt` line 35129).
Hi3516 V100 data sheet (Chinese original) 5.6 IN_QUEUE_TH (offset 0x5D8, printed page 5-107, `Hi3516-Datasheet.txt` line 34410).";

        field {
            name = "tx_rq_in_th";
            desc = "Threshold for reporting descriptor enqueue interrupts in the TX direction. The threshold must be greater than or equal to 1.";
            sw = rw;
            hw = r;
            reset = 0x1;
        } tx_rq_in_th[23:16];

        field {
            name = "rx_bq_in_th";
            desc = "Threshold for reporting descriptor enqueue interrupts in the RX direction. The threshold must be greater than or equal to 1.";
            sw = rw;
            hw = r;
            reset = 0x1;
        } rx_bq_in_th[7:0];
    } IN_QUEUE_TH @ 0x5D8;

    reg {
