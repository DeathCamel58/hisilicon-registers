    reg {
        name = "RX frame filter control register";
        desc = "REC_FILT_CONTROL is an RX frame filter control register.

Linux/U-Boot use the same bit masks (crc_err_pass bit 5 ... uc_match_en bit 0). Linux sets only crc_err_pass at init; the vendor U-Boot writes 0x3F and then clears bc_drop_en. vlan_drop_en does not exist on the Hi3516 V100 data sheet.

Data sheet 5.7 REC_FILT_CONTROL (offset 0x64, printed page 5-25, `Hi3516AV200-Datasheet.txt` line 31154).
Hi3516 V100 data sheet (Chinese original) 5.6 REC_FILT_CONTROL (offset 0x64, printed page 5-25, `Hi3516-Datasheet.txt` line 29384).";

        enum REC_FILT_CONTROL_crc_err_pass_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "crc_err_pass";
            desc = "CRC error frame filter enable";
            sw = rw;
            hw = r;
            encode = REC_FILT_CONTROL_crc_err_pass_enum;
            reset = 0x0;
        } crc_err_pass[5:5];

        enum REC_FILT_CONTROL_pause_frm_pass_enum {
            DISABLED_THIS_BIT = 0 { name = "Disabled This Bit"; desc = "disabled. This bit takes effect only when flow control is enabled, which is transmitted to the software."; };
            ENABLED_THIS_BIT = 1 { name = "Enabled This Bit"; desc = "enabled. This bit takes effect only when flow control is enabled, which is not transmitted to the software."; };
        };

        field {
            name = "pause_frm_pass";
            desc = "Flow control frame filter enable";
            sw = rw;
            hw = r;
            encode = REC_FILT_CONTROL_pause_frm_pass_enum;
            reset = 0x0;
        } pause_frm_pass[4:4];

`ifndef HISI_GMAC_HI3516V100
        enum REC_FILT_CONTROL_vlan_drop_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "vlan_drop_en";
            desc = "VLAN frame filter enable";
            sw = rw;
            hw = r;
            encode = REC_FILT_CONTROL_vlan_drop_en_enum;
            reset = 0x0;
        } vlan_drop_en[3:3];
`endif

