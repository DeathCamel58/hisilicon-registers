Data sheet 5.7 PMT_CTRL_STAUTS (offset 0xA00, printed page 5-103, `Hi3516AV200-Datasheet.txt` line 35619).";

        enum PMT_CTRL_STATUS_scr_wkupfrm_glbucast_enum {
