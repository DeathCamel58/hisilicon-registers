        field {
            name = "reserved_nz";
            desc = "Reserved (RO); reads 1: the data sheet total reset value is 0x0000_00D0 (this bit is link_sel on the Hi3516 V100; not read on hardware).";
            sw = r;
            hw = w;
            reset = 0x1;
        } reserved_nz[4:4];
`endif

`ifdef HISI_GMAC_HI3516V100
        field {
            name = "link_sel";
            desc = "Link status selection. 1: the link status is always forced to link up (default); 0: invalid. (Hi3516 V100 data sheet, Chinese original; read-only there.)";
