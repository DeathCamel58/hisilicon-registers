    reg {
        name = "MDIO single operation register";
        desc = "MDIO_SINGLE_CMD is an MDIO single operation register.

Linux MDIO_START = bit 20, MDIO_READ = start | bit 17 (op_code 2), MDIO_WRITE = start | bit 16 (op_code 1); the PHY address goes into bits 12:8 (the data sheet text in 5.4.5 says bit[9:8] for the write sequence, a typo; the older vendor U-Boot higmac masks the PHY address with 0x3 only and cannot address PHYs above 3). mdio_cmd is set by software and cleared by the MDIO logic when the operation completes.

Data sheet 5.7 MDIO_SINGLE_CMD (offset 0x3C0, printed page 5-63, `Hi3516AV200-Datasheet.txt` line 33372).
Hi3516 V100 data sheet (Chinese original) 5.6 MDIO_SINGLE_CMD (offset 0x3C0, printed page 5-77, `Hi3516-Datasheet.txt` line 32486).";

        enum MDIO_SINGLE_CMD_mdio_cmd_enum {
            COMPLETE = 0 { name = "Complete"; desc = "The operation through the MDIO is complete."; };
            START = 1 { name = "Start"; desc = "The operation through the MDIO starts."; };
        };

        field {
            name = "mdio_cmd";
            desc = "Operation completion through the MDIO indicator";
            sw = rw;
            hw = w;
            encode = MDIO_SINGLE_CMD_mdio_cmd_enum;
            reset = 0x0;
        } mdio_cmd[20:20];

        enum MDIO_SINGLE_CMD_op_code_enum {
            RESERVED_0 = 0 { name = "Reserved"; desc = "Reserved"; };
            WRITE = 1 { name = "Write"; desc = "Write"; };
            READ = 2 { name = "Read"; desc = "Read"; };
            RESERVED_3 = 3 { name = "Reserved"; desc = "Reserved"; };
        };

        field {
            name = "op_code";
            desc = "MDIO operation type";
            sw = rw;
            hw = r;
            encode = MDIO_SINGLE_CMD_op_code_enum;
            reset = 0x0;
        } op_code[17:16];

        field {
            name = "phy_addr";
            desc = "5 bits of the external PHY address";
            sw = rw;
            hw = r;
            reset = 0x0;
        } phy_addr[12:8];

        field {
            name = "reg_addr";
            desc = "Internal address of the PHY component";
            sw = rw;
            hw = r;
            reset = 0x0;
        } reg_addr[4:0];
    } MDIO_SINGLE_CMD @ 0x3C0;

    reg {
        name = "MDIO read/write data register";
        desc = "MDIO_SINGLE_DATA is an MDIO read/write data register.

Linux reads the PHY register data from bits 31:16 after mdio_cmd returns to 0.

Data sheet 5.7 MDIO_SINGLE_DATA (offset 0x3C4, printed page 5-64, `Hi3516AV200-Datasheet.txt` line 33420).
Hi3516 V100 data sheet (Chinese original) 5.6 MDIO_SINGLE_DATA (offset 0x3C4, printed page 5-78, `Hi3516-Datasheet.txt` line 32540).";

        field {
            name = "mdio_rd_data";
            desc = "Data that is read back from the external PHY through the MDIO";
            sw = r;
            hw = w;
            reset = 0x0;
        } mdio_rd_data[31:16];

        field {
            name = "mdio_wr_data";
            desc = "Data that is written through the MDIO";
            sw = rw;
            hw = r;
            reset = 0x0;
        } mdio_wr_data[15:0];
    } MDIO_SINGLE_DATA @ 0x3C4;

`ifdef HISI_GMAC_HI3516V100
