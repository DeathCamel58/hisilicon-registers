    reg {
        name = "Cff read/write descriptor enable register";
        desc = "DESC_WR_RD_ENA is a cff read/write descriptor enable register.

Linux writes 0xF to enable all four descriptor engines and 0 to disable them; vendor U-Boot higmac_desc_enable sets the same four bits.

Data sheet 5.7 DESC_WR_RD_ENA (offset 0x5CC, printed page 5-93, `Hi3516AV200-Datasheet.txt` line 35076).
Hi3516 V100 data sheet (Chinese original) 5.6 DESC_WR_RD_ENA (offset 0x5CC, printed page 5-106, `Hi3516-Datasheet.txt` line 34349).";

        enum DESC_WR_RD_ENA_rx_outcff_wr_desc_ena_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "rx_outcff_wr_desc_ena";
            desc = "RX_OUTCFF write descriptor to RX_BQ enable in the RX direction";
            sw = rw;
            hw = r;
