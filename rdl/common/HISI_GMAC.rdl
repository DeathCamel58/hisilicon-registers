            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "crf_peel_dsa";
            desc = "DA/SA stripping control enable";
            sw = rw;
            hw = r;
            encode = CONTROL_WORD_crf_peel_dsa_enum;
            reset = 0x0;
        } crf_peel_dsa[15:15];

        enum CONTROL_WORD_crf_add_da_sa_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLE_F = 1 { name = "Enable F"; desc = "enable"; };
        };

        field {
            name = "crf_add_da_sa";
            desc = "DA/SA addition control enable";
            sw = rw;
            hw = r;
            encode = CONTROL_WORD_crf_add_da_sa_enum;
            reset = 0x0;
        } crf_add_da_sa[14:14];

        field {
            name = "crf_large_packet";
            desc = "Maximum length configured for packets. The default length is 1600 bytes (maximum length of packets used by the PMU).";
            sw = rw;
            hw = r;
            reset = 0x640;
        } crf_large_packet[13:0];
    } CONTROL_WORD @ 0x214;

    reg {
        name = "Flow control packet count register SLD";
        desc = "FLOW_CTRL_PKG_THRSLD is a flow control packet number threshold register.

Data sheet 5.7 FLOW_CTRL_PKG_THRSLD (offset 0x218, printed page 5-52, `Hi3516AV200-Datasheet.txt` line 32703).
Hi3516 V100 data sheet (Chinese original) 5.6 FLOW_CTRL_PKG_THRSLD (offset 0x218, printed page 5-49, `Hi3516-Datasheet.txt` line 30876).";

        field {
            name = "crf_ip_pkg_thrsld";
            desc = "Upper threshold of the number of IP packets. When the number of IP packets that are received within period T exceeds the configured value, the flow is controlled. Otherwise, the flow is not controlled.";
            sw = rw;
            hw = r;
            reset = 0xFFFF;
        } crf_ip_pkg_thrsld[31:16];

        field {
            name = "crf_ctrl_pkg_thrsld";
            desc = "Upper threshold of the number of control packets. When the number of control packets that are received within period T exceeds the configured value, the flow is controlled. Otherwise, the flow is not controlled.";
            sw = rw;
            hw = r;
            reset = 0xFFFF;
        } crf_ctrl_pkg_thrsld[15:0];
    } FLOW_CTRL_PKG_THRSLD @ 0x218;

    reg {
        name = "Flow control time register SLD 0x00000220+ FILTER_LISTm (m Filter list register 4*m ranging from 0 to 15)";
        desc = "CRF_FLOW_TIME_THRSLD is a flow control time register.

Data sheet 5.7 CRF_FLOW_TIME_THRSLD (offset 0x21C, printed page 5-52, `Hi3516AV200-Datasheet.txt` line 32730).
Hi3516 V100 data sheet (Chinese original) 5.6 CRF_FLOW_TIME_THRSLD (offset 0x21C, printed page 5-49, `Hi3516-Datasheet.txt` line 30901).";

        field {
            name = "crf_flow_time_thrsld";
            desc = "Flow control time, measured by 125 µs Flow control time T = (crf_flow_time_thrsld + 1) x 125 µs";
            sw = rw;
            hw = r;
            reset = 0xFF;
        } crf_flow_time_thrsld[7:0];
    } CRF_FLOW_TIME_THRSLD @ 0x21C;

    reg {
        name = "FILTER_LISTm (m ranging from 0 to 15) is a filter list register";
        desc = "FILTER_LISTm (m ranging from 0 to 15) is a filter list register.

Sixteen registers at 0x220 + 4 x m (m = 0..15). The Hi3516 V100 data sheet prints them as sixteen separate registers FILTER_LIST0..FILTER_LIST15 (0x220..0x25C). The data sheet names the fields crf_filt_cfg0/crf_filt_id0/crf_filt_frm_type0 (the suffix 0 is dropped here, the description text uses the names without suffix).

Data sheet 5.7 FILTER_LISTm (offset 0x220, printed page 5-53, `Hi3516AV200-Datasheet.txt` line 32760).
Hi3516 V100 data sheet (Chinese original) 5.6 FILTER_LIST0..FILTER_LIST15 (offset 0x220, printed page 5-50, `Hi3516-Datasheet.txt` line 30934).";

        enum FILTER_LIST_crf_filt_cfg_enum {
            NOT_CONFIGURED = 0 { name = "Not configured"; desc = "not configured"; };
            CONFIGURED = 1 { name = "Configured"; desc = "configured; the content of this list needs to be parsed only when crf_filt_cfg is set to 1, otherwise it can be ignored"; };
        };

        field {
            name = "crf_filt_cfg";
            desc = "Configured row or not";
            sw = rw;
            hw = r;
            encode = FILTER_LIST_crf_filt_cfg_enum;
            reset = 0x0;
        } crf_filt_cfg[17:17];

        enum FILTER_LIST_crf_filt_id_enum {
            MAC_FRAME = 0 { name = "MAC frame"; desc = "MAC frame"; };
            IP = 1 { name = "IP"; desc = "IP"; };
        };

        field {
            name = "crf_filt_id";
            desc = "Type of the list";
            sw = rw;
            hw = r;
            encode = FILTER_LIST_crf_filt_id_enum;
            reset = 0x0;
        } crf_filt_id[16:16];

        field {
            name = "crf_filt_frm_type";
            desc = "Configured filter type When the ID is 0, 16 bits of crf_filt_frm_type are valid. When the ID is 1, the lower 8 bits of crf_filt_frm_type are valid, and the upper 8 bits are ignored.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } crf_filt_frm_type[15:0];
    } FILTER_LIST[16] @ 0x220 += 0x4;

    reg {
        name = "UDP port number register";
        desc = "CRF_UDP_NO is a UDP port number register.

Data sheet 5.7 CRF_UDP_NO (offset 0x260, printed page 5-54, `Hi3516AV200-Datasheet.txt` line 32808).
Hi3516 V100 data sheet (Chinese original) 5.6 CRF_UDP_NO (offset 0x260, printed page 5-65, `Hi3516-Datasheet.txt` line 31726).";

        field {
            name = "crf_udp_max_no";
            desc = "Maximum number of the UDP ports";
            sw = rw;
            hw = r;
            reset = 0xFFFF;
        } crf_udp_max_no[31:16];
    } CRF_UDP_NO @ 0x260;

    reg {
        name = "TX FIFO threshold register";
        desc = "CRF_TX_FIFO_THRSLD is a TX FIFO threshold register.

The data sheet text of crf_tx_p_empty_th says \"quadruples crf_tx_p_full_th\" (copy-paste, it means crf_tx_p_empty_th) and \"FX FIFO\".

Data sheet 5.7 CRF_TX_FIFO_THRSLD (offset 0x264, printed page 5-54, `Hi3516AV200-Datasheet.txt` line 32827).
Hi3516 V100 data sheet (Chinese original) 5.6 CRF_TX_FIFO_THRSLD (offset 0x264, printed page 5-66, `Hi3516-Datasheet.txt` line 31755).";

        field {
            name = "crf_tx_p_full_th";
            desc = "Upper threshold of the TX FIFO When the number of valid data packets in the TX FIFO quadruples crf_tx_p_full_th, packets are not transferred from the SDRAM. After the threshold is set, the TX FIFO has sufficient space to receive a packet with the longest frame. The maximum frame length of the packet can be set in CONTROL_WORD bit[13:0] and must meet the following formula: CONTROL_WORD bit[13:0] < 8192 - 4(crf_tx_p_full_th)";
            sw = rw;
            hw = r;
            reset = 0x271;
        } crf_tx_p_full_th[26:16];

        field {
            name = "crf_tx_p_empty_th";
            desc = "Lower threshold of the TX FIFO When the number of valid data packets in the TX FIFO quadruples crf_tx_p_full_th, data can be read from the FX FIFO. It is recommended that this threshold be set to 0x14.";
            sw = rw;
            hw = r;
            reset = 0x17C;
        } crf_tx_p_empty_th[10:0];
    } CRF_TX_FIFO_THRSLD @ 0x264;

    reg {
        name = "RX FIFO threshold register";
        desc = "CRF_RX_FIFO_THRSLD is an RX FIFO threshold register.

Differs between data sheets: Hi3516A/AV200/Hi3519 crf_rx_p_full_th is 12 bits (27:16, reset 3600) and crf_rx_p_empty_th 12 bits (11:0); the Hi3516 V100 has 11-bit fields (26:16 reset 1600 and 10:0) and total reset 0x0640_0200 instead of 0x0E10_0200.

Data sheet 5.7 CRF_RX_FIFO_THRSLD (offset 0x268, printed page 5-55, `Hi3516AV200-Datasheet.txt` line 32868).
Hi3516 V100 data sheet (Chinese original) 5.6 CRF_RX_FIFO_THRSLD (offset 0x268, printed page 5-66, `Hi3516-Datasheet.txt` line 31790).";

`ifndef HISI_GMAC_HI3516V100
        field {
            name = "crf_rx_p_full_th";
            desc = "Upper threshold of the RX FIFO When the number of valid data packets in the RX FIFO quadruples crf_rx_p_full_th, new packets are not written to the RX FIFO. After the threshold is set, the RX FIFO has sufficient space to receive a packet with the longest frame. The maximum frame length of the packet can be set in CONTROL_WORD bit[13:0] and must meet the following formula: CONTROL_WORD[13:0] < (8192 - 4(crf_rx_p_full_th)";
            sw = rw;
            hw = r;
            reset = 0xE10;
        } crf_rx_p_full_th[27:16];
`endif

`ifdef HISI_GMAC_HI3516V100
        field {
            name = "crf_rx_p_full_th";
            desc = "Upper threshold of the RX FIFO (Hi3516 V100: 11 bits, default 1600). When the number of valid data items in the RX FIFO reaches 4 x crf_rx_p_full_th, no new packet is written to the RX FIFO. After the threshold is set, the RX FIFO must keep enough space for one packet of the maximum frame length (CONTROL_WORD[13:0]): CONTROL_WORD[13:0] < 8192 - 4 x crf_rx_p_full_th.";
            sw = rw;
            hw = r;
            reset = 0x640;
        } crf_rx_p_full_th[26:16];
`endif

`ifndef HISI_GMAC_HI3516V100
        field {
            name = "crf_rx_p_empty_th";
            desc = "Lower threshold of the RX FIFO. When the number of valid data packets in the RX FIFO quadruples crf_rx_p_empty_th, data can be read from the RX FIFO. This threshold must be set to 0x200 at least.";
            sw = rw;
            hw = r;
            reset = 0x200;
        } crf_rx_p_empty_th[11:0];
`endif

`ifdef HISI_GMAC_HI3516V100
        field {
            name = "crf_rx_p_empty_th";
            desc = "Lower threshold of the RX FIFO (Hi3516 V100: 11 bits). When the number of valid data items in the RX FIFO reaches 4 x crf_rx_p_empty_th, data can be read from the RX FIFO. The threshold must be set to 0x200 at least.";
            sw = rw;
            hw = r;
            reset = 0x200;
        } crf_rx_p_empty_th[10:0];
`endif
    } CRF_RX_FIFO_THRSLD @ 0x268;

`ifdef HISI_GMAC_HI3516V100
