    reg {
        name = "RX and TX packet control stop register";
        desc = "STOP_CMD is an RX and TX packet control stop register.

Vendor U-Boot (higmac_desc_flush) sets the stop bit, waits for the flush flag, issues the flush command and then clears both again.

Data sheet 5.7 STOP_CMD (offset 0x5E8, printed page 5-96, `Hi3516AV200-Datasheet.txt` line 35239).
Hi3516 V100 data sheet (Chinese original) 5.6 STOP_CMD (offset 0x5E8, printed page 5-109, `Hi3516-Datasheet.txt` line 34529).";

        enum STOP_CMD_tx_stop_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "tx_stop_en";
            desc = "Packet TX stop enable";
            sw = rw;
            hw = r;
            encode = STOP_CMD_tx_stop_en_enum;
            reset = 0x0;
        } tx_stop_en[1:1];

        enum STOP_CMD_rx_stop_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "rx_stop_en";
            desc = "Packet RX stop enable";
            sw = rw;
            hw = r;
            encode = STOP_CMD_rx_stop_en_enum;
            reset = 0x0;
        } rx_stop_en[0:0];
    } STOP_CMD @ 0x5E8;

    reg {
        name = "Recycle descriptor enable register";
        desc = "FLUSH_CMD is a recycle descriptor enable register.

DISAGREEMENT: the data sheets (all four editions: this layout, bits 5:0, with tx/rx_flush_cmd at 5:4 and the four flush flags at 3:0) and Linux hix5hd2_gmac.c (BITS_TX_FLUSH_CMD = bit 5, BITS_RX_FLUSH_CMD = bit 4, BITS_TX_FLUSH_FLAG_DOWN = bit 3, ..._UP = bit 2, BITS_RX_FLUSH_FLAG_DOWN = bit 1, ..._UP = bit 0, defined but never used) agree; the vendor U-Boot drivers higmac and higmacv300 use a 4-bit layout (TX_FLUSH_CMD bit 3, RX_FLUSH_CMD bit 2, TX_FLUSH_FLAG bit 1, RX_FLUSH_FLAG bit 0) and poll the flag bit while writing the command bit. The data sheet layout is modelled (the flags are write-1-to-clear as the text says); the vendor layout is not hardware verified either.

Data sheet 5.7 FLUSH_CMD (offset 0x5EC, printed page 5-97, `Hi3516AV200-Datasheet.txt` line 35280).
Hi3516 V100 data sheet (Chinese original) 5.6 FLUSH_CMD (offset 0x5EC, printed page 5-109, `Hi3516-Datasheet.txt` line 34562).";

        enum FLUSH_CMD_tx_flush_cmd_enum {
            INVALID = 0 { name = "Invalid"; desc = "The recycle descriptor configuration command is invalid."; };
            VALID = 1 { name = "Valid"; desc = "The recycle descriptor configuration command is valid."; };
        };

        field {
            name = "tx_flush_cmd";
            desc = "Recycle descriptor command in the TX direction, instructing the descriptors to enter the tx_rq queue";
            sw = rw;
            hw = r;
            encode = FLUSH_CMD_tx_flush_cmd_enum;
            reset = 0x0;
        } tx_flush_cmd[5:5];

        enum FLUSH_CMD_rx_flush_cmd_enum {
            INVALID = 0 { name = "Invalid"; desc = "The recycle descriptor configuration command is invalid."; };
            VALID = 1 { name = "Valid"; desc = "The recycle descriptor configuration command is valid."; };
        };

        field {
            name = "rx_flush_cmd";
            desc = "Recycle descriptor command in the RX direction, instructing the descriptors to enter the rx_bq queue";
            sw = rw;
            hw = r;
            encode = FLUSH_CMD_rx_flush_cmd_enum;
            reset = 0x0;
        } rx_flush_cmd[4:4];

        field {
            name = "tx_flush_flag_down";
            desc = "Recycle descriptor stop indicator in the TX direction. After descriptors are recycled, the logic sets tx_flush_flag to 1, and the software writes 1 to clear the register.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            reset = 0x0;
        } tx_flush_flag_down[3:3];

        field {
            name = "tx_flush_flag_up";
            desc = "Recycle descriptor stop indicator in the TX direction. After RX and TX packets are stopped, the logic sets tx_flush_flag to 1, indicating that the software can recycle the descriptors. The software writes 1 to clear the register.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            reset = 0x0;
        } tx_flush_flag_up[2:2];

        field {
            name = "rx_flush_flag_down";
            desc = "Recycle descriptor stop indicator in the RX direction. After descriptors are recycled, the logic sets rx_flush_flag_down to 1, and the software writes 1 to clear the register.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            reset = 0x0;
        } rx_flush_flag_down[1:1];

        field {
            name = "rx_flush_flag_up";
            desc = "Recycle descriptor indicator in the RX direction. After RX packets are stopped, the logic sets rx_flush_flag_up to 1, indicating that the software can recycle the descriptors. The software writes 1 to clear the register.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            reset = 0x0;
        } rx_flush_flag_up[0:0];
    } FLUSH_CMD @ 0x5EC;

