        name = "MDIO automatic scan register";
        desc = "MDIO_SCAN_EN is mDIO automatic scan register.

Hi3516 V100 data sheet (Chinese original) 5.6 MDIO_SCAN_EN (offset 0x3C8, printed page 5-78, `Hi3516-Datasheet.txt` line 32561). Hi3516 V100 only (not in the Hi3516A, Hi3516A V200 and Hi3519 V101 data sheets).";

        field {
            name = "mdio_scan_en";
            desc = "Automatic scan enable for the PHY addresses, 1 = valid. (The note in the data sheet says the code was changed so that only one PHY can be attached.)";
            sw = rw;
            hw = r;
            reset = 0xF;
        } mdio_scan_en[3:0];
    } MDIO_SCAN_EN @ 0x3C8;
