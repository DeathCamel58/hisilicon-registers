Hi3516 V100 data sheet (Chinese original) 5.6 RX_FAIL_COMMA_CNT (offset 0x1F8, printed page 5-31, `Hi3516-Datasheet.txt` line 29755).";

        field {
            name = "rx_fail_comma_cnt";
            desc = "Count of COMMA codes when two or more COMMA codes exist during byte delimitation";
            sw = r;
            hw = w;
            onread = rclr;
            reset = 0x0;
        } rx_fail_comma_cnt[31:0];
    } RX_FAIL_COMMA_CNT @ 0x1F8;

    reg {
        name = "Source MAC address register";
        desc = "MAC_SA_ADDR_L is a source MAC address register.

Data sheet 5.7 MAC_SA_ADDR_L (offset 0x200, printed page 5-48, `Hi3516AV200-Datasheet.txt` line 32498).
Hi3516 V100 data sheet (Chinese original) 5.6 MAC_SA_ADDR_L (offset 0x200, printed page 5-45, `Hi3516-Datasheet.txt` line 30654).";

        field {
            name = "mac_sa_addr_l";
            desc = "Lower 32 bits of the source MAC address used by the PMU, which are inserted into the lower 32 bits of the source address (SA) field";
            sw = rw;
            hw = r;
            reset = 0x0;
        } mac_sa_addr_l[31:0];
    } MAC_SA_ADDR_L @ 0x200;

    reg {
        name = "Source MAC address register";
        desc = "MAC_SA_ADDR_H is a source MAC address register.

Data sheet 5.7 MAC_SA_ADDR_H (offset 0x204, printed page 5-49, `Hi3516AV200-Datasheet.txt` line 32523).
Hi3516 V100 data sheet (Chinese original) 5.6 MAC_SA_ADDR_H (offset 0x204, printed page 5-45, `Hi3516-Datasheet.txt` line 30675).";

        field {
            name = "mac_sa_addr_h";
            desc = "Upper 16 bits of the source MAC address used by the PMU";
            sw = rw;
            hw = r;
            reset = 0x0;
        } mac_sa_addr_h[15:0];
    } MAC_SA_ADDR_H @ 0x204;

    reg {
        name = "Destination MAC address register";
        desc = "MAC_DA_ADDR_L is a destination MAC address register.

Data sheet 5.7 MAC_DA_ADDR_L (offset 0x208, printed page 5-49, `Hi3516AV200-Datasheet.txt` line 32543).
Hi3516 V100 data sheet (Chinese original) 5.6 MAC_DA_ADDR_L (offset 0x208, printed page 5-46, `Hi3516-Datasheet.txt` line 30702).";

        field {
            name = "mac_da_addr_l";
            desc = "Lower 32 bits of the destination MAC address used by the PMU, which are inserted into the lower 32 bits of the destination address field";
            sw = rw;
            hw = r;
            reset = 0x0;
        } mac_da_addr_l[31:0];
    } MAC_DA_ADDR_L @ 0x208;

    reg {
        name = "Destination MAC address register";
        desc = "MAC_DA_ADDR_H is a destination MAC address register.

The data sheet places crf_tx_max_packet (bits 26:16) in this register; the Hi3516 V100 data sheet has no such field.

Data sheet 5.7 MAC_DA_ADDR_H (offset 0x20C, printed page 5-49, `Hi3516AV200-Datasheet.txt` line 32563).
Hi3516 V100 data sheet (Chinese original) 5.6 MAC_DA_ADDR_H (offset 0x20C, printed page 5-46, `Hi3516-Datasheet.txt` line 30723).";

`ifndef HISI_GMAC_HI3516V100
        field {
            name = "crf_tx_max_packet";
            desc = "Maximum length of the normal and SG packets allowed by the PMU";
            sw = rw;
            hw = r;
            reset = 0x0;
        } crf_tx_max_packet[26:16];
`endif

        field {
            name = "mac_da_addr_h";
            desc = "Upper 16 bits of the destination MAC address used by the PMU";
            sw = rw;
            hw = r;
            reset = 0x0;
        } mac_da_addr_h[15:0];
    } MAC_DA_ADDR_H @ 0x20C;

    reg {
        name = "Minimum filter packet length register";
        desc = "CRF_MIN_PACKET is a minimum filter packet length register.

Vendor U-Boot: BIT_TSO_VERSION = MK_BITS(20, 12), i.e. bits 31:20. Not present on the Hi3516 V100 (reserved there).

Data sheet 5.7 CRF_MIN_PACKET (offset 0x210, printed page 5-50, `Hi3516AV200-Datasheet.txt` line 32595).
Hi3516 V100 data sheet (Chinese original) 5.6 CRF_MIN_PACKET (offset 0x210, printed page 5-47, `Hi3516-Datasheet.txt` line 30754).";

`ifndef HISI_GMAC_HI3516V100
        field {
            name = "tso_version";
            desc = "TSO version 100: single-byte combination version 200: SG or COE version 300: TSO version";
            sw = r;
            hw = w;
            reset = 0x0;
        } tso_version[31:20];
`endif

        field {
            name = "crf_tx_min_packet";
            desc = "Minimum length of the TX packet. The default length is 15 bytes.";
            sw = rw;
            hw = r;
            reset = 0xF;
        } crf_tx_min_packet[13:8];

        field {
            name = "crf_rx_min_packet";
            desc = "Minimum length of the RX packet. The default length is 42 bytes.";
            sw = rw;
            hw = r;
            reset = 0x2A;
        } crf_rx_min_packet[5:0];
    } CRF_MIN_PACKET @ 0x210;

    reg {
        name = "Control register";
        desc = "CONTROL_WORD is a control register.

Linux hix5hd2_gmac.c writes the plain maximum frame size (MAC_MAX_FRAME_SIZE = 1600) to the whole register at init. The reserved bits read 1 where shown by the data sheet total reset value; the set of such bits differs between the Hi3516A-class data sheets (bits 23:22) and the Hi3516 V100 (bits 30, 27, 26, 22).

Data sheet 5.7 CONTROL_WORD (offset 0x214, printed page 5-51, `Hi3516AV200-Datasheet.txt` line 32635).
Hi3516 V100 data sheet (Chinese original) 5.6 CONTROL_WORD (offset 0x214, printed page 5-47, `Hi3516-Datasheet.txt` line 30783).";

`ifdef HISI_GMAC_HI3516V100
        field {
            name = "reserved_nz";
            desc = "Reserved (RO); reads 1: the Hi3516 V100 data sheet total reset value is 0x4C40_0640 and its bit table shows bits 30, 27, 26 and 22 set (not read on hardware).";
            sw = r;
            hw = w;
            reset = 0x1;
        } reserved_nz[30:30];
`endif

`ifdef HISI_GMAC_HI3516V100
        field {
            name = "reserved_nz";
            desc = "Reserved (RO); reads 3 (see the bit 30 field; Hi3516 V100).";
            sw = r;
            hw = w;
            reset = 0x3;
        } reserved_nz_2[27:26];
`endif

        enum CONTROL_WORD_crf_tx_standard_enum {
            PACKET_AND_EMPTY_THRESHOLD = 0 { name = "Packet and empty threshold"; desc = "The standard is set based on the packet and empty threshold. If the TX FIFO contains a complete packet or the number of valid data items in the TX FIFO is equal to or greater than the threshold multiplied by 4, a read request is sent to the MAC."; };
            PACKET = 1 { name = "Packet"; desc = "The standard is set based on the packet. If the TX FIFO contains a complete packet, a read request is sent to the MAC."; };
        };

        field {
            name = "crf_tx_standard";
            desc = "Configuration standard for the transmit waterline of the TX FIFO";
            sw = rw;
            hw = r;
            encode = CONTROL_WORD_crf_tx_standard_enum;
            reset = 0x0;
        } crf_tx_standard[25:25];

`ifdef HISI_GMAC_HI3516V100
        field {
            name = "hrdy_sel";
            desc = "hrdy selection bit. 0: hreadym is selected (default); 1: hrdy is selected. (Hi3516 V100 data sheet, Chinese original; reserved on the later chips.)";
            sw = rw;
            hw = r;
            reset = 0x0;
        } hrdy_sel[24:24];
`endif

`ifndef HISI_GMAC_HI3516V100
        field {
            name = "reserved_nz";
            desc = "Reserved (RO); reads 3: the data sheet total reset value is 0x00C0_0640 (Hi3516A/AV200/Hi3519; the Hi3516 V100 has other bits set; not read on hardware).";
            sw = r;
            hw = w;
            reset = 0x3;
        } reserved_nz[23:22];
`endif

`ifdef HISI_GMAC_HI3516V100
        field {
            name = "reserved_nz";
            desc = "Reserved (RO); reads 1 (see the bit 30 field; Hi3516 V100).";
            sw = r;
            hw = w;
            reset = 0x1;
        } reserved_nz_3[22:22];
`endif

        enum CONTROL_WORD_crf_ip_flow_ctrl_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
