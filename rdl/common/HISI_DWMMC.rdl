        field { name = "cmd_lock_err"; desc = "Command conflict: 1 = command conflicts occurred. Write 1 to clear."; sw = rw; hw = w; onwrite = woclr; reset = 0x0; } cmd_lock_err[29:29];
        field { name = "ids_ownbit_err"; desc = "Integrated-descriptor own-bit error. Write 1 to clear."; sw = rw; hw = w; onwrite = woclr; reset = 0x0; } ids_ownbit_err[28:28];
