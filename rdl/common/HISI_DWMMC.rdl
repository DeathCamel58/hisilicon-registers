            SINGLE_INCR4_INCR8 = 1 { name = "Single Incr4 Incr8"; desc = "single, INCR4, INCR8, and INCR16 burst types"; };
        };

        field {
            name = "fb";
            desc = "Fixed burst length type";
            sw = rw;
            hw = r;
            encode = MMC_BMOD_fb_enum;
            reset = 0x0;
        } fb[1:1];

