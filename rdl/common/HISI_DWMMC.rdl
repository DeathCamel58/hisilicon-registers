            sw = rw;
            hw = w;
            onwrite = woclr;
            reset = 0x0;
        } du[4:4];

        field {
            name = "fbe";
            desc = "Fatal bus error interrupt. If this bit is set to 1, the IDMAC stops all accesses through the bus. Writing 1 clears this bit.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            reset = 0x0;
        } fbe[2:2];

        field {
            name = "ri";
            desc = "Receive done interrupt. This bit indicates that the data of a descriptor is received. Writing 1 clears this bit.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            reset = 0x0;
        } ri[1:1];

        field {
            name = "ti";
            desc = "Transmit done interrupt. This bit indicates that a descriptor finishes transmitting data. Writing 1 clears this bit.";
            sw = rw;
            hw = w;
            onwrite = woclr;
            reset = 0x0;
        } ti[0:0];
    } MMC_IDSTS @ 0x8C;

    reg {
        name = "IDMAC interrupt enable register";
        desc = "MMC_IDINTEN is an IDMAC interrupt enable register.

Data sheet 12.4.4 MMC_IDINTEN (offset 0x90, printed page 12-112, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 83520). Bits 29:21 (DWMMC_ADMA3) enable the ADMA3 interrupts of the Hi3516A V200 / Hi3519 V101 (data sheet 12.5, MMC_IDINTEN; bits 20:10 reserved RO there).";

`ifdef DWMMC_ADMA3
        field { name = "cmd_lock_err"; desc = "Command conflict interrupt enable"; sw = rw; hw = r; reset = 0x0; } cmd_lock_err[29:29];
        field { name = "ids_ownbit_err"; desc = "Own-bit error interrupt enable"; sw = rw; hw = r; reset = 0x0; } ids_ownbit_err[28:28];
        field { name = "ids_queue_overflow"; desc = "Queue overflow interrupt enable"; sw = rw; hw = r; reset = 0x0; } ids_queue_overflow[27:27];
        field { name = "resp_check_err"; desc = "Response error detection interrupt enable"; sw = rw; hw = r; reset = 0x0; } resp_check_err[26:26];
        field { name = "packet_int"; desc = "Multi-packet interrupt enable"; sw = rw; hw = r; reset = 0x0; } packet_int[25:25];
        field { name = "packet_timeout_int"; desc = "Timeout interrupt enable"; sw = rw; hw = r; reset = 0x0; } packet_timeout_int[24:24];
        field { name = "auto_stop_err"; desc = "Hardware stop error detection interrupt enable"; sw = rw; hw = r; reset = 0x0; } auto_stop_err[23:23];
        field { name = "ids_queue_full"; desc = "Queue full interrupt enable"; sw = rw; hw = r; reset = 0x0; } ids_queue_full[22:22];
        field { name = "ids_queue_empty"; desc = "Queue empty interrupt enable"; sw = rw; hw = r; reset = 0x0; } ids_queue_empty[21:21];
`endif

        enum MMC_IDINTEN_ai_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            FBE_DU_CES = 1 { name = "Fbe Du Ces"; desc = "The FBE, DU, and CES interrupts are enabled."; };
        };

        field {
            name = "ai";
            desc = "Abnormal interrupt enable";
            sw = rw;
            hw = r;
            encode = MMC_IDINTEN_ai_enum;
            reset = 0x0;
        } ai[9:9];

        enum MMC_IDINTEN_ni_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            TI_RI_INTERRUPTS = 1 { name = "Ti Ri Interrupts"; desc = "The TI and RI interrupts are enabled."; };
        };

        field {
            name = "ni";
            desc = "Normal interrupt enable";
            sw = rw;
            hw = r;
            encode = MMC_IDINTEN_ni_enum;
            reset = 0x0;
        } ni[8:8];

        enum MMC_IDINTEN_ces_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "ces";
            desc = "Card error interrupt enable";
            sw = rw;
            hw = r;
            encode = MMC_IDINTEN_ces_enum;
            reset = 0x0;
        } ces[5:5];

        enum MMC_IDINTEN_du_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "du";
            desc = "Descriptor invalid interrupt enable";
            sw = rw;
            hw = r;
            encode = MMC_IDINTEN_du_enum;
            reset = 0x0;
        } du[4:4];

        enum MMC_IDINTEN_fbe_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "fbe";
            desc = "Fatal bus error interrupt enable";
            sw = rw;
            hw = r;
            encode = MMC_IDINTEN_fbe_enum;
            reset = 0x0;
        } fbe[2:2];

        enum MMC_IDINTEN_ri_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "ri";
            desc = "RX interrupt enable";
            sw = rw;
            hw = r;
            encode = MMC_IDINTEN_ri_enum;
            reset = 0x0;
        } ri[1:1];

        enum MMC_IDINTEN_ti_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "ti";
            desc = "TX interrupt enable";
            sw = rw;
            hw = r;
            encode = MMC_IDINTEN_ti_enum;
            reset = 0x0;
        } ti[0:0];
    } MMC_IDINTEN @ 0x90;

    reg {
        name = "Address register of the current descriptor";
        desc = "MMC_DSCADDR is an address register of the current descriptor.

Data sheet 12.4.4 MMC_DSCADDR (offset 0x94, printed page 12-113, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 83574).";

        field {
            name = "had";
            desc = "Descriptor pointer. The value is automatically refreshed during data transfer. The register points to the start address of the descriptor that will be used by the IDMAC.";
            sw = r;
            hw = w;
            reset = 0x0;
        } had[31:0];
    } MMC_DSCADDR @ 0x94;

    reg {
        name = "Address register of the current data buffer";
        desc = "MMC_BUFADDR is an address register of the current data buffer.

Data sheet 12.4.4 MMC_BUFADDR (offset 0x98, printed page 12-113, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 83594).";

        field {
            name = "hba";
            desc = "Data buffer pointer. The value is automatically refreshed during data transfer. The register points to the start address of the data buffer that is being used by the IDMAC.";
            sw = r;
            hw = w;
            reset = 0x0;
        } hba[31:0];
    } MMC_BUFADDR @ 0x98;
`endif

`ifdef DWMMC_ADMA3
    reg {
        name = "ADMA3 control register";
        desc = "ADMA_CONTROL is the ADMA3 (command queue / integrated descriptor) control register of the Hi3516A V200 / Hi3519 V101 (data sheet 12.5, offset 0xB0, reset 0). The ADMA3 engine fetches integrated descriptors (command + data descriptor pairs) from the queue at ADMA_IDS_ADDR and issues the commands without CPU intervention.";
        field { name = "resp_check_en"; desc = "Response error detection enable"; sw = rw; hw = r; reset = 0x0; } resp_check_en[4:4];
        field { name = "soft_change_rdptr_en"; desc = "Software rewrite of the logic read pointer (ADMA_ID_RDPTR) enable"; sw = rw; hw = r; reset = 0x0; } soft_change_rdptr_en[3:3];
        field { name = "packet_int_en"; desc = "Multi-packet interrupt enable"; sw = rw; hw = r; reset = 0x0; } packet_int_en[2:2];
        field { name = "adma3_restart"; desc = "ADMA3 restart"; sw = rw; hw = r; reset = 0x0; } adma3_restart[1:1];
        field { name = "adma3_enable"; desc = "ADMA3 enable"; sw = rw; hw = r; reset = 0x0; } adma3_enable[0:0];
    } ADMA_CONTROL @ 0xB0;

    reg {
        name = "ADMA3 queue start address register";
        desc = "ADMA_IDS_ADDR: start address of the integrated descriptor queue (Hi3516A V200 / Hi3519 V101 data sheet 12.5, offset 0xB4).";
        field { name = "ids_start_addr"; desc = "Start address of the integrated descriptors"; sw = rw; hw = r; reset = 0x0; } ids_start_addr[31:0];
    } ADMA_IDS_ADDR @ 0xB4;

    reg {
        name = "ADMA3 queue depth register";
        desc = "ADMA_DEEPTH (data sheet spelling): depth of the integrated descriptor queue (offset 0xB8).";
        field { name = "ids_deepth"; desc = "Depth of the integrated descriptor queue"; sw = rw; hw = r; reset = 0x0; } ids_deepth[31:0];
    } ADMA_DEEPTH @ 0xB8;

    reg {
        name = "ADMA3 queue read pointer register";
        desc = "ADMA_ID_RDPTR: read pointer of the integrated descriptor queue (offset 0xBC); software may rewrite it when ADMA_CONTROL[soft_change_rdptr_en] is set.";
        field { name = "ids_rdptr"; desc = "Read pointer of the integrated descriptors"; sw = rw; hw = r; reset = 0x0; } ids_rdptr[31:0];
    } ADMA_ID_RDPTR @ 0xBC;

    reg {
        name = "ADMA3 queue write pointer register";
        desc = "ADMA_ID_WRPTR: write pointer of the integrated descriptor queue (offset 0xC0).";
        field { name = "ids_wrptr"; desc = "Write pointer of the integrated descriptors"; sw = rw; hw = r; reset = 0x0; } ids_wrptr[31:0];
    } ADMA_ID_WRPTR @ 0xC0;

    reg {
        name = "ADMA3 timeout configuration register";
        desc = "ADMA_TIMEOUT: timeout count for the multi-packet timeout interrupt MMC_IDSTS[packet_timeout_int] (offset 0xC4).";
        field { name = "timeout_count"; desc = "Timeout count for the multi-packet timeout interrupt"; sw = rw; hw = r; reset = 0x0; } timeout_count[31:0];
    } ADMA_TIMEOUT @ 0xC4;
`endif

`ifndef DWMMC_FIFO_0x100
    reg {
        name = "Threshold control register";
        desc = "MMC_CARDTHRCTL is a threshold control register.

Vendor driver value `RW_THRESHOLD_SIZE` = 0x02000005 (cardrdthreshold 0x200, cardrdthr_en and cardwrthr_en set; bit 1 BsyClrIntEn clear).

Data sheet 12.4.4 MMC_CARDTHRCTL (offset 0x100, printed page 12-114, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 83620).";

        field {
            name = "cardrdthreshold";
            desc = "Read threshold The maximum value is 512.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } cardrdthreshold[27:16];

        enum MMC_CARDTHRCTL_cardwrthr_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "cardwrthr_en";
            desc = "Write threshold enable";
            sw = rw;
            hw = r;
            encode = MMC_CARDTHRCTL_cardwrthr_en_enum;
            reset = 0x0;
        } cardwrthr_en[2:2];

        enum MMC_CARDTHRCTL_BsyClrIntEn_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "BsyClrIntEn";
            desc = "Busy clear interrupt enable";
            sw = rw;
            hw = r;
            encode = MMC_CARDTHRCTL_BsyClrIntEn_enum;
            reset = 0x0;
        } BsyClrIntEn[1:1];

        enum MMC_CARDTHRCTL_cardrdthr_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "cardrdthr_en";
            desc = "Read threshold enable";
            sw = rw;
            hw = r;
            encode = MMC_CARDTHRCTL_cardrdthr_en_enum;
            reset = 0x0;
        } cardrdthr_en[0:0];
    } MMC_CARDTHRCTL @ 0x100;

    reg {
        name = "UHS extension register";
        desc = "MMC_UHS_REG_EXT is a UHS extension register.

Vendor driver tuning: clk_drv_phase_ctrl (bits 25:23, `DRV_PHASE_MASK` 0x7 << 23) and clk_smpl_phase_ctrl (bits 18:16, `SMPL_PHASE_MASK` 0x7 << 16); the driver writes drive phase 2 (90 degrees) and sample phase 2 on Hi3518EV200 (sample phase 0 on Hi3516CV300 / Hi3519 / Hi3516AV200), then tunes the sample phase for HS200.

Hi3516A V200 / Hi3519 V101 (DWMMC_ADMA3): both fields are 4 bits wide, [26:23] and [19:16], in 22.5-degree steps (drive phase 0x4 = 90, 0x5 = 112.5, 0x6 = 135 degrees, other values reserved; sample phase 0x0 = 0 .. 0xF = 337.5 degrees). Hi3516A/D V100 and Hi3516C V300: 3-bit fields as here.

Data sheet 12.4.4 MMC_UHS_REG_EXT (offset 0x108, printed page 12-115, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 83665).";

        enum MMC_UHS_REG_EXT_clk_drv_phase_ctrl_enum {
            V_0 = 0 { name = "V 0"; desc = "0°"; };
            V_45 = 1 { name = "V 45"; desc = "45°"; };
            V_90 = 2 { name = "V 90"; desc = "90°"; };
            V_135 = 3 { name = "V 135"; desc = "135°"; };
            V_180 = 4 { name = "V 180"; desc = "180°"; };
            V_225 = 5 { name = "V 225"; desc = "225°"; };
            V_270 = 6 { name = "V 270"; desc = "270°"; };
            V_315 = 7 { name = "V 315"; desc = "315°"; };
        };

`ifdef DWMMC_ADMA3
        field {
            name = "clk_drv_phase_ctrl";
            desc = "clk_in_drv clock phase control: 0x4 = 90 degrees, 0x5 = 112.5 degrees, 0x6 = 135 degrees; other values reserved.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } clk_drv_phase_ctrl[26:23];
`else
        field {
            name = "clk_drv_phase_ctrl";
            desc = "clk_in_drv clock phase control";
            sw = rw;
            hw = r;
            encode = MMC_UHS_REG_EXT_clk_drv_phase_ctrl_enum;
            reset = 0x0;
        } clk_drv_phase_ctrl[25:23];
`endif

        enum MMC_UHS_REG_EXT_clk_smpl_phase_ctrl_enum {
            V_0 = 0 { name = "V 0"; desc = "0°"; };
            V_45 = 1 { name = "V 45"; desc = "45°"; };
            V_90 = 2 { name = "V 90"; desc = "90°"; };
            V_135 = 3 { name = "V 135"; desc = "135°"; };
            V_180 = 4 { name = "V 180"; desc = "180°"; };
            V_225 = 5 { name = "V 225"; desc = "225°"; };
            V_270 = 6 { name = "V 270"; desc = "270°"; };
            V_315 = 7 { name = "V 315"; desc = "315°"; };
        };

`ifdef DWMMC_ADMA3
        field {
            name = "clk_smpl_phase_ctrl";
            desc = "clk_in_sample clock phase control in 22.5-degree steps: 0x0 = 0, 0x1 = 22.5, 0x2 = 45, ... 0x8 = 180, ... 0xF = 337.5 degrees.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } clk_smpl_phase_ctrl[19:16];
`else
        field {
            name = "clk_smpl_phase_ctrl";
            desc = "clk_in_sample clock phase control";
            sw = rw;
            hw = r;
            encode = MMC_UHS_REG_EXT_clk_smpl_phase_ctrl_enum;
            reset = 0x0;
        } clk_smpl_phase_ctrl[18:16];
`endif
    } MMC_UHS_REG_EXT @ 0x108;

    reg {
        name = "EMMC 4.5 DDR start bit detection control register";
        desc = "MMC_DDR_REG is an eMMC 4.5 DDR start bit detection control register.

Data sheet 12.4.4 MMC_DDR_REG (offset 0x10C, printed page 12-116, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 83718).";

        enum MMC_DDR_REG_hs400_mode_enum {
            NON_HS400_MODE = 0 { name = "Non Hs400 Mode"; desc = "non-HS400 mode"; };
            HS400_MODE = 1 { name = "Hs400 Mode"; desc = "HS400 mode"; };
        };

        field {
            name = "hs400_mode";
            desc = "HS400 mode control";
            sw = rw;
            hw = r;
            encode = MMC_DDR_REG_hs400_mode_enum;
            reset = 0x0;
        } hs400_mode[31:31];

        field {
            name = "half_start_bit";
            desc = "For the eMMC4.5 component, when this bit is set to 1'b1, RINTSTS[15] is set to 1 when CMD12 is received in DDR mode.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } half_start_bit[1:1];
    } MMC_DDR_REG @ 0x10C;

    reg {
        name = "Phase shift register";
        desc = "MMC_ENABLE_SHIFT is a phase shift register.

Data sheet 12.4.4 MMC_ENABLE_SHIFT (offset 0x110, printed page 12-117, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 83757).";

        enum MMC_ENABLE_SHIFT_Register_1_enum {
            DEFAULT_PHASE_SHIFT = 0 { name = "Default Phase Shift"; desc = "default phase shift"; };
            PHASE_SHIFT_NEXT = 1 { name = "Phase Shift Next"; desc = "Phase shift on the next rising edge"; };
            PHASE_SHIFT_NEXT_2 = 2 { name = "Phase Shift Next 2"; desc = "Phase shift on the next falling edge"; };
            RESERVED = 3 { name = "Reserved"; desc = "Reserved"; };
        };

        field {
            name = "Register_1";
            desc = "eMMC phase shift control";
            sw = rw;
            hw = r;
            encode = MMC_ENABLE_SHIFT_Register_1_enum;
            reset = 0x0;
        } Register_1[3:2];

        enum MMC_ENABLE_SHIFT_Register_0_enum {
            DEFAULT_PHASE_SHIFT = 0 { name = "Default Phase Shift"; desc = "default phase shift"; };
            PHASE_SHIFT_NEXT = 1 { name = "Phase Shift Next"; desc = "Phase shift on the next rising edge"; };
            PHASE_SHIFT_NEXT_2 = 2 { name = "Phase Shift Next 2"; desc = "Phase shift on the next falling edge"; };
            RESERVED = 3 { name = "Reserved"; desc = "Reserved"; };
        };

        field {
            name = "Register_0";
            desc = "SDIO phase shift control";
            sw = rw;
            hw = r;
            encode = MMC_ENABLE_SHIFT_Register_0_enum;
            reset = 0x0;
        } Register_0[1:0];
    } MMC_ENABLE_SHIFT @ 0x110;
`endif

    reg {
        name = "Data register (entrance address of the FIFO)";
        desc = "MMC_DATA is a data register (entrance address of the FIFO). The FIFO overflow must be read first before the data is read from or written to the FIFO.

FIFO window: the whole range 0x200 .. 0x200 + FIFO depth (256 words) addresses the FIFO (vendor `MCI_FIFO_START` 0x200 for HIMCI_V200). On the Hi3511/Hi3515/Hi3520 V100, Hi3516C/Hi3518 V100 and Hi3516 V100 generations (DWMMC_FIFO_0x100) the FIFO window starts at 0x100 instead (vendor `MCI_FIFO_START` 0x100; the Hi3515 data sheet names the field fifo_entrance).

Data sheet 12.4.4 MMC_DATA (offset 0x200, printed page 12-118, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 83808).";

        field {
            name = "data";
            desc = "Address for reading/writing to the FIFO. If the address ranges from 0x200 to 0x200 + FIFO_DEPTH, the FIFO is selected.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } data[31:0];
`ifdef DWMMC_FIFO_0x100
    } MMC_DATA @ 0x100;
`else
    } MMC_DATA @ 0x200;
`endif

