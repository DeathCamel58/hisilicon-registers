`ifndef HISI_DWMMC_RDL
`define HISI_DWMMC_RDL


regfile eHISI_DWMMC {
    name = "HiSilicon MMC/SD/SDIO controller (DesignWare-MMC based, himciv200)";
    desc = "
    HiSilicon MMC/SD/SDIO host controller \"himciv200\", a Synopsys DesignWare Mobile Storage Host (dw_mmc) core with HiSilicon additions (PHASE/tuning register MMC_UHS_REG_EXT, MMC_ENABLE_SHIFT, MMC_DDR_REG (HS400), card threshold control, 256-word FIFO at 0x200). Two instances: MMC0 / SDIO0 at 0x10020000 (SD 3.0, SDIO 3.0, eMMC 5.0 with 8-bit bus; GIC/VIC interrupt 18) and MMC1 / SDIO1 at 0x10030000 (SD 2.0 and SDIO 2.0 only, 4-bit bus; interrupt 8, shared with GZIP). Data moves through the built-in IDMAC (descriptor list, MMC_DBADDR) or the CPU through the FIFO window.
    Registers are from the Hi3518E V20X/Hi3516C V200 data sheet issue 02 (2017-06-12), section 12.4.4 (`datasheet` text lines 82110-84358). The DS describes eMMC/SDIO bit pairs in several registers (copied from a two-slot variant of the IP); on this SoC each controller drives a single slot and the vendor driver (and the Linux dw_mmc based `himci` driver) only uses bit 0 / bits 7:0 / bit 16 for the 8-bit mode. The vendor U-Boot register header (include/himciv200_reg.h) additionally names MMC_GPIO (0x58), MMC_USRID (0x68), MMC_VERID (0x6C) and MMC_HCON (0x70); they are modelled as vendor-only registers.
    Clock and reset (PERI_CRG49, 0x20030000 + 0xC4): MMC0 srst bit 8, clock enable bit 9, clock select bits 11:10 (0 = 99 MHz, 1 = 74.25 MHz, 2 = 49.5 MHz, 3 = 148.5 MHz); MMC1 srst bit 0, clock enable bit 1, clock select bits 3:2 (the vendor driver programs 0 = 49.5 MHz for MMC1; compare the MMC0 encoding, where 2 = 49.5 MHz). The card clock is CCLK_IN / (2 x MMC_CLKDIV).
    Not hardware verified.
";

    reg {
        name = "MMC control register";
        desc = "MMC_CTRL is a MMC control register.

Vendor driver (himciv200.c): sets `USE_INTERNAL_DMA` (bit 25), `INTR_EN` (bit 4) and resets controller/FIFO/DMA with `CTRL_RESET | FIFO_RESET | DMA_RESET` (bits 0-2) during init; the DS marks bit 25 as use_internal_dmac. The reset bits clear themselves.

Data sheet 12.4.4 MMC_CTRL (offset 0x0, printed page 12-88, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 82115).";

        enum MMC_CTRL_Use_internal_dmac_enum {
            CPU_TRANSFERS_DATA = 0 { name = "Cpu Transfers Data"; desc = "The CPU transfers data by using the slave interface."; };
            CPU_TRANSFERS_DATA_2 = 1 { name = "Cpu Transfers Data 2"; desc = "The CPU transfers data by using the IDMAC."; };
        };

        field {
            name = "Use_internal_dmac";
            desc = "Whether to transfer data by using the IDMAC";
            sw = rw;
            hw = r;
            encode = MMC_CTRL_Use_internal_dmac_enum;
            reset = 0x0;
        } Use_internal_dmac[25:25];

        enum MMC_CTRL_Abort_read_data_enum {
            INVALID = 0 { name = "Invalid"; desc = "invalid"; };
            AFTER_TRANSMITTING_SUSPEND = 1 { name = "After Transmitting Suspend"; desc = "After transmitting a suspend command during data read, the software polls the card to check when suspend occurs. After the suspend occurs, the software sets the bit to 1. This enables the data transfer state machine to be restored to idle state for the next block transfer. After the state machine restores to the idle status, this bit is cleared automatically."; };
        };

        field {
            name = "Abort_read_data";
            desc = "Whether to abort the data transfer during data read";
            sw = rw;
            hw = r;
            encode = MMC_CTRL_Abort_read_data_enum;
            reset = 0x0;
        } Abort_read_data[8:8];

        enum MMC_CTRL_Send_irq_response_enum {
            INVALID = 0 { name = "Invalid"; desc = "invalid"; };
            INTERRUPT_REQUEST_RESPONSE = 1 { name = "Interrupt Request Response"; desc = "An interrupt request (IRQ) response is transmitted automatically. After the response is transmitted, this bit is cleared automatically. To wait for the interrupt generated by the MMC controller, the host transmits the CMD40 command and waits for the interrupt response from the MMC controller. If you do not want the host to keep in the interrupt wait state, set this bit to 1 and transmit the CMD40 command to restore the host to the idle state."; };
        };

        field {
            name = "Send_irq_response";
            desc = "TX interrupt response control";
            sw = rw;
            hw = w;
            encode = MMC_CTRL_Send_irq_response_enum;
            reset = 0x0;
        } Send_irq_response[7:7];

        enum MMC_CTRL_Read_wait_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED_THIS_BIT = 1 { name = "Enabled This Bit"; desc = "enabled This bit is valid only for the SDIO card that supports the read wait function."; };
        };

        field {
            name = "Read_wait";
            desc = "Read wait control";
            sw = rw;
            hw = r;
            encode = MMC_CTRL_Read_wait_enum;
            reset = 0x0;
        } Read_wait[6:6];

        enum MMC_CTRL_Int_enable_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED_INTERRUPT_OUTPUT = 1 { name = "Enabled Interrupt Output"; desc = "enabled The interrupt output is valid only when this bit is valid and the interrupt source is enabled."; };
        };

        field {
            name = "Int_enable";
            desc = "Global interrupt enable";
            sw = rw;
            hw = r;
            encode = MMC_CTRL_Int_enable_enum;
            reset = 0x0;
        } Int_enable[4:4];

        enum MMC_CTRL_Dma_reset_enum {
            INVALID = 0 { name = "Invalid"; desc = "invalid"; };
            RESET_INTERNAL_DMA = 1 { name = "Reset Internal Dma"; desc = "reset the internal DMA interface This bit is automatically reset after two AHB clock cycles."; };
        };

        field {
            name = "Dma_reset";
            desc = "Soft reset control for the IDMAC";
            sw = rw;
            hw = w;
            encode = MMC_CTRL_Dma_reset_enum;
            reset = 0x0;
        } Dma_reset[2:2];

        enum MMC_CTRL_Fifo_reset_enum {
            INVALID = 0 { name = "Invalid"; desc = "invalid"; };
            RESET_FIFO_POINTER = 1 { name = "Reset Fifo Pointer"; desc = "reset the FIFO pointer This bit is reset automatically after the reset operation is complete."; };
        };

        field {
            name = "Fifo_reset";
            desc = "Soft reset control for the internal FIFO";
            sw = rw;
            hw = w;
            encode = MMC_CTRL_Fifo_reset_enum;
            reset = 0x0;
        } Fifo_reset[1:1];

        enum MMC_CTRL_Controller_reset_enum {
            INVALID = 0 { name = "Invalid"; desc = "invalid"; };
            RESET_MMC_SD = 1 { name = "Reset Mmc Sd"; desc = "reset the MMC/SD/SDIO host module"; };
        };

        field {
            name = "Controller_reset";
            desc = "Soft reset control for the controller";
            sw = rw;
            hw = w;
            encode = MMC_CTRL_Controller_reset_enum;
            reset = 0x0;
        } Controller_reset[0:0];
    } MMC_CTRL @ 0x0;

    reg {
        name = "Power_en control register";
        desc = "MMC_PWREN is a Power_en control register.

Bit 0 drives the card-power output of this controller (SDIOn_CARD_POWER_EN). The DS describes a two-bit eMMC/SDIO pair; on this SoC each controller (MMC0 at 0x10020000, MMC1 at 0x10030000) is a separate instance and only bit 0 is meaningful to the vendor driver.

Data sheet 12.4.4 MMC_PWREN (offset 0x4, printed page 12-90, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 82211).";

        enum MMC_PWREN_Power_enable_enum {
            POWER_OFF = 0 { name = "Power Off"; desc = "power off"; };
            POWER_THIS_VALUE = 1 { name = "Power This Value"; desc = "power on This value is used to drive the SDIOn_CARD_POWER_EN (n = 0 or 1) pin."; };
        };

        field {
            name = "Power_enable";
            desc = "Power control Bit 1 and bit 0 control the eMMC power and SDIO power respectively. The following takes bit 0 as an example:";
            sw = rw;
            hw = r;
            encode = MMC_PWREN_Power_enable_enum;
            reset = 0x0;
        } Power_enable[1:0];
    } MMC_PWREN @ 0x4;

    reg {
        name = "Clock divider register";
        desc = "Clock divider register.

Interface clock = CCLK_IN / (2 x clk_divider) (DS 12.4.2); CCLK_IN is selected in PERI_CRG49 (MMC0 bits 11:10, MMC1 bits 3:2) and the maximum interface clock is 100 MHz. The vendor driver programs clk_divider0 for card 0. After a change, update the clock registers with MMC_CMD[update_clock_registers_only] as in DS 12.4.2.

Data sheet 12.4.4 MMC_CLKDIV (offset 0x8, printed page 12-91, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 82258).";

        field {
            name = "clk_divider1";
            desc = "eMMC clock divider. The clock divider is 2 x n. If the value of n is 0, it indicates no frequency division; if the value of n is 1, the frequency is divided by 2; if the value of is 0xFF, the frequency is divided by 510.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } clk_divider1[15:8];

        field {
            name = "clk_divider0";
            desc = "SDIO clock divider. The clock divider is 2 x n. If the value of n is 0, it indicates no frequency division; if the value of n is 1, the frequency is divided by 2; if the value of n is 0xFF, the frequency is divided by 510.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } clk_divider0[7:0];
    } MMC_CLKDIV @ 0x8;

    reg {
        name = "Clock source select register of the SD card";
        desc = "MMC_CLKSRC is a clock source select register of the SD card.

Must stay 0 on this SoC in practice; the DS text for clk_source says \"must be set to 4\" for the bit pair of two cards but the vendor driver never writes this register. (DS wording kept verbatim in the field description.)

Data sheet 12.4.4 MMC_CLKSRC (offset 0xC, printed page 12-91, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 82286).";

        field {
            name = "clk_source";
            desc = "This bit must be set to 4.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } clk_source[3:0];
    } MMC_CLKSRC @ 0xC;

    reg {
        name = "Clock enable register";
        desc = "MMC_CLKENA is a clock enable register.

Data sheet 12.4.4 MMC_CLKENA (offset 0x10, printed page 12-92, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 82320).";

        enum MMC_CLKENA_cclk_low_power_enum {
            NON_LOWER_POWER = 0 { name = "Non Lower Power"; desc = "non lower-power mode"; };
            LOW_POWER_MODE = 1 { name = "Low Power Mode"; desc = "low-power mode When the card is idle, the card clock is disabled. This function is used only for the MMC and SD card, because the card clock of the SDIO card must be retained for detecting interrupts."; };
        };

        field {
            name = "cclk_low_power";
            desc = "Card low-power control for disabling the card clock Bit 17 and bit 16 indicate the low-power control for eMMC and SDIO respectively. The following takes bit 16 as an example:";
            sw = rw;
            hw = r;
            encode = MMC_CLKENA_cclk_low_power_enum;
            reset = 0x0;
        } cclk_low_power[17:16];

        enum MMC_CLKENA_cclk_enable_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "cclk_enable";
            desc = "Card clock enable Bit 1 and bit 0 indicate the clock enable for eMMC and SDIO respectively. The following takes bit 0 as an example:";
            sw = rw;
            hw = r;
            encode = MMC_CLKENA_cclk_enable_enum;
            reset = 0x0;
        } cclk_enable[1:0];
    } MMC_CLKENA @ 0x10;

    reg {
        name = "Timeout register";
        desc = "MMC_TMOUT is a timeout register.

Data sheet 12.4.4 MMC_TMOUT (offset 0x14, printed page 12-92, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 82362).";

        field {
            name = "data_timeout";
            desc = "Timeout during the data transfer of the card, in unit of the mmc_clk cycle of the card. The timeout is also the data starvation timeout of the CPU";
            sw = rw;
            hw = r;
            reset = 0x00FFFFFF;
        } data_timeout[31:8];

        field {
            name = "response_timeout";
            desc = "Response timeout, in unit of the mmc_clk cycle of the card.";
            sw = rw;
            hw = r;
            reset = 0x40;
        } response_timeout[7:0];
    } MMC_TMOUT @ 0x14;

    reg {
        name = "Card type register";
        desc = "MMC_CTYPE is a card type register.

DS inconsistency: the field names are swapped against their bit positions (`card_width_0` is bits 17:16 and `card_width_1` is bits 1:0). Vendor header: `CARD_WIDTH_4BIT` = bit 0, `CARD_WIDTH_8BIT` = bit 16 (`CARD_WIDTH_MASK` = 0x10001); the DS text for bits 17:16 says the field must be 0 (non-8-bit mode), which contradicts the 8-bit mode the MMC0 (eMMC) controller supports and the vendor driver uses (`bus-width = <8>` in the device tree). MMC1 has no 8-bit mode.

Data sheet 12.4.4 MMC_CTYPE (offset 0x18, printed page 12-93, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 82393).";

        field {
            name = "card_width_0";
            desc = "Bus width of the card Bit 17 and bit 16 indicate the eMMC bus width and SDIO bus width respectively. The following takes bit 16 as an example: This field must be set to 0 (non 8-bit mode). The bus width of the card is set to 1-bit mode or 4-bit mode, which depends on the value of bit[0].";
            sw = rw;
            hw = r;
            reset = 0x0;
        } card_width_0[17:16];

        enum MMC_CTYPE_card_width_1_enum {
            V_1_BIT_MODE = 0 { name = "V 1 Bit Mode"; desc = "1-bit mode"; };
            V_4_BIT_MODE = 1 { name = "V 4 Bit Mode"; desc = "4-bit mode"; };
        };

        field {
            name = "card_width_1";
            desc = "Bus width of the card Bit 1 and bit 0 indicate the eMMC bus width and SDIO bus width respectively. The following takes bit 0 as an example:";
            sw = rw;
            hw = r;
            encode = MMC_CTYPE_card_width_1_enum;
            reset = 0x0;
        } card_width_1[1:0];
    } MMC_CTYPE @ 0x18;

    reg {
        name = "Block size configuration register";
        desc = "MMC_BLKSIZ is a block size configuration register.

Data sheet 12.4.4 MMC_BLKSIZ (offset 0x1C, printed page 12-93, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 82431).";

        field {
            name = "block_size";
            desc = "Block size. The initial size of each block is 512 bytes.";
            sw = rw;
            hw = r;
            reset = 0x200;
        } block_size[15:0];
    } MMC_BLKSIZ @ 0x1C;

    reg {
        name = "Block transfer count register";
        desc = "MMC_BYTCNT is a block transfer count register.

Data sheet 12.4.4 MMC_BYTCNT (offset 0x20, printed page 12-94, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 82460).";

        field {
            name = "Byte_count";
            desc = "Number of transferred bytes. The number must be an integral multiple of the block size. If the data transfer is not block transfer, this register must be set to 0. In this case, the software needs to transmit a stop or an abort command to control the data transfer.";
            sw = rw;
            hw = r;
            reset = 0x200;
        } Byte_count[31:0];
    } MMC_BYTCNT @ 0x20;

    reg {
        name = "Interrupt mask register";
        desc = "MMC_INTMASK is an interrupt mask register.

Interrupt bit meanings (same in MMC_MINTSTS/MMC_RINTSTS): bit 0 card detect, bit 1 response error (RE), 2 command done (CD), 3 data transfer over (DTO), 4 TX FIFO data request (TXDR), 5 RX FIFO data request (RXDR), 6 response CRC error (RCRC), 7 data CRC error (DCRC), 8 response timeout (RTO), 9 data read timeout (DRTO; also boot data start, vendor `BDS_INT_STATUS`), 10 data starvation by host timeout (HTO), 11 FIFO underrun/overrun (FRUN), 12 hardware locked write error (HLE), 13 start-bit error (SBE), 14 auto command done (ACD), 15 end-bit error (EBE); bits 17:16 are the SDIO card interrupt. The vendor header `ALL_INT_MASK` = 0x1FFFE and `ALL_INT_CLR` = 0x1AFFE.

Data sheet 12.4.4 MMC_INTMASK (offset 0x24, printed page 12-94, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 82483).";

        enum MMC_INTMASK_sdio_int_mask_enum {
            MASKED = 0 { name = "Masked"; desc = "masked"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "sdio_int_mask";
            desc = "Interrupt mask control Bit 17 and bit 16 indicate the interrupt mask control for eMMC and SDIO respectively. The following takes bit 16 as an example:";
            sw = rw;
            hw = r;
            encode = MMC_INTMASK_sdio_int_mask_enum;
            reset = 0x0;
        } sdio_int_mask[17:16];

        enum MMC_INTMASK_int_mask_enum {
            MASKED = 0x0 { name = "Masked"; desc = "masked"; };
            ENABLED_BIT_15 = 0x1 { name = "Enabled Bit 15"; desc = "enabled Bit[15]: end-bit error (read)/write no CRC (EBE) Bit[14]: auto command done (ACD) Bit[13]: start-bit error (SBE) Bit[12]: hardware locked write error (HLE) Bit[11]: FIFO underrun/overrun error (FRUN) Bit[10]: data starvation-by-host timeout (HTO) Bit[9]: data read timeout (DTO) Bit[8]: response timeout (RTO) Bit[7]: data CRC error (DCRC) Bit[6]: response CRC error (RCRC) Bit[5]: RX FIFO data request (RXDR) Bit[4]: TX FIFO data request (TXDR) Bit[3]: data transfer over (DTO) Bit[2]: command done (CD) Bit[1]: response error (RE) Bit[0]: card detect (CD)"; };
        };

        field {
            name = "int_mask";
            desc = "Interrupt mask";
            sw = rw;
            hw = r;
            encode = MMC_INTMASK_int_mask_enum;
            reset = 0x0;
        } int_mask[15:0];
    } MMC_INTMASK @ 0x24;

    reg {
        name = "Command parameter register";
        desc = "MMC_CMDARG is a command parameter register.

Data sheet 12.4.4 MMC_CMDARG (offset 0x28, printed page 12-95, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 82543).";

        field {
            name = "cmd_arg";
            desc = "Command parameter that is transferred to the card. The command parameter is related to the protocol, and each command corresponds to a command parameter.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } cmd_arg[31:0];
    } MMC_CMDARG @ 0x28;

    reg {
        name = "Command register";
        desc = "MMC_CMD is a command register.

Vendor flags (`MCI_CMD_MASK` 0x803FFFFF): START_CMD bit 31, USE_HOLD_REG bit 29 (set in every command by the vendor driver; reset value 1 per the DS Total Reset Value, the bit diagram of the DS shows 0 for it), UP_CLK_ONLY bit 21, CARD_NUM bit 16 (card number field is [20:16]), SEND_INIT, WT_PD_CPT, SEND_AUTO_STOP, DATA_EXPECT, CHECK_RESP_CRC, RESP_LENGTH, RESP_EXPECT bits as in the table.

Data sheet 12.4.4 MMC_CMD (offset 0x2C, printed page 12-96, `Hi3518EV20X-Hi3516CV200-Datasheet.txt` line 82569).";

        enum MMC_CMD_start_cmd_enum {
            DO_NOT_START = 0 { name = "Do Not Start"; desc = "do not start"; };
            START_COMMAND_AFTER = 1 { name = "Start Command After"; desc = "start a command After the command is transferred to the card interface unit (CIU), this bit is cleared. The CPU does not allow modifications to this register. Otherwise, an HLE interrupt is generated. After transmitting a command, the CPU queries this bit, and transmits the next command when the value of this bit changes to 0."; };
        };

        field {
            name = "start_cmd";
            desc = "Start control";
            sw = rw;
            hw = w;
            encode = MMC_CMD_start_cmd_enum;
            reset = 0x0;
        } start_cmd[31:31];

        enum MMC_CMD_use_hold_reg_enum {
            CMD_DATA_SIGNALS = 0 { name = "Cmd Data Signals"; desc = "The CMD and DATA signals transmitted to the MMC do not pass through the hold register."; };
            CMD_DATA_SIGNALS_2 = 1 { name = "Cmd Data Signals 2"; desc = "The CMD and DATA signals transmitted to the MMC pass through the hold register."; };
        };

        field {
            name = "use_hold_reg";
            desc = "Whether to use the hold register";
            sw = rw;
            hw = r;
            encode = MMC_CMD_use_hold_reg_enum;
            reset = 0x1;
        } use_hold_reg[29:29];

        enum MMC_CMD_volt_switch_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "volt_switch";
            desc = "Voltage switching enable";
            sw = rw;
            hw = r;
            encode = MMC_CMD_volt_switch_enum;
            reset = 0x0;
        } volt_switch[28:28];

        enum MMC_CMD_boot_mode_enum {
            BOOT_MODE = 0 { name = "Boot Mode"; desc = "boot mode"; };
            ALTERNATIVE_BOOT_MODE = 1 { name = "Alternative Boot Mode"; desc = "alternative boot mode"; };
        };

        field {
            name = "boot_mode";
            desc = "Boot mode";
            sw = rw;
            hw = r;
            encode = MMC_CMD_boot_mode_enum;
            reset = 0x0;
        } boot_mode[27:27];

        field {
            name = "disable_boot";
            desc = "Boot disable If the software enables this bit and the Start_cmd bit at the same time, the controller aborts the boot operation. The Enable_boot and Disable_boot bits cannot be enabled at the same time.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } disable_boot[26:26];

        field {
            name = "expect_boot_ack";
            desc = "Boot response enable If the software enables this bit and the Enable_boot bit at the same time, the controller detects the boot response signal in \"0-1-0\" sequence.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } expect_boot_ack[25:25];

        field {
            name = "enable_boot";
            desc = "Boot enable This bit is available when the boot mode is mandatory. If the software enables this bit and the Start_cmd bit, the controller pulls down the CMD signal to start the boot process. The Enable_boot and Disable_boot bits cannot be enabled at the same time.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } enable_boot[24:24];

        enum MMC_CMD_update_clock_registers_only_enum {
            NORMAL_COMMAND_SEQUENCE = 0 { name = "Normal Command Sequence"; desc = "The normal command sequence is used. That is, the values of MMC_CMD, MMC_CMDARG, MMC_TMOUT, MMC_CTYPE, MMC_BLKSIZ, and MMC_BYTCNT are transferred from the BIU to the CIU. The CIU uses the new values of registers when running new commands."; };
            NO_COMMAND_TRANSMITTED = 1 { name = "No Command Transmitted"; desc = "No command is transmitted, and only the clock register values in the card clock domain are updated. The values of MMC_CLKDIV, MMC_CLKSRC, and MMC_CLKENA are transferred to the card clock domain. The card clock can be changed (frequency change and clock enable) even no command is transmitted. Each time the card clock is changed; this bit must be set to 1. In this case, no command is transmitted to the card, and no command done interrupt is generated."; };
        };

        field {
            name = "update_clock_registers_only";
            desc = "Automatic update";
            sw = rw;
            hw = r;
            encode = MMC_CMD_update_clock_registers_only_enum;
            reset = 0x0;
        } update_clock_registers_only[21:21];

        field {
            name = "card_number";
            desc = "Serial number of the card that is being used";
            sw = rw;
            hw = r;
            reset = 0x0;
        } card_number[20:16];

        enum MMC_CMD_send_initialization_enum {
            DO_NOT_TRANSMIT = 0 { name = "Do Not Transmit"; desc = "do not transmit the initialization sequence before transmitting the Send_initialization command (high level in 80 clock cycles)"; };
            TRANSMIT_INITIALIZATION_SEQUEN = 1 { name = "Transmit Initialization Sequen"; desc = "transmit the initialization sequence before transmitting the Send_initialization command When a card is powered on, the initialization sequence must be transmitted for initialization before any command is transmitted. That is, this bit must be set to 1."; };
        };

        field {
            name = "send_initialization";
            desc = "Whether to transmit the initialization sequence";
            sw = rw;
            hw = r;
            encode = MMC_CMD_send_initialization_enum;
            reset = 0x0;
        } send_initialization[15:15];

        enum MMC_CMD_stop_abort_cmd_enum {
            DO_NOT_TRANSMIT = 0 { name = "Do Not Transmit"; desc = "do not transmit the stop/abort command"; };
            TRANSMIT_STOP_ABORT = 1 { name = "Transmit Stop Abort"; desc = "transmit the stop/abort command for stopping the current data transfer"; };
        };

        field {
            name = "stop_abort_cmd";
            desc = "Whether to transmit the stop/abort command when data is being transferred in open-ended mode or in fixed length mode.";
            sw = rw;
            hw = r;
            encode = MMC_CMD_stop_abort_cmd_enum;
            reset = 0x0;
        } stop_abort_cmd[14:14];

        enum MMC_CMD_wait_prvdata_complete_enum {
