        desc = "RTC_CLK is the RTC output clock select register.

Data sheet 3.8.7 RTC_CLK (internal address 0x17, printed page 3-168, `datasheet.txt` line 16681).";
        regwidth = 8;

        enum RTC_CLK_clk_out_sel_enum {
            OUTPUT_CRYSTAL_OSCILLATOR = 0 { name = "Output Crystal Oscillator"; desc = "output crystal oscillator clock"; };
            OUTPUT_CORRECTED_100 = 1 { name = "Output Corrected 100"; desc = "output corrected 100 Hz clock 1X: output 1 Hz clock"; };
        };

        field {
            name = "clk_out_sel";
            desc = "Output test clock of the RTC.";
            sw = rw;
            hw = r;
            encode = RTC_CLK_clk_out_sel_enum;
            reset = 0x0;
        } clk_out_sel[1:0];
    } RTC_CLK @ 0x17;

    reg {
        name = "RTC reset control register";
        desc = "RTC_POR_N is the RTC reset control register.

Data sheet 3.8.7 RTC_POR_N (internal address 0x18, printed page 3-169, `datasheet.txt` line 16723).";
        regwidth = 8;

        field {
            name = "rtc_por_n";
