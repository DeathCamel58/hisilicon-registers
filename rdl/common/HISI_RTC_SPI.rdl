        desc = "RTC_SAR_CTRL is the RTC internal t_sensor control register.

Data sheet 3.8.7 RTC_SAR_CTRL (internal address 0x1A, printed page 3-169, `datasheet.txt` line 16751).";
        regwidth = 8;

        enum RTC_SAR_CTRL_sample_time_enum {
            V_1_MINUTE = 0 { name = "V 1 Minute"; desc = "1 minute"; };
            V_4_MINUTES = 1 { name = "V 4 Minutes"; desc = "4 minutes"; };
