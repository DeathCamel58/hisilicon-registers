    reg {
        name = "Lower-8-bit corrected tot_offset register when the correction algorithm is used";
        desc = "TOT_OFFSET_L is the lower-8-bit corrected tot_offset register when the correction algorithm is used.

Data sheet 3.8.7 TOT_OFFSET_L (internal address 0x1C, printed page 3-170, `datasheet.txt` line 16789).";
        regwidth = 8;

        field {
            name = "tot_offset_l";
            desc = "Corrected tot_offset by using the correction algorithm. The value is expressed by complement codes -256 to +255. That is, tot_offset is 1990 + (-256 to +255) in the correction algorithm. This field value is the lower seven bits of tot_offset.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } tot_offset_l[7:0];
    } TOT_OFFSET_L @ 0x1C;

    reg {
        name = "Upper-1-bit corrected tot_offset register when the correction algorithm is used";
        desc = "TOT_OFFSET_H is the upper-1-bit corrected tot_offset register when the correction algorithm is used.

Data sheet 3.8.7 TOT_OFFSET_H (internal address 0x1D, printed page 3-170, `datasheet.txt` line 16813).";
        regwidth = 8;

        field {
            name = "tot_offset_h";
            desc = "Corrected tot_offset by using the correction algorithm. The value is expressed by complement codes -256 to +255. That is, tot_offset is 1990 + (-256 to +255) in the correction algorithm. This field value is the upper one bit of tot_offset.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } tot_offset_h[0:0];
    } TOT_OFFSET_H @ 0x1D;

    reg {
        name = "Temperature code word offset register corresponding to the correction input LUT";
        desc = "TEMP_OFFSET is the temperature code word offset register corresponding to the correction input LUT.

Data sheet 3.8.7 TEMP_OFFSET (internal address 0x1E, printed page 3-171, `datasheet.txt` line 16852).";
        regwidth = 8;

        field {
            name = "temp_offset";
            desc = "Offset of the temperature code words that are input to the correction LUT. The value is expressed by the complement code and the value ranges from -32 to +31.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } temp_offset[5:0];
    } TEMP_OFFSET @ 0x1E;

    reg {
        name = "External ambient temperature register";
        desc = "OUTSIDE_TEMP is the external ambient temperature register.

Data sheet 3.8.7 OUTSIDE_TEMP (internal address 0x1F, printed page 3-171, `datasheet.txt` line 16881).";
        regwidth = 8;

        field {
            name = "outside_temp";
            desc = "Ambient temperature. The code word indicates -40°C to +140°C.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } outside_temp[7:0];
    } OUTSIDE_TEMP @ 0x1F;

    reg {
        name = "RTC internal t_sensor temperature register";
        desc = "DIE_TEMP is the RTC internal t_sensor temperature register.

Data sheet 3.8.7 DIE_TEMP (internal address 0x20, printed page 3-172, `datasheet.txt` line 16912).";
        regwidth = 8;

        field {
            name = "die_temp";
            desc = "Internal chip temperature provided by the t_sensor in the RTC. The code word indicates -40°C to +140°C.";
            sw = r;
            hw = w;
            reset = 0x0;
        } die_temp[7:0];
    } DIE_TEMP @ 0x20;

    reg {
        name = "Correction algorithm input temperature source select register";
        desc = "TEMP_SEL is the correction algorithm input temperature source select register.

Data sheet 3.8.7 TEMP_SEL (internal address 0x21, printed page 3-172, `datasheet.txt` line 16932).";
        regwidth = 8;

        field {
            name = "sdm_sel";
            desc = "Whether to perform temperature compensation. This field works with fix_model and temp_sel. When the chip is powered on or off: {temp_sel, fix_mode, temp_sel} 0xx: temperature compensation enabled. The mode depends on {fix_mode, temp_sel}. 110: temperature compensation disabled. The RTC clock is the one obtained after decimal frequency division. For details about the frequency dividers, see the sdm_coef_ouside_h and sdm_coef_ouside_l registers. Other values: reserved";
            sw = rw;
            hw = r;
            reset = 0x0;
        } sdm_sel[2:2];

        field {
            name = "fix_mode";
            desc = "Correction algorithm input temperature source select. This field works with temp_sel. For details, see descriptions of the temp_sel field.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } fix_mode[1:1];

        field {
            name = "temp_sel";
            desc = "Correction algorithm input temperature source select. This field parameter works with fix_mode. When the chip is powered on, the value meanings for {fix_mode, temp_sel} are as follows: 00: The correction circuit temperature is read from the DIE_TEMP register. 01: The correction circuit temperature is read from the OUTSIDE_TEMP register. 1X: The correction circuit temperature is read from the OUTSIDE_TEMP register. When the chip is powered off, the value meanings for {fix_mode, temp_sel} are as follows: 0X: The correction circuit temperature is read from the DIE_TEMP register. 1X: The correction circuit temperature is read from the OUTSIDE_TEMP register.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } temp_sel[0:0];
    } TEMP_SEL @ 0x21;

