// Top-level wrapper so that the internal address space can be elaborated and exported on its own. It is NOT instantiated in any SoC:
// the registers have no CPU address (see eHISI_RTC_SPI).
addrmap aHISI_RTC_SPI_INTERNAL {
    name = "HiSilicon SPI-bridged RTC internal address space";
    desc = "Internal 8-bit register space of the RTC, reached only through SPI_RW (see eHISI_RTC_SPI). Offsets are the SPI internal addresses.";
    eHISI_RTC_SPI_INTERNAL INTERNAL @ 0x0;
};

