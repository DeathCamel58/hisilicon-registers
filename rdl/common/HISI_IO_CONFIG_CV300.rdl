        enum muxctrl_reg0_func_enum {

            GPIO = 0 { name = "GPIO"; desc = "GPIO function (dts gpio-range: pin 0)"; };

        };

        field {
            name = "func";
            desc = "Function select (3 bits). INFERRED from the pinctrl-single function-mask 7.";
            sw = rw;
            hw = r;
            encode = muxctrl_reg0_func_enum;
        } func[2:0];
    } muxctrl_reg0 @ 0x0;

