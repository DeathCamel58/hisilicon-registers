            sw = rw;
            hw = r;
        } value[31:0];
    } DXNWDQNBDL1 @ 0x14;

    reg {
        name = "DXNWDQNBDL2";
        desc = "DXNWDQNBDL2. PROVENANCE: PROVEN name/offset: DDR_PHY_DXNWDQNBDL2(n) at 0x218 + (n << 7) with the lane window at PHY + 0x200 (ddr_phy_t28.h); the lane window is also written at a few offsets by the CV300 init table (listed in the PHY description).";
        field {
