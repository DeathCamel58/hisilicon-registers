        desc = "PLLTIMER. PROVENANCE: INFERRED name (borrowed from the S40/V2 PHY at the same offset; ddr_phy_t28.h does not name it); PROVEN access: the CV300 init table writes 0x5DC00080 to PHY+0x1C.";
        field {
            name = "value";
            desc = "32-bit register value (field layout not described by any source I have: UNKNOWN).";
            sw = rw;
