regfile eHISI_DDRC_T28_PHY_LANE {
    name = "DDR PHY (T28) byte-lane registers";
    desc = "One byte lane of the 28 nm T28 DDR PHY (offsets relative to PHY + 0x200 + lane x 0x80). PROVENANCE: PROVEN names and offsets from DDR_PHY_DXN*(n) in drivers/ddr/ddr_phy_t28.h of the vendor U-Boot (formulas 0x210 + (n << 7) etc.); meanings INFERRED from the names; field layout UNKNOWN except the masks listed in the header (bit delay line [6:0], RDQS bit delay [8:0], RDQSG phase [14:9], WDQS phase mask 0xF, WDQ phase mask 0x1F, VREF status DVREF [5:0] and HVREF [4:0]). Not hardware verified.";

    reg {
        name = "DXNWDQNBDL0";
        desc = "DXNWDQNBDL0. PROVENANCE: PROVEN name/offset: DDR_PHY_DXNWDQNBDL0(n) at 0x210 + (n << 7) with the lane window at PHY + 0x200 (ddr_phy_t28.h); the lane window is also written at a few offsets by the CV300 init table (listed in the PHY description).";
        field {
            name = "value";
            desc = "32-bit register value (field layout not described by any source I have: UNKNOWN).";
            sw = rw;
            hw = r;
        } value[31:0];
    } DXNWDQNBDL0 @ 0x10;

    reg {
        name = "DXNWDQNBDL1";
        desc = "DXNWDQNBDL1. PROVENANCE: PROVEN name/offset: DDR_PHY_DXNWDQNBDL1(n) at 0x214 + (n << 7) with the lane window at PHY + 0x200 (ddr_phy_t28.h); the lane window is also written at a few offsets by the CV300 init table (listed in the PHY description).";
        field {
