    reg {
        name = "PHYTIMER1";
        desc = "PHYTIMER1. PROVENANCE: INFERRED name (borrowed from the S40/V2 PHY at the same offset; ddr_phy_t28.h does not name it); PROVEN access: the CV300 init table writes 0xF000F000 to PHY+0x14.";
        field {
            name = "value";
            desc = "32-bit register value (field layout not described by any source I have: UNKNOWN).";
            sw = rw;
