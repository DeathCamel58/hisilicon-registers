            sw = rw;
            hw = r;
        } value[31:0];
    } DXNRDQNBDL1 @ 0x20;

    reg {
        name = "DXNRDQNBDL2";
        desc = "DXNRDQNBDL2. PROVENANCE: PROVEN name/offset: DDR_PHY_DXNRDQNBDL2(n) at 0x224 + (n << 7) with the lane window at PHY + 0x200 (ddr_phy_t28.h); the lane window is also written at a few offsets by the CV300 init table (listed in the PHY description).";
