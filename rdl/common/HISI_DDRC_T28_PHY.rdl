    reg {
        name = "DXNRDQNBDL1";
        desc = "DXNRDQNBDL1. PROVENANCE: PROVEN name/offset: DDR_PHY_DXNRDQNBDL1(n) at 0x220 + (n << 7) with the lane window at PHY + 0x200 (ddr_phy_t28.h); the lane window is also written at a few offsets by the CV300 init table (listed in the PHY description).";
        field {
            name = "value";
