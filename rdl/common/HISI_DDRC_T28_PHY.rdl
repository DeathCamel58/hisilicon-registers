        } value[31:0];
    } DRAMTIMER0 @ 0x30;

    reg {
        name = "DRAMTIMER1";
        desc = "DRAMTIMER1. PROVENANCE: INFERRED name (borrowed from the S40/V2 PHY at the same offset; ddr_phy_t28.h does not name it); PROVEN access: the CV300 init table writes 0x182C0E75 to PHY+0x34.";
