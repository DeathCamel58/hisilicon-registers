`ifndef HISI_MIPI_RX_AV100_RDL
`define HISI_MIPI_RX_AV100_RDL


regfile eHISI_MIPI_RX_AV100 {
    name = "MIPI RX (sensor serial interface receiver, Hi3516A/D V100)";
    desc = "
    MIPI RX (combo PHY + controller for MIPI D-PHY CSI-2, LVDS / sub-LVDS / HiSPI and CMOS parallel sensors, feeding the VICAP) of the Hi3516A V100 / Hi3516D V100 at 0x20680000. Two links (link 0 at 0x1000, link 1 at 0x1400, each with interrupt, lane, PHY, MIPI data-ID / packet-error, FSM registers and per-lane LVDS sync codes at +0x80); 38 of the 42 registers of the Hi3518E V20X `eHISI_MIPI_RX` are identical by offset, fields and reset (that block lacks LVDS_WDR_MODE 0x10, MIPI_RSTN 0x1034 and link 1, and has MIPI_USERDEF_DT/USER_DEF/CROPSTART/CTRL_MODE at 0x18-0x24 which this chip's data sheet does not list). The vendor header adds PHY_MODE/POWER/DLY, the lane 2/3 sync codes, the PHY status set at 0x1200/0x1600 and MIPI_IMGSIZE_CHN0/1 at 0x800. Non-hardware-verified transcription.

    Generated 2026-11-10 by build/rdl-audit/video-rdl-scratch/gen_blocks.py: mechanical transcription of the data sheet register tables (ds_extract2 + description extraction from the PDF) merged with the vendor header; not hardware verified.

    Register sources: 64 registers from the data sheet (hi3516av100--Hi3516A-Hi3516D-Datasheet.txt, section 10.3.6); 71 registers and 50 fields from OpenIPC openhisilicon `kernel/mipi_rx/hi3516av100/mipi_reg.h` (GPL-3.0 repository, HiSilicon copyright; local copy sources/openhisilicon) (GPL-3.0 repository, HiSilicon copyright; byte-identical to the hi3516cv200 file), each marked `[inferred]` in its desc (names from the header, meanings inferred from the names, reset/access unknown). 4 field names that the data-sheet text extraction garbled (two column cells run together) were taken from the header. Name differences, data sheet kept: 0x4 name DS MIPI_CTRL_MODE / header MIPI_CTRL_PARAM; 0x1014 LANE_ID_LINK0 header field lane0_id [2:0] overlaps DS fields differently; 0x1014 LANE_ID_LINK0 header field lane1_id [6:4] overlaps DS fields differently; 0x1014 LANE_ID_LINK0 header field lane2_id [10:8] overlaps DS fields differently; 0x1014 LANE_ID_LINK0 header field lane3_id [14:12] overlaps DS fields differently; 0x1030 name DS MIPI_LANES_NUM / header MIPI_LANES_NUM_LINK0; 0x1030 MIPI_LANES_NUM [1:0] DS  / header mipi_lane_num; 0x1034 name DS MIPI_RSTN / header MIPI_RSTN_LINK0; 0x1038 name DS MIPI_DI_1 / header MIPI_DI_1_LINK0; 0x103C name DS MIPI_DI_2 / header MIPI_DI_2_LINK0; 0x1040 name DS MIPI_INTR1_RAW / header MIPI_INTR1_RAW_LINK0; 0x1044 name DS MIPI_INTR2_RAW / header MIPI_INTR2_RAW_LINK0; 0x1044 MIPI_INTR2_RAW [8:8] data-sheet text `ctedintr_vc0_ecc_corrected` garbled, header name intr_vc0_ecc_corrected used; 0x1044 MIPI_INTR2_RAW [9:9] data-sheet text `ctedintr_vc1_ecc_correctedintr_vc0_ecc_corre` garbled, header name intr_vc1_ecc_corrected used; 0x1044 MIPI_INTR2_RAW [10:10] data-sheet text `ctedintr_vc2_ecc_correctedintr_vc1_ecc_corre` garbled, header name intr_vc2_ecc_corrected used; 0x1044 MIPI_INTR2_RAW [11:11] data-sheet text `intr_vc3_ecc_correctedintr_vc2_ecc_corre` garbled, header name intr_vc3_ecc_corrected used; 0x1048 name DS MIPI_INTR1_MASK / header MIPI_INTR1_MASK_LINK0; 0x104C name DS MIPI_INTR2_MASK / header MIPI_INTR2_MASK_LINK0; 0x1060 name DS MIPI_TIMEOUT / header MIPI_TIMEOUT_LINK0; 0x1064 name DS MIPI_FSM_PARAM / header MIPI_FSM_PARAM_LINK0; 0x1064 MIPI_FSM_PARAM [13:8] DS cyc_data_hs_trail / header cyc_data_hs0; 0x1068 name DS MIPI_FSM_CKEN / header MIPI_FSM_CKEN_LINK0; 0x1414 LANE_ID_LINK1 header field lane0_id [2:0] overlaps DS fields differently; 0x1414 LANE_ID_LINK1 header field lane1_id [6:4] overlaps DS fields differently; 0x1414 LANE_ID_LINK1 header field lane2_id [10:8] overlaps DS fields differently; 0x1414 LANE_ID_LINK1 header field lane3_id [14:12] overlaps DS fields differently; 0x1428 PHY_CFG_LINK1 [3:0] DS rg_en_d / header phy_rg_en_d; 0x1428 PHY_CFG_LINK1 [4:4] DS rg_en_clk / header phy_rg_en_clk; 0x1428 PHY_CFG_LINK1 [8:8] DS rg_en_cmos / header phy_rg_en_cmos; 0x1428 PHY_CFG_LINK1 [12:12] DS rg_en_lp / header phy_rg_en_lp; 0x1428 PHY_CFG_LINK1 [19:16] DS da_ulpb / header phy_da_ulpb; 0x1428 PHY_CFG_LINK1 [20:20] DS da_ulpb_ck / header phy_da_ulpb_ck; 0x1428 PHY_CFG_LINK1 [25:24] DS rg_it_lp / header phy_rg_it_lp; 0x1428 PHY_CFG_LINK1 [27:26] DS rg_it_ck / header phy_rg_it_ck; 0x1428 PHY_CFG_LINK1 [29:28] DS rg_it_dt / header phy_rg_it_dt; 0x1428 PHY_CFG_LINK1 [30:30] DS rg_sa_en / header phy_rg_sa_en.";

    reg {
        name = "MIPI configuration enable register";
        desc = "MIPI_START is an MIPI configuration enable register. Huawei Proprietary and Confidential Hi3516A/Hi3516D Professional HD IP Camera SoC

Data sheet 10.3.6 MIPI_START (offset 0x0, printed page 10-281, `hi3516av100--Hi3516A-Hi3516D-Datasheet.txt` line 74566).";

        enum MIPI_START_mipi_start_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED_APB_CLOCK = 1 { name = "Enabled Apb Clock"; desc = "enabled the APB clock domain configuration signal and convert it into the MIPI working clock domain output."; };
        };

        field {
            name = "mipi_start";
            desc = "Configuration enable.";
            sw = rw;
            hw = r;
            encode = MIPI_START_mipi_start_enum;
            reset = 0x0;
        } mipi_start[0:0];
    } MIPI_START @ 0x0;

