            SAV_EAV_MODE = 1 { name = "Sav Eav Mode"; desc = "SAV-EAV mode SAV-EAV mode is widely applied in SONY/OmniVision sensors. In this mode, set InValid SAV/EAV in LINKm_LANEn_SOF_xx or LINKm_LANEn_EOF_xx, and set Valid SAV/EAV in LINKm_LANEn_SOL_xx or LINKm_LANEn_SOL_xx. Here, m is 0 or 1, and n is 0, 1, 2, or 3. In HiSPI mode, this field must be set to 0."; };
