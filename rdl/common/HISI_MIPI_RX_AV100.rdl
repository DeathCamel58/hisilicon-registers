            MSB_MOST_SIGNIFICANT = 1 { name = "Msb Most Significant"; desc = "MSB. Most significant bits are transmitted first. Use RAW12 as an example. The serial data sequence of the valid pixels received is bit 11, bit 10, …, bit 0."; };
