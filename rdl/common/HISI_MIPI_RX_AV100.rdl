        desc = "LINK0_LANE3_SOF_01 is an SOF synchronization code configuration register for lane 3 in LVDS or HiSPI mode.

Data sheet 10.3.6 LINK0_LANE3_SOF_01 (offset 0x10E0, printed page 10-316, `hi3516av100--Hi3516A-Hi3516D-Datasheet.txt` line 76557).";

        field {
            name = "lane3_sof_1";
            desc = "SOF synchronization code of frame 1 for lane 3 in LVDS or HiSPI mode. The field is configurable only in WDR mode, and the configuration is invalid in linear mode.";
            sw = rw;
            hw = r;
            reset = 0x0;
