`ifndef HISI_VEDU_RDL
`define HISI_VEDU_RDL

addrmap aHISI_VEDU {
    name = "HiSilicon VEDU (registers not described)";
    desc = "Not described: no register of this block is described; the registers exist only in closed vendor libraries (the MPP binary modules), not in the data sheet or any vendor source in the tree. The 64 KB window is kept only so that the block base address and size exist in the address map (STUB). H.264 video encoder (data sheet 6.2 calls it VENC, Table 1-1 'Video encoding (VENC) register'; chapter 6 overview/features only, no register description): H.264 High/Main/Baseline @4.2, 8 ROIs, OSD front-end overlay (8 regions), CBR/VBR, 16xD1@6 + 8xCIF@6 etc.; three DDR buffers (input picture, reconstruction/reference, stream). The vendor MPP VENC is a closed-source binary module; the Hi3531-family header lists a second encoder VENC1 at 0x20690000 (Reserved in the Hi3520D table). PERI_CRG16 holds the clock/reset (VEDU0 cken bit 1). Base address 0x20620000, GIC interrupt ID 72. Listed as an open item in docs/rdl-sweep/PORT-BLOCKS.md.";

    external mem {
        name = "Undocumented register window";
        desc = "The whole 64 KB window of the block. Register layout unknown; placeholder so the block base address and size exist in the map. No registers are described.";
        mementries = 16384;
        memwidth = 32;
        sw = rw;
    } REGS;
};

`endif
