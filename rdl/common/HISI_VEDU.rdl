        desc = "UNK_0xA98 (name is a placeholder, not a vendor name). NOT IN THE DATA SHEET. Source: vendor module hi3520D_chnl.ko (VEDU_OutputDebugInfo 0x57e4, called from the channel watchdog ChnlWatchDogTimerISR 0x308c when a frame does not complete): read as part of the debug dump of the ranges 0x000-0x15F and 0xA50-0xA9F (word loads, printed with printk, value not interpreted); never written by the vendor. Neighbors: the whole dump range. r006 has VEDU_LDSTR_STATE[2] at this offset (neighbor generation, inferred, LOW; not adopted as a name). Unknown purpose, vendor-observed only, confidence LOW, not verified on hardware.";

        field {
            name = "unk";
            desc = "Unknown 32-bit value (vendor-observed read in the debug dump only).";
            sw = r;
            hw = w;
        } unk[31:0];

    } UNK_0xA98 @ 0xA98;

