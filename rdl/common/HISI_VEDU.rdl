        field {
            name = "idrind";
            desc = "r006 field IDRind. 1 for an IDR picture: the hardware writes the NAL header 0x65 (nal_ref_idc from PICFG0 [17:16], type 5; PROVEN that the value 1 gives 0x65 in the 40 runs; the vendor sets it for IDR, 0 otherwise is INFERRED).";
            sw = rw;
            hw = r;
        } idrind[1:1];

        field {
