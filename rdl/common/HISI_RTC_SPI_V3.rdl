    reg {
        name = "RTC raw interrupt status register";
        desc = "RTC_RAW_INT is an RTC raw interrupt status register.

Data sheet 3.9.7 RTC_RAW_INT (internal address 0x16, printed page 3-190, `hi3516av200--Hi3516AV200-Datasheet.txt` line 14396).";
        regwidth = 8;

        enum RTC_RAW_INT_status_enum {
