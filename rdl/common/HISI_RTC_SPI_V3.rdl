Data sheet 3.9.7 RTC_INT_CLR (internal address 0x14, printed page 3-189, `hi3516av200--Hi3516AV200-Datasheet.txt` line 14331).";
        regwidth = 8;

        field {
            name = "rtc_int_clr";
            desc = "RTC interrupt clear register. Writing any value by software clears the interrupt. Reading back the value has no effect.";
            sw = w;
            hw = r;
            reset = 0x0;
        } rtc_int_clr[0:0];
    } RTC_INT_CLR @ 0x14;

    reg {
        name = "RTC mask interrupt status register.";
        desc = "RTC_MSC_INT is an RTC mask interrupt status register.

Data sheet 3.9.7 RTC_MSC_INT (internal address 0x15, printed page 3-189, `hi3516av200--Hi3516AV200-Datasheet.txt` line 14358).";
