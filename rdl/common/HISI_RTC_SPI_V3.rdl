    reg {
        name = "RTC reset control register";
        desc = "RTC_POR_N is an RTC reset control register.

Soft reset: write 0, wait 30 ms (DS 3.9.4.2); after reset all RTC registers return to their defaults and must be re-initialised. The bit sets itself back to 1.

Data sheet 3.9.7 RTC_POR_N (internal address 0x18, printed page 3-191, `hi3516av200--Hi3516AV200-Datasheet.txt` line 14462).";
        regwidth = 8;

        field {
            name = "rtc_por_n";
            desc = "RTC reset. This field is automatically set to 1 after the RTC is successfully reset. 0: reset";
            sw = rw;
            hw = r;
            reset = 0x1;
        } rtc_por_n[0:0];
    } RTC_POR_N @ 0x18;

    reg {
        name = "RTC internal low-voltage detection control register";
        desc = "RTC_UV_CTRL is an RTC internal low-voltage detection control register.

Battery (RTC supply) under-voltage detection; the result is the `*_uv` interrupt in RTC_RAW_INT / RTC_MSC_INT. This register replaces the Hi3520D / Hi3516A V100 RTC_SAR_CTRL (temperature sensor update period) at the same internal address; only `sample_time` [1:0] keeps its position, with different periods.

Data sheet 3.9.7 RTC_UV_CTRL (internal address 0x1A, printed page 3-192, `hi3516av200--Hi3516AV200-Datasheet.txt` line 14496).";
        regwidth = 8;

        enum RTC_UV_CTRL_bat_uv_ctrl_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        enum RTC_UV_CTRL_bat_uv_ctrl_sel_enum {
            NO_FILTERING = 0 { name = "No Filtering"; desc = "no filtering"; };
            FILTERING = 1 { name = "Filtering"; desc = "filtering"; };
        };

        enum RTC_UV_CTRL_sample_time_enum {
            V_1_S = 0 { name = "1 s"; desc = "1 s"; };
            V_1_MINUTE = 1 { name = "1 Minute"; desc = "1 minute"; };
            V_10_MINUTES = 2 { name = "10 Minutes"; desc = "10 minutes"; };
            V_30_MINUTES = 3 { name = "30 Minutes"; desc = "30 minutes"; };
        };

        field {
            name = "bat_uv_ctrl_en";
            desc = "Low-voltage detection enable";
            sw = rw;
            hw = r;
            encode = RTC_UV_CTRL_bat_uv_ctrl_en_enum;
            reset = 0x0;
        } bat_uv_ctrl_en[5:5];

        field {
            name = "bat_uv_ctrl_sel";
            desc = "Low-voltage detection source select";
            sw = rw;
            hw = r;
            encode = RTC_UV_CTRL_bat_uv_ctrl_sel_enum;
            reset = 0x0;
        } bat_uv_ctrl_sel[4:4];

        field {
            name = "sample_time";
            desc = "Low-voltage detection cycle";
            sw = rw;
            hw = r;
            encode = RTC_UV_CTRL_sample_time_enum;
            reset = 0x0;
        } sample_time[1:0];
    } RTC_UV_CTRL @ 0x1A;

    reg {
        name = "Upper 4-bit external frequency divider register";
        desc = "SDM_COEF_OUSIDE_H is an upper 4-bit external frequency divider register.

The data sheet names the registers 0x51/0x52 `Sdm_coef_ouside_h/l` (sic); the register names here are the summary-table spelling, the field of the _H register is `Sdm_coef_ouside_h` as in the bit table.

Data sheet 3.9.7 SDM_COEF_OUSIDE_H (internal address 0x51, printed page 3-192, `hi3516av200--Hi3516AV200-Datasheet.txt` line 14535).";
        regwidth = 8;

        field {
            name = "Sdm_coef_ouside_h";
            desc = "Upper four bits of the frequency divider";
            sw = rw;
            hw = r;
            reset = 0x8;
        } Sdm_coef_ouside_h[3:0];
    } SDM_COEF_OUSIDE_H @ 0x51;

    reg {
        name = "Lower 8-bit external frequency divider register";
        desc = "SDM_COEF_OUSIDE_L is a lower 8-bit external frequency divider register.

Read/write the upper four bits (0x51) and then the lower eight bits (0x52) consecutively. Divider = (f - 32700) x 30.52 where f is the external crystal frequency (about 32700..32800 Hz). Reset 0x81B (= 32768 Hz).

Data sheet 3.9.7 SDM_COEF_OUSIDE_L (internal address 0x52, printed page 3-193, `hi3516av200--Hi3516AV200-Datasheet.txt` line 14567).";
        regwidth = 8;

        field {
            name = "sdm_coef_ouside_l";
            desc = "Lower eight bits of the frequency divider Note: When clock divider registers (addresses of 0x51 and 0x52) are read or written, you need to read or write to the upper four bits and then the lower eight bits continuously. The clock divider is calculated as follows: (f - 32700) x 30.52. f indicates the oscillation frequency of the external crystal and ranges from 32700 to 32799.";
            sw = rw;
            hw = r;
            reset = 0x1B;
        } sdm_coef_ouside_l[7:0];
    } SDM_COEF_OUSIDE_L @ 0x52;

