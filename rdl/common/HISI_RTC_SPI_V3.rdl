    reg {
        name = "RTC configured value loading enable register";
        desc = "RTC_LORD is an RTC configured value loading enable register.

Same as the Hi3518E V20X (the Hi3520D RTC has no `rtc_lock` / `rtc_lock_bypass` here): while `rtc_lock_bypass` is 0 the counter registers 0x00-0x05 only update after a successful lock: write `rtc_lock` = 1 and wait until hardware clears it, then read RTC_*_COUNT. With `rtc_lock_bypass` = 1 the count registers update in real time.

Data sheet 3.9.7 RTC_LORD (internal address 0x12, printed page 3-189, `hi3516av200--Hi3516AV200-Datasheet.txt` line 14254).";
        regwidth = 8;

        enum RTC_LORD_rtc_lock_bypass_enum {
            ENABLED_RTC_COUNT = 0 { name = "Enabled Rtc Count"; desc = "enabled. The RTC count value (0x00-0x05) is updated only after the RTC is successfully locked."; };
            DISABLED_RTC_COUNT = 1 { name = "Disabled Rtc Count"; desc = "disabled. The RTC count value (0x00-0x05) is updated in real time."; };
        };

        field {
            name = "rtc_lock_bypass";
            desc = "RTC lock enable";
            sw = rw;
            hw = r;
            encode = RTC_LORD_rtc_lock_bypass_enum;
            reset = 0x0;
        } rtc_lock_bypass[2:2];

        field {
            name = "rtc_lock";
            desc = "RTC lock. If software writes 1, hardware is automatically cleared after the RTC is successfully locked. Note: This field is valid only when rtc_lock_bypass is 0.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } rtc_lock[1:1];

        field {
            name = "rtc_load";
            desc = "RTC configured value loading enable. When the field is enabled, the RTC configured value will be loaded to the RTC accumulator. If software writes 1 to load the configured value, hardware will automatically set this field to 0 after successful loading.";
            sw = rw;
            hw = r;
            reset = 0x0;
        } rtc_load[0:0];
    } RTC_LORD @ 0x12;

    reg {
        name = "RTC interrupt enable register";
        desc = "RTC_IMSC is an RTC interrupt enable register.

Two interrupt sources (timing / alarm match and battery low-voltage detection) behind one global output enable `rtc_imsc`; the Hi3518E V20X / Hi3520D RTC only has the timing enable in bit 0.

Data sheet 3.9.7 RTC_IMSC (internal address 0x13, printed page 3-189, `hi3516av200--Hi3516AV200-Datasheet.txt` line 14290).";
        regwidth = 8;

        enum RTC_IMSC_enable_enum {
            DISABLED = 0 { name = "Disabled"; desc = "disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "enabled"; };
        };

        field {
            name = "rtc_imsc";
            desc = "RTC global interrupt output enable";
            sw = rw;
            hw = r;
            encode = RTC_IMSC_enable_enum;
            reset = 0x0;
        } rtc_imsc[2:2];

        field {
            name = "rtc_imsc_uv";
            desc = "Battery low-voltage detection interrupt output enable";
            sw = rw;
            hw = r;
            encode = RTC_IMSC_enable_enum;
            reset = 0x0;
        } rtc_imsc_uv[1:1];

        field {
            name = "rtc_imsc_time";
            desc = "RTC timing interrupt output enable";
            sw = rw;
            hw = r;
            encode = RTC_IMSC_enable_enum;
            reset = 0x0;
        } rtc_imsc_time[0:0];
    } RTC_IMSC @ 0x13;

