// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3516av300-boot" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3516A V300: boot and upgrade flow</B><BR/><FONT POINT-SIZE="11">data sheet 1.4 Table 1-1; BOOT_SEL1 = SENSOR0_RSTN latch, BOOT_SEL0 = MDCK latch (SYSSTAT[5:4]), UPDATE_MODE = GPIO0_0 level</FONT>>, fontcolor="#808080", rankdir=TB];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  por [label="Power-on reset", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  um [label="UPDATE_MODE (GPIO0_0) ?", fillcolor="#d6d27a"   shape=diamond];
  sd [label="BOOTROM: upgrade from SDIO0 card or USB\n(BOOT_SEL0: 0 SPI flash, 1 eMMC)", fillcolor="#e0b86f"  ];
  b1 [label="BOOT_SEL1 ?", fillcolor="#d6d27a"   shape=diamond];
  ser [label="BOOTROM: burn over UART\n(BOOT_SEL0: 0 SPI flash, 1 eMMC)", fillcolor="#e0b86f"  ];
  b0 [label="BOOT_SEL0 ?", fillcolor="#d6d27a"   shape=diamond];
  spi [label="SPI NOR / SPI NAND (FMC)", fillcolor="#8fb3de"  ];
  emmc [label="eMMC 4-bit", fillcolor="#8fb3de"  ];
  sec [label="secure boot (PERISTAT[0] = 1):\nBOOTROM verifies the U-Boot signature", fillcolor="#c9a0dc"  ];
  run [label="boot code runs; remap cleared", fillcolor="#a6c98f"  ];
  por -> um;
  um -> sd [label="0"];
  um -> b1 [label="1"];
  b1 -> ser [label="1"];
  b1 -> b0 [label="0"];
  b0 -> spi [label="0"];
  b0 -> emmc [label="1"];
  spi -> sec;
  emmc -> sec;
  sec -> run;
  sd -> run;
  ser -> run;
}
