digraph "hi3516av300-crgmap" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>hi3516av300: CRG register map overview</B><BR/><FONT POINT-SIZE="11">generated from the compiled RDL CRG block (56 registers at 0x12010000); registers grouped by the keywords of their names (keyword grouping, not a data sheet figure)</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  crg [label="CRG  0x12010000\n56 registers", fillcolor="#9aa7e6"  ];
  g0 [label="PLL configuration\n9 registers, 0x000-0x1E8\nPERI_CRG_PLL0, PERI_CRG_PLL1, PERI_CRG_PLL2, PERI_CRG_PLL3, PERI_CRG_PLL4, PERI_CRG_PLL5, PERI_CRG_PLL6, ...", fillcolor="#e6a0a0"  ];
  crg -> g0;
  g1 [label="Clock frequency / source select\n5 registers, 0x078-0x1E0\nPERI_CRG30, PERI_CRG32, PERI_CRG40, PERI_CRG65, PERI_CRG120", fillcolor="#d6d27a"  ];
  crg -> g1;
  g2 [label="Module clock gate and soft reset\n35 registers, 0x07C-0x1BC\nPERI_CRG31, PERI_CRG41, PERI_CRG42, PERI_CRG43, PERI_CRG44, PERI_CRG45, PERI_CRG46, ...", fillcolor="#9aa7e6"  ];
  crg -> g2;
  g3 [label="Status / monitor / other\n7 registers, 0x150-0x1E4\nPERI_CRG84, PERI_CRG87, PERI_CRG90, PERI_CRG105, PERI_CRG106, PERI_CRG107, PERI_CRG_PLL121", fillcolor="#9a9a9a"  ];
  crg -> g3;
}
