// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3516av300-video" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3516A V300: video and AI data path</B><BR/><FONT POINT-SIZE="11">block names and capabilities from the data sheet chapter 1 (ISP, VPSS, VGS, VEDU, VDP, TDE, IVE ...); the arrows are the usual camera data path (INFERRED, not tabulated in the data sheet); frames pass through DDR between stages</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  sen [label="2 sensor inputs\nMIPI / LVDS / HiSPi, DC, BT.601/656/1120", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  vicap [label="MIPI RX + VICAP + ISP\n(3A, WDR, LSC, LDC, dehaze, NR)", fillcolor="#a6c98f"  ];
  viproc [label="VIPROC", fillcolor="#a6c98f"  ];
  vpss [label="VPSS\n3DNR, scale, rotate, OSD", fillcolor="#a6c98f"  ];
  gdc [label="GDC\ndistortion, 6-DoF stabilization", fillcolor="#a6c98f"  ];
  vgs [label="VGS", fillcolor="#a6c98f"  ];
  venc [label="VEDU (H.264/H.265)\nJPGE / JPGD", fillcolor="#a6c98f"  ];
  ai [label="NNIE (neural network)\nIVE, SCD", fillcolor="#a6c98f"  ];
  vdp [label="VDP\nBT.656/1120, LCD", fillcolor="#a6c98f"  ];
  dsi [label="MIPI TX (4-lane DSI)\nHDMI 1.4 TX", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  net [label="ETH / SDIO / eMMC / USB / FMC\n(stream out, storage)", fillcolor="#8fb3de"  ];
  sen -> vicap;
  vicap -> viproc;
  viproc -> vpss;
  vpss -> gdc;
  gdc -> vgs;
  vpss -> vgs;
  vgs -> venc;
  vpss -> venc;
  vpss -> ai;
  venc -> net [label="streams"];
  vpss -> vdp;
  vdp -> dsi;
}
