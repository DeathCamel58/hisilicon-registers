// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3516av300-dma" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3516A V300: DMAC request lines</B><BR/><FONT POINT-SIZE="11">data sheet Table 3-5 / 3-9; 8 channels, programmable priority, per-channel security attribute; fixed line assignment</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  i2c [label="I2C0..I2C7 RX/TX\nlines 0-15", fillcolor="#7fcdc4"  ];
  uart [label="UART0..UART4 RX/TX\nlines 16-25", fillcolor="#7fcdc4"  ];
  spi [label="SPI0..SPI2 RX/TX\nlines 26-31", fillcolor="#7fcdc4"  ];
  dmac [label="DMAC 0x10060000\n8 channels, LLI, 8/16/32/64-bit", fillcolor="#e0b86f"  ];
  mem [label="DDR / peripherals", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  i2c -> dmac;
  uart -> dmac;
  spi -> dmac;
  dmac -> mem;
}
