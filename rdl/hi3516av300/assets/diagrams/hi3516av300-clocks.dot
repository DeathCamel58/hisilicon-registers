// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3516av300-clocks" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3516A V300: clock tree</B><BR/><FONT POINT-SIZE="11">redrawn from data sheet Figure 3-3 and Tables 3-2..3-4; PLL values as printed; module selects are in the PERI_CRG registers (no per-signal table in this data sheet)</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  xin [label="XIN 24 MHz crystal", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  apll [label="APLL PERI_CRG_PLL0/1\nVCO 1800, POSTDIV 900 MHz\n(programmable)", fillcolor="#e6a0a0"  ];
  dpll [label="DPLL PERI_CRG_PLL2/3\nVCO 2376, POSTDIV 594 MHz", fillcolor="#e6a0a0"  ];
  epll [label="EPLL PERI_CRG_PLL4/5\nVCO 1056, POSTDIV 528 MHz", fillcolor="#e6a0a0"  ];
  vpll [label="VPLL PERI_CRG_PLL6/7\nVCO 1104, POSTDIV 552 MHz", fillcolor="#e6a0a0"  ];
  div [label="dividers / selects in PERI_CRG\n(600/360/300/257/200/100/72, 450/150/50,\n792/594/475/396/339/297, 54/27, 148.5/74.25 MHz)", fillcolor="#d6d27a"  ];
  cpu [label="A7: 24 / 600 / 792 / 900 MHz", fillcolor="#e0b86f"  ];
  ddr [label="DDR: 24 / 360 / 396 / 450 MHz", fillcolor="#8fb3de"  ];
  bus [label="SYSAXI 24/198/300, SYSCFG 24/148.5, SYSAPB 24/50", fillcolor="#8fb3de"  ];
  vid [label="VPSS 150-475, VIPROC/VICAP 150-396, VGS 300-475,\nIVE 300-475, GDC 300-475", fillcolor="#a6c98f"  ];
  io [label="FMC 24-396, SDIO0 25/50/100,\nSDIO1 + eMMC 25/50/100", fillcolor="#8fb3de"  ];
  gate [label="clock gate + soft reset bits in PERI_CRGn", fillcolor="#9aa7e6"  ];
  xin -> apll;
  xin -> dpll;
  xin -> epll;
  xin -> vpll;
  apll -> div;
  dpll -> div;
  epll -> div;
  vpll -> div;
  xin -> div [label="24 MHz"];
  div -> cpu;
  div -> ddr;
  div -> bus;
  div -> vid;
  div -> io;
  vid -> gate;
  io -> gate;
}
