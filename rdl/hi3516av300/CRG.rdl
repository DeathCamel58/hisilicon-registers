            LOCKED = 1 { name = "Locked"; desc = "Locked"; };
        };

        field {
            name = "vpll_lock";
            desc = "VPLL lock status. 0: unlocked, 1: locked.";
            sw = r;
            hw = w;
            encode = PERI_CRG_PLL122_vpll_lock_enum;
            reset = 0x0;
        } vpll_lock[2:2];

        enum PERI_CRG_PLL122_dpll_lock_enum {
