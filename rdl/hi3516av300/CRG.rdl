            hw = w;
            encode = PERI_CRG_PLL121_nnie_rst_ok_enum;
            reset = 0x0;
        } nnie_rst_ok[0:0];
    } PERI_CRG_PLL121 @ 0x1E4;

    reg {
        name = "PLL lock status register";
        desc = "PLL lock status register.

PLL lock status, bit per PLL (APLL 0, DPLL 1, VPLL 2, EPLL 3). The PLL change procedure in data sheet 3.2.4.1 says to observe `PERI_CRG_PLL122[10:0]` but only bits [3:0] are defined (the others are reserved).

Data sheet 3.2.6 PERI_CRG_PLL122 (offset 0x1E8, printed page 3-58, `hi3516av300--Hi3516AV300-Datasheet.txt` line 9911).";

        enum PERI_CRG_PLL122_epll_lock_enum {
            UNLOCKED = 0 { name = "Unlocked"; desc = "Unlocked"; };
            LOCKED = 1 { name = "Locked"; desc = "Locked"; };
        };

        field {
            name = "epll_lock";
            desc = "EPLL lock status. 0: unlocked, 1: locked.";
            sw = r;
            hw = w;
            encode = PERI_CRG_PLL122_epll_lock_enum;
            reset = 0x0;
        } epll_lock[3:3];

        enum PERI_CRG_PLL122_vpll_lock_enum {
