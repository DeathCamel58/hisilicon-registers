        field {
            name = "aiao_mclk2_div";
            desc = "AIAO MCLK2 divided clock, configurable. For a target frequency X (MHz): aiao_mclk2_div = (X / 1188) * 2^27; maximum 75 MHz.";
            sw = rw;
            hw = r;
            reset = 0x1FFFFF;
        } aiao_mclk2_div[26:0];
