            LOCKED = 1 { name = "Locked"; desc = "Locked"; };
        };

        field {
            name = "dpll_lock";
            desc = "DPLL lock status. 0: unlocked, 1: locked.";
            sw = r;
            hw = w;
            encode = PERI_CRG_PLL122_dpll_lock_enum;
            reset = 0x0;
        } dpll_lock[1:1];

        enum PERI_CRG_PLL122_apll_lock_enum {
            UNLOCKED = 0 { name = "Unlocked"; desc = "Unlocked"; };
            LOCKED = 1 { name = "Locked"; desc = "Locked"; };
        };

        field {
            name = "apll_lock";
