            hw = r;
            encode = MISC_CTRL6_vicap_viproc_online_mode_enum;
            reset = 0x0;
        } vicap_viproc_online_mode[6:6];

        enum MISC_CTRL6_vi_port1_input_sel_enum {
            MIPI_CHANNEL1 = 0 { name = "Mipi Channel1"; desc = "MIPI channel 1"; };
            CMOS_INPUT = 1 { name = "Cmos Input"; desc = "CMOS input"; };
        };

        field {
