`ifndef HI3516AV300_MISC_CTRL_RDL
`define HI3516AV300_MISC_CTRL_RDL

regfile eMISC_CTRL {
    name = "Miscellaneous control (MISC_CTRL), Hi3516A V300";
    desc = "    MISC_CTRL miscellaneous control registers at 0x12030000. Names MISC_CTRLn with offset = n x 4. Data sheet: Hi3516AV300 Professional Smart IP Camera SoC User Guide, document version 01 (2019-09-15), original Chinese edition (watermarked), register overview 3.5.4 (Table 3-4) and descriptions 3.5.5 (printed pages 3-70..3-110). Only the 55 registers listed in the data sheet exist: MISC_CTRL0, 1, 3, 4, 6, 8, 10..12, 14..39 and 44..63 (the numbers skipped in Table 3-4 are not implemented). Offset = n x 4 holds up to MISC_CTRL56 (0xE0); MISC_CTRL57..63 sit at 0x100..0x118, i.e. at (n + 7) x 4 (data sheet naming anomaly, offsets as printed). Read from the PDF text (pdftotext -raw) and cross-checked with the layout dump `hi3516av300--Hi3516AV300-Datasheet.txt` lines 10618..13677. Checked on 2026-11-10.

    Contents: function select (MISC_CTRL0/1: TEST_CLK select, JTAG on SDIO0, eMMC/SDIO bug-fix bypasses, SPI chip-select polarity, SDIO0 power switch), CPU status (MISC_CTRL3), RAM retention/power (MISC_CTRL4), video data path modes (MISC_CTRL6), USB 2.0 controller options (MISC_CTRL8), DDR scrambling (MISC_CTRL10..12), AXI bus timeout and priority control for the SYSCFG, SYSDATA, AHB1, MEDIA0, MEDIA1, MEDIA2 and VIVO buses (MISC_CTRL14..31), DDR controller QoS groups (MISC_CTRL32..39), SVB PWM (MISC_CTRL44), TSensor (MISC_CTRL45..50), upgrade mode (MISC_CTRL51), HPM/SHPM (MISC_CTRL52..56), DDRC register lock (MISC_CTRL57) and the secure-access/security-attribute registers (MISC_CTRL58..63). No clock or PLL registers live here (see CRG.rdl).

    Data sheet quirks: the description of MISC_CTRL8 has no `MISC_CTRL8 is` sentence; the bit-priority register numbers in the titles skip 3 (MISC_CTRL17 is `register 4`); the layout dump has wrapped or watermark-damaged field names (for example `Comedia1_timeout_val`, `gojpgd_slv_sec_acc_di`, `cpu_hpm_pc_record` three times) that were rebuilt from the PDF text, and MISC_CTRL62 bits 9 and 8 have no name in the layout dump (names jpgd_mst_r_sec_acc and jpgd_mst_w_sec_acc from the PDF text); the extracted JSON header of MISC_CTRL44/MISC_CTRL51 shows `0x0000000c` because of watermark noise, the true total reset value is 0 (all field resets are 0). No vendor code for this block (the vendor Linux driver only uses the CRG, not the MISC block) was found for cross-checks.";

    reg {
        name = "MISC function select register 0";
        desc = "MISC function select register 0.

Reset 0x2000: vgs_bootram_mode = 1 (the VGS RAM is used as BOOTRAM). Contains the TEST_CLK source select, JTAG-on-SDIO0 pin mux, eMMC/SDIO bug-fix bypass bits, SDIO0 card-detect polarity and the SPI/3-wire chip-select polarity and SPI1 chip-select select bits.

Data sheet 3.5.5 MISC_CTRL0 (offset 0x0, printed page 3-70, `hi3516av300--Hi3516AV300-Datasheet.txt` line 10785).";

        enum MISC_CTRL0_test_clk_sel_enum {
            PLL_TEST_OUT0 = 0 { name = "Pll Test Out0"; desc = "Pll_test_out[0]"; };
            PLL_TEST_OUT1 = 1 { name = "Pll Test Out1"; desc = "Pll_test_out[1]"; };
            PLL_TEST_OUT2 = 2 { name = "Pll Test Out2"; desc = "Pll_test_out[2]"; };
            PLL_TEST_OUT3 = 3 { name = "Pll Test Out3"; desc = "Pll_test_out[3]"; };
            CLK_24M = 4 { name = "Clk 24M"; desc = "Clk_24m"; };
            AUDIOCODEC_MCLK = 5 { name = "Audiocodec Mclk"; desc = "Audiocodec_mclk"; };
            USB_PHY_CLK = 6 { name = "Usb Phy Clk"; desc = "Usb_phy_clk"; };
            MIPITX_PHY_LANEBYTE_CLK = 7 { name = "Mipitx Phy Lanebyte Clk"; desc = "Mipitx_phy_lanebyte_clk"; };
            HDMITX_PHY_TMDS_CLK = 8 { name = "Hdmitx Phy Tmds Clk"; desc = "Hdmitx_phy_tmds_clk"; };
            RTC_CLK_OUT = 9 { name = "Rtc Clk Out"; desc = "Rtc_clk_out"; };
            RESERVED_10 = 10 { name = "Reserved 10"; desc = "Reserved"; };
            RESERVED_11 = 11 { name = "Reserved 11"; desc = "Reserved"; };
            RESERVED_12 = 12 { name = "Reserved 12"; desc = "Reserved"; };
            RESERVED_13 = 13 { name = "Reserved 13"; desc = "Reserved"; };
            RESERVED_14 = 14 { name = "Reserved 14"; desc = "Reserved"; };
            RESERVED_15 = 15 { name = "Reserved 15"; desc = "Reserved"; };
        };

        field {
            name = "test_clk_sel";
            desc = "Source select of the TEST_CLK test clock. Other values are reserved.";
            sw = rw;
            hw = r;
            encode = MISC_CTRL0_test_clk_sel_enum;
            reset = 0x0;
        } test_clk_sel[19:16];

        enum MISC_CTRL0_jtag_on_sdio_enum {
            JTAG_PINS = 0 { name = "Jtag Pins"; desc = "JTAG signals on the JTAG_* pins"; };
            SDIO0_PINS = 1 { name = "Sdio0 Pins"; desc = "JTAG signals on the SDIO0_* pins"; };
        };

        field {
            name = "jtag_on_sdio";
            desc = "Multiplexes the JTAG signals onto the SDIO0 interface. 0: JTAG signals on the JTAG_* pins, 1: JTAG signals on the SDIO0_* pins.";
            sw = rw;
            hw = r;
            encode = MISC_CTRL0_jtag_on_sdio_enum;
            reset = 0x0;
        } jtag_on_sdio[14:14];

        enum MISC_CTRL0_vgs_bootram_mode_enum {
            DISABLED = 0 { name = "Disabled"; desc = "Disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "Enabled"; };
        };

        field {
            name = "vgs_bootram_mode";
            desc = "Use of the VGS RAM as BOOTRAM. Enable it when BOOTRAM is needed; set it to 0 when the VGS function is used. 0: disabled, 1: enabled.";
            sw = rw;
            hw = r;
            encode = MISC_CTRL0_vgs_bootram_mode_enum;
            reset = 0x1;
        } vgs_bootram_mode[13:13];

        enum MISC_CTRL0_emmc_fix_bypass_enum {
            FIX_ENABLED = 0 { name = "Fix Enabled"; desc = "Fix logic enabled"; };
            FIX_DISABLED = 1 { name = "Fix Disabled"; desc = "Fix logic disabled"; };
        };

        field {
            name = "emmc_fix_bypass";
            desc = "eMMC controller card-not-recognised bug fix logic enable control. 0: fix logic enabled, 1: fix logic disabled.";
            sw = rw;
            hw = r;
            encode = MISC_CTRL0_emmc_fix_bypass_enum;
            reset = 0x0;
        } emmc_fix_bypass[12:12];

        enum MISC_CTRL0_sdio1_fix_bypass_enum {
            FIX_ENABLED = 0 { name = "Fix Enabled"; desc = "Fix logic enabled"; };
            FIX_DISABLED = 1 { name = "Fix Disabled"; desc = "Fix logic disabled"; };
        };

        field {
            name = "sdio1_fix_bypass";
            desc = "SDIO1 controller card-not-recognised bug fix logic enable control. 0: fix logic enabled, 1: fix logic disabled.";
            sw = rw;
            hw = r;
            encode = MISC_CTRL0_sdio1_fix_bypass_enum;
            reset = 0x0;
        } sdio1_fix_bypass[11:11];

        enum MISC_CTRL0_sdio1_pd_mux_bypass_enum {
            FIX_ENABLED = 0 { name = "Fix Enabled"; desc = "Fix logic enabled"; };
            FIX_DISABLED = 1 { name = "Fix Disabled"; desc = "Fix logic disabled"; };
        };

        field {
            name = "sdio1_pd_mux_bypass";
            desc = "SDIO1 controller card power-down bug fix logic enable control. 0: fix logic enabled, 1: fix logic disabled.";
            sw = rw;
            hw = r;
            encode = MISC_CTRL0_sdio1_pd_mux_bypass_enum;
            reset = 0x0;
        } sdio1_pd_mux_bypass[10:10];

        enum MISC_CTRL0_sdio0_carddetect_pol_enum {
            ACTIVE_LOW = 0 { name = "Active Low"; desc = "Card-detect signal active low"; };
            ACTIVE_HIGH = 1 { name = "Active High"; desc = "Card-detect signal active high"; };
        };

        field {
            name = "sdio0_carddetect_pol";
            desc = "SDIO0 card-detect signal polarity control. 0: card-detect signal active low, 1: card-detect signal active high.";
            sw = rw;
            hw = r;
            encode = MISC_CTRL0_sdio0_carddetect_pol_enum;
            reset = 0x0;
        } sdio0_carddetect_pol[6:6];

        enum MISC_CTRL0_spi2_cs_pctrl_enum {
            ACTIVE_LOW = 0 { name = "Active Low"; desc = "SPI2_CSN active low"; };
            ACTIVE_HIGH = 1 { name = "Active High"; desc = "SPI2_CSN active high"; };
        };

        field {
            name = "spi2_cs_pctrl";
            desc = "SPI2 chip-select polarity control. 0: SPI2_CSN active low, 1: SPI2_CSN active high.";
            sw = rw;
            hw = r;
            encode = MISC_CTRL0_spi2_cs_pctrl_enum;
            reset = 0x0;
        } spi2_cs_pctrl[5:5];

        enum MISC_CTRL0_spi1_cs1_pctrl_enum {
            ACTIVE_LOW = 0 { name = "Active Low"; desc = "SPI1_CSN1 active low"; };
            ACTIVE_HIGH = 1 { name = "Active High"; desc = "SPI1_CSN1 active high"; };
        };

        field {
            name = "spi1_cs1_pctrl";
            desc = "SPI1 chip-select 1 polarity control. 0: SPI1_CSN1 active low, 1: SPI1_CSN1 active high.";
            sw = rw;
            hw = r;
            encode = MISC_CTRL0_spi1_cs1_pctrl_enum;
            reset = 0x0;
        } spi1_cs1_pctrl[4:4];

        enum MISC_CTRL0_spi1_cs0_pctrl_enum {
            ACTIVE_LOW = 0 { name = "Active Low"; desc = "SPI1_CSN0 active low"; };
            ACTIVE_HIGH = 1 { name = "Active High"; desc = "SPI1_CSN0 active high"; };
        };

        field {
            name = "spi1_cs0_pctrl";
            desc = "SPI1 chip-select 0 polarity control. 0: SPI1_CSN0 active low, 1: SPI1_CSN0 active high.";
            sw = rw;
            hw = r;
            encode = MISC_CTRL0_spi1_cs0_pctrl_enum;
            reset = 0x0;
        } spi1_cs0_pctrl[3:3];

        enum MISC_CTRL0_ssp1_cs_sel_enum {
            SPI1_CSN0 = 0 { name = "Spi1 Csn0"; desc = "SPI1_CSN0"; };
            SPI1_CSN1 = 1 { name = "Spi1 Csn1"; desc = "SPI1_CSN1"; };
        };

        field {
            name = "ssp1_cs_sel";
            desc = "SPI1 output chip-select selection. 0: SPI1_CSN0, 1: SPI1_CSN1.";
            sw = rw;
            hw = r;
            encode = MISC_CTRL0_ssp1_cs_sel_enum;
            reset = 0x0;
        } ssp1_cs_sel[2:2];

        enum MISC_CTRL0_spi_3wire_cs_pctrl_enum {
            ACTIVE_LOW = 0 { name = "Active Low"; desc = "SPI_3LINE_CSN active low"; };
            ACTIVE_HIGH = 1 { name = "Active High"; desc = "SPI_3LINE_CSN active high"; };
        };

        field {
            name = "spi_3wire_cs_pctrl";
            desc = "3WIRE SPI chip-select polarity control. 0: SPI_3LINE_CSN active low, 1: SPI_3LINE_CSN active high.";
            sw = rw;
            hw = r;
            encode = MISC_CTRL0_spi_3wire_cs_pctrl_enum;
            reset = 0x0;
        } spi_3wire_cs_pctrl[1:1];

        enum MISC_CTRL0_spi0_cs_pctrl_enum {
            ACTIVE_LOW = 0 { name = "Active Low"; desc = "SPI0_CSN active low"; };
            ACTIVE_HIGH = 1 { name = "Active High"; desc = "SPI0_CSN active high"; };
        };

        field {
            name = "spi0_cs_pctrl";
            desc = "SPI0 chip-select polarity control. 0: SPI0_CSN active low, 1: SPI0_CSN active high.";
            sw = rw;
            hw = r;
            encode = MISC_CTRL0_spi0_cs_pctrl_enum;
            reset = 0x0;
        } spi0_cs_pctrl[0:0];
    } MISC_CTRL0 @ 0x0;

    reg {
        name = "MISC function select register 1";
        desc = "MISC function select register 1.

SDIO0 PowerSwitch control: when sdio0_pswitch_ctrl_sel = 1 the MISC register bits drive the voltage switch instead of the SDIO0 controller.

Data sheet 3.5.5 MISC_CTRL1 (offset 0x4, printed page 3-72, `hi3516av300--Hi3516AV300-Datasheet.txt` line 10911).";

        enum MISC_CTRL1_sdio0_pswitch_ctrl_sel_enum {
            SDIO0_CONTROLLER = 0 { name = "Sdio0 Controller"; desc = "Controlled by the SDIO0 controller"; };
            MISC_REGISTERS = 1 { name = "Misc Registers"; desc = "Controlled by the MISC registers"; };
        };

        field {
            name = "sdio0_pswitch_ctrl_sel";
            desc = "SDIO0 PowerSwitch control select. 0: controlled by the SDIO0 controller, 1: controlled by the MISC registers.";
            sw = rw;
            hw = r;
            encode = MISC_CTRL1_sdio0_pswitch_ctrl_sel_enum;
            reset = 0x0;
        } sdio0_pswitch_ctrl_sel[2:2];

        enum MISC_CTRL1_sdio0_pswitch_sel_enum {
            V3P3 = 0 { name = "V3P3"; desc = "3.3 V"; };
            V1P8 = 1 { name = "V1P8"; desc = "1.8 V"; };
        };

        field {
            name = "sdio0_pswitch_sel";
            desc = "SDIO0 PowerSwitch output voltage select. 0: 3.3 V, 1: 1.8 V.";
            sw = rw;
            hw = r;
            encode = MISC_CTRL1_sdio0_pswitch_sel_enum;
            reset = 0x0;
        } sdio0_pswitch_sel[1:1];

        enum MISC_CTRL1_sdio0_pswitch_en_enum {
            DISABLED = 0 { name = "Disabled"; desc = "SDIO0 PowerSwitch disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "SDIO0 PowerSwitch enabled"; };
        };

        field {
            name = "sdio0_pswitch_en";
            desc = "SDIO0 PowerSwitch enable. Only effective when sdio0_pswitch_ctrl_sel is 1. 0: SDIO0 PowerSwitch disabled, 1: SDIO0 PowerSwitch enabled.";
            sw = rw;
            hw = r;
            encode = MISC_CTRL1_sdio0_pswitch_en_enum;
            reset = 0x0;
        } sdio0_pswitch_en[0:0];
    } MISC_CTRL1 @ 0x4;

    reg {
        name = "CPU control register 1";
        desc = "CPU control register 1.

Read-only Cortex-A7 status: SMP/AMP mode and WFI/WFE state of the two cores and of L2.

Data sheet 3.5.5 MISC_CTRL3 (offset 0xC, printed page 3-73, `hi3516av300--Hi3516AV300-Datasheet.txt` line 10945).";

        field {
            name = "a7_smpnamp";
            desc = "Indicates whether A7 CORE0/CORE1 are in SMP (Symmetric MultiProcessing) or AMP (Asymmetric MultiProcessing) mode. Bit 0 (reg bit 5) is CORE0 and bit 1 (reg bit 6) is CORE1; high means SMP mode, low means AMP mode.";
            sw = r;
            hw = w;
            reset = 0x0;
        } a7_smpnamp[6:5];

        enum MISC_CTRL3_a7_standbywfi_l2_enum {
            NOT_IN_WFI = 0 { name = "Not In Wfi"; desc = "Not in WFI low-power state"; };
            IN_WFI = 1 { name = "In Wfi"; desc = "In WFI low-power state"; };
        };

        field {
            name = "a7_standbywfi_l2";
            desc = "A7 L2 WFI low-power state indication. 0: not in WFI low-power state, 1: in WFI low-power state.";
            sw = r;
            hw = w;
            encode = MISC_CTRL3_a7_standbywfi_l2_enum;
            reset = 0x0;
        } a7_standbywfi_l2[4:4];

        field {
            name = "a7_standbywfi";
            desc = "A7 CORE0/CORE1 WFI low-power state indication. Bit 0 (reg bit 2) is CORE0 and bit 1 (reg bit 3) is CORE1; high means the core is in the WFI low-power state.";
            sw = r;
            hw = w;
            reset = 0x0;
        } a7_standbywfi[3:2];

        field {
            name = "a7_standbywfe";
            desc = "A7 CORE0/CORE1 WFE low-power state indication. Bit 0 (reg bit 0) is CORE0 and bit 1 (reg bit 1) is CORE1; high means the core is in the WFE low-power state.";
            sw = r;
            hw = w;
            reset = 0x0;
        } a7_standbywfe[1:0];
    } MISC_CTRL3 @ 0xC;

    reg {
        name = "RAM Retention control register 0";
        desc = "RAM Retention control register 0.

Reset 0xD: gzip_ram_clk_gate_en_bypass = 1, vedu_ret1n_bypass = 1, spacc_ret1n = 1, bootrom_pgen = 0 (BOOTROM powered).

Data sheet 3.5.5 MISC_CTRL4 (offset 0x10, printed page 3-74, `hi3516av300--Hi3516AV300-Datasheet.txt` line 11001).";

        enum MISC_CTRL4_gzip_ram_clk_gate_en_bypass_enum {
            AUTO_GATING_ON = 0 { name = "Auto Gating On"; desc = "Automatic clock gating enabled"; };
            AUTO_GATING_OFF = 1 { name = "Auto Gating Off"; desc = "Automatic clock gating disabled; the GZIP RAM clock is always on"; };
        };

        field {
            name = "gzip_ram_clk_gate_en_bypass";
            desc = "Automatic clock gating control of the RAM inside the GZIP module. 0: automatic clock gating enabled, 1: automatic clock gating disabled; the GZIP RAM clock is always on.";
            sw = rw;
            hw = r;
            encode = MISC_CTRL4_gzip_ram_clk_gate_en_bypass_enum;
            reset = 0x1;
        } gzip_ram_clk_gate_en_bypass[3:3];

        enum MISC_CTRL4_vedu_ret1n_bypass_enum {
            AUTO_RETENTION_ON = 0 { name = "Auto Retention On"; desc = "VEDU RAM automatic Retention enabled"; };
            AUTO_RETENTION_OFF = 1 { name = "Auto Retention Off"; desc = "VEDU RAM automatic Retention disabled"; };
        };

        field {
            name = "vedu_ret1n_bypass";
            desc = "Automatic RAM Retention function control of the VEDU module. 0: VEDU RAM automatic Retention enabled, 1: VEDU RAM automatic Retention disabled.";
            sw = rw;
            hw = r;
            encode = MISC_CTRL4_vedu_ret1n_bypass_enum;
            reset = 0x1;
        } vedu_ret1n_bypass[2:2];

        enum MISC_CTRL4_bootrom_pgen_enum {
            POWERED_ON = 0 { name = "Powered On"; desc = "BOOTROM powered on"; };
            POWERED_OFF = 1 { name = "Powered Off"; desc = "BOOTROM powered off; it cannot work"; };
        };

        field {
            name = "bootrom_pgen";
            desc = "BOOTROM power supply control. 0: BOOTROM powered on, 1: BOOTROM powered off; it cannot work.";
            sw = rw;
            hw = r;
            encode = MISC_CTRL4_bootrom_pgen_enum;
            reset = 0x0;
        } bootrom_pgen[1:1];

        enum MISC_CTRL4_spacc_ret1n_enum {
            RETENTION = 0 { name = "Retention"; desc = "SPACC RAM in Retention state"; };
            ACTIVE = 1 { name = "Active"; desc = "SPACC RAM in Active state"; };
        };

        field {
            name = "spacc_ret1n";
            desc = "RAM Retention control of the SPACC. The bit can be set to 0 to save power while the SPACC controller is not enabled. 0: SPACC RAM in Retention state, 1: SPACC RAM in Active state.";
            sw = rw;
            hw = r;
            encode = MISC_CTRL4_spacc_ret1n_enum;
            reset = 0x1;
        } spacc_ret1n[0:0];
    } MISC_CTRL4 @ 0x10;

    reg {
        name = "VICAP/VDP mode control register 1";
        desc = "VICAP/VDP mode control register 1.

Data path mode selects of the video chain (VICAP -> VIPROC -> VPSS online/offline), the VDP parallel output mode and the MIPI RX channel work modes. Use together with PERI_CRG42/PERI_CRG63.

Data sheet 3.5.5 MISC_CTRL6 (offset 0x18, printed page 3-74, `hi3516av300--Hi3516AV300-Datasheet.txt` line 11046).";

        enum MISC_CTRL6_vo_pdata_reverse_enum {
            DISABLED = 0 { name = "Disabled"; desc = "Disabled"; };
            ENABLED = 1 { name = "Enabled"; desc = "Enabled"; };
        };

        field {
            name = "vo_pdata_reverse";
            desc = "VDP parallel output bit-reversal enable. 0: disabled, 1: enabled.";
            sw = rw;
            hw = r;
            encode = MISC_CTRL6_vo_pdata_reverse_enum;
            reset = 0x0;
        } vo_pdata_reverse[11:11];

        enum MISC_CTRL6_vo_pdata_mode_enum {
            LCD_PARALLEL_24BIT_MODE = 0 { name = "Lcd Parallel 24Bit Mode"; desc = "LCD parallel 24-bit mode"; };
            LCD_PARALLEL_18BIT_MODE = 1 { name = "Lcd Parallel 18Bit Mode"; desc = "LCD parallel 18-bit mode"; };
            LCD_PARALLEL_16BIT_MODE = 2 { name = "Lcd Parallel 16Bit Mode"; desc = "LCD parallel 16-bit mode"; };
            LCD_SERIAL_8BIT_MODE = 3 { name = "Lcd Serial 8Bit Mode"; desc = "LCD serial 8-bit mode"; };
            LCD_SERIAL_6BIT_MODE = 4 { name = "Lcd Serial 6Bit Mode"; desc = "LCD serial 6-bit mode"; };
            BT1120_MODE = 5 { name = "Bt1120 Mode"; desc = "BT.1120 mode"; };
            BT656_MODE = 6 { name = "Bt656 Mode"; desc = "BT.656 mode"; };
            RESERVED_7 = 7 { name = "Reserved 7"; desc = "Reserved"; };
        };

        field {
            name = "vo_pdata_mode";
            desc = "VDP parallel port output mode select. Other values are reserved.";
            sw = rw;
            hw = r;
            encode = MISC_CTRL6_vo_pdata_mode_enum;
            reset = 0x0;
        } vo_pdata_mode[10:8];

        enum MISC_CTRL6_viproc_vpss_online_mode_enum {
            OFFLINE = 0 { name = "Offline"; desc = "Offline mode"; };
            ONLINE = 1 { name = "Online"; desc = "Online mode"; };
        };

        field {
