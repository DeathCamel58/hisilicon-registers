            name = "free_pwm_duty";
            desc = "Number of PWM high-level beats for the FREE PWM output. If the value is greater than or equal to the number of PWM cycles, the output level is always high.";
            sw = rw; hw = r;
            reset = 0x12;
        } free_pwm_duty[31:16];
        field {
            name = "free_pwm_period";
            desc = "Number of PWM cycles for the FREE PWM output.";
            sw = rw; hw = r;
            reset = 0x78;
        } free_pwm_period[15:0];
    } PERI_PMC2 @ 0x8;
    reg {
        name = "PERI_PMC4";
        desc = "PERI_PMC4 (offset 0x10, total reset 0x00002400; PROVEN: Hi3536D V100 data sheet).";
        field {
            name = "reserved_31_6";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x90;
        } reserved_31_6[31:6];
        field {
            name = "free_pwm_inv";
            desc = "PWM phase control for the FREE PWM output 0: normal output 1: inverted output";
            sw = rw; hw = r;
            reset = 0x0;
        } free_pwm_inv[5:5];
        field {
            name = "free_pwm_enable";
            desc = "PWM enable control for the FREE PWM output 0: disabled 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } free_pwm_enable[4:4];
        field {
            name = "cpu_pwm_inv";
            desc = "PWM phase control for the CPU AVS output 0: normal output 1: inverted output";
            sw = rw; hw = r;
            reset = 0x0;
        } cpu_pwm_inv[3:3];
        field {
            name = "cpu_pwm_enable";
            desc = "PWM enable for the CPU AVS output 0: disabled 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } cpu_pwm_enable[2:2];
        field {
            name = "core_pwm_inv";
            desc = "PWM phase control for the core AVS output 0: normal output 1: inverted output";
            sw = rw; hw = r;
            reset = 0x0;
        } core_pwm_inv[1:1];
        field {
            name = "core_pwm_enable";
            desc = "PWM enable for the core AVS output 0: disabled 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } core_pwm_enable[0:0];
    } PERI_PMC4 @ 0x10;
    reg {
