`ifndef HI3536D_PMC_RDL
`define HI3536D_PMC_RDL
regfile eHI3536D_PMC {
    name = "Power management control (PMC / PWM + HPM) registers, Hi3536D V100";
    desc = "Power management control (PMC / PWM + HPM) registers of the Hi3536D V100 at base 0x120E0000. 21 registers extracted programmatically from the Hi3536D V100 data sheet (Issue 00B04, 2017-12-13, Table 3-21), register descriptions and field tables; reset values are the data sheet total reset values split onto the fields. Source: dl/research-hi3536 ReleaseDoc (unofficial copy of the HiSilicon SDK documentation; facts only). Field names, bit ranges, access types and reset values are exact; the free-text descriptions are attributed to fields from the PDF text layout (title sentence above the bit row, enumerations below) and can be shifted by one field where a sentence wraps: check the data sheet page when a description matters. Hardware not yet verified (no Hi3536D board on the bench).";
    reg {
        name = "PERI_PMC0";
        desc = "PERI_PMC0 is a core AVS PWM configuration register. (offset 0x0, total reset 0x00120078; PROVEN: Hi3536D V100 data sheet).";
        field {
            name = "core_pwm_duty";
            desc = "Number of PWM high-level beats for the core AVS output. If the value is greater than or equal to the number of PWM cycles, the output level is always high.";
            sw = rw; hw = r;
            reset = 0x12;
        } core_pwm_duty[31:16];
        field {
            name = "core_pwm_period";
            desc = "Number of PWM cycles for the core AVS output..";
            sw = rw; hw = r;
            reset = 0x78;
        } core_pwm_period[15:0];
    } PERI_PMC0 @ 0x0;
    reg {
        name = "PERI_PMC1";
        desc = "PERI_PMC1 (offset 0x4, total reset 0x00120078; PROVEN: Hi3536D V100 data sheet).";
        field {
            name = "cpu_pwm_duty";
            desc = "Number of PWM high-level beats for the CPU AVS output. If the value is greater than or equal to the number of PWM cycles, the output level is always high.";
            sw = rw; hw = r;
            reset = 0x12;
        } cpu_pwm_duty[31:16];
        field {
            name = "cpu_pwm_period";
            desc = "Number of PWM cycles for the CPU AVS output.";
            sw = rw; hw = r;
            reset = 0x78;
        } cpu_pwm_period[15:0];
    } PERI_PMC1 @ 0x4;
    reg {
        name = "PERI_PMC2";
        desc = "PERI_PMC2 is a FREE PWM configuration register. (offset 0x8, total reset 0x00120078; PROVEN: Hi3536D V100 data sheet).";
