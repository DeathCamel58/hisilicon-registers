regfile eHI3536D_VDH_SLICEMSG {
    name = "VDH HEVC slice message (DDR, NOT registers), Hi3536D V100";
    desc = "NOT A REGISTER FILE: layout of one 64-word slice message slot (burst 0), chained through D63 (next slot address). Followed by burst 1/2 (words 64-191) with the explicit weighted-prediction tables when (weighted_pred_flag and P slice) or (weighted_bipred_flag and B slice): burst 1 D0-D15 luma list0, D16-D31 luma list1; burst 2 D0-D15 chroma Cb list0, D16-D31 Cb list1, D32-D47 Cr list0, D48-D63 Cr list1; luma/Cb word = offset[7:0] << 12 | weight[8:0] << 3 | log2_denom[2:0]; Cr word = offset[7:0] << 9 | weight[8:0]. Positions: GPL Kirin V400R004 source, checked in the Hi3536D module by the stored word offsets (1-14, 23, 24, 43, 44, 63) and the D6/D7/D12 shift constants (27, 18; 28, 24, 20, 16, 15, 14, 8, 2; 16, 3, 1). R001 additionally writes D24 = 0.";
    reg {
        name = "D0/D3 stream segment 0 byte offset";
        desc = "D0/D3 stream segment 0 byte offset Stream conventions (M7): the hardware does NOT remove the 00 00 03 emulation prevention bytes, the stream it reads must not have them (PROVEN on the board 2026-11-23: a slice with a 00 00 03 inside decodes wrong and exact once the 03 byte is removed, HEVC and H.264; board run 2: escape bytes in the slice header and behind the data exact too, so the software copies the NAL unit without them and counts the offset and the lengths in the copy); the byte offset is of the 16-byte chunk holding the first slice-data bit, relative to STREAM_BASE_ADDR & ~0xF; STREAM_BASE_ADDR is & ~0xF of the lowest segment address of the picture (vendor, PROVEN dynamic: bytespos 0x81000123, base 0x81000007 gives D0 = 0x120). HEVC: slice data starts after slice_segment_header and byte_alignment(). Provenance: PROVEN (word offsets). Source: HEVCHAL_V400R004_SetPicMsg / SetSliceMsg (GPL Kirin source); shift constants and stored word offsets of HEVCHAL_V400R001_SetPicMsg / SetSliceMsg (hi3536dv100_vfmw.ko) agree.";
        field {
            name = "byte_offset";
            desc = " (stream_start & ~0xF) - (stream_base & ~0xF) of segment i; segment 1 is D3-D5 [INFERRED]";
            sw = rw;
            hw = r;
        } byte_offset[31:0];
    } D0 @ 0x0;

    reg {
        name = "D1 bit offset segment 0";
        desc = "D1 bit offset segment 0 Bit position of the first slice-data bit in the 16-byte chunk: (bitsoffset + 8 * bytespos) & 0x7F (PROVEN dynamic: bitsoffset 5 gives D1 = 0x1d with the example above). Provenance: INFERRED. Source: HEVCHAL_V400R004_SetPicMsg / SetSliceMsg (GPL Kirin source); shift constants and stored word offsets of HEVCHAL_V400R001_SetPicMsg / SetSliceMsg (hi3536dv100_vfmw.ko) agree.";
        field {
            name = "bit_offset";
            desc = "(bitsoffset + 8 x (bytespos & 0xF)) & 0x7F [INFERRED]";
            sw = rw;
            hw = r;
        } bit_offset[6:0];
        field {
            name = "reserved_31_7";
            desc = " [INFERRED]";
            sw = r;
            hw = r;
        } reserved_31_7[31:7];
    } D1 @ 0x4;

    reg {
        name = "D2 valid bit length segment 0";
        desc = "D2 valid bit length segment 0 Bits from the first slice-data bit to the end of the data in the stream the hardware reads (the NAL unit without its emulation prevention bytes), counted INCLUDING the rbsp_stop_one_bit for HEVC and H.264 CABAC; H.264 CAVLC does not count it; trailing zero bytes (cabac_zero_words, after the stripping) are not counted. PROVEN on the board 2026-11-23: HEVC with the stop bit gives VDH_STATE 0x00020001 and an exact picture, a count without it (or off by 1, 8 or 32) sets the error flag (the output stays exact for 0 and -1); H.264 CABAC and CAVLC exact with the counts above, +-1 flags an error and -1 also corrupts the picture. Board run 2: several slices (HEVC segments, H.264 slices) in one picture each have their own D0..D2, all exact. The vendor code (HEVC_FindTrailZeros 0x3b8ac, HEVC_CalcStreamBits 0x33b14, CalcStreamBits 0x1f83c) was read as excluding the HEVC stop bit: that reading was wrong. Segment 1 (D3-D5) exists for ring-buffer wrap only. Entry point offsets are NOT passed (no message word depends on them, M9; a wavefront stream decoded exact without them). The stream buffer needs a readable tail past the last byte: no margin in the vendor code, the hardware reads 16-byte units (GUESS: keep >= 128 bytes; a 0xFF fill instead of zeros changed nothing, a smaller margin was not tried). Provenance: PROVEN (stop bit rule, conventions), GUESS (tail margin). Source: HEVCHAL_V400R004_SetPicMsg / SetSliceMsg (GPL Kirin source); shift constants and stored word offsets of HEVCHAL_V400R001_SetPicMsg / SetSliceMsg (hi3536dv100_vfmw.ko) agree.";
        field {
            name = "valid_bitlen";
            desc = "bits of slice data in this segment [INFERRED]";
            sw = rw;
            hw = r;
        } valid_bitlen[31:0];
    } D2 @ 0x8;

    reg {
        name = "D6 slice control";
        desc = "D6 slice control Provenance: PROVEN (shift constants). Source: HEVCHAL_V400R004_SetPicMsg / SetSliceMsg (GPL Kirin source); shift constants and stored word offsets of HEVCHAL_V400R001_SetPicMsg / SetSliceMsg (hi3536dv100_vfmw.ko) agree.";
        field {
            name = "independent_slice_segment_addr";
            desc = " [INFERRED]";
            sw = rw;
            hw = r;
        } independent_slice_segment_addr[17:0];
        field {
            name = "cabac_init_flag";
            desc = " [INFERRED]";
            sw = rw;
            hw = r;
        } cabac_init_flag[18:18];
        field {
            name = "slice_qp_y";
            desc = "SliceQpY & 0x3F [INFERRED]";
            sw = rw;
            hw = r;
        } slice_qp_y[24:19];
        field {
            name = "dependent_slice_segment_flag";
            desc = " [INFERRED]";
            sw = rw;
            hw = r;
        } dependent_slice_segment_flag[26:26];
        field {
            name = "is_low_delay";
            desc = " [INFERRED]";
            sw = rw;
            hw = r;
        } is_low_delay[27:27];
    } D6 @ 0x18;

    reg {
        name = "D7 slice reference setup";
        desc = "D7 slice reference setup Provenance: PROVEN (shift constants). Source: HEVCHAL_V400R004_SetPicMsg / SetSliceMsg (GPL Kirin source); shift constants and stored word offsets of HEVCHAL_V400R001_SetPicMsg / SetSliceMsg (hi3536dv100_vfmw.ko) agree.";
        field {
            name = "slice_type_for_pmv";
            desc = "s_SliceTypeForPMV[SliceType] [INFERRED]";
            sw = rw;
            hw = r;
        } slice_type_for_pmv[1:0];
        field {
            name = "list0_size";
            desc = "listXsize[0] [INFERRED]";
            sw = rw;
            hw = r;
        } list0_size[7:2];
        field {
            name = "list1_size";
            desc = "listXsize[1] [INFERRED]";
            sw = rw;
            hw = r;
        } list1_size[13:8];
        field {
            name = "mvd_l1_zero_flag";
            desc = " [INFERRED]";
            sw = rw;
            hw = r;
        } mvd_l1_zero_flag[14:14];
        field {
            name = "slice_temporal_mvp_enabled_flag";
            desc = " [INFERRED]";
            sw = rw;
            hw = r;
        } slice_temporal_mvp_enabled_flag[15:15];
        field {
            name = "num_ref_idx_l0_active_minus1";
            desc = " [INFERRED]";
            sw = rw;
            hw = r;
        } num_ref_idx_l0_active_minus1[19:16];
        field {
            name = "num_ref_idx_l1_active_minus1";
            desc = " [INFERRED]";
            sw = rw;
            hw = r;
        } num_ref_idx_l1_active_minus1[23:20];
        field {
            name = "max_num_merge_cand";
            desc = " [INFERRED]";
            sw = rw;
            hw = r;
        } max_num_merge_cand[26:24];
        field {
            name = "collocated_from_l0_flag";
            desc = " [INFERRED]";
            sw = rw;
            hw = r;
        } collocated_from_l0_flag[27:27];
        field {
            name = "col_pic_apc";
            desc = " [INFERRED]";
            sw = rw;
            hw = r;
        } col_pic_apc[31:28];
    } D7 @ 0x1C;

    reg {
        name = "D8 slice segment address (CTB raster)";
        desc = "D8 slice segment address (CTB raster) Provenance: PROVEN (word offset). Source: HEVCHAL_V400R004_SetPicMsg / SetSliceMsg (GPL Kirin source); shift constants and stored word offsets of HEVCHAL_V400R001_SetPicMsg / SetSliceMsg (hi3536dv100_vfmw.ko) agree.";
        field {
            name = "slice_segment_address";
            desc = "first CTB of the slice segment [INFERRED]";
            sw = rw;
            hw = r;
        } slice_segment_address[31:0];
    } D8 @ 0x20;

    reg {
        name = "D9 slice start x/y";
        desc = "D9 slice start x/y Provenance: INFERRED. Source: HEVCHAL_V400R004_SetPicMsg / SetSliceMsg (GPL Kirin source); shift constants and stored word offsets of HEVCHAL_V400R001_SetPicMsg / SetSliceMsg (hi3536dv100_vfmw.ko) agree.";
        field {
            name = "x";
            desc = "address % width in CTBs [INFERRED]";
            sw = rw;
            hw = r;
        } x[15:0];
        field {
            name = "y";
            desc = "address / width [INFERRED]";
            sw = rw;
            hw = r;
        } y[31:16];
    } D9 @ 0x24;

    reg {
        name = "D10 slice segment tile address";
        desc = "D10 slice segment tile address Provenance: INFERRED. Source: HEVCHAL_V400R004_SetPicMsg / SetSliceMsg (GPL Kirin source); shift constants and stored word offsets of HEVCHAL_V400R001_SetPicMsg / SetSliceMsg (hi3536dv100_vfmw.ko) agree.";
        field {
            name = "slice_segment_tile_address";
            desc = "tile-scan address [INFERRED]";
            sw = rw;
            hw = r;
        } slice_segment_tile_address[31:0];
    } D10 @ 0x28;

    reg {
        name = "D11 chroma QP offsets";
        desc = "D11 chroma QP offsets Provenance: INFERRED. Source: HEVCHAL_V400R004_SetPicMsg / SetSliceMsg (GPL Kirin source); shift constants and stored word offsets of HEVCHAL_V400R001_SetPicMsg / SetSliceMsg (hi3536dv100_vfmw.ko) agree.";
        field {
            name = "slice_cr_qp_offset";
            desc = " [INFERRED]";
            sw = rw;
            hw = r;
        } slice_cr_qp_offset[4:0];
        field {
            name = "slice_cb_qp_offset";
            desc = " [INFERRED]";
            sw = rw;
            hw = r;
        } slice_cb_qp_offset[12:8];
    } D11 @ 0x2C;

    reg {
        name = "D12 loop filter";
        desc = "D12 loop filter Provenance: PROVEN (shift constants). Source: HEVCHAL_V400R004_SetPicMsg / SetSliceMsg (GPL Kirin source); shift constants and stored word offsets of HEVCHAL_V400R001_SetPicMsg / SetSliceMsg (hi3536dv100_vfmw.ko) agree.";
        field {
            name = "slice_loop_filter_across_slices_enabled_flag";
            desc = " [INFERRED]";
            sw = rw;
            hw = r;
        } slice_loop_filter_across_slices_enabled_flag[0:0];
        field {
            name = "slice_deblocking_filter_disabled_flag";
            desc = " [INFERRED]";
            sw = rw;
            hw = r;
        } slice_deblocking_filter_disabled_flag[1:1];
        field {
            name = "slice_sao_chroma_flag";
            desc = " [INFERRED]";
            sw = rw;
            hw = r;
        } slice_sao_chroma_flag[2:2];
        field {
            name = "slice_sao_luma_flag";
            desc = " [INFERRED]";
            sw = rw;
            hw = r;
        } slice_sao_luma_flag[3:3];
        field {
            name = "slice_beta_offset_div2";
            desc = " [INFERRED]";
            sw = rw;
            hw = r;
        } slice_beta_offset_div2[11:8];
        field {
            name = "slice_tc_offset_div2";
            desc = " [INFERRED]";
            sw = rw;
            hw = r;
        } slice_tc_offset_div2[19:16];
    } D12 @ 0x30;

    reg {
        name = "D13 list0 long-term bits";
        desc = "D13 list0 long-term bits Provenance: INFERRED. Source: HEVCHAL_V400R004_SetPicMsg / SetSliceMsg (GPL Kirin source); shift constants and stored word offsets of HEVCHAL_V400R001_SetPicMsg / SetSliceMsg (hi3536dv100_vfmw.ko) agree.";
        field {
            name = "is_long_term_l0";
            desc = "bit i = entry i of list 0 is long-term [INFERRED]";
            sw = rw;
            hw = r;
        } is_long_term_l0[31:0];
    } D13 @ 0x34;

    reg {
        name = "D14 list1 long-term bits";
        desc = "D14 list1 long-term bits Provenance: INFERRED. Source: HEVCHAL_V400R004_SetPicMsg / SetSliceMsg (GPL Kirin source); shift constants and stored word offsets of HEVCHAL_V400R001_SetPicMsg / SetSliceMsg (hi3536dv100_vfmw.ko) agree.";
        field {
            name = "is_long_term_l1";
            desc = "bit i = entry i of list 1 is long-term [INFERRED]";
            sw = rw;
            hw = r;
        } is_long_term_l1[31:0];
    } D14 @ 0x38;

    reg {
        name = "D15-D16 list0 APC indices";
        desc = "D15-D16 list0 APC indices Provenance: INFERRED. Source: HEVCHAL_V400R004_SetPicMsg / SetSliceMsg (GPL Kirin source); shift constants and stored word offsets of HEVCHAL_V400R001_SetPicMsg / SetSliceMsg (hi3536dv100_vfmw.ko) agree.";
        field {
            name = "apc";
            desc = "4 bits per entry, 8 entries per word (D15, D16) [INFERRED]";
            sw = rw;
            hw = r;
        } apc[31:0];
    } D15 @ 0x3C;

    reg {
        name = "D17-D18 list1 APC indices";
        desc = "D17-D18 list1 APC indices Provenance: INFERRED. Source: HEVCHAL_V400R004_SetPicMsg / SetSliceMsg (GPL Kirin source); shift constants and stored word offsets of HEVCHAL_V400R001_SetPicMsg / SetSliceMsg (hi3536dv100_vfmw.ko) agree.";
        field {
            name = "apc";
            desc = "4 bits per entry, 8 entries per word (D17, D18) [INFERRED]";
            sw = rw;
            hw = r;
        } apc[31:0];
    } D17 @ 0x44;

    reg {
        name = "D23 collocated MV address (Apc2MvAddr)";
        desc = "D23 collocated MV address (Apc2MvAddr) Provenance: PROVEN (word offset). Source: HEVCHAL_V400R004_SetPicMsg / SetSliceMsg (GPL Kirin source); shift constants and stored word offsets of HEVCHAL_V400R001_SetPicMsg / SetSliceMsg (hi3536dv100_vfmw.ko) agree.";
        field {
            name = "apc2mvaddr";
            desc = " [INFERRED]";
            sw = rw;
            hw = r;
        } apc2mvaddr[31:0];
    } D23 @ 0x5C;

    reg {
        name = "D24 (R001 writes 0)";
        desc = "D24 (R001 writes 0) Provenance: PROVEN. Source: HEVCHAL_V400R001_SetSliceMsg (str to word 24).";
        field {
            name = "zero";
            desc = "written 0 by the Hi3536D module, not present in R004 [PROVEN]";
            sw = rw;
            hw = r;
        } zero[31:0];
    } D24 @ 0x60;

    reg {
        name = "D43 end CTB (raster)";
        desc = "D43 end CTB (raster) Provenance: PROVEN (word offset). Source: HEVCHAL_V400R004_SetPicMsg / SetSliceMsg (GPL Kirin source); shift constants and stored word offsets of HEVCHAL_V400R001_SetPicMsg / SetSliceMsg (hi3536dv100_vfmw.ko) agree.";
        field {
            name = "end_ctb_in_slice_raster";
            desc = " [INFERRED]";
            sw = rw;
            hw = r;
        } end_ctb_in_slice_raster[31:0];
    } D43 @ 0xAC;

    reg {
        name = "D44 end CTB (tile scan)";
        desc = "D44 end CTB (tile scan) Provenance: PROVEN (word offset). Source: HEVCHAL_V400R004_SetPicMsg / SetSliceMsg (GPL Kirin source); shift constants and stored word offsets of HEVCHAL_V400R001_SetPicMsg / SetSliceMsg (hi3536dv100_vfmw.ko) agree.";
        field {
            name = "end_ctb_in_slice_tile";
            desc = " [INFERRED]";
            sw = rw;
            hw = r;
        } end_ctb_in_slice_tile[31:0];
    } D44 @ 0xB0;

    reg {
        name = "D63 next slice message address";
        desc = "D63 next slice message address Provenance: PROVEN (word offset). Source: HEVCHAL_V400R004_SetPicMsg / SetSliceMsg (GPL Kirin source); shift constants and stored word offsets of HEVCHAL_V400R001_SetPicMsg / SetSliceMsg (hi3536dv100_vfmw.ko) agree.";
        field {
            name = "next_slice_msg_addr";
            desc = " [INFERRED]";
            sw = rw;
            hw = r;
        } next_slice_msg_addr[31:0];
    } D63 @ 0xFC;

};

regfile eHI3536D_VDH_UPMSG {
    name = "VDH up message (report) slice record (DDR, NOT registers), Hi3536D V100";
    desc = "NOT A REGISTER FILE: the VDH writes one 4-word record per decoded slice into the up message buffer (VAM_ADDR); the driver reads min(decoded_slice_num, 300) records (VDH_STATE[16:0]; R001: at most 300 slices = 4800 bytes = 1200 words, MakeDecReport 0x17a80 forces the count to 0 above 300 and ReadMsgSlot 0x1743c refuses more; R004: 200) and uses word 1 and 2 as the decoded macroblock/CTB range of each slice for error concealment: the R001 module uses only the low 16 bits of each (PROVEN, dynamic), word 3 is never read, word 0 only through the SED_STA copy (register 0x1000: [25:24] == 2 requests a whole-picture H.264 repair). Picture status is in VDH_STATE: bits [18:17] == 01 means decode over without error. Evidence: GPL V400R004 MakeDecReport; same record size 4 words for all standards on this generation (comment in the source: hi3531 uniform). Word 0 and 3 are only partly known. Record stride 16 bytes PROVEN (MakeDecReport add lsl #4).";
    reg {
        name = "W0 slice status";
        desc = "W0 slice status Provenance: INFERRED. Source: VDMHAL_V400R004_IMP_MakeDecReport / BackInfo (GPL Kirin source); R001 module: same VDH_STATE/SED_STA/SED_END0 reads in VDMHAL_V400R001_BackupInfo (offsets 0x1000, 0x1014, 0xB0-0xC0 seen).";
        field {
            name = "sed_status";
            desc = "low-delay mode: 00 no error, 10 stream end error, 01 data error, 11 reserved (R004 comment; the last slice record only) [INFERRED] BOARD 2026-11-23: W0 of a clean picture 0x14020000 (H.264) / 0x00020000 (HEVC) / 0x80430000 for a damaged HEVC picture; the flagged-but-exact H.264 CABAC pictures read 0x14230000 (bits 21 and 16 set).";
            sw = rw;
            hw = r;
        } sed_status[22:21];
        field {
            name = "sed_status_normal";
            desc = "normal mode: value 2 means the whole picture needs repair (H.264) [INFERRED]";
            sw = rw;
            hw = r;
        } sed_status_normal[25:24];
    } W0 @ 0x0;

    reg {
        name = "W1 slice start";
        desc = "W1 slice start Provenance: INFERRED. Source: VDMHAL_V400R004_IMP_MakeDecReport / BackInfo (GPL Kirin source); R001 module: same VDH_STATE/SED_STA/SED_END0 reads in VDMHAL_V400R001_BackupInfo (offsets 0x1000, 0x1014, 0xB0-0xC0 seen).";
        field {
            name = "start_mb";
            desc = "first macroblock/CTB of the slice [INFERRED]";
            sw = rw;
            hw = r;
        } start_mb[19:0];
    } W1 @ 0x4;

    reg {
        name = "W2 slice end";
        desc = "W2 slice end Provenance: INFERRED. Source: VDMHAL_V400R004_IMP_MakeDecReport / BackInfo (GPL Kirin source); R001 module: same VDH_STATE/SED_STA/SED_END0 reads in VDMHAL_V400R001_BackupInfo (offsets 0x1000, 0x1014, 0xB0-0xC0 seen).";
        field {
            name = "end_mb";
            desc = "last macroblock/CTB decoded (low-delay: bits [19:0] of the last record, word 2) [INFERRED]";
            sw = rw;
            hw = r;
        } end_mb[19:0];
    } W2 @ 0x8;

    reg {
        name = "W3 reserved/unknown";
        desc = "W3 reserved/unknown Provenance: GUESS. Source: VDMHAL_V400R004_IMP_MakeDecReport / BackInfo (GPL Kirin source); R001 module: same VDH_STATE/SED_STA/SED_END0 reads in VDMHAL_V400R001_BackupInfo (offsets 0x1000, 0x1014, 0xB0-0xC0 seen).";
        field {
            name = "unknown";
            desc = "not used by the driver [GUESS]";
            sw = rw;
            hw = r;
        } unknown[31:0];
    } W3 @ 0xC;

};

regfile eHI3536D_VDH_H264_PICMSG {
    name = "VDH H.264 picture message (DDR, NOT registers), Hi3536D V100";
    desc = "NOT A REGISTER FILE: layout of the H.264 picture message (D0-D63) plus scaling matrix burst 1 (words 64-119) the VFMW software builds for H264HAL_V400R001_SetPicMsg; the VDH reads it through AVM_ADDR. Offsets are word index x 4. All words PROVEN (differential run); names INFERRED (R004). Differences to R004: D1 is not rounded up by 0xF, D0 bit 31 has two extra vendor-struct conditions (flag at +0x388 and a non-null current PMV buffer). The scaling matrix word packing (bytes 1 and 2 swapped in 4x4 words, 8x8 words interleaved) is read from the instruction pattern of WritePicMsg 0x1cf84 and the R004 source and is INFERRED (not run).";

    reg {
        name = "D0 sequence flags and size";
        desc = "D0. Provenance: PROVEN. Source: hi3536dv100_vfmw.ko H264HAL_V400R001_SetPicMsg (0x2ac04) / SetSliceMsg (0x2ae80), word-checked statically and by a differential run of the vendor code in qemu-arm user mode on 2026-11-22 (what the code programs, not what silicon answers); names and shift constants agree with R004 vdm_hal_h264.c (GPL Kirin source), docs/research/vdh-hi3536d-static-analysis-2026-11-22.md.";
        field {
            name = "pic_width_in_mb_minus1";
            desc = "pic_width_in_mb - 1";
            sw = rw;
            hw = r;
        } pic_width_in_mb_minus1[8:0];
        field {
            name = "structure";
            desc = "structure code from g_StructTrans[pic_structure * 2 + mbaff] = {0, 3, 1, 1, 2, 2, 3, 3}";
            sw = rw;
            hw = r;
        } structure[15:14];
        field {
            name = "pic_height_in_mb_minus1";
            desc = "pic_height_in_mb - 1";
            sw = rw;
            hw = r;
        } pic_height_in_mb_minus1[24:16];
        field {
            name = "chroma_format_is_420";
            desc = "chroma_format_idc == 1";
            sw = rw;
            hw = r;
        } chroma_format_is_420[25:25];
        field {
            name = "constrained_intra_pred_flag";
            desc = "constrained_intra_pred_flag";
            sw = rw;
            hw = r;
        } constrained_intra_pred_flag[26:26];
        field {
            name = "entropy_coding_mode_flag";
            desc = "entropy_coding_mode_flag (1 = CABAC)";
            sw = rw;
            hw = r;
        } entropy_coding_mode_flag[27:27];
        field {
            name = "transform_8x8_mode_flag";
            desc = "transform_8x8_mode_flag";
            sw = rw;
            hw = r;
        } transform_8x8_mode_flag[28:28];
        field {
            name = "ref_pic_write_pmv";
            desc = "(nal_ref_idc != 0) and a vendor flag and a non-null current PMV buffer: write the PMV of this picture (INFERRED meaning)";
            sw = rw;
            hw = r;
        } ref_pic_write_pmv[31:31];
    } D0 @ 0x0;

    reg {
        name = "D1 current picture frame address";
