        field {
            name = "dec_cycleperpic";
            desc = "cycles [INFERRED]";
            sw = r;
            hw = r;
        } dec_cycleperpic[31:0];
    } DEC_CYCLEPERPIC @ 0xB0;

    reg {
        name = "Read bandwidth per picture";
        desc = "Counter (R004). Provenance: INFERRED. Source: Huawei Kirin GPL VDH V400R004 header vdm_hal_local.h (a later generation of the same VDH).";
        field {
            name = "rd_bdwidth_perpic";
            desc = "bytes [INFERRED]";
