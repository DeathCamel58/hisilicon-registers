    reg {
        name = "D36 APC to reference index map";
        desc = "D36-D43: 32 entries, 4 per word, 5 bits each at 5 * (i % 4). Provenance: PROVEN. Source: hi3536dv100_vfmw.ko H264HAL_V400R001_SetPicMsg (0x2ac04) / SetSliceMsg (0x2ae80), word-checked statically and by a differential run of the vendor code in qemu-arm user mode on 2026-11-22 (what the code programs, not what silicon answers); names and shift constants agree with R004 vdm_hal_h264.c (GPL Kirin source), docs/research/vdh-hi3536d-static-analysis-2026-11-22.md.";
        field {
            name = "apc_map";
            desc = "apc map word";
            sw = rw;
            hw = r;
        } apc_map[31:0];
    } D36[8] @ 0x90 += 0x4;

    reg {
        name = "D44 last macroblock";
        desc = "D44: last macroblock of the slice: the last_mb argument if a next slice exists, else (mbtodec - 1) / (1 + mbaff). Provenance: PROVEN. Source: hi3536dv100_vfmw.ko H264HAL_V400R001_SetPicMsg (0x2ac04) / SetSliceMsg (0x2ae80), word-checked statically and by a differential run of the vendor code in qemu-arm user mode on 2026-11-22 (what the code programs, not what silicon answers); names and shift constants agree with R004 vdm_hal_h264.c (GPL Kirin source), docs/research/vdh-hi3536d-static-analysis-2026-11-22.md.";
        field {
            name = "end_mb";
            desc = "last macroblock of the slice";
            sw = rw;
            hw = r;
        } end_mb[31:0];
    } D44 @ 0xB0;

    reg {
        name = "D63 next slice message address";
        desc = "D63: & ~0xF, 0 ends the chain. Provenance: PROVEN. Source: hi3536dv100_vfmw.ko H264HAL_V400R001_SetPicMsg (0x2ac04) / SetSliceMsg (0x2ae80), word-checked statically and by a differential run of the vendor code in qemu-arm user mode on 2026-11-22 (what the code programs, not what silicon answers); names and shift constants agree with R004 vdm_hal_h264.c (GPL Kirin source), docs/research/vdh-hi3536d-static-analysis-2026-11-22.md.";
        field {
            name = "next_slice_msg_addr";
            desc = "next slice message address";
            sw = rw;
            hw = r;
        } next_slice_msg_addr[31:0];
    } D63 @ 0xFC;

    reg {
        name = "W64 luma weight list0";
        desc = "Words 64-95: luma weight/offset list0 (i < 32): [19:12] offset (signed 8), [11:3] weight (9 bits), [2:0] log2 denominator. Weighted bursts exist only if (weighted_pred_flag and P) or (weighted_bipred_idc == 1 and B). Provenance: PROVEN. Source: hi3536dv100_vfmw.ko H264HAL_V400R001_SetPicMsg (0x2ac04) / SetSliceMsg (0x2ae80), word-checked statically and by a differential run of the vendor code in qemu-arm user mode on 2026-11-22 (what the code programs, not what silicon answers); names and shift constants agree with R004 vdm_hal_h264.c (GPL Kirin source), docs/research/vdh-hi3536d-static-analysis-2026-11-22.md.";
        field {
            name = "luma_l0";
            desc = "luma weight word";
            sw = rw;
            hw = r;
        } luma_l0[31:0];
    } W64[32] @ 0x100 += 0x4;

    reg {
        name = "W96 luma weight list1";
        desc = "Words 96-127: luma list1, same format. Provenance: PROVEN. Source: hi3536dv100_vfmw.ko H264HAL_V400R001_SetPicMsg (0x2ac04) / SetSliceMsg (0x2ae80), word-checked statically and by a differential run of the vendor code in qemu-arm user mode on 2026-11-22 (what the code programs, not what silicon answers); names and shift constants agree with R004 vdm_hal_h264.c (GPL Kirin source), docs/research/vdh-hi3536d-static-analysis-2026-11-22.md.";
        field {
            name = "luma_l1";
            desc = "luma weight word";
            sw = rw;
            hw = r;
        } luma_l1[31:0];
    } W96[32] @ 0x180 += 0x4;

    reg {
        name = "W128 Cb weight list0";
        desc = "Words 128-159: Cb list0, same format with the chroma denominator. Provenance: PROVEN. Source: hi3536dv100_vfmw.ko H264HAL_V400R001_SetPicMsg (0x2ac04) / SetSliceMsg (0x2ae80), word-checked statically and by a differential run of the vendor code in qemu-arm user mode on 2026-11-22 (what the code programs, not what silicon answers); names and shift constants agree with R004 vdm_hal_h264.c (GPL Kirin source), docs/research/vdh-hi3536d-static-analysis-2026-11-22.md.";
        field {
            name = "cb_l0";
            desc = "Cb weight word";
            sw = rw;
            hw = r;
        } cb_l0[31:0];
    } W128[32] @ 0x200 += 0x4;

    reg {
        name = "W160 Cb weight list1";
        desc = "Words 160-191: Cb list1. Provenance: PROVEN. Source: hi3536dv100_vfmw.ko H264HAL_V400R001_SetPicMsg (0x2ac04) / SetSliceMsg (0x2ae80), word-checked statically and by a differential run of the vendor code in qemu-arm user mode on 2026-11-22 (what the code programs, not what silicon answers); names and shift constants agree with R004 vdm_hal_h264.c (GPL Kirin source), docs/research/vdh-hi3536d-static-analysis-2026-11-22.md.";
        field {
            name = "cb_l1";
            desc = "Cb weight word";
            sw = rw;
            hw = r;
        } cb_l1[31:0];
    } W160[32] @ 0x280 += 0x4;

    reg {
        name = "W192 Cr weight list0";
        desc = "Words 192-223: Cr list0: [16:9] offset (signed 8), [8:0] weight (no denominator). Provenance: PROVEN. Source: hi3536dv100_vfmw.ko H264HAL_V400R001_SetPicMsg (0x2ac04) / SetSliceMsg (0x2ae80), word-checked statically and by a differential run of the vendor code in qemu-arm user mode on 2026-11-22 (what the code programs, not what silicon answers); names and shift constants agree with R004 vdm_hal_h264.c (GPL Kirin source), docs/research/vdh-hi3536d-static-analysis-2026-11-22.md.";
        field {
            name = "cr_l0";
            desc = "Cr weight word";
            sw = rw;
            hw = r;
        } cr_l0[31:0];
    } W192[32] @ 0x300 += 0x4;

    reg {
        name = "W224 Cr weight list1";
        desc = "Words 224-255: Cr list1. Provenance: PROVEN. Source: hi3536dv100_vfmw.ko H264HAL_V400R001_SetPicMsg (0x2ac04) / SetSliceMsg (0x2ae80), word-checked statically and by a differential run of the vendor code in qemu-arm user mode on 2026-11-22 (what the code programs, not what silicon answers); names and shift constants agree with R004 vdm_hal_h264.c (GPL Kirin source), docs/research/vdh-hi3536d-static-analysis-2026-11-22.md.";
        field {
            name = "cr_l1";
            desc = "Cr weight word";
            sw = rw;
            hw = r;
        } cr_l1[31:0];
    } W224[32] @ 0x380 += 0x4;

};

regfile eHI3536D_VDH_TILETAB {
    name = "VDH HEVC tile table (DDR, NOT registers), Hi3536D V100";
    desc = "NOT A REGISTER FILE: 298 words (1192 bytes) at the address in picture message D55, written for every picture by HEVC_WriteTileInfo, 16-byte aligned. Limits of this chip: at most 16 tile columns, 11 tile rows, 256 tile-id entries per direction (matches the vendor Logic limit messages). The tile-id entries are indexed in 16-pixel units, not CTBs (HEVC_CalcTileInfo of the Hi3536D module shifts the CTB position by log2(CTB size) - 4, disassembly 0x2d348 `sub r9, r9, #4`, 2026-11-23): 256 entries cover 4096 pixels. Entry point offsets are neither passed nor used (M9). Layout PROVEN (dynamic run); that the hardware uses TileId is INFERRED; the content for a picture without tiles is INFERRED from R004 HEVC_CalcTileInfo (not run).";

    reg {
        name = "TILEID_COL";
        desc = "Words 0-127: one byte per 16-pixel column unit j (byte j % 4 of word j / 4) = index of the tile column containing it (the CTB column position is multiplied by CTB size / 16: for a 64 pixel CTB every CTB column fills four bytes); only j <= 255 written (words 64-127 stay zero). Provenance: PROVEN. Source: hi3536dv100_vfmw.ko HEVC_WriteTileInfo (0x4059c), dynamic run of the vendor code in qemu-arm user mode on 2026-11-22 (what it programs, not what silicon answers), docs/research/vdh-hi3536d-static-analysis-2026-11-22.md.";
        field {
            name = "tileid_col_word";
            desc = "four tile column indices";
            sw = rw;
            hw = r;
        } tileid_col_word[31:0];
    } TILEID_COL[128] @ 0x0 += 0x4;

    reg {
        name = "TILEID_ROW";
        desc = "Words 128-255: one byte per 16-pixel row unit = tile row index (same unit and limit; words 192-255 stay zero). Provenance: PROVEN. Source: hi3536dv100_vfmw.ko HEVC_WriteTileInfo (0x4059c), dynamic run of the vendor code in qemu-arm user mode on 2026-11-22 (what it programs, not what silicon answers), docs/research/vdh-hi3536d-static-analysis-2026-11-22.md.";
        field {
            name = "tileid_row_word";
            desc = "four tile row indices";
            sw = rw;
            hw = r;
        } tileid_row_word[31:0];
    } TILEID_ROW[128] @ 0x200 += 0x4;

    reg {
        name = "TILEPOSX";
        desc = "Words 256-271: (last_ctb_column << 16) | first_ctb_column of tile column i (i < 16); words 272-275 zero. Provenance: PROVEN. Source: hi3536dv100_vfmw.ko HEVC_WriteTileInfo (0x4059c), dynamic run of the vendor code in qemu-arm user mode on 2026-11-22 (what it programs, not what silicon answers), docs/research/vdh-hi3536d-static-analysis-2026-11-22.md.";
        field {
            name = "first_ctb_col";
            desc = "first CTB column of the tile column";
            sw = rw;
            hw = r;
        } first_ctb_col[15:0];
        field {
            name = "last_ctb_col";
            desc = "last CTB column";
            sw = rw;
            hw = r;
        } last_ctb_col[31:16];
    } TILEPOSX[16] @ 0x400 += 0x4;

    reg {
        name = "TILEPOSY";
        desc = "Words 276-286: (last_ctb_row << 16) | first_ctb_row of tile row i (i < 11); words 287-297 zero. Provenance: PROVEN. Source: hi3536dv100_vfmw.ko HEVC_WriteTileInfo (0x4059c), dynamic run of the vendor code in qemu-arm user mode on 2026-11-22 (what it programs, not what silicon answers), docs/research/vdh-hi3536d-static-analysis-2026-11-22.md.";
        field {
            name = "first_ctb_row";
            desc = "first CTB row of the tile row";
            sw = rw;
            hw = r;
        } first_ctb_row[15:0];
        field {
            name = "last_ctb_row";
            desc = "last CTB row";
            sw = rw;
            hw = r;
        } last_ctb_row[31:16];
    } TILEPOSY[11] @ 0x450 += 0x4;

};

addrmap aHI3536D_VDH_MSG {
    name = "VDH DDR message layouts (placeholder window, NOT hardware)";
    desc = "Placeholder address 0x13210000 just past the VDH window (reserved in the data sheet): this only shows the DDR message layouts (HEVC and H.264 picture/slice, up message, HEVC tile table) in the register browser. The words live in the message pool in DDR, never at this address.";
    eHI3536D_VDH_PICMSG   PICMSG   @ 0x0;
    eHI3536D_VDH_SLICEMSG SLICEMSG @ 0x1000;
    eHI3536D_VDH_UPMSG    UPMSG    @ 0x2000;
    eHI3536D_VDH_H264_PICMSG   H264_PICMSG   @ 0x3000;
    eHI3536D_VDH_H264_SLICEMSG H264_SLICEMSG @ 0x4000;
    eHI3536D_VDH_TILETAB       TILETAB       @ 0x5000;
};

`endif
