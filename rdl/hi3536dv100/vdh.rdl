            desc = "first_mb_in_slice";
            sw = rw;
            hw = r;
        } first_mb_in_slice[19:0];
        field {
            name = "cabac_init_idc";
            desc = "cabac_init_idc & 3 (must be 0 for I slices: selects the (m,n) set, INFERRED)";
