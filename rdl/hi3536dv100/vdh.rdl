        field {
            name = "pic_height_luma";
            desc = " [INFERRED]";
            sw = rw;
            hw = r;
        } pic_height_luma[31:16];
    } D54 @ 0xD8;

    reg {
        name = "D55 tile info buffer address";
        desc = "D55 tile info buffer address 2048-byte region, 298 words used (eHI3536D_VDH_TILETAB), written for every picture. PROVEN. Provenance: PROVEN (word offset). Source: HEVCHAL_V400R004_SetPicMsg / SetSliceMsg (GPL Kirin source); shift constants and stored word offsets of HEVCHAL_V400R001_SetPicMsg / SetSliceMsg (hi3536dv100_vfmw.ko) agree.";
