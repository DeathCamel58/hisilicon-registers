            sw = rw;
            hw = r;
        } col_pmv_addr[31:0];
    } D8[2] @ 0x20 += 0x4;

    reg {
        name = "D10 weighting and chroma QP";
        desc = "D10. Provenance: PROVEN. Source: hi3536dv100_vfmw.ko H264HAL_V400R001_SetPicMsg (0x2ac04) / SetSliceMsg (0x2ae80), word-checked statically and by a differential run of the vendor code in qemu-arm user mode on 2026-11-22 (what the code programs, not what silicon answers); names and shift constants agree with R004 vdm_hal_h264.c (GPL Kirin source), docs/research/vdh-hi3536d-static-analysis-2026-11-22.md.";
        field {
            name = "second_chroma_qp_index_offset";
            desc = "second_chroma_qp_index_offset & 0x1F";
            sw = rw;
            hw = r;
        } second_chroma_qp_index_offset[4:0];
