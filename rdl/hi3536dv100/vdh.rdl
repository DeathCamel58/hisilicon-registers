            sw = rw;
            hw = r;
        } pcm_bit_depth_y[11:8];
        field {
            name = "pcm_bit_depth_c";
            desc = " [INFERRED]";
            sw = rw;
            hw = r;
        } pcm_bit_depth_c[15:12];
        field {
            name = "qp_bd_offset_y";
            desc = " [INFERRED]";
            sw = rw;
            hw = r;
        } qp_bd_offset_y[21:16];
        field {
            name = "qp_bd_offset_c";
            desc = " [INFERRED]";
            sw = rw;
            hw = r;
        } qp_bd_offset_c[27:22];
    } D3 @ 0xC;

    reg {
        name = "D4 SED top line buffer";
        desc = "D4 SED top line buffer R001 layout (HAL memory block, W = maximum picture width the context is configured for, A = ALIGN128(W)): size A, allocated only for W > 2048 (for W <= 2048 the vendor leaves a zero-size region and the address aliases the next one; EMAR_ID bit 16 is set for those pictures). PROVEN. Not the 256 B per column of R004: those constants are about 12x too large for this chip. Provenance: PROVEN (word offset). Source: HEVCHAL_V400R004_SetPicMsg / SetSliceMsg (GPL Kirin source); shift constants and stored word offsets of HEVCHAL_V400R001_SetPicMsg / SetSliceMsg (hi3536dv100_vfmw.ko) agree.";
        field {
            name = "sed_top_addr";
            desc = "physical address [INFERRED]";
            sw = rw;
            hw = r;
        } sed_top_addr[31:0];
    } D4 @ 0x10;

    reg {
        name = "D5 PMV top line buffer";
        desc = "D5 PMV top line buffer Size 3A (A = ALIGN128(W)), W > 2048 only (see D4). PROVEN. Provenance: PROVEN (word offset). Source: HEVCHAL_V400R004_SetPicMsg / SetSliceMsg (GPL Kirin source); shift constants and stored word offsets of HEVCHAL_V400R001_SetPicMsg / SetSliceMsg (hi3536dv100_vfmw.ko) agree.";
        field {
            name = "pmv_top_addr";
            desc = "physical address [INFERRED]";
            sw = rw;
            hw = r;
        } pmv_top_addr[31:0];
    } D5 @ 0x14;

    reg {
        name = "D6 PMV buffer of the current picture";
        desc = "D6 PMV buffer of the current picture Per-frame buffer: vdec.ko VDEC_DRV_UpdateFrameSize reserves ALIGN256(((W + 63) >> 4) * ((H + 63) >> 4) * 16) bytes per HEVC frame (139776 for 1080p; ArrangeMem reports a half-slot of ALIGN128(WMB*HMB*16)/2 = 130560, so allocate the vdec number), 16-byte aligned address. PROVEN formula. Provenance: PROVEN (word offset). Source: HEVCHAL_V400R004_SetPicMsg / SetSliceMsg (GPL Kirin source); shift constants and stored word offsets of HEVCHAL_V400R001_SetPicMsg / SetSliceMsg (hi3536dv100_vfmw.ko) agree.";
        field {
            name = "pmv_cur_addr";
            desc = "physical address [INFERRED]";
            sw = rw;
            hw = r;
        } pmv_cur_addr[31:0];
    } D6 @ 0x18;

    reg {
        name = "D7 RCN top line buffer";
        desc = "D7 RCN top line buffer Size 2.5A (A = ALIGN128(W)), W > 2048 only (see D4). PROVEN. Provenance: PROVEN (word offset). Source: HEVCHAL_V400R004_SetPicMsg / SetSliceMsg (GPL Kirin source); shift constants and stored word offsets of HEVCHAL_V400R001_SetPicMsg / SetSliceMsg (hi3536dv100_vfmw.ko) agree.";
        field {
            name = "rcn_top_addr";
            desc = "physical address [INFERRED]";
            sw = rw;
            hw = r;
