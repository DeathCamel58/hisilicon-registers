regfile eHI3536D_VDH_H264_SLICEMSG {
    name = "VDH H.264 slice message (DDR, NOT registers), Hi3536D V100";
    desc = "NOT A REGISTER FILE: one 64-word slice message per H.264 slice plus the weighted prediction bursts (words 64-255), chained by D63 (0 ends the chain), built by H264HAL_V400R001_SetSliceMsg. Equal to the R004 text word for word; unlike the Hi3520D generation D44 (last macroblock) is written in both branches. All positions PROVEN (static plus differential run); B/field-related words INFERRED.";

    reg {
        name = "D0 segment 0 byte offset";
        desc = "D0: (bytespos & ~0xF) - (STREAM_BASE_ADDR & ~0xF). D1[6:0] bit offset, D2 valid bit length (conventions: see eHI3536D_VDH_SLICEMSG). Provenance: PROVEN. Source: hi3536dv100_vfmw.ko H264HAL_V400R001_SetPicMsg (0x2ac04) / SetSliceMsg (0x2ae80), word-checked statically and by a differential run of the vendor code in qemu-arm user mode on 2026-11-22 (what the code programs, not what silicon answers); names and shift constants agree with R004 vdm_hal_h264.c (GPL Kirin source), docs/research/vdh-hi3536d-static-analysis-2026-11-22.md.";
        field {
            name = "byte_offset";
            desc = "segment 0 byte offset";
            sw = rw;
            hw = r;
        } byte_offset[31:0];
    } D0 @ 0x0;

    reg {
        name = "D1 segment 0 bit offset";
