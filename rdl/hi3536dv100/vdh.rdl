regfile eHI3536D_VDH_TOP {
    name = "VDH top / SCD glue registers (0x1320C000 window), Hi3536D V100";
    desc = "Four glue registers at the start of the SCD window (the SCD proper is eHISI_SCD at 0x1320C800). PROVEN offsets: hi3536dv100_vfmw.ko writes 0xC000 (VDMHAL_V400R001_PrepareDec: 1 when the standard code is 6 else 0), 0xC004 (WriteScdEMARID: 0x0481A1F7; HEVC CfgVdmReg also read-modify-writes bit 16 depending on picture width <= 4096, from R004 source), 0xC008 (PrepareDec: 1, only for VDH 0), 0xC00C (StartHwDecode, VDH id > 0 only). Names AVS_FLAG / EMAR_ID / VDH_SELRST / VDH_CK_GT follow the V400R004 documentation in docs/rdl-campaign/vdh-scd.md (INFERRED).";
    reg {
        name = "AVS flag";
        desc = "1 when the stream standard code is 6 (AVS), else 0. PROVEN offset and value. Provenance: PROVEN. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0).";
        field {
            name = "avs_flag";
            desc = "AVS mode [PROVEN]";
            sw = rw;
            hw = r;
        } avs_flag[0:0];
    } AVS_FLAG @ 0x0;

    reg {
        name = "AXI master ID / limits";
        desc = "PROVEN: VDMHAL_V400R001_WriteScdEMARID writes 0x0481A1F7; HEVC CfgVdmReg then sets/clears bit 16 by width (R004 source). Provenance: PROVEN. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0); Huawei Kirin GPL VDH V400R004 header vdm_hal_local.h (a later generation of the same VDH).";
        field {
            name = "emar_id";
            desc = "AXI master configuration word (fields unknown) [INFERRED]";
            sw = rw;
            hw = r;
        } emar_id[31:0];
    } EMAR_ID @ 0x4;

    reg {
        name = "VDH reset select";
        desc = "PROVEN: PrepareDec writes 1 for VDH 0. Provenance: PROVEN. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0).";
        field {
            name = "vdh_selrst";
            desc = "select [INFERRED]";
            sw = rw;
            hw = r;
        } vdh_selrst[0:0];
    } VDH_SELRST @ 0x8;

    reg {
        name = "VDH clock gate";
        desc = "Written 2 or 3 depending on the standard (only on the VDH1 path, never taken on this single-VDH chip). Provenance: INFERRED. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0).";
        field {
            name = "vdh_ck_gt";
            desc = "clock gating [INFERRED]";
            sw = rw;
            hw = r;
        } vdh_ck_gt[1:0];
    } VDH_CK_GT @ 0xC;

};

regfile eHI3536D_VDH_BPD {
