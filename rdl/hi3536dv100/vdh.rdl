regfile eHI3536D_VDH_SLICEMSG {
    name = "VDH HEVC slice message (DDR, NOT registers), Hi3536D V100";
    desc = "NOT A REGISTER FILE: layout of one 64-word slice message slot (burst 0), chained through D63 (next slot address). Followed by burst 1/2 (words 64-191) with the explicit weighted-prediction tables when (weighted_pred_flag and P slice) or (weighted_bipred_flag and B slice): burst 1 D0-D15 luma list0, D16-D31 luma list1; burst 2 D0-D15 chroma Cb list0, D16-D31 Cb list1, D32-D47 Cr list0, D48-D63 Cr list1; luma/Cb word = offset[7:0] << 12 | weight[8:0] << 3 | log2_denom[2:0]; Cr word = offset[7:0] << 9 | weight[8:0]. Positions: GPL Kirin V400R004 source, checked in the Hi3536D module by the stored word offsets (1-14, 23, 24, 43, 44, 63) and the D6/D7/D12 shift constants (27, 18; 28, 24, 20, 16, 15, 14, 8, 2; 16, 3, 1). R001 additionally writes D24 = 0.";
    reg {
        name = "D0/D3 stream segment 0 byte offset";
        desc = "D0/D3 stream segment 0 byte offset Provenance: PROVEN (word offsets). Source: HEVCHAL_V400R004_SetPicMsg / SetSliceMsg (GPL Kirin source); shift constants and stored word offsets of HEVCHAL_V400R001_SetPicMsg / SetSliceMsg (hi3536dv100_vfmw.ko) agree.";
        field {
            name = "byte_offset";
            desc = " (stream_start & ~0xF) - (stream_base & ~0xF) of segment i; segment 1 is D3-D5 [INFERRED]";
            sw = rw;
            hw = r;
        } byte_offset[31:0];
    } D0 @ 0x0;

    reg {
        name = "D1 bit offset segment 0";
        desc = "D1 bit offset segment 0 Provenance: INFERRED. Source: HEVCHAL_V400R004_SetPicMsg / SetSliceMsg (GPL Kirin source); shift constants and stored word offsets of HEVCHAL_V400R001_SetPicMsg / SetSliceMsg (hi3536dv100_vfmw.ko) agree.";
        field {
            name = "bit_offset";
            desc = "(bitsoffset + 8 x (bytespos & 0xF)) & 0x7F [INFERRED]";
            sw = rw;
            hw = r;
        } bit_offset[6:0];
        field {
            name = "reserved_31_7";
            desc = " [INFERRED]";
            sw = r;
            hw = r;
        } reserved_31_7[31:7];
    } D1 @ 0x4;

    reg {
        name = "D2 valid bit length segment 0";
