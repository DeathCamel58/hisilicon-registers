            desc = "reference type [INFERRED]";
            sw = rw;
            hw = r;
        } ref_pic_type_4[9:8];
        field {
            name = "ref_pic_type_5";
            desc = "reference type [INFERRED]";
            sw = rw;
            hw = r;
        } ref_pic_type_5[11:10];
        field {
            name = "ref_pic_type_6";
            desc = "reference type [INFERRED]";
            sw = rw;
            hw = r;
        } ref_pic_type_6[13:12];
        field {
