        desc = "PROVEN offset and value: HEVC CfgVdmReg writes 0 (R004 writes 2); H264HAL_V400R001_StartDec writes 2 for a progressive frame picture and 0 for field pictures or MBAFF (dynamic run). Provenance: PROVEN. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0).";
        field {
            name = "ff_apt_en";
            desc = "enable: H.264 progressive frame writes 2 (bit 1 of the value, not this bit 0), HEVC 0 [PROVEN values, INFERRED meaning]";
            sw = rw;
            hw = r;
        } ff_apt_en[0:0];
        field {
            name = "reserved_31_1";
            desc = "reserved [INFERRED]";
            sw = r;
            hw = r;
        } reserved_31_1[31:1];
    } FF_APT_EN @ 0x98;

    reg {
        name = "Decode cycles per picture";
