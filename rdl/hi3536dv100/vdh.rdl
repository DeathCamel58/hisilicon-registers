        field {
            name = "bit_offset";
            desc = "(bitsoffset + 8 * bytespos) & 0x7F";
            sw = rw;
            hw = r;
        } bit_offset[6:0];
    } D1 @ 0x4;

    reg {
        name = "D2 segment 0 valid bit length";
