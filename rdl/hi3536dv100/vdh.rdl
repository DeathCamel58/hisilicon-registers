};

regfile eHI3536D_VDH_TOP {
    name = "VDH top / SCD glue registers (0x1320C000 window), Hi3536D V100";
    desc = "Four glue registers at the start of the SCD window (the SCD proper is eHISI_SCD_AV300 at 0x1320C800: the SCD of this chip is a function of the VDH IP, it shares the 64 KB window, the clock gate and the reset register PERI_CRG41 with it and has its own interrupt, SPI 23). PROVEN offsets: hi3536dv100_vfmw.ko writes 0xC000 (VDMHAL_V400R001_PrepareDec: 1 when the standard code is 6 else 0), 0xC004 (WriteScdEMARID: 0x0481A1F7 once at init; per picture bit 16 is read-modify-written: set when the picture width is <= 2048, cleared above, HEVC CfgVdmReg 0x411d8 PROVEN, H.264 StartDec by the macroblock width <= 128), 0xC008 (PrepareDec: 1, VDH 0, after AVS_FLAG and before the codec StartDec), 0xC00C (StartHwDecode for VDH 0: 2 for HEVC, 3 for other standards, after INT_MASK and before the START pulse; corrected 2026-11-22, the earlier text said VDH1 only). Order before START (vendor): AVS_FLAG, SELRST, picture registers, INT_STATE/INT_MASK, messages, INT_MASK, CK_GT, START 0/1/0. Names AVS_FLAG / EMAR_ID / VDH_SELRST / VDH_CK_GT follow the V400R004 documentation in docs/rdl-campaign/vdh-scd.md (INFERRED). BOARD 2026-11-23 (reads after a whole block reset, all addresses in the 0x1320C800 SCD page): SCD_INT_MASK (+0x81C) reads 1 (masked) after reset and keeps a written 1, SCD_OVER (+0x840) 2, +0x820 0x00000C00, +0x844 0x0000FFFF, +0x800/804/808/810/814/818/848 and SCD_NUM (+0x84C) 0; no scan was run, so the polarity of the mask (1 = masked, the reset state, as for the VDH INT_MASK whose reset value is 7) is supported but not proven.";
    reg {
        name = "AVS flag";
        desc = "1 when the stream standard code is 6 (AVS), else 0. PROVEN offset and value. Provenance: PROVEN. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0).";
        field {
            name = "avs_flag";
            desc = "AVS mode [PROVEN]";
            sw = rw;
            hw = r;
        } avs_flag[0:0];
    } AVS_FLAG @ 0x0;

    reg {
        name = "AXI master ID / limits";
        desc = "PROVEN: VDMHAL_V400R001_WriteScdEMARID writes 0x0481A1F7; Per picture the bit 16 is set when the picture width is <= 2048 and cleared above (R001 module; R004 uses 4096), for HEVC (CfgVdmReg, dynamic widths 1920/2048 keep 0x0481A1F7, 2049/3072 write 0x0480A1F7) and H.264. Bit 17 is never touched by R001. R004 header comment: 0x0000FF00 no RAM on chip, 0x0001FF00 all RAM on chip, 0x0002FF00 all on-chip RAM except the DBLK RAM. R004 default value 0x161F7 differs from the R001 0x0481A1F7. Provenance: PROVEN value and bit 16 rule, INFERRED bit 16 meaning. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0); Huawei Kirin GPL VDH V400R004 header vdm_hal_local.h (a later generation of the same VDH). BOARD 2026-11-23: reset 0x000161F7; only bits [16:0] are implemented, bits [15:14] read 01 whatever is written (0x8 written reads 0x4), bit 16 stores. Bit 16 = 0 is byte exact at 128 and at 2304 pixels width, bit 16 = 1 is exact at 128 and corrupts 384 luma bytes at 2304 (on-chip line RAM too small above 2048). SELRST reads 0 after reset, AVS_FLAG 0.";
        field {
            name = "emar_id";
            desc = "AXI master configuration word (fields unknown); written 0x0481A1F7 at init, bit 16 per picture below [PROVEN value] [INFERRED field meanings]";
            sw = rw;
            hw = r;
        } emar_id[31:0];
    } EMAR_ID @ 0x4;

    reg {
        name = "VDH reset select";
        desc = "PROVEN: PrepareDec writes 1 for VDH 0. Provenance: PROVEN. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0).";
        field {
            name = "vdh_selrst";
            desc = "VDH self reset enable (R004 source comment 'set VDH self reset'); written 1 and never cleared by the module, ResetVdm/ResetGlb do not touch it [PROVEN value and order, INFERRED meaning]";
            sw = rw;
            hw = r;
        } vdh_selrst[0:0];
    } VDH_SELRST @ 0x8;

    reg {
        name = "VDH clock gate";
        desc = "Written for VDH 0 by VDMHAL_V400R001_StartHwDecode (0x17ea8) before every start, after INT_MASK and before the START pulse: 2 for HEVC (standard 16), 3 for H.264 and the others (dynamic run). R004 comment: VDH clock gating, its default leaves it unwritten. Bit meanings unknown (GUESS: bit 1 common clock gating, bit 0 H.264-only path). Provenance: PROVEN value, order and path, INFERRED meaning. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0). BOARD 2026-11-23: HEVC CK_GT 0, 2 and 3 all decode byte exact on 128x128 and 2304x128 (no visible effect).";
        field {
            name = "vdh_ck_gt";
            desc = "clock gating control: HEVC 2, H.264 3 [PROVEN values, bit meanings GUESS]";
            sw = rw;
            hw = r;
        } vdh_ck_gt[1:0];
    } VDH_CK_GT @ 0xC;

};

regfile eHI3536D_VDH_BPD {
    name = "VDH bitplane decoder (VC-1/WMV9), window at VDH+0xD000, Hi3536D V100";
    desc = "Window at 0x1320D000 mapped by VDMHAL_V400R001_OpenHAL (PROVEN: MEM_Phy2Vir(0x1320D000) stored as the second register base of g_HwMem). In the GPL V400R004 source this is the bitplane decoder (BPD_REG_OFFSET 0xD000, bitplane.h): it decodes the VC-1 bitplane syntax elements. The Hi3536D vfmw module maps the window but no BPD register access was found in the H.264/HEVC paths read (VC-1 is not a feature of this chip per the data sheet: only H.265/H.264/MJPEG). Register names and offsets are from the V400R004 header (INFERRED); not used on this chip as far as the module shows.";
    reg {
        name = "BPD_START";
