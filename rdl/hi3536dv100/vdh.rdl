    } RD_BDWIDTH_PERPIC @ 0xB4;

    reg {
        name = "Write bandwidth per picture";
        desc = "Counter (R004). Provenance: INFERRED. Source: Huawei Kirin GPL VDH V400R004 header vdm_hal_local.h (a later generation of the same VDH).";
        field {
            name = "wr_bdwidth_perpic";
            desc = "bytes [INFERRED]";
            sw = r;
            hw = r;
        } wr_bdwidth_perpic[31:0];
    } WR_BDWIDTH_PERPIC @ 0xB8;

    reg {
        name = "Read requests per picture";
        desc = "Counter (R004). Provenance: INFERRED. Source: Huawei Kirin GPL VDH V400R004 header vdm_hal_local.h (a later generation of the same VDH).";
        field {
            name = "rd_req_perpic";
