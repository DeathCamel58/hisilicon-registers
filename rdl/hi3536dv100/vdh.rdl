    } D26 @ 0x68;

    reg {
        name = "D43 PMV left buffer";
        desc = "D43 PMV left buffer Size 3B (B = ALIGN128(H maximum)); always allocated. PROVEN. Provenance: PROVEN (word offset). Source: HEVCHAL_V400R004_SetPicMsg / SetSliceMsg (GPL Kirin source); shift constants and stored word offsets of HEVCHAL_V400R001_SetPicMsg / SetSliceMsg (hi3536dv100_vfmw.ko) agree.";
