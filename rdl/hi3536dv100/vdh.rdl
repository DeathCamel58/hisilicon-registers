            desc = "chroma_qp_index_offset & 0x1F";
            sw = rw;
            hw = r;
        } chroma_qp_index_offset[9:5];
        field {
            name = "weight_mode";
            desc = "Prediction weighting of the slice: weighted_pred_flag for P slices, weighted_bipred_idc for B slices (0 none, 1 explicit, 2 implicit), 0 for I slices; the vendor code writes the value shifted by 16 (R004 `weight_flag << 16`), so the implicit mode sets bit 17. Earlier text called bit 16 a one-bit 'explicit weighted prediction' flag [PROVEN position and value rule, INFERRED hardware reading]";
            sw = rw;
            hw = r;
        } weight_mode[17:16];
    } D10 @ 0x28;

