        desc = "D13 list0 long-term bits Provenance: INFERRED. Source: HEVCHAL_V400R004_SetPicMsg / SetSliceMsg (GPL Kirin source); shift constants and stored word offsets of HEVCHAL_V400R001_SetPicMsg / SetSliceMsg (hi3536dv100_vfmw.ko) agree.";
        field {
            name = "is_long_term_l0";
            desc = "bit i = entry i of list 0 is long-term [INFERRED]";
            sw = rw;
            hw = r;
        } is_long_term_l0[31:0];
    } D13 @ 0x34;

    reg {
        name = "D14 list1 long-term bits";
        desc = "D14 list1 long-term bits Provenance: INFERRED. Source: HEVCHAL_V400R004_SetPicMsg / SetSliceMsg (GPL Kirin source); shift constants and stored word offsets of HEVCHAL_V400R001_SetPicMsg / SetSliceMsg (hi3536dv100_vfmw.ko) agree.";
        field {
