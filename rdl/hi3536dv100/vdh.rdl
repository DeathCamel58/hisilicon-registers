        name = "D8-D24 reference picture addresses";
        desc = "D8-D24 reference picture addresses Provenance: INFERRED. Source: HEVCHAL_V400R004_SetPicMsg / SetSliceMsg (GPL Kirin source); shift constants and stored word offsets of HEVCHAL_V400R001_SetPicMsg / SetSliceMsg (hi3536dv100_vfmw.ko) agree.";
        field {
            name = "ref_pic_addr";
            desc = "D8..D23: picture address per APC index (16 words) [INFERRED]";
            sw = rw;
            hw = r;
        } ref_pic_addr[31:0];
    } D8 @ 0x20;

    reg {
        name = "D25 MN (CABAC init) table address";
        desc = "D25 MN (CABAC init) table address Region of 1024 bytes in the HAL block (464 entries x 2 bytes used, built by HEVCWriteCabacTab from the spec init values), 1024 aligned. PROVEN. Provenance: PROVEN (word offset). Source: HEVCHAL_V400R004_SetPicMsg / SetSliceMsg (GPL Kirin source); shift constants and stored word offsets of HEVCHAL_V400R001_SetPicMsg / SetSliceMsg (hi3536dv100_vfmw.ko) agree.";
