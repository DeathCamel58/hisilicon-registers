`ifndef HI3536D_VDH_RDL
`define HI3536D_VDH_RDL

regfile eHI3536D_VDH {
    name = "VDH video decoder, V400R001 generation (H.264 / H.265), Hi3536D V100";
    desc = "VDH register window at 0x13200000 (GIC SPI 21 = interrupt bit 53 in the data sheet table 3-8). The data sheet has NO register table for the VDH (feature text only: H.265 Main@L4.1 and H.264 High@L4.2 up to 3072 x 3072, 4 x 1080p@20). Evidence: static disassembly of hi3536dv100_vfmw.ko (the HAL functions VDMHAL_V400R001_*, H264HAL_V400R001_*, HEVCHAL_V400R001_*) plus the GPL source of the later generation V400R004 for names and bit layouts. Every register and field carries PROVEN (offset and value seen in the Hi3536D vendor module), INFERRED (taken from V400R004 or from register semantics) or GUESS. Nothing was verified on hardware. The H.264 and HEVC paths use the same register set; HEVC differs only in the message words (see eHI3536D_VDH_PICMSG / SLICEMSG) and in BASIC_CFG0/1 values. Clock and reset: PERI_CRG41 (0x120400A4) bit 0 clock, bits 4/5/6 reset requests (MFD/SCD/ALL), status in PERI_CRG_PLL61 (0x120400F4) bits 1/2; VDM_OpenHardware writes 1 to CRG41 (one whole-register write, no PLL61 wait afterwards) and, when the chip-revision byte at 0x12060024 equals 2, ORs 0xC. ResetVdm/ResetGlb (0x16ddc/0x16ed8) set CRG41 bit 4 / 6, poll PLL61 bit 1 / 2 up to 1000 x 30 us, only log on timeout, clear the bit and restore INT_MASK. The vendor software watchdog is 5000 ms (VDMDRV_CheckDevice 0x113a4). No VDH clock select exists in vfmw/vdec or the data sheet: the rate is open. Documented in docs/research/hi3536dv100-blocks.md.";

    reg {
        name = "Decode start";
        desc = "Pulse 0, 1, 0 starts decoding one picture (slice chain). PROVEN: VDMHAL_V400R001_StartHwDecode writes 0,1,0 after INT_MASK. Provenance: PROVEN. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0).";
        field {
            name = "dec_start";
            desc = "1 starts the decode [PROVEN]";
            sw = rw;
            hw = r;
        } dec_start[0:0];
    } VDH_START @ 0x0;

    reg {
        name = "Repair start";
        desc = "Hardware error-repair copy start (pulse). Not used by the paths read. Provenance: INFERRED. Source: Huawei Kirin GPL VDH V400R004 header vdm_hal_local.h (a later generation of the same VDH).";
        field {
            name = "repair_start";
            desc = "start repair [INFERRED]";
            sw = rw;
            hw = r;
        } repair_start[0:0];
    } VDH_REPAIR @ 0x4;

    reg {
        name = "Basic configuration 0";
        desc = "HEVC path value: mbamt_to_dec = CTB count - 1, bit 24 set, bit 30 = scaling_list_enabled_flag, bit 28 is set by R001 for BOTH codecs, unconditionally (PROVEN: HEVC byte 3 = 0x11 | scaling_list_enabled_flag << 6, H.264 byte 3 = 0x51: bits 24, 28, 30 always set; the R004 name luma_sum_en is INFERRED from BackupInfo always reading the luma sum and histogram registers), bit 23 = 0. Not a codec difference. Provenance: PROVEN for offset, mbamt, bits 24/28/30 (2026-11-22 dynamic: mbamt 509 gives 0x110001FD, with a scaling list 0x510001FD). Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0); field names Huawei Kirin GPL VDH V400R004 header vdm_hal_local.h (a later generation of the same VDH).";
        field {
            name = "mbamt_to_dec";
            desc = "Macroblock/CTB count to decode minus 1 [PROVEN]";
            sw = rw;
            hw = r;
        } mbamt_to_dec[19:0];
        field {
            name = "memory_clock_gating_en";
            desc = "Memory clock gating enable (name from R004; R001 leaves 0) [INFERRED]";
            sw = rw;
            hw = r;
        } memory_clock_gating_en[20:20];
        field {
            name = "module_clock_gating_en";
            desc = "Module clock gating enable (R004; R001 leaves 0) [INFERRED]";
            sw = rw;
            hw = r;
        } module_clock_gating_en[21:21];
        field {
            name = "marker_bit_detect_en";
            desc = "MPEG-4 marker bit detect (0) [INFERRED]";
            sw = rw;
            hw = r;
        } marker_bit_detect_en[22:22];
        field {
            name = "ac_last_detect_en";
            desc = "AC last detect (0 in R001) [PROVEN]";
            sw = rw;
            hw = r;
        } ac_last_detect_en[23:23];
        field {
            name = "coef_idx_detect_en";
            desc = "Coefficient index detect (1 in R001) [PROVEN]";
            sw = rw;
            hw = r;
        } coef_idx_detect_en[24:24];
        field {
            name = "vop_type_detect_en";
            desc = "VOP type detect (0) [INFERRED]";
            sw = rw;
            hw = r;
        } vop_type_detect_en[25:25];
        field {
            name = "work_mode";
            desc = "Work mode (R004 HEVC struct; R001 writes 0) [INFERRED]";
            sw = rw;
            hw = r;
        } work_mode[27:26];
        field {
            name = "luma_sum_en";
            desc = "R001 writes 1 for both codecs, unconditionally; name from R004 (luma sum statistics enable) [PROVEN value, INFERRED meaning]";
            sw = rw;
            hw = r;
        } luma_sum_en[28:28];
        field {
            name = "luma_histogram_en";
            desc = "Luma histogram enable (0) [INFERRED]";
            sw = rw;
            hw = r;
        } luma_histogram_en[29:29];
        field {
            name = "load_qmatrix_flag";
            desc = "Load scaling list (HEVC: scaling_list_enabled_flag; H.264: hard 1, the scaling matrix is always loaded) [PROVEN]";
            sw = rw;
            hw = r;
        } load_qmatrix_flag[30:30];
        field {
            name = "vdh_safe_flag";
            desc = "Secure mode flag (0 in the normal build) [INFERRED]";
            sw = rw;
            hw = r;
        } vdh_safe_flag[31:31];
    } BASIC_CFG0 @ 0x8;

    reg {
        name = "Basic configuration 1";
        desc = "HEVC value built by HEVCHAL_V400R001_CfgVdmReg: [3:0] video_standard 0xD, bit 15 mv_output_en 1, bit 14 fst_slc_grp = NewPicFlag, bit 13 uv_order_en 0 (hard), [27:16] max_slcgrp_num 3, bit 28 0, bit 29 = output format select (below), bit 30 frm_cmp_en = Compress_en, bit 31 0; example 0x2003C00D (1080p, linear, no compression) or 0x0003C00D (TILE64). H.264 (H264HAL_V400R001_StartDec): video_standard 0, [12:4] ddr_stride = stride >> 6, bit 14 NewPicFlag, [27:16] max_slcgrp_num 4, bit 29 = the same format select, bits 13/15/28/30/31 0. OUTPUT FORMAT (M1, 2026-11-22): bit 29 is NOT the constant 1 of the R004 source. It is a per-channel software choice: vdec.ko VdecGenChanCfg (0x6f88) sets channel-config word +0x64 = (enVideoFormat == VIDEO_FORMAT_LINEAR), VCTRL_ConfigChan (0xad5c) copies it to chan+0x5d8 and both StartDec paths insert that byte at bit 29. Dynamic: LINEAR gives 1, TILE64 gives 0. So bit 29 = 1: raster (linear, semi-planar) output; bit 29 = 0: TILE64 (64 x 16 tiles, the HiMPP default). R004 hard-sets it to 1 (its platform outputs linear). Compression (bit 30) is only allowed with TILE64 (vdec rejects LINEAR + compress: only LINEAR/NONE, TILE64/NONE, TILE64/SEG128 are valid). Provenance: PROVEN for video_standard, max_slcgrp_num; others INFERRED. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0); names Huawei Kirin GPL VDH V400R004 header vdm_hal_local.h (a later generation of the same VDH). BOARD 2026-11-23: reset value 0x20008000 (bits 29 and 15 set); with bit 13 = 1 the output is NV12.";
        field {
            name = "video_standard";
            desc = "0 = H.264, 0xD = HEVC (the module dispatches on standard code 0 / 16 = H.264 / HEVC) [PROVEN]";
            sw = rw;
            hw = r;
        } video_standard[3:0];
        field {
            name = "reserved_12_4";
            desc = "reserved for HEVC (0); H.264: ddr_stride = YSTRIDE_1D >> 6 in [12:4] [PROVEN for H.264 R001, dynamic StartDec run]";
            sw = r;
            hw = r;
        } reserved_12_4[12:4];
        field {
            name = "uv_order_en";
            desc = "Chroma order swap: R004 sets it from the channel option u8UVOrder (0: uv, 1: vu), because the HEVC CRC check is NV12; R001 HEVC writes 0 (hard) [PROVEN value, INFERRED meaning; 0 = UV order = NV12 per the vfmw comment, to be confirmed by a colored test frame] BOARD 2026-11-23 (Hi3536D, hevc and h264, FFmpeg reference): 1 = NV12 (U first, the layout a V4L2 NV12 client expects), 0 = NV21 (V first). The vendor value 0 is the NV21 order; our driver and kit must set the bit. [PROVEN]";
            sw = rw;
            hw = r;
        } uv_order_en[13:13];
        field {
            name = "fst_slc_grp";
            desc = "first slice group of a picture [INFERRED]";
            sw = rw;
            hw = r;
        } fst_slc_grp[14:14];
        field {
            name = "mv_output_en";
            desc = "write motion vectors to DDR (HEVC: 1 [PROVEN]; H.264: 0) [INFERRED meaning]";
            sw = rw;
            hw = r;
        } mv_output_en[15:15];
        field {
            name = "max_slcgrp_num";
            desc = "max slice groups per batch (HEVC 3, H.264 4) [PROVEN]";
            sw = rw;
            hw = r;
        } max_slcgrp_num[27:16];
        field {
            name = "line_num_output_en";
            desc = "line number output (0) [INFERRED]";
            sw = rw;
            hw = r;
        } line_num_output_en[28:28];
        field {
            name = "vdh_2d_en";
            desc = "Output format select, 2026-11-22: 1 = linear raster output (VIDEO_FORMAT_LINEAR), 0 = TILE64 (default of the vendor stack). Per-channel option, see the register text. Name from R004 (hard 1 there). [PROVEN source and polarity of the vendor value, INFERRED hardware meaning] BOARD 2026-11-23: the register reads 0x20008000 after the power-on reset, so bit 29 is 1 by default; 1 = linear raster NV12 with stride = YSTRIDE_1D/16 (byte exact on 128x128 .. 1920x1080 and 2304x128, both codecs); 0 = a tiled layout: 64 byte rows, 1024 byte tiles (16 rows), the first tile in row order, the second tile starts at +1024 with the rows in a different order (not decoded further; not the simple row-major 64 x 16 tiling). [PROVEN polarity]";
            sw = rw;
            hw = r;
        } vdh_2d_en[29:29];
        field {
            name = "frm_cmp_en";
            desc = "frame compression (Compress_en): only with TILE64 + COMPRESS_MODE_SEG128 in the vendor stack; needs the compression header (HEAD_INF_OFFSET, UVOFFSET_1D includes the header) [INFERRED]";
            sw = rw;
            hw = r;
        } frm_cmp_en[30:30];
        field {
            name = "ppfd_en";
            desc = "PPFD enable (0) [INFERRED]";
            sw = rw;
            hw = r;
        } ppfd_en[31:31];
    } BASIC_CFG1 @ 0xC;

    reg {
        name = "Down message (AV) address";
        desc = "Physical address of the picture+slice message chain, bits [3:0] zero. PROVEN: stored as MsgSlotAddr & 0xFFFFFFF0. Provenance: PROVEN. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0).";
        field {
            name = "av_msg_addr";
            desc = "message pool address >> 0, 16-byte aligned [PROVEN]";
            sw = rw;
            hw = r;
        } av_msg_addr[31:0];
    } AVM_ADDR @ 0x10;

    reg {
        name = "Up message (VA) address";
        desc = "Physical address of the up (report) message, 16-byte aligned. PROVEN. Provenance: PROVEN. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0).";
        field {
            name = "va_msg_addr";
            desc = "up message address [PROVEN]";
            sw = rw;
            hw = r;
        } va_msg_addr[31:0];
    } VAM_ADDR @ 0x14;

    reg {
        name = "Stream base address";
        desc = "Physical start of the stream buffer, & ~0xF. PROVEN; slice offsets in the message are relative to it. Provenance: PROVEN. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0). BOARD 2026-11-23: reset value 0xFFFFFF00 (restored by the all reset); 0x12345670 latches. HEVC valid bits (slice message D2) must include the rbsp stop bit (+1), H.264 CABAC includes it and CAVLC does not (exact: +-1 flags an error or corrupts); the hardware does NOT remove emulation prevention bytes: a 00 00 03 inside the slice data decodes wrong, the same stream without the 03 byte exact (HEVC and H.264).";
        field {
            name = "stream_base_addr";
            desc = "stream base [PROVEN]";
            sw = rw;
            hw = r;
        } stream_base_addr[31:0];
    } STREAM_BASE_ADDR @ 0x18;

    reg {
        name = "VDH state";
        desc = "Decoded slice count, over/error status and version id. R004 layout; offset 0x1C INFERRED. [18:17] == 01 is the only success value the vendor accepts (anything else = failed picture; MPEG-2 tests bit 17 only): PROVEN, VDMHAL_V400R001_MakeDecReport (0x17a80), dynamic with injected values. [16:0] = decoded slice count, forced to 0 when above 300 (R004: 200). version_id [26:19] is NEVER read or extracted by hi3536dv100_vfmw.ko (PROVEN absence); in the R004 low-delay code bit 19 acts as a class bit next to bit 17, which does not fit a plain 8-bit version id: the field is unverified, the Hi3536D value needs a board read. Provenance: PROVEN for [18:0], INFERRED for the rest. Source: Huawei Kirin GPL VDH V400R004 header vdm_hal_local.h (a later generation of the same VDH). BOARD 2026-11-23: after power-on 0x0001c5e0 (meaningless slice count, id field 0), NOT cleared by a block reset (keeps the last picture: 0x00020001 after a clean one, 0x00060001 after a flagged one); a clean picture reads slice count 1, [18:17] = 01.";
        field {
            name = "decoded_slice_num";
            desc = "decoded slice count (MakeDecReport: ubfx 0,17; > 300 is an error) [PROVEN]";
            sw = r;
            hw = r;
        } decoded_slice_num[16:0];
        field {
            name = "intrs_vdh_dec_over";
            desc = "decode over; with bit 18 clear = success [PROVEN] BOARD 2026-11-23: 1 after every picture, clean or damaged.";
            sw = r;
            hw = r;
        } intrs_vdh_dec_over[17:17];
        field {
            name = "intrs_vdh_dec_err";
            desc = "decode error; the vendor treats [18:17] != 01 as a failed picture [PROVEN] BOARD 2026-11-23: 0 for a clean picture. 1 for a damaged slice (up message last block stops short) and also for a HEVC picture whose slice valid-bits count (D2) does not include the stop bit (output still byte exact), and for many H.264 CABAC pictures that decode byte exact with a correct D2 (SED_STA 0x1014 reads 0x14210000 instead of 0x14000000, 0x1004 bit 18 clear instead of set; CAVLC and HEVC are clean); cause of the H.264 CABAC case not found. [PROVEN observation, meaning OPEN]";
            sw = r;
            hw = r;
        } intrs_vdh_dec_err[18:18];
        field {
            name = "version_id";
            desc = "R004 name hardware version; never read by the R001 module; unverified (board read) [INFERRED, unused] BOARD 2026-11-23: reads 0 on a Hi3536D V100 (idle value after power-on 0x0001c5e0, after a picture 0x00020001).";
            sw = r;
            hw = r;
        } version_id[26:19];
        field {
            name = "reserved_31_27";
            desc = "reserved [INFERRED]";
            sw = r;
            hw = r;
        } reserved_31_27[31:27];
    } VDH_STATE @ 0x1C;

    reg {
        name = "Interrupt status";
        desc = "PROVEN: ClearIntState writes 0xFFFFFFFF (write-1-to-clear: R004 clears single bits with 0xFFFFFFF4 / 0xFFFFFFF1 in its low-delay path). The ISR (VDMDRV_VdmIntServProc 0x116f0) examines ONLY bit 0: a picture is finished when INT_STATE[0] is set; failure is then read from VDH_STATE[18:17]. Bit 1 (R004 name dec_err) is never read by the R001 module. Bit 2 is the R004 low-delay line-number interrupt, unused by R001. Provenance: PROVEN (offset, clear, bit 0 use); bit 1 meaning INFERRED. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0); names Huawei Kirin GPL VDH V400R004 header vdm_hal_local.h (a later generation of the same VDH). BOARD 2026-11-23: 0 after reset, 1 after every finished picture (clean, damaged and flagged), INT_MASK 0xFFFFFFFE; the up message of a damaged picture shows the stop (W2 = last block reached).";
        field {
            name = "intrs_vdm_dec_over";
            desc = "decode finished (the only bit the vendor ISR tests; whether it also fires on a failed picture is INFERRED, board test) [PROVEN use]";
            sw = rw;
            hw = r;
        } intrs_vdm_dec_over[0:0];
        field {
            name = "intrs_vdm_dec_err";
            desc = "decode error (R004 name); never examined by the R001 module [INFERRED]";
            sw = rw;
            hw = r;
        } intrs_vdm_dec_err[1:1];
        field {
            name = "reserved_31_2";
            desc = "reserved [INFERRED]";
            sw = r;
            hw = r;
        } reserved_31_2[31:2];
    } INT_STATE @ 0x20;

    reg {
        name = "Interrupt mask";
        desc = "PROVEN: EnableInt/StartHwDecode write 0xFFFFFFFE (bit 0 unmasked, 1 = masked); the low-delay build 0xFFFFFFFA (bits 0 and 2 enabled), the busy-wait build 0xFFFFFFFF (all masked, status polled; polarity from the three R004 values). ResetVdm/ResetGlb save and restore it around the reset. Provenance: PROVEN. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0).";
        field {
            name = "mask_dec_over";
            desc = "0 = interrupt enabled [PROVEN] BOARD 2026-11-23: the register has 3 implemented bits, reset value 7 (all masked), write 0xFFFFFFFE reads 6; bit 0 = 0 fires on every finished picture. [PROVEN]";
            sw = rw;
            hw = r;
        } mask_dec_over[0:0];
        field {
            name = "mask_dec_err";
            desc = "0 = interrupt enabled (0xFFFFFFFE leaves it masked) [PROVEN]";
            sw = rw;
            hw = r;
        } mask_dec_err[1:1];
        field {
            name = "reserved_31_2";
            desc = "reserved [INFERRED]";
            sw = r;
            hw = r;
        } reserved_31_2[31:2];
    } INT_MASK @ 0x24;

    reg {
        name = "VCTRL state";
        desc = "PROVEN: IsVdmRun reads this register and treats value 1 as idle. Provenance: PROVEN. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0).";
        field {
            name = "vctrl_state";
            desc = "1 = idle, else running [PROVEN]";
            sw = r;
            hw = r;
        } vctrl_state[31:0];
    } VCTRL_STATE @ 0x28;

    reg {
        name = "AXI master id / outstanding";
        desc = "R004 location; in R001 the EMAR_ID value is written in the SCD top window (0x1320C004), not here. Provenance: INFERRED. Source: Huawei Kirin GPL VDH V400R004 header vdm_hal_local.h (a later generation of the same VDH).";
        field {
            name = "emar_id";
            desc = "AXI master configuration [INFERRED]";
            sw = rw;
            hw = r;
        } emar_id[31:0];
    } EMAR_ID @ 0x30;

    reg {
        name = "Sed To";
        desc = "Module timeout counter. PROVEN: HEVC CfgVdmReg writes 0x00300C03 to every timeout register 0x3C-0x54. Provenance: PROVEN. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0).";
        field {
            name = "sed_to";
            desc = "timeout value, written 0x00300C03 [PROVEN]";
            sw = rw;
            hw = r;
        } sed_to[31:0];
    } SED_TO @ 0x3C;

    reg {
        name = "Itrans To";
        desc = "Module timeout counter. PROVEN: HEVC CfgVdmReg writes 0x00300C03 to every timeout register 0x3C-0x54. Provenance: PROVEN. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0).";
        field {
            name = "itrans_to";
            desc = "timeout value, written 0x00300C03 [PROVEN]";
            sw = rw;
            hw = r;
        } itrans_to[31:0];
    } ITRANS_TO @ 0x40;

    reg {
        name = "Pmv To";
        desc = "Module timeout counter. PROVEN: HEVC CfgVdmReg writes 0x00300C03 to every timeout register 0x3C-0x54. Provenance: PROVEN. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0).";
        field {
            name = "pmv_to";
            desc = "timeout value, written 0x00300C03 [PROVEN]";
            sw = rw;
            hw = r;
        } pmv_to[31:0];
    } PMV_TO @ 0x44;

    reg {
        name = "Prc To";
        desc = "Module timeout counter. PROVEN: HEVC CfgVdmReg writes 0x00300C03 to every timeout register 0x3C-0x54. Provenance: PROVEN. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0).";
        field {
            name = "prc_to";
            desc = "timeout value, written 0x00300C03 [PROVEN]";
            sw = rw;
            hw = r;
        } prc_to[31:0];
    } PRC_TO @ 0x48;

    reg {
        name = "Rcn To";
        desc = "Module timeout counter. PROVEN: HEVC CfgVdmReg writes 0x00300C03 to every timeout register 0x3C-0x54. Provenance: PROVEN. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0).";
        field {
            name = "rcn_to";
            desc = "timeout value, written 0x00300C03 [PROVEN]";
            sw = rw;
            hw = r;
        } rcn_to[31:0];
    } RCN_TO @ 0x4C;

    reg {
        name = "Dblk To";
        desc = "Module timeout counter. PROVEN: HEVC CfgVdmReg writes 0x00300C03 to every timeout register 0x3C-0x54. Provenance: PROVEN. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0).";
        field {
            name = "dblk_to";
            desc = "timeout value, written 0x00300C03 [PROVEN]";
            sw = rw;
            hw = r;
        } dblk_to[31:0];
    } DBLK_TO @ 0x50;

    reg {
        name = "Ppfd To";
        desc = "Module timeout counter. PROVEN: HEVC CfgVdmReg writes 0x00300C03 to every timeout register 0x3C-0x54. Provenance: PROVEN. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0).";
        field {
            name = "ppfd_to";
            desc = "timeout value, written 0x00300C03 [PROVEN]";
            sw = rw;
            hw = r;
        } ppfd_to[31:0];
    } PPFD_TO @ 0x54;

    reg {
        name = "Luma frame address (1D)";
        desc = "PROVEN: ImgPhyAddr & 0xFFFFFF00 (256-byte aligned). Provenance: PROVEN. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0).";
        field {
            name = "ystaddr_1d";
            desc = "luma base address of the output picture [PROVEN]";
            sw = rw;
            hw = r;
        } ystaddr_1d[31:0];
    } YSTADDR_1D @ 0x60;

    reg {
        name = "Luma stride";
        desc = "PROVEN: imgstride = fs_image.image_stride = ArrangeMem VahbStride = 16 x the line stride in bytes (R004 comment: ystride x 16; vdec VDEC_PackFrameInfo reports u32Stride = image_stride >> 4). The line stride is ALIGN64(width) (VDMHAL_V400R001_ArrangeMem, 80 dynamic points). The same register value is programmed for TILE64 and linear output (INFERRED: the hardware takes the distance of 16 lines in both layouts). Provenance: PROVEN. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0).";
        field {
            name = "ystride_1d";
            desc = "16 x line stride in bytes (= bytes between 16-line groups) [PROVEN value rule, INFERRED hardware reading]";
            sw = rw;
            hw = r;
        } ystride_1d[31:0];
    } YSTRIDE_1D @ 0x64;

    reg {
        name = "Chroma offset";
        desc = "PROVEN: UVOffset = chrom_phy_addr - luma_phy_addr in bytes = line stride x aligned height (+ compression header when frm_cmp_en): the height is ALIGN16(H) rounded up to 64 for HEVC (to 16 for H.264), ArrangeMem +0x110. Same rule for TILE64 and linear. Provenance: PROVEN. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0).";
        field {
            name = "uvoffset_1d";
            desc = "chroma plane offset in bytes from the luma base [PROVEN]";
            sw = rw;
            hw = r;
        } uvoffset_1d[31:0];
    } UVOFFSET_1D @ 0x68;

    reg {
        name = "Header info offset (compression)";
        desc = "PROVEN: written 0 without compression; with frm_cmp_en = 1 HEVCHAL_V400R001_CfgVdmReg writes ((H + 63) >> 6) << 5 times (((W + 2047) >> 7) & ~0xF) (1080p: 0x2200; H = ctx+0xb8, W = ctx+0xbc). Provenance: PROVEN. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0).";
        field {
            name = "head_inf_offset";
            desc = "compression header offset [PROVEN]";
            sw = rw;
            hw = r;
        } head_inf_offset[31:0];
    } HEAD_INF_OFFSET @ 0x6C;

    reg {
        name = "Line number output address";
        desc = "R004 alias PRCMEM1_1D_CNT; written only with the low-delay build option. Provenance: INFERRED. Source: Huawei Kirin GPL VDH V400R004 header vdm_hal_local.h (a later generation of the same VDH).";
        field {
            name = "line_num_staddr";
            desc = "line number buffer [INFERRED]";
            sw = rw;
            hw = r;
        } line_num_staddr[31:0];
    } LINE_NUM_STADDR @ 0x70;

    reg {
        name = "PPFD buffer address";
        desc = "PROVEN offset, value 0 (PPFD unused). Provenance: PROVEN. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0).";
        field {
            name = "ppfd_buf_addr";
            desc = "PPFD buffer [PROVEN]";
            sw = rw;
            hw = r;
        } ppfd_buf_addr[31:0];
    } PPFD_BUF_ADDR @ 0x80;

    reg {
        name = "PPFD buffer length";
        desc = "PROVEN offset, value 0. Provenance: PROVEN. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0).";
        field {
            name = "ppfd_buf_len";
            desc = "length [PROVEN]";
            sw = rw;
            hw = r;
        } ppfd_buf_len[15:0];
        field {
            name = "reserved_31_16";
            desc = "reserved [INFERRED]";
            sw = r;
            hw = r;
        } reserved_31_16[31:16];
    } PPFD_BUF_LEN @ 0x84;

    reg {
        name = "Reference picture type";
        desc = "2 bits per reference picture (16 entries); R004 layout. Offset PROVEN: H264HAL_V400R001_StartDec writes 0x94 (arm-re path-sensitive scan, 2026-11-12); not written on the HEVC path. Provenance: PROVEN offset; fields INFERRED. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0); Huawei Kirin GPL VDH V400R004 header vdm_hal_local.h (a later generation of the same VDH).";
        field {
            name = "ref_pic_type_0";
            desc = "reference type [INFERRED]";
            sw = rw;
            hw = r;
        } ref_pic_type_0[1:0];
        field {
            name = "ref_pic_type_1";
            desc = "reference type [INFERRED]";
            sw = rw;
            hw = r;
        } ref_pic_type_1[3:2];
        field {
            name = "ref_pic_type_2";
            desc = "reference type [INFERRED]";
            sw = rw;
            hw = r;
        } ref_pic_type_2[5:4];
        field {
            name = "ref_pic_type_3";
            desc = "reference type [INFERRED]";
            sw = rw;
            hw = r;
        } ref_pic_type_3[7:6];
        field {
