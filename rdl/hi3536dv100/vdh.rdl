            sw = rw;
            hw = r;
        } apc2mvaddr[31:0];
    } D23 @ 0x5C;

    reg {
        name = "D24 (R001 writes 0)";
        desc = "D24 (R001 writes 0) Provenance: PROVEN. Source: HEVCHAL_V400R001_SetSliceMsg (str to word 24).";
        field {
            name = "zero";
            desc = "written 0 by the Hi3536D module, not present in R004 [PROVEN]";
            sw = rw;
            hw = r;
