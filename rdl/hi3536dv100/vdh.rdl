            desc = "bit i = entry i of list 1 is long-term [INFERRED]";
            sw = rw;
            hw = r;
        } is_long_term_l1[31:0];
    } D14 @ 0x38;

    reg {
        name = "D15-D16 list0 APC indices";
        desc = "D15-D16 list0 APC indices Provenance: INFERRED. Source: HEVCHAL_V400R004_SetPicMsg / SetSliceMsg (GPL Kirin source); shift constants and stored word offsets of HEVCHAL_V400R001_SetPicMsg / SetSliceMsg (hi3536dv100_vfmw.ko) agree.";
        field {
            name = "apc";
            desc = "4 bits per entry, 8 entries per word (D15, D16) [INFERRED]";
            sw = rw;
            hw = r;
        } apc[31:0];
    } D15 @ 0x3C;

    reg {
        name = "D17-D18 list1 APC indices";
        desc = "D17-D18 list1 APC indices Provenance: INFERRED. Source: HEVCHAL_V400R004_SetPicMsg / SetSliceMsg (GPL Kirin source); shift constants and stored word offsets of HEVCHAL_V400R001_SetPicMsg / SetSliceMsg (hi3536dv100_vfmw.ko) agree.";
        field {
            name = "apc";
            desc = "4 bits per entry, 8 entries per word (D17, D18) [INFERRED]";
            sw = rw;
            hw = r;
        } apc[31:0];
    } D17 @ 0x44;

    reg {
        name = "D23 collocated MV address (Apc2MvAddr)";
        desc = "D23 collocated MV address (Apc2MvAddr) Provenance: PROVEN (word offset). Source: HEVCHAL_V400R004_SetPicMsg / SetSliceMsg (GPL Kirin source); shift constants and stored word offsets of HEVCHAL_V400R001_SetPicMsg / SetSliceMsg (hi3536dv100_vfmw.ko) agree.";
        field {
            name = "apc2mvaddr";
