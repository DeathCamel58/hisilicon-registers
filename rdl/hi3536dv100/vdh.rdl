            desc = "reference type [INFERRED]";
            sw = rw;
            hw = r;
        } ref_pic_type_13[27:26];
        field {
            name = "ref_pic_type_14";
            desc = "reference type [INFERRED]";
            sw = rw;
            hw = r;
        } ref_pic_type_14[29:28];
        field {
