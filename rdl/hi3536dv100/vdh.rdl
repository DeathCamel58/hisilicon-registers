`ifndef HI3536D_VDH_RDL
`define HI3536D_VDH_RDL

regfile eHI3536D_VDH {
    name = "VDH video decoder, V400R001 generation (H.264 / H.265), Hi3536D V100";
    desc = "VDH register window at 0x13200000 (GIC SPI 21 = interrupt bit 53 in the data sheet table 3-8). The data sheet has NO register table for the VDH (feature text only: H.265 Main@L4.1 and H.264 High@L4.2 up to 3072 x 3072, 4 x 1080p@20). Evidence: static disassembly of hi3536dv100_vfmw.ko (the HAL functions VDMHAL_V400R001_*, H264HAL_V400R001_*, HEVCHAL_V400R001_*) plus the GPL source of the later generation V400R004 for names and bit layouts. Every register and field carries PROVEN (offset and value seen in the Hi3536D vendor module), INFERRED (taken from V400R004 or from register semantics) or GUESS. Nothing was verified on hardware. The H.264 and HEVC paths use the same register set; HEVC differs only in the message words (see eHI3536D_VDH_PICMSG / SLICEMSG) and in BASIC_CFG0/1 values. Clock and reset: PERI_CRG41 (0x120400A4) bit 0 clock, bits 4/5/6 reset requests (MFD/SCD/ALL), status in PERI_CRG_PLL61 (0x120400F4) bits 1/2; VDM_OpenHardware writes 1 to CRG41 and, when the chip-revision byte at 0x12060024 equals 2, ORs 0xC. Documented in docs/research/hi3536dv100-blocks.md.";

    reg {
        name = "Decode start";
        desc = "Pulse 0, 1, 0 starts decoding one picture (slice chain). PROVEN: VDMHAL_V400R001_StartHwDecode writes 0,1,0 after INT_MASK. Provenance: PROVEN. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0).";
        field {
            name = "dec_start";
            desc = "1 starts the decode [PROVEN]";
            sw = rw;
            hw = r;
        } dec_start[0:0];
    } VDH_START @ 0x0;

    reg {
        name = "Repair start";
        desc = "Hardware error-repair copy start (pulse). Not used by the paths read. Provenance: INFERRED. Source: Huawei Kirin GPL VDH V400R004 header vdm_hal_local.h (a later generation of the same VDH).";
        field {
            name = "repair_start";
            desc = "start repair [INFERRED]";
            sw = rw;
            hw = r;
        } repair_start[0:0];
    } VDH_REPAIR @ 0x4;

    reg {
        name = "Basic configuration 0";
        desc = "HEVC path value: mbamt_to_dec = CTB count - 1, bit 24 set, bit 30 = scaling_list_enabled_flag, bit 28 also set by R001 (named luma_sum_en in R004, which the R004 source leaves 0: unexplained, may be a different bit in R001), bit 23 = 0. Provenance: PROVEN for offset, mbamt, bits 24/30. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0); field names Huawei Kirin GPL VDH V400R004 header vdm_hal_local.h (a later generation of the same VDH).";
        field {
            name = "mbamt_to_dec";
            desc = "Macroblock/CTB count to decode minus 1 [PROVEN]";
            sw = rw;
            hw = r;
        } mbamt_to_dec[19:0];
        field {
            name = "memory_clock_gating_en";
            desc = "Memory clock gating enable (name from R004; R001 leaves 0) [INFERRED]";
            sw = rw;
            hw = r;
        } memory_clock_gating_en[20:20];
        field {
            name = "module_clock_gating_en";
            desc = "Module clock gating enable (R004; R001 leaves 0) [INFERRED]";
            sw = rw;
            hw = r;
        } module_clock_gating_en[21:21];
        field {
            name = "marker_bit_detect_en";
            desc = "MPEG-4 marker bit detect (0) [INFERRED]";
            sw = rw;
            hw = r;
        } marker_bit_detect_en[22:22];
        field {
            name = "ac_last_detect_en";
            desc = "AC last detect (0 in R001) [PROVEN]";
            sw = rw;
            hw = r;
        } ac_last_detect_en[23:23];
        field {
            name = "coef_idx_detect_en";
            desc = "Coefficient index detect (1 in R001) [PROVEN]";
            sw = rw;
            hw = r;
        } coef_idx_detect_en[24:24];
        field {
            name = "vop_type_detect_en";
            desc = "VOP type detect (0) [INFERRED]";
            sw = rw;
            hw = r;
        } vop_type_detect_en[25:25];
        field {
            name = "work_mode";
            desc = "Work mode (R004 HEVC struct; R001 writes 0) [INFERRED]";
            sw = rw;
            hw = r;
        } work_mode[27:26];
        field {
            name = "luma_sum_en";
            desc = "R004 name; R001 writes 1 here (see register text) [INFERRED]";
            sw = rw;
            hw = r;
        } luma_sum_en[28:28];
        field {
            name = "luma_histogram_en";
            desc = "Luma histogram enable (0) [INFERRED]";
            sw = rw;
            hw = r;
        } luma_histogram_en[29:29];
        field {
            name = "load_qmatrix_flag";
            desc = "Load scaling list (HEVC: scaling_list_enabled_flag; R001 inserts it at bit 30) [PROVEN]";
            sw = rw;
            hw = r;
        } load_qmatrix_flag[30:30];
        field {
            name = "vdh_safe_flag";
            desc = "Secure mode flag (0 in the normal build) [INFERRED]";
            sw = rw;
            hw = r;
        } vdh_safe_flag[31:31];
    } BASIC_CFG0 @ 0x8;

    reg {
        name = "Basic configuration 1";
        desc = "HEVC: video_standard 0xD, fst_slc_grp = NewPicFlag, mv_output_en 1, vdh_2d_en 1, max_slcgrp_num 3, frm_cmp_en = Compress_en, ppfd_en 0 (R004 source values; R001 writes video_standard 13 and max_slcgrp_num 3, PROVEN from the stores). H.264 uses video_standard 0. Provenance: PROVEN for video_standard, max_slcgrp_num; others INFERRED. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0); names Huawei Kirin GPL VDH V400R004 header vdm_hal_local.h (a later generation of the same VDH).";
        field {
            name = "video_standard";
            desc = "0 = H.264, 0xD = HEVC (the module dispatches on standard code 0 / 16 = H.264 / HEVC) [PROVEN]";
            sw = rw;
            hw = r;
        } video_standard[3:0];
        field {
            name = "reserved_12_4";
            desc = "reserved (ddr_stride in the H.264 struct) [INFERRED]";
            sw = r;
            hw = r;
        } reserved_12_4[12:4];
        field {
            name = "uv_order_en";
            desc = "UV order swap for CRC on NV12 [INFERRED]";
            sw = rw;
            hw = r;
        } uv_order_en[13:13];
        field {
            name = "fst_slc_grp";
            desc = "first slice group of a picture [INFERRED]";
            sw = rw;
            hw = r;
        } fst_slc_grp[14:14];
        field {
            name = "mv_output_en";
            desc = "write motion vectors to DDR (1) [INFERRED]";
            sw = rw;
            hw = r;
        } mv_output_en[15:15];
        field {
            name = "max_slcgrp_num";
            desc = "max slice groups per batch (3) [PROVEN]";
            sw = rw;
            hw = r;
        } max_slcgrp_num[27:16];
        field {
            name = "line_num_output_en";
            desc = "line number output (0) [INFERRED]";
            sw = rw;
            hw = r;
        } line_num_output_en[28:28];
        field {
            name = "vdh_2d_en";
            desc = "2D (tiled) output enable (1) [INFERRED]";
            sw = rw;
            hw = r;
        } vdh_2d_en[29:29];
        field {
            name = "frm_cmp_en";
            desc = "frame compression (Compress_en) [INFERRED]";
            sw = rw;
            hw = r;
        } frm_cmp_en[30:30];
        field {
            name = "ppfd_en";
            desc = "PPFD enable (0) [INFERRED]";
            sw = rw;
            hw = r;
        } ppfd_en[31:31];
    } BASIC_CFG1 @ 0xC;

    reg {
        name = "Down message (AV) address";
        desc = "Physical address of the picture+slice message chain, bits [3:0] zero. PROVEN: stored as MsgSlotAddr & 0xFFFFFFF0. Provenance: PROVEN. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0).";
        field {
            name = "av_msg_addr";
            desc = "message pool address >> 0, 16-byte aligned [PROVEN]";
            sw = rw;
            hw = r;
        } av_msg_addr[31:0];
    } AVM_ADDR @ 0x10;

    reg {
        name = "Up message (VA) address";
        desc = "Physical address of the up (report) message, 16-byte aligned. PROVEN. Provenance: PROVEN. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0).";
        field {
            name = "va_msg_addr";
            desc = "up message address [PROVEN]";
            sw = rw;
            hw = r;
        } va_msg_addr[31:0];
    } VAM_ADDR @ 0x14;

    reg {
        name = "Stream base address";
        desc = "Physical start of the stream buffer, & ~0xF. PROVEN; slice offsets in the message are relative to it. Provenance: PROVEN. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0).";
        field {
            name = "stream_base_addr";
            desc = "stream base [PROVEN]";
            sw = rw;
            hw = r;
        } stream_base_addr[31:0];
    } STREAM_BASE_ADDR @ 0x18;

    reg {
        name = "VDH state";
        desc = "Decoded slice count, over/error status and version id. R004 layout; offset 0x1C INFERRED. A version_id read would identify the die (hardware needed). Provenance: INFERRED. Source: Huawei Kirin GPL VDH V400R004 header vdm_hal_local.h (a later generation of the same VDH).";
        field {
            name = "decoded_slice_num";
            desc = "decoded slice count [INFERRED]";
            sw = r;
            hw = r;
        } decoded_slice_num[16:0];
        field {
            name = "intrs_vdh_dec_over";
            desc = "decode over [INFERRED]";
            sw = r;
            hw = r;
        } intrs_vdh_dec_over[17:17];
        field {
            name = "intrs_vdh_dec_err";
            desc = "decode error [INFERRED]";
            sw = r;
            hw = r;
        } intrs_vdh_dec_err[18:18];
        field {
            name = "version_id";
            desc = "hardware version [INFERRED]";
            sw = r;
            hw = r;
        } version_id[26:19];
        field {
            name = "reserved_31_27";
            desc = "reserved [INFERRED]";
            sw = r;
            hw = r;
        } reserved_31_27[31:27];
    } VDH_STATE @ 0x1C;

    reg {
        name = "Interrupt status";
        desc = "PROVEN: ClearIntState writes 0xFFFFFFFF (write-1-to-clear assumed). bit 0 dec over, bit 1 dec error (R004 names). Provenance: PROVEN offset/clear. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0); names Huawei Kirin GPL VDH V400R004 header vdm_hal_local.h (a later generation of the same VDH).";
        field {
            name = "intrs_vdm_dec_over";
            desc = "decode finished [INFERRED]";
            sw = rw;
            hw = r;
        } intrs_vdm_dec_over[0:0];
        field {
            name = "intrs_vdm_dec_err";
            desc = "decode error [INFERRED]";
            sw = rw;
            hw = r;
        } intrs_vdm_dec_err[1:1];
        field {
            name = "reserved_31_2";
            desc = "reserved [INFERRED]";
            sw = r;
            hw = r;
        } reserved_31_2[31:2];
    } INT_STATE @ 0x20;

    reg {
        name = "Interrupt mask";
        desc = "PROVEN: EnableInt/StartHwDecode write 0xFFFFFFFE (bit 0 unmasked, 1 = masked); the busy-wait build writes 0xFFFFFFFF. Provenance: PROVEN. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0).";
        field {
            name = "mask_dec_over";
            desc = "0 = interrupt enabled [PROVEN]";
            sw = rw;
            hw = r;
        } mask_dec_over[0:0];
        field {
            name = "mask_dec_err";
            desc = "0 = interrupt enabled (0xFFFFFFFE leaves it masked) [PROVEN]";
            sw = rw;
            hw = r;
        } mask_dec_err[1:1];
        field {
            name = "reserved_31_2";
            desc = "reserved [INFERRED]";
            sw = r;
            hw = r;
        } reserved_31_2[31:2];
    } INT_MASK @ 0x24;

    reg {
        name = "VCTRL state";
        desc = "PROVEN: IsVdmRun reads this register and treats value 1 as idle. Provenance: PROVEN. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0).";
        field {
            name = "vctrl_state";
            desc = "1 = idle, else running [PROVEN]";
            sw = r;
            hw = r;
        } vctrl_state[31:0];
    } VCTRL_STATE @ 0x28;

    reg {
        name = "AXI master id / outstanding";
        desc = "R004 location; in R001 the EMAR_ID value is written in the SCD top window (0x1320C004), not here. Provenance: INFERRED. Source: Huawei Kirin GPL VDH V400R004 header vdm_hal_local.h (a later generation of the same VDH).";
        field {
            name = "emar_id";
            desc = "AXI master configuration [INFERRED]";
            sw = rw;
            hw = r;
        } emar_id[31:0];
    } EMAR_ID @ 0x30;

    reg {
        name = "Sed To";
        desc = "Module timeout counter. PROVEN: HEVC CfgVdmReg writes 0x00300C03 to every timeout register 0x3C-0x54. Provenance: PROVEN. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0).";
        field {
            name = "sed_to";
            desc = "timeout value, written 0x00300C03 [PROVEN]";
            sw = rw;
            hw = r;
        } sed_to[31:0];
    } SED_TO @ 0x3C;

    reg {
        name = "Itrans To";
        desc = "Module timeout counter. PROVEN: HEVC CfgVdmReg writes 0x00300C03 to every timeout register 0x3C-0x54. Provenance: PROVEN. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0).";
        field {
            name = "itrans_to";
            desc = "timeout value, written 0x00300C03 [PROVEN]";
            sw = rw;
            hw = r;
        } itrans_to[31:0];
    } ITRANS_TO @ 0x40;

    reg {
        name = "Pmv To";
        desc = "Module timeout counter. PROVEN: HEVC CfgVdmReg writes 0x00300C03 to every timeout register 0x3C-0x54. Provenance: PROVEN. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0).";
        field {
            name = "pmv_to";
            desc = "timeout value, written 0x00300C03 [PROVEN]";
            sw = rw;
            hw = r;
        } pmv_to[31:0];
    } PMV_TO @ 0x44;

    reg {
        name = "Prc To";
        desc = "Module timeout counter. PROVEN: HEVC CfgVdmReg writes 0x00300C03 to every timeout register 0x3C-0x54. Provenance: PROVEN. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0).";
        field {
            name = "prc_to";
            desc = "timeout value, written 0x00300C03 [PROVEN]";
            sw = rw;
            hw = r;
        } prc_to[31:0];
    } PRC_TO @ 0x48;

    reg {
        name = "Rcn To";
        desc = "Module timeout counter. PROVEN: HEVC CfgVdmReg writes 0x00300C03 to every timeout register 0x3C-0x54. Provenance: PROVEN. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0).";
        field {
            name = "rcn_to";
            desc = "timeout value, written 0x00300C03 [PROVEN]";
            sw = rw;
            hw = r;
        } rcn_to[31:0];
    } RCN_TO @ 0x4C;

    reg {
        name = "Dblk To";
        desc = "Module timeout counter. PROVEN: HEVC CfgVdmReg writes 0x00300C03 to every timeout register 0x3C-0x54. Provenance: PROVEN. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0).";
        field {
            name = "dblk_to";
            desc = "timeout value, written 0x00300C03 [PROVEN]";
            sw = rw;
            hw = r;
        } dblk_to[31:0];
    } DBLK_TO @ 0x50;

    reg {
        name = "Ppfd To";
        desc = "Module timeout counter. PROVEN: HEVC CfgVdmReg writes 0x00300C03 to every timeout register 0x3C-0x54. Provenance: PROVEN. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0).";
        field {
            name = "ppfd_to";
            desc = "timeout value, written 0x00300C03 [PROVEN]";
            sw = rw;
            hw = r;
        } ppfd_to[31:0];
    } PPFD_TO @ 0x54;

    reg {
        name = "Luma frame address (1D)";
        desc = "PROVEN: ImgPhyAddr & 0xFFFFFF00 (256-byte aligned). Provenance: PROVEN. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0).";
        field {
            name = "ystaddr_1d";
            desc = "luma base address of the output picture [PROVEN]";
            sw = rw;
            hw = r;
        } ystaddr_1d[31:0];
    } YSTADDR_1D @ 0x60;

    reg {
        name = "Luma stride";
        desc = "PROVEN: imgstride. Provenance: PROVEN. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0).";
        field {
            name = "ystride_1d";
            desc = "line stride in bytes [PROVEN]";
            sw = rw;
            hw = r;
        } ystride_1d[31:0];
    } YSTRIDE_1D @ 0x64;

    reg {
        name = "Chroma offset";
        desc = "PROVEN: UVOffset, chroma plane offset from the luma base. Provenance: PROVEN. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0).";
        field {
            name = "uvoffset_1d";
            desc = "chroma offset [PROVEN]";
            sw = rw;
            hw = r;
        } uvoffset_1d[31:0];
    } UVOFFSET_1D @ 0x68;

    reg {
        name = "Header info offset (compression)";
        desc = "PROVEN: written 0. Provenance: PROVEN. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0).";
        field {
            name = "head_inf_offset";
            desc = "compression header offset [PROVEN]";
            sw = rw;
            hw = r;
        } head_inf_offset[31:0];
    } HEAD_INF_OFFSET @ 0x6C;

    reg {
        name = "Line number output address";
        desc = "R004 alias PRCMEM1_1D_CNT; written only with the low-delay build option. Provenance: INFERRED. Source: Huawei Kirin GPL VDH V400R004 header vdm_hal_local.h (a later generation of the same VDH).";
        field {
            name = "line_num_staddr";
            desc = "line number buffer [INFERRED]";
            sw = rw;
            hw = r;
        } line_num_staddr[31:0];
    } LINE_NUM_STADDR @ 0x70;

    reg {
        name = "PPFD buffer address";
        desc = "PROVEN offset, value 0 (PPFD unused). Provenance: PROVEN. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0).";
        field {
            name = "ppfd_buf_addr";
            desc = "PPFD buffer [PROVEN]";
            sw = rw;
            hw = r;
        } ppfd_buf_addr[31:0];
    } PPFD_BUF_ADDR @ 0x80;

    reg {
        name = "PPFD buffer length";
        desc = "PROVEN offset, value 0. Provenance: PROVEN. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0).";
        field {
            name = "ppfd_buf_len";
            desc = "length [PROVEN]";
            sw = rw;
            hw = r;
        } ppfd_buf_len[15:0];
        field {
            name = "reserved_31_16";
            desc = "reserved [INFERRED]";
            sw = r;
            hw = r;
        } reserved_31_16[31:16];
    } PPFD_BUF_LEN @ 0x84;

    reg {
        name = "Reference picture type";
        desc = "2 bits per reference picture (16 entries); R004 layout. Offset PROVEN: H264HAL_V400R001_StartDec writes 0x94 (arm-re path-sensitive scan, 2026-11-12); not written on the HEVC path. Provenance: PROVEN offset; fields INFERRED. Source: hi3536dv100_vfmw.ko (VDMHAL_V400R001 / HEVCHAL_V400R001 disassembly, SDK 2.0.2.0); Huawei Kirin GPL VDH V400R004 header vdm_hal_local.h (a later generation of the same VDH).";
        field {
            name = "ref_pic_type_0";
            desc = "reference type [INFERRED]";
            sw = rw;
            hw = r;
        } ref_pic_type_0[1:0];
        field {
            name = "ref_pic_type_1";
            desc = "reference type [INFERRED]";
            sw = rw;
            hw = r;
        } ref_pic_type_1[3:2];
        field {
            name = "ref_pic_type_2";
            desc = "reference type [INFERRED]";
            sw = rw;
            hw = r;
        } ref_pic_type_2[5:4];
        field {
            name = "ref_pic_type_3";
            desc = "reference type [INFERRED]";
            sw = rw;
            hw = r;
        } ref_pic_type_3[7:6];
        field {
            name = "ref_pic_type_4";
            desc = "reference type [INFERRED]";
            sw = rw;
            hw = r;
        } ref_pic_type_4[9:8];
        field {
            name = "ref_pic_type_5";
            desc = "reference type [INFERRED]";
            sw = rw;
            hw = r;
        } ref_pic_type_5[11:10];
        field {
            name = "ref_pic_type_6";
            desc = "reference type [INFERRED]";
            sw = rw;
            hw = r;
        } ref_pic_type_6[13:12];
        field {
            name = "ref_pic_type_7";
            desc = "reference type [INFERRED]";
            sw = rw;
            hw = r;
        } ref_pic_type_7[15:14];
        field {
            name = "ref_pic_type_8";
            desc = "reference type [INFERRED]";
            sw = rw;
            hw = r;
        } ref_pic_type_8[17:16];
        field {
            name = "ref_pic_type_9";
            desc = "reference type [INFERRED]";
            sw = rw;
            hw = r;
        } ref_pic_type_9[19:18];
        field {
            name = "ref_pic_type_10";
            desc = "reference type [INFERRED]";
            sw = rw;
            hw = r;
