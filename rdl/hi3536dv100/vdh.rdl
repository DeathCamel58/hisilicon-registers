regfile eHI3536D_VDH_UPMSG {
    name = "VDH up message (report) slice record (DDR, NOT registers), Hi3536D V100";
    desc = "NOT A REGISTER FILE: the VDH writes one 4-word record per decoded slice into the up message buffer (VAM_ADDR); the driver reads min(decoded_slice_num, 200) records (VDH_STATE[16:0]; at most 200 slices = 800 words, MAX_UP_MSG_SLICE_NUM in the GPL source) and uses word 1 and 2 as the decoded macroblock/CTB range of each slice for error concealment. Picture status is in VDH_STATE: bits [18:17] == 01 means decode over without error. Evidence: GPL V400R004 MakeDecReport; same record size 4 words for all standards on this generation (comment in the source: hi3531 uniform). Word 0 and 3 are only partly known. Not extracted from the Hi3536D module (its MakeDecReport is a thin wrapper); offsets 4 words per slice INFERRED.";
    reg {
        name = "W0 slice status";
        desc = "W0 slice status Provenance: INFERRED. Source: VDMHAL_V400R004_IMP_MakeDecReport / BackInfo (GPL Kirin source); R001 module: same VDH_STATE/SED_STA/SED_END0 reads in VDMHAL_V400R001_BackupInfo (offsets 0x1000, 0x1014, 0xB0-0xC0 seen).";
        field {
            name = "sed_status";
            desc = "low-delay mode: 00 no error, 10 stream end error, 01 data error, 11 reserved (R004 comment; the last slice record only) [INFERRED]";
            sw = rw;
            hw = r;
        } sed_status[22:21];
        field {
            name = "sed_status_normal";
            desc = "normal mode: value 2 means the whole picture needs repair (H.264) [INFERRED]";
            sw = rw;
            hw = r;
        } sed_status_normal[25:24];
    } W0 @ 0x0;

    reg {
        name = "W1 slice start";
        desc = "W1 slice start Provenance: INFERRED. Source: VDMHAL_V400R004_IMP_MakeDecReport / BackInfo (GPL Kirin source); R001 module: same VDH_STATE/SED_STA/SED_END0 reads in VDMHAL_V400R001_BackupInfo (offsets 0x1000, 0x1014, 0xB0-0xC0 seen).";
        field {
            name = "start_mb";
            desc = "first macroblock/CTB of the slice [INFERRED]";
            sw = rw;
            hw = r;
        } start_mb[19:0];
    } W1 @ 0x4;

    reg {
        name = "W2 slice end";
        desc = "W2 slice end Provenance: INFERRED. Source: VDMHAL_V400R004_IMP_MakeDecReport / BackInfo (GPL Kirin source); R001 module: same VDH_STATE/SED_STA/SED_END0 reads in VDMHAL_V400R001_BackupInfo (offsets 0x1000, 0x1014, 0xB0-0xC0 seen).";
        field {
            name = "end_mb";
            desc = "last macroblock/CTB decoded (low-delay: bits [19:0] of the last record, word 2) [INFERRED]";
            sw = rw;
            hw = r;
        } end_mb[19:0];
    } W2 @ 0x8;

    reg {
        name = "W3 reserved/unknown";
        desc = "W3 reserved/unknown Provenance: GUESS. Source: VDMHAL_V400R004_IMP_MakeDecReport / BackInfo (GPL Kirin source); R001 module: same VDH_STATE/SED_STA/SED_END0 reads in VDMHAL_V400R001_BackupInfo (offsets 0x1000, 0x1014, 0xB0-0xC0 seen).";
        field {
            name = "unknown";
            desc = "not used by the driver [GUESS]";
            sw = rw;
            hw = r;
        } unknown[31:0];
    } W3 @ 0xC;

};

addrmap aHI3536D_VDH_MSG {
    name = "VDH HEVC DDR message layouts (placeholder window, NOT hardware)";
    desc = "Placeholder address 0x13210000 just past the VDH window (reserved in the data sheet): this only shows the two DDR message layouts in the register browser. The words live in the message pool in DDR, never at this address.";
    eHI3536D_VDH_PICMSG   PICMSG   @ 0x0;
    eHI3536D_VDH_SLICEMSG SLICEMSG @ 0x1000;
    eHI3536D_VDH_UPMSG    UPMSG    @ 0x2000;
};

`endif
