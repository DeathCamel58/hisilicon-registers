regfile eHI3536D_VDH_PICMSG {
    name = "VDH HEVC picture message (DDR, NOT registers), Hi3536D V100";
    desc = "NOT A REGISTER FILE: layout of the 64-word picture message ('burst 0', D0-D63) the HEVC driver writes into the message pool (slot DN_MSG_SLOT_INDEX) before the slice messages; the VDH reads it through AVM_ADDR. Offsets are word index x 4. Names and bit positions from the GPL Kirin V400R004 source; the R001 module of this chip was checked by its stored word offsets (1-7, 25, 43, 54-61, 63, plus the loops for D8-D24 and D26-D41) and by the shift constants of D0 (25, 23, 22, 21, 19, 18), D2 (29, 28, 27, 24, 21, 18, 15, 12, 9, 6, 3), D3 (22, 16, 12, 8, 4), D54 (16), D60 (24-19, 16, 13-10, 5): all agree. Words not listed are not written. Words 64-319 (bursts 1-4) hold the scaling lists (4 x 64 words, HEVC_WriteQmatrix, order 4x4/8x8/16x16/32x32 as the driver's Qmatrix array); the tile table is a separate buffer pointed to by D55 (TileId 2 x 128 words of 4 packed bytes, TilePosX 20 words, TilePosY 22 words, 16-bit pairs).";
    reg {
        name = "D0 sequence flags and size";
        desc = "D0 sequence flags and size Provenance: PROVEN (shift constants). Source: HEVCHAL_V400R004_SetPicMsg / SetSliceMsg (GPL Kirin source); shift constants and stored word offsets of HEVCHAL_V400R001_SetPicMsg / SetSliceMsg (hi3536dv100_vfmw.ko) agree.";
        field {
            name = "pic_width_in_ctbs_minus1";
            desc = "PicWidthInCtbsYMinus1 [INFERRED]";
            sw = rw;
            hw = r;
        } pic_width_in_ctbs_minus1[8:0];
        field {
