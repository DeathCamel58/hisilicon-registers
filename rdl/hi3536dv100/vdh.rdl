            sw = rw;
            hw = r;
        } seg1_word[31:0];
    } D3[3] @ 0xC += 0x4;

    reg {
        name = "D6 slice control";
        desc = "D6. Provenance: PROVEN. Source: hi3536dv100_vfmw.ko H264HAL_V400R001_SetPicMsg (0x2ac04) / SetSliceMsg (0x2ae80), word-checked statically and by a differential run of the vendor code in qemu-arm user mode on 2026-11-22 (what the code programs, not what silicon answers); names and shift constants agree with R004 vdm_hal_h264.c (GPL Kirin source), docs/research/vdh-hi3536d-static-analysis-2026-11-22.md.";
