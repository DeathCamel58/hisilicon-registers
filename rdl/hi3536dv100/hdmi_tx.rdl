        field { name = "rsv_2"; desc = ""; sw = r; hw = na; reset = 0x0; } rsv_2[31:1];
        field { name = "tx_aon_soft_arst_req"; desc = ""; sw = rw; hw = r; reset = 0x0; } tx_aon_soft_arst_req[0:0];
    } TX_AON_RST_CTRL @ 0x1C;
