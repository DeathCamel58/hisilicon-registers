regfile eHI3536D_HDMI_hdcp {
    name = "HDMI TX hdcp, Hi3536D V100 / HDMI v2 (hisiv100)";
    desc = "TX HDCP 1.x. Offsets are relative to the sub-block base 0x13002000 (HDMI TX window 0x13000000 + 0x2000). Provenance: PROVEN (vendor code): register names, offsets, field names/bit ranges and reset (INIT) values come from the machine-generated register headers of the vendor HDMI v2 driver (nManager-generated hdmi_reg_hdcp.h, product/hiosd/hdmi/hdmi_v2/drv/hal in the vendor U-Boot tree for the Hi3536D/Hi3536C/Hi3531D/Hi3521D family, source: sources/openipc-u-boot-hi3536dv100); the Hi3536D V100 maps the window at 0x13000000 per its hdmi_product_define.h and the closed hi3536dv100_hdmi.ko symbol names (HDMI_TX_S_*_REGS_TYPE_Init) agree. INFERRED: access types. Of the 503 register definitions in the vendor headers only 38 carry an ATTR (all RW); the others have none, so fields are modelled read/write except reserved/rsv fields and registers whose names mark them read-only by convention where the vendor hal/drv C sources call the accessors (203 registers) a register only ever read is modelled sw=r and the call-site counts are in each register description; for the other registers the name convention (SW_VER*, HW_INFO/HW_VERSION/HW_FEATURE, _STATUS, _STAT, _STATE, _OUT<n>: sw=r) is used. The 8051 MCU window (mcu sub-block) is modelled the same way and its function is inferred from the HDCP2X_* names only and hardware behavior; nothing run on hardware. NOT in the data sheet (no HDMI TX chapter)." ;
    reg {
        name = "HDCP1X_MEM_CTRL";
        desc = "HDCP1X_MEM_CTRL (offset 0x0 in this sub-block, absolute 0x13002000). Reset INIT 0x00000000. PROVEN: vendor register header. Driver usage (vendor hal/drv C, uncommented call sites): 5 Get, 10 Set (hdmi_hal_hdcp14.c): read and written (RW). ";
        field { name = "rsv_0"; desc = ""; sw = r; hw = na; reset = 0x0; } rsv_0[31:11];
        field { name = "hdcp1x_bist2_err"; desc = ""; sw = rw; hw = r; reset = 0x0; } hdcp1x_bist2_err[10:10];
        field { name = "hdcp1x_bist1_err"; desc = ""; sw = rw; hw = r; reset = 0x0; } hdcp1x_bist1_err[9:9];
        field { name = "hdcp1x_bist0_err"; desc = ""; sw = rw; hw = r; reset = 0x0; } hdcp1x_bist0_err[8:8];
        field { name = "hdcp1x_cmd_done"; desc = ""; sw = rw; hw = r; reset = 0x0; } hdcp1x_cmd_done[7:7];
        field { name = "hdcp1x_key_cmd_valid"; desc = ""; sw = rw; hw = r; reset = 0x0; } hdcp1x_key_cmd_valid[6:6];
        field { name = "hdcp1x_key_cmd"; desc = ""; sw = rw; hw = r; reset = 0x0; } hdcp1x_key_cmd[5:1];
        field { name = "hdcp1x_key_load"; desc = ""; sw = rw; hw = r; reset = 0x0; } hdcp1x_key_load[0:0];
    } HDCP1X_MEM_CTRL @ 0x0;
    reg {
        name = "HDCP1X_KEY_AKSV0";
        desc = "HDCP1X_KEY_AKSV0 (offset 0x4 in this sub-block, absolute 0x13002004). Reset INIT 0x00000000. PROVEN: vendor register header. Driver usage (vendor hal/drv C, uncommented call sites): 4 Get, 0 Set (hdmi_hal_hdcp14.c): read-only by usage (INFERRED RO). ";
        field { name = "hdcp1x_key_aksv_byte3"; desc = ""; sw = r; hw = w; reset = 0x0; } hdcp1x_key_aksv_byte3[31:24];
        field { name = "hdcp1x_key_aksv_byte2"; desc = ""; sw = r; hw = w; reset = 0x0; } hdcp1x_key_aksv_byte2[23:16];
        field { name = "hdcp1x_key_aksv_byte1"; desc = ""; sw = r; hw = w; reset = 0x0; } hdcp1x_key_aksv_byte1[15:8];
        field { name = "hdcp1x_key_aksv_byte0"; desc = ""; sw = r; hw = w; reset = 0x0; } hdcp1x_key_aksv_byte0[7:0];
    } HDCP1X_KEY_AKSV0 @ 0x4;
    reg {
        name = "HDCP1X_KEY_AKSV1";
        desc = "HDCP1X_KEY_AKSV1 (offset 0x8 in this sub-block, absolute 0x13002008). Reset INIT 0x00000000. PROVEN: vendor register header. Driver usage (vendor hal/drv C, uncommented call sites): 1 Get, 0 Set (hdmi_hal_hdcp14.c): read-only by usage (INFERRED RO). ";
        field { name = "rsv_1"; desc = ""; sw = r; hw = na; reset = 0x0; } rsv_1[31:8];
        field { name = "hdcp1x_key_aksv_byte4"; desc = ""; sw = r; hw = w; reset = 0x0; } hdcp1x_key_aksv_byte4[7:0];
    } HDCP1X_KEY_AKSV1 @ 0x8;
    reg {
        name = "HDCP_MUTE_CTRL";
        desc = "HDCP_MUTE_CTRL (offset 0xC in this sub-block, absolute 0x1300200C). Reset INIT 0x00000000. PROVEN: vendor register header. Driver usage (vendor hal/drv C, uncommented call sites): 2 Get, 2 Set (hdmi_hal_hdcp14.c): read and written (RW). ";
        field { name = "rsv_2"; desc = ""; sw = r; hw = na; reset = 0x0; } rsv_2[31:6];
        field { name = "hdcp2x_amute_ctrl"; desc = ""; sw = rw; hw = r; reset = 0x0; } hdcp2x_amute_ctrl[5:4];
        field { name = "hdcp2x_vmute_ctrl"; desc = ""; sw = rw; hw = r; reset = 0x0; } hdcp2x_vmute_ctrl[3:3];
        field { name = "hdcp1x_amute_ctrl"; desc = ""; sw = rw; hw = r; reset = 0x0; } hdcp1x_amute_ctrl[2:1];
        field { name = "hdcp1x_vmute_ctrl"; desc = ""; sw = rw; hw = r; reset = 0x0; } hdcp1x_vmute_ctrl[0:0];
    } HDCP_MUTE_CTRL @ 0xC;
