regfile eHI3536D_HDMI_aon {
    name = "HDMI TX aon, Hi3536D V100 / HDMI v2 (hisiv100)";
    desc = "TX always-on block (HW info/version, reset control). Offsets are relative to the sub-block base 0x13004000 (HDMI TX window 0x13000000 + 0x4000). Provenance: PROVEN (vendor code): register names, offsets, field names/bit ranges and reset (INIT) values come from the machine-generated register headers of the vendor HDMI v2 driver (nManager-generated hdmi_reg_aon.h, product/hiosd/hdmi/hdmi_v2/drv/hal in the vendor U-Boot tree for the Hi3536D/Hi3536C/Hi3531D/Hi3521D family, source: sources/openipc-u-boot-hi3536dv100); the Hi3536D V100 maps the window at 0x13000000 per its hdmi_product_define.h and the closed hi3536dv100_hdmi.ko symbol names (HDMI_TX_S_*_REGS_TYPE_Init) agree. INFERRED: access types. Of the 503 register definitions in the vendor headers only 38 carry an ATTR (all RW); the others have none, so fields are modelled read/write except reserved/rsv fields and registers whose names mark them read-only by convention where the vendor hal/drv C sources call the accessors (203 registers) a register only ever read is modelled sw=r and the call-site counts are in each register description; for the other registers the name convention (SW_VER*, HW_INFO/HW_VERSION/HW_FEATURE, _STATUS, _STAT, _STATE, _OUT<n>: sw=r) is used. The 8051 MCU window (mcu sub-block) is modelled the same way and its function is inferred from the HDCP2X_* names only and hardware behavior; nothing run on hardware. NOT in the data sheet (no HDMI TX chapter)." ;
    reg {
        name = "TX_HW_INFO";
        desc = "TX_HW_INFO (offset 0x0 in this sub-block, absolute 0x13004000). Reset INIT 0x07DF0912. PROVEN: vendor register header. No call site in the vendor hal/drv C sources: access by register-name convention only (INFERRED). ";
        field { name = "tx_hw_year"; desc = ""; sw = r; hw = w; reset = 0x7DF; } tx_hw_year[31:16];
        field { name = "tx_hw_month"; desc = ""; sw = r; hw = w; reset = 0x9; } tx_hw_month[15:8];
        field { name = "tx_hw_day"; desc = ""; sw = r; hw = w; reset = 0x12; } tx_hw_day[7:0];
    } TX_HW_INFO @ 0x0;
    reg {
        name = "TX_HW_VERSION";
        desc = "TX_HW_VERSION (offset 0x4 in this sub-block, absolute 0x13004004). Reset INIT 0x00101010. PROVEN: vendor register header. No call site in the vendor hal/drv C sources: access by register-name convention only (INFERRED). ";
        field { name = "rsv_0"; desc = ""; sw = r; hw = na; reset = 0x0; } rsv_0[31:24];
        field { name = "tx_rtl_version"; desc = ""; sw = r; hw = w; reset = 0x10; } tx_rtl_version[23:16];
        field { name = "tx_drv_version"; desc = ""; sw = r; hw = w; reset = 0x10; } tx_drv_version[15:8];
        field { name = "tx_reg_version"; desc = ""; sw = r; hw = w; reset = 0x10; } tx_reg_version[7:0];
    } TX_HW_VERSION @ 0x4;
    reg {
        name = "TX_HW_FEATURE";
        desc = "TX_HW_FEATURE (offset 0x8 in this sub-block, absolute 0x13004008). Reset INIT 0x00000000. PROVEN: vendor register header. No call site in the vendor hal/drv C sources: access by register-name convention only (INFERRED). ";
        field { name = "rsv_1"; desc = ""; sw = r; hw = na; reset = 0x0; } rsv_1[31:0];
    } TX_HW_FEATURE @ 0x8;
    reg {
