            sw = rw; hw = r;
            reset = 0x0;
        } usb2_phy_test_rstn[23:23];
        field {
            name = "phy_test_reg_access";
            desc = "USB 2.0 PHY register access mode
- 0: register access mode (indirect: write enable, address and data fields below)
- 1: bus access mode (the PHY registers appear at offset 0x8000 of the MISC_CTRL block; the vendor kernel sets this bit before it writes the tuning registers)";
            sw = rw; hw = r;
            reset = 0x0;
        } phy_test_reg_access[22:22];
        field {
            name = "usb2_phy_test_wren";
            desc = "Read/write control for the USB 2.0 PHY test register (register access mode)
- 0: read enable
- 1: write enable";
