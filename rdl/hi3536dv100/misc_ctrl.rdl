`ifndef HI3536D_MISC_CTRL_RDL
`define HI3536D_MISC_CTRL_RDL
regfile eHI3536D_MISC_CTRL {
    name = "Peripheral control (MISC) incl. USB 2.0 PHY and FE PHY trim, Hi3536D V100";
    desc = "Peripheral control (MISC) incl. USB 2.0 PHY and FE PHY trim of the Hi3536D V100 at base 0x12120000. 16 registers extracted programmatically from the Hi3536D V100 data sheet (Issue 00B04, 2017-12-13, Table 3-10 and Table 11-18), register descriptions and field tables; reset values are the data sheet total reset values split onto the fields. Source: dl/research-hi3536 ReleaseDoc (unofficial copy of the HiSilicon SDK documentation; facts only). Field names, bit ranges, access types and reset values are exact; the free-text descriptions are attributed to fields from the PDF text layout (title sentence above the bit row, enumerations below) and can be shifted by one field where a sentence wraps: check the data sheet page when a description matters. Hardware not yet verified (no Hi3536D board on the bench).";
    reg {
        name = "MISC_CTRL2";
        desc = "MISC_CTRL2 is peripheral function selection register 0. (offset 0x8, total reset 0x000033C0; PROVEN: Hi3536D V100 data sheet).";
        field {
            name = "reserved_31_12";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x3;
        } reserved_31_12[31:12];
        field {
            name = "rom_pgen";
            desc = "System ROM power supply enable 0: enabled 1: disabled";
            sw = rw; hw = r;
            reset = 0x0;
        } rom_pgen[11:11];
        field {
            name = "jtag_sel";
            desc = "JTAG interface selection 0: CPU 1: DDRC";
            sw = rw; hw = r;
            reset = 0x0;
        } jtag_sel[10:10];
        field {
            name = "reserved_9_8";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x3;
        } reserved_9_8[9:8];
        field {
            name = "vgs_bootram_mode";
            desc = "VGS RAM working mode 1: BOOTRAM function 0: VGS function";
            sw = rw; hw = r;
            reset = 0x1;
        } vgs_bootram_mode[7:7];
        field {
            name = "reserved_6_0";
            desc = "Reserved";
            sw = r; hw = na;
            reset = 0x40;
        } reserved_6_0[6:0];
    } MISC_CTRL2 @ 0x8;
