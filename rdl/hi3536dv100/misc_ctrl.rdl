        field {
            name = "reserved_22_21";
            desc = "Reserved usb2_host_pwr_me enable signal. 1: enabled";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_22_21[22:21];
        field {
            name = "reserved_19_19";
            desc = "Enable bit controlling whether two USB ports use the same power [20]                  RW rge                                                0: disabled Reserved usb2_host_pwren_";
            sw = r; hw = na;
            reset = 0x1;
        } reserved_19_19[19:19];
        field {
            name = "f_0_";
            desc = "Power enable polarity control for the USB port active low pol 1: active high";
            sw = rw; hw = r;
            reset = 0x1;
        } f_0_[18:18];
        field {
            name = "reserved_17_14";
            desc = "Reserved usb2_host_p1_pwr";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_17_14[17:14];
        field {
            name = "f_0__13";
            desc = "Power shutdown control for the USB port 1 The power is shut down. 1: The output power of the USB controller is turned on.";
            sw = rw; hw = r;
            reset = 0x1;
        } f_0__13[13:13];
        field {
            name = "f_0__12";
            desc = "_en Power shutdown control for the USB 2.0 port 0 usb2_host_p0_pwr The power is shut down. 1: The output power of the USB 2.0 controller is turned on.";
            sw = rw; hw = r;
            reset = 0x1;
        } f_0__12[12:12];
        field {
            name = "reserved_11_10";
            desc = "_en Reserved usb2_host_ena_incr";
            sw = rw; hw = r;
            reset = 0x0;
        } reserved_11_10[11:10];
        field {
            name = "f_0__9";
            desc = "USB 2.0 controller burst16 enable disabled 16 1: enabled usb2_host_ena_incr";
            sw = rw; hw = r;
            reset = 0x1;
        } f_0__9[9:9];
        field {
            name = "f_0__8";
            desc = "USB 2.0 controller burst8 enable disabled 8 1: enabled usb2_host_ena_incr";
            sw = rw; hw = r;
            reset = 0x1;
        } f_0__8[8:8];
        field {
            name = "f_0__7";
            desc = "USB 2.0 controller burst4 enable disabled 4 1: enabled usb2_host_ena_incr";
            sw = rw; hw = r;
            reset = 0x1;
        } f_0__7[7:7];
        field {
            name = "f_0__6";
            desc = "USB 2.0 controller burst alignment enable disabled x_align 1: enabled";
            sw = rw; hw = r;
            reset = 0x1;
        } f_0__6[6:6];
        field {
            name = "reserved_5_3";
            desc = "Reserved usb2_host_app_star";
            sw = r; hw = na;
            reset = 0x4;
        } reserved_5_3[5:3];
        field {
