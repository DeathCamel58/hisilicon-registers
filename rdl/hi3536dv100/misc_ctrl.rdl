`ifndef HI3536D_MISC_CTRL_RDL
`define HI3536D_MISC_CTRL_RDL
regfile eHI3536D_MISC_CTRL {
    name = "Peripheral control (MISC) incl. USB 2.0 PHY and FE PHY trim, Hi3536D V100";
    desc = "Peripheral control (MISC) incl. USB 2.0 PHY and FE PHY trim, Hi3536D V100 of the Hi3536D V100 at base 0x1212_0000. 16 registers extracted programmatically from the Hi3536D V100 data sheet (Issue 00B04, 2017-12-13) (Table 3-10 Summary of peripheral control registers (base address: 0x1212_0000)): register headings, offsets, total reset values, field bit ranges, access types, names, reset values and descriptions, with PDF page numbers in each register description. Field names, bit ranges, access types and offsets are exact; the free-text descriptions are taken from the cell text of the field table and were checked by sampling only. Hardware not verified.";
    reg {
        name = "MISC_CTRL2";
        desc = "MISC_CTRL2 is peripheral function selection register 0. (offset 0x8; total reset 0x000033C0; PROVEN: Hi3536D V100 data sheet (Issue 00B04, 2017-12-13), section 3.5.5.2, PDF page 129).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = rw; hw = r;
            reset = 0x3;
        } reserved_31_12[31:12];
        field {
            name = "rom_pgen";
            desc = "System ROM power supply enable
- 0: enabled
- 1: disabled";
            sw = rw; hw = r;
            reset = 0x0;
        } rom_pgen[11:11];
        field {
            name = "jtag_sel";
            desc = "JTAG interface selection
- 0: CPU
- 1: DDRC";
            sw = rw; hw = r;
            reset = 0x0;
        } jtag_sel[10:10];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = rw; hw = r;
            reset = 0x3;
        } reserved_9_8[9:8];
        field {
            name = "vgs_bootram_mode";
            desc = "VGS RAM working mode
- 1: BOOTRAM function
- 0: VGS function

Vendor code (PROVEN, static: hi3536dv100_sys.ko SYS_HAL_VgsClkEn, called when the VGS clock is enabled): the bit is CLEARED together with the clock enable, so the VGS only works with the bit at 0 (INFERRED: the VGS RAM is the boot RAM while it is 1; the effect has not been observed on hardware). The reset value is 1.";
            sw = rw; hw = r;
            reset = 0x1;
        } vgs_bootram_mode[7:7];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x40;
        } reserved_6_0[6:0];
    } MISC_CTRL2 @ 0x8;
    reg {
        name = "MISC_CTRL20";
        desc = "MISC_CTRL20 is USB 2.0 control register 0. (offset 0x50; total reset 0x000C33E0; PROVEN: Hi3536D V100 data sheet (Issue 00B04, 2017-12-13), section 3.5.5.2, PDF page 130).";
