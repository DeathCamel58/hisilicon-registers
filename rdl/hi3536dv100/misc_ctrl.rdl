            reset = 0x0;
        } mdio_enb[20:20];
        field {
            name = "mdio_o";
            desc = "output of the FE PHY in patch mode mdio_o fun_fephy_patch_";
            sw = r; hw = w;
            reset = 0x0;
        } mdio_o[19:19];
        field {
            name = "mdio_i";
            desc = "input of the FE PHY in patch mode mdio_i fun_fephy_patch_";
            sw = rw; hw = r;
            reset = 0x0;
        } mdio_i[18:18];
        field {
            name = "mdck";
            desc = "input of the FE PHY in patch mode mdck 0: disabled fun_fephy_patch_e 1: enabled [16]                        RW n                 Note: same time.";
            sw = rw; hw = r;
            reset = 0x0;
        } mdck[17:17];
        field {
            name = "reserved_15_0";
            desc = "FE PHY patch mode control The patch mode and the I/O test mode do not take effect at the Reserved";
