// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3536dv100-logic" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3536D V100: logic block diagram</B><BR/><FONT POINT-SIZE="11">redrawn from data sheet Figure 1-2 (chapter 1.2.1)</FONT>>, fontcolor="#808080", rankdir=LR, compound=true, newrank=true];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  bus [label="AMBA 3.0 bus", fillcolor="#9a9a9a"  shape=box, height=5.2, width=0.5, fontcolor="white"];
  subgraph cluster_cpu { label="CPU subsystem"; fontcolor="#808080"; color="#808080"; style="rounded";
  cpu [label="Cortex-A7 850 MHz, NEON + FPU\n32 KB I + 32 KB D L1, 128 KB L2", fillcolor="#e0b86f"  ];
  }
  ddrc [label="DDRC", fillcolor="#8fb3de"  ];
  ddrext [label="16-bit DDR3 / DDR3L\nup to 800 MHz", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  ddrext -> ddrc [dir=both]; ddrc -> cpu [dir=both]; ddrc -> bus [dir=both, style=dashed];
  subgraph cluster_l0 { label="High-speed peripherals"; fontcolor="#808080"; color="#808080"; style="rounded";
    sata [label="SATA 2.0 (PM, eSATA)", fillcolor="#8fb3de"  ];
    fmc [label="FMC (SPI NOR / NAND)", fillcolor="#8fb3de"  ];
    eth [label="FE PHY + MAC (TSO)", fillcolor="#8fb3de"  ];
    usb [label="USB 2.0 host x2", fillcolor="#8fb3de"  ];
    aiao [label="I2S + audio DAC", fillcolor="#8fb3de"  ];
  }
  sata -> bus [dir=both];
  fmc -> bus [dir=both];
  eth -> bus [dir=both];
  usb -> bus [dir=both];
  aiao -> bus [dir=both];
  subgraph cluster_l1 { label="Security and DMA"; fontcolor="#808080"; color="#808080"; style="rounded";
    cipher [label="AES / DES / 3DES", fillcolor="#c9a0dc"  ];
    dmac [label="DMAC", fillcolor="#c9a0dc"  ];
  }
  cipher -> bus [dir=both];
  dmac -> bus [dir=both];
  subgraph cluster_r0 { label="Image subsystem"; fontcolor="#808080"; color="#808080"; style="rounded";
    vgs [label="VGS", fillcolor="#a6c98f"  ];
    tde [label="TDE", fillcolor="#a6c98f"  ];
    vdp [label="VDP / HDMI / VGA", fillcolor="#a6c98f"  ];
  }
  bus -> vgs [dir=both];
  bus -> tde [dir=both];
  bus -> vdp [dir=both];
  subgraph cluster_r1 { label="Video subsystem"; fontcolor="#808080"; color="#808080"; style="rounded";
    dec [label="H.265 / H.264 decoder", fillcolor="#a6c98f"  ];
    jpgd [label="JPEG / MJPEG decoder", fillcolor="#a6c98f"  ];
    jpge [label="JPEG encoder", fillcolor="#a6c98f"  ];
  }
  bus -> dec [dir=both];
  bus -> jpgd [dir=both];
  bus -> jpge [dir=both];
  subgraph cluster_r2 { label="Low-speed peripherals"; fontcolor="#808080"; color="#808080"; style="rounded";
    lsp [label="RTC, I2C, IR, UART x3, GPIO, PMC", fillcolor="#7fcdc4"  ];
    rom [label="SRAM, BootROM", fillcolor="#7fcdc4"  ];
  }
  bus -> lsp [dir=both];
  bus -> rom [dir=both];
  hdd [label="SATA hard disk", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  hdd -> sata [dir=both, style=dashed];
  flash [label="SPI NOR / NAND flash", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  flash -> fmc [dir=both, style=dashed];
  phy [label="RJ-45", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  phy -> eth [dir=both, style=dashed];
  usbp [label="USB disk / mouse", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  usbp -> usb [dir=both, style=dashed];
  spk [label="Audio codec / speaker", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  spk -> aiao [dir=both, style=dashed];
  bus -> cpu [dir=both];
}
