// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3536dv100-boot" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3536D V100: boot flow</B><BR/><FONT POINT-SIZE="11">data sheet 1.3, Table 1-1 (BOOTROM_SEL is multiplexed with pin MDCK)</FONT>>, fontcolor="#808080", rankdir=TB];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  por [label="Power-on reset", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  sel [label="BOOTROM_SEL ?", fillcolor="#d6d27a"   shape=diamond];
  rom [label="BOOTROM\n(address 0 after reset)", fillcolor="#e0b86f"  ];
  ser [label="Serial download over the UART\n(HiBurn tool)", fillcolor="#8fb3de"  ];
  to [label="Serial link\ntimed out?", fillcolor="#d6d27a"   shape=diamond];
  fl [label="External SPI NOR / SPI NAND flash\n(FMC)", fillcolor="#8fb3de"  ];
  run [label="Boot program runs;\nremap cleared, on-chip RAM at address 0", fillcolor="#a6c98f"  ];
  por -> sel;
  sel -> rom [label="1"];
  sel -> fl [label="0"];
  rom -> ser;
  ser -> to;
  to -> run [label="download done"];
  to -> fl [label="yes"];
  fl -> run;
}
