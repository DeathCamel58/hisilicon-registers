// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3536dv100-video" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3536D V100: decode and display data path</B><BR/><FONT POINT-SIZE="11">block names from the data sheet chapter 1 / memory map; arrows are the usual NVR data path (INFERRED, not tabulated in the data sheet); the chip has no video-input block</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  io [label="SATA 2.0 / FE ETH (MAC + PHY) /\nUSB 2.0 host x2 / FMC flash\n(recorded streams in)", fillcolor="#8fb3de"  ];
  ddr [label="DDR3 / DDR3L, 16 bit", fillcolor="#e0b86f"  ];
  scd [label="SCD\n(stream chunk detect)", fillcolor="#a6c98f"  ];
  vdh [label="VDH\nH.265 / H.264 decoder", fillcolor="#a6c98f"  ];
  jpgd [label="JPGD\nMJPEG / JPEG decode", fillcolor="#a6c98f"  ];
  jpge [label="JPGE\nJPEG encode", fillcolor="#a6c98f"  ];
  vgs [label="VGS\nscale, sharpen, cover, OSD", fillcolor="#a6c98f"  ];
  tde [label="TDE\ngraphics", fillcolor="#a6c98f"  ];
  vdp [label="VDP (VOU)\nvideo layer (16 pictures), PIP, graphics, cursor", fillcolor="#a6c98f"  ];
  hdmi [label="HDMI 1.4b TX (controller + PHY) / VGA", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  aiao [label="AIAO + audio DAC\n(I2S)", fillcolor="#a6c98f"  ];
  audio [label="line out", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  io -> ddr;
  ddr -> scd;
  scd -> vdh;
  ddr -> vdh [label="streams"];
  ddr -> jpgd;
  vdh -> vgs;
  jpgd -> vgs;
  vgs -> vdp;
  tde -> vdp [label="graphics"];
  vdp -> hdmi;
  ddr -> jpge [label="snapshots"];
  ddr -> aiao;
  aiao -> audio;
}
