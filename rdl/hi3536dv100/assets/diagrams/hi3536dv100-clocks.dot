// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3536dv100-clocks" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3536D V100: clock tree</B><BR/><FONT POINT-SIZE="11">data sheet 3.2.3-3.2.5 (Figure 3-3, Tables 3-2 to 3-6): default / optional clock per module as printed in Table 3-2; the PLL that supplies a fixed frequency is read from the frequency lists of the figure (INFERRED where noted by adjacency)</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  xin [label="XIN 24 MHz crystal", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  rtcx [label="RTC_XIN\n32.768 kHz crystal", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  eth [label="RMII_CLK, MII_RXCK, MII_TXCK\n(ETH interface clocks)", fillcolor="#d0d0d0" style="filled,dashed,rounded" ];
  apll [label="APLL (programmable)\nPERI_CRG_PLL0 / PERI_CRG_PLL1\nFOUTVCO max 1100 MHz", fillcolor="#e6a0a0"  ];
  dpll [label="DPLL (programmable)\nPERI_CRG_PLL10 / PERI_CRG_PLL11\nFOUTPOSTDIV default 400 MHz", fillcolor="#e6a0a0"  ];
  vpll0 [label="VPLL0 (programmable)\nPERI_CRG_PLL2 / PERI_CRG_PLL3\nFOUTPOSTDIV default 594 MHz;\nCLK_VPLL0_DIV default 148.5 MHz", fillcolor="#e6a0a0"  ];
  vpll1 [label="VPLL1 (programmable)\nPERI_CRG_PLL4 / PERI_CRG_PLL5\nFOUTPOSTDIV default 786.432 MHz (max 800)", fillcolor="#e6a0a0"  ];
  vpll2 [label="VPLL2 (fixed)\nPERI_CRG_PLL6 / PERI_CRG_PLL7\nFOUTVCO 1620 MHz; 162 / 54 MHz;\ndividers 405 / 202.5 / 27 MHz", fillcolor="#e6a0a0"  ];
  epll [label="EPLL (fixed)\nPERI_CRG_PLL8 / PERI_CRG_PLL9\nFOUTVCO 1500 MHz; 500 / 250 / 125 / 83.3 MHz;\ndividers 300 / 150 / 100 / 60 / 50 / 31.25 / 25 MHz", fillcolor="#e6a0a0"  ];
  a7 [label="Cortex-A7 (A7)\n24 MHz or APLL FOUTPOSTDIV\na7_sc_sel PERI_CRG20[7:6]", fillcolor="#e0b86f"  ];
  ddr [label="DDR subsystem\n24 MHz or DPLL FOUTPOSTDIV\nddr_sc_sel PERI_CRG20[5:4]", fillcolor="#8fb3de"  ];
  bus [label="sysbus 24 or 202.5 MHz (PERI_CRG20[3:2]);\nmdaapb 24 or 100 MHz (PERI_CRG20[1]); sysapb 24 or 50 MHz (PERI_CRG20[0])", fillcolor="#8fb3de"  ];
  vdp [label="VDP\n202.5 (default) or 100 MHz\nvdp_cksel PERI_CRG34[6]", fillcolor="#a6c98f"  ];
  hdmi [label="HDMI\nVPLL0 FOUTPOSTDIV or CLK_VPLL0_DIV", fillcolor="#a6c98f"  ];
  aiao [label="AIAO core 100 or 50 MHz (PERI_CRG43[3]);\nAIAO PLL: VPLL1 FOUTPOSTDIV or 500 MHz (PERI_CRG43[2])", fillcolor="#a6c98f"  ];
  sata [label="SATA PHY0 reference\n100 (default) or 25 MHz (PERI_CRG44[3:2])", fillcolor="#8fb3de"  ];
  fmc [label="FMC\n24 (default), 83.3 or 150 MHz (PERI_CRG48[3:2])", fillcolor="#8fb3de"  ];
  ethc [label="ETH core 54 (default) or 100 MHz (PERI_CRG49[7]);\nexternal PHY clock PERI_CRG49[5:4]; RMII clock PERI_CRG49[2]", fillcolor="#8fb3de"  ];
  usbp [label="USB 2.0 PHY PLL reference\nPERI_CRG46[20]", fillcolor="#8fb3de"  ];
  rtc [label="RTC reference", fillcolor="#7fcdc4"  ];
  uart [label="UART clock select PERI_CRG51[19:18]", fillcolor="#7fcdc4"  ];
  tmr [label="divided clocks 200 kHz / 1 / 2 / 3 MHz\n(consumers not named in the figure text)", fillcolor="#7fcdc4"  ];
  xin -> apll;
  xin -> dpll;
  xin -> vpll0;
  xin -> vpll1;
  xin -> vpll2;
  xin -> epll;
  xin -> a7 [label="default"];
  xin -> ddr [label="default"];
  xin -> bus [label="default"];
  xin -> usbp;
  xin -> uart;
  rtcx -> rtc;
  eth -> ethc;
  apll -> a7 [label="FOUTPOSTDIV"];
  apll -> tmr [label="divider"];
  dpll -> ddr [label="FOUTPOSTDIV"];
  vpll0 -> hdmi;
  vpll1 -> aiao;
  vpll2 -> vdp [label="202.5 MHz"];
  vpll2 -> bus [label="202.5 MHz"];
  epll -> vdp [label="100 MHz"];
  epll -> aiao [label="100 / 50 / 500 MHz"];
  epll -> sata [label="100 / 25 MHz"];
  epll -> fmc [label="83.3 / 150 MHz"];
  epll -> ethc [label="100 MHz"];
  vpll2 -> ethc [label="54 MHz"];
  epll -> bus [label="100 / 50 MHz"];
}
