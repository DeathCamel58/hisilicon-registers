// written by scripts/rdl-extract/diagrams_handmade.py (edit the spec there, then regenerate)
digraph "hi3536dv100-bus" {
  graph [bgcolor=transparent, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.2, nodesep=0.3, ranksep=0.55,
         label=<<B>Hi3536D V100: bus clock domains</B><BR/><FONT POINT-SIZE="11">bus clock domains from the data sheet clock chapter; the data sheet has no master/slave bus matrix or QoS table (INFERRED: the role named in each domain label)</FONT>>, fontcolor="#808080", rankdir=LR];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, color="#505050", fontcolor="#101010", fillcolor="#8fb3de", margin="0.12,0.06"];
  edge [color="#808080", fontname="Helvetica", fontsize=9, fontcolor="#808080", arrowsize=0.7];

  a7 [label="Cortex-A7 + L2 (128 KB)\n128-bit ACE interface,\nasynchronous to the system bus\na7_sc_sel PERI_CRG20[7:6]", fillcolor="#e0b86f"  ];
  sysbus [label="sysbus\n24 / 202.5 MHz\nsysbus_sc_sel PERI_CRG20[3:2]", fillcolor="#9a9a9a"  ];
  ddr [label="DDR subsystem\n24 MHz or DPLL FOUTPOSTDIV\nddr_sc_sel PERI_CRG20[5:4]", fillcolor="#8fb3de"  ];
  mda [label="mdaapb\n24 / 100 MHz\nPERI_CRG20[1]", fillcolor="#9a9a9a"  ];
  sapb [label="sysapb\n24 / 50 MHz\nPERI_CRG20[0]", fillcolor="#9a9a9a"  ];
  media [label="media blocks (INFERRED from the domain name):\nVDH, JPGD/JPGE, TDE, VGS, VDP, AIAO, HDMI", fillcolor="#a6c98f"  ];
  per [label="peripherals on APB: UART, I2C, GPIO, timers, WDG, RTC, IR, PMC", fillcolor="#7fcdc4"  ];
  a7 -> sysbus [label="ACE (async)"];
  sysbus -> ddr;
  sysbus -> mda;
  sysbus -> sapb;
  mda -> media;
  sapb -> per;
}
