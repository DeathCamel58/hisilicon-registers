    reg {
        name = "QOSB_CFG_PERF";
        desc = "QOSB_CFG_PERF is a QoSBuf performance statistical mode register. (offset 0x120, total reset 0x00000000; PROVEN: Hi3536D V100 data sheet).";
        field {
            name = "reserved_31_30";
            desc = "Reserved 1: enabled 0: disabled";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_30[31:30];
        field {
            name = "perf_en";
            desc = "Performance statistics enable register starts the cyclic count. When perf_mode is 1, this bit is automatically cleared after the counting is complete. 0: continuous trigger mode. Counters related to performance statistics keep counting to ensure that no data overflows within 1s. 1: single trigger mode. When the performance statistical period";
            sw = rw; hw = r;
            reset = 0x0;
        } perf_en[29:29];
        field {
            name = "perf_mode";
            desc = "When perf_mode is 0 and this bit is enabled, the performance statistics Performance statistical mode reaches the value of perf_prd, the statistical result retains and the counting stops. 0x0: invalid 0x1−0xFFFFFFF: statistical cycle";
            sw = rw; hw = r;
            reset = 0x0;
        } perf_mode[28:28];
        field {
            name = "perf_prd";
            desc = "The maximum statistical result retains after an overflow occurs. Performance statistical cycle The actual statistical cycle is (perf_prd x 16 x tclk). tclk is the bus clock cycle of the DDRC. This configuration is valid only when perf_mode is 1. When perf_mode is 0, counters related to performance statistics keep counting.";
            sw = rw; hw = r;
            reset = 0x0;
        } perf_prd[27:0];
    } QOSB_CFG_PERF @ 0x120;
