`ifndef HI3536D_DDRC_QOSB_RDL
`define HI3536D_DDRC_QOSB_RDL
regfile eHI3536D_DDRC_QOSB {
    name = "DDRC QoS buffer registers, Hi3536D V100";
    desc = "DDRC QoS buffer registers of the Hi3536D V100 at base 0x12114000. 20 registers extracted programmatically from the Hi3536D V100 data sheet (Issue 00B04, 2017-12-13, Table 4-5), register descriptions and field tables; reset values are the data sheet total reset values split onto the fields. Source: dl/research-hi3536 ReleaseDoc (unofficial copy of the HiSilicon SDK documentation; facts only). Field names, bit ranges, access types and reset values are exact; the free-text descriptions are attributed to fields from the PDF text layout (title sentence above the bit row, enumerations below) and can be shifted by one field where a sentence wraps: check the data sheet page when a description matters. Hardware not yet verified (no Hi3536D board on the bench).";
    reg {
        name = "QOSB_ADPT_CTRL";
        desc = "QOSB_ADPT_CTRL is a QoSBuf adaptation configuration register. (offset 0x4, total reset 0x00000FF0; PROVEN: Hi3536D V100 data sheet).";
        field {
            name = "reserved_31_20";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_20[31:20];
        field {
            name = "adpt_share_cnt";
            desc = "Adapt counter for lower bits. When the value of this counter decreases to 0, the counter for upper bits corresponding to each";
            sw = rw; hw = r;
            reset = 0xff;
        } adpt_share_cnt[19:4];
        field {
            name = "reserved_3_1";
            desc = "CMD decreases by 1. Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_3_1[3:1];
        field {
            name = "adpt_en";
            desc = "Adapt enable 0: disabled 1: enabled";
            sw = rw; hw = r;
            reset = 0x0;
        } adpt_en[0:0];
    } QOSB_ADPT_CTRL @ 0x4;
    reg {
        name = "QOSB_BUF_BYP";
        desc = "QOSB_BUF_BYP (offset 0x88, total reset 0x00000000; PROVEN: Hi3536D V100 data sheet).";
        field {
            name = "reserved_31_2";
            desc = "Reserved x0: forcible non-bypass mode. That is, all the commands enter the 01: whether to bypass depends on the queue status in the DMC";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_2[31:2];
        field {
            name = "qos_buf_byp";
            desc = "QoSBuf bypass control QoSBuf module when the value is set to 00 or 10. 11: forcible bypass mode. None of the commands enter the configuration is forbidden during the access. QoSBuf module. These modes need to be configured before the access. The dynamic";
            sw = rw; hw = r;
            reset = 0x0;
        } qos_buf_byp[1:0];
    } QOSB_BUF_BYP @ 0x88;
    reg {
        name = "QOSB_WRTOUT0";
        desc = "QOSB_WRTOUT0 is QoSBuf write command timeout period register 0. (offset 0x9C, total reset 0x00000000; PROVEN: Hi3536D V100 data sheet).";
        field {
            name = "wr_tout3";
            desc = "Write command timeout period (level 3)";
            sw = rw; hw = r;
            reset = 0x0;
        } wr_tout3[31:24];
        field {
            name = "wr_tout2";
            desc = "The configuration mode is the same as that of wr_tout0. Write command timeout period (level 2)";
            sw = rw; hw = r;
            reset = 0x0;
        } wr_tout2[23:16];
        field {
            name = "wr_tout1";
            desc = "The configuration mode is the same as that of wr_tout0. Write command timeout period (level 1) 0x0: The timeout function is disabled.";
            sw = rw; hw = r;
            reset = 0x0;
        } wr_tout1[15:8];
        field {
            name = "wr_tout0";
            desc = "The configuration mode is the same as that of wr_tout0. Write command timeout period (level 0) 0x1−0xFF: n x 4 clock cycles When the timeout period is set to 8 bits, the actual count value is 10 bits. That is, the lower two bits are fixed at 0.";
            sw = rw; hw = r;
            reset = 0x0;
        } wr_tout0[7:0];
    } QOSB_WRTOUT0 @ 0x9C;
    reg {
        name = "QOSB_WRTOUT1";
        desc = "QOSB_WRTOUT1 is QoSBuf write command timeout period register 1. (offset 0xA0, total reset 0x00000000; PROVEN: Hi3536D V100 data sheet).";
        field {
            name = "wr_tout7";
            desc = "Write command timeout period (level 7)";
            sw = rw; hw = r;
            reset = 0x0;
        } wr_tout7[31:24];
        field {
