            sw = rw; hw = r;
            reset = 0x0;
        } rd_tout4[7:0];
    } QOSB_RDTOUT1 @ 0xB0;
    reg {
        name = "QOSB_RDTOUT2";
        desc = "QOSB_RDTOUT2 is QoSBuf read command timeout period register 2. (offset 0xB4, total reset 0x00000000; PROVEN: Hi3536D V100 data sheet).";
        field {
