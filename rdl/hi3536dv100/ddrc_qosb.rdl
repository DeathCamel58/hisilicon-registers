            desc = "The configuration mode is the same as that of rd_tout0. Read command timeout period (level 0) 0x1−0xFF: n x 4 clock cycles When the timeout period is set to 8 bits, the actual count value is 10 bits. That is, the lower two bits are fixed at 0.";
            sw = rw; hw = r;
            reset = 0x0;
        } rd_tout0[7:0];
    } QOSB_RDTOUT0 @ 0xAC;
    reg {
        name = "QOSB_RDTOUT1";
        desc = "QOSB_RDTOUT1 is QoSBuf read command timeout period register 1. (offset 0xB0, total reset 0x00000000; PROVEN: Hi3536D V100 data sheet).";
        field {
            name = "rd_tout7";
