            sw = rw; hw = r;
            reset = 0x0;
        } wr_tout8[7:0];
    } QOSB_WRTOUT2 @ 0xA4;
    reg {
        name = "QOSB_WRTOUT3";
        desc = "QOSB_WRTOUT3 is QoSBuf write command timeout period register 3. (offset 0xA8, total reset 0x00000000; PROVEN: Hi3536D V100 data sheet).";
        field {
            name = "wr_tout15";
