            desc = "The configuration mode is the same as that of wr_tout0. Write command timeout period (level 6)";
            sw = rw; hw = r;
            reset = 0x0;
        } wr_tout6[23:16];
        field {
            name = "wr_tout5";
            desc = "The configuration mode is the same as that of wr_tout0. Write command timeout period (level 5)";
            sw = rw; hw = r;
            reset = 0x0;
        } wr_tout5[15:8];
        field {
            name = "wr_tout4";
            desc = "The configuration mode is the same as that of wr_tout0. Write command timeout period (level 4) The configuration mode is the same as that of wr_tout0.";
            sw = rw; hw = r;
            reset = 0x0;
        } wr_tout4[7:0];
    } QOSB_WRTOUT1 @ 0xA0;
    reg {
        name = "QOSB_WRTOUT2";
        desc = "QOSB_WRTOUT2 (offset 0xA4, total reset 0x00000000; PROVEN: Hi3536D V100 data sheet).";
        field {
            name = "wr_tout11";
            desc = "Write command timeout period (level 11)";
            sw = rw; hw = r;
            reset = 0x0;
        } wr_tout11[31:24];
        field {
