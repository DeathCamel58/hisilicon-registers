`ifndef HI3536D_TDE_NODE_RDL
`define HI3536D_TDE_NODE_RDL

addrmap aHI3536D_TDE_NODE {
    name = "TDE G2 job node layout (DDR, NOT hardware), Hi3536D V100";
    desc = "NOT HARDWARE: placeholder window (0x13140000, reserved in the data sheet) showing the layout of one TDE job node in DDR. The Hi3536D TDE is the G2 generation: jobs are submitted through the async list registers (AQ_NADDR 0x830 = node physical address, AQ_UPDATE 0x834 / AQ_UPDATE2 0x85C = 64-bit update mask, AQ_CTRL 0x82C bits 23:20, then TDE_CTRL 0x808 = 1; TdeHalNodeExecute in hi3536dv100_tde.ko, PROVEN). The node itself has the SAME 42-word layout as the Hi3520D G1 node: every TdeHalNodeSet* function of the Hi3536D module (SetSrc1/2, SetTgt, SetResize, SetFlicker, SetClipping, SetColorKey, SetColorize, SetBlend, SetBaseOperate, SetGlobalAlpha, SetRop, SetColorConvert, SetCsc, SetClutOpt, InitNd) touches the same word offsets and bit ranges as eHISI_TDE_G1_NODE (word offsets 0x00-0xA4, e.g. S1_TYPE 0x08 [15:0] pitch [20:16] fmt [21] [24] [25]; TAR_TYPE 0x2C; ALU 0x68 global alpha [20:13], ROP [12:9] and [8:5]; ALPHA_BLEND 0x9C; ICSC/OCSC addresses 0xA0/0xA4; flicker coefficients 0x58-0x64; clip 0x74/0x78) (PROVEN by disassembly; positions listed in docs/research/hi3536dv100-blocks.md section 10.2). Differences: the allocation is 196 bytes = a 16-byte header before the node plus 45 words (the three words after 0xA4 are INFERRED to be next-node address and 64-bit next update mask, as in the compact G1 node); word 0 bits [22:19] are initialized to 8 by TdeHalNodeInitNd and bit 21 is the completion-interrupt enable (PROVEN); a child node (resize second pass) stores its link in the clip words 0x74/0x78 (TdeHalNodeInitChildNd, INFERRED). Field names are those of the G1 description (HiSTB v1 names, vendor-derived, confidence as there).";
    eHISI_TDE_G1_NODE NODE @ 0x0;
};

`endif
