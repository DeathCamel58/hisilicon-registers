            name = "hor_luma_coef_addr";
            desc = "physical address of the table [PROVEN value, INFERRED that the engine reads it as a physical address]";
            sw = rw;
            hw = r;
        } hor_luma_coef_addr[31:0];
    } W_200 @ 0x200;

