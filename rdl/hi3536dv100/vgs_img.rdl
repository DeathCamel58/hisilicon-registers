`ifndef HI3536D_VGS_IMG_RDL
`define HI3536D_VGS_IMG_RDL

regfile eHI3536D_VGS_IMG {
    name = "VGS job register image (DDR, NOT registers), Hi3536D V100";
    desc = "BOARD 2026-11-23 (docs/drivers/vgs-design.md section 14): the node images the driver builds (nodes built by the driver's own builder, equal to the vendor builder on 3393 host jobs) RUN on the block: 1:1 copy and crop (exact), scaling 2:1, 1:2, 5:4, 4:3, 4:5 (corner-aligned sampling grid, triangle taps, phase table read as built), 4:2:0 <-> 4:2:2 (vertical chroma table at the CHROMA line ratio), 90 / 180 / 270 degree rotation (two nodes for 90 / 270, one node with 0x68 bits 5:4 for 180: the direction is clockwise for 90), strides that are not the width (112 for 100), sizes 32 x 32 to 2048 x 4096; 180 degrees also works with 4:2:2 and with a 4:2:2 -> 4:2:0 conversion in the same node. NV12 / NV21 and NV16 / NV61 need no format bit (the chroma pair is opaque). NOT A REGISTER FILE: the register image that VGS_DRV_SetVgsReg and VGS_DrvInitDefaultRegs of hi3536dv100_vgs.ko build in memory for one job; the job engine loads it (NEXT_NODE 0x2FC). 128 distinct words, offsets equal the engine register offsets. Generated by scripts/tools/arm-re (path-sensitive, --arg a0=IMG), documentation only. Provenance: PROVEN = offset, cleared bit extents, source expression and conditions read from the instruction stream; the source `stImgIn.x` / `stImgOut.x` names are INFERRED: a1[0x0] / a1[0x4] are taken to be pointers to the input / output VIDEO_FRAME_S of VGS_TASK_ATTR_S (member offsets from hi_comm_video.h, e.g. [0xC] = enPixelFormat); other a1[N] members belong to a driver-private job struct whose definition is not in the SDK (names UNKNOWN). Pixel-format fields hold PIXEL_FORMAT_E minus 0x17 (0 = YUV_SEMIPLANAR_420). Field extents are lower bounds. Not verified on hardware.";

    reg {
        name = "Task mode";
        desc = "Task mode word. PROVEN (dynamic): base value 0x80000008 for scale/crop/convert nodes (type 0, bypass, OSD-less); rotation tasks (types 5 = luma pass, 6 = chroma pass of VGS_AddRotateTask) add bits: 90 degrees = bit 22, 270 degrees = bits 22 and 21, plus bit 11 (luma pass, type 5) or bit 12 (chroma pass, type 6); 0 and 180 degrees leave the word at the base value. Other bits set by features this analysis did not use: bit 9 (bLTI, user option at +0x448), bit 5 (DCI, option at +0x468), bit 11 for a PIXEL_FORMAT 0x1D input. The type-5/6 passes of one picture are two nodes of one job. Provenance: DYNAMIC: the vendor node builder (VGS_DrvCommSubmitJobToVgs -> VGS_DrvCommPrepareNodes -> VGS_DRV_SetVgsReg, GenSclCfg, VGSSplitAndCrop) was run under qemu-arm with a fake register file and swept one input at a time (2026-11-23, scripts/tools/vgs-static/). Static source: hi3536dv100_vgs.ko (SDK 2.0.2.0 / Hi3536D_MPP_V1.0.1.0 B040, Dec 7 2017).";
        field {
            name = "const_3";
            desc = "always 1 [PROVEN value, meaning UNKNOWN]";
            sw = rw;
            hw = r;
        } const_3[3:3];
        field {
            name = "dci_en";
            desc = "DCI option on [PROVEN trigger, INFERRED meaning]";
            sw = rw;
            hw = r;
        } dci_en[5:5];
        field {
            name = "lti_en";
            desc = "bLTI option on [PROVEN trigger, INFERRED meaning]";
            sw = rw;
            hw = r;
        } lti_en[9:9];
        field {
            name = "rot_luma";
            desc = "luma plane pass of a 90/270 rotation [PROVEN trigger]";
            sw = rw;
            hw = r;
        } rot_luma[11:11];
        field {
            name = "rot_chroma";
            desc = "chroma plane pass of a 90/270 rotation [PROVEN trigger]";
            sw = rw;
            hw = r;
        } rot_chroma[12:12];
        field {
            name = "rot_dir";
            desc = "1 for 270 degrees [PROVEN trigger]";
            sw = rw;
            hw = r;
        } rot_dir[21:21];
        field {
            name = "rot_en";
            desc = "90 or 270 degree rotation [PROVEN trigger]";
            sw = rw;
            hw = r;
        } rot_en[22:22];
        field {
            name = "const_31";
            desc = "always 1 [PROVEN value, meaning UNKNOWN]";
            sw = rw;
            hw = r;
        } const_31[31:31];
    } W_000 @ 0x0;

    reg {
        name = "Image formats";
        desc = "Pixel formats of the pictures. PROVEN (dynamic): the field is 0 when the PIXEL_FORMAT_E value is 0x17 (SEMIPLANAR_420) and 1 for any other accepted value (22 = SEMIPLANAR_422; the vendor check VGS_CheckImage accepts 22, 23 and 29). Provenance: DYNAMIC: the vendor node builder (VGS_DrvCommSubmitJobToVgs -> VGS_DrvCommPrepareNodes -> VGS_DRV_SetVgsReg, GenSclCfg, VGSSplitAndCrop) was run under qemu-arm with a fake register file and swept one input at a time (2026-11-23, scripts/tools/vgs-static/). Static source: hi3536dv100_vgs.ko (SDK 2.0.2.0 / Hi3536D_MPP_V1.0.1.0 B040, Dec 7 2017).";
        field {
            name = "out_fmt";
            desc = "0 = semi-planar 4:2:0 output, 1 = other (4:2:2) [PROVEN]";
            sw = rw;
            hw = r;
        } out_fmt[15:12];
        field {
            name = "in_fmt";
            desc = "0 = semi-planar 4:2:0 input, 1 = other (4:2:2) [PROVEN]";
            sw = rw;
            hw = r;
        } in_fmt[20:16];
    } W_004 @ 0x4;

    reg {
        name = "Scaler enable";
        desc = "Word 0x8: base value 0x8 (bit 3) in scale/crop/convert nodes, 0 in 90/270 rotation nodes (PROVEN, dynamic). The static scan found further source bits (a1[0x25C] bit 3, a1[0xD0] bit 11, a1[0x1CC] bit 12): features this analysis did not exercise. Provenance: DYNAMIC: the vendor node builder (VGS_DrvCommSubmitJobToVgs -> VGS_DrvCommPrepareNodes -> VGS_DRV_SetVgsReg, GenSclCfg, VGSSplitAndCrop) was run under qemu-arm with a fake register file and swept one input at a time (2026-11-23, scripts/tools/vgs-static/). Static source: hi3536dv100_vgs.ko (SDK 2.0.2.0 / Hi3536D_MPP_V1.0.1.0 B040, Dec 7 2017).";
        field {
            name = "scaler_en";
            desc = "scaler path used: 1 in scale/crop/convert nodes, 0 in 90/270 rotation nodes [PROVEN value, INFERRED meaning]";
            sw = rw;
            hw = r;
        } scaler_en[3:3];
    } W_008 @ 0x8;

    reg {
        name = "Input size";
        desc = "Size of the (cropped) input rectangle minus one, type-0 task (scale/crop/convert), no split (width <= 2048). Provenance: DYNAMIC: the vendor node builder (VGS_DrvCommSubmitJobToVgs -> VGS_DrvCommPrepareNodes -> VGS_DRV_SetVgsReg, GenSclCfg, VGSSplitAndCrop) was run under qemu-arm with a fake register file and swept one input at a time (2026-11-23, scripts/tools/vgs-static/). Static source: hi3536dv100_vgs.ko (SDK 2.0.2.0 / Hi3536D_MPP_V1.0.1.0 B040, Dec 7 2017).";
        field {
            name = "in_w_m1";
            desc = "input width - 1 after crop [PROVEN]";
            sw = rw;
            hw = r;
        } in_w_m1[12:0];
        field {
            name = "in_h_m1";
            desc = "input height - 1 after crop [PROVEN]";
            sw = rw;
            hw = r;
        } in_h_m1[28:16];
    } W_00C @ 0xC;

    reg {
        name = "Input mode";
        desc = "Input picture mode. PROVEN (dynamic): base value 0x20; stImgIn.enCompressMode != 0 sets bit 0, enVideoFormat == 2 (TILE64) sets bit 6; linear = 0. Provenance: DYNAMIC: the vendor node builder (VGS_DrvCommSubmitJobToVgs -> VGS_DrvCommPrepareNodes -> VGS_DRV_SetVgsReg, GenSclCfg, VGSSplitAndCrop) was run under qemu-arm with a fake register file and swept one input at a time (2026-11-23, scripts/tools/vgs-static/). Static source: hi3536dv100_vgs.ko (SDK 2.0.2.0 / Hi3536D_MPP_V1.0.1.0 B040, Dec 7 2017).";
        field {
            name = "compressed";
            desc = "input is compressed (header addresses in 0x24/0x28) [PROVEN]";
            sw = rw;
            hw = r;
        } compressed[0:0];
        field {
            name = "const_5";
            desc = "always 1 in every node built [PROVEN value, meaning UNKNOWN]";
            sw = rw;
            hw = r;
        } const_5[5:5];
        field {
            name = "tile64";
            desc = "input uses the TILE64 layout [PROVEN]";
            sw = rw;
            hw = r;
        } tile64[6:6];
    } W_020 @ 0x20;

    reg {
        name = "Input header address Y";
        desc = "Physical address of the luma compression header of the input (stImgIn.u32HeaderPhyAddr[0]); written whatever the mode, 0 when unused. Provenance: DYNAMIC: the vendor node builder (VGS_DrvCommSubmitJobToVgs -> VGS_DrvCommPrepareNodes -> VGS_DRV_SetVgsReg, GenSclCfg, VGSSplitAndCrop) was run under qemu-arm with a fake register file and swept one input at a time (2026-11-23, scripts/tools/vgs-static/). Static source: hi3536dv100_vgs.ko (SDK 2.0.2.0 / Hi3536D_MPP_V1.0.1.0 B040, Dec 7 2017).";
        field {
            name = "hdr_y_addr";
            desc = "luma header address [PROVEN]";
            sw = rw;
            hw = r;
        } hdr_y_addr[31:0];
    } W_024 @ 0x24;

    reg {
        name = "Input header address C";
        desc = "Physical address of the chroma compression header of the input (stImgIn.u32HeaderPhyAddr[1]). Provenance: DYNAMIC: the vendor node builder (VGS_DrvCommSubmitJobToVgs -> VGS_DrvCommPrepareNodes -> VGS_DRV_SetVgsReg, GenSclCfg, VGSSplitAndCrop) was run under qemu-arm with a fake register file and swept one input at a time (2026-11-23, scripts/tools/vgs-static/). Static source: hi3536dv100_vgs.ko (SDK 2.0.2.0 / Hi3536D_MPP_V1.0.1.0 B040, Dec 7 2017).";
        field {
            name = "hdr_c_addr";
            desc = "chroma header address [PROVEN]";
            sw = rw;
            hw = r;
        } hdr_c_addr[31:0];
    } W_028 @ 0x28;

    reg {
        name = "Input luma address";
        desc = "Physical address of the first luma sample of the (cropped) input: stImgIn.u32PhyAddr[0] + crop_y * stride0 + crop_x (PROVEN, crop (16,8) gave +0x2810 with stride 1280). Provenance: DYNAMIC: the vendor node builder (VGS_DrvCommSubmitJobToVgs -> VGS_DrvCommPrepareNodes -> VGS_DRV_SetVgsReg, GenSclCfg, VGSSplitAndCrop) was run under qemu-arm with a fake register file and swept one input at a time (2026-11-23, scripts/tools/vgs-static/). Static source: hi3536dv100_vgs.ko (SDK 2.0.2.0 / Hi3536D_MPP_V1.0.1.0 B040, Dec 7 2017).";
        field {
            name = "in_y_addr";
            desc = "input luma address incl. crop offset [PROVEN]";
            sw = rw;
            hw = r;
        } in_y_addr[31:0];
    } W_02C @ 0x2C;

    reg {
        name = "Input chroma address";
        desc = "Physical address of the first chroma sample of the (cropped) input: stImgIn.u32PhyAddr[1] + (crop_y / 2 for 4:2:0) * stride1 + crop_x (PROVEN for 4:2:0: crop (16,8) gave +0x1410 with stride 1280). Provenance: DYNAMIC: the vendor node builder (VGS_DrvCommSubmitJobToVgs -> VGS_DrvCommPrepareNodes -> VGS_DRV_SetVgsReg, GenSclCfg, VGSSplitAndCrop) was run under qemu-arm with a fake register file and swept one input at a time (2026-11-23, scripts/tools/vgs-static/). Static source: hi3536dv100_vgs.ko (SDK 2.0.2.0 / Hi3536D_MPP_V1.0.1.0 B040, Dec 7 2017).";
        field {
            name = "in_c_addr";
            desc = "input chroma address incl. crop offset [PROVEN]";
            sw = rw;
            hw = r;
        } in_c_addr[31:0];
    } W_030 @ 0x30;

    reg {
        name = "Input strides";
        desc = "Line strides of the input planes in bytes. Provenance: DYNAMIC: the vendor node builder (VGS_DrvCommSubmitJobToVgs -> VGS_DrvCommPrepareNodes -> VGS_DRV_SetVgsReg, GenSclCfg, VGSSplitAndCrop) was run under qemu-arm with a fake register file and swept one input at a time (2026-11-23, scripts/tools/vgs-static/). Static source: hi3536dv100_vgs.ko (SDK 2.0.2.0 / Hi3536D_MPP_V1.0.1.0 B040, Dec 7 2017).";
        field {
            name = "in_stride_y";
            desc = "stImgIn.u32Stride[0] [PROVEN]";
            sw = rw;
            hw = r;
        } in_stride_y[15:0];
        field {
            name = "in_stride_c";
            desc = "stImgIn.u32Stride[1] [PROVEN]";
            sw = rw;
            hw = r;
        } in_stride_c[31:16];
    } W_034 @ 0x34;

    reg {
        name = "Flip / option word";
        desc = "Word 0x68. PROVEN (dynamic): a rotation task with angle 180 degrees (types 5 and 6 build identical nodes) sets bits 5:4 = 3 and nothing else changes (the node is a 1:1 scale node); user option u32 at +0x4B4 sets bit 8. INFERRED: bit 4 / bit 5 are the horizontal / vertical flip, which together make a 180 degree rotation. Provenance: DYNAMIC: the vendor node builder (VGS_DrvCommSubmitJobToVgs -> VGS_DrvCommPrepareNodes -> VGS_DRV_SetVgsReg, GenSclCfg, VGSSplitAndCrop) was run under qemu-arm with a fake register file and swept one input at a time (2026-11-23, scripts/tools/vgs-static/). Static source: hi3536dv100_vgs.ko (SDK 2.0.2.0 / Hi3536D_MPP_V1.0.1.0 B040, Dec 7 2017).";
        field {
            name = "flip_h";
            desc = "INFERRED horizontal flip (180 degree rotation sets both) [PROVEN trigger]";
            sw = rw;
            hw = r;
        } flip_h[4:4];
        field {
            name = "flip_v";
            desc = "INFERRED vertical flip [PROVEN trigger]";
            sw = rw;
            hw = r;
        } flip_v[5:5];
        field {
            name = "opt_b8";
            desc = "set by the user option at +0x4B4 [PROVEN trigger, meaning UNKNOWN]";
            sw = rw;
            hw = r;
        } opt_b8[8:8];
    } W_068 @ 0x68;

    reg {
        name = "Image word 0x6C";
        desc = "Image word 0x6C. PROVEN: written by VGS_DRV_SetVgsReg (3 records). Constants stored: none; ORed constants: none. Typical path conditions: stImgIn.enPixelFormat != 0x1D; a1[0x25C] != 0x0; a1[0x25C] == 0x0. Meaning UNKNOWN beyond the field sources.";
        field {
            name = "f_0_12";
            desc = "Field [12:0]. Sources (PROVEN expression, INFERRED naming): a1[0x25C]; a1[0x34].";
            sw = rw;
            hw = r;
        } f_0_12[12:0];
        field {
            name = "f_16_28";
            desc = "Field [28:16]. Sources (PROVEN expression, INFERRED naming): a1[0x25C]; a1[0x38].";
            sw = rw;
            hw = r;
        } f_16_28[28:16];
    } W_06C @ 0x6C;

    reg {
        name = "Output size";
        desc = "Output size minus one (the ROTATED size for 90/270 rotation tasks). Provenance: DYNAMIC: the vendor node builder (VGS_DrvCommSubmitJobToVgs -> VGS_DrvCommPrepareNodes -> VGS_DRV_SetVgsReg, GenSclCfg, VGSSplitAndCrop) was run under qemu-arm with a fake register file and swept one input at a time (2026-11-23, scripts/tools/vgs-static/). Static source: hi3536dv100_vgs.ko (SDK 2.0.2.0 / Hi3536D_MPP_V1.0.1.0 B040, Dec 7 2017).";
        field {
            name = "out_w_m1";
            desc = "output width - 1 [PROVEN]";
            sw = rw;
            hw = r;
        } out_w_m1[12:0];
        field {
            name = "out_h_m1";
            desc = "output height - 1 [PROVEN]";
            sw = rw;
            hw = r;
        } out_h_m1[28:16];
    } W_070 @ 0x70;

    reg {
        name = "Output luma address";
        desc = "Physical address of the output luma plane (stImgOut.u32PhyAddr[0]). Provenance: DYNAMIC: the vendor node builder (VGS_DrvCommSubmitJobToVgs -> VGS_DrvCommPrepareNodes -> VGS_DRV_SetVgsReg, GenSclCfg, VGSSplitAndCrop) was run under qemu-arm with a fake register file and swept one input at a time (2026-11-23, scripts/tools/vgs-static/). Static source: hi3536dv100_vgs.ko (SDK 2.0.2.0 / Hi3536D_MPP_V1.0.1.0 B040, Dec 7 2017).";
        field {
            name = "out_y_addr";
            desc = "output luma address [PROVEN]";
            sw = rw;
            hw = r;
        } out_y_addr[31:0];
    } W_074 @ 0x74;

    reg {
        name = "Output chroma address";
        desc = "Physical address of the output chroma plane (stImgOut.u32PhyAddr[1]). Provenance: DYNAMIC: the vendor node builder (VGS_DrvCommSubmitJobToVgs -> VGS_DrvCommPrepareNodes -> VGS_DRV_SetVgsReg, GenSclCfg, VGSSplitAndCrop) was run under qemu-arm with a fake register file and swept one input at a time (2026-11-23, scripts/tools/vgs-static/). Static source: hi3536dv100_vgs.ko (SDK 2.0.2.0 / Hi3536D_MPP_V1.0.1.0 B040, Dec 7 2017).";
        field {
            name = "out_c_addr";
            desc = "output chroma address [PROVEN]";
            sw = rw;
            hw = r;
        } out_c_addr[31:0];
    } W_078 @ 0x78;

    reg {
        name = "Output strides";
        desc = "Line strides of the output planes in bytes. Provenance: DYNAMIC: the vendor node builder (VGS_DrvCommSubmitJobToVgs -> VGS_DrvCommPrepareNodes -> VGS_DRV_SetVgsReg, GenSclCfg, VGSSplitAndCrop) was run under qemu-arm with a fake register file and swept one input at a time (2026-11-23, scripts/tools/vgs-static/). Static source: hi3536dv100_vgs.ko (SDK 2.0.2.0 / Hi3536D_MPP_V1.0.1.0 B040, Dec 7 2017).";
        field {
            name = "out_stride_y";
            desc = "stImgOut.u32Stride[0] [PROVEN]";
            sw = rw;
            hw = r;
        } out_stride_y[15:0];
        field {
            name = "out_stride_c";
            desc = "stImgOut.u32Stride[1] [PROVEN]";
            sw = rw;
            hw = r;
        } out_stride_c[31:16];
    } W_07C @ 0x7C;

    reg {
        name = "Input header strides";
        desc = "Strides of the compression headers (only meaningful for compressed input; 0 otherwise). Provenance: DYNAMIC: the vendor node builder (VGS_DrvCommSubmitJobToVgs -> VGS_DrvCommPrepareNodes -> VGS_DRV_SetVgsReg, GenSclCfg, VGSSplitAndCrop) was run under qemu-arm with a fake register file and swept one input at a time (2026-11-23, scripts/tools/vgs-static/). Static source: hi3536dv100_vgs.ko (SDK 2.0.2.0 / Hi3536D_MPP_V1.0.1.0 B040, Dec 7 2017).";
        field {
            name = "hdr_stride_y";
            desc = "stImgIn.u32HeaderStride[0] [PROVEN]";
            sw = rw;
            hw = r;
        } hdr_stride_y[9:0];
        field {
            name = "hdr_stride_c";
            desc = "stImgIn.u32HeaderStride[1] [PROVEN]";
            sw = rw;
            hw = r;
        } hdr_stride_c[25:16];
    } W_0D8 @ 0xD8;

    reg {
        name = "Image word 0xF0";
        desc = "Image word 0xF0. PROVEN: written by VGS_DRV_SetVgsReg (1 records). Constants stored: none; ORed constants: none. Typical path conditions: stImgIn.enPixelFormat != 0x1D; a7 != 0xFFFFFFFF. Meaning UNKNOWN beyond the field sources.";
        field {
            name = "word";
            desc = "32-bit word (no struct-member source found).";
            sw = rw;
            hw = r;
        } word[31:0];
    } W_0F0 @ 0xF0;

    reg {
        name = "Node id";
        desc = "Node id: written by VGS_HAL_SetNodeID with the CPU address of the node image (VGS_DrvCommStartWaitlist: 0, 1, 2 ... along the nodes of one job); read back through MMIO 0xF4 in the interrupt handler. Provenance: DYNAMIC: the vendor node builder (VGS_DrvCommSubmitJobToVgs -> VGS_DrvCommPrepareNodes -> VGS_DRV_SetVgsReg, GenSclCfg, VGSSplitAndCrop) was run under qemu-arm with a fake register file and swept one input at a time (2026-11-23, scripts/tools/vgs-static/). Static source: hi3536dv100_vgs.ko (SDK 2.0.2.0 / Hi3536D_MPP_V1.0.1.0 B040, Dec 7 2017).";
        field {
            name = "node_id";
            desc = "id of the node in its job [PROVEN]";
            sw = rw;
            hw = r;
        } node_id[31:0];
    } W_0F4 @ 0xF4;

    reg {
        name = "Interrupt mask";
        desc = "Interrupt mask: written by VGS_HAL_SetMask with the CPU address of the node image: 0 on every node but the last of a job, 0x87 on the last node. Provenance: DYNAMIC: the vendor node builder (VGS_DrvCommSubmitJobToVgs -> VGS_DrvCommPrepareNodes -> VGS_DRV_SetVgsReg, GenSclCfg, VGSSplitAndCrop) was run under qemu-arm with a fake register file and swept one input at a time (2026-11-23, scripts/tools/vgs-static/). Static source: hi3536dv100_vgs.ko (SDK 2.0.2.0 / Hi3536D_MPP_V1.0.1.0 B040, Dec 7 2017).";
        field {
            name = "int_mask";
            desc = "0x87 on the last node of a job, 0 otherwise [PROVEN values, INFERRED meaning]";
            sw = rw;
            hw = r;
        } int_mask[31:0];
    } W_0FC @ 0xFC;

    reg {
        name = "Image word 0x110";
        desc = "Image word 0x110. PROVEN: written by VGS_DRV_SetVgsReg (3 records). Constants stored: none; ORed constants: none. Typical path conditions: stImgIn.enPixelFormat != 0x1D; a1[0x198] == 0x0; a1[0x1E8] != 0x0. Meaning UNKNOWN beyond the field sources.";
        field {
            name = "f_0_12";
            desc = "Field [12:0]. Sources (PROVEN expression, INFERRED naming): a1[0x88]; a1[0x8C].";
            sw = rw;
            hw = r;
        } f_0_12[12:0];
        field {
            name = "f_16_28";
            desc = "Field [28:16]. Sources (PROVEN expression, INFERRED naming): a1[0x88]; a1[0x90].";
            sw = rw;
            hw = r;
        } f_16_28[28:16];
    } W_110 @ 0x110;

    reg {
        name = "Image word 0x114";
        desc = "Image word 0x114. PROVEN: written by VGS_DRV_SetVgsReg (3 records). Constants stored: none; ORed constants: none. Typical path conditions: stImgIn.enPixelFormat != 0x1D; a1[0x198] == 0x0; a1[0x25C] != 0x0. Meaning UNKNOWN beyond the field sources.";
        field {
            name = "f_0_12";
            desc = "Field [12:0]. Sources (PROVEN expression, INFERRED naming): a1[0x88]; sub(a1[0x94],0x1).";
            sw = rw;
            hw = r;
        } f_0_12[12:0];
        field {
            name = "f_16_28";
            desc = "Field [28:16]. Sources (PROVEN expression, INFERRED naming): a1[0x88]; sub(a1[0x98],0x1).";
            sw = rw;
            hw = r;
        } f_16_28[28:16];
        field {
            name = "f_31_31";
            desc = "Field [31:31]. Sources (PROVEN expression, INFERRED naming): a1[0x88].";
            sw = rw;
            hw = r;
        } f_31_31[31:31];
    } W_114 @ 0x114;

