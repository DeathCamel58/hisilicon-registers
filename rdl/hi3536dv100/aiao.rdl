            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_8[31:8];
        field {
            name = "tx_dat_break_int_clear";
            desc = "Interface data break interrupt clear for the TX channel
- 0: No raw interrupt is generated.
- 1: A raw interrupt is generated.

Access type WC in the data sheet: written 1 clears the bit.";
            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } tx_dat_break_int_clear[7:7];
        field {
            name = "tx_mfade_int_clear";
            desc = "Mute fade-in/fade-output completion interrupt clear for the TX channel
- 0: not cleared
- 1: cleared

Access type WC in the data sheet: written 1 clears the bit.";
            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } tx_mfade_int_clear[6:6];
        field {
