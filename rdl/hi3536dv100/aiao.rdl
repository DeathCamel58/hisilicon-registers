        field {
            name = "reserved_31_3";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_3[31:3];
        field {
            name = "vhb_outst_num";
            desc = "Number of VHB outstandings The recommended value is 3.";
            sw = rw; hw = r;
            reset = 0x0;
        } vhb_outst_num[2:0];
    } VHB_OUTSTANDING @ 0x34;
    reg {
        name = "AIAO_RST_REQ";
        desc = "AIAO_RST_REQ (offset 0x4C, total reset 0x00000000; PROVEN: Hi3536D V100 data sheet).";
        field {
            name = "reserved_31_10";
            desc = "Reserved";
            sw = rw; hw = r;
            reset = 0x0;
        } reserved_31_10[31:10];
        field {
            name = "srst_tcx1_apb";
            desc = "Writing 1 to this bit resets write channel 1. Hardware automatically sets this bit to 0 after the reset is complete.";
            sw = rw; hw = r;
            reset = 0x0;
        } srst_tcx1_apb[9:9];
        field {
            name = "srst_tcx0_apb";
            desc = "Writing 1 to this bit resets write channel 0. Hardware automatically sets this bit to 0 after the reset is complete.";
            sw = rw; hw = r;
            reset = 0x0;
        } srst_tcx0_apb[8:8];
        field {
            name = "reserved_7_1";
            desc = "Reserved";
            sw = rw; hw = r;
            reset = 0x0;
        } reserved_7_1[7:1];
        field {
            name = "srst_rcx0_apb";
            desc = "Writing 1 to this bit resets read channel 0. Hardware automatically sets this bit to 0 after the reset is complete.";
            sw = rw; hw = r;
            reset = 0x0;
        } srst_rcx0_apb[0:0];
    } AIAO_RST_REQ @ 0x4C;
    reg {
        name = "AIAO_RST_DONE";
        desc = "AIAO_RST_DONE is a soft reset result feedback register. (offset 0x50, total reset 0x00000000; PROVEN: Hi3536D V100 data sheet).";
        field {
            name = "reserved_31_27";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_27[31:27];
        field {
            name = "srst_varb_done_apb";
            desc = "VHB to AXI bus bridge reset completion flag. This bit is cleared when software writes 0 to it.";
            sw = rw; hw = w; woclr;
            reset = 0x0;
        } srst_varb_done_apb[26:26];
        field {
            name = "srst_pcfg_done_apb";
            desc = "Configuration register (not configured in the channel) reset completion flag. This bit is cleared when software writes 0 to it.";
            sw = rw; hw = w; woclr;
            reset = 0x0;
        } srst_pcfg_done_apb[25:25];
        field {
            name = "srst_tdsp_done_apb";
            desc = "Volume adjustment module reset completion flag. This bit is cleared when software writes 0 to it.";
            sw = rw; hw = w; woclr;
            reset = 0x0;
        } srst_tdsp_done_apb[24:24];
        field {
            name = "reserved_23_10";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_23_10[23:10];
        field {
            name = "srst_tcx1_done_apb";
            desc = "Write channel 1 reset completion flag. This bit is cleared when software writes 0 to it.";
            sw = rw; hw = w; woclr;
            reset = 0x0;
        } srst_tcx1_done_apb[9:9];
        field {
            name = "srst_tcx0_done_apb";
            desc = "Write channel 0 reset completion flag. This bit is cleared when software writes 0 to it.";
            sw = rw; hw = w; woclr;
            reset = 0x0;
        } srst_tcx0_done_apb[8:8];
        field {
            name = "reserved_7_1";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_1[7:1];
        field {
            name = "srst_rcx0_done_apb";
            desc = "Read channel 0 reset completion flag. This bit is cleared when software writes 0 to it.";
            sw = rw; hw = w; woclr;
            reset = 0x0;
        } srst_rcx0_done_apb[0:0];
    } AIAO_RST_DONE @ 0x50;
    reg {
        name = "I2S_CRG_CFG1_00";
        desc = "I2S_CRG_CFG1_00 (offset 0x104, total reset 0x00000131; PROVEN: Hi3536D V100 data sheet).";
        field {
            name = "reserved_31_14";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_14[31:14];
