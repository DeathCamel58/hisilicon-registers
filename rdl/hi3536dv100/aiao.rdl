            reset = 0x1;
        } f_0x8_[7:4];
        field {
            name = "f_0x8__0";
            desc = "Internal BCLK select for TX channel 0 BCLK8 tx_00 0x9: BCLK9 Other values: reserved";
            sw = rw; hw = r;
            reset = 0x0;
        } f_0x8__0[3:0];
    } AIAO_SWITCH_TX_BCLK @ 0x2C;
    reg {
