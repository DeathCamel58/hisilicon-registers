            desc = "Number of VHB outstandings The recommended value is 3.";
            sw = rw; hw = r;
            reset = 0x0;
        } vhb_outst_num[2:0];
    } VHB_OUTSTANDING @ 0x34;
    reg {
        name = "AIAO_RST_REQ";
        desc = "AIAO_RST_REQ is a soft reset request register. (offset 0x4C; total reset 0x00000000; PROVEN: Hi3536D V100 data sheet (Issue 00B04, 2017-12-13), section 10.1.6, PDF page 603).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = rw; hw = r;
            reset = 0x0;
        } reserved_31_10[31:10];
        field {
            name = "srst_tcx1_apb";
            desc = "Writing 1 to this bit resets write channel 1. Hardware automatically sets this bit to 0 after the reset is complete.";
            sw = rw; hw = r;
            reset = 0x0;
        } srst_tcx1_apb[9:9];
        field {
            name = "srst_tcx0_apb";
            desc = "Writing 1 to this bit resets write channel 0. Hardware automatically sets this bit to 0 after the reset is complete.";
            sw = rw; hw = r;
            reset = 0x0;
        } srst_tcx0_apb[8:8];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = rw; hw = r;
            reset = 0x0;
        } reserved_7_1[7:1];
        field {
            name = "srst_rcx0_apb";
            desc = "Writing 1 to this bit resets read channel 0. Hardware automatically sets this bit to 0 after the reset is complete.";
            sw = rw; hw = r;
            reset = 0x0;
        } srst_rcx0_apb[0:0];
    } AIAO_RST_REQ @ 0x4C;
    reg {
        name = "AIAO_RST_DONE";
        desc = "AIAO_RST_DONE is a soft reset result feedback register. (offset 0x50; total reset 0x00000000; PROVEN: Hi3536D V100 data sheet (Issue 00B04, 2017-12-13), section 10.1.6, PDF page 603).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_27[31:27];
        field {
            name = "srst_varb_done_apb";
            desc = "VHB to AXI bus bridge reset completion flag. This bit is cleared when software writes 0 to it.

Access type WC in the data sheet: written 1 clears the bit.";
            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } srst_varb_done_apb[26:26];
        field {
            name = "srst_pcfg_done_apb";
            desc = "Configuration register (not configured in the channel) reset completion flag. This bit is cleared when software writes 0 to it.

Access type WC in the data sheet: written 1 clears the bit.";
            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } srst_pcfg_done_apb[25:25];
        field {
            name = "srst_tdsp_done_apb";
            desc = "Volume adjustment module reset completion flag. This bit is cleared when software writes 0 to it.

Access type WC in the data sheet: written 1 clears the bit.";
            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } srst_tdsp_done_apb[24:24];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_23_10[23:10];
        field {
            name = "srst_tcx1_done_apb";
            desc = "Write channel 1 reset completion flag. This bit is cleared when software writes 0 to it.

Access type WC in the data sheet: written 1 clears the bit.";
            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } srst_tcx1_done_apb[9:9];
        field {
            name = "srst_tcx0_done_apb";
            desc = "Write channel 0 reset completion flag. This bit is cleared when software writes 0 to it.

Access type WC in the data sheet: written 1 clears the bit.";
            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } srst_tcx0_done_apb[8:8];
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_7_1[7:1];
        field {
            name = "srst_rcx0_done_apb";
            desc = "Read channel 0 reset completion flag. This bit is cleared when software writes 0 to it.

Access type WC in the data sheet: written 1 clears the bit.";
            sw = rw; hw = w; onwrite = woclr;
            reset = 0x0;
        } srst_rcx0_done_apb[0:0];
    } AIAO_RST_DONE @ 0x50;
    reg I2S_CRG_CFG0_00_t {
        name = "I2S_CRG_CFG0_00";
        desc = "I2S_CRG_CFG0_00 is I2S00 CRG configuration register 0. (offset 0x100, 3 instances at stride 0x8; total reset 0x00AAAAAA; PROVEN: Hi3536D V100 data sheet (Issue 00B04, 2017-12-13), section 10.1.6, PDF page 604).";
        field {
            name = "reserved";
            desc = "Reserved";
            sw = r; hw = w;
            reset = 0x0;
        } reserved_31_27[31:27];
        field {
            name = "aiao_mclk_div";
            desc = "Clock divider of the MCLK. The configured value is calculated as follows: (Frequency of the target MCLK clock/Frequency of the MCLK PLL source clock) x 2^27. For details about the frequency of the MCLK PLL source clock, see section 3.2 \"Clock\" in chapter 3 \"System.\"";
            sw = rw; hw = r;
            reset = 0xaaaaaa;
        } aiao_mclk_div[26:0];
    };
    I2S_CRG_CFG0_00_t I2S_CRG_CFG0_00_0 @ 0x100;
