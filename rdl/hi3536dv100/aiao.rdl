        field {
            name = "rx_trackmode";
            desc = "Audio-left and audio-right channel mode in I2S mode
- 000: The sound is not processed.
- 001: The sounds in two channels are audio-left channel sounds.
- 010: The sounds in two channels are audio-right channel sounds.
- 011: The sounds in two channels are exchanged.
- 100: The sounds of two channels are added and then output.
- 101: The audio-left channel is muted, and the sound of the audio- right channel is from the original audio-right channel.
- 110: The audio-right channel is muted, and the sound of the audio- left channel is from the original audio-left channel.
- 111: The audio-left and audio-right channels are muted.

Note: trackmode is still valid in 1-channel RX mode. In this case, the value 101 indicates that the sound is not processed, and the value 110 indicates that the audio channels are muted.";
            sw = rw; hw = r;
            reset = 0x0;
        } rx_trackmode[18:16];
        field {
            name = "rx_sd_offset";
            desc = "Number of BCLK clocks delayed for data relative to the frame sync signal in PCM mode
- 0x00: 0 bit clocks
- 0x01: 1 bit clock
- 0x02: 2 bit clocks …
- 0xFE: 254 bit clocks
- 0xFF: 255 bit clocks";
            sw = rw; hw = r;
            reset = 0x0;
        } rx_sd_offset[15:8];
        field {
            name = "rx_multislot_en";
            desc = "Time-division multiplexing validity indicator
- 0: invalid (normal mode)
- 1: valid";
            sw = rw; hw = r;
            reset = 0x0;
        } rx_multislot_en[7:7];
        field {
            name = "rx_ch_num";
            desc = "Number of RX channels rx_multislot_en = 0
- 000: 1-channel RX (SD0 data line)
- 001: 2-channel RX (SD0 data line)

Other values: reserved rx_multislot_en = 1 Number of RX channels in time-division multiplexing mode.
- 000: 2-channel RX (SD0 data line)
- 001: 4-channel RX (SD0 data line)
- 010: 8-channel RX (SD0 data line)
- 011: 16-channel RX (SD0 data line)

Other values: reserved Note: The data line must be SD0 for multi-channel RX.";
            sw = rw; hw = r;
            reset = 0x0;
        } rx_ch_num[6:4];
        field {
            name = "rx_i2s_precision";
            desc = "Data sampling precision rx_multislot_en = 0 I2S normal mode:
- 00: reserved
- 01: 16 bits
- 10: 24 bits
- 11: reserved

PCM normal mode:
- 00: 8 bits
- 01: 16 bits

Other values: reserved rx_multislot_en = 1 I2S/PCM mode:
- 00: 8 bits
- 01: 16 bits

Other values: reserved";
            sw = rw; hw = r;
            reset = 0x1;
        } rx_i2s_precision[3:2];
        field {
            name = "rx_mode";
            desc = "Interface mode of the RX channel
- 00: I2S mode
- 01: PCM mode

Other values: reserved";
            sw = rw; hw = r;
            reset = 0x0;
        } rx_mode[1:0];
    };
