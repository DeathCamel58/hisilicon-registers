        desc = "TX_INT_CLR is an interrupt clear register for the TX channel. (offset 0x20AC, 3 instances at stride 0x100; total reset 0x00000000; PROVEN: Hi3536D V100 data sheet (Issue 00B04, 2017-12-13), section 10.1.6, PDF page 631).";
        field {
            name = "reserved";
